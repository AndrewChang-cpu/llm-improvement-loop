+import unittest
+from unittest import mock
+
+import numpy as np
+import torch
+
+from monai.handlers.tensorboard_handlers import plot_2d_or_3d_image
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def test_2d_image(self):
+        writer = mock.MagicMock()
+        plot_2d_or_3d_image(np.random.rand(2, 20, 20), 5, writer, tag='output')
+        writer.add_image.assert_called_once()
+        args, kwargs = writer.add_image.call_args
+        self.assertEqual(args[0], 'output_HW')
+        self.assertEqual(args[2], 5)
+        self.assertEqual(kwargs['dataformats'], 'HW')
+
+    def test_multi_channel_2d(self):
+        writer = mock.MagicMock()
+        plot_2d_or_3d_image(torch.rand(1, 2, 20, 20), 1, writer, max_channels=2, tag='input_0')
+        tags = [call[0][0] for call in writer.add_image.call_args_list]
+        self.assertEqual(tags, ['input_0_HW_0', 'input_0_HW_1'])
+
+    def test_3d_image_uses_animated_gif(self):
+        writer = mock.MagicMock()
+        with mock.patch('monai.handlers.tensorboard_handlers.img2tensorboard.add_animated_gif') as gif:
+            plot_2d_or_3d_image(np.random.rand(1, 2, 20, 20, 20), 3, writer, max_channels=2, max_frames=4)
+        self.assertEqual(gif.call_count, 2)
+        args = gif.call_args_list[0][0]
+        self.assertEqual(args[1], 'output_HWD_0')
+        self.assertEqual(args[3], 4)
+        self.assertEqual(args[5], 3)
+
+    def test_index_selects_batch_element(self):
+        writer = mock.MagicMock()
+        data = np.zeros((2, 1, 8, 8))
+        data[1] = 1.0
+        plot_2d_or_3d_image(data, 0, writer, index=1, tag='output')
+        self.assertEqual(writer.add_image.call_args[0][0], 'output_HW')
+
+    def test_invalid_input(self):
+        with self.assertRaises(ValueError):
+            plot_2d_or_3d_image([1, 2, 3], 0, mock.MagicMock())
+
+
+if __name__ == '__main__':
+    unittest.main()
