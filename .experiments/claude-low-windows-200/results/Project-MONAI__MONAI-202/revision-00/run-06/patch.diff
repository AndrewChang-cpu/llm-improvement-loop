+import os
+import csv
+import logging
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Save the classification predictions as a CSV file. This class has no dependency on any event engine,
+    so it can be used directly or wrapped by an event handler (e.g. ``monai.handlers.ClassificationSaver``).
+    Call ``save`` for each item, then call ``finalize`` once to write the CSV file.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True, name=None):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the output CSV file.
+            overwrite (bool): whether to overwriting existing CSV file content. If we are not overwriting,
+                then we check if the results have been previously saved, and load them to the prediction_dict.
+            name (str): identifier of logging.logger to use, defaults to this module's logger.
+        """
+        self.output_dir = output_dir
+        self._prediction_dict = {}
+        self._preds_filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self.logger = logging.getLogger(name if name is not None else __name__)
+
+    def save(self, data, meta_data):
+        """
+        Store the prediction of one item, to be written by ``finalize``.
+
+        Args:
+            data (numpy.ndarray or torch.Tensor): prediction of one item (no batch dimension).
+            meta_data (dict): must contain ``'filename_or_obj'`` which is used as the row key.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._prediction_dict[meta_data['filename_or_obj']] = np.asarray(data).astype(np.float32)
+
+    def finalize(self):
+        """
+        Writes the prediction dict to a csv file.
+        """
+        if not self.overwrite and os.path.exists(self._preds_filepath):
+            with open(self._preds_filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._prediction_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._preds_filepath, 'w') as f:
+            for k, v in sorted(self._prediction_dict.items()):
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+        self.logger.info('saved classification predictions into: {}'.format(self._preds_filepath))
