+
+import csv
+import os
+import shutil
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return [row for row in csv.reader(f)]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        saver = CSVSaver(output_dir=default_dir)
+        for i in reversed(range(3)):
+            saver.save(torch.full((2,), float(i)), {'filename_or_obj': 'testfile' + str(i)})
+        saver.finalize()
+
+        filepath = os.path.join(default_dir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        rows = _read_rows(filepath)
+        self.assertEqual(len(rows), 3)
+        for i, row in enumerate(rows):  # sorted by file name
+            self.assertEqual(row[0], 'testfile' + str(i))
+            np.testing.assert_allclose(np.array(row[1:]).astype(np.float32), float(i))
+        shutil.rmtree(default_dir)
+
+    def test_not_overwrite(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        first = CSVSaver(output_dir=default_dir)
+        first.save(np.zeros(3), {'filename_or_obj': 'a'})
+        first.finalize()
+
+        second = CSVSaver(output_dir=default_dir, overwrite=False)
+        second.save(np.ones(3), {'filename_or_obj': 'b'})
+        second.finalize()
+
+        rows = _read_rows(os.path.join(default_dir, 'predictions.csv'))
+        self.assertEqual([row[0] for row in rows], ['a', 'b'])
+        shutil.rmtree(default_dir)
+
+
+if __name__ == '__main__':
+    unittest.main()
