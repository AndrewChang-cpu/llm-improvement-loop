+import os
+import shutil
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        saver = NiftiSaver(output_dir=default_dir, output_postfix='seg', output_ext='.nii.gz')
+        data = np.random.rand(1, 4, 5, 6)  # channel first, no batch dimension
+        meta_data = {'filename_or_obj': 'test1.nii.gz', 'affine': np.eye(4), 'original_affine': np.eye(4)}
+        saver.save(data, meta_data)
+
+        filepath = os.path.join(default_dir, 'test1', 'test1_seg.nii.gz')
+        self.assertTrue(os.path.exists(filepath))
+        img = nib.load(filepath)
+        self.assertEqual(img.shape, (4, 5, 6, 1))
+        self.assertTrue(np.allclose(np.asarray(img.dataobj), np.moveaxis(data, 0, -1), atol=1e-6))
+        shutil.rmtree(default_dir)
+
+    def test_tensor_input_and_default_affine(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        saver = NiftiSaver(output_dir=default_dir, output_postfix='seg', output_ext='.nii.gz')
+        data = torch.ones((2, 3, 3, 3))
+        saver.save(data, {'filename_or_obj': 'test2.nii.gz'})
+
+        filepath = os.path.join(default_dir, 'test2', 'test2_seg.nii.gz')
+        self.assertTrue(os.path.exists(filepath))
+        img = nib.load(filepath)
+        self.assertEqual(img.shape, (3, 3, 3, 2))
+        self.assertTrue(np.allclose(np.asarray(img.dataobj), 1.0))
+        shutil.rmtree(default_dir)
+
+    def test_create_file_basename(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        path = NiftiSaver.create_file_basename('seg', os.path.join('a', 'b', 'img.nii.gz'), default_dir)
+        self.assertEqual(path, os.path.join(default_dir, 'img', 'img_seg'))
+        self.assertTrue(os.path.isdir(os.path.join(default_dir, 'img')))
+        shutil.rmtree(default_dir)
+
+
+if __name__ == '__main__':
+    unittest.main()
