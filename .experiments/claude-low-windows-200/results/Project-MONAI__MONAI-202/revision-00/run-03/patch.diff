+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            saver = NiftiSaver(output_dir=tempdir, output_postfix='seg', output_ext='.nii.gz')
+            data = torch.zeros(2, 1, 8, 8, 8)
+            meta_data = {'filename_or_obj': ['/data/case_0.nii.gz', '/data/case_1.nii.gz'],
+                         'affine': [np.eye(4), np.eye(4)], 'original_affine': [np.eye(4), np.eye(4)]}
+            saved = saver.save(data, meta_data)
+
+            self.assertEqual(len(saved), 2)
+            for i in range(2):
+                filepath = os.path.join(tempdir, 'case_{}'.format(i), 'case_{}_seg.nii.gz'.format(i))
+                self.assertTrue(os.path.exists(filepath))
+                self.assertEqual(saved[i], filepath)
+                img = nib.load(filepath)
+                self.assertEqual(img.shape, (8, 8, 8, 1))
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_create_file_basename_with_root_dir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            name = NiftiSaver._create_file_basename('seg', os.path.join('/root', 'sub', 'img.nii.gz'),
+                                                    tempdir, data_root_dir='/root')
+            self.assertEqual(name, os.path.join(tempdir, 'sub', 'img', 'img_seg'))
+            self.assertTrue(os.path.isdir(os.path.join(tempdir, 'sub', 'img')))
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_missing_filename_raises(self):
+        saver = NiftiSaver(output_dir=tempfile.gettempdir())
+        with self.assertRaises(ValueError):
+            saver.save(np.zeros((1, 1, 4, 4)), {})
+
+
+if __name__ == '__main__':
+    unittest.main()
