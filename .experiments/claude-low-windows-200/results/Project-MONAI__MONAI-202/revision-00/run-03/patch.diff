+
+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save(torch.zeros(8, 2), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+            filepath = saver.finalize()
+            self.assertEqual(filepath, os.path.join(tempdir, 'predictions.csv'))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                np.testing.assert_allclose(np.array(row[1:]).astype(np.float32), np.zeros(2))
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_no_overwrite_keeps_previous_rows(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            first = CSVSaver(output_dir=tempdir, overwrite=True)
+            first.save(np.ones((1, 3)), {'filename_or_obj': ['old']})
+            first.finalize()
+
+            second = CSVSaver(output_dir=tempdir, overwrite=False)
+            second.save(np.zeros((1, 3)), {'filename_or_obj': ['new']})
+            filepath = second.finalize()
+            with open(filepath, 'r') as f:
+                names = [row[0] for row in csv.reader(f)]
+            self.assertEqual(names, ['new', 'old'])
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_missing_filename_raises(self):
+        saver = CSVSaver(output_dir=tempfile.gettempdir())
+        with self.assertRaises(ValueError):
+            saver.save(np.zeros((1, 3)), None)
+
+
+if __name__ == '__main__':
+    unittest.main()
