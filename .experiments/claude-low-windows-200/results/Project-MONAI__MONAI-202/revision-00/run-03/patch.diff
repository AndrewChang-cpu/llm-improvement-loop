+import glob
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.handlers.tensorboard_handlers import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [[2, 20, 20]],
+    [[3, 20, 20]],
+    [[20, 20, 20]],
+    [[2, 20, 20, 20]],
+    [[2, 2, 20, 20, 20]],
+]
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        tempdir = tempfile.mkdtemp()
+        try:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(np.random.normal(size=(2, *shape)), 1, writer, index=0, max_channels=2)
+            writer.close()
+            self.assertTrue(len(glob.glob(os.path.join(tempdir, '*'))) > 0)
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_accepts_tensor(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.rand(1, 20, 20), 0, writer, tag='tensor_input')
+            writer.close()
+            self.assertTrue(len(glob.glob(os.path.join(tempdir, '*'))) > 0)
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_invalid_input_raises(self):
+        writer = SummaryWriter(log_dir=tempfile.gettempdir())
+        with self.assertRaises(ValueError):
+            plot_2d_or_3d_image([[1, 2]], 0, writer)
+        writer.close()
+
+
+if __name__ == '__main__':
+    unittest.main()
