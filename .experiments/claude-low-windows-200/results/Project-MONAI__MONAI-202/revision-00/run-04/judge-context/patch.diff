+import os
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_save_numpy(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir, output_postfix='seg', output_ext='.nii.gz')
+            data = np.random.rand(1, 4, 5, 6).astype(np.float32)  # channel first
+            meta = {'filename_or_obj': 'testfile.nii.gz', 'affine': np.eye(4), 'original_affine': np.eye(4)}
+            filepath = saver.save(data, meta)
+
+            expected = os.path.join(tempdir, 'testfile', 'testfile_seg.nii.gz')
+            self.assertEqual(filepath, expected)
+            self.assertTrue(os.path.exists(expected))
+            # saved in channel-last format
+            loaded = nib.load(expected).get_fdata()
+            self.assertEqual(loaded.shape, (4, 5, 6, 1))
+            np.testing.assert_allclose(loaded[..., 0], data[0], rtol=1e-5)
+
+    def test_save_tensor_and_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir, output_postfix='seg', output_ext='.nii.gz', dtype='uint8')
+            data = torch.ones((2, 3, 3, 3), dtype=torch.float32)
+            meta = {'filename_or_obj': 'sub/testfile.nii.gz', 'affine': np.eye(4)}
+            filepath = saver.save(data, meta)
+
+            self.assertTrue(os.path.exists(filepath))
+            loaded = nib.load(filepath)
+            self.assertEqual(loaded.shape, (3, 3, 3, 2))
+            self.assertEqual(loaded.get_data_dtype(), np.uint8)
+
+    def test_create_file_basename(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            basename = NiftiSaver._create_file_basename('seg', 'a/b/image.nii.gz', tempdir)
+            self.assertEqual(basename, os.path.join(tempdir, 'image', 'image_seg'))
+            self.assertTrue(os.path.isdir(os.path.join(tempdir, 'image')))
+
+
+if __name__ == '__main__':
+    unittest.main()
