+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [[2, 20, 20]],
+    [[3, 20, 20]],
+    [[20, 20]],
+    [[2, 20, 20, 20]],
+    [[2, 2, 20, 20, 20]],
+]
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            data = np.random.normal(size=(4, *shape))
+            plot_2d_or_3d_image(data, step=0, writer=writer, index=1, max_channels=1, max_frames=4, tag='test')
+            writer.close()
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_torch_tensor_input(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            data = torch.rand(2, 1, 10, 10)
+            plot_2d_or_3d_image(data, step=1, writer=writer, tag='output')
+            writer.close()
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_invalid_input_raises(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            with self.assertRaises(ValueError):
+                plot_2d_or_3d_image([[1, 2]], step=0, writer=writer)
+            writer.close()
+
+
+if __name__ == '__main__':
+    unittest.main()
