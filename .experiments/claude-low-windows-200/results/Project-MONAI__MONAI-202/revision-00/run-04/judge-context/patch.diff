+
+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return list(csv.reader(f))
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_save_and_finalize(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save(torch.tensor([0.5, 1.0]), {'filename_or_obj': 'b'})
+            saver.save(np.array([2.0, 3.0]), {'filename_or_obj': 'a'})
+            filepath = saver.finalize()
+
+            self.assertEqual(filepath, os.path.join(tempdir, 'predictions.csv'))
+            rows = _read_rows(filepath)
+            # rows are sorted by key
+            self.assertEqual(rows, [['a', '2.0', '3.0'], ['b', '0.5', '1.0']])
+
+    def test_creates_missing_directory(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            output_dir = os.path.join(tempdir, 'nested', 'dir')
+            saver = CSVSaver(output_dir=output_dir)
+            saver.save(np.array([1.0]), {'filename_or_obj': 'x'})
+            filepath = saver.finalize()
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_not_overwrite_keeps_existing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            first = CSVSaver(output_dir=tempdir)
+            first.save(np.array([1.0]), {'filename_or_obj': 'old'})
+            first.finalize()
+
+            second = CSVSaver(output_dir=tempdir, overwrite=False)
+            second.save(np.array([2.0]), {'filename_or_obj': 'new'})
+            filepath = second.finalize()
+
+            rows = _read_rows(filepath)
+            self.assertEqual(rows, [['new', '2.0'], ['old', '1.0']])
+
+    def test_overwrite_replaces_existing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            first = CSVSaver(output_dir=tempdir)
+            first.save(np.array([1.0]), {'filename_or_obj': 'old'})
+            first.finalize()
+
+            second = CSVSaver(output_dir=tempdir, overwrite=True)
+            second.save(np.array([2.0]), {'filename_or_obj': 'new'})
+            filepath = second.finalize()
+
+            rows = _read_rows(filepath)
+            self.assertEqual(rows, [['new', '2.0']])
+
+
+if __name__ == '__main__':
+    unittest.main()
