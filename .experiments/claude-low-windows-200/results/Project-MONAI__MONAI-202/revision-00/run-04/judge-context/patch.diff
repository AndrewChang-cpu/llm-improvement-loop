+# limitations under the License.
+
+import os
+import csv
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Collects predictions item by item and writes them to a single CSV file (``predictions.csv``)
+    in ``output_dir``. Each row is ``filename,value1,value2,...``. It does not depend on any ignite engine.
+    """
+
+    def __init__(self, output_dir='./', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            overwrite (bool): whether to overwrite existing CSV file content. If not overwriting,
+                previously saved results are loaded from the existing file before new ones are added.
+        """
+        self.output_dir = output_dir
+        self.overwrite = overwrite
+        self._prediction_dict = {}
+        self._preds_filepath = os.path.join(output_dir, 'predictions.csv')
+
+    def save(self, data, meta_data):
+        """
+        Store the prediction of one item in memory. It is written to file by ``finalize``.
+
+        Args:
+            data (Tensor or numpy.ndarray): prediction of this item.
+            meta_data (dict): metadata of this item, must contain ``'filename_or_obj'`` as the row key.
+        """
+        filename = meta_data['filename_or_obj']
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._prediction_dict[filename] = np.asarray(data).astype(np.float32)
+
+    def finalize(self):
+        """
+        Write the stored predictions to the CSV file.
+
+        Returns:
+            str: the path of the CSV file.
+        """
+        if not self.overwrite and os.path.exists(self._preds_filepath):
+            with open(self._preds_filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._prediction_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._preds_filepath, 'w') as f:
+            for k, v in sorted(self._prediction_dict.items()):
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+        return self._preds_filepath
