+import os
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+
+            # set up engine
+            def _train_func(engine, batch):
+                return torch.ones((2, 1, 4, 5, 6))
+
+            engine = Engine(_train_func)
+
+            # set up testing handler
+            saver = SegmentationSaver(output_path=tempdir, output_ext='.nii.gz', output_postfix='seg')
+            saver.attach(engine)
+
+            affine = np.stack([np.eye(4), np.eye(4)])
+            data = [{'filename_or_obj': ['testfile0', 'testfile1'], 'affine': affine, 'original_affine': affine}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            for name in ['testfile0', 'testfile1']:
+                filepath = os.path.join(tempdir, name, '{}_seg.nii.gz'.format(name))
+                self.assertTrue(os.path.exists(filepath))
+                loaded = nib.load(filepath).get_fdata()
+                self.assertEqual(loaded.shape, (4, 5, 6, 1))
+                np.testing.assert_allclose(loaded, 1.0)
+
+    def test_saved_without_affine(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+
+            def _train_func(engine, batch):
+                return torch.zeros((1, 2, 3, 3))
+
+            engine = Engine(_train_func)
+            SegmentationSaver(output_path=tempdir, output_ext='.nii.gz', output_postfix='seg').attach(engine)
+
+            data = [{'filename_or_obj': ['noaffine']}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            filepath = os.path.join(tempdir, 'noaffine', 'noaffine_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+            self.assertEqual(nib.load(filepath).get_fdata().shape, (3, 3, 2))
+
+
+if __name__ == '__main__':
+    unittest.main()
