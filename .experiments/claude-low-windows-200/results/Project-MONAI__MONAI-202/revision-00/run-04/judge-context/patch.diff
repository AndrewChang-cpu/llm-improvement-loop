                                                                     max_out=max_out, animation_axes=[1],
                                                                     image_axes=[2, 3], scale_factor=scale_factor),
                                           global_step)
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot the data to TensorBoard as an image. 2D data (H, W) is written as a plain image.
+    3D data (C, H, W) is written as one 2D image per channel (up to ``max_channels``), or as an RGB image
+    when it has 3 channels and ``max_channels`` is 3. Data with 4 or more dimensions is written as an
+    animated GIF along the last spatial axis (typically depth), one per channel (up to ``max_channels``).
+
+    Args:
+        data (numpy.ndarray or torch.Tensor): data to plot, the first dimension is the batch dimension.
+        step (int): global step value to record.
+        writer (SummaryWriter): TensorBoard SummaryWriter to write to.
+        index (int): which element of the batch to plot, defaults to the first one.
+        max_channels (int): number of channels to plot.
+        max_frames (int): number of frames for 2D-t (animated GIF) plot.
+        tag (str): tag name used in TensorBoard.
+    """
+    if torch.is_tensor(data):
+        data = data.detach().cpu().numpy()
+    if not isinstance(data, np.ndarray):
+        raise ValueError('data must be an ndarray or tensor.')
+
+    d = data[index]  # show the selected element in a batch
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        dataformats = 'HW'
+        writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+        return
+
+    if d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            dataformats = 'CHW'
+            writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+            return
+        for j, d2 in enumerate(d[:max_channels]):
+            d2 = rescale_array(d2, 0, 1)
+            dataformats = 'HW'
+            writer.add_image('{}_{}_{}'.format(tag, dataformats, j), d2, step, dataformats=dataformats)
+            return
+
+    if d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
+        return
