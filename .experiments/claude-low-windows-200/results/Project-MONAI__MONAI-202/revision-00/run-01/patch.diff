+# limitations under the License.
+
+import os
+import csv
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Collects per-item predictions and writes them to a CSV file, one row per item:
+    ``filename,value_0,value_1,...``. This class has no dependency on ignite; the ignite
+    handlers in ``monai.handlers`` are thin wrappers around it.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the CSV file written in ``output_dir``.
+            overwrite (bool): whether to overwrite existing CSV file content. If False, previously saved
+                results in the file are loaded first and kept unless replaced by new results.
+        """
+        self.output_dir = output_dir
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._prediction_dict = {}
+
+    def save(self, key, data):
+        """
+        Store the prediction for one item.
+
+        Args:
+            key (str): identifier of the item, written in the first column of the CSV file.
+            data (numpy.ndarray or torch.Tensor or list): prediction values, flattened before writing.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._prediction_dict[key] = np.asarray(data).astype(np.float32)
+
+    def finalize(self):
+        """
+        Write all stored predictions to the CSV file, sorted by key. Creates ``output_dir`` if needed.
+
+        Returns:
+            str: path of the written file.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._prediction_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in sorted(self._prediction_dict.items()):
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+        return self._filepath
