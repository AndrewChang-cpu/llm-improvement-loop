+import glob
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.visualizer import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [[2, 20, 20]],  # batch of 2D images
+    [[2, 1, 20, 20]],  # batch of 2D images, one channel
+    [[2, 3, 20, 20]],  # RGB-like channels
+    [[2, 2, 20, 20, 20]],  # batch of 3D images, 2 channels
+    [[2, 1, 20, 20, 20]],
+]
+
+
+class TestPlotImage(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        writer = SummaryWriter(log_dir=self.tempdir)
+        data = np.random.normal(size=shape)
+        plot_2d_or_3d_image(data, step=0, writer=writer, index=0, max_channels=2, max_frames=4, tag='test')
+        writer.flush()
+        writer.close()
+        self.assertTrue(len(glob.glob(os.path.join(self.tempdir, 'events.out.tfevents*'))) > 0)
+
+    def test_plot_tensor_input(self):
+        writer = SummaryWriter(log_dir=self.tempdir)
+        plot_2d_or_3d_image(torch.rand(2, 1, 16, 16), step=1, writer=writer, tag='tensor')
+        writer.flush()
+        writer.close()
+        self.assertTrue(len(glob.glob(os.path.join(self.tempdir, 'events.out.tfevents*'))) > 0)
+
+    def test_invalid_input_raises(self):
+        writer = SummaryWriter(log_dir=self.tempdir)
+        with self.assertRaises(ValueError):
+            plot_2d_or_3d_image([[1, 2]], step=0, writer=writer)
+        writer.close()
+
+
+if __name__ == '__main__':
+    unittest.main()
