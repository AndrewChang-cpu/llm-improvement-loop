+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def test_save_numpy(self):
+        saver = NiftiSaver(output_dir=self.tempdir, output_postfix='seg', output_ext='.nii.gz')
+        data = np.random.rand(1, 8, 8, 4).astype(np.float32)  # channel-first
+        out_file = saver.save(data, os.path.join('/input', 'test_image.nii.gz'), np.eye(4), np.eye(4))
+
+        expected = os.path.join(self.tempdir, 'test_image', 'test_image_seg.nii.gz')
+        self.assertEqual(out_file, expected)
+        self.assertTrue(os.path.exists(expected))
+
+        loaded = nib.load(expected).get_fdata()
+        self.assertEqual(loaded.shape, (8, 8, 4, 1))  # saved channel-last
+        np.testing.assert_allclose(loaded[..., 0], data[0], rtol=1e-5)
+
+    def test_save_tensor_and_postfix(self):
+        saver = NiftiSaver(output_dir=self.tempdir, output_postfix='pred', output_ext='.nii')
+        data = torch.ones(2, 6, 6, 6)  # two channels
+        out_file = saver.save(data, 'case0.nii.gz')
+
+        self.assertEqual(out_file, os.path.join(self.tempdir, 'case0', 'case0_pred.nii'))
+        loaded = nib.load(out_file).get_fdata()
+        self.assertEqual(loaded.shape, (6, 6, 6, 2))
+        np.testing.assert_allclose(loaded, 1.0)
+
+    def test_create_file_basename_keeps_relative_folder(self):
+        base = NiftiSaver._create_file_basename('seg', os.path.join('/data', 'sub', 'img.nii.gz'),
+                                                self.tempdir, data_root_dir='/data')
+        self.assertEqual(base, os.path.join(self.tempdir, 'sub', 'img', 'img_seg'))
+        self.assertTrue(os.path.isdir(os.path.join(self.tempdir, 'sub', 'img')))
+
+
+if __name__ == '__main__':
+    unittest.main()
