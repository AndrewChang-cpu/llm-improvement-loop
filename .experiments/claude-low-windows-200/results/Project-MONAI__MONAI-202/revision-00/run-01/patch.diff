+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(path):
+    with open(path, 'r') as f:
+        return [row for row in csv.reader(f)]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def test_save_and_finalize(self):
+        out_dir = os.path.join(self.tempdir, 'nested')
+        saver = CSVSaver(output_dir=out_dir)
+        saver.save('b_file', torch.tensor([0.5, 0.25]))
+        saver.save('a_file', np.array([1.0, 2.0]))
+        path = saver.finalize()
+
+        self.assertEqual(path, os.path.join(out_dir, 'predictions.csv'))
+        rows = _read_rows(path)
+        self.assertEqual(rows[0][0], 'a_file')  # sorted by key
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [1.0, 2.0])
+        self.assertEqual(rows[1][0], 'b_file')
+        self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [0.5, 0.25])
+        self.assertEqual(len(rows), 2)
+
+    def test_not_overwrite_keeps_previous_results(self):
+        saver = CSVSaver(output_dir=self.tempdir)
+        saver.save('old', [3.0])
+        saver.finalize()
+
+        saver2 = CSVSaver(output_dir=self.tempdir, overwrite=False)
+        saver2.save('new', [4.0])
+        rows = _read_rows(saver2.finalize())
+        self.assertEqual([row[0] for row in rows], ['new', 'old'])
+
+    def test_overwrite_replaces_previous_results(self):
+        saver = CSVSaver(output_dir=self.tempdir, overwrite=True)
+        saver.save('old', [3.0])
+        saver.finalize()
+
+        saver2 = CSVSaver(output_dir=self.tempdir, overwrite=True)
+        saver2.save('new', [4.0])
+        rows = _read_rows(saver2.finalize())
+        self.assertEqual([row[0] for row in rows], ['new'])
+
+
+if __name__ == '__main__':
+    unittest.main()
