+import os
+import shutil
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = os.path.join('.', 'tempdir_seg')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        # set up engine
+        def _train_func(engine, batch):
+            return torch.ones((2, 1, 4, 4, 4))
+
+        engine = Engine(_train_func)
+
+        # set up testing handler
+        saver = SegmentationSaver(output_path=default_dir, output_postfix='seg', output_ext='.nii.gz')
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['testfile0.nii.gz', 'testfile1.nii.gz'],
+                 'affine': [np.eye(4), np.eye(4)],
+                 'original_affine': [np.eye(4), np.eye(4)]}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+        for i in range(2):
+            filepath = os.path.join(default_dir, 'testfile' + str(i), 'testfile' + str(i) + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+            loaded = nib.load(filepath).get_fdata()
+            self.assertEqual(loaded.shape, (4, 4, 4, 1))
+            np.testing.assert_allclose(loaded, 1.0)
+        shutil.rmtree(default_dir)
+
+
+if __name__ == '__main__':
+    unittest.main()
