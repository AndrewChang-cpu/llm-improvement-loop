+import glob
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(2, 20, 20)],
+    [(3, 20, 20)],
+    [(20, 20, 20)],
+    [(2, 20, 20, 20)],
+    [(2, 2, 20, 20, 20)],
+]
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        tempdir = tempfile.mkdtemp()
+        try:
+            writer = SummaryWriter(log_dir=tempdir)
+            data = np.random.normal(size=shape)
+            plot_2d_or_3d_image(data, 0, writer, index=0, max_channels=1, max_frames=4, tag='test')
+            writer.flush()
+            writer.close()
+            self.assertTrue(len(glob.glob(os.path.join(tempdir, '*'))) > 0)
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
