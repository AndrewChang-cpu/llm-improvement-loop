+import glob
+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            def _train_func(engine, batch):
+                return torch.ones((2, 1, 4, 5, 6))
+
+            engine = Engine(_train_func)
+            saver = SegmentationSaver(output_path=tempdir, output_postfix='seg', output_ext='.nii.gz')
+            saver.attach(engine)
+
+            data = [{'filename_or_obj': ['case0.nii.gz', 'case1.nii.gz'],
+                     'affine': [np.eye(4), np.eye(4)],
+                     'original_affine': [np.eye(4), np.eye(4)]}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            files = sorted(glob.glob(os.path.join(tempdir, '*', '*.nii.gz')))
+            self.assertEqual(len(files), 2)
+            img = nib.load(files[0])
+            self.assertEqual(img.shape, (4, 5, 6, 1))
+            np.testing.assert_allclose(np.asanyarray(img.dataobj), 1.0)
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
