+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            saver = NiftiSaver(output_dir=tempdir, output_postfix='seg', output_ext='.nii.gz')
+            data = torch.randint(0, 2, size=(1, 4, 5, 6)).float()
+            affine = np.eye(4)
+            out = saver.save(data, 'subject/image.nii.gz', affine)
+
+            self.assertEqual(out, os.path.join(tempdir, 'image', 'image_seg.nii.gz'))
+            self.assertTrue(os.path.exists(out))
+            img = nib.load(out)
+            self.assertEqual(img.shape, (4, 5, 6, 1))
+            np.testing.assert_allclose(np.asanyarray(img.dataobj).squeeze(), data.numpy()[0])
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_create_file_basename(self):
+        path = NiftiSaver._create_file_basename('seg', '/root/a/b/case.nii.gz', '/out', data_root_dir='/root')
+        self.assertEqual(path, os.path.join('/out', 'a', 'b', 'case', 'case_seg'))
+
+
+if __name__ == '__main__':
+    unittest.main()
