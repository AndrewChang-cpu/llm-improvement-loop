+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import numpy as np
+import torch
+
+from monai.transforms.utils import rescale_array
+from monai.visualize import img2tensorboard
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot a batch item of an image to a TensorBoard writer. This is the framework-independent core used by
+    event handlers (e.g. ``monai.handlers.TensorBoardImageHandler``); it does not depend on ignite.
+
+    2D data (H, W) is written as a single image. Data with a channel dimension (C, H, W) is written per
+    channel (or as RGB when there are 3 channels and ``max_channels`` is 3). For 3D data (C, H, W, D) or
+    higher, each of up to ``max_channels`` channels is written as an animated GIF along the last axis.
+
+    Args:
+        data (numpy.ndarray or torch.Tensor): data with batch as the first dimension, shape (N, C, ...).
+        step (int): global step number to write the image at.
+        writer (SummaryWriter): TensorBoard SummaryWriter to write to.
+        index (int): index of the batch item to plot.
+        max_channels (int): number of channels to plot.
+        max_frames (int): number of frames for 2D-t plot.
+        tag (str): tag prefix for the written images.
+    """
+    if torch.is_tensor(data):
+        data = data.detach().cpu().numpy()
+    if not isinstance(data, np.ndarray):
+        raise ValueError('data must be an ndarray or tensor.')
+
+    d = data[index]
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        dataformats = 'HW'
+        writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+        return
+
+    if d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            dataformats = 'CHW'
+            writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+            return
+        for j, d2 in enumerate(d[:max_channels]):
+            d2 = rescale_array(d2, 0, 1)
+            dataformats = 'HW'
+            writer.add_image('{}_{}_{}'.format(tag, dataformats, j), d2, step, dataformats=dataformats)
+            return
+
+    if d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            img2tensorboard.add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
+        return
