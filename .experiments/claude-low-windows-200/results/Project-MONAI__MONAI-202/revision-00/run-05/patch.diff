+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASES = [
+    [(1, 10, 12), 'image.nii.gz', 'seg'],
+    [(2, 8, 9, 10), 'subdir/image.nii', 'pred'],
+]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_saved_file(self, shape, input_name, postfix):
+        saver = NiftiSaver(output_dir=self.tempdir, output_postfix=postfix, output_ext='.nii.gz')
+        data = np.random.rand(*shape).astype(np.float32)
+        affine = np.eye(4)
+
+        out_path = saver.save(data, input_name, affine)
+
+        base = os.path.splitext(os.path.splitext(os.path.basename(input_name))[0])[0]
+        expected = os.path.join(self.tempdir, base, base + '_' + postfix + '.nii.gz')
+        self.assertEqual(out_path, expected)
+        self.assertTrue(os.path.exists(expected))
+
+        loaded = nib.load(expected).get_fdata()
+        # the saver moves the channel axis to the end
+        self.assertEqual(loaded.shape, tuple(shape[1:]) + (shape[0],))
+        np.testing.assert_allclose(loaded, np.moveaxis(data, 0, -1), rtol=1e-5)
+
+    def test_tensor_input(self):
+        saver = NiftiSaver(output_dir=self.tempdir)
+        data = torch.rand(1, 5, 6)
+        out_path = saver.save(data, 'case.nii', np.eye(4))
+        self.assertTrue(os.path.exists(out_path))
+        self.assertEqual(nib.load(out_path).shape, (5, 6, 1))
+
+    def test_dtype_conversion(self):
+        saver = NiftiSaver(output_dir=self.tempdir, dtype='uint8')
+        data = np.ones((1, 4, 4), dtype=np.float32) * 3
+        out_path = saver.save(data, 'case.nii', np.eye(4))
+        self.assertEqual(nib.load(out_path).get_data_dtype(), np.dtype('uint8'))
+
+
+if __name__ == '__main__':
+    unittest.main()
