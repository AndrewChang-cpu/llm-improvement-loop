+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Collects per-item results (e.g. classification predictions) and writes them to one CSV file.
+    Each row is ``<key>,<value_0>,<value_1>,...``. This is the framework-independent core used by
+    event handlers (e.g. ``monai.handlers.ClassificationSaver``); it does not depend on ignite.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the CSV file written in ``output_dir``.
+            overwrite (bool): whether to overwrite existing CSV file content. If not overwriting,
+                results already present in the file are loaded before ``finalize`` writes the file.
+        """
+        self.output_dir = output_dir
+        self.filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._data_dict = {}
+
+    def save(self, data, filename):
+        """
+        Store the result for one item.
+
+        Args:
+            data (numpy.ndarray or torch.Tensor or float or list): result for this item.
+            filename (str): key identifying the item, written as the first column of its row.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._data_dict[filename] = np.asarray(data).astype(np.float32)
+
+    def finalize(self):
+        """
+        Write all stored results to the CSV file, sorted by key. Creates ``output_dir`` if needed.
+        """
+        if not self.overwrite and os.path.exists(self.filepath):
+            with open(self.filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._data_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self.filepath, 'w') as f:
+            for k, v in sorted(self._data_dict.items()):
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
