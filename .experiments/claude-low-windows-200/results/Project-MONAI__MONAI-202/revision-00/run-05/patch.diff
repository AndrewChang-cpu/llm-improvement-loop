+import glob
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.visualizer import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(2, 20, 20)],          # batch of 2D images
+    [(2, 20, 20, 20)],      # batch of 3D images, single channel
+    [(2, 2, 20, 20, 20)],   # batch of 3D images with 2 channels
+    [(2, 3, 20, 20)],       # batch of 2D images with 3 channels
+]
+
+
+class _RecordingWriter:
+    """Minimal writer that records what would be written to TensorBoard."""
+
+    def __init__(self):
+        self.images = []
+        self.gifs = []
+
+    def add_image(self, tag, img, step, dataformats):
+        self.images.append((tag, np.asarray(img).shape, step, dataformats))
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def test_2d_image_written_as_hw(self):
+        writer = _RecordingWriter()
+        data = np.random.rand(2, 16, 16).astype(np.float32)
+        plot_2d_or_3d_image(data, 7, writer, index=0, max_channels=1, tag='input_0')
+        self.assertEqual(writer.images, [('input_0_HW', (16, 16), 7, 'HW')])
+
+    def test_tensor_input_accepted(self):
+        writer = _RecordingWriter()
+        data = torch.rand(1, 1, 8, 8)
+        plot_2d_or_3d_image(data, 1, writer, index=0, max_channels=1, tag='output')
+        self.assertEqual(len(writer.images), 1)
+        # a single-channel (C, H, W) item is written per channel with a channel index suffix
+        self.assertEqual(writer.images[0][0], 'output_HW_0')
+
+    def test_rgb_written_as_chw(self):
+        writer = _RecordingWriter()
+        data = np.random.rand(1, 3, 8, 8).astype(np.float32)
+        plot_2d_or_3d_image(data, 2, writer, index=0, max_channels=3, tag='output')
+        self.assertEqual(writer.images, [('output_CHW', (3, 8, 8), 2, 'CHW')])
+
+    def test_invalid_type_raises(self):
+        with self.assertRaises(ValueError):
+            plot_2d_or_3d_image([[1, 2], [3, 4]], 0, _RecordingWriter())
+
+    @parameterized.expand(TEST_CASES)
+    def test_real_summary_writer(self, shape):
+        log_dir = os.path.join(self.tempdir, 'runs')
+        writer = SummaryWriter(log_dir=log_dir)
+        data = np.random.normal(size=shape)
+        plot_2d_or_3d_image(data, 3, writer, index=0, max_channels=2, max_frames=4, tag='input_0')
+        writer.flush()
+        writer.close()
+        self.assertTrue(os.path.exists(log_dir))
+        self.assertTrue(len(glob.glob(os.path.join(log_dir, '*'))) > 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
