+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def test_saved_nifti_files(self):
+        output = torch.rand(2, 1, 6, 7, 8)
+
+        def _train_func(engine, batch):
+            return output
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_path=self.tempdir, output_postfix='seg', output_ext='.nii.gz')
+        saver.attach(engine)
+
+        names = ['case_a.nii', 'case_b.nii.gz']
+        data = [{'filename_or_obj': names, 'affine': [np.eye(4), np.eye(4)],
+                 'original_affine': [np.eye(4), np.eye(4)]}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+        for i, name in enumerate(names):
+            base = name.split('.')[0]
+            path = os.path.join(self.tempdir, base, base + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(path), path)
+            loaded = nib.load(path).get_fdata()
+            self.assertEqual(loaded.shape, (6, 7, 8, 1))
+            np.testing.assert_allclose(loaded[..., 0], output[i, 0].numpy(), rtol=1e-5)
+
+    def test_no_affine_metadata(self):
+        def _train_func(engine, batch):
+            return torch.zeros(1, 1, 4, 4)
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_path=self.tempdir)
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['plain.nii']}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+        self.assertTrue(os.path.exists(os.path.join(self.tempdir, 'plain', 'plain_seg.nii.gz')))
+
+
+if __name__ == '__main__':
+    unittest.main()
