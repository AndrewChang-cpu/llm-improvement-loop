+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def _read_rows(self, path):
+        with open(path, 'r') as f:
+            return list(csv.reader(f))
+
+    def test_saved_content_sorted(self):
+        out_dir = os.path.join(self.tempdir, 'nested')
+        saver = CSVSaver(output_dir=out_dir)
+        saver.save(torch.tensor([0.5, 1.5]), 'b')
+        saver.save(np.array([2.0, 3.0]), 'a')
+        saver.finalize()
+
+        self.assertTrue(os.path.exists(os.path.join(out_dir, 'predictions.csv')))
+        rows = self._read_rows(saver.filepath)
+        self.assertEqual(rows[0][0], 'a')
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [2.0, 3.0])
+        self.assertEqual(rows[1][0], 'b')
+        self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [0.5, 1.5])
+        self.assertEqual(len(rows), 2)
+
+    def test_custom_filename(self):
+        saver = CSVSaver(output_dir=self.tempdir, filename='out.csv')
+        saver.save(1.0, 'x')
+        saver.finalize()
+        self.assertEqual(saver.filepath, os.path.join(self.tempdir, 'out.csv'))
+        self.assertEqual(self._read_rows(saver.filepath), [['x', '1.0']])
+
+    def test_no_overwrite_keeps_previous_rows(self):
+        first = CSVSaver(output_dir=self.tempdir)
+        first.save([1.0, 2.0], 'old')
+        first.finalize()
+
+        second = CSVSaver(output_dir=self.tempdir, overwrite=False)
+        second.save([3.0, 4.0], 'new')
+        second.finalize()
+
+        rows = self._read_rows(second.filepath)
+        self.assertEqual([r[0] for r in rows], ['new', 'old'])
+
+    def test_overwrite_replaces_previous_rows(self):
+        first = CSVSaver(output_dir=self.tempdir)
+        first.save([1.0], 'old')
+        first.finalize()
+
+        second = CSVSaver(output_dir=self.tempdir, overwrite=True)
+        second.save([3.0], 'new')
+        second.finalize()
+
+        rows = self._read_rows(second.filepath)
+        self.assertEqual([r[0] for r in rows], ['new'])
+
+
+if __name__ == '__main__':
+    unittest.main()
