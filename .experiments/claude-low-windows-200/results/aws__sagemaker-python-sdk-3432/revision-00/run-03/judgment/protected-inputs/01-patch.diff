diff --git a/src/sagemaker/image_uris.py b/src/sagemaker/image_uris.py
index 01ed5f1..deeed13 100644
--- a/src/sagemaker/image_uris.py
+++ b/src/sagemaker/image_uris.py
@@ -172,6 +172,14 @@ def retrieve(
 
     repo = version_config["repository"]
 
+    if version_config.get("instance_architecture") == "graviton" and not (
+        _is_graviton_instance_type(instance_type)
+    ):
+        raise ValueError(
+            "Framework version {} is only available for Graviton instance types "
+            "(e.g. ml.c6g.4xlarge, ml.t4g.2xlarge), not {}.".format(version, instance_type)
+        )
+
     processor = _processor(
         instance_type,
         config.get("processors") or version_config.get("processors"),
@@ -380,6 +388,9 @@ def _processor(instance_type, available_processors, serverless_inference_config=
             # 'cpu' or 'gpu'.
             if family in available_processors:
                 processor = family
+            elif _is_graviton_family(family):
+                # Graviton (ARM) instances use the CPU image tag.
+                processor = "cpu"
             elif family.startswith("inf"):
                 processor = "inf"
             elif family[0] in ("g", "p"):
@@ -396,6 +407,19 @@ def _processor(instance_type, available_processors, serverless_inference_config=
     return processor
 
 
+def _is_graviton_family(family):
+    """Returns True if the instance family is an AWS Graviton (ARM) family, e.g. c6g, t4g, g5g."""
+    return re.match(r"^[a-z]+\d+g[dne]*$", family) is not None
+
+
+def _is_graviton_instance_type(instance_type):
+    """Returns True if the instance type belongs to a Graviton (ARM) family."""
+    if not instance_type:
+        return False
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    return bool(match) and _is_graviton_family(match[1])
+
+
 def _should_auto_select_container_version(instance_type, distribution):
     """Returns a boolean that indicates whether to use an auto-selected container version."""
     p4d = False
