diff --git a/src/sagemaker/image_uris.py b/src/sagemaker/image_uris.py
index 01ed5f1..2cdefd7 100644
--- a/src/sagemaker/image_uris.py
+++ b/src/sagemaker/image_uris.py
@@ -30,6 +30,8 @@ logger = logging.getLogger(__name__)
 
 ECR_URI_TEMPLATE = "{registry}.dkr.{hostname}/{repository}"
 HUGGING_FACE_FRAMEWORK = "huggingface"
+GRAVITON_FRAMEWORKS = ("pytorch", "tensorflow")
+GRAVITON_CONFIG_SUFFIX = "graviton"
 
 
 @override_pipeline_parameter_var
@@ -151,6 +153,8 @@ def retrieve(
             inference_tool = _get_inference_tool(inference_tool, instance_type)
             if inference_tool == "neuron":
                 _framework = f"{framework}-{inference_tool}"
+        elif _is_graviton_inference(framework, instance_type, image_scope, accelerator_type):
+            _framework = f"{framework}-{GRAVITON_CONFIG_SUFFIX}"
         config = _config_for_framework_and_scope(_framework, image_scope, accelerator_type)
 
     original_version = version
@@ -296,6 +300,20 @@ def _get_inference_tool(inference_tool, instance_type):
     return inference_tool
 
 
+def _is_graviton_inference(framework, instance_type, image_scope, accelerator_type):
+    """Returns True if the request should use the Graviton (ARM64) inference image config.
+
+    Graviton families look like ``c6g``, ``m6gd``, ``r7g``, or ``t4g``: a letter, a
+    generation number, then ``g`` (optionally followed by suffix letters).
+    """
+    if framework not in GRAVITON_FRAMEWORKS or accelerator_type or not instance_type:
+        return False
+    if image_scope not in (None, "inference"):
+        return False
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    return bool(match and re.match(r"^[cmrt]\d+g[a-z]*$", match[1]))
+
+
 def _get_latest_versions(list_of_versions):
     """Extract the latest version from the input list of available versions."""
     return sorted(list_of_versions, reverse=True)[0]
