diff --git a/tests/unit/sagemaker/image_uris/test_retrieve.py b/tests/unit/sagemaker/image_uris/test_retrieve.py
index ae37395..91e1a9b 100644
--- a/tests/unit/sagemaker/image_uris/test_retrieve.py
+++ b/tests/unit/sagemaker/image_uris/test_retrieve.py
@@ -418,6 +418,73 @@ def test_retrieve_unsupported_python_version(config_for_framework):
     assert "Supported Python version(s): py3, py37." in str(e.value)
 
 
+@pytest.mark.parametrize(
+    "family, expected",
+    [
+        ("c6g", True),
+        ("t4g", True),
+        ("m6gd", True),
+        ("c7gn", True),
+        ("c5", False),
+        ("g4dn", False),
+        ("p3", False),
+        ("inf1", False),
+    ],
+)
+def test_is_graviton_family(family, expected):
+    assert image_uris._is_graviton_family(family) is expected
+
+
+def test_retrieve_graviton_pytorch_and_tensorflow():
+    uri = image_uris.retrieve(
+        "pytorch",
+        "us-west-2",
+        version="1.12.1",
+        py_version="py38",
+        instance_type="ml.c6g.4xlarge",
+        image_scope="inference",
+    )
+    assert (
+        uri == "763104351884.dkr.ecr.us-west-2.amazonaws.com/"
+        "pytorch-inference-graviton:1.12.1-cpu-py38-ubuntu20.04-sagemaker"
+    )
+
+    uri = image_uris.retrieve(
+        "tensorflow",
+        "us-west-2",
+        version="2.9.1",
+        py_version="py38",
+        instance_type="ml.t4g.2xlarge",
+        image_scope="inference",
+    )
+    assert (
+        uri == "763104351884.dkr.ecr.us-west-2.amazonaws.com/"
+        "tensorflow-inference-graviton:2.9.1-cpu-py38-ubuntu20.04-sagemaker"
+    )
+
+    # x86 instances keep using the regular CPU image
+    uri = image_uris.retrieve(
+        "pytorch",
+        "us-west-2",
+        version="1.12.1",
+        py_version="py38",
+        instance_type="ml.m5.xlarge",
+        image_scope="inference",
+    )
+    assert uri == "763104351884.dkr.ecr.us-west-2.amazonaws.com/pytorch-inference:1.12.1-cpu-py38"
+
+    # versions without a Graviton image fall back to the CPU image
+    uri = image_uris.retrieve(
+        "pytorch",
+        "us-west-2",
+        version="1.12.0",
+        py_version="py38",
+        instance_type="ml.c6g.4xlarge",
+        image_scope="inference",
+    )
+    assert uri == "763104351884.dkr.ecr.us-west-2.amazonaws.com/pytorch-inference:1.12.0-cpu-py38"
+
+
