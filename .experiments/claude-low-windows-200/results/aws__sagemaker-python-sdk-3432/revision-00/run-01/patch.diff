+        graviton_config = version_config.get("graviton")
+        if graviton_config:
+            # Graviton DLCs live in their own repository and their tags use the "cpu" label.
+            repo = graviton_config["repository"]
+            container_version = graviton_config["container_version"]
+            py_version = _validate_py_version_and_set_if_needed(
+                py_version, graviton_config, framework
+            )
+            processor = "cpu"
+        else:
+            # This version has no Graviton image; fall back to the x86 CPU image.
+            processor = "cpu"
+
