 from __future__ import absolute_import
 
+import pytest
 from packaging.version import Version
 
 from sagemaker import image_uris
@@ -414,3 +415,55 @@ def _sagemaker_or_dlc_account(repo, region):
         )
     else:
         return DLC_ACCOUNT if region == REGION else DLC_ALTERNATE_REGION_ACCOUNTS[region]
+
+
+@pytest.mark.parametrize(
+    "gv_framework, gv_version, gv_instance_type, expected_repo, expected_tag",
+    [
+        (
+            "pytorch",
+            "1.12.1",
+            "ml.c6g.4xlarge",
+            "pytorch-inference-graviton",
+            "1.12.1-cpu-py38-ubuntu20.04-sagemaker",
+        ),
+        (
+            "tensorflow",
+            "2.9.1",
+            "ml.t4g.2xlarge",
+            "tensorflow-inference-graviton",
+            "2.9.1-cpu-py38-ubuntu20.04-sagemaker",
+        ),
+    ],
+)
+def test_graviton_inference(gv_framework, gv_version, gv_instance_type, expected_repo, expected_tag):
+    uri = image_uris.retrieve(
+        framework=gv_framework,
+        region=REGION,
+        version=gv_version,
+        instance_type=gv_instance_type,
+        image_scope="inference",
+    )
+    assert uri == "{}.dkr.ecr.{}.amazonaws.com/{}:{}".format(
+        DLC_ACCOUNT, REGION, expected_repo, expected_tag
+    )
+
+
+def test_graviton_inference_without_version_uses_only_graviton_version():
+    uri = image_uris.retrieve(framework="pytorch", region=REGION, instance_type="ml.c6g.4xlarge")
+    assert uri == (
+        "763104351884.dkr.ecr.us-west-2.amazonaws.com/"
+        "pytorch-inference-graviton:1.12.1-cpu-py38-ubuntu20.04-sagemaker"
+    )
+
+
+def test_non_graviton_instance_unaffected_by_graviton_config():
+    uri = image_uris.retrieve(
+        framework="pytorch",
+        region=REGION,
+        version="1.12.0",
+        py_version="py38",
+        instance_type="ml.c5.xlarge",
+        image_scope="inference",
+    )
+    assert "pytorch-inference:1.12.0-cpu-py38" in uri
