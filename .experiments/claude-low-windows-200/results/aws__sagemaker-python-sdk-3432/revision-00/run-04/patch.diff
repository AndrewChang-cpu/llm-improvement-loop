+GRAVITON_FRAMEWORKS = ("pytorch", "tensorflow")
+
+
+def _is_graviton_instance(instance_type):
+    """Returns True if ``instance_type`` is an AWS Graviton (arm64) CPU instance family."""
+    if not isinstance(instance_type, str):
+        return False
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    return bool(match) and match[1] in GRAVITON_INSTANCE_FAMILIES
+
+
+def _use_graviton_config(framework, instance_type, image_scope, accelerator_type):
+    """Returns True if the Graviton inference image config should be used for this request."""
+    return (
+        framework in GRAVITON_FRAMEWORKS
+        and _is_graviton_instance(instance_type)
+        and image_scope in (None, "inference")
+        and not accelerator_type
+    )
+
