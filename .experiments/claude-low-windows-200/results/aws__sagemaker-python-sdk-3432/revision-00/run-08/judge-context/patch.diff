index 01ed5f1..fb8b265 100644
--- a/src/sagemaker/image_uris.py
+++ b/src/sagemaker/image_uris.py
@@ -174,7 +174,7 @@ def retrieve(
 
     processor = _processor(
         instance_type,
-        config.get("processors") or version_config.get("processors"),
+        version_config.get("processors") or config.get("processors"),
         serverless_inference_config,
     )
 
@@ -182,6 +182,12 @@ def retrieve(
     if version_config.get("container_version"):
         container_version = version_config["container_version"][processor]
 
+    # Graviton (ARM) images share the CPU tag format but live in a separate repository.
+    tag_processor = processor
+    if processor == "graviton":
+        tag_processor = "cpu"
+        repo = f"{repo}-graviton"
+
     if framework == HUGGING_FACE_FRAMEWORK:
         pt_or_tf_version = (
             re.compile("^(pytorch|tensorflow)(.*)$").match(base_framework_version).group(2)
@@ -216,7 +222,7 @@ def retrieve(
     else:
         tag_prefix = version_config.get("tag_prefix", version)
 
-    tag = _format_tag(tag_prefix, processor, py_version, container_version, inference_tool)
+    tag = _format_tag(tag_prefix, tag_processor, py_version, container_version, inference_tool)
 
     if instance_type is not None and _should_auto_select_container_version(
         instance_type, distribution
@@ -380,6 +386,8 @@ def _processor(instance_type, available_processors, serverless_inference_config=
             # 'cpu' or 'gpu'.
             if family in available_processors:
                 processor = family
+            elif "graviton" in available_processors and _is_graviton_family(family):
+                processor = "graviton"
             elif family.startswith("inf"):
                 processor = "inf"
             elif family[0] in ("g", "p"):
@@ -396,6 +404,15 @@ def _processor(instance_type, available_processors, serverless_inference_config=
     return processor
 
 
+def _is_graviton_family(family):
+    """Returns True if the instance family is an AWS Graviton (ARM64) family.
+
+    Graviton families follow the ``<letters><generation>g[suffix]`` naming pattern,
+    e.g. c6g, m6gd, r6g, t4g, x2gd, c7g.
+    """
+    return re.match(r"^[a-z]{1,2}\d+g[a-z]*$", family) is not None
+
+
 def _should_auto_select_container_version(instance_type, distribution):
     """Returns a boolean that indicates whether to use an auto-selected container version."""
     p4d = False
diff --git a/tests/unit/sagemaker/image_uris/test_retrieve.py b/tests/unit/sagemaker/image_uris/test_retrieve.py
index ae37395..38db425 100644
--- a/tests/unit/sagemaker/image_uris/test_retrieve.py
+++ b/tests/unit/sagemaker/image_uris/test_retrieve.py
@@ -769,3 +769,45 @@ def test_retrieve_with_pipeline_variable():
         ),
         image_scope="training",
     )
+
+
+@pytest.mark.parametrize(
+    "framework,version,graviton_instance,expected",
+    [
+        (
+            "pytorch",
+            "1.12.1",
+            "ml.c6g.4xlarge",
+            "763104351884.dkr.ecr.us-west-2.amazonaws.com/pytorch-inference-graviton:"
+            "1.12.1-cpu-py38-ubuntu20.04-sagemaker",
+        ),
+        (
+            "tensorflow",
+            "2.9.1",
+            "ml.t4g.2xlarge",
+            "763104351884.dkr.ecr.us-west-2.amazonaws.com/tensorflow-inference-graviton:"
+            "2.9.1-cpu-py38-ubuntu20.04-sagemaker",
+        ),
+    ],
+)
+def test_retrieve_graviton_inference_uri(framework, version, graviton_instance, expected):
+    uri = image_uris.retrieve(
+        framework,
+        region="us-west-2",
+        version=version,
+        instance_type=graviton_instance,
+        image_scope="inference",
+    )
+    assert expected == uri
+
+
+def test_retrieve_graviton_not_used_for_versions_without_graviton_image():
+    uri = image_uris.retrieve(
+        "pytorch",
+        region="us-west-2",
+        version="1.12.0",
+        instance_type="ml.c6g.4xlarge",
+        image_scope="inference",
+    )
+    assert "pytorch-inference:1.12.0-cpu-py38" in uri
+    assert "graviton" not in uri
