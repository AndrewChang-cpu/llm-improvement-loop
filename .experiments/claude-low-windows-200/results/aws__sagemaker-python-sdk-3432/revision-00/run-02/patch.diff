diff --git a/src/sagemaker/image_uris.py b/src/sagemaker/image_uris.py
index 01ed5f1..1ba9b82 100644
--- a/src/sagemaker/image_uris.py
+++ b/src/sagemaker/image_uris.py
@@ -182,6 +182,11 @@ def retrieve(
     if version_config.get("container_version"):
         container_version = version_config["container_version"][processor]
 
+    # Graviton (ARM64) CPU instances use a dedicated image when the version config provides one
+    if processor == "cpu" and "graviton" in version_config and _is_graviton_instance(instance_type):
+        repo = version_config["graviton"]["repository"]
+        container_version = version_config["graviton"].get("container_version", container_version)
+
     if framework == HUGGING_FACE_FRAMEWORK:
         pt_or_tf_version = (
             re.compile("^(pytorch|tensorflow)(.*)$").match(base_framework_version).group(2)
@@ -396,6 +401,15 @@ def _processor(instance_type, available_processors, serverless_inference_config=
     return processor
 
 
+def _is_graviton_instance(instance_type):
+    """Returns True if the instance type is a Graviton (ARM64) CPU instance, e.g. ml.c6g.4xlarge."""
+    if not instance_type:
+        return False
+    # looks for either "ml.<family>.<size>" or "ml_<family>"
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    return bool(match and re.match(r"^[cmrt]\d+g[a-z]*$", match[1]))
+
+
 def _should_auto_select_container_version(instance_type, distribution):
     """Returns a boolean that indicates whether to use an auto-selected container version."""
     p4d = False
