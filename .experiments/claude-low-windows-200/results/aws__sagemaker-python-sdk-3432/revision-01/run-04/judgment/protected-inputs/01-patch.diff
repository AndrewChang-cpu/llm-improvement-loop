@@ -30,6 +34,8 @@ logger = logging.getLogger(__name__)
 
 ECR_URI_TEMPLATE = "{registry}.dkr.{hostname}/{repository}"
 HUGGING_FACE_FRAMEWORK = "huggingface"
+GRAVITON_IMAGE_SCOPE = "inference_graviton"
