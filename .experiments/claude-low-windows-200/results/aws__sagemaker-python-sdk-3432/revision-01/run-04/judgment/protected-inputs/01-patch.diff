+
     if framework == HUGGING_FACE_FRAMEWORK:
         pt_or_tf_version = (
             re.compile("^(pytorch|tensorflow)(.*)$").match(base_framework_version).group(2)
@@ -245,6 +258,29 @@ def retrieve(
     return ECR_URI_TEMPLATE.format(registry=registry, hostname=hostname, repository=repo)
 
 
+def _resolve_image_scope(framework, instance_type, image_scope):
+    """Returns the Graviton scope for allowed framework and family requests, else ``image_scope``.
+
+    Never raises: a non-string ``instance_type`` or an unlisted framework or family keeps the
+    caller's scope unchanged.
+    """
+    if not isinstance(framework, str) or framework not in GRAVITON_ALLOWED_FRAMEWORKS:
+        return image_scope
+    if not isinstance(instance_type, str):
+        return image_scope
+
+    # looks for either "ml.<family>.<size>" or "ml_<family>"
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    if match and match[1] in GRAVITON_ALLOWED_TARGET_INSTANCE_FAMILY:
+        return GRAVITON_IMAGE_SCOPE
+    return image_scope
+
+
+def _is_graviton_repository(framework, repo):
+    """Returns True if ``repo`` is the Graviton inference repository for ``framework``."""
+    return framework in GRAVITON_ALLOWED_FRAMEWORKS and repo == f"{framework}-inference-graviton"
+
+
 def _config_for_framework_and_scope(framework, image_scope, accelerator_type=None):
     """Loads the JSON config for the given framework and image scope."""
     config = config_for_framework(framework)
