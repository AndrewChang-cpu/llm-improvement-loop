+def _get_image_scope_from_instance_type(framework, instance_type, image_scope):
+    """Returns the effective image scope, routing allowed Graviton requests to the Graviton scope.
+
+    Only the allowed frameworks on an allowed Graviton family are overridden. Any other request
+    keeps the caller's image scope. This never raises.
+    """
+    if framework not in GRAVITON_ALLOWED_FRAMEWORKS or not isinstance(instance_type, str):
+        return image_scope
+
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    if match and match[1] in GRAVITON_ALLOWED_TARGET_INSTANCE_FAMILY:
+        return GRAVITON_INFERENCE_SCOPE
+    return image_scope
