+def _get_image_scope_from_instance_type(framework, instance_type, image_scope):
+    """Returns the effective image scope, routing allowed Graviton requests to the Graviton scope.
+
+    The Graviton scope is used when the framework is in ``GRAVITON_ALLOWED_FRAMEWORKS`` and
+    the instance type is a string whose family is in ``GRAVITON_ALLOWED_TARGET_INSTANCE_FAMILY``.
+    Otherwise, the requested ``image_scope`` is returned unchanged.
+    """
+    if not isinstance(framework, str) or framework not in fw_utils.GRAVITON_ALLOWED_FRAMEWORKS:
+        return image_scope
+    if not isinstance(instance_type, str):
+        return image_scope
+
+    # looks for either "ml.<family>.<size>" or "ml_<family>"
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    if match and match[1] in fw_utils.GRAVITON_ALLOWED_TARGET_INSTANCE_FAMILY:
+        return GRAVITON_INFERENCE_SCOPE
+    return image_scope
+
+
