+from sagemaker import image_uris
+from tests.unit.sagemaker.image_uris import expected_uris
+
+GRAVITON_FAMILIES = ("c6g", "t4g", "r6g", "m6g")
+GRAVITON_REGIONS = (
+    "af-south-1",
+    "ap-east-1",
+    "ap-northeast-1",
+    "ap-northeast-2",
+    "ap-northeast-3",
+    "ap-south-1",
+    "ap-southeast-1",
+    "ap-southeast-2",
+    "ap-southeast-3",
+    "ca-central-1",
+    "cn-north-1",
+    "cn-northwest-1",
+    "eu-central-1",
+    "eu-north-1",
+    "eu-south-1",
+    "eu-west-1",
+    "eu-west-2",
+    "eu-west-3",
+    "me-south-1",
+    "sa-east-1",
+    "us-east-1",
+    "us-east-2",
+    "us-gov-west-1",
+    "us-iso-east-1",
+    "us-west-1",
+    "us-west-2",
+)
+
+
+def test_graviton_pytorch(graviton_pytorch_version):
+    for family in GRAVITON_FAMILIES:
+        for region in GRAVITON_REGIONS:
+            uri = image_uris.retrieve(
+                "pytorch",
+                region=region,
+                version=graviton_pytorch_version,
+                instance_type="ml.{}.xlarge".format(family),
+            )
+            expected = expected_uris.graviton_framework_uri(
+                "pytorch", graviton_pytorch_version, region
+            )
+            assert expected == uri
+
+
+def test_graviton_tensorflow(graviton_tensorflow_version):
+    for family in GRAVITON_FAMILIES:
+        for region in GRAVITON_REGIONS:
+            uri = image_uris.retrieve(
+                "tensorflow",
+                region=region,
+                version=graviton_tensorflow_version,
+                instance_type="ml.{}.xlarge".format(family),
+            )
+            expected = expected_uris.graviton_framework_uri(
+                "tensorflow", graviton_tensorflow_version, region
+            )
+            assert expected == uri
