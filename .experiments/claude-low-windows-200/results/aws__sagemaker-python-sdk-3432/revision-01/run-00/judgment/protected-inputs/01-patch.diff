+def _graviton_image_scope(framework, instance_type, image_scope):
+    """Returns the Graviton image scope for allowed framework and family, else the given scope.
+
+    Never raises: a non-string instance type or any unlisted framework or family keeps
+    the caller's image scope.
+    """
+    if framework not in GRAVITON_ALLOWED_FRAMEWORKS or not isinstance(instance_type, str):
+        return image_scope
+
+    # same "ml.<family>.<size>" or "ml_<family>" pattern used for processor selection
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    if match and match[1] in GRAVITON_ALLOWED_TARGET_INSTANCE_FAMILY:
+        return GRAVITON_IMAGE_SCOPE
+    return image_scope
+
+
 def _config_for_framework_and_scope(framework, image_scope, accelerator_type=None):
