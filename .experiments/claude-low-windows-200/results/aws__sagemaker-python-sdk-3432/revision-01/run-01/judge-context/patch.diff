+def _image_scope_for_instance_type(framework, instance_type, image_scope):
+    """Returns the effective image scope for the given framework and instance type.
+
+    Allowed frameworks running on an allowed Graviton family use the Graviton scope,
+    regardless of the requested scope. Otherwise the requested scope is returned unchanged.
+    This never raises.
+    """
+    if not isinstance(framework, str) or framework not in fw_utils.GRAVITON_ALLOWED_FRAMEWORKS:
+        return image_scope
+    if not isinstance(instance_type, str):
+        return image_scope
+
+    # looks for either "ml.<family>.<size>" or "ml_<family>"
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    if match and match[1] in fw_utils.GRAVITON_ALLOWED_TARGET_INSTANCE_FAMILY:
+        return GRAVITON_IMAGE_SCOPE
+    return image_scope
+
+
 def _config_for_framework_and_scope(framework, image_scope, accelerator_type=None):
     """Loads the JSON config for the given framework and image scope."""
     config = config_for_framework(framework)
