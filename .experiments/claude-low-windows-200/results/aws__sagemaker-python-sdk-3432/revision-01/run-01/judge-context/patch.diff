+    "ap-southeast-3": "907027046896",
+    "ca-central-1": "763104351884",
+    "cn-north-1": "727897471807",
+    "cn-northwest-1": "727897471807",
+    "eu-central-1": "763104351884",
+    "eu-north-1": "763104351884",
+    "eu-south-1": "692866216735",
+    "eu-west-1": "763104351884",
+    "eu-west-2": "763104351884",
+    "eu-west-3": "763104351884",
+    "me-south-1": "217643126080",
+    "sa-east-1": "763104351884",
+    "us-east-1": "763104351884",
+    "us-east-2": "763104351884",
+    "us-gov-west-1": "442386744353",
+    "us-iso-east-1": "886529160074",
+    "us-west-1": "763104351884",
+    "us-west-2": "763104351884",
+}
+
+
+def _test_graviton_image_uris(framework, repo, fw_version):
+    for region, account in GRAVITON_REGION_ACCOUNTS.items():
+        expected = expected_uris.graviton_framework_uri(
+            repo=repo,
+            fw_version=fw_version,
+            account=account,
+            region=region,
+        )
+        for family in GRAVITON_FAMILIES:
+            uri = image_uris.retrieve(
+                framework=framework,
+                region=region,
+                version=fw_version,
+                instance_type=f"ml.{family}.xlarge",
+            )
+            assert expected == uri
+
+
+def test_graviton_pytorch(graviton_pytorch_version):
+    _test_graviton_image_uris("pytorch", "pytorch-inference-graviton", graviton_pytorch_version)
+
+
+def test_graviton_tensorflow(graviton_tensorflow_version):
+    _test_graviton_image_uris(
+        "tensorflow", "tensorflow-inference-graviton", graviton_tensorflow_version
+    )
