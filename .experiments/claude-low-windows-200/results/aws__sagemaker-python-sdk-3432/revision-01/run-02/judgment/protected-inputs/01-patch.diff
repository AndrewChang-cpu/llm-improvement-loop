--- a/src/sagemaker/image_uris.py
+++ b/src/sagemaker/image_uris.py
@@ -19,6 +19,7 @@ import os
 import re
 from typing import Optional
 
+from sagemaker import fw_utils
 from sagemaker import utils
 from sagemaker.jumpstart.utils import is_jumpstart_model_input
 from sagemaker.spark import defaults
@@ -141,6 +142,8 @@ def retrieve(
             tolerate_deprecated_model,
         )
 
+    image_scope = _get_image_scope_from_instance_type(framework, instance_type, image_scope)
+
     if training_compiler_config and (framework == HUGGING_FACE_FRAMEWORK):
         config = _config_for_framework_and_scope(
             framework + "-training-compiler", image_scope, accelerator_type
@@ -182,6 +185,10 @@ def retrieve(
     if version_config.get("container_version"):
         container_version = version_config["container_version"][processor]
 
+    # Graviton repositories ("<framework>-inference-graviton") use a "-sagemaker" container suffix.
+    if repo.endswith("-inference-graviton"):
+        container_version = "{}-sagemaker".format(container_version)
+
     if framework == HUGGING_FACE_FRAMEWORK:
         pt_or_tf_version = (
             re.compile("^(pytorch|tensorflow)(.*)$").match(base_framework_version).group(2)
@@ -245,6 +252,23 @@ def retrieve(
     return ECR_URI_TEMPLATE.format(registry=registry, hostname=hostname, repository=repo)
 
 
+def _get_image_scope_from_instance_type(framework, instance_type, image_scope):
+    """Returns the effective image scope, routing allowed Graviton requests to the Graviton scope.
+
+    Never raises: a non-string instance type or a non-Graviton family keeps the caller's scope.
+    """
+    if (
+        isinstance(framework, str)
+        and framework in fw_utils.GRAVITON_ALLOWED_FRAMEWORKS
+        and isinstance(instance_type, str)
+    ):
+        # looks for either "ml.<family>.<size>" or "ml_<family>"
+        match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+        if match and match[1] in fw_utils.GRAVITON_ALLOWED_TARGET_INSTANCE_FAMILY:
+            return "inference_graviton"
+    return image_scope
+
+
 def _config_for_framework_and_scope(framework, image_scope, accelerator_type=None):
     """Loads the JSON config for the given framework and image scope."""
     config = config_for_framework(framework)
