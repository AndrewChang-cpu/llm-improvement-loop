+from __future__ import absolute_import
+
+import pytest
+
+from sagemaker import image_uris
+from tests.unit.sagemaker.image_uris import expected_uris
+
+GRAVITON_INSTANCE_FAMILIES = ["c6g", "t4g", "r6g", "m6g"]
+GRAVITON_SCOPES = [None, "training", "inference", "inference_graviton"]
+
+GRAVITON_ACCOUNTS = {
+    "af-south-1": "626614931356",
+    "ap-east-1": "871362719292",
+    "ap-northeast-1": "763104351884",
+    "ap-northeast-2": "763104351884",
+    "ap-northeast-3": "364406365360",
+    "ap-south-1": "763104351884",
+    "ap-southeast-1": "763104351884",
+    "ap-southeast-2": "763104351884",
+    "ap-southeast-3": "907027046896",
+    "ca-central-1": "763104351884",
+    "cn-north-1": "727897471807",
+    "cn-northwest-1": "727897471807",
+    "eu-central-1": "763104351884",
+    "eu-north-1": "763104351884",
+    "eu-south-1": "692866216735",
+    "eu-west-1": "763104351884",
+    "eu-west-2": "763104351884",
+    "eu-west-3": "763104351884",
+    "me-south-1": "217643126080",
+    "sa-east-1": "763104351884",
+    "us-east-1": "763104351884",
+    "us-east-2": "763104351884",
+    "us-gov-west-1": "442386744353",
+    "us-iso-east-1": "886529160074",
+    "us-west-1": "763104351884",
+    "us-west-2": "763104351884",
+}
+
+
+def _test_graviton_uris(framework, repo, fw_version):
+    for family in GRAVITON_INSTANCE_FAMILIES:
+        instance_type = "ml.{}.xlarge".format(family)
+        for scope in GRAVITON_SCOPES:
+            for region, account in GRAVITON_ACCOUNTS.items():
+                uri = image_uris.retrieve(
+                    framework=framework,
+                    region=region,
+                    version=fw_version,
+                    py_version="py38",
+                    instance_type=instance_type,
+                    image_scope=scope,
+                )
+                expected = expected_uris.graviton_framework_uri(
+                    repo, fw_version, account, region=region
+                )
+                assert expected == uri
+
+
+def test_graviton_pytorch(graviton_pytorch_version):
+    _test_graviton_uris("pytorch", "pytorch-inference-graviton", graviton_pytorch_version)
+
+
+def test_graviton_tensorflow(graviton_tensorflow_version):
+    _test_graviton_uris(
+        "tensorflow", "tensorflow-inference-graviton", graviton_tensorflow_version
+    )
