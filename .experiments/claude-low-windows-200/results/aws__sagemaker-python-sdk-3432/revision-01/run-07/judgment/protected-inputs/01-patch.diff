@@ -280,6 +289,22 @@ def _config_for_framework_and_scope(framework, image_scope, accelerator_type=Non
     return config if "scope" in config else config[image_scope]
 
 
+def _resolve_image_scope(framework, instance_type, image_scope):
+    """Returns the Graviton image scope for allowed Graviton requests, else ``image_scope``.
+
+    Never raises: a non-string instance type or any framework or family outside the
+    allow-lists keeps the caller's scope.
+    """
+    if framework not in GRAVITON_ALLOWED_FRAMEWORKS or not isinstance(instance_type, str):
+        return image_scope
+
+    # looks for either "ml.<family>.<size>" or "ml_<family>"
+    match = re.match(r"^ml[\._]([a-z\d]+)\.?\w*$", instance_type)
+    if match and match[1] in GRAVITON_ALLOWED_TARGET_INSTANCE_FAMILY:
+        return "inference_graviton"
+    return image_scope
+
+
