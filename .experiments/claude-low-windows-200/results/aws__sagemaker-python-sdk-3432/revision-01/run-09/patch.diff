+from __future__ import absolute_import
+
+import pytest
+
+from sagemaker import image_uris
+from tests.unit.sagemaker.image_uris import expected_uris
+
+GRAVITON_INSTANCE_FAMILIES = ("c6g", "t4g", "r6g", "m6g")
+GRAVITON_REGION_ACCOUNTS = {
+    **{
+        region: "763104351884"
+        for region in (
+            "ap-northeast-1",
+            "ap-northeast-2",
+            "ap-south-1",
+            "ap-southeast-1",
+            "ap-southeast-2",
+            "ca-central-1",
+            "eu-central-1",
+            "eu-north-1",
+            "eu-west-1",
+            "eu-west-2",
+            "eu-west-3",
+            "sa-east-1",
+            "us-east-1",
+            "us-east-2",
+            "us-west-1",
+            "us-west-2",
+        )
+    },
+    "af-south-1": "626614931356",
+    "ap-east-1": "871362719292",
+    "ap-northeast-3": "364406365360",
+    "ap-southeast-3": "907027046896",
+    "cn-north-1": "727897471807",
+    "cn-northwest-1": "727897471807",
+    "eu-south-1": "692866216735",
+    "me-south-1": "217643126080",
+    "us-gov-west-1": "442386744353",
+    "us-iso-east-1": "886529160074",
+}
+
+
+def test_graviton_pytorch(graviton_pytorch_version):
+    for region, account in GRAVITON_REGION_ACCOUNTS.items():
+        for family in GRAVITON_INSTANCE_FAMILIES:
+            uri = image_uris.retrieve(
+                "pytorch",
+                region=region,
+                version=graviton_pytorch_version,
+                instance_type="ml.{}.xlarge".format(family),
+            )
+            assert uri == expected_uris.graviton_framework_uri(
+                "pytorch-inference-graviton", graviton_pytorch_version, account, region=region
+            )
+
+
+def test_graviton_tensorflow(graviton_tensorflow_version):
+    for region, account in GRAVITON_REGION_ACCOUNTS.items():
+        for family in GRAVITON_INSTANCE_FAMILIES:
+            uri = image_uris.retrieve(
+                "tensorflow",
+                region=region,
+                version=graviton_tensorflow_version,
+                instance_type="ml.{}.xlarge".format(family),
+            )
+            assert uri == expected_uris.graviton_framework_uri(
+                "tensorflow-inference-graviton", graviton_tensorflow_version, account, region=region
+            )
