+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tempdir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        base = os.path.join(self.tempdir, "data")
+        path = self._write_datalist({
+            "training": [
+                {"image": "imagesTr/a.nii.gz", "label": ["labelsTr/a.nii.gz", "./labelsTr//b.nii.gz"], "fold": 1}
+            ]
+        })
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base)
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/a.nii.gz")))
+        self.assertEqual(
+            items[0]["label"],
+            [
+                os.path.normpath(os.path.join(base, "labelsTr/a.nii.gz")),
+                os.path.normpath(os.path.join(base, "labelsTr/b.nii.gz")),
+            ],
+        )
+        self.assertEqual(items[0]["fold"], 1)
+
+    def test_cls_values(self):
+        base = os.path.join(self.tempdir, "data")
+        path = self._write_datalist({
+            "training": [{"image": "imagesTr/a.nii.gz", "label": 2}, {"image": "imagesTr/b.nii.gz", "label": 0}]
+        })
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base)
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/a.nii.gz")))
+        self.assertEqual(items[0]["label"], 2)
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        abs_image = os.path.join(self.tempdir, "abs", "image.nii.gz")
+        abs_label = os.path.join(self.tempdir, "abs", "label.nii.gz")
+        path = self._write_datalist({"training": [{"image": abs_image, "label": abs_label}]})
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+        self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        base = os.path.join(self.tempdir, "data")
+        path = self._write_datalist({"test": ["imagesTs/a.nii.gz", "imagesTs/b.nii.gz"]})
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=base)
+        self.assertEqual(len(items), 2)
+        self.assertEqual(set(items[0].keys()), {"image"})
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTs/a.nii.gz")))
+
+
+if __name__ == "__main__":
+    unittest.main()
