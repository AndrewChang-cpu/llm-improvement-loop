+import json
+import os
+
+
+def _resolve_path(value, base_dir):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory to join relative paths with.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the original order.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list contains a non-string element {element!r}, expected only strings.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value {value!r} must be a string or a list of strings, got {type(value).__name__}.")
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries stored under ``data_list_key`` are returned as a list of items, in the original order. The
+    ``"image"`` field of every item is resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; otherwise it is kept exactly as stored (for example an integer class id).
+    Any other field is kept unchanged and is never path-joined. Items without ``"image"`` or ``"label"`` are allowed.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string; it is converted to an image-only item
+    ``{"image": entry}`` before resolution.
+
+    Example:
+        A datalist entry ``{"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz", "fold": 0}`` loaded with
+        ``base_dir="/data"`` and ``is_segmentation=True`` becomes
+        ``{"image": "/data/imagesTr/a.nii.gz", "label": "/data/labelsTr/a.nii.gz", "fold": 0}``.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: whether labels are paths to resolve (True) or values to keep as stored (False).
+            Defaults to True.
+        data_list_key: key in the top-level JSON object that holds the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used.
+
+    Returns:
+        a list of dicts with the same field names as the input items. "image", and "label" in segmentation mode,
+        hold normalized paths (strings, or lists of strings when the input value was a list). All other fields
+        are unchanged.
+
+    Raises:
+        ValueError: when the datalist file does not exist, when ``data_list_key`` is missing from the JSON
+            object, when an item is not a mapping, or when a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"data_list_key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"item {item!r} in datalist file '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        result.append(new_item)
+
+    return result
