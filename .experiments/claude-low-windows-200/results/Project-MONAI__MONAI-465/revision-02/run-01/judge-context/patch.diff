+import json
+import os
+
+
+def _resolve_path(value, base_dir, key, data_list_file_path):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined to.
+        key: name of the field being resolved, used in error messages.
+        data_list_file_path: datalist path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{key}' list in {data_list_file_path} must contain only strings, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{key}' in {data_list_file_path} must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist and resolve its image (and label) paths.
+
+    The datalist is a JSON object whose entries are stored under ``data_list_key``. Each item must be a mapping.
+    The ``"image"`` field is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; otherwise it is returned exactly as stored (for example an integer class id).
+    Other fields are never path-joined and are kept unchanged. Items without ``"image"`` or ``"label"`` are allowed.
+
+    If ``data_list_key`` is ``"test"``, the entries are plain path strings in the Decathlon layout; each one is
+    converted to an image-only item ``{"image": entry}`` before validation and path resolution.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: if True, resolve the ``"label"`` field as a path. Defaults to True.
+        data_list_key: key in the top-level JSON object that holds the list of entries. Defaults to ``"training"``.
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input item. ``"image"``
+        and, in segmentation mode, ``"label"`` hold normalized paths (a string, or a list of strings when the input
+        was a list). All other fields are unchanged. For example::
+
+            [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the JSON object,
+            if an item is not a mapping, or if an ``"image"`` (or segmentation ``"label"``) value is neither a
+            string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in {data_list_file_path} must be a mapping, "
+                f"got {type(item).__name__}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
