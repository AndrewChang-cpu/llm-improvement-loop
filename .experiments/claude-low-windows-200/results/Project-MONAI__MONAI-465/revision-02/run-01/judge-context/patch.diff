+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {
+                "training": [
+                    {"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz", "fold": 0},
+                    {"image": ["imagesTr/./b1.nii.gz", "imagesTr//b2.nii.gz"], "label": "labelsTr/b.nii.gz"},
+                ]
+            }
+            path = self._write_datalist(tempdir, data)
+            base_dir = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/a.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "imagesTr/b1.nii.gz")),
+                    os.path.normpath(os.path.join(base_dir, "imagesTr/b2.nii.gz")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/b.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {"training": [{"image": "img0.nii.gz", "label": 1}, {"image": "img1.nii.gz", "label": 0}]}
+            path = self._write_datalist(tempdir, data)
+            base_dir = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, False, "training", base_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "image.nii.gz")
+            abs_label = os.path.join(tempdir, "abs", "label.nii.gz")
+            data = {
+                "training": [
+                    {"image": "rel/image.nii.gz", "label": abs_label},
+                    {"image": abs_image, "label": "x.nii.gz"},
+                ]
+            }
+            path = self._write_datalist(tempdir, data)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "rel", "image.nii.gz")))
+            self.assertEqual(result[0]["label"], abs_label)
+            self.assertEqual(result[1]["image"], abs_image)
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "x.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {"test": ["imagesTs/t0.nii.gz", "imagesTs/t1.nii.gz"]}
+            path = self._write_datalist(tempdir, data)
+            base_dir = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/t0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
