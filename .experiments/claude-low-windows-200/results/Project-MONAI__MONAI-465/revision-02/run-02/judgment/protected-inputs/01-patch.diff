+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz", "fold": 0},
+                    {"image": ["imagesTr/b0.nii.gz", "imagesTr/b1.nii.gz"], "label": "./labelsTr//b.nii.gz"},
+                ]
+            }
+            path = os.path.join(tempdir, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            base = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, True, "training", base)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base, "labelsTr/a.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base, "imagesTr/b0.nii.gz")),
+                    os.path.normpath(os.path.join(base, "imagesTr/b1.nii.gz")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base, "labelsTr/b.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "a.nii.gz", "label": 0},
+                    {"image": "b.nii.gz", "label": 2},
+                ]
+            }
+            path = os.path.join(tempdir, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            base = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, False, "training", base)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "a.nii.gz")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "b.nii.gz")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "image.nii.gz")
+            abs_label = os.path.join(tempdir, "abs", "label.nii.gz")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            path = os.path.join(tempdir, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": ["imagesTs/t0.nii.gz", "imagesTs/t1.nii.gz"]
+            }
+            path = os.path.join(tempdir, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            base = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, True, "test", base)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imagesTs/t0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
