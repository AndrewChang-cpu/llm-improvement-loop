+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """Resolve a single path string, or a list of path strings, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list in datalist file {data_list_file_path} must contain only strings, "
+                    f"got {type(element).__name__}: {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in datalist file {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}: {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as an item. The ``"image"`` field is always resolved
+    against ``base_dir``. The ``"label"`` field is resolved only when ``is_segmentation`` is True; otherwise it is
+    returned exactly as stored, whatever its JSON type (for example an integer class id). All other fields are
+    returned unchanged. Relative path strings are joined with ``base_dir`` and normalized; absolute path strings
+    keep their absolute meaning. List values are resolved element by element and keep their order.
+
+    When ``data_list_key`` equals ``"test"``, the entries are plain path strings in the Decathlon layout and each
+    one is converted into an image-only item ``{"image": entry}``.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file.
+        is_segmentation: whether the datalist is for segmentation. If True, the ``"label"`` field of each item is
+            resolved as a path. If False, the ``"label"`` field is left unchanged. Defaults to True.
+        data_list_key: key in the JSON object whose value is the list of entries. Defaults to ``"training"``.
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, in the original order of the datalist. Each dictionary has the same field names as
+        its input item, with ``"image"`` (and ``"label"`` in segmentation mode) holding resolved paths as strings,
+        or as lists of strings when the input was a list.
+
+        Example of a segmentation datalist entry resolved with ``base_dir="/data"``::
+
+            {"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz", "fold": 0}
+
+    Raises:
+        ValueError: if the datalist file does not exist.
+        ValueError: if ``data_list_key`` is not present in the parsed JSON.
+        ValueError: if an item is not a mapping.
+        ValueError: if a resolved path value is neither a string nor a list, or a list contains a non-string.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing in datalist file {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"item {index} under key '{data_list_key}' in datalist file {data_list_file_path} "
+                f"must be a mapping, got {type(item).__name__}: {item!r}"
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
