+from typing import Optional
+
+import json
+import os
+
+
+def _resolve_path(value, base_dir):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined with.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list, or a list contains a non-string.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list contains a non-string element {element!r}, expected only strings.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value {value!r} must be a string or a list of strings, got {type(value).__name__}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+):
+    """
+    Load the image and label paths of a Medical Segmentation Decathlon style datalist JSON file.
+
+    The entries are read from the list stored under ``data_list_key``. The "image" field of every
+    item is resolved against ``base_dir``. The "label" field is resolved only when ``is_segmentation``
+    is True; otherwise it is returned exactly as stored (for example an integer class id). Any other
+    field is returned unchanged. Items without "image" or "label" are not rejected.
+
+    When ``data_list_key`` is "test", the entries are plain path strings and each one is converted to an
+    image-only item ``{"image": entry}`` before resolution.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: whether the "label" field is a path to be resolved. Defaults to True.
+        data_list_key: key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are joined with. Defaults to None, which uses the
+            directory containing the datalist file.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary has the same fields as its input
+        item, with "image" (and "label" in segmentation mode) replaced by resolved paths: a normalized
+        string, or a list of normalized strings when the input value was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, ``data_list_key`` is missing from the JSON object,
+            an item is not a mapping, or a path value is neither a string nor a list of strings.
+
+    Example::
+
+        [
+            {"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 0},
+            {"image": ["/data/img1_t1.nii.gz", "/data/img1_t2.nii.gz"], "label": "/data/seg1.nii.gz", "fold": 1},
+        ]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    data_list = json_data[data_list_key]
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed_items = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"item {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        processed_items.append(new_item)
+
+    return processed_items
