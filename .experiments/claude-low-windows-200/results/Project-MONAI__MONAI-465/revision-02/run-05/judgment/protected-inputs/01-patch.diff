+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tempdir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        base_dir = os.path.join(self.tempdir, "data")
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": "./imagesTr/img0.nii.gz", "label": "labelsTr//seg0.nii.gz", "fold": 0},
+                    {"image": ["imagesTr/a.nii.gz", "imagesTr/b.nii.gz"], "label": "labelsTr/seg1.nii.gz", "fold": 1},
+                ]
+            }
+        )
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/img0.nii.gz")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/seg0.nii.gz")))
+        self.assertEqual(result[0]["fold"], 0)
+        self.assertEqual(
+            result[1]["image"],
+            [
+                os.path.normpath(os.path.join(base_dir, "imagesTr/a.nii.gz")),
+                os.path.normpath(os.path.join(base_dir, "imagesTr/b.nii.gz")),
+            ],
+        )
+        self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/seg1.nii.gz")))
+        self.assertEqual(result[1]["fold"], 1)
+
+    def test_cls_values(self):
+        base_dir = os.path.join(self.tempdir, "data")
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": "imagesTr/img0.nii.gz", "label": 0},
+                    {"image": "imagesTr/img1.nii.gz", "label": 2},
+                ]
+            }
+        )
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/img0.nii.gz")))
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["label"], 0)
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/img1.nii.gz")))
+        self.assertIsInstance(result[1]["label"], int)
+        self.assertEqual(result[1]["label"], 2)
+
+    def test_seg_no_basedir(self):
+        img = os.path.abspath(os.path.join(self.tempdir, "abs_img.nii.gz"))
+        lbl = os.path.abspath(os.path.join(self.tempdir, "abs_seg.nii.gz"))
+        path = self._write_datalist({"training": [{"image": img, "label": lbl}]})
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], img)
+        self.assertEqual(result[0]["label"], lbl)
+
+    def test_seg_no_labels(self):
+        base_dir = os.path.join(self.tempdir, "data")
+        path = self._write_datalist({"test": ["imagesTs/t0.nii.gz", "imagesTs/t1.nii.gz"]})
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/t0.nii.gz")))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
