+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """Resolve a string or list-of-strings path value against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in datalist '{data_list_file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} in datalist '{data_list_file_path}' must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    The entries stored under ``data_list_key`` are returned as a list of per-case items. The "image" field, and the
+    "label" field when ``is_segmentation`` is true, are resolved against ``base_dir``. Other fields are kept unchanged.
+    When ``is_segmentation`` is false the "label" field is returned exactly as stored (for example an integer class id).
+    If ``data_list_key`` is "test", each plain path entry is converted to an item with only an "image" field.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. The file must exist.
+        is_segmentation: whether to resolve "label" paths. Defaults to True.
+        data_list_key: top-level key holding the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are joined with. Defaults to None, which means the directory
+            containing the datalist file.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary has the same field names as its input item.
+        "image", and "label" in segmentation mode, hold normalized paths (strings, or lists of strings when the input
+        was a list). Other fields are unchanged.
+
+    Example::
+
+        [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path value
+            is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {item!r} in datalist '{data_list_file_path}' under key '{data_list_key}' must be a mapping."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        result.append(new_item)
+
+    return result
