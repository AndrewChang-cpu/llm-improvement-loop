+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _make_temp_dir(test_case):
+    tmp_dir = tempfile.mkdtemp()
+    test_case.addCleanup(shutil.rmtree, tmp_dir, True)
+    return tmp_dir
+
+
+def _write_json(directory, name, content):
+    path = os.path.join(directory, name)
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = _make_temp_dir(self)
+        base_dir = os.path.join(tmp_dir, "data")
+        datalist = {
+            "training": [
+                {"image": "./imagesTr/case_0.nii.gz", "label": "labelsTr//case_0.nii.gz", "fold": 0},
+                {"image": "imagesTr/case_1.nii.gz", "label": "labelsTr/case_1.nii.gz", "fold": 1},
+            ]
+        }
+        path = _write_json(tmp_dir, "datalist.json", datalist)
+
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(base_dir, "imagesTr", "case_0.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join(base_dir, "labelsTr", "case_0.nii.gz"))
+        self.assertEqual(result[0]["fold"], 0)
+        self.assertEqual(result[1]["image"], os.path.join(base_dir, "imagesTr", "case_1.nii.gz"))
+        self.assertEqual(result[1]["label"], os.path.join(base_dir, "labelsTr", "case_1.nii.gz"))
+        self.assertEqual(result[1]["fold"], 1)
+
+    def test_cls_values(self):
+        tmp_dir = _make_temp_dir(self)
+        base_dir = os.path.join(tmp_dir, "data")
+        datalist = {
+            "training": [
+                {"image": "imagesTr/case_0.nii.gz", "label": 0},
+                {"image": "imagesTr/case_1.nii.gz", "label": 2},
+            ]
+        }
+        path = _write_json(tmp_dir, "datalist.json", datalist)
+
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(base_dir, "imagesTr", "case_0.nii.gz"))
+        self.assertEqual(result[0]["label"], 0)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[1]["image"], os.path.join(base_dir, "imagesTr", "case_1.nii.gz"))
+        self.assertEqual(result[1]["label"], 2)
+        self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = _make_temp_dir(self)
+        abs_image = os.path.join(tmp_dir, "abs", "image.nii.gz")
+        abs_label = os.path.join(tmp_dir, "abs", "label.nii.gz")
+        datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+        path = _write_json(tmp_dir, "datalist.json", datalist)
+
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        tmp_dir = _make_temp_dir(self)
+        base_dir = os.path.join(tmp_dir, "data")
+        datalist = {"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]}
+        path = _write_json(tmp_dir, "datalist.json", datalist)
+
+        result = load_decathalon_datalist(path, data_list_key="test", base_dir=base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(base_dir, "imagesTs", "case_0.nii.gz"))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
