+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "root")
+            datalist = {
+                "training": [
+                    {"image": "./imagesTr/case_0.nii.gz", "label": "labelsTr//case_0.nii.gz", "fold": 1},
+                    {"image": ["imagesTr/a.nii.gz", "./imagesTr/b.nii.gz"], "label": "labelsTr/a.nii.gz"},
+                ]
+            }
+            path = self._write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "training", base)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base, "labelsTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(
+                result[1]["image"],
+                [os.path.normpath(os.path.join(base, "imagesTr/a.nii.gz")),
+                 os.path.normpath(os.path.join(base, "imagesTr/b.nii.gz"))],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base, "labelsTr/a.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "root")
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": 0},
+                    {"image": "imagesTr/case_1.nii.gz", "label": 2},
+                ]
+            }
+            path = self._write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, False, "training", base)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "imagesTr/case_1.nii.gz")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "image.nii.gz")
+            abs_label = os.path.join(tempdir, "abs", "label.nii.gz")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            path = self._write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+            self.assertTrue(os.path.isabs(result[0]["image"]))
+            self.assertTrue(os.path.isabs(result[0]["label"]))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "root")
+            datalist = {"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]}
+            path = self._write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "test", base)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imagesTs/case_0.nii.gz")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "imagesTs/case_1.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
