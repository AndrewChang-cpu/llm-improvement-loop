+import json
+import os
+
+
+def _resolve_path(value, base_dir):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined with.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list, or a list contains a non-string element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list element must be a string, got {type(element).__name__}: {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str, is_segmentation: bool = True, data_list_key: str = "training", base_dir=None
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items with
+    their image (and, in segmentation mode, label) paths resolved against ``base_dir``.
+
+    The top-level JSON object must contain ``data_list_key``; its value is the list of entries.
+    Each entry must be a mapping. The ``"image"`` field is always resolved as a path (a string or a
+    list of strings). The ``"label"`` field is resolved as a path only when ``is_segmentation`` is True;
+    otherwise it is returned exactly as stored (for example an integer class id or a class name string).
+    Any other field is left unchanged. Items without ``"image"`` or ``"label"`` are accepted.
+
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted into an
+    image-only item ``{"image": entry}`` before any validation or path resolution.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: whether labels are paths to be resolved (True) or pass-through values (False).
+            Defaults to True.
+        data_list_key: key in the JSON object under which the list of entries is stored. Defaults to "training".
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input item, with
+        resolved ``"image"`` (and, in segmentation mode, ``"label"``) values as strings or lists of strings.
+
+    Raises:
+        ValueError: if the datalist file does not exist, ``data_list_key`` is missing from the JSON object,
+            an item is not a mapping, or a path value is neither a string nor a list of strings.
+
+    Example::
+
+        [
+            {"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"},
+            {"image": "/data/imagesTr/case_1.nii.gz", "label": "/data/labelsTr/case_1.nii.gz"},
+        ]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing in datalist file: {data_list_file_path}")
+
+    items = json_data[data_list_key]
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in items]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(f"datalist item must be a mapping, got {type(item).__name__}: {item!r}")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        result.append(new_item)
+    return result
