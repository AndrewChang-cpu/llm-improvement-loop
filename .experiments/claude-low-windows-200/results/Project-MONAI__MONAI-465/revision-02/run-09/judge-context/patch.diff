+import json
+import os
+
+
+def _resolve_path(value, base_dir, field):
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value: a string, or a list whose elements are all strings.
+        base_dir: directory used as the join base.
+        field: name of the datalist field, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings in the original order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' contains a non-string element {element!r} in base dir '{base_dir}'.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' must be a string or a list of strings, got {type(value).__name__}: {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is turned into an item. The ``"image"`` field is always resolved
+    against ``base_dir``. The ``"label"`` field is resolved only when ``is_segmentation`` is True; otherwise
+    it is returned exactly as stored (for example an integer class id or a class name string). All other
+    fields are returned unchanged and are never path-joined. Items without ``"image"`` or ``"label"`` are
+    accepted.
+
+    When ``data_list_key`` equals ``"test"``, each entry is a plain path string. Each one is converted to an
+    image-only item ``{"image": entry}`` before path resolution, regardless of ``is_segmentation``.
+
+    The default ``data_list_key`` is ``"training"``. A datalist that only contains a ``"test"`` key must be
+    loaded by passing ``data_list_key="test"`` explicitly.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: if True, resolve the ``"label"`` field as a path. If False, leave labels unchanged.
+        data_list_key: key in the top-level JSON object whose value is the list of entries.
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary has the same field names as its input
+        item. ``"image"`` and, in segmentation mode, ``"label"`` hold normalized paths. A value that was a list
+        in the input stays a list of normalized paths. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist.
+        ValueError: if the top-level JSON object does not contain ``data_list_key``.
+        ValueError: if an item is not a mapping.
+        ValueError: if an ``"image"`` value, or a ``"label"`` value in segmentation mode, is neither a string
+            nor a list of strings.
+
+    Example::
+
+        {
+            "training": [
+                {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 0}
+            ]
+        }
+
+        load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "<datalist dir>/imagesTr/case_0.nii.gz",
+        #   "label": "<datalist dir>/labelsTr/case_0.nii.gz", "fold": 0}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in key '{data_list_key}' of '{data_list_file_path}' is not a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image")
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label")
+        output.append(new_item)
+    return output
