+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imagesTr/a.nii.gz", "label": "labelsTr/./a.nii.gz", "fold": 1},
+                    {"image": ["imagesTr/b0.nii.gz", "imagesTr/b1.nii.gz"], "label": "labelsTr//b.nii.gz"},
+                ]
+            }
+            path = _write_datalist(tempdir, content)
+            base = os.path.join(tempdir, "root")
+            items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/a.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(base, "labelsTr/a.nii.gz")))
+            self.assertEqual(items[0]["fold"], 1)
+            self.assertEqual(
+                items[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base, "imagesTr/b0.nii.gz")),
+                    os.path.normpath(os.path.join(base, "imagesTr/b1.nii.gz")),
+                ],
+            )
+            self.assertEqual(items[1]["label"], os.path.normpath(os.path.join(base, "labelsTr/b.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imagesTr/a.nii.gz", "label": 0},
+                    {"image": "imagesTr/b.nii.gz", "label": 2},
+                ]
+            }
+            path = _write_datalist(tempdir, content)
+            base = os.path.join(tempdir, "root")
+            items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/a.nii.gz")))
+            self.assertEqual(items[0]["label"], 0)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(base, "imagesTr/b.nii.gz")))
+            self.assertEqual(items[1]["label"], 2)
+            self.assertIsInstance(items[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "image.nii.gz")
+            abs_label = os.path.join(tempdir, "abs", "label.nii.gz")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = _write_datalist(tempdir, content)
+            items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["imagesTs/a.nii.gz", "imagesTs/b.nii.gz"]}
+            path = _write_datalist(tempdir, content)
+            base = os.path.join(tempdir, "root")
+            items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=base)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTs/a.nii.gz")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
