+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: the stored path value, a string or a list of strings.
+        base_dir: directory to join relative paths with.
+        field: name of the field being resolved, used in error messages.
+        data_list_file_path: datalist path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist {data_list_file_path} contains a non-string element: {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist {data_list_file_path} must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entry list is read from ``data_list_key`` of the top-level JSON object. Each entry must be a mapping.
+    The ``"image"`` field is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; otherwise it is returned exactly as stored (for example an integer class id).
+    Relative paths are joined with ``base_dir`` and normalized, while absolute paths keep their absolute meaning.
+    Other fields are returned unchanged. Items without ``"image"`` or ``"label"`` are accepted.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string, and it is converted to an
+    image-only item ``{"image": entry}`` before any validation or path resolution.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file.
+        is_segmentation: whether ``"label"`` values are paths to resolve. Defaults to True.
+        data_list_key: key under which the entry list is stored. Defaults to "training".
+        base_dir: directory to resolve relative paths against. Defaults to None, which means the directory
+            containing ``data_list_file_path``.
+
+    Returns:
+        a list of dicts in the original entry order. Each dict has the same field names as its input item, with
+        ``"image"`` (and ``"label"`` in segmentation mode) holding resolved paths as strings, or as lists of strings
+        when the input was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the JSON object,
+            if an item is not a mapping, or if a path value is neither a string nor a list of strings.
+
+    Example::
+
+        # datalist.json: {"training": [{"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz"}]}
+        items = load_decathalon_datalist("/data/task/datalist.json", data_list_key="training")
+        # items == [{"image": "/data/task/imagesTr/a.nii.gz", "label": "/data/task/labelsTr/a.nii.gz"}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from datalist {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in datalist {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each item in datalist {data_list_file_path} must be a mapping, got {item!r}.")
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir, "label", data_list_file_path)
+        items.append(out)
+    return items
