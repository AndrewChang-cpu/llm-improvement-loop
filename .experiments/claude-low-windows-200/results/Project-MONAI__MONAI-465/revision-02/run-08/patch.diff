+import json
+import os
+from collections.abc import Mapping
+
+
+def _resolve_path(value, base_dir, file_path, data_list_key, field):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: the stored path value, a string or a list of strings.
+        base_dir: directory that relative paths are joined with.
+        file_path: datalist file path, used in error messages.
+        data_list_key: key of the entry list, used in error messages.
+        field: name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} under key '{data_list_key}' "
+                    f"in datalist file {file_path} must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} under key '{data_list_key}' in datalist file {file_path} "
+        "must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+):
+    """
+    Load the Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a new dictionary with the same fields.
+    The "image" field is always resolved against ``base_dir``. The "label" field is resolved
+    only when ``is_segmentation`` is True; otherwise it is returned exactly as stored (for
+    example an integer class id or a class-name string). Any other field is left unchanged.
+    Relative values are joined with ``base_dir`` and normalized; absolute values keep their
+    absolute meaning. Items without "image" or "label" are not an error.
+
+    When ``data_list_key`` is "test", each entry is a plain path string; it is converted to an
+    image-only item ``{"image": entry}`` before path resolution.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file.
+        is_segmentation: whether the labels are segmentation paths. If False, "label" values
+            are not resolved or type-checked.
+        data_list_key: key in the JSON object holding the list of entries, default "training".
+        base_dir: directory used to resolve relative paths. If None, the directory containing
+            the datalist file is used.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the
+        same field names as its input item, with "image" (and "label" in segmentation mode)
+        holding resolved paths: strings, or lists of strings when the input was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if the JSON does not contain
+            ``data_list_key``, if an item is not a mapping, or if a resolved path value is
+            neither a string nor a list of strings.
+
+    Example::
+
+        >>> items = load_decathalon_datalist("dataset.json", True, "training", "/data/task01")
+        >>> items[0]["image"]  # e.g. "/data/task01/imagesTr/case_000.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Item {item!r} under key '{data_list_key}' in datalist file {data_list_file_path} "
+                "must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(
+                processed["image"], base_dir, data_list_file_path, data_list_key, "image"
+            )
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(
+                processed["label"], base_dir, data_list_file_path, data_list_key, "label"
+            )
+        result.append(processed)
+    return result
