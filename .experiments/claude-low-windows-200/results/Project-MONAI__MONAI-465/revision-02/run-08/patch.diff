+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmp_dir, True)
+
+    def _write_datalist(self, content, name="dataset.json"):
+        path = os.path.join(self.tmp_dir, name)
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        base = os.path.join(self.tmp_dir, "data")
+        path = self._write_datalist({
+            "training": [
+                {"image": "./imagesTr/case0.nii.gz", "label": "labelsTr//case0.nii.gz", "fold": 0},
+                {"image": ["imagesTr/a.nii.gz", "./imagesTr/b.nii.gz"], "label": ["labelsTr/a.nii.gz"]},
+            ]
+        })
+        result = load_decathalon_datalist(path, True, "training", base)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(base, "imagesTr", "case0.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join(base, "labelsTr", "case0.nii.gz"))
+        self.assertEqual(result[0]["fold"], 0)
+        self.assertEqual(result[1]["image"], [
+            os.path.join(base, "imagesTr", "a.nii.gz"),
+            os.path.join(base, "imagesTr", "b.nii.gz"),
+        ])
+        self.assertEqual(result[1]["label"], [os.path.join(base, "labelsTr", "a.nii.gz")])
+
+    def test_cls_values(self):
+        base = os.path.join(self.tmp_dir, "data")
+        path = self._write_datalist({
+            "training": [
+                {"image": "imagesTr/case0.nii.gz", "label": 2, "name": "cat"},
+                {"image": "imagesTr/case1.nii.gz", "label": 0},
+            ]
+        })
+        result = load_decathalon_datalist(path, False, "training", base)
+        self.assertEqual(result[0]["image"], os.path.join(base, "imagesTr", "case0.nii.gz"))
+        self.assertEqual(result[0]["label"], 2)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["name"], "cat")
+        self.assertEqual(result[1]["image"], os.path.join(base, "imagesTr", "case1.nii.gz"))
+        self.assertEqual(result[1]["label"], 0)
+        self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        abs_image = os.path.join(self.tmp_dir, "abs", "image.nii.gz")
+        abs_label = os.path.join(self.tmp_dir, "abs", "label.nii.gz")
+        path = self._write_datalist({
+            "training": [{"image": "rel/image.nii.gz", "label": "rel/label.nii.gz"},
+                         {"image": abs_image, "label": abs_label}]
+        })
+        result = load_decathalon_datalist(path, True, "training", None)
+        self.assertEqual(result[0]["image"],
+                         os.path.normpath(os.path.join(self.tmp_dir, "rel", "image.nii.gz")))
+        self.assertEqual(result[0]["label"],
+                         os.path.normpath(os.path.join(self.tmp_dir, "rel", "label.nii.gz")))
+        self.assertEqual(result[1]["image"], abs_image)
+        self.assertEqual(result[1]["label"], abs_label)
+
+    def test_seg_no_labels(self):
+        base = os.path.join(self.tmp_dir, "data")
+        path = self._write_datalist({
+            "test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]
+        })
+        result = load_decathalon_datalist(path, True, "test", base)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(base, "imagesTs", "case0.nii.gz"))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
