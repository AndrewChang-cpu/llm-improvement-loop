+import json
+import os
+
+
+def _resolve_path(value, base_dir, field):
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value: a string, or a list whose elements are all strings.
+        base_dir: directory that relative paths are joined to.
+        field: name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' contains a non-string element {element!r}; expected a string or list of strings."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' has type {type(value).__name__}; expected a string or list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items with
+    their ``image`` (and, in segmentation mode, ``label``) paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: if True, the ``label`` field is resolved as a path. If False, ``label`` is
+            returned exactly as stored, whatever its type (e.g. an integer class id).
+        data_list_key: key under which the list of entries is stored in the JSON object.
+            Defaults to ``"training"``. If it equals ``"test"``, each plain path string is converted
+            into an image-only item ``{"image": entry}``.
+        base_dir: directory that relative paths are joined to. Defaults to the directory containing
+            ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input item.
+        ``image`` is a resolved path string, or a list of resolved path strings when the input was a list.
+        In segmentation mode ``label`` is resolved the same way. All other fields are unchanged.
+        Only ``image`` and ``label`` are path-resolved; no other field is joined to ``base_dir``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing from the JSON object, an item is not
+            a mapping, or an ``image`` (or segmentation ``label``) value is neither a string nor a list of strings.
+
+    Example::
+
+        # dataset.json contains: {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 0}]}
+        load_decathalon_datalist("dataset.json", True, "training", "/data")
+        # [{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 0}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in '{data_list_file_path}' is not a mapping."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image")
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label")
+        processed.append(new_item)
+
+    return processed
