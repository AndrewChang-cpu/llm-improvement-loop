+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.test_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        base_dir = os.path.join(self.test_dir, "data")
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": "./imgs//img0.nii.gz", "label": ["seg0.nii.gz", "seg0b.nii.gz"], "fold": 1},
+                    {"image": "img1.nii.gz", "label": "seg1.nii.gz"},
+                ]
+            }
+        )
+        result = load_decathalon_datalist(path, True, "training", base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs", "img0.nii.gz")))
+        self.assertEqual(
+            result[0]["label"],
+            [
+                os.path.normpath(os.path.join(base_dir, "seg0.nii.gz")),
+                os.path.normpath(os.path.join(base_dir, "seg0b.nii.gz")),
+            ],
+        )
+        self.assertEqual(result[0]["fold"], 1)
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "img1.nii.gz")))
+        self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base_dir, "seg1.nii.gz")))
+
+    def test_cls_values(self):
+        base_dir = os.path.join(self.test_dir, "data")
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 0},
+                    {"image": "img1.nii.gz", "label": 2},
+                ]
+            }
+        )
+        result = load_decathalon_datalist(path, False, "training", base_dir)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img0.nii.gz")))
+        self.assertEqual(result[0]["label"], 0)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "img1.nii.gz")))
+        self.assertEqual(result[1]["label"], 2)
+        self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        abs_image = os.path.join(self.test_dir, "abs_img.nii.gz")
+        abs_label = os.path.join(self.test_dir, "abs_seg.nii.gz")
+        path = self._write_datalist({"training": [{"image": abs_image, "label": abs_label}]})
+        result = load_decathalon_datalist(path, True, "training", None)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        self.assertTrue(os.path.isabs(result[0]["image"]))
+        self.assertTrue(os.path.isabs(result[0]["label"]))
+
+    def test_seg_no_labels(self):
+        base_dir = os.path.join(self.test_dir, "data")
+        path = self._write_datalist({"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]})
+        result = load_decathalon_datalist(path, True, "test", base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(base_dir, "imgs", "t0.nii.gz"))})
+        self.assertEqual(result[1], {"image": os.path.normpath(os.path.join(base_dir, "imgs", "t1.nii.gz"))})
+
+
+if __name__ == "__main__":
+    unittest.main()
