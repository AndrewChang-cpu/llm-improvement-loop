+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+):
+    """
+    Load image/label (if exists) information from the Medical Segmentation Decathlon (MSD) style JSON datalist.
+    The file is expected to contain a dictionary with a key (default "training" or "test") mapping to a list
+    of items. Each item is either a dictionary with "image" (and optionally "label") file paths, or,
+    when ``is_segmentation=False``, a plain image file path string (as used in MSD test sets).
+    Relative paths are resolved against ``base_dir``.
+
+    Returns a list of dictionaries. Each dictionary contains an "image" key, and a "label" key if
+    ``is_segmentation=True`` and the item provides one. Any other keys in the item are kept unchanged.
+
+    Example of a datalist file::
+
+        {
+            "name": "Spleen",
+            "training": [
+                {"image": "imagesTr/spleen_1.nii.gz", "label": "labelsTr/spleen_1.nii.gz"},
+                {"image": "imagesTr/spleen_2.nii.gz", "label": "labelsTr/spleen_2.nii.gz"}
+            ],
+            "test": ["imagesTs/spleen_3.nii.gz"]
+        }
+
+    Args:
+        data_list_file_path (str): the path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist has "image" and "label" pairs. If True, each item must
+            contain a "label" key. If False, items may be plain image paths or dictionaries with only "image".
+        data_list_key (str): the key in the JSON file which holds the list to load, e.g. "training" or "test".
+        base_dir (str): the base directory used to resolve relative file paths. Defaults to the directory
+            containing ``data_list_file_path``.
+
+    Raises:
+        ValueError: when ``data_list_key`` is not in the file, or an item does not match the expected format.
+    """
+    if base_dir is None:
+        base_dir = os.path.dirname(os.path.abspath(data_list_file_path))
+
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is not found in '{data_list_file_path}'.")
+
+    expected_data = json_data[data_list_key]
+    if not isinstance(expected_data, list):
+        raise ValueError(f"data list '{data_list_key}' in '{data_list_file_path}' must be a list.")
+
+    result = []
+    for item in expected_data:
+        if isinstance(item, str):
+            if is_segmentation:
+                raise ValueError(f"segmentation datalist item must be a dictionary with 'image' and 'label': {item}.")
+            result.append({"image": os.path.join(base_dir, item)})
+            continue
+        if not isinstance(item, dict) or "image" not in item:
+            raise ValueError(f"datalist item must be a dictionary with an 'image' key: {item}.")
+        if is_segmentation and "label" not in item:
+            raise ValueError(f"segmentation datalist item must contain a 'label' key: {item}.")
+
+        new_item = dict(item)
+        for k in ("image", "label"):
+            if k in new_item:
+                new_item[k] = os.path.join(base_dir, new_item[k])
+        result.append(new_item)
+
+    return result
+
