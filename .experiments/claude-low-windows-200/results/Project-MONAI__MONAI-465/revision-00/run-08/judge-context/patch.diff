+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+SEG_DATALIST = {
+    "name": "Spleen",
+    "training": [
+        {"image": "imagesTr/spleen_1.nii.gz", "label": "labelsTr/spleen_1.nii.gz"},
+        {"image": "imagesTr/spleen_2.nii.gz", "label": "labelsTr/spleen_2.nii.gz", "fold": 1},
+    ],
+    "test": ["imagesTs/spleen_3.nii.gz"],
+}
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+        self.json_path = os.path.join(self.tempdir, "dataset.json")
+        with open(self.json_path, "w") as f:
+            json.dump(SEG_DATALIST, f)
+
+    def tearDown(self):
+        for root, dirs, files in os.walk(self.tempdir, topdown=False):
+            for name in files:
+                os.remove(os.path.join(root, name))
+            for name in dirs:
+                os.rmdir(os.path.join(root, name))
+        os.rmdir(self.tempdir)
+
+    def test_segmentation_training(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=True, data_list_key="training")
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(self.tempdir, "imagesTr/spleen_1.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join(self.tempdir, "labelsTr/spleen_1.nii.gz"))
+        self.assertEqual(result[1]["image"], os.path.join(self.tempdir, "imagesTr/spleen_2.nii.gz"))
+        self.assertEqual(result[1]["label"], os.path.join(self.tempdir, "labelsTr/spleen_2.nii.gz"))
+        # extra keys are preserved
+        self.assertEqual(result[1]["fold"], 1)
+
+    def test_explicit_base_dir(self):
+        base_dir = "/data/root"
+        result = load_decathlon_datalist(self.json_path, data_list_key="training", base_dir=base_dir)
+        self.assertEqual(result[0]["image"], os.path.join(base_dir, "imagesTr/spleen_1.nii.gz"))
+
+    def test_test_set_without_labels(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="test")
+        self.assertEqual(result, [{"image": os.path.join(self.tempdir, "imagesTs/spleen_3.nii.gz")}])
+
+    def test_missing_key_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+    def test_missing_label_raises_for_segmentation(self):
+        bad = {"training": [{"image": "a.nii.gz"}]}
+        path = os.path.join(self.tempdir, "bad.json")
+        with open(path, "w") as f:
+            json.dump(bad, f)
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(path, is_segmentation=True, data_list_key="training")
+
+    def test_string_item_raises_for_segmentation(self):
+        bad = {"training": ["a.nii.gz"]}
+        path = os.path.join(self.tempdir, "bad2.json")
+        with open(path, "w") as f:
+            json.dump(bad, f)
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(path, is_segmentation=True, data_list_key="training")
+
+
+if __name__ == "__main__":
+    unittest.main()
