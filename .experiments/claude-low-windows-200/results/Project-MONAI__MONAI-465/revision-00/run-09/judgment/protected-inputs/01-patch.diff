+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[dict]:
+    """
+    Load a datalist for Medical Segmentation Decathlon (MSD) format from a JSON config file.
+
+    The JSON file is expected to contain a top-level dictionary with a key (default ``"training"``) whose value is a
+    list of dictionaries, one per data item, e.g.::
+
+        {
+            "training": [
+                {"image": "imagesTr/la_003.nii.gz", "label": "labelsTr/la_003.nii.gz"},
+                ...
+            ],
+            "test": ["imagesTs/la_004.nii.gz", ...]
+        }
+
+    Args:
+        data_list_file_path (str): the path to the JSON file that contains the datalist.
+        is_segmentation (bool): whether the datalist is used for segmentation. If True, every item must be a dictionary
+            containing a ``"label"`` key. Defaults to True.
+        data_list_key (str): the key in the JSON file whose value is the list to load, e.g. ``"training"`` or
+            ``"test"``. Defaults to ``"training"``.
+        base_dir (str, optional): base directory prepended to the file paths in each item (for example, the root
+            folder of the Decathlon dataset). If None, the paths are returned unchanged. Defaults to None.
+
+    Returns:
+        A list of data items, in the same order as in the JSON file. Dictionary items keep their keys; string
+        items are returned as strings.
+
+    Raises:
+        ValueError: if ``data_list_key`` is missing, its value is not a list, or an item does not match the format
+            required by ``is_segmentation``.
+    """
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' not found in '{data_list_file_path}'.")
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"value of '{data_list_key}' in '{data_list_file_path}' must be a list.")
+
+    for item in data_list:
+        if is_segmentation and (not isinstance(item, dict) or "label" not in item):
+            raise ValueError(
+                f"every item in '{data_list_key}' must be a dictionary with a 'label' key for segmentation."
+            )
+
+    if base_dir is None:
+        return data_list
+
+    def _join(value):
+        if isinstance(value, list):
+            return [_join(v) for v in value]
+        if isinstance(value, str):
+            return os.path.join(base_dir, value)
+        return value
+
+    return [
+        {k: _join(v) for k, v in item.items()} if isinstance(item, dict) else _join(item) for item in data_list
+    ]
+
