+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+DATA = {
+    "name": "Test",
+    "training": [
+        {"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz"},
+        {"image": "imagesTr/b.nii.gz", "label": "labelsTr/b.nii.gz"},
+    ],
+    "test": ["imagesTs/c.nii.gz", "imagesTs/d.nii.gz"],
+    "bad_label": [{"image": "imagesTr/e.nii.gz"}],
+    "not_list": {"image": "imagesTr/f.nii.gz"},
+}
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+        self.json_path = os.path.join(self.tempdir, "dataset.json")
+        with open(self.json_path, "w") as f:
+            json.dump(DATA, f)
+
+    def test_load_training_default(self):
+        result = load_decathlon_datalist(self.json_path)
+        self.assertEqual(result, DATA["training"])
+
+    def test_load_with_base_dir(self):
+        result = load_decathlon_datalist(self.json_path, base_dir="/root")
+        self.assertEqual(result[0]["image"], os.path.join("/root", "imagesTr/a.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join("/root", "labelsTr/a.nii.gz"))
+        self.assertEqual(len(result), 2)
+
+    def test_load_test_list_without_segmentation(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="test", base_dir="/r")
+        self.assertEqual(result, [os.path.join("/r", "imagesTs/c.nii.gz"), os.path.join("/r", "imagesTs/d.nii.gz")])
+
+    def test_missing_key(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+    def test_missing_label_for_segmentation(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="bad_label")
+
+    def test_not_a_list(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="not_list")
+
+
+if __name__ == "__main__":
+    unittest.main()
