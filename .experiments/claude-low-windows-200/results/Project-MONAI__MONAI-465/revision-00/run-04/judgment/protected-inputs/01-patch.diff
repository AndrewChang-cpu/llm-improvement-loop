+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict]:
+    """
+    Load the Medical Segmentation Decathlon style datalist from a JSON file.
+
+    The file is expected to be a JSON object whose `data_list_key` entry is a list of dictionaries, for example::
+
+        {
+            "training": [
+                {"image": "imagesTr/la_003.nii.gz", "label": "labelsTr/la_003.nii.gz"},
+                {"image": "imagesTr/la_004.nii.gz", "label": "labelsTr/la_004.nii.gz"}
+            ],
+            "test": ["imagesTs/la_001.nii.gz", "imagesTs/la_002.nii.gz"]
+        }
+
+    Relative file paths (string values, or each string in a list value) are resolved against `base_dir`.
+    Absolute paths are kept as they are. Non-path values are passed through unchanged.
+
+    Args:
+        data_list_file_path (str): the path to the JSON datalist file.
+        is_segmentation (bool): if True, every item must be a dictionary containing an "image" key
+            (and a "label" key for segmentation tasks). Defaults to True.
+        data_list_key (str): the key in the JSON file which holds the list to load, e.g. "training" or "test".
+            Defaults to "training".
+        base_dir (str, optional): the directory to resolve relative paths against. Defaults to the directory
+            containing `data_list_file_path`.
+
+    Returns:
+        a list of dictionaries (or other items, if `is_segmentation` is False) with paths resolved.
+
+    Raises:
+        ValueError: if the file does not exist, `data_list_key` is missing, or items do not have the required keys.
+    """
+    data_list_file_path = os.path.abspath(os.path.expanduser(data_list_file_path))
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' not found in {data_list_file_path}.")
+
+    expected_data = json_data[data_list_key]
+    if not isinstance(expected_data, list):
+        raise ValueError(f"data list '{data_list_key}' must be a list, got {type(expected_data).__name__}.")
+
+    required_keys = ("image", "label") if is_segmentation else ()
+    for item in expected_data:
+        if not isinstance(item, dict):
+            if is_segmentation:
+                raise ValueError(f"each item in '{data_list_key}' must be a dictionary, got {item!r}.")
+            continue
+        missing = [k for k in required_keys if k not in item]
+        if missing:
+            raise ValueError(f"item {item} in '{data_list_key}' is missing required keys: {missing}.")
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    def _resolve(value):
+        if isinstance(value, str):
+            return os.path.join(base_dir, value)
+        if isinstance(value, list):
+            return [_resolve(v) for v in value]
+        return value
+
+    result = []
+    for item in expected_data:
+        if isinstance(item, dict):
+            result.append({k: _resolve(v) for k, v in item.items()})
+        else:
+            result.append(_resolve(item))
+    return result
+
