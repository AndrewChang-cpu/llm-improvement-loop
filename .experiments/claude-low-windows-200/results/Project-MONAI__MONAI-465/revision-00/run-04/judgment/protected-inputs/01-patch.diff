+import json
+import os
+import tempfile
+import unittest
+
+from parameterized import parameterized
+
+from monai.data import load_decathlon_datalist
+
+DATA = {
+    "training": [
+        {"image": "imagesTr/la_003.nii.gz", "label": "labelsTr/la_003.nii.gz"},
+        {"image": "imagesTr/la_004.nii.gz", "label": "labelsTr/la_004.nii.gz", "extra": 5},
+    ],
+    "test": ["imagesTs/la_001.nii.gz", "imagesTs/la_002.nii.gz"],
+    "bad": {"image": "x"},
+    "partial": [{"image": "imagesTr/la_005.nii.gz"}],
+}
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.json_path = os.path.join(self.tmp.name, "dataset.json")
+        with open(self.json_path, "w") as f:
+            json.dump(DATA, f)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_default_resolves_against_json_dir(self):
+        result = load_decathlon_datalist(self.json_path)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(self.tmp.name, "imagesTr/la_003.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join(self.tmp.name, "labelsTr/la_003.nii.gz"))
+        self.assertEqual(result[1]["extra"], 5)
+
+    def test_test_key_with_list_of_strings(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="test")
+        self.assertEqual(result, [os.path.join(self.tmp.name, "imagesTs/la_001.nii.gz"),
+                                  os.path.join(self.tmp.name, "imagesTs/la_002.nii.gz")])
+
+    def test_custom_base_dir(self):
+        result = load_decathlon_datalist(self.json_path, base_dir="/data")
+        self.assertEqual(result[0]["image"], os.path.join("/data", "imagesTr/la_003.nii.gz"))
+
+    def test_does_not_mutate_file_contents(self):
+        load_decathlon_datalist(self.json_path)
+        with open(self.json_path) as f:
+            self.assertEqual(json.load(f)["training"][0]["image"], "imagesTr/la_003.nii.gz")
+
+    @parameterized.expand(
+        [
+            ("missing_file", os.path.join("nonexistent", "dataset.json"), "training", True),
+            ("missing_key", None, "validation", True),
+            ("not_a_list", None, "bad", True),
+            ("missing_label", None, "partial", True),
+        ]
+    )
+    def test_invalid_inputs(self, _, path, key, is_seg):
+        if path is None:
+            path = self.json_path
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(path, is_segmentation=is_seg, data_list_key=key)
+
+
+if __name__ == "__main__":
+    unittest.main()
