+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+SAMPLE_DATALIST = {
+    "name": "Spleen",
+    "training": [
+        {"image": "imagesTr/spleen_1.nii.gz", "label": "labelsTr/spleen_1.nii.gz"},
+        {"image": "imagesTr/spleen_2.nii.gz", "label": "labelsTr/spleen_2.nii.gz"},
+    ],
+    "test": [{"image": "imagesTs/spleen_3.nii.gz"}],
+}
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.TemporaryDirectory()
+        self.json_path = os.path.join(self.tmp_dir.name, "dataset.json")
+        with open(self.json_path, "w") as f:
+            json.dump(SAMPLE_DATALIST, f)
+
+    def tearDown(self):
+        self.tmp_dir.cleanup()
+
+    def test_default_base_dir_is_json_dir(self):
+        result = load_decathlon_datalist(self.json_path)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(
+            result[0]["image"], os.path.join(self.tmp_dir.name, "imagesTr", "spleen_1.nii.gz")
+        )
+        self.assertEqual(
+            result[0]["label"], os.path.join(self.tmp_dir.name, "labelsTr", "spleen_1.nii.gz")
+        )
+
+    def test_custom_base_dir(self):
+        result = load_decathlon_datalist(self.json_path, base_dir="/data")
+        self.assertEqual(result[1]["image"], os.path.normpath("/data/imagesTr/spleen_2.nii.gz"))
+
+    def test_test_key_without_label(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="test")
+        self.assertEqual(len(result), 1)
+        self.assertNotIn("label", result[0])
+        self.assertEqual(result[0]["image"], os.path.join(self.tmp_dir.name, "imagesTs", "spleen_3.nii.gz"))
+
+    def test_segmentation_requires_label(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="test")
+
+    def test_missing_key_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+
+if __name__ == "__main__":
+    unittest.main()
