+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+):
+    """Load an image/label datalist in the Medical Segmentation Decathlon JSON format.
+
+    The file is expected to be a JSON object whose `data_list_key` entry is a list of
+    dictionaries, e.g. ``{"training": [{"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz"}]}``.
+    Each item is returned as a dictionary. Relative file paths are joined with `base_dir`.
+
+    Args:
+        data_list_file_path (str): the path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist contains segmentation labels. If True, every item
+            must contain both "image" and "label" keys. If False, only "image" is required and the
+            "label" key is kept if present.
+        data_list_key (str): the key of the list to load from the JSON file, e.g. "training" or "test".
+        base_dir (str): the base directory that relative paths in the datalist are resolved against.
+            If None, the directory containing `data_list_file_path` is used.
+
+    Returns:
+        A list of dictionaries, one per item in `data_list_key`, with file paths resolved.
+
+    Raises:
+        ValueError: when `data_list_key` is missing or an item lacks required keys.
+    """
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+    if data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is not found in '{data_list_file_path}'.")
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    required_keys = ["image", "label"] if is_segmentation else ["image"]
+    data = []
+    for item in json_data[data_list_key]:
+        for key in required_keys:
+            if key not in item:
+                raise ValueError(f"item {item} in '{data_list_key}' is missing the required key '{key}'.")
+        resolved = {}
+        for key, value in item.items():
+            if isinstance(value, str):
+                resolved[key] = os.path.normpath(os.path.join(base_dir, value))
+            elif isinstance(value, list):
+                resolved[key] = [os.path.normpath(os.path.join(base_dir, v)) if isinstance(v, str) else v for v in value]
+            else:
+                resolved[key] = value
+        data.append(resolved)
+    return data
+
