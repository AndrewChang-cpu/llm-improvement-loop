+def _join_path(base_dir: str, path):
+    """Join `path` to `base_dir` if `path` is a relative string, otherwise return it unchanged."""
+    if isinstance(path, str):
+        return path if os.path.isabs(path) else os.path.normpath(os.path.join(base_dir, path))
+    if isinstance(path, (list, tuple)):
+        return [_join_path(base_dir, p) for p in path]
+    return path
+
+
+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Union[str, List[str]]]]:
+    """
+    Load a data list in the Medical Segmentation Decathlon JSON format and return it as a list of dictionaries,
+    which can be directly used to create a `monai.data.Dataset` (or its subclasses).
+
+    The JSON file is expected to contain a key `data_list_key` (for example ``"training"`` or ``"test"``) whose
+    value is a list of items. For segmentation tasks each item is a dictionary with an ``"image"`` entry and a
+    ``"label"`` entry, and both can be a single path or a list of paths (e.g. multi-modal inputs). Any other
+    keys in an item are kept unchanged. For non-segmentation tasks each item only needs an ``"image"`` entry.
+    Relative paths are resolved against `base_dir`; absolute paths are kept as they are.
+
+    Example of a JSON file::
+
+        {
+            "name": "Spleen",
+            "training": [
+                {"image": "imagesTr/spleen_1.nii.gz", "label": "labelsTr/spleen_1.nii.gz"},
+                {"image": "imagesTr/spleen_2.nii.gz", "label": "labelsTr/spleen_2.nii.gz"}
+            ],
+            "test": ["imagesTs/spleen_3.nii.gz", "imagesTs/spleen_4.nii.gz"]
+        }
+
+    Args:
+        data_list_file_path (str): the path to the JSON file that contains the data list.
+        is_segmentation (bool): whether the datalist is for a segmentation task, which requires both
+            ``"image"`` and ``"label"`` entries in every item. Default is True.
+        data_list_key (str): the key of the data list in the JSON file, default is ``"training"``.
+        base_dir (str, optional): the base directory used to resolve relative paths. If None, the directory
+            that contains `data_list_file_path` is used.
+
+    Returns:
+        A list of dictionaries, one per data item, with file paths resolved.
+
+    Raises:
+        ValueError: if `data_list_key` is not in the JSON file, or an item lacks a required entry.
+    """
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is not specified in the json file '{data_list_file_path}'.")
+
+    expected_data = json_data[data_list_key]
+    if base_dir is None:
+        base_dir = os.path.dirname(os.path.abspath(data_list_file_path))
+
+    required_keys = ["image", "label"] if is_segmentation else ["image"]
+    data = []
+    for i, item in enumerate(expected_data):
+        if not isinstance(item, dict):
+            raise ValueError(f"item {i} in data list '{data_list_key}' must be a dictionary, got {type(item)}.")
+        for key in required_keys:
+            if key not in item:
+                raise ValueError(f"item {i} in data list '{data_list_key}' is missing the '{key}' entry.")
+        new_item = dict(item)
+        for key in required_keys:
+            new_item[key] = _join_path(base_dir, item[key])
+        data.append(new_item)
+    return data
+
