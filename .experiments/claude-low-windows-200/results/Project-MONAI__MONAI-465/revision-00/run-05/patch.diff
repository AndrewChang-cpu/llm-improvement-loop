+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+        self.json_path = os.path.join(self.tempdir, "dataset.json")
+        self.content = {
+            "name": "Spleen",
+            "training": [
+                {"image": "imagesTr/spleen_1.nii.gz", "label": "labelsTr/spleen_1.nii.gz", "extra": 1},
+                {"image": "imagesTr/spleen_2.nii.gz", "label": "labelsTr/spleen_2.nii.gz", "extra": 2},
+            ],
+            "test": [{"image": ["imagesTs/a.nii.gz", "imagesTs/b.nii.gz"]}],
+        }
+        with open(self.json_path, "w") as f:
+            json.dump(self.content, f)
+
+    def test_segmentation_default(self):
+        data = load_decathlon_datalist(self.json_path)
+        self.assertEqual(len(data), 2)
+        self.assertEqual(data[0]["image"], os.path.join(self.tempdir, "imagesTr", "spleen_1.nii.gz"))
+        self.assertEqual(data[0]["label"], os.path.join(self.tempdir, "labelsTr", "spleen_1.nii.gz"))
+        self.assertEqual(data[1]["extra"], 2)
+
+    def test_custom_base_dir(self):
+        data = load_decathlon_datalist(self.json_path, base_dir="/data")
+        self.assertEqual(data[0]["image"], os.path.normpath(os.path.join("/data", "imagesTr/spleen_1.nii.gz")))
+
+    def test_absolute_path_kept(self):
+        abs_path = os.path.join(self.tempdir, "x.nii.gz")
+        with open(self.json_path, "w") as f:
+            json.dump({"training": [{"image": abs_path, "label": abs_path}]}, f)
+        data = load_decathlon_datalist(self.json_path)
+        self.assertEqual(data[0]["image"], abs_path)
+
+    def test_list_key_and_multimodal_non_segmentation(self):
+        data = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="test")
+        self.assertEqual(
+            data[0]["image"],
+            [
+                os.path.join(self.tempdir, "imagesTs", "a.nii.gz"),
+                os.path.join(self.tempdir, "imagesTs", "b.nii.gz"),
+            ],
+        )
+
+    def test_missing_key_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+    def test_missing_label_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="test")
+
+
+if __name__ == "__main__":
+    unittest.main()
