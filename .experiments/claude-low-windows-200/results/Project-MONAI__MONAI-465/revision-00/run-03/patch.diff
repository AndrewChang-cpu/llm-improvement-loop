+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+DATA = {
+    "training": [
+        {"image": "imagesTr/img0001.nii.gz", "label": "labelsTr/label0001.nii.gz"},
+        {"image": "imagesTr/img0002.nii.gz", "label": "labelsTr/label0002.nii.gz"},
+    ],
+    "test": ["imagesTs/img0003.nii.gz", "imagesTs/img0004.nii.gz"],
+    "classes": [{"image": ["a.nii.gz", "b.nii.gz"]}],
+}
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.TemporaryDirectory()
+        self.json_path = os.path.join(self.tmp_dir.name, "datalist.json")
+        with open(self.json_path, "w") as f:
+            json.dump(DATA, f)
+
+    def tearDown(self):
+        self.tmp_dir.cleanup()
+
+    def test_segmentation_default_base_dir(self):
+        result = load_decathlon_datalist(self.json_path)
+        base = os.path.dirname(os.path.abspath(self.json_path))
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(base, "imagesTr/img0001.nii.gz"))
+        self.assertEqual(result[1]["label"], os.path.join(base, "labelsTr/label0002.nii.gz"))
+
+    def test_custom_base_dir_and_key(self):
+        result = load_decathlon_datalist(self.json_path, data_list_key="test", base_dir="/data")
+        self.assertEqual(
+            result, [os.path.join("/data", "imagesTs/img0003.nii.gz"), os.path.join("/data", "imagesTs/img0004.nii.gz")]
+        )
+
+    def test_non_segmentation_list_values(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="classes", base_dir="/d")
+        self.assertEqual(result, [{"image": [os.path.join("/d", "a.nii.gz"), os.path.join("/d", "b.nii.gz")]}])
+
+    def test_missing_file(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(os.path.join(self.tmp_dir.name, "missing.json"))
+
+    def test_missing_key(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+    def test_missing_label_in_segmentation(self):
+        path = os.path.join(self.tmp_dir.name, "bad.json")
+        with open(path, "w") as f:
+            json.dump({"training": [{"image": "a.nii.gz"}]}, f)
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
