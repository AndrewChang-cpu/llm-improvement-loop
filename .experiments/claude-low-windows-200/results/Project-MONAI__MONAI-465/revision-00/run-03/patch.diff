+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+):
+    """
+    Load the image/label (or other) file paths from a Decathlon-format datalist JSON file.
+
+    The file is expected to be a JSON object containing a list of items under `data_list_key`, e.g.::
+
+        {
+            "training": [
+                {"image": "imagesTr/img0001.nii.gz", "label": "labelsTr/label0001.nii.gz"},
+                ...
+            ],
+            "test": ["imagesTs/img0002.nii.gz", ...]
+        }
+
+    Each item is either a dictionary of keys to paths, or (for classification or other tasks) a plain path string
+    or a list of paths. Relative paths are resolved against `base_dir`.
+
+    Args:
+        data_list_file_path (str): the path to the JSON datalist file.
+        is_segmentation (bool): if True, every dictionary item must contain both "image" and "label" keys.
+            Defaults to True.
+        data_list_key (str): the key in the JSON file whose value holds the list of items. Defaults to "training".
+        base_dir (str, optional): the directory used to resolve relative paths. Defaults to the directory
+            containing `data_list_file_path`.
+
+    Returns:
+        a list of data items, where each dictionary item has its path values resolved against `base_dir`.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, or the items are malformed.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file does not exist: {data_list_file_path}.")
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is not found in {data_list_file_path}.")
+    items = json_data[data_list_key]
+    if not isinstance(items, list):
+        raise ValueError(f"value of '{data_list_key}' must be a list in {data_list_file_path}.")
+
+    if base_dir is None:
+        base_dir = os.path.dirname(os.path.abspath(data_list_file_path))
+
+    def _resolve(value):
+        if isinstance(value, list):
+            return [os.path.join(base_dir, str(v)) for v in value]
+        if not isinstance(value, str):
+            raise ValueError(f"path values must be strings or lists of strings, got: {value!r}.")
+        return os.path.join(base_dir, value)
+
+    result = []
+    for item in items:
+        if isinstance(item, dict):
+            if is_segmentation and ("image" not in item or "label" not in item):
+                raise ValueError(f"segmentation items must contain 'image' and 'label' keys, got: {item}.")
+            result.append({k: _resolve(v) for k, v in item.items()})
+        else:
+            result.append(_resolve(item))
+    return result
