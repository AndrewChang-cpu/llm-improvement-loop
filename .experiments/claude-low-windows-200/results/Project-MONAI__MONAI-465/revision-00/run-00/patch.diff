+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+):
+    """
+    Load the image/label (or other) paths of a Medical Segmentation Decathlon challenge datalist from a JSON file.
+
+    The JSON file is expected to follow the Decathlon format, e.g.::
+
+        {
+            "name": "Spleen",
+            "training": [
+                {"image": "imagesTr/spleen_1.nii.gz", "label": "labelsTr/spleen_1.nii.gz"},
+                ...
+            ],
+            "test": ["imagesTs/spleen_2.nii.gz", ...]
+        }
+
+    Relative paths are resolved against `base_dir`, which defaults to the directory containing the JSON file.
+    Users can convert their own datalist to this format and load it with this function.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, every item of the selected list must be a dictionary containing both
+            "image" and "label" keys. If False, items may be any type (e.g. a plain path string or a dictionary).
+        data_list_key (str): key of the list to load from the JSON file, default is "training".
+        base_dir (str, optional): directory to resolve relative paths against. Defaults to the directory of
+            `data_list_file_path`.
+
+    Returns:
+        a list of data items (dictionaries with paths resolved, or paths) ready to be used by a dataset.
+
+    Raises:
+        ValueError: if the file does not exist, `data_list_key` is missing, or items do not match the expected format.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is not specified in the JSON data list file.")
+    expected_data = json_data[data_list_key]
+    if not isinstance(expected_data, list):
+        raise ValueError(f"Data list '{data_list_key}' must be a list in the JSON data list file.")
+
+    if is_segmentation:
+        for item in expected_data:
+            if not isinstance(item, dict) or "image" not in item or "label" not in item:
+                raise ValueError(
+                    f"Each item in '{data_list_key}' must be a dictionary with 'image' and 'label' keys "
+                    "when is_segmentation=True."
+                )
+
+    if base_dir is None:
+        base_dir = os.path.dirname(os.path.abspath(data_list_file_path))
+
+    def _resolve(value):
+        if isinstance(value, str):
+            return os.path.join(base_dir, value)
+        if isinstance(value, list):
+            return [_resolve(v) for v in value]
+        return value
+
+    result = []
+    for item in expected_data:
+        if isinstance(item, dict):
+            result.append({k: _resolve(v) for k, v in item.items()})
+        else:
+            result.append(_resolve(item))
+    return result
+
