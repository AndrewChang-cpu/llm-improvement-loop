+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+DATA = {
+    "name": "Spleen",
+    "training": [
+        {"image": "imagesTr/spleen_1.nii.gz", "label": "labelsTr/spleen_1.nii.gz"},
+        {"image": "imagesTr/spleen_2.nii.gz", "label": "labelsTr/spleen_2.nii.gz"},
+    ],
+    "test": ["imagesTs/spleen_3.nii.gz", "imagesTs/spleen_4.nii.gz"],
+}
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.TemporaryDirectory()
+        self.json_path = os.path.join(self.tmp_dir.name, "dataset.json")
+        with open(self.json_path, "w") as f:
+            json.dump(DATA, f)
+
+    def tearDown(self):
+        self.tmp_dir.cleanup()
+
+    def test_segmentation_training_list(self):
+        result = load_decathlon_datalist(self.json_path)
+        self.assertEqual(len(result), 2)
+        base = os.path.dirname(os.path.abspath(self.json_path))
+        self.assertEqual(result[0]["image"], os.path.join(base, "imagesTr/spleen_1.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join(base, "labelsTr/spleen_1.nii.gz"))
+        self.assertEqual(result[1]["label"], os.path.join(base, "labelsTr/spleen_2.nii.gz"))
+
+    def test_custom_base_dir(self):
+        result = load_decathlon_datalist(self.json_path, base_dir="/data")
+        self.assertEqual(result[0]["image"], os.path.join("/data", "imagesTr/spleen_1.nii.gz"))
+
+    def test_non_segmentation_list(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="test")
+        base = os.path.dirname(os.path.abspath(self.json_path))
+        self.assertEqual(
+            result,
+            [os.path.join(base, "imagesTs/spleen_3.nii.gz"), os.path.join(base, "imagesTs/spleen_4.nii.gz")],
+        )
+
+    def test_missing_key_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+    def test_missing_file_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(os.path.join(self.tmp_dir.name, "missing.json"))
+
+    def test_segmentation_items_without_label_raise(self):
+        bad_path = os.path.join(self.tmp_dir.name, "bad.json")
+        with open(bad_path, "w") as f:
+            json.dump({"training": [{"image": "a.nii.gz"}]}, f)
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(bad_path)
+
+
+if __name__ == "__main__":
+    unittest.main()
