+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+):
+    """
+    Load image/label paths of a Decathlon challenge style datalist from a JSON file.
+
+    The JSON file is expected to contain a top-level dictionary with a key `data_list_key` (default "training"),
+    whose value is a list of dictionaries, e.g.::
+
+        {
+            "training": [
+                {"image": "imagesTr/la_003.nii.gz", "label": "labelsTr/la_003.nii.gz"},
+                ...
+            ],
+            "test": ["imagesTs/la_004.nii.gz", ...]
+        }
+
+    Relative paths are resolved against `base_dir`. If `base_dir` is None, the directory containing
+    `data_list_file_path` is used.
+
+    Args:
+        data_list_file_path (str): the JSON file path of the datalist.
+        is_segmentation (bool): whether the datalist contains segmentation labels. If True, each item must be a
+            dictionary with "image" and "label" keys; if False, each item is either a dictionary with an "image"
+            key or a plain image path string.
+        data_list_key (str): the key of the list to load in the JSON file, default is "training".
+        base_dir (str, optional): base directory used to resolve relative paths in the datalist.
+            Defaults to the directory of `data_list_file_path`.
+
+    Returns:
+        a list of dictionaries (for segmentation, or for non-segmentation items given as dicts) with
+        resolved paths, or a list of resolved image paths when `is_segmentation` is False and items are strings.
+
+    Raises:
+        ValueError: when `data_list_key` is not in the JSON file, or items do not match the expected format.
+    """
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list '{data_list_key}' is not specified in '{data_list_file_path}'.")
+    expected_data = json_data[data_list_key]
+
+    def _resolve(path):
+        return os.path.join(base_dir, path)
+
+    result = []
+    for item in expected_data:
+        if isinstance(item, str):
+            if is_segmentation:
+                raise ValueError("Segmentation datalist items must be dictionaries with 'image' and 'label' keys.")
+            result.append(_resolve(item))
+            continue
+        if not isinstance(item, dict) or "image" not in item:
+            raise ValueError(f"Datalist item must be a dictionary with an 'image' key, got: {item}.")
+        if is_segmentation and "label" not in item:
+            raise ValueError(f"Segmentation datalist item must have a 'label' key, got: {item}.")
+        item = dict(item)
+        item["image"] = _resolve(item["image"])
+        if "label" in item:
+            item["label"] = _resolve(item["label"])
+        result.append(item)
+    return result
+
