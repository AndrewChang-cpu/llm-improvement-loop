+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+SEG_DATA = {
+    "training": [
+        {"image": "imagesTr/img0.nii.gz", "label": "labelsTr/lbl0.nii.gz"},
+        {"image": "imagesTr/img1.nii.gz", "label": "labelsTr/lbl1.nii.gz"},
+    ],
+    "test": ["imagesTs/img2.nii.gz"],
+}
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.TemporaryDirectory()
+        self.json_path = os.path.join(self.tmp_dir.name, "dataset.json")
+        with open(self.json_path, "w") as f:
+            json.dump(SEG_DATA, f)
+
+    def tearDown(self):
+        self.tmp_dir.cleanup()
+
+    def test_segmentation_default_base_dir(self):
+        result = load_decathlon_datalist(self.json_path)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(self.tmp_dir.name, "imagesTr/img0.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join(self.tmp_dir.name, "labelsTr/lbl0.nii.gz"))
+        self.assertEqual(result[1]["image"], os.path.join(self.tmp_dir.name, "imagesTr/img1.nii.gz"))
+
+    def test_explicit_base_dir_and_key(self):
+        result = load_decathlon_datalist(self.json_path, data_list_key="test", is_segmentation=False, base_dir="/data")
+        self.assertEqual(result, [os.path.join("/data", "imagesTs/img2.nii.gz")])
+
+    def test_missing_key_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+    def test_segmentation_missing_label_raises(self):
+        bad = {"training": [{"image": "a.nii.gz"}]}
+        with open(self.json_path, "w") as f:
+            json.dump(bad, f)
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path)
+
+
+if __name__ == "__main__":
+    unittest.main()
