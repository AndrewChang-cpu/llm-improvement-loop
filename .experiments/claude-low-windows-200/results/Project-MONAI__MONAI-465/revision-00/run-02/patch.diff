+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+SEG_DATA = {
+    "name": "Spleen",
+    "training": [
+        {"image": "imagesTr/spleen_2.nii.gz", "label": "labelsTr/spleen_2.nii.gz"},
+        {"image": "imagesTr/spleen_3.nii.gz", "label": "labelsTr/spleen_3.nii.gz"},
+    ],
+    "test": ["imagesTs/spleen_1.nii.gz"],
+}
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+        self.json_path = os.path.join(self.tempdir, "dataset.json")
+        with open(self.json_path, "w") as f:
+            json.dump(SEG_DATA, f)
+
+    def tearDown(self):
+        for root, dirs, files in os.walk(self.tempdir, topdown=False):
+            for name in files:
+                os.remove(os.path.join(root, name))
+            for name in dirs:
+                os.rmdir(os.path.join(root, name))
+        os.rmdir(self.tempdir)
+
+    def test_training_segmentation(self):
+        result = load_decathlon_datalist(self.json_path)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(self.tempdir, "imagesTr/spleen_2.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join(self.tempdir, "labelsTr/spleen_2.nii.gz"))
+        self.assertEqual(result[1]["label"], os.path.join(self.tempdir, "labelsTr/spleen_3.nii.gz"))
+
+    def test_test_key_without_label(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="test")
+        self.assertEqual(result, [{"image": os.path.join(self.tempdir, "imagesTs/spleen_1.nii.gz")}])
+
+    def test_segmentation_drops_label_when_not_segmentation(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False)
+        self.assertEqual(set(result[0].keys()), {"image"})
+
+    def test_base_dir(self):
+        base = "/data/root"
+        result = load_decathlon_datalist(self.json_path, base_dir=base)
+        self.assertEqual(result[0]["image"], os.path.join(base, "imagesTr/spleen_2.nii.gz"))
+
+    def test_missing_key_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+    def test_missing_label_raises_for_segmentation(self):
+        bad_path = os.path.join(self.tempdir, "bad.json")
+        with open(bad_path, "w") as f:
+            json.dump({"training": [{"image": "a.nii.gz"}]}, f)
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(bad_path)
+
+
+if __name__ == "__main__":
+    unittest.main()
