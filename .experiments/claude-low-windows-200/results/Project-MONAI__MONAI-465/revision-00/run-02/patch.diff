+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict]:
+    """
+    Load a datalist in the Medical Segmentation Decathlon JSON format and return it as a list of dictionaries.
+
+    The JSON file is expected to contain a top-level object with a key `data_list_key` (for example
+    ``"training"`` or ``"test"``) whose value is a list of items. Each item is either a dictionary of
+    relative file paths (e.g. ``{"image": "imagesTr/la_003.nii.gz", "label": "labelsTr/la_003.nii.gz"}``)
+    or a single relative file path string (e.g. ``"imagesTs/la_004.nii.gz"``).
+    Relative paths are joined with `base_dir`, so the returned items can be passed directly to datasets.
+
+    Users can convert their own datalist to the Decathlon format and use this function to load it.
+
+    Example JSON::
+
+        {
+            "name": "Spleen",
+            "training": [
+                {"image": "imagesTr/spleen_2.nii.gz", "label": "labelsTr/spleen_2.nii.gz"}
+            ],
+            "test": ["imagesTs/spleen_1.nii.gz"]
+        }
+
+    Args:
+        data_list_file_path (str): the path to the JSON file of the datalist.
+        is_segmentation (bool): whether the datalist is for a segmentation task. If True, every dictionary
+            item must contain both `image` and `label` keys. If False, `label` entries are dropped and only
+            the `image` path is returned for each item. Default is True.
+        data_list_key (str): the key of the list in the JSON file to load, default is "training".
+        base_dir (str, optional): the base directory that relative paths are joined with. If None,
+            the directory containing `data_list_file_path` is used.
+
+    Returns:
+        a list of dictionaries (or path strings converted to ``{"image": path}``) with absolute or
+        `base_dir`-joined file paths.
+
+    Raises:
+        ValueError: if `data_list_key` is not in the JSON file, or the items do not match the task type.
+    """
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+
+    if data_list_key not in json_data:
+        raise ValueError(f'data list key "{data_list_key}" not found in "{data_list_file_path}".')
+    expected_items = json_data[data_list_key]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in expected_items:
+        if isinstance(item, dict):
+            if is_segmentation and ("image" not in item or "label" not in item):
+                raise ValueError(f'segmentation datalist item must contain "image" and "label" keys, got: {item}.')
+            if is_segmentation:
+                result.append({k: os.path.join(base_dir, v) for k, v in item.items()})
+            else:
+                if "image" not in item:
+                    raise ValueError(f'datalist item must contain an "image" key, got: {item}.')
+                result.append({"image": os.path.join(base_dir, item["image"])})
+        elif isinstance(item, str):
+            if is_segmentation:
+                raise ValueError(f"segmentation datalist item must be a dictionary with image and label, got: {item}.")
+            result.append({"image": os.path.join(base_dir, item)})
+        else:
+            raise ValueError(f"unsupported datalist item type: {type(item)}.")
+
+    return result
+
+
