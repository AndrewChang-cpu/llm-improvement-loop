+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathlon_datalist
+
+DATA = {
+    "name": "Test",
+    "training": [
+        {"image": "./imagesTr/a.nii.gz", "label": "./labelsTr/a.nii.gz"},
+        {"image": "./imagesTr/b.nii.gz", "label": "./labelsTr/b.nii.gz"},
+    ],
+    "test": ["./imagesTs/c.nii.gz", "./imagesTs/d.nii.gz"],
+    "unpaired": [{"image": "./imagesU/e.nii.gz"}],
+}
+
+
+class TestLoadDecathlonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.json_path = os.path.join(self.tmp.name, "dataset.json")
+        with open(self.json_path, "w") as f:
+            json.dump(DATA, f)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_training_list(self):
+        result = load_decathlon_datalist(self.json_path)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(self.tmp.name, "./imagesTr/a.nii.gz"))
+        self.assertEqual(result[0]["label"], os.path.join(self.tmp.name, "./labelsTr/a.nii.gz"))
+
+    def test_test_list_strings(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="test")
+        self.assertEqual(result, [os.path.join(self.tmp.name, "./imagesTs/c.nii.gz"),
+                                  os.path.join(self.tmp.name, "./imagesTs/d.nii.gz")])
+
+    def test_no_label_when_not_segmentation(self):
+        result = load_decathlon_datalist(self.json_path, is_segmentation=False, data_list_key="unpaired")
+        self.assertEqual(result[0]["image"], os.path.join(self.tmp.name, "./imagesU/e.nii.gz"))
+
+    def test_base_dir(self):
+        result = load_decathlon_datalist(self.json_path, base_dir="/data")
+        self.assertEqual(result[1]["image"], os.path.join("/data", "./imagesTr/b.nii.gz"))
+
+    def test_missing_key(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="validation")
+
+    def test_missing_label_raises(self):
+        with self.assertRaises(ValueError):
+            load_decathlon_datalist(self.json_path, data_list_key="unpaired")
+
+
+if __name__ == "__main__":
+    unittest.main()
