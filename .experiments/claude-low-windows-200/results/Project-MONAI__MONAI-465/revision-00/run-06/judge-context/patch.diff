+def load_decathlon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Union[str, Dict]]:
+    """
+    Load the datalist of a Decathlon challenge dataset from a JSON file, e.g. one obtained from
+    http://medicaldecathlon.com/. Users can also convert their own datalist to the Decathlon format and use this.
+
+    The JSON file must contain a top-level key `data_list_key` whose value is a list of items. Each item is either a
+    dictionary with an "image" entry (and a "label" entry when `is_segmentation` is True), or a plain string/list
+    of strings for unlabelled data (e.g. the "test" split). Relative file paths are resolved against `base_dir`.
+
+    Args:
+        data_list_file_path (str): the path to the JSON file that records the data list.
+        is_segmentation (bool): whether the datalist must contain the segmentation "label" key for each item.
+            Defaults to True.
+        data_list_key (str): the key to choose the data list from the JSON file, e.g. "training", "test".
+            Defaults to "training".
+        base_dir (str, optional): the base directory used to resolve relative paths in the datalist.
+            Defaults to the directory containing `data_list_file_path`.
+
+    Returns:
+        a list of data items with the file paths resolved (dictionaries for paired data, strings otherwise).
+
+    Raises:
+        ValueError: if `data_list_key` is not in the JSON file, or an item is missing the required keys.
+    """
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in '{data_list_file_path}'.")
+    expected_data = json_data[data_list_key]
+    if not isinstance(expected_data, list):
+        raise ValueError(f"Data list '{data_list_key}' in '{data_list_file_path}' must be a list.")
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    def _resolve(value):
+        if isinstance(value, str):
+            return os.path.join(base_dir, value)
+        if isinstance(value, list):
+            return [_resolve(v) for v in value]
+        return value
+
+    result = []
+    for item in expected_data:
+        if isinstance(item, dict):
+            if "image" not in item:
+                raise ValueError(f"Item {item} in '{data_list_key}' of '{data_list_file_path}' has no 'image' key.")
+            if is_segmentation and "label" not in item:
+                raise ValueError(f"Item {item} in '{data_list_key}' of '{data_list_file_path}' has no 'label' key.")
+            result.append({k: (_resolve(v) if k in ("image", "label") else v) for k, v in item.items()})
+        elif isinstance(item, (str, list)):
+            result.append(_resolve(item))
+        else:
+            raise ValueError(f"Unsupported item type {type(item)} in '{data_list_key}' of '{data_list_file_path}'.")
+    return result
+
