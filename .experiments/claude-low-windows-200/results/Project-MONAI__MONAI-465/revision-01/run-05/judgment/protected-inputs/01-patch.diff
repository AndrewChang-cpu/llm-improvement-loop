+import json
+import os
+
+
+def _resolve_path(value, base_dir, file_path, key):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined with.
+        file_path: datalist file path, used in error messages.
+        key: field name the value came from, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list element under key '{key}' in datalist '{file_path}' must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"value under key '{key}' in datalist '{file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries are read from the top-level key ``data_list_key``. The ``"image"`` field of each
+    item is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; otherwise it is returned exactly as stored, so integer class ids
+    and class-name strings are kept unchanged. All other fields are copied through unchanged.
+    Items without ``"image"`` or ``"label"`` are accepted. When ``data_list_key`` is ``"test"``,
+    each entry is a plain path string and is converted into an item containing only ``"image"``.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. The file must exist.
+        is_segmentation: whether labels are paths to be resolved (True) or values to pass through (False).
+        data_list_key: top-level key in the JSON object that holds the list of entries.
+        base_dir: directory that relative paths are resolved against. If None, the directory
+            containing ``data_list_file_path`` is used.
+
+    Returns:
+        a list of dictionaries, one per entry, in the original order. Each dictionary has the same
+        field names as its input item, with ``"image"`` (and ``"label"`` in segmentation mode) holding
+        resolved paths: strings, or lists of strings when the input value was a list.
+
+    Raises:
+        ValueError: when the datalist file does not exist, when ``data_list_key`` is missing from the
+            JSON object, when an item is not a mapping, or when a path value is neither a string nor
+            a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    data_list = json_data[data_list_key]
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"each item under key '{data_list_key}' in datalist '{data_list_file_path}' must be a mapping, "
+                f"got {type(item).__name__}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, data_list_file_path, "label")
+        result.append(new_item)
+
+    return result
