+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_datalist(self, tempdir, content):
+        path = os.path.join(tempdir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imgs/a.nii.gz", "label": ["labels/./a.nii.gz"], "name": "case_a"},
+                    {"image": ["imgs//b.nii.gz", "imgs/c.nii.gz"], "label": "labels/b.nii.gz", "extra": 3},
+                ]
+            }
+            path = self._write_datalist(tempdir, content)
+            base = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, True, "training", base)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/a.nii.gz")))
+            self.assertEqual(result[0]["label"], [os.path.normpath(os.path.join(base, "labels/a.nii.gz"))])
+            self.assertEqual(result[0]["name"], "case_a")
+            expected_images = [
+                os.path.normpath(os.path.join(base, "imgs/b.nii.gz")),
+                os.path.normpath(os.path.join(base, "imgs/c.nii.gz")),
+            ]
+            self.assertEqual(result[1]["image"], expected_images)
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base, "labels/b.nii.gz")))
+            self.assertEqual(result[1]["extra"], 3)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"training": [{"image": "imgs/a.nii.gz", "label": 1}, {"image": "imgs/b.nii.gz", "label": 0}]}
+            path = self._write_datalist(tempdir, content)
+            base = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, False, "training", base)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/a.nii.gz")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "imgs/b.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "img.nii.gz")
+            abs_label = os.path.join(tempdir, "abs", "lbl.nii.gz")
+            content = {
+                "training": [
+                    {"image": "imgs/a.nii.gz", "label": "labels/a.nii.gz"},
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            content["test"] = ["imgs/t.nii.gz"]
+            path = self._write_datalist(tempdir, content)
+
+            result = load_decathalon_datalist(path, True, "training")
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labels/a.nii.gz")))
+            self.assertEqual(result[1]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[1]["label"], os.path.normpath(abs_label))
+
+            test_result = load_decathalon_datalist(path, True, "test")
+            self.assertEqual(len(test_result), 1)
+            self.assertEqual(test_result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/t.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]}
+            path = self._write_datalist(tempdir, content)
+            base = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(path, True, "test", base)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/t0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
