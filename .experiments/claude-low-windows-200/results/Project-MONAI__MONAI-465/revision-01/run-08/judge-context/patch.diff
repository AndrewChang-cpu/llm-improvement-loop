+import json
+import os
+
+
+def _resolve_path(value, base_dir, field):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path or a list of string paths.
+        base_dir: directory used as the base of the join.
+        field: name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list, or a list contains a non-string element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"list elements of field '{field}' must be strings, got {element!r}.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"field '{field}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entry list is read from the top-level key ``data_list_key``. Other top-level fields are ignored.
+    For the ``"test"`` key, each entry is a plain path string and is converted to an item holding only
+    the ``"image"`` field. For other keys, each entry must be a mapping.
+
+    The ``"image"`` field is always resolved against ``base_dir``. The ``"label"`` field is resolved only
+    when ``is_segmentation`` is true; otherwise it is returned exactly as stored, whatever its type
+    (for example an integer class id or a class-name string). Other fields are never modified.
+    Items lacking ``"image"`` or ``"label"`` are accepted.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file.
+        is_segmentation: whether labels are file paths to be resolved. Defaults to True.
+        data_list_key: top-level key in the JSON file that holds the entry list. Defaults to "training".
+        base_dir: directory that relative paths are resolved against. Defaults to None, which means the
+            directory containing the datalist file.
+
+    Returns:
+        A list of dictionaries, in the same order as the entries in the file. Each dictionary has the same
+        fields as its input item, with ``"image"`` (and ``"label"`` in segmentation mode) holding resolved
+        paths: strings, or lists of strings when the input value was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the JSON lacks ``data_list_key``, an item is not a
+            mapping, or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    data_list = json_data[data_list_key]
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(f"each item under key '{data_list_key}' must be a mapping, got {item!r}.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image")
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label")
+        result.append(new_item)
+
+    return result
