+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "base")
+            datalist = {
+                "name": "test",
+                "training": [
+                    {"image": "./imagesTr/case_0.nii.gz", "label": "labelsTr//case_0.nii.gz", "extra": "keep"},
+                    {"image": ["a/./img1.nii.gz", "a//img2.nii.gz"], "label": ["lab/l1.nii.gz", "lab/l2.nii.gz"]},
+                ],
+            }
+            list_path = os.path.join(tempdir, "datalist.json")
+            with open(list_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(list_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["extra"], "keep")
+            self.assertEqual(result[1]["image"], [
+                os.path.normpath(os.path.join(base_dir, "a/img1.nii.gz")),
+                os.path.normpath(os.path.join(base_dir, "a/img2.nii.gz")),
+            ])
+            self.assertEqual(result[1]["label"], [
+                os.path.normpath(os.path.join(base_dir, "lab/l1.nii.gz")),
+                os.path.normpath(os.path.join(base_dir, "lab/l2.nii.gz")),
+            ])
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "base")
+            datalist = {
+                "training": [
+                    {"image": "img/case_0.nii.gz", "label": 0},
+                    {"image": "img/case_1.nii.gz", "label": 2},
+                ],
+            }
+            list_path = os.path.join(tempdir, "datalist.json")
+            with open(list_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(list_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img/case_0.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 2)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "img/case_1.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "image.nii.gz")
+            abs_label = os.path.join(tempdir, "abs", "label.nii.gz")
+            datalist = {
+                "training": [
+                    {"image": "rel/image.nii.gz", "label": "rel/label.nii.gz"},
+                    {"image": abs_image, "label": abs_label},
+                ],
+                "test": ["test/case_0.nii.gz", "test/case_1.nii.gz"],
+            }
+            list_path = os.path.join(tempdir, "datalist.json")
+            with open(list_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(list_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "rel/image.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "rel/label.nii.gz")))
+            self.assertEqual(result[1]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[1]["label"], os.path.normpath(abs_label))
+
+            test_result = load_decathalon_datalist(list_path, True, "test", None)
+            self.assertEqual(len(test_result), 2)
+            self.assertEqual(test_result[0], {"image": os.path.normpath(os.path.join(tempdir, "test/case_0.nii.gz"))})
+            self.assertEqual(test_result[1], {"image": os.path.normpath(os.path.join(tempdir, "test/case_1.nii.gz"))})
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "base")
+            datalist = {"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]}
+            list_path = os.path.join(tempdir, "datalist.json")
+            with open(list_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(list_path, base_dir=base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/case_0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
