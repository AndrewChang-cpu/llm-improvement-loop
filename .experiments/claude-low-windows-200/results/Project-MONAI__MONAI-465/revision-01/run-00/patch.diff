+import json
+import os
+from collections.abc import Mapping
+
+
+def _resolve_path(value, base_dir):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list whose elements are all strings.
+        base_dir: directory that relative paths are joined with.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the original order.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list, or a list contains a non-string element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list element must be a string, got {type(element).__name__}: {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str, is_segmentation: bool = True, data_list_key: str = "training", base_dir=None
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entry list is read from the top-level key ``data_list_key``. Each entry is a mapping; its "image" value
+    is resolved against ``base_dir``. Its "label" value is resolved only when ``is_segmentation`` is True;
+    otherwise the label is returned exactly as stored (for example an integer class id or a class name).
+    Other fields are returned unchanged. Items without "image" or "label" are accepted as they are.
+
+    When ``data_list_key`` is "test", the entries are plain path strings; each one is converted to an item
+    holding only an "image" field before any other processing.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: whether the labels are paths to be resolved (True) or raw values to keep (False).
+            Defaults to True.
+        data_list_key: top-level key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are joined with. If None, the directory containing the
+            datalist file is used. Defaults to None.
+
+    Returns:
+        a list of dictionaries, one per entry, in the original order. Each dictionary has the same field names as
+        its input entry. "image" (and "label" in segmentation mode) hold resolved paths: strings, or lists of
+        strings when the input was a list.
+
+    Raises:
+        ValueError: when the datalist file does not exist, the top-level object lacks ``data_list_key``, an entry
+            is not a mapping, or an "image" or segmentation "label" value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"data_list_key '{data_list_key}' must hold a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"each datalist item must be a mapping, got {type(item).__name__}: {item!r}")
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir)
+        result.append(out)
+    return result
