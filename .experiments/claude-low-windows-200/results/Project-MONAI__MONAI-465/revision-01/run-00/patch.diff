+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def _write_datalist(self, content, name="datalist.json"):
+        path = os.path.join(self.tempdir, name)
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        base = os.path.join(self.tempdir, "data")
+        path = self._write_datalist(
+            {
+                "name": "demo",
+                "training": [
+                    {"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 0},
+                    {"image": ["imgs/b0.nii", "imgs/b1.nii"], "label": ["labels/b.nii"], "fold": 1},
+                ],
+            }
+        )
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/a.nii")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base, "labels/a.nii")))
+        self.assertEqual(result[0]["fold"], 0)
+        self.assertEqual(
+            result[1]["image"],
+            [os.path.normpath(os.path.join(base, "imgs/b0.nii")), os.path.normpath(os.path.join(base, "imgs/b1.nii"))],
+        )
+        self.assertEqual(result[1]["label"], [os.path.normpath(os.path.join(base, "labels/b.nii"))])
+        self.assertEqual(result[1]["fold"], 1)
+
+    def test_cls_values(self):
+        base = os.path.join(self.tempdir, "data")
+        path = self._write_datalist(
+            {"training": [{"image": "imgs/a.nii", "label": 3}, {"image": "imgs/b.nii", "label": 0}]}
+        )
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/a.nii")))
+        self.assertEqual(result[0]["label"], 3)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "imgs/b.nii")))
+        self.assertEqual(result[1]["label"], 0)
+        self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        abs_img = os.path.join(self.tempdir, "abs", "img.nii")
+        abs_label = os.path.join(self.tempdir, "abs", "label.nii")
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": abs_img, "label": abs_label},
+                    {"image": "rel/img.nii", "label": "rel/label.nii"},
+                ],
+                "test": ["test/t0.nii", "test/t1.nii"],
+            }
+        )
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_img))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(self.tempdir, "rel/img.nii")))
+        self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(self.tempdir, "rel/label.nii")))
+
+        test_result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=None)
+        self.assertEqual(len(test_result), 2)
+        self.assertEqual(list(test_result[0].keys()), ["image"])
+        self.assertEqual(test_result[0]["image"], os.path.normpath(os.path.join(self.tempdir, "test/t0.nii")))
+        self.assertEqual(test_result[1]["image"], os.path.normpath(os.path.join(self.tempdir, "test/t1.nii")))
+
+    def test_seg_no_labels(self):
+        base = os.path.join(self.tempdir, "data")
+        path = self._write_datalist({"test": ["t0.nii", "t1.nii"]})
+        result = load_decathalon_datalist(path, data_list_key="test", base_dir=base)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "t0.nii")))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
