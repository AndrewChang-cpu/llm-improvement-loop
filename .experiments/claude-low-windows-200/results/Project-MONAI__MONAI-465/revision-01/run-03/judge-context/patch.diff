+
+import json
+import os
+
+
+def _resolve_path(value, base_dir):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined with.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list, or a list contains a non-string element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list element must be a string, got {type(element).__name__}: {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str, is_segmentation: bool = True, data_list_key: str = "training", base_dir=None
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file is a JSON object whose entries are stored under ``data_list_key``. Each entry is a mapping
+    holding an "image" field, and optionally a "label" field. The "image" value is resolved against
+    ``base_dir``: a string is joined with ``base_dir`` and normalized, and a list of strings is resolved
+    element by element, keeping the list order. The "label" value is resolved the same way only when
+    ``is_segmentation`` is True; otherwise it is returned exactly as stored, so classification labels
+    such as integer class ids or class-name strings are not modified. All other fields are kept unchanged.
+
+    When ``data_list_key`` is "test", the entries are plain path strings. Each one is converted into an
+    image-only item whose only field is "image", and then resolved as usual.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: whether labels are paths to be resolved (True) or passed through unchanged (False).
+            Defaults to True.
+        data_list_key: top-level key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, in the same order as the entries in the datalist. Each dictionary has the same
+        field names as its input item, with "image" (and "label" in segmentation mode) holding resolved paths,
+        either as strings or as lists of strings.
+
+    Raises:
+        ValueError: when the datalist file does not exist, when ``data_list_key`` is missing from the JSON
+            object, when an item is not a mapping, or when a resolved path value is neither a string nor a
+            list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is missing from file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"each item in data list must be a mapping, got {type(item).__name__}: {item!r}")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir)
+        items.append(processed)
+
+    return items
