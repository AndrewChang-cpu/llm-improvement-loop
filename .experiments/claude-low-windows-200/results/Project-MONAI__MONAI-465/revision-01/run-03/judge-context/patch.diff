+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii.gz", "label": "labels/case0.nii.gz", "fold": 1},
+                    {"image": ["imgs/a.nii.gz", "imgs/b.nii.gz"], "label": "./labels/case1.nii.gz"},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            base_dir = os.path.join(tempdir, "data")
+            result = load_decathalon_datalist(file_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "imgs/a.nii.gz")),
+                    os.path.normpath(os.path.join(base_dir, "imgs/b.nii.gz")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base_dir, "labels/case1.nii.gz")))
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii.gz", "label": 0},
+                    {"image": "imgs/case1.nii.gz", "label": 2},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            base_dir = os.path.join(tempdir, "data")
+            result = load_decathalon_datalist(file_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case1.nii.gz")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            abs_image = os.path.join(tempdir, "abs", "image.nii.gz")
+            abs_label = os.path.join(tempdir, "abs", "label.nii.gz")
+            datalist = {
+                "training": [{"image": abs_image, "label": abs_label}],
+                "test": ["imgs/test0.nii.gz", "imgs/test1.nii.gz"],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            # base_dir omitted: absolute values stay absolute
+            result = load_decathalon_datalist(file_path)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+            # base_dir omitted: relative "test" entries resolve against the datalist directory
+            result = load_decathalon_datalist(file_path, True, "test")
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tempdir, "imgs/test0.nii.gz"))})
+            self.assertEqual(result[1], {"image": os.path.normpath(os.path.join(tempdir, "imgs/test1.nii.gz"))})
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {"test": ["imgs/test0.nii.gz", "imgs/test1.nii.gz"]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, data_list_key="test")
+
+            self.assertEqual(len(result), 2)
+            self.assertNotIn("label", result[0])
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/test0.nii.gz")))
+
+
+if __name__ == "__main__":
+    unittest.main()
