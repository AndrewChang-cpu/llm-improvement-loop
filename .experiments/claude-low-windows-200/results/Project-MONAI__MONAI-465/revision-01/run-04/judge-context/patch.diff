+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "imgs/./a.nii", "label": "labels//a.nii", "extra": "keep_me"},
+                    {"image": ["imgs/b.nii", "imgs/c.nii"], "label": ["labels/b.nii", "labels/c.nii"]},
+                ]
+            }
+            with open(data_list_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_list_file, True, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/a.nii")))
+            self.assertEqual(result[0]["extra"], "keep_me")
+            self.assertEqual(
+                result[1]["image"],
+                [os.path.normpath(os.path.join(base_dir, "imgs/b.nii")),
+                 os.path.normpath(os.path.join(base_dir, "imgs/c.nii"))],
+            )
+            self.assertEqual(
+                result[1]["label"],
+                [os.path.normpath(os.path.join(base_dir, "labels/b.nii")),
+                 os.path.normpath(os.path.join(base_dir, "labels/c.nii"))],
+            )
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            datalist = {"training": [{"image": "imgs/a.nii", "label": 1}, {"image": "imgs/b.nii", "label": 0}]}
+            with open(data_list_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_list_file, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/b.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            abs_image = os.path.join(tempdir, "abs", "image.nii")
+            abs_label = os.path.join(tempdir, "abs", "label.nii")
+            datalist = {
+                "training": [{"image": abs_image, "label": abs_label}],
+                "test": ["test/t1.nii"],
+            }
+            with open(data_list_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_list_file, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+            test_result = load_decathalon_datalist(data_list_file, True, "test", None)
+            self.assertEqual(len(test_result), 1)
+            self.assertEqual(test_result[0]["image"], os.path.normpath(os.path.join(tempdir, "test/t1.nii")))
+            self.assertNotIn("label", test_result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            datalist = {"test": ["imgs/t1.nii", "imgs/t2.nii"]}
+            with open(data_list_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_list_file, base_dir=base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/t1.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
