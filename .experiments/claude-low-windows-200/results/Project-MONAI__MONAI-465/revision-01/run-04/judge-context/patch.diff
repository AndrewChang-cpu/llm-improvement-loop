+import json
+import os
+
+
+def _resolve_path_value(value, base_dir, file_path, key):
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value: a string, or a list whose elements are all strings.
+        base_dir: directory that relative paths are joined with.
+        file_path: datalist file path, used in error messages.
+        key: field name the value belongs to, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the same order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list element {element!r} for field '{key}' in datalist file '{file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"value {value!r} for field '{key}' in datalist file '{file_path}' must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+):
+    """
+    Load the Medical Segmentation Decathlon style datalist file and resolve its paths.
+
+    The entries are read from the top-level key ``data_list_key`` of the JSON file. Each entry must be a mapping.
+    The ``image`` field is always resolved against ``base_dir``. The ``label`` field is resolved only when
+    ``is_segmentation`` is True; otherwise it is returned exactly as stored, so integer class ids and class-name
+    strings are kept unchanged. Other fields are never path-resolved. Entries under the ``"test"`` key are plain
+    path strings and are converted to image-only items.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file.
+        is_segmentation: whether the labels are segmentation paths to resolve. Defaults to True.
+        data_list_key: top-level key in the JSON file holding the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are resolved against. Defaults to None, which means the
+            directory containing the datalist file.
+
+    Returns:
+        a list of dictionaries, in the same order as the input entries. Each dictionary has the same field names
+        as its input entry; ``image`` (and ``label`` in segmentation mode) hold resolved paths, which are strings
+        or lists of strings matching the input type, and all other fields are kept unchanged.
+
+    Raises:
+        ValueError: when the datalist file does not exist, the JSON does not contain ``data_list_key``, an entry is
+            not a mapping, or an ``image`` or segmentation ``label`` value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"item {item!r} in datalist file '{data_list_file_path}' must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path_value(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path_value(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+
+    return items
