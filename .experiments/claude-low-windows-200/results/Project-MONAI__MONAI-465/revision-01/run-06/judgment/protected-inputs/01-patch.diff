+import json
+import os
+
+
+def _resolve_path(value, base_dir, field):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined with.
+        field: name of the field being resolved, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the original order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list, or a list contains a non-string element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"field '{field}' contains a non-string element {element!r} in list {value!r}.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"field '{field}' must be a string or a list of strings, got {type(value).__name__}: {value!r}.")
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its per-case items with
+    the "image" and (in segmentation mode) "label" paths resolved against ``base_dir``.
+
+    The entries are read from the top-level key ``data_list_key``. Other top-level fields of the JSON
+    object, such as name, description, labels, modality and counts, are ignored. Each returned item has
+    the same field names as its input item. The "image" field is always resolved. The "label" field is
+    resolved only when ``is_segmentation`` is True; otherwise it is returned exactly as stored, whatever
+    its type (for example an integer class id or a class name string). Any other field is returned unchanged.
+    Items without an "image" or "label" field are accepted.
+
+    When ``data_list_key`` is "test", each entry is a plain path string and is converted to an item
+    holding only the "image" field, independent of ``is_segmentation``.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file.
+        is_segmentation: whether the labels are segmentation paths to resolve (True) or classification
+            values to pass through unchanged (False). Defaults to True.
+        data_list_key: top-level key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            the datalist file is used. Defaults to None.
+
+    Returns:
+        a list of dictionaries, one per entry, in the original order. Resolved values are normalized path
+        strings, or lists of normalized path strings when the input value was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the JSON object does not contain ``data_list_key``,
+            an item is not a mapping, or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"key '{data_list_key}' is not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"item {item!r} in datalist file '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image")
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label")
+        result.append(new_item)
+    return result
