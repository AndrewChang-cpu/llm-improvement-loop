+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_json(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "data")
+            path = _write_json(
+                tempdir,
+                {
+                    "training": [
+                        {"image": "imgs/a.nii", "label": "lbls/./a.nii", "fold": 1},
+                        {"image": ["imgs/b0.nii", "imgs/b1.nii"], "label": "lbls//b.nii", "fold": 2},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", base)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base, "lbls/a.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(
+                result[1]["image"],
+                [os.path.join(base, "imgs", "b0.nii"), os.path.join(base, "imgs", "b1.nii")],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base, "lbls/b.nii")))
+            self.assertEqual(result[1]["fold"], 2)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "data")
+            path = _write_json(
+                tempdir,
+                {"training": [{"image": "imgs/a.nii", "label": 2}, {"image": "imgs/b.nii", "label": 0}]},
+            )
+            result = load_decathalon_datalist(path, False, "training", base)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/a.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "imgs/b.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "img.nii")
+            abs_label = os.path.join(tempdir, "abs", "lbl.nii")
+            path = _write_json(
+                tempdir,
+                {
+                    "training": [{"image": abs_image, "label": abs_label}],
+                    "test": [os.path.join("imgs", "t0.nii"), abs_image],
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+            result = load_decathalon_datalist(path, True, "test", None)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tempdir, "imgs", "t0.nii"))})
+            self.assertEqual(result[1], {"image": os.path.normpath(abs_image)})
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "data")
+            path = _write_json(tempdir, {"test": ["imgs/t0.nii", "imgs/t1.nii"]})
+            result = load_decathalon_datalist(path, base_dir=base)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/t0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
