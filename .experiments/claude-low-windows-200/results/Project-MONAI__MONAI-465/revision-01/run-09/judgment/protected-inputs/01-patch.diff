+import json
+import os
+
+
+def _resolve_path(value, base_dir, field_name, data_list_file_path):
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value: a string, or a list of strings, to be joined with ``base_dir``.
+        base_dir: directory that relative paths are resolved against.
+        field_name: name of the field being resolved, used in error messages.
+        data_list_file_path: path of the datalist file, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings in the original order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"element {element!r} of field '{field_name}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"field '{field_name}' in {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object whose entry list is stored under ``data_list_key``. Other top-level
+    fields are ignored. Each entry must be a mapping. Its "image" value is resolved against ``base_dir``
+    and must be a string or a list of strings. Its "label" value is resolved the same way only when
+    ``is_segmentation`` is True; otherwise it is returned exactly as stored, whatever its type (for
+    example an integer class id). Items without "image" or "label" are not rejected, and all other
+    fields are kept unchanged. When ``data_list_key`` is "test", each entry is a plain path string and
+    is converted to an image-only item before processing.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. It must exist.
+        is_segmentation: if True, resolve the "label" field as a path (string or list of strings).
+            If False, leave the "label" field unchanged. Defaults to True.
+        data_list_key: top-level key in the JSON object that holds the list of entries.
+            Defaults to "training".
+        base_dir: directory that relative paths are joined with. If None, the directory containing
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the same
+        field names as its input item. "image" (and "label" in segmentation mode) holds resolved
+        paths, either strings or lists of strings. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the
+            JSON object, if an entry is not a mapping, or if a path value is neither a string nor a
+            list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is missing in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"each entry under key '{data_list_key}' in {data_list_file_path} must be a mapping, "
+                f"got {type(item).__name__}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        result.append(new_item)
+
+    return result
