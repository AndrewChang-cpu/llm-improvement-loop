+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_json(self, directory, data):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(data, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": ["labels/a.nii", "labels/./b.nii"], "fold": 1},
+                    {"image": "imgs//c.nii", "label": "labels/c.nii"},
+                ]
+            }
+            path = self._write_json(tempdir, data)
+            base = os.path.join(tempdir, "base")
+            result = load_decathalon_datalist(path, True, "training", base)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/a.nii")))
+            self.assertEqual(
+                result[0]["label"],
+                [
+                    os.path.normpath(os.path.join(base, "labels/a.nii")),
+                    os.path.normpath(os.path.join(base, "labels/b.nii")),
+                ],
+            )
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "imgs/c.nii")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base, "labels/c.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {"training": [{"image": "imgs/a.nii", "label": 2}, {"image": "imgs/b.nii", "label": 0}]}
+            path = self._write_json(tempdir, data)
+            base = os.path.join(tempdir, "base")
+            result = load_decathalon_datalist(path, False, "training", base)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "imgs/b.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "img.nii")
+            abs_label = os.path.join(tempdir, "abs", "lbl.nii")
+            data = {
+                "training": [
+                    {"image": "rel/img.nii", "label": "rel/lbl.nii"},
+                    {"image": abs_image, "label": abs_label},
+                ],
+                "test": ["test/t1.nii", "test/t2.nii"],
+            }
+            path = self._write_json(tempdir, data)
+
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "rel/img.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "rel/lbl.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[1]["label"], os.path.normpath(abs_label))
+
+            test_result = load_decathalon_datalist(path, True, "test", None)
+            self.assertEqual(len(test_result), 2)
+            self.assertEqual(test_result[0], {"image": os.path.normpath(os.path.join(tempdir, "test/t1.nii"))})
+            self.assertEqual(test_result[1], {"image": os.path.normpath(os.path.join(tempdir, "test/t2.nii"))})
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {"test": ["imgs/t1.nii", "imgs/t2.nii"]}
+            path = self._write_json(tempdir, data)
+            base = os.path.join(tempdir, "base")
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=base)
+
+            self.assertEqual(len(result), 2)
+            self.assertNotIn("label", result[0])
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/t1.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
