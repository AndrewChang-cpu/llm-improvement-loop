+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def _write_datalist(self, content, name="datalist.json"):
+        path = os.path.join(self.tempdir, name)
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        content = {
+            "name": "demo",
+            "training": [
+                {"image": "imgs/a.nii.gz", "label": "labels/a.nii.gz", "fold": 1},
+                {"image": ["imgs/b0.nii.gz", "imgs/b1.nii.gz"], "label": "./labels//b.nii.gz", "fold": 2},
+            ],
+        }
+        path = self._write_datalist(content)
+        base_dir = os.path.join(self.tempdir, "base")
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii.gz")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/a.nii.gz")))
+        self.assertEqual(result[0]["fold"], 1)
+        self.assertEqual(
+            result[1]["image"],
+            [
+                os.path.normpath(os.path.join(base_dir, "imgs/b0.nii.gz")),
+                os.path.normpath(os.path.join(base_dir, "imgs/b1.nii.gz")),
+            ],
+        )
+        self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base_dir, "labels/b.nii.gz")))
+        self.assertEqual(result[1]["fold"], 2)
+
+    def test_cls_values(self):
+        content = {
+            "training": [
+                {"image": "imgs/a.nii.gz", "label": 0},
+                {"image": "imgs/b.nii.gz", "label": 3, "name": "tumor"},
+            ]
+        }
+        path = self._write_datalist(content)
+        base_dir = os.path.join(self.tempdir, "base")
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base_dir)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii.gz")))
+        self.assertEqual(result[0]["label"], 0)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/b.nii.gz")))
+        self.assertEqual(result[1]["label"], 3)
+        self.assertIsInstance(result[1]["label"], int)
+        self.assertEqual(result[1]["name"], "tumor")
+
+    def test_seg_no_basedir(self):
+        abs_image = os.path.join(self.tempdir, "abs", "img.nii.gz")
+        abs_label = os.path.join(self.tempdir, "abs", "lbl.nii.gz")
+        content = {
+            "training": [
+                {"image": "rel/img.nii.gz", "label": "rel/lbl.nii.gz"},
+                {"image": abs_image, "label": abs_label},
+            ],
+            "test": ["rel/test0.nii.gz", "rel/test1.nii.gz"],
+        }
+        path = self._write_datalist(content)
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        datalist_dir = os.path.dirname(path)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(datalist_dir, "rel/img.nii.gz")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(datalist_dir, "rel/lbl.nii.gz")))
+        self.assertEqual(result[1]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[1]["label"], os.path.normpath(abs_label))
+
+        test_result = load_decathalon_datalist(path, data_list_key="test")
+        self.assertEqual(len(test_result), 2)
+        self.assertEqual(test_result[0], {"image": os.path.normpath(os.path.join(datalist_dir, "rel/test0.nii.gz"))})
+
+    def test_seg_no_labels(self):
+        content = {"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]}
+        path = self._write_datalist(content)
+        result = load_decathalon_datalist(path, data_list_key="test")
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tempdir, "imgs/t0.nii.gz")))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
