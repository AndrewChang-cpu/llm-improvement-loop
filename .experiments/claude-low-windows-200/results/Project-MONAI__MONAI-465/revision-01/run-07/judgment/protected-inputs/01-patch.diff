+import json
+import os
+
+
+def _resolve_path(value, base_dir, data_list_file_path):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list whose elements are all strings.
+        base_dir: directory used to resolve the path.
+        data_list_file_path: datalist path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the original order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list, or a list contains a non-string element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list path element {element!r} in datalist {data_list_file_path} must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"path value {value!r} in datalist {data_list_file_path} must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries are read from the list stored under ``data_list_key``. The ``"image"`` field of every
+    item is resolved against ``base_dir``. In segmentation mode the ``"label"`` field is resolved the
+    same way; in classification mode the label is returned exactly as stored, whatever its type.
+    Items lacking ``"image"`` or ``"label"`` are not errors. Other fields are returned unchanged.
+    Entries under the ``"test"`` key are plain path strings and are converted to image-only items.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file.
+        is_segmentation: whether the datalist is for segmentation. If True, ``"label"`` values are
+            resolved as paths and must be a string or a list of strings. If False, labels are not
+            type-checked or resolved. Defaults to True.
+        data_list_key: key under the top-level JSON object that holds the list of entries.
+            Defaults to "training".
+        base_dir: directory used to resolve relative paths. If None, the directory containing
+            ``data_list_file_path`` is used.
+
+    Returns:
+        a list of dictionaries, one per entry, in the original order. Each dictionary has the same
+        field names as its input item, with ``"image"`` (and ``"label"`` in segmentation mode) holding
+        resolved paths: strings, or lists of strings when the input was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the ``data_list_key`` is missing, an item is
+            not a mapping, or an ``"image"`` or segmentation ``"label"`` value is neither a string nor
+            a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"item {item!r} in datalist {data_list_file_path} must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path)
+        result.append(processed)
+
+    return result
