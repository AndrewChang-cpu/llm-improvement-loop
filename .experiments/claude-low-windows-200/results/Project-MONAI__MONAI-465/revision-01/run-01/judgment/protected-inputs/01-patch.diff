+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_json(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "data")
+            path = self._write_json(
+                tempdir,
+                {
+                    "training": [
+                        {"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 1},
+                        {"image": ["imgs/b0.nii", "./imgs/b1.nii"], "label": "labels/./b.nii"},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", base)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.join(base, "imgs", "a.nii"))
+            self.assertEqual(result[0]["label"], os.path.join(base, "labels", "a.nii"))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(result[1]["image"], [os.path.join(base, "imgs", "b0.nii"),
+                                                  os.path.join(base, "imgs", "b1.nii")])
+            self.assertEqual(result[1]["label"], os.path.join(base, "labels", "b.nii"))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "data")
+            path = self._write_json(
+                tempdir,
+                {"training": [{"image": "imgs/a.nii", "label": 0}, {"image": "imgs/b.nii", "label": 2}]},
+            )
+            result = load_decathalon_datalist(path, False, "training", base)
+            self.assertEqual(result[0]["image"], os.path.join(base, "imgs", "a.nii"))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.join(base, "imgs", "b.nii"))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "img.nii")
+            abs_label = os.path.join(tempdir, "abs", "lbl.nii")
+            path = self._write_json(
+                tempdir,
+                {
+                    "training": [
+                        {"image": abs_image, "label": abs_label},
+                        {"image": "rel/c.nii", "label": "rel/d.nii"},
+                    ],
+                    "test": ["t/e.nii", "t/f.nii"],
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "rel", "c.nii")))
+
+            test_result = load_decathalon_datalist(path, True, "test", None)
+            self.assertEqual(len(test_result), 2)
+            self.assertEqual(list(test_result[0].keys()), ["image"])
+            self.assertEqual(test_result[0]["image"], os.path.normpath(os.path.join(tempdir, "t", "e.nii")))
+            self.assertEqual(test_result[1]["image"], os.path.normpath(os.path.join(tempdir, "t", "f.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tempdir, "data")
+            path = self._write_json(tempdir, {"test": ["imgs/x.nii", "imgs/y.nii"]})
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=base)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.join(base, "imgs", "x.nii"))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
