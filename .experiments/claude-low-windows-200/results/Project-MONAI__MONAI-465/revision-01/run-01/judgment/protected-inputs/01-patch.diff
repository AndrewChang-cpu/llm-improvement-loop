+import json
+import os
+
+
+def _resolve_path(value, base_dir: str, field: str, data_list_file_path: str):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list whose elements are all strings.
+        base_dir: directory that relative paths are joined to.
+        field: name of the field being resolved, used in error messages.
+        data_list_file_path: datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the original order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list element for field '{field}' in {data_list_file_path} must be a string, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"field '{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entry list is read from the top-level key ``data_list_key``. Other top-level fields are ignored.
+    Entries under the key "test" are plain path strings; each is converted to an item holding only the
+    "image" field. Every other entry must be a mapping. Its "image" field is resolved against ``base_dir``,
+    as is its "label" field when ``is_segmentation`` is True. When ``is_segmentation`` is False, the
+    "label" field is returned exactly as stored, whatever its type. Other fields are never modified.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file.
+        is_segmentation: if True, the "label" field of each item is resolved as a path. If False, it is
+            passed through unchanged (for example an integer class id or a class name string).
+        data_list_key: top-level key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used.
+
+    Returns:
+        a list of dictionaries, in the original order of the datalist. Each dictionary has the same field
+        names as its input entry. "image", and "label" in segmentation mode, hold normalized path strings,
+        or lists of normalized path strings when the input value was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist.
+        ValueError: if ``data_list_key`` is not present in the parsed JSON object.
+        ValueError: if an item is not a mapping.
+        ValueError: if an "image" value, or a resolved "label" value, is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"each item in {data_list_file_path} under key '{data_list_key}' must be a mapping.")
+        item = {}
+        for field, value in entry.items():
+            if field == "image" or (field == "label" and is_segmentation):
+                item[field] = _resolve_path(value, base_dir, field, data_list_file_path)
+            else:
+                item[field] = value
+        items.append(item)
+
+    return items
