+
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_json(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            content = {
+                "training": [
+                    {"image": "imagesTr/a.nii", "label": "labelsTr/a.nii", "fold": 1},
+                    {"image": ["imagesTr/b0.nii", "imagesTr/b1.nii"], "label": ["./labelsTr/b.nii"]},
+                ]
+            }
+            path = self._write_json(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/a.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "imagesTr/b0.nii")),
+                    os.path.normpath(os.path.join(base_dir, "imagesTr/b1.nii")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], [os.path.normpath(os.path.join(base_dir, "labelsTr/b.nii"))])
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            content = {
+                "training": [
+                    {"image": "imagesTr/a.nii", "label": 0},
+                    {"image": "imagesTr/b.nii", "label": 3, "name": "class_name"},
+                ]
+            }
+            path = self._write_json(tempdir, content)
+            result = load_decathalon_datalist(path, False, "training", base_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/a.nii")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/b.nii")))
+            self.assertEqual(result[1]["label"], 3)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["name"], "class_name")
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs", "image.nii")
+            abs_label = os.path.join(tempdir, "abs", "label.nii")
+            content = {
+                "training": [{"image": abs_image, "label": abs_label}],
+                "test": ["imagesTs/t0.nii", "imagesTs/t1.nii"],
+            }
+            path = self._write_json(tempdir, content)
+
+            result = load_decathalon_datalist(path, True, "training")
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+            test_result = load_decathalon_datalist(path, True, "test")
+            self.assertEqual(len(test_result), 2)
+            self.assertEqual(test_result[0], {"image": os.path.normpath(os.path.join(tempdir, "imagesTs/t0.nii"))})
+            self.assertEqual(test_result[1], {"image": os.path.normpath(os.path.join(tempdir, "imagesTs/t1.nii"))})
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            content = {"test": ["imagesTs/t0.nii", "imagesTs/t1.nii"]}
+            path = self._write_json(tempdir, content)
+            result = load_decathalon_datalist(path, base_dir=base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/t0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
