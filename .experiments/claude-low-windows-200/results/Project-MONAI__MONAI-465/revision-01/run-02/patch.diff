+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: the stored path value, a string or a list of strings.
+        base_dir: directory that relative paths are joined with.
+        field: name of the field being resolved, used in error messages.
+        file_path: datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' contains a non-string element: {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items.
+
+    The entries are read from the top-level key ``data_list_key``; other top-level fields are ignored.
+    The "image" field of every item is always resolved against ``base_dir``. The "label" field is
+    resolved only when ``is_segmentation`` is True; otherwise it is returned exactly as stored, whatever
+    its type (for example an integer class id or a class name string). Other fields are never modified.
+    When ``data_list_key`` is "test", each entry is a plain path string and is converted to an
+    image-only item before any processing.
+
+    Args:
+        data_list_file_path: path to the JSON datalist file. Must exist.
+        is_segmentation: if True, the "label" field is resolved as a path; if False, it is passed through
+            unchanged. Defaults to True.
+        data_list_key: top-level key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir: directory that relative paths are resolved against. If None, the directory containing
+            the datalist file is used.
+
+    Returns:
+        a list of dicts, one per entry, in the original order. Each dict has the same field names as its
+        input item, with "image" (and "label" in segmentation mode) holding normalized paths. A path that was
+        a list stays a list of normalized paths.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the JSON object lacks ``data_list_key``, an item is
+            not a mapping, or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not contain the key '{data_list_key}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, got {type(item).__name__}: {item!r}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        result.append(new_item)
+
+    return result
