+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list in {data_list_file_path} contains a non-string element: {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' in {data_list_file_path} must be a string or a list of strings: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items with
+    resolved paths.
+
+    The entries are read from the top-level key ``data_list_key``. The ``"image"`` field of every item is
+    resolved against ``base_dir``. The ``"label"`` field is resolved the same way only when ``is_segmentation``
+    is True; otherwise it is returned exactly as stored (for example an integer class id). All other fields
+    are returned unchanged.
+
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted to an image-only item.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, resolve the ``"label"`` field as a path. If False, leave labels unchanged.
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON file that holds the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input item, with
+        ``"image"`` (and ``"label"`` in segmentation mode) holding a normalized path string, or a list of
+        normalized path strings when the input value was a list.
+
+    Example::
+
+        >>> items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        >>> items[0]["image"]  # doctest: +SKIP
+        '/data/imagesTr/case_0.nii.gz'
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Datalist file {data_list_file_path} must contain a JSON object at the top level")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item under key '{data_list_key}' in {data_list_file_path} must be a mapping")
+        processed: Dict[str, Any] = {}
+        for field, value in item.items():
+            if field == "image" or (field == "label" and is_segmentation):
+                processed[field] = _resolve_path(value, base_dir, data_list_file_path, field)
+            else:
+                processed[field] = value
+        result.append(processed)
+    return result
