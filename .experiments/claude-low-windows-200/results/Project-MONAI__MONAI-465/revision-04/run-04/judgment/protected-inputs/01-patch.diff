+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        path = self._write_datalist(
+            {
+                "name": "demo",
+                "training": [
+                    {"image": "imagesTr/case0.nii", "label": "labelsTr/case0.nii", "fold": 0},
+                    {"image": ["imagesTr/a.nii", "imagesTr/b.nii"], "label": "labelsTr/case1.nii"},
+                ],
+            }
+        )
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/case0.nii")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labelsTr/case0.nii")))
+        self.assertEqual(result[0]["fold"], 0)
+        self.assertEqual(
+            result[1]["image"],
+            [
+                os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/a.nii")),
+                os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/b.nii")),
+            ],
+        )
+        self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labelsTr/case1.nii")))
+
+    def test_cls_values(self):
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": "imagesTr/case0.nii", "label": 1},
+                    {"image": "imagesTr/case1.nii", "label": 0},
+                ],
+            }
+        )
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/case0.nii")))
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["label"], 1)
+        self.assertIsInstance(result[1]["label"], int)
+        self.assertEqual(result[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        abs_image = os.path.join(self.tmp_dir, "imagesTr", "abs.nii")
+        abs_label = os.path.join(self.tmp_dir, "labelsTr", "abs.nii")
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                    {"image": "imagesTr/rel.nii", "label": "labelsTr/rel.nii"},
+                ],
+            }
+        )
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/rel.nii")))
+        self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labelsTr/rel.nii")))
+
+    def test_seg_no_labels(self):
+        path = self._write_datalist({"test": ["imagesTs/case0.nii", "imagesTs/case1.nii"]})
+        result = load_decathalon_datalist(path, data_list_key="test", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(list(result[0].keys()), ["image"])
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTs/case0.nii")))
+        self.assertEqual(list(result[1].keys()), ["image"])
+
+
+if __name__ == "__main__":
+    unittest.main()
