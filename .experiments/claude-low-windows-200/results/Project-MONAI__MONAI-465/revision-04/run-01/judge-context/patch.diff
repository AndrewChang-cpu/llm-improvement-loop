+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as file:
+            json.dump(content, file)
+        return path
+
+    def _expected(self, base, name):
+        return os.path.normpath(os.path.join(base, name))
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "name": "unused",
+                "training": [
+                    {"image": "imgs/case0.nii", "label": "labels/case0.nii", "fold": 1},
+                    {"image": ["imgs/./case1_a.nii", "imgs//case1_b.nii"], "label": ["labels/case1.nii"]},
+                ],
+            }
+            path = self._write_datalist(tmp, datalist)
+            items = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=True, data_list_key="training", base_dir=tmp
+            )
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], self._expected(tmp, "imgs/case0.nii"))
+            self.assertEqual(items[0]["label"], self._expected(tmp, "labels/case0.nii"))
+            self.assertEqual(items[0]["fold"], 1)
+            self.assertEqual(
+                items[1]["image"],
+                [self._expected(tmp, "imgs/case1_a.nii"), self._expected(tmp, "imgs/case1_b.nii")],
+            )
+            self.assertEqual(items[1]["label"], [self._expected(tmp, "labels/case1.nii")])
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": 0},
+                    {"image": "imgs/case1.nii", "label": 1},
+                ]
+            }
+            path = self._write_datalist(tmp, datalist)
+            items = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=False, data_list_key="training", base_dir=tmp
+            )
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], self._expected(tmp, "imgs/case0.nii"))
+            self.assertEqual(items[1]["image"], self._expected(tmp, "imgs/case1.nii"))
+            self.assertEqual(items[0]["label"], 0)
+            self.assertEqual(items[1]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertIsInstance(items[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp, "img_abs.nii")
+            abs_label = os.path.join(tmp, "lbl_abs.nii")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                    {"image": "imgs/rel.nii", "label": "labels/rel.nii"},
+                ]
+            }
+            path = self._write_datalist(tmp, datalist)
+            items = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+            self.assertEqual(items[1]["image"], self._expected(tmp, "imgs/rel.nii"))
+            self.assertEqual(items[1]["label"], self._expected(tmp, "labels/rel.nii"))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": ["imgs/test0.nii", "imgs/test1.nii"],
+            }
+            path = self._write_datalist(tmp, datalist)
+            items = load_decathalon_datalist(data_list_file_path=path, data_list_key="test", base_dir=tmp)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0], {"image": self._expected(tmp, "imgs/test0.nii")})
+            self.assertEqual(items[1], {"image": self._expected(tmp, "imgs/test1.nii")})
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
