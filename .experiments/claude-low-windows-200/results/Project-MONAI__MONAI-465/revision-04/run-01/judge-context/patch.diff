+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string or a list of path strings against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file {data_list_file_path} "
+                    "must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its per-case items with
+    the ``"image"`` and, in segmentation mode, ``"label"`` paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the ``"label"`` field of each item is resolved as a path.
+            If False, the ``"label"`` value is returned exactly as stored, for example an integer class id.
+        data_list_key (str): key in the top-level JSON object that holds the list of entries.
+            Defaults to ``"training"``. When it is ``"test"``, each entry is a plain path string and is
+            converted to an image-only item ``{"image": entry}``.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which means the
+            directory containing ``data_list_file_path``. Absolute paths keep their absolute meaning.
+
+    Returns:
+        A list of dicts in the original entry order. Each dict has the same keys as its input item. The
+        ``"image"`` value (and ``"label"`` in segmentation mode) is a normalized path string, or a list of
+        normalized path strings when the input value was a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the top-level object lacks ``data_list_key``,
+            an item is not a mapping, or a path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "<dataset dir>/imagesTr/case0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as file:
+        datalist = json.load(file)
+
+    if not isinstance(datalist, dict):
+        raise ValueError(f"Datalist file {data_list_file_path} must contain a JSON object at the top level.")
+    if data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item under key '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        resolved = dict(item)
+        if "image" in item:
+            resolved["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            resolved["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        output.append(resolved)
+    return output
