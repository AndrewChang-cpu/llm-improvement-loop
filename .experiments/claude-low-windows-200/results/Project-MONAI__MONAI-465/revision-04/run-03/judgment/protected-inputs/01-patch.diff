+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            datalist = {
+                "training": [
+                    {"image": os.path.join("imgs", "img0.nii"), "label": os.path.join("labels", "lbl0.nii"), "id": "a"},
+                    {"image": ["imgs", "img1.nii"], "label": ["labels", "lbl1.nii"]},
+                ]
+            }
+            path = self._write_datalist(tmp, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labels", "lbl0.nii")))
+            self.assertEqual(result[0]["id"], "a")
+            self.assertEqual(result[1]["image"], [os.path.normpath(os.path.join(tmp, "imgs", "img1.nii"))])
+            self.assertEqual(result[1]["label"], [os.path.normpath(os.path.join(tmp, "labels", "lbl1.nii"))])
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii", "label": 1},
+                    {"image": "img1.nii", "label": 0},
+                ]
+            }
+            path = self._write_datalist(tmp, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "img1.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            abs_image = os.path.join(tmp, "img0.nii")
+            abs_label = os.path.join(tmp, "lbl0.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = self._write_datalist(tmp, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "lbl0.nii")))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            datalist = {"test": [os.path.join("imgs", "img0.nii"), os.path.join("imgs", "img1.nii")]}
+            path = self._write_datalist(tmp, datalist)
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "img0.nii")))
+            self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
