+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element {element!r} must be a string, got {type(element).__name__}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value {value!r} must be a string or a list of strings, got {type(value).__name__}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" value is left exactly as stored (for example an integer class id or a class name string).
+            Defaults to True.
+        data_list_key (str): top-level key in the datalist holding the list of entries. Defaults to "training".
+            If it equals "test", each plain path string entry is converted to an item ``{"image": entry}``.
+        base_dir (str): directory that relative "image" and "label" paths are joined with. If None, the
+            directory containing the datalist file is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, in the original entry order. Each dictionary has the same field names as its
+        input item. The "image" field is resolved to a normalized path string, or a list of them if the input was
+        a list. In segmentation mode the "label" field is resolved the same way. All other fields are unchanged.
+        Items without "image" or "label" are returned without those fields added.
+
+    Raises:
+        ValueError: if the file does not exist, the JSON top level is not an object, ``data_list_key`` is missing,
+            the entries are not a list, an item is not a mapping, or a path value is neither a string nor a list
+            of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0] == {"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Data list file '{data_list_file_path}' must contain a JSON object at the top level.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item under key '{data_list_key}' in '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        output.append(new_item)
+    return output
