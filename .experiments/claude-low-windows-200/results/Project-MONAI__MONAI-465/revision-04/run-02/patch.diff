+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            content = {
+                "name": "demo",
+                "training": [
+                    {"image": "imagesTr/img0.nii", "label": "labelsTr/lbl0.nii", "name": "case0"},
+                    {
+                        "image": ["imagesTr/a.nii", "imagesTr/b.nii"],
+                        "label": ["labelsTr/a.nii", "labelsTr/b.nii"],
+                    },
+                ],
+            }
+            path = self._write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, True, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(
+                result[0],
+                {
+                    "image": os.path.normpath(os.path.join(tmp, "imagesTr", "img0.nii")),
+                    "label": os.path.normpath(os.path.join(tmp, "labelsTr", "lbl0.nii")),
+                    "name": "case0",
+                },
+            )
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp, "imagesTr", "a.nii")),
+                    os.path.normpath(os.path.join(tmp, "imagesTr", "b.nii")),
+                ],
+            )
+            self.assertEqual(
+                result[1]["label"],
+                [
+                    os.path.normpath(os.path.join(tmp, "labelsTr", "a.nii")),
+                    os.path.normpath(os.path.join(tmp, "labelsTr", "b.nii")),
+                ],
+            )
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            content = {
+                "training": [
+                    {"image": "imagesTr/img0.nii", "label": 0},
+                    {"image": "imagesTr/img1.nii", "label": 2},
+                ],
+            }
+            path = self._write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, False, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr", "img0.nii")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imagesTr", "img1.nii")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            abs_image = os.path.join(tmp, "img0.nii")
+            abs_label = os.path.join(tmp, "lbl0.nii")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = self._write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "lbl0.nii")))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            content = {"test": ["imagesTs/t0.nii", "imagesTs/t1.nii"]}
+            path = self._write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, True, "test", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tmp, "imagesTs", "t0.nii"))})
+            self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
