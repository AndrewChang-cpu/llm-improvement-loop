+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str, data_list_key: str) -> Any:
+    """Resolve a path string or list of path strings against ``base_dir``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' under key '{data_list_key}' "
+                    f"in datalist file {data_list_file_path} must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' under key '{data_list_key}' in datalist file {data_list_file_path} "
+        f"must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", True, "training", "/data/task01")
+        # items[0] == {"image": "/data/task01/imagesTr/case_0.nii.gz",
+        #              "label": "/data/task01/labelsTr/case_0.nii.gz"}
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path.
+            If False, "label" is returned exactly as stored (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON object holding the list of entries.
+            If it is "test", each plain string entry is converted to an image-only item
+            ``{"image": entry}``. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory
+            containing ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same keys as its input item.
+        The "image" value, and the "label" value in segmentation mode, are normalized paths
+        (strings, or lists of strings when the input was a list). Other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, ``data_list_key`` is missing, an item
+            is not a mapping, or an image or label path is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Every item under key '{data_list_key}' must be a mapping, got {item!r}.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path, data_list_key)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path, data_list_key)
+        result.append(new_item)
+    return result
