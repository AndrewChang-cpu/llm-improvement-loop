+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 0},
+                    {"image": ["imgs/b0.nii", "imgs/b1.nii"], "label": "./labels//b.nii", "fold": 1},
+                ],
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            out = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+
+            self.assertEqual(len(out), 2)
+            self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "a.nii")))
+            self.assertEqual(out[0]["label"], os.path.normpath(os.path.join(tmp, "labels", "a.nii")))
+            self.assertEqual(out[0]["fold"], 0)
+            expected_images = [
+                os.path.normpath(os.path.join(tmp, "imgs", "b0.nii")),
+                os.path.normpath(os.path.join(tmp, "imgs", "b1.nii")),
+            ]
+            self.assertEqual(out[1]["image"], expected_images)
+            self.assertEqual(out[1]["label"], os.path.normpath(os.path.join(tmp, "labels", "b.nii")))
+            self.assertEqual(out[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": 2},
+                    {"image": "imgs/b.nii", "label": 0},
+                ],
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            out = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+
+            self.assertEqual(len(out), 2)
+            self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "a.nii")))
+            self.assertEqual(out[0]["label"], 2)
+            self.assertIsInstance(out[0]["label"], int)
+            self.assertEqual(out[1]["image"], os.path.normpath(os.path.join(tmp, "imgs", "b.nii")))
+            self.assertEqual(out[1]["label"], 0)
+            self.assertIsInstance(out[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp, "a.nii")
+            abs_label = os.path.join(tmp, "a_label.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            out = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(len(out), 1)
+            self.assertEqual(out[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(out[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/t0.nii", "imgs/t1.nii", "imgs/t2.nii"]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            out = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(len(out), 3)
+            self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "t0.nii")))
+            self.assertEqual(set(out[0].keys()), {"image"})
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
