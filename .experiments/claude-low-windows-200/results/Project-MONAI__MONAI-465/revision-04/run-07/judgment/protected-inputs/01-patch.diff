+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path string or list of path strings.
+        base_dir (str): directory to join the path(s) with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+                    f"but a list element is {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, but got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items with the
+    "image" (and, in segmentation mode, "label") paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False,
+            the "label" is returned exactly as stored, whatever its type (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries.
+            Defaults to "training". When it is "test", each plain path string entry is converted to an
+            image-only item ``{"image": entry}``.
+        base_dir (str): directory that relative paths are joined with. If None, the directory of
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries in the original entry order. Each dictionary has the same keys as its input
+        item; "image" (and "label" in segmentation mode) hold normalized paths, either strings or lists of
+        strings when the input was a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: when the datalist file does not exist, the top-level JSON object lacks ``data_list_key``,
+            an item is not a mapping, or a resolved path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # e.g. [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz", "fold": 0}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Datalist file '{data_list_file_path}' must contain a JSON object at the top level.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(f"Every item under key '{data_list_key}' in '{data_list_file_path}' must be a mapping.")
+
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+
+    return result
