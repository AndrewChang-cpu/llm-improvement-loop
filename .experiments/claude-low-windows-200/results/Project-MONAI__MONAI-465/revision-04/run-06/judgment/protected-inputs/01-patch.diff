+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """Join a string or a list of strings with ``base_dir`` and normalize the result."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element {element!r} must be a string, got {type(element).__name__}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value {value!r} must be a string or a list of strings, got {type(value).__name__}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    The entries stored under ``data_list_key`` are returned as a list of items, one per entry, in the original order.
+    The ``"image"`` field of every item is resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is true; in classification mode (``is_segmentation`` false) the label is returned exactly as
+    stored, whatever its type. Any other field is kept unchanged.
+
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted into an image-only item
+    ``{"image": entry}`` before resolution, regardless of ``is_segmentation``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the labels are paths to be resolved (segmentation) or are passed through
+            unchanged (classification). Defaults to True.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. If None, the directory containing
+            the datalist file is used.
+
+    Returns:
+        A list of dictionaries, one per entry, with the same field names as the input items. The ``"image"`` value,
+        and the ``"label"`` value in segmentation mode, are normalized paths (strings, or lists of strings when the
+        input was a list). All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+
+    Example::
+
+        >>> items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        >>> items[0]["image"], items[0]["label"]  # doctest: +SKIP
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict):
+        raise ValueError(f"Datalist file '{data_list_file_path}' must contain a JSON object at the top level.")
+
+    if data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in datalist file '{data_list_file_path}' must be a mapping, got {item!r}.")
+
+        resolved = dict(item)
+        if "image" in item:
+            resolved["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            resolved["label"] = _resolve_path(item["label"], base_dir)
+        output.append(resolved)
+
+    return output
