+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            base = os.path.join(tempdir, "data")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {
+                "training": [
+                    {"image": "imgs/case_0.nii", "label": "labels/case_0.nii", "extra": "keep me"},
+                    {"image": ["imgs/a.nii", "./imgs//b.nii"], "label": ["labels/a.nii", "labels/b.nii"]},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=base
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/case_0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base, "labels/case_0.nii")))
+            self.assertEqual(result[0]["extra"], "keep me")
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base, "imgs/a.nii")),
+                    os.path.normpath(os.path.join(base, "imgs/b.nii")),
+                ],
+            )
+            self.assertEqual(
+                result[1]["label"],
+                [
+                    os.path.normpath(os.path.join(base, "labels/a.nii")),
+                    os.path.normpath(os.path.join(base, "labels/b.nii")),
+                ],
+            )
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            base = os.path.join(tempdir, "data")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"training": [{"image": "imgs/0.nii", "label": 1}, {"image": "imgs/1.nii", "label": 0}]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=base
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "imgs/0.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "imgs/1.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            abs_image = os.path.join(tempdir, "image_0.nii")
+            abs_label = os.path.join(tempdir, "label_0.nii")
+            content = {
+                "training": [
+                    {"image": "rel_image.nii", "label": "rel_label.nii"},
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "rel_image.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "rel_label.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[1]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            base = os.path.join(tempdir, "data")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"test": ["img_0.nii", "img_1.nii"]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=base)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base, "img_0.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base, "img_1.nii")))
+
+
+if __name__ == "__main__":
+    unittest.main()
