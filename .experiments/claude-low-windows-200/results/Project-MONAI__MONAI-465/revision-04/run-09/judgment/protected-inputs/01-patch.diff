+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Args:
+        value (str or list of str): path or list of paths to resolve.
+        base_dir (str): directory the paths are joined with.
+
+    Returns:
+        (str or list of str): normalized path(s), with list order preserved.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list contains a non-string element: {element!r}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value must be a string or a list of strings, got: {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items with resolved paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is left exactly as stored, whatever its type (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key of the datalist that holds the list of entries. Defaults to "training".
+            When it equals "test", each entry is a plain path string and is converted to an image-only item.
+        base_dir (str or None): directory that relative "image" and "label" paths are resolved against. If None,
+            the directory containing `data_list_file_path` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, in the same order as the entries in the datalist. Each dict has the same fields as its
+        input item. "image" holds a resolved path (or a list of resolved paths), and in segmentation mode "label"
+        holds a resolved path (or list of paths). All other fields are unchanged. For the "test" key, each dict is
+        ``{"image": <resolved path>}``.
+
+    Example::
+
+        {
+            "training": [
+                {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 0}
+            ]
+        }
+
+        load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "<dir>/imagesTr/case_0.nii.gz", "label": "<dir>/labelsTr/case_0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file: {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' must hold a list in datalist file: {data_list_file_path}.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item must be a mapping, got {item!r} in datalist file: {data_list_file_path}.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        result.append(new_item)
+
+    return result
