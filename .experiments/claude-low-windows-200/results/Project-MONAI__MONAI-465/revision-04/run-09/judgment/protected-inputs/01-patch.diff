+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _expected(base_dir, name):
+    return os.path.normpath(os.path.join(base_dir, name))
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "name": "demo",
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 0},
+                    {"image": ["imagesTr/a.nii.gz", "imagesTr/b.nii.gz"], "label": "labelsTr/case_1.nii.gz"},
+                ],
+            }
+            json_path = os.path.join(tempdir, "datalist.json")
+            with open(json_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(json_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], _expected(tempdir, "imagesTr/case_0.nii.gz"))
+            self.assertEqual(result[0]["label"], _expected(tempdir, "labelsTr/case_0.nii.gz"))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(
+                result[1]["image"],
+                [_expected(tempdir, "imagesTr/a.nii.gz"), _expected(tempdir, "imagesTr/b.nii.gz")],
+            )
+            self.assertEqual(result[1]["label"], _expected(tempdir, "labelsTr/case_1.nii.gz"))
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": 0},
+                    {"image": "imagesTr/case_1.nii.gz", "label": 2},
+                ],
+            }
+            json_path = os.path.join(tempdir, "datalist.json")
+            with open(json_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(json_path, False, "training", tempdir)
+
+            self.assertEqual(result[0]["image"], _expected(tempdir, "imagesTr/case_0.nii.gz"))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], _expected(tempdir, "imagesTr/case_1.nii.gz"))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            image_path = os.path.join(tempdir, "case_0.nii.gz")
+            label_path = os.path.join(tempdir, "case_0_label.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            json_path = os.path.join(tempdir, "datalist.json")
+            with open(json_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(json_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], _expected(tempdir, "case_0.nii.gz"))
+            self.assertEqual(result[0]["label"], _expected(tempdir, "case_0_label.nii.gz"))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "name": "demo",
+                "test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"],
+            }
+            json_path = os.path.join(tempdir, "datalist.json")
+            with open(json_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(json_path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], _expected(tempdir, "imagesTs/case_0.nii.gz"))
+            self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
