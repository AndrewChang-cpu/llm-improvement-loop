+
+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    file_path = os.path.join(directory, "datalist.json")
+    with open(file_path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+    return file_path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist = {
+                "name": "example",
+                "training": [
+                    {"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 1},
+                    {"image": ["imgs/b0.nii", "imgs/b1.nii"], "label": ["labels/b.nii"]},
+                ],
+            }
+            file_path = _write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(
+                data_list_file_path=file_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels", "a.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "imgs", "b0.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "imgs", "b1.nii")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], [os.path.normpath(os.path.join(tmp_dir, "labels", "b.nii"))])
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": 0},
+                    {"image": "imgs/b.nii", "label": 2},
+                ],
+            }
+            file_path = _write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(
+                data_list_file_path=file_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "b.nii")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            image_path = os.path.join(tmp_dir, "image.nii")
+            label_path = os.path.join(tmp_dir, "label.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = _write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(
+                data_list_file_path=file_path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "image.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "label.nii")))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist = {"test": ["imgs/t0.nii", "imgs/t1.nii"]}
+            file_path = _write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(data_list_file_path=file_path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "t0.nii")))
+            self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
