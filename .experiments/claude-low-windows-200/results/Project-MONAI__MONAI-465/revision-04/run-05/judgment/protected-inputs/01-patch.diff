+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """Join a string or list of strings with ``base_dir`` and normalize the result."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+                    f"but a list element has type {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+        f"but found type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False,
+            the "label" field is returned exactly as stored, so classification labels such as integer
+            class ids keep their type and value.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries.
+            Defaults to "training". When it is "test", each plain path entry is converted to an
+            image-only item ``{"image": entry}``.
+        base_dir (str): directory that relative "image" and "label" paths are joined with.
+            Defaults to None, which means the directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same keys as its input
+        item. The "image" value, and the "label" value when ``is_segmentation`` is True, are normalized
+        paths: strings, or lists of strings when the input value was a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing, if an item is not
+            a mapping, or if an "image" or segmentation "label" value is neither a string nor a list of strings.
+
+    Example::
+
+        {
+            "name": "Example",
+            "training": [
+                {"image": "imgs/case0.nii.gz", "label": "labels/case0.nii.gz", "fold": 0},
+            ],
+        }
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is the normalized path "<datalist directory>/imgs/case0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item under '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
