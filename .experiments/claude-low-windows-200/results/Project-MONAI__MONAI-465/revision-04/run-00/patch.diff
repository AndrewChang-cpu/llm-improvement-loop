+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a string or list-of-strings path value against ``base_dir``.
+
+    Args:
+        value: the stored path value, a string or a list of strings.
+        base_dir (str): directory the relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in data list file {file_path} contains a non-string element: {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in data list file {file_path} must be a string or a list of strings: {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    The entries stored under ``data_list_key`` are returned as a list of items in their original order. The
+    ``"image"`` field of every item is resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; otherwise it is kept exactly as stored (for example an integer class id). Other
+    fields are never modified. If ``data_list_key`` is ``"test"``, each plain path entry is converted to an
+    image-only item ``{"image": entry}`` before resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the items are segmentation items. If True, the ``"label"`` field is resolved
+            as a path. If False, the ``"label"`` field is passed through unchanged. Defaults to True.
+        data_list_key (str): top-level key of the JSON object that holds the entry list. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the same field names as its
+        input item, with ``"image"`` (and ``"label"`` in segmentation mode) holding resolved paths: strings, or lists
+        of strings when the input value was a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: when the datalist file does not exist, ``data_list_key`` is missing, an item is not a mapping, or
+            a path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "<datalist directory>/imagesTr/case_0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing in data list file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each item in data list file {data_list_file_path} must be a mapping, got: {item!r}.")
+        new_item: Dict[str, Any] = {}
+        for field, value in item.items():
+            if field == "image" or (field == "label" and is_segmentation):
+                new_item[field] = _resolve_path(value, base_dir, field, data_list_file_path)
+            else:
+                new_item[field] = value
+        processed.append(new_item)
+    return processed
