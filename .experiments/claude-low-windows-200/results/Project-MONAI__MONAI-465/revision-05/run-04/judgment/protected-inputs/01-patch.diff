+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _join(base_dir, rel_path):
+    return os.path.normpath(os.path.join(base_dir, rel_path))
+
+
+def _write_datalist(path, content):
+    with open(path, "w") as file:
+        json.dump(content, file)
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data_list_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 0},
+                    {"image": "imagesTr/case_1.nii.gz", "label": "labelsTr/case_1.nii.gz", "fold": 1},
+                ],
+            }
+            _write_datalist(data_list_path, datalist)
+
+            result = load_decathalon_datalist(
+                data_list_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], _join(tmp_dir, "imagesTr/case_0.nii.gz"))
+            self.assertEqual(result[0]["label"], _join(tmp_dir, "labelsTr/case_0.nii.gz"))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], _join(tmp_dir, "imagesTr/case_1.nii.gz"))
+            self.assertEqual(result[1]["label"], _join(tmp_dir, "labelsTr/case_1.nii.gz"))
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data_list_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": 1},
+                    {"image": "imagesTr/case_1.nii.gz", "label": 0},
+                ],
+            }
+            _write_datalist(data_list_path, datalist)
+
+            result = load_decathalon_datalist(
+                data_list_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], _join(tmp_dir, "imagesTr/case_0.nii.gz"))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], _join(tmp_dir, "imagesTr/case_1.nii.gz"))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data_list_path = os.path.join(tmp_dir, "datalist.json")
+            abs_image = os.path.join(tmp_dir, "case_0.nii.gz")
+            abs_label = os.path.join(tmp_dir, "case_0_label.nii.gz")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ],
+            }
+            _write_datalist(data_list_path, datalist)
+
+            result = load_decathalon_datalist(
+                data_list_path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], _join(tmp_dir, "case_0.nii.gz"))
+            self.assertEqual(result[0]["label"], _join(tmp_dir, "case_0_label.nii.gz"))
+            self.assertTrue(os.path.isabs(result[0]["image"]))
+            self.assertTrue(os.path.isabs(result[0]["label"]))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data_list_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "test": [
+                    "imagesTs/case_0.nii.gz",
+                    "imagesTs/case_1.nii.gz",
+                ],
+            }
+            _write_datalist(data_list_path, datalist)
+
+            result = load_decathalon_datalist(
+                data_list_path, is_segmentation=True, data_list_key="test", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], _join(tmp_dir, "imagesTs/case_0.nii.gz"))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
