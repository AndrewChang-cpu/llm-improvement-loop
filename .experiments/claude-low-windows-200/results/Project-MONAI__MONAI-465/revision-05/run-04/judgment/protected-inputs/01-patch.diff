+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """Resolve a string path, or each string in a list of paths, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"List elements of '{field}' in {data_list_file_path} must be strings, got {element!r}"
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"'{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return its per-case items with the
+    "image" and, in segmentation mode, "label" fields resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist, otherwise a ValueError is raised.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is returned exactly as stored, so integer class ids and class names stay unchanged.
+        data_list_key (str): top-level key in the datalist that holds the list of entries. Defaults to "training".
+            If it is "test", each plain path string entry is converted to an image-only item ``{"image": entry}``.
+        base_dir (str): directory that relative paths are joined to. Defaults to None, which means the directory
+            containing ``data_list_file_path``. Absolute paths keep their absolute meaning.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the same field names as
+        its input item. The "image" field, and the "label" field in segmentation mode, is a normalized path string
+        when the input was a string, or a list of normalized path strings with the same length and order when the
+        input was a list. All other fields are copied unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the parsed JSON, if an
+            item is not a mapping, or if a path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "<datalist dir>/imagesTr/case_0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Each item under '{data_list_key}' in {data_list_file_path} must be a mapping, got {item!r}"
+            )
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
