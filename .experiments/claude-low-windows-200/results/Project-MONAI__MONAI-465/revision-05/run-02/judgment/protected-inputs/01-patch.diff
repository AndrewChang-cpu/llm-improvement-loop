+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string of a list of path strings, against `base_dir`.
+    Each string is joined with `base_dir` and normalized. Elements of a list are resolved independently.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list contains a non-string element {element!r}: {value!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its entries as a list of items.
+
+    The entries stored under `data_list_key` are processed in order. Each item must be a mapping. The "image"
+    field is resolved against `base_dir`. The "label" field is resolved only when `is_segmentation` is True;
+    otherwise it is returned exactly as stored, so integer or string class labels are kept unchanged. All other
+    fields are returned unchanged. Items without "image" or "label" are not errors.
+
+    If `data_list_key` is "test", each entry is a plain path string and is converted to an image-only item
+    before resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field is resolved as a path. If False, labels are passed
+            through unchanged. Defaults to True.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir (str): directory against which relative paths are resolved. If None, the directory containing
+            the datalist file is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as its input
+        item. "image", and "label" in segmentation mode, hold resolved paths: a string when the input was a
+        string, or a list of resolved path strings with the same length and order when the input was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if `data_list_key` is missing from the JSON object,
+            if an item is not a mapping, or if a path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is a normalized path under the directory containing dataset.json
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing in datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"datalist item must be a mapping, got {item!r} in file: {data_list_file_path}")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        output.append(new_item)
+    return output
