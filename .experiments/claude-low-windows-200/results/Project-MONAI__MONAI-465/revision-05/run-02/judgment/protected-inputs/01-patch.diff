+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/img1.nii.gz",
+                        "label": "labelsTr/label1.nii.gz",
+                        "name": "case1",
+                    },
+                    {
+                        "image": ["imagesTr/./a.nii.gz", "imagesTr//b.nii.gz"],
+                        "label": "labelsTr/label2.nii.gz",
+                    },
+                ]
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/img1.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/label1.nii.gz")))
+            self.assertEqual(result[0]["name"], "case1")
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "imagesTr/./a.nii.gz")),
+                    os.path.normpath(os.path.join(base_dir, "imagesTr//b.nii.gz")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/label2.nii.gz")))
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {"training": [{"image": "img1.nii.gz", "label": 1}, {"image": "img2.nii.gz", "label": 0}]}
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img1.nii.gz")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "img2.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            image_path = os.path.join(tempdir, "img.nii.gz")
+            label_path = os.path.join(tempdir, "label.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {"test": ["imagesTs/t1.nii.gz", "imagesTs/t2.nii.gz"]}
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(base_dir, "imagesTs/t1.nii.gz"))})
+            self.assertEqual(result[1], {"image": os.path.normpath(os.path.join(base_dir, "imagesTs/t2.nii.gz"))})
+
+
+if __name__ == "__main__":
+    unittest.main()
