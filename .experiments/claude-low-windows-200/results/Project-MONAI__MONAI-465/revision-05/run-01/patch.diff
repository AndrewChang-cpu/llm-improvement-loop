+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmpdir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tmpdir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        datalist = {
+            "training": [{"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 1}],
+        }
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, True, "training", self.tmpdir)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmpdir, "imagesTr", "case_0.nii.gz")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(self.tmpdir, "labelsTr", "case_0.nii.gz")))
+        self.assertEqual(result[0]["fold"], 1)
+
+    def test_cls_values(self):
+        datalist = {
+            "training": [{"image": "imagesTr/case_0.nii.gz", "label": 2}],
+        }
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, False, "training", self.tmpdir)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmpdir, "imagesTr", "case_0.nii.gz")))
+        self.assertEqual(result[0]["label"], 2)
+        self.assertIsInstance(result[0]["label"], int)
+
+    def test_seg_no_basedir(self):
+        image = os.path.join(self.tmpdir, "image_0.nii.gz")
+        label = os.path.join(self.tmpdir, "label_0.nii.gz")
+        datalist = {
+            "training": [{"image": image, "label": label}],
+        }
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, True, "training", None)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(image))
+        self.assertEqual(result[0]["label"], os.path.normpath(label))
+        self.assertTrue(os.path.isabs(result[0]["image"]))
+        self.assertTrue(os.path.isabs(result[0]["label"]))
+
+    def test_seg_no_labels(self):
+        datalist = {
+            "test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"],
+        }
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, True, "test", self.tmpdir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(list(result[0].keys()), ["image"])
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmpdir, "imagesTs", "case_0.nii.gz")))
+
+
+if __name__ == "__main__":
+    unittest.main()
