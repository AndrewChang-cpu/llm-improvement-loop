+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a path string, or each string of a list of paths, against base_dir.
+    Each list element is resolved independently; elements are never joined to each other.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' contains a non-string element: {element!r}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return its per-case items with
+    image (and, in segmentation mode, label) paths resolved against base_dir.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False,
+            "label" is returned exactly as stored, whatever its type (e.g. an integer class id).
+            Defaults to True.
+        data_list_key (str): key under the top-level JSON object that holds the list of entries.
+            If it equals "test", each plain path string entry is converted to an image-only item
+            ``{"image": entry}``. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory
+            containing the datalist file is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as its
+        input item. "image" (and "label" in segmentation mode) hold a resolved, normalized path string when
+        the input was a string, or a list of resolved path strings with the same length and order when the
+        input was a list. All other fields are copied unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a
+            path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # e.g. [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}, ...]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "is not a mapping."
+            )
+        processed: Dict[str, Any] = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image")
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label")
+        items.append(processed)
+
+    return items
