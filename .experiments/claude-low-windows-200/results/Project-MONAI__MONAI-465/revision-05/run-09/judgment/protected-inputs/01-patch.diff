+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (string or list of strings) against base_dir.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+                    f"found element {element!r}"
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, found {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its per-case items with the
+    "image" field (and, in segmentation mode, the "label" field) resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is left exactly as stored (for example an integer class id or a class name string).
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries. Defaults to "training".
+            If it is "test", each plain string entry is converted to an image-only item ``{"image": entry}``.
+        base_dir (str): directory that relative paths are joined to. If None, the directory containing
+            the datalist file is used. Defaults to None.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same fields as its input item. The "image" field,
+        and the "label" field in segmentation mode, hold normalized paths: a string when the input was a string, or
+        a list of normalized path strings with the same length and order when the input was a list. All other
+        fields are unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are paths under the datalist directory
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list")
+
+    if data_list_key == "test":
+        items: List[Any] = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in items:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each item in key '{data_list_key}' of {data_list_file_path} must be a mapping")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        result.append(new_item)
+
+    return result
