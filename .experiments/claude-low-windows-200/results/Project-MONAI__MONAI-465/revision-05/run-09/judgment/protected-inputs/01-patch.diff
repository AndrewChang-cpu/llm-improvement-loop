+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/img0.nii", "label": "labelsTr/seg0.nii", "extra": "keep"},
+                    {"image": ["imagesTr/a.nii", "imagesTr/b.nii"], "label": ["labelsTr/a.nii", "labelsTr/b.nii"]},
+                ]
+            }
+            path = self._write_datalist(tmp, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/seg0.nii")))
+            self.assertEqual(result[0]["extra"], "keep")
+            expected_images = [os.path.normpath(os.path.join(tmp, p)) for p in ["imagesTr/a.nii", "imagesTr/b.nii"]]
+            expected_labels = [os.path.normpath(os.path.join(tmp, p)) for p in ["labelsTr/a.nii", "labelsTr/b.nii"]]
+            self.assertEqual(result[1]["image"], expected_images)
+            self.assertEqual(result[1]["label"], expected_labels)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {"training": [{"image": "img0.nii", "label": 1}, {"image": "img1.nii", "label": 0}]}
+            path = self._write_datalist(tmp, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp, "img0.nii")
+            label_path = os.path.join(tmp, "seg0.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            path = self._write_datalist(tmp, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imagesTs/img0.nii", "imagesTs/img1.nii"]}
+            path = self._write_datalist(tmp, datalist)
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTs/img0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
