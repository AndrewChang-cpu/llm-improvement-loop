+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        file_path = os.path.join(self.tmp_dir, "datalist.json")
+        with open(file_path, "w") as f:
+            json.dump(content, f)
+        return file_path
+
+    def test_seg_values(self):
+        datalist = {
+            "name": "demo",
+            "training": [
+                {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "extra": "keep me"}
+            ],
+        }
+        file_path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(file_path, True, "training", self.tmp_dir)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labelsTr/case_0.nii.gz")))
+        self.assertEqual(result[0]["extra"], "keep me")
+
+    def test_cls_values(self):
+        datalist = {"training": [{"image": "imagesTr/case_0.nii.gz", "label": 2}]}
+        file_path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(file_path, False, "training", self.tmp_dir)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(result[0]["label"], 2)
+        self.assertIsInstance(result[0]["label"], int)
+
+    def test_seg_no_basedir(self):
+        image_path = os.path.join(self.tmp_dir, "image_0.nii.gz")
+        label_path = os.path.join(self.tmp_dir, "label_0.nii.gz")
+        datalist = {"training": [{"image": image_path, "label": label_path}]}
+        file_path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(file_path, True, "training", None)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+        self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        datalist = {"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]}
+        file_path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(file_path, True, "test", self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTs/case_0.nii.gz")))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
