+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string of a list of paths, against ``base_dir``.
+
+    Args:
+        value (Any): a path string, or a list of path strings.
+        base_dir (str): directory used as the base of relative paths.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list, or a list contains a non-string.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list contains a non-string element: {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items.
+
+    The entries stored under ``data_list_key`` are returned in their original order. The "image" field of each
+    item is resolved against ``base_dir``. The "label" field is resolved only when ``is_segmentation`` is True;
+    otherwise it is returned exactly as stored, so integer class ids and class-name strings are kept unchanged.
+    All other fields are left untouched. Items without "image" or "label" are not rejected.
+
+    If ``data_list_key`` is "test", each entry is a plain path string and is converted to an image-only item
+    ``{"image": entry}`` before resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): whether the labels are file paths to be resolved (True) or passed through
+            unchanged, e.g. integer class ids (False). Defaults to True.
+        data_list_key (str): top-level key of the datalist holding the entries. Defaults to "training".
+        base_dir (str): directory against which relative paths are resolved. Defaults to None, which means
+            the directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as its input
+        item. "image" and, in segmentation mode, "label" hold resolved paths: a string when the input was a
+        string, or a list of resolved path strings with the same length and order when the input was a list.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are normalized paths under the datalist directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as file:
+        datalist_json = json.load(file)
+
+    if not isinstance(datalist_json, dict):
+        raise ValueError(f"top-level JSON of datalist file must be an object: {data_list_file_path}")
+    if data_list_key not in datalist_json:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = datalist_json[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed_items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"every item must be a mapping, got {item!r} in datalist file: {data_list_file_path}")
+        processed_item = dict(item)
+        if "image" in processed_item:
+            processed_item["image"] = _resolve_path(processed_item["image"], base_dir)
+        if is_segmentation and "label" in processed_item:
+            processed_item["label"] = _resolve_path(processed_item["label"], base_dir)
+        processed_items.append(processed_item)
+
+    return processed_items
