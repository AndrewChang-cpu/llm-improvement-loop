+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_dir(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, True)
+        return tmp
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = self._make_dir()
+        datalist = {
+            "training": [{"image": "imagesTr/img0.nii.gz", "label": "labelsTr/lbl0.nii.gz", "fold": 0}],
+        }
+        path = self._write_datalist(tmp, datalist)
+
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/img0.nii.gz")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/lbl0.nii.gz")))
+        self.assertEqual(items[0]["fold"], 0)
+
+    def test_cls_values(self):
+        tmp = self._make_dir()
+        datalist = {
+            "training": [{"image": "imagesTr/img0.nii.gz", "label": 1}],
+        }
+        path = self._write_datalist(tmp, datalist)
+
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/img0.nii.gz")))
+        self.assertEqual(items[0]["label"], 1)
+        self.assertIsInstance(items[0]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp = self._make_dir()
+        image = os.path.join(tmp, "img0.nii.gz")
+        label = os.path.join(tmp, "lbl0.nii.gz")
+        datalist = {
+            "training": [{"image": image, "label": label}],
+        }
+        path = self._write_datalist(tmp, datalist)
+
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii.gz")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "lbl0.nii.gz")))
+
+    def test_seg_no_labels(self):
+        tmp = self._make_dir()
+        datalist = {
+            "test": ["imagesTs/img0.nii.gz", "imagesTs/img1.nii.gz"],
+        }
+        path = self._write_datalist(tmp, datalist)
+
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=tmp)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTs/img0.nii.gz")))
+        self.assertNotIn("label", items[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
