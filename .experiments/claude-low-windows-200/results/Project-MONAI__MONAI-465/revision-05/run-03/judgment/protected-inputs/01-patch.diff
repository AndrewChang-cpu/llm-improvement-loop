+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized independently.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{field}' in datalist '{data_list_file_path}' must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"'{field}' value {value!r} in datalist '{data_list_file_path}' must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries are read from the top-level ``data_list_key`` of the JSON object. Each entry must be a mapping.
+    The ``"image"`` field is always resolved against ``base_dir``; the ``"label"`` field is resolved only when
+    ``is_segmentation`` is True. When it is False, labels are returned exactly as stored (for example integer
+    class ids). Other fields are never modified. Items without ``"image"`` or ``"label"`` are accepted.
+
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted to an image-only item
+    ``{"image": entry}`` before any validation or resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the datalist describes segmentation data. If True, the ``"label"`` field
+            is resolved as a path; if False, the ``"label"`` field is passed through unchanged. Defaults to True.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries. Defaults to
+            ``"training"``.
+        base_dir (str): directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, in the original order of the datalist. Each dictionary has the same field names as
+        its input item. ``"image"`` (and ``"label"`` in segmentation mode) holds a resolved path string when the
+        input was a string, or a list of resolved path strings with the same length and order when the input was a
+        list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "/data/imagesTr/img0.nii.gz", "label": "/data/labelsTr/lbl0.nii.gz", "fold": 0}, ...]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist '{data_list_file_path}' must hold a list of entries.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Entry {item!r} in datalist '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in item:
+            new_item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            new_item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+    return processed
