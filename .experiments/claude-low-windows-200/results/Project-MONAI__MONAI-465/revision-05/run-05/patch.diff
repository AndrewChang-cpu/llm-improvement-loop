+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value against ``base_dir``. A string is joined with ``base_dir`` and normalized.
+    A list is resolved element by element; each element must be a string.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element {element!r} in datalist {data_list_file_path} must be a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value {value!r} in datalist {data_list_file_path} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field is resolved as a path. If False, "label" is
+            left exactly as stored, whatever its type (for example an integer class id).
+        data_list_key (str): key in the top-level JSON object that holds the list of entries.
+            Defaults to "training". If it is "test", each entry is a plain path string and is converted
+            to an image-only item ``{"image": entry}``.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which means
+            the directory containing the datalist file.
+
+    Returns:
+        A list of dictionaries, in the original order of the datalist. Each dictionary has the same
+        fields as its input item. "image" (and "label" in segmentation mode) hold resolved paths:
+        a string when the input was a string, or a list of resolved path strings with the same
+        number of elements and order when the input was a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+
+    Example::
+
+        {
+            "training": [
+                {"image": "imagesTr/case0.nii.gz", "label": "labelsTr/case0.nii.gz"},
+            ]
+        }
+
+        load_decathalon_datalist("dataset.json")
+        # [{"image": "<dataset dir>/imagesTr/case0.nii.gz", "label": "<dataset dir>/labelsTr/case0.nii.gz"}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key {data_list_key} is missing from datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} under key {data_list_key} in {data_list_file_path} must be a mapping.")
+
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, data_list_file_path)
+        result.append(processed)
+
+    return result
