+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_tmp_dir(self):
+        tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp_dir, True)
+        return tmp_dir
+
+    @staticmethod
+    def _write_datalist(directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    @staticmethod
+    def _resolved(base_dir, rel_path):
+        return os.path.normpath(os.path.join(base_dir, rel_path))
+
+    def test_seg_values(self):
+        tmp_dir = self._make_tmp_dir()
+        datalist = {
+            "training": [
+                {"image": "imagesTr/img0.nii.gz", "label": "labelsTr/lbl0.nii.gz", "fold": 0},
+                {"image": ["imagesTr/img1a.nii.gz", "imagesTr/img1b.nii.gz"], "label": "labelsTr/lbl1.nii.gz"},
+            ],
+        }
+        path = self._write_datalist(tmp_dir, datalist)
+
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], self._resolved(tmp_dir, "imagesTr/img0.nii.gz"))
+        self.assertEqual(items[0]["label"], self._resolved(tmp_dir, "labelsTr/lbl0.nii.gz"))
+        self.assertEqual(items[0]["fold"], 0)
+
+        expected_images = [
+            self._resolved(tmp_dir, "imagesTr/img1a.nii.gz"),
+            self._resolved(tmp_dir, "imagesTr/img1b.nii.gz"),
+        ]
+        self.assertEqual(items[1]["image"], expected_images)
+        self.assertEqual(items[1]["label"], self._resolved(tmp_dir, "labelsTr/lbl1.nii.gz"))
+
+    def test_cls_values(self):
+        tmp_dir = self._make_tmp_dir()
+        datalist = {"training": [{"image": "imagesTr/img0.nii.gz", "label": 3, "name": "cat"}]}
+        path = self._write_datalist(tmp_dir, datalist)
+
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], self._resolved(tmp_dir, "imagesTr/img0.nii.gz"))
+        self.assertEqual(items[0]["label"], 3)
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[0]["name"], "cat")
+
+    def test_seg_no_basedir(self):
+        tmp_dir = self._make_tmp_dir()
+        abs_image = os.path.join(tmp_dir, "img0.nii.gz")
+        abs_label = os.path.join(tmp_dir, "lbl0.nii.gz")
+        datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+        path = self._write_datalist(tmp_dir, datalist)
+
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        tmp_dir = self._make_tmp_dir()
+        datalist = {"test": ["imagesTs/t0.nii.gz", "imagesTs/t1.nii.gz"]}
+        path = self._write_datalist(tmp_dir, datalist)
+
+        items = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0], {"image": self._resolved(tmp_dir, "imagesTs/t0.nii.gz")})
+        self.assertEqual(items[1], {"image": self._resolved(tmp_dir, "imagesTs/t1.nii.gz")})
+
+
+if __name__ == "__main__":
+    unittest.main()
