+import os
+import json
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+    Other types raise ValueError, naming the datalist file and the offending value.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Path list element {element!r} in datalist {data_list_file_path} must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Path value {value!r} in datalist {data_list_file_path} must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): the path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the "label" field is a path to be resolved. If True, "label" is resolved
+            against ``base_dir``. If False, "label" is left exactly as stored, so it may be any JSON value,
+            such as an integer class id.
+        data_list_key (str): the top-level key under which the list of entries is stored. Defaults to "training".
+            If it is "test", each plain path string entry is converted to an image-only item ``{"image": entry}``.
+        base_dir (str): the directory that relative paths are resolved against. Defaults to None, which means the
+            directory containing the datalist file.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the same fields as its
+        input item. "image" is resolved to a normalized path string, or to a list of normalized path strings with
+        the same length and order when the input was a list. In segmentation mode, "label" is resolved in the same
+        way. All other fields are returned unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the JSON object, if an
+            item is not a mapping, or if a path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is a normalized path under the datalist directory, and so is items[0]["label"]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key {data_list_key} is missing in datalist {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist {data_list_file_path} must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path)
+        output.append(processed)
+    return output
