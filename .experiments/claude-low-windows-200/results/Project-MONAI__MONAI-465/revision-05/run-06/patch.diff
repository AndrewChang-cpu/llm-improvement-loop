+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "name": "test",
+                "training": [
+                    {"image": "imgs/img0.nii", "label": "segs/seg0.nii", "extra": "keep"},
+                    {
+                        "image": ["imgs/./img1.nii", "imgs//img2.nii"],
+                        "label": ["segs/seg1.nii", "segs/seg2.nii"],
+                    },
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "segs/seg0.nii")))
+            self.assertEqual(items[0]["extra"], "keep")
+            self.assertEqual(
+                items[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "imgs/./img1.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "imgs//img2.nii")),
+                ],
+            )
+            self.assertEqual(
+                items[1]["label"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "segs/seg1.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "segs/seg2.nii")),
+                ],
+            )
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"training": [{"image": "imgs/img0.nii", "label": 1, "class_name": "cat"}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, False, "training", tmp_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii")))
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["class_name"], "cat")
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img0.nii")
+            abs_label = os.path.join(tmp_dir, "seg0.nii")
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "seg0.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"test": ["imgs/img0.nii", "imgs/img1.nii"]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
