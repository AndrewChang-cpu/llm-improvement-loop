+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """Resolve a string path, or each string in a list of paths, against base_dir."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+                    f"found list element {element!r}"
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, found {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries stored under ``data_list_key`` are returned as a list of items, in their original order. The
+    "image" field of every item is resolved against ``base_dir``. The "label" field is resolved only when
+    ``is_segmentation`` is True; when it is False, the label is returned exactly as stored (for example an
+    integer class id or a class-name string). All other fields are kept unchanged.
+
+    Each path value may be a string or a list of strings. A string is joined with ``base_dir`` and normalized;
+    a list is resolved element by element, so the result has the same number of elements, in the same order.
+
+    If ``data_list_key`` is "test", each entry is a plain path string and is converted to an image-only item
+    ``{"image": entry}`` before resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist, and the parsed top-level
+            object must contain ``data_list_key``.
+        is_segmentation (bool): whether to resolve the "label" field. Default is True. When False, labels are
+            passed through unchanged and are not type-checked.
+        data_list_key (str): top-level key under which the list of entries is stored. Default is "training".
+        base_dir (str): directory that relative paths are resolved against. Default is None, which means the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as its input
+        item. "image" (and "label" in segmentation mode) hold resolved path strings, or lists of resolved path
+        strings when the input was a list. Other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is a normalized path under the datalist's directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from data list file {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Every item under key '{data_list_key}' must be a mapping, found {item!r}")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+    return processed
