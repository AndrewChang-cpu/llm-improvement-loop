+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tempdir, "datalist.json")
+        with open(path, "w") as file:
+            json.dump(content, file)
+        return path
+
+    def test_seg_values(self):
+        datalist = {
+            "training": [
+                {"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 1},
+                {"image": ["imgs/b.nii", "imgs/c.nii"], "label": ["labels/b.nii", "labels/c.nii"]},
+            ],
+        }
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, True, "training", self.tempdir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tempdir, "imgs/a.nii")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(self.tempdir, "labels/a.nii")))
+        self.assertEqual(result[0]["fold"], 1)
+        self.assertEqual(
+            result[1]["image"],
+            [
+                os.path.normpath(os.path.join(self.tempdir, "imgs/b.nii")),
+                os.path.normpath(os.path.join(self.tempdir, "imgs/c.nii")),
+            ],
+        )
+        self.assertEqual(
+            result[1]["label"],
+            [
+                os.path.normpath(os.path.join(self.tempdir, "labels/b.nii")),
+                os.path.normpath(os.path.join(self.tempdir, "labels/c.nii")),
+            ],
+        )
+
+    def test_cls_values(self):
+        datalist = {"training": [{"image": "imgs/a.nii", "label": 2}, {"image": "imgs/b.nii", "label": 0}]}
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, False, "training", self.tempdir)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tempdir, "imgs/a.nii")))
+        self.assertEqual(result[0]["label"], 2)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        image_path = os.path.join(self.tempdir, "image.nii")
+        label_path = os.path.join(self.tempdir, "label.nii")
+        datalist = {"training": [{"image": image_path, "label": label_path}]}
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, True, "training", None)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+        self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        datalist = {"test": ["imgs/a.nii", "imgs/b.nii"]}
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, True, "test", self.tempdir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tempdir, "imgs/a.nii")))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
