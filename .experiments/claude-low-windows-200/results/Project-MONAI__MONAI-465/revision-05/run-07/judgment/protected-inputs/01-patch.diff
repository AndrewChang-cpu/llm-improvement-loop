+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [{"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz", "fold": 0}],
+            }
+            datalist_path = os.path.join(tempdir, "dataset.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/a.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [{"image": "imagesTr/a.nii.gz", "label": 2}],
+            }
+            datalist_path = os.path.join(tempdir, "dataset.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(datalist_path, False, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/a.nii.gz")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "a.nii.gz")
+            abs_label = os.path.join(tempdir, "a_label.nii.gz")
+            datalist = {
+                "training": [{"image": abs_image, "label": abs_label}],
+            }
+            datalist_path = os.path.join(tempdir, "dataset.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": ["imagesTs/b.nii.gz", "imagesTs/c.nii.gz"],
+            }
+            datalist_path = os.path.join(tempdir, "dataset.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTs/b.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
