+
+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    A list is resolved element by element; elements are never joined to each other.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list element must be a string, got {type(element).__name__}: {element!r}")
+            resolved.append(_resolve_path(element, base_dir))
+        return resolved
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return a list of per-case items.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of each
+            item is resolved as a path. If False, "label" is returned unchanged, whatever its type.
+        data_list_key (str): top-level key holding the list of entries, default "training". If it is "test",
+            each entry is a plain path string and is converted to an item with only an "image" field.
+        base_dir (str): directory that relative paths are resolved against. Default None, which means the
+            directory containing the datalist file.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same fields as its input item. The "image"
+        field, and the "label" field in segmentation mode, hold resolved paths: a string when the input was a
+        string, or a list of resolved path strings with the same length and order when the input was a list.
+        All other fields are unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "<dataset dir>/imagesTr/case_0.nii.gz"
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing from datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"each datalist item must be a mapping, got {type(item).__name__} in {data_list_file_path}"
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        items.append(new_item)
+
+    return items
