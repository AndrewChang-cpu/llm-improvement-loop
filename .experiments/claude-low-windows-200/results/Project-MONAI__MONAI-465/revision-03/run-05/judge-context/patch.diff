+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list, or a list contains a non-string element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element must be a string, got {element!r} of type {type(element)}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value must be a string or a list of strings, got {value!r} of type {type(value)}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return a list of per-case items.
+
+    The "image" field of every item is resolved against ``base_dir``. In segmentation mode the "label" field is
+    resolved the same way. In classification mode (``is_segmentation`` false) the "label" field is returned
+    exactly as stored, whatever its type. All other fields are kept unchanged. Items lacking "image" or "label"
+    are not errors.
+
+    When ``data_list_key`` equals "test", each entry is a plain path string and is converted to an image-only item
+    of the form ``{"image": entry}`` before any validation or path resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the labels are segmentation paths (True) or classification values (False).
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir (str): directory against which relative paths are resolved. Defaults to None, which means the
+            directory containing the datalist file.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input item, with "image"
+        (and "label" in segmentation mode) holding resolved paths: a string, or a list of strings when the input
+        was a list.
+
+    Raises:
+        ValueError: when the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are normalized paths resolved against the datalist directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each data list item must be a mapping, got {item!r} in '{data_list_file_path}'.")
+
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir)
+        items.append(processed)
+
+    return items
