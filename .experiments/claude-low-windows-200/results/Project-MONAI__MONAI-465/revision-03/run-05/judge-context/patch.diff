+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        datalist = {"name": "demo", "training": [{"image": "imgs/a.nii", "label": "labels/a.nii", "id": "case_a"}]}
+        path = self._write_datalist(datalist)
+        items = load_decathalon_datalist(path, True, "training", self.tmp_dir)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imgs/a.nii")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labels/a.nii")))
+        self.assertEqual(items[0]["id"], "case_a")
+
+    def test_cls_values(self):
+        datalist = {"training": [{"image": "imgs/a.nii", "label": 2}, {"image": "imgs/b.nii", "label": 0}]}
+        path = self._write_datalist(datalist)
+        items = load_decathalon_datalist(path, False, "training", self.tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imgs/a.nii")))
+        self.assertEqual(items[0]["label"], 2)
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[1]["label"], 0)
+        self.assertIsInstance(items[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        image = os.path.join(self.tmp_dir, "abs", "img.nii")
+        label = os.path.join(self.tmp_dir, "abs", "lbl.nii")
+        datalist = {"training": [{"image": image, "label": label}]}
+        path = self._write_datalist(datalist)
+        items = load_decathalon_datalist(path, True, "training", None)
+
+        self.assertEqual(items[0]["image"], image)
+        self.assertEqual(items[0]["label"], label)
+
+    def test_seg_no_labels(self):
+        datalist = {"test": ["imgs/a.nii", "imgs/b.nii"]}
+        path = self._write_datalist(datalist)
+        items = load_decathalon_datalist(path, True, "test", self.tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0], {"image": os.path.normpath(os.path.join(self.tmp_dir, "imgs/a.nii"))})
+        self.assertEqual(items[1], {"image": os.path.normpath(os.path.join(self.tmp_dir, "imgs/b.nii"))})
+
+
+if __name__ == "__main__":
+    unittest.main()
