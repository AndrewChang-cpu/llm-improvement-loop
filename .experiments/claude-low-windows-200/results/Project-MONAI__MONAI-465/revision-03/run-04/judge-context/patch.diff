+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tmp_dir, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "extra": "keep"},
+                    {"image": ["imagesTr/a.nii", "imagesTr/b.nii"], "label": "./labelsTr//case_1.nii"},
+                ],
+            }
+        )
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labelsTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["extra"], "keep")
+        self.assertEqual(
+            items[1]["image"],
+            [
+                os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/a.nii")),
+                os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/b.nii")),
+            ],
+        )
+        self.assertEqual(items[1]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labelsTr/case_1.nii")))
+
+    def test_cls_values(self):
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": 1},
+                    {"image": "imagesTr/case_1.nii.gz", "label": 0, "name": "normal"},
+                ],
+            }
+        )
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["label"], 1)
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[1]["label"], 0)
+        self.assertEqual(items[1]["name"], "normal")
+
+    def test_seg_no_basedir(self):
+        path = self._write_datalist({"training": [{"image": "/abs/path/image.nii", "label": "/abs/path/label.nii"}]})
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath("/abs/path/image.nii"))
+        self.assertEqual(items[0]["label"], os.path.normpath("/abs/path/label.nii"))
+
+    def test_seg_no_labels(self):
+        path = self._write_datalist({"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]})
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0], {"image": os.path.normpath(os.path.join(self.tmp_dir, "imagesTs/case_0.nii.gz"))})
+        self.assertEqual(items[1], {"image": os.path.normpath(os.path.join(self.tmp_dir, "imagesTs/case_1.nii.gz"))})
+
+
+if __name__ == "__main__":
+    unittest.main()
