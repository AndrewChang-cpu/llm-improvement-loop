+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, key: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{key}' list in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Value of '{key}' in {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items with resolved paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is left exactly as stored, whatever its type (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON object whose value is the list of entries.
+            Defaults to "training". When it equals "test", each entry is a plain path string and is converted
+            into an item with only an "image" field.
+        base_dir (str): directory that relative "image" and "label" paths are joined with. If None, the
+            directory containing the datalist file is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary has the same fields as its input item.
+        "image" (and "label" in segmentation mode) hold normalized paths: strings, or lists of strings when the
+        input value was a list. All other fields are unchanged. Other top-level JSON fields are ignored.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0] == {"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, Mapping) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each item in datalist {data_list_file_path} must be a mapping, got {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        output.append(processed)
+
+    return output
