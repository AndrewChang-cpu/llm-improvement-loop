+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tempdir, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        base = os.path.join(self.tempdir, "root")
+        path = self._write_datalist(
+            {
+                "name": "demo",
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": "./labelsTr/case_0.nii.gz", "fold": 1},
+                    {"image": ["imagesTr/a.nii.gz", "imagesTr/b.nii.gz"], "label": "labelsTr/case_1.nii.gz"},
+                ],
+            }
+        )
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base)
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(base, "labelsTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["fold"], 1)
+        self.assertEqual(
+            items[1]["image"],
+            [
+                os.path.normpath(os.path.join(base, "imagesTr/a.nii.gz")),
+                os.path.normpath(os.path.join(base, "imagesTr/b.nii.gz")),
+            ],
+        )
+        self.assertEqual(items[1]["label"], os.path.normpath(os.path.join(base, "labelsTr/case_1.nii.gz")))
+
+    def test_cls_values(self):
+        base = os.path.join(self.tempdir, "root")
+        path = self._write_datalist(
+            {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": 0},
+                    {"image": "imagesTr/case_1.nii.gz", "label": 2},
+                ]
+            }
+        )
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["label"], 0)
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(base, "imagesTr/case_1.nii.gz")))
+        self.assertEqual(items[1]["label"], 2)
+        self.assertIsInstance(items[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        image = os.path.join(self.tempdir, "abs", "case_0.nii.gz")
+        label = os.path.join(self.tempdir, "abs", "label_0.nii.gz")
+        path = self._write_datalist({"training": [{"image": image, "label": label}]})
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+        self.assertEqual(items[0]["image"], os.path.normpath(image))
+        self.assertEqual(items[0]["label"], os.path.normpath(label))
+
+    def test_seg_no_labels(self):
+        base = os.path.join(self.tempdir, "root")
+        path = self._write_datalist({"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]})
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=base)
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base, "imagesTs/case_0.nii.gz")))
+        self.assertNotIn("label", items[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
