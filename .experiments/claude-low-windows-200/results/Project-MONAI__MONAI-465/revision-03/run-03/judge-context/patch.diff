+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.test_dir, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        content = {
+            "training": [
+                {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 0},
+                {
+                    "image": ["imagesTr/a.nii.gz", "./imagesTr//b.nii.gz"],
+                    "label": ["labelsTr/a.nii.gz", "labelsTr/b.nii.gz"],
+                },
+            ]
+        }
+        path = self._write_datalist(content)
+        base_dir = os.path.join(self.test_dir, "base")
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["fold"], 0)
+        self.assertEqual(
+            items[1]["image"],
+            [
+                os.path.normpath(os.path.join(base_dir, "imagesTr/a.nii.gz")),
+                os.path.normpath(os.path.join(base_dir, "imagesTr/b.nii.gz")),
+            ],
+        )
+        self.assertEqual(items[1]["label"][1], os.path.normpath(os.path.join(base_dir, "labelsTr/b.nii.gz")))
+
+    def test_cls_values(self):
+        content = {
+            "training": [
+                {"image": "imagesTr/case_0.nii.gz", "label": 1},
+                {"image": "imagesTr/case_1.nii.gz", "label": 0},
+            ]
+        }
+        path = self._write_datalist(content)
+        base_dir = os.path.join(self.test_dir, "base")
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base_dir)
+
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["label"], 1)
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[1]["label"], 0)
+        self.assertIsInstance(items[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        image = os.path.join(self.test_dir, "images", "case_0.nii.gz")
+        label = os.path.join(self.test_dir, "labels", "case_0.nii.gz")
+        content = {"training": [{"image": image, "label": label}]}
+        path = self._write_datalist(content)
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(items[0]["image"], image)
+        self.assertEqual(items[0]["label"], label)
+
+    def test_seg_no_labels(self):
+        content = {"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]}
+        path = self._write_datalist(content)
+        base_dir = os.path.join(self.test_dir, "base")
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=base_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/case_0.nii.gz")))
+        self.assertNotIn("label", items[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
