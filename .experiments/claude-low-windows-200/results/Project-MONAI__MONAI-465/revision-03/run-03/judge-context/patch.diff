+
+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """Resolve a string or list-of-strings path value against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist '{data_list_file_path}' contains a non-string element: {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}: {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" value is left exactly as stored (for example an integer class id or a class name string).
+            Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries. Use "test" for the
+            Decathalon test split, whose entries are plain path strings and are converted to image-only items.
+            Defaults to "training".
+        base_dir (str or None): directory that relative paths are joined with. If None, the directory containing
+            the datalist file is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same keys as its input item.
+        The "image" value, and the "label" value when is_segmentation is True, are resolved paths: strings, or
+        lists of strings when the input was a list. All other fields are unchanged. For the "test" key each
+        entry becomes ``{"image": resolved_path}``.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}, ...]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item in key '{data_list_key}' of datalist '{data_list_file_path}' must be a mapping, "
+                f"got {type(item).__name__}: {item!r}"
+            )
+        processed = {}
+        for field, value in item.items():
+            if field == "image" or (field == "label" and is_segmentation):
+                processed[field] = _resolve_path(value, base_dir, field, data_list_file_path)
+            else:
+                processed[field] = value
+        output.append(processed)
+
+    return output
