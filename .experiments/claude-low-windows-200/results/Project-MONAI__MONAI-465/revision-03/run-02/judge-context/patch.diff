+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list contains a non-string element {element!r}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its per-case items.
+
+    The entries stored under ``data_list_key`` are returned in their original order. The "image" field of each
+    item is resolved against ``base_dir``; the "label" field is resolved only when ``is_segmentation`` is True.
+    When ``is_segmentation`` is False, the label is returned exactly as stored, whatever its type. Other fields are
+    kept unchanged. Items lacking "image" or "label" are not errors. If ``data_list_key`` is "test", each entry is a
+    plain path string and is converted to an item with only an "image" field.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file, must exist.
+        is_segmentation (bool): whether the "label" field is a path to be resolved. Defaults to True.
+        data_list_key (str): key under the top-level JSON object that holds the entries. Defaults to "training".
+        base_dir (str): directory against which relative paths are resolved. Defaults to None, which means the
+            directory containing the datalist file.
+
+    Returns:
+        a list of dicts, one per entry, in the original order. Each dict has the same field names as its input item,
+        with "image" (and "label" in segmentation mode) holding resolved paths: strings, or lists of strings when the
+        input was a list.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value has an
+            invalid type.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Datalist file '{data_list_file_path}' must contain a JSON object at the top level.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist file '{data_list_file_path}' is not a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        items.append(new_item)
+    return items
