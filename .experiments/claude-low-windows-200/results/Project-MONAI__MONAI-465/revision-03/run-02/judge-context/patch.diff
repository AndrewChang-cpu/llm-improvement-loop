+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        datalist = {"training": [{"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 0}]}
+        path = self._write_datalist(datalist)
+        base_dir = os.path.join(self.tmp_dir, "root")
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base_dir)
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.join(base_dir, "imgs", "a.nii"))
+        self.assertEqual(result[0]["label"], os.path.join(base_dir, "labels", "a.nii"))
+        self.assertEqual(result[0]["fold"], 0)
+
+    def test_cls_values(self):
+        datalist = {"training": [{"image": "imgs/a.nii", "label": 2}, {"image": "imgs/b.nii", "label": 0}]}
+        path = self._write_datalist(datalist)
+        base_dir = os.path.join(self.tmp_dir, "root")
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base_dir)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(base_dir, "imgs", "a.nii"))
+        self.assertEqual(result[1]["image"], os.path.join(base_dir, "imgs", "b.nii"))
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["label"], 2)
+        self.assertIsInstance(result[1]["label"], int)
+        self.assertEqual(result[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        datalist = {"training": [{"image": "/abs/imgs/a.nii", "label": "/abs/labels/a.nii"}]}
+        path = self._write_datalist(datalist)
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+        self.assertEqual(result[0]["image"], "/abs/imgs/a.nii")
+        self.assertEqual(result[0]["label"], "/abs/labels/a.nii")
+
+    def test_seg_no_labels(self):
+        datalist = {"test": ["imgs/t0.nii", "imgs/t1.nii"]}
+        path = self._write_datalist(datalist)
+        base_dir = os.path.join(self.tmp_dir, "root")
+        result = load_decathalon_datalist(path, data_list_key="test", base_dir=base_dir)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0], {"image": os.path.join(base_dir, "imgs", "t0.nii")})
+
+
+if __name__ == "__main__":
+    unittest.main()
