+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_dir(self):
+        tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp_dir, True)
+        return tmp_dir
+
+    def _write_json(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = self._make_dir()
+        content = {
+            "training": [
+                {
+                    "image": ["imagesTr/a.nii.gz", "./imagesTr//b.nii.gz"],
+                    "label": "labelsTr/a.nii.gz",
+                    "extra": "keep me",
+                }
+            ]
+        }
+        path = self._write_json(tmp_dir, content)
+        result = load_decathalon_datalist(path, True, "training", tmp_dir)
+        self.assertEqual(len(result), 1)
+        self.assertEqual(
+            result[0]["image"],
+            [os.path.join(tmp_dir, "imagesTr", "a.nii.gz"), os.path.join(tmp_dir, "imagesTr", "b.nii.gz")],
+        )
+        self.assertEqual(result[0]["label"], os.path.join(tmp_dir, "labelsTr", "a.nii.gz"))
+        self.assertEqual(result[0]["extra"], "keep me")
+
+    def test_cls_values(self):
+        tmp_dir = self._make_dir()
+        entries = [{"image": "imagesTr/a.nii.gz", "label": 3}, {"image": "imagesTr/b.nii.gz", "label": 0}]
+        content = {"training": entries}
+        path = self._write_json(tmp_dir, content)
+        result = load_decathalon_datalist(path, False, "training", tmp_dir)
+        self.assertEqual(result[0]["image"], os.path.join(tmp_dir, "imagesTr", "a.nii.gz"))
+        self.assertEqual(result[0]["label"], 3)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[1]["label"], 0)
+        self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = self._make_dir()
+        abs_image = os.path.join(tmp_dir, "abs", "image.nii.gz")
+        abs_label = os.path.join(tmp_dir, "abs", "label.nii.gz")
+        content = {"training": [{"image": abs_image, "label": abs_label}]}
+        path = self._write_json(tmp_dir, content)
+        result = load_decathalon_datalist(path, True, "training", None)
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        tmp_dir = self._make_dir()
+        content = {"test": ["imagesTs/a.nii.gz", "imagesTs/b.nii.gz"]}
+        path = self._write_json(tmp_dir, content)
+        result = load_decathalon_datalist(path, True, "test", tmp_dir)
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.join(tmp_dir, "imagesTs", "a.nii.gz"))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
