+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a string or list-of-strings path value against `base_dir`, keeping list order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist {data_list_file_path} must be a string or a list of strings, "
+                    f"found element {element!r} of type {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist {data_list_file_path} must be a string or a list of strings, "
+        f"found type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return a list of per-case items with
+    image (and, in segmentation mode, label) paths resolved against `base_dir`.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; it must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is returned exactly as stored (for example an integer class id). Default True.
+        data_list_key (str): top-level key in the JSON object holding the list of entries. Default "training".
+            If it equals "test", each entry is a plain path string and is converted to an item with only an
+            "image" field.
+        base_dir (str): directory that relative paths are resolved against. If None, the directory containing
+            the datalist file is used.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same keys as its input item.
+        "image" (and "label" in segmentation mode) hold normalized paths, as strings or lists of strings when the
+        input was a list. All other fields are returned unchanged.
+
+    Example::
+
+        {
+            "training": [
+                {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "extra": 1},
+            ]
+        }
+
+        load_decathalon_datalist("dataset.json", base_dir="/data/task01")
+        # [{'image': '/data/task01/imagesTr/case_0.nii.gz',
+        #   'label': '/data/task01/labelsTr/case_0.nii.gz', 'extra': 1}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        json_data = json.load(file)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in datalist {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist {data_list_file_path} must be a mapping, "
+                f"found type {type(item).__name__}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
