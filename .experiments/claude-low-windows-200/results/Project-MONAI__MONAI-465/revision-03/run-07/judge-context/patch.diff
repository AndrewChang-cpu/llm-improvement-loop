+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        path = self._write_datalist(
+            {
+                "name": "demo",
+                "training": [
+                    {"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 0},
+                    {"image": ["imgs/b0.nii", "./imgs/b1.nii"], "label": "labels/b.nii"},
+                ],
+            }
+        )
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imgs/a.nii")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labels/a.nii")))
+        self.assertEqual(result[0]["fold"], 0)
+        self.assertEqual(
+            result[1]["image"],
+            [os.path.normpath(os.path.join(self.tmp_dir, "imgs/b0.nii")), os.path.normpath(os.path.join(self.tmp_dir, "imgs/b1.nii"))],
+        )
+        self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labels/b.nii")))
+
+    def test_cls_values(self):
+        path = self._write_datalist(
+            {"training": [{"image": "imgs/a.nii", "label": 3}, {"image": "imgs/b.nii", "label": 0}]}
+        )
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imgs/a.nii")))
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["label"], 3)
+        self.assertIsInstance(result[1]["label"], int)
+        self.assertEqual(result[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        abs_image = os.path.join(self.tmp_dir, "abs_img.nii")
+        abs_label = os.path.join(self.tmp_dir, "abs_label.nii")
+        path = self._write_datalist({"training": [{"image": abs_image, "label": abs_label}]})
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        path = self._write_datalist({"test": ["imgs/t0.nii", "imgs/t1.nii"]})
+        result = load_decathalon_datalist(path, data_list_key="test", base_dir=self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(self.tmp_dir, "imgs/t0.nii"))})
+        self.assertEqual(result[1], {"image": os.path.normpath(os.path.join(self.tmp_dir, "imgs/t1.nii"))})
+
+
+if __name__ == "__main__":
+    unittest.main()
