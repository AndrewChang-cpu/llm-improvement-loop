+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in data list file {data_list_file_path} must be a string or a list of strings, "
+                    f"found element {element!r} of type {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in data list file {data_list_file_path} must be a string or a list of strings, "
+        f"found {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    The entries are read from the list stored under ``data_list_key``. For each entry, the "image" field is resolved
+    against ``base_dir``. When ``is_segmentation`` is True, the "label" field is resolved against ``base_dir`` as well;
+    when it is False, the label is returned exactly as stored (for example an integer class id or a class name).
+    Any other field is kept unchanged. Items without "image" or "label" are not errors.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the labels are paths to be resolved. Defaults to True.
+        data_list_key (str): top-level key of the datalist that holds the entries. Defaults to "training".
+            When it equals "test", each entry is a plain path string and is converted to an image-only item.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the same field names as its
+        input item. "image" holds a resolved path (a string, or a list of strings when the input was a list), and in
+        segmentation mode "label" holds a resolved path of the same kind. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0] == {"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz"}
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Top-level JSON value in data list file {data_list_file_path} must be an object.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in data list file {data_list_file_path} must be a mapping, found {item!r}.")
+        processed: Dict[str, Any] = {}
+        for field, value in item.items():
+            if field == "image" or (field == "label" and is_segmentation):
+                processed[field] = _resolve_path(value, base_dir, data_list_file_path, field)
+            else:
+                processed[field] = value
+        result.append(processed)
+    return result
