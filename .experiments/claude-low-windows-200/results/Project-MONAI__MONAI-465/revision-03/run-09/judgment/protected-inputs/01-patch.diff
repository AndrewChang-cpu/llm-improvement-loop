+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list contains a non-string element: {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return a list of per-case items.
+
+    The entries are read from the top-level key ``data_list_key``. The ``"image"`` field of every item is resolved
+    against ``base_dir``. The ``"label"`` field is resolved only when ``is_segmentation`` is True; otherwise it is
+    left exactly as stored (for example an integer class id). All other fields are kept unchanged. When
+    ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted to an image-only item
+    ``{"image": entry}``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the datalist holds segmentation labels. If True, the ``"label"`` field of
+            each item is resolved as a path. If False, the ``"label"`` field is passed through unchanged.
+        data_list_key (str): top-level key holding the list of entries, default ``"training"``.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means the
+            directory containing the datalist file.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input item, with the
+        ``"image"`` value (and, in segmentation mode, the ``"label"`` value) replaced by resolved paths: strings,
+        or lists of strings when the input was a list.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0] == {"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a
+            path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Item in '{data_list_key}' must be a mapping, got {entry!r} in {data_list_file_path}")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir)
+        items.append(item)
+    return items
