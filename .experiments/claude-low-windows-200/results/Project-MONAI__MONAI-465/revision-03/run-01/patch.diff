+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or a list of path strings, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file {data_list_file_path} "
+                    "must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return a list of per-case items.
+
+    The entries are read from the top-level key ``data_list_key``. The ``"image"`` field of every item is
+    resolved against ``base_dir``. The ``"label"`` field is resolved only when ``is_segmentation`` is True;
+    when it is False, the label is returned exactly as stored (for example an integer class id). Other
+    fields are returned unchanged. If ``data_list_key`` is ``"test"``, each entry is a plain path string and
+    is converted to an image-only item.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the items are segmentation cases. If True, the ``"label"`` field is
+            resolved as a path; if False, it is left unchanged. Defaults to True.
+        data_list_key (str): top-level key in the datalist holding the entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory containing
+            the datalist file is used. Defaults to None.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input item, with
+        ``"image"`` (and ``"label"`` in segmentation mode) holding resolved paths: strings, or lists of strings
+        when the input was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a
+            path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "<datalist dir>/imgs/case0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Datalist file {data_list_file_path} must contain a top-level JSON object.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {item!r} in key '{data_list_key}' of datalist file {data_list_file_path} must be a mapping."
+            )
+        processed: Dict[str, Any] = {}
+        for field, value in item.items():
+            if field == "image" or (field == "label" and is_segmentation):
+                processed[field] = _resolve_path(value, base_dir, field, data_list_file_path)
+            else:
+                processed[field] = value
+        items.append(processed)
+
+    return items
