+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_dir(self):
+        tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp_dir, True)
+        return tmp_dir
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = self._make_dir()
+        path = self._write_datalist(
+            tmp_dir,
+            {"training": [{"image": "imgs/case0.nii.gz", "label": "labels/case0.nii.gz", "fold": 1}]},
+        )
+        out = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir)
+        self.assertEqual(len(out), 1)
+        self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case0.nii.gz")))
+        self.assertEqual(out[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels", "case0.nii.gz")))
+        self.assertEqual(out[0]["fold"], 1)
+
+    def test_cls_values(self):
+        tmp_dir = self._make_dir()
+        entries = [
+            {"image": "imgs/case0.nii.gz", "label": 2},
+            {"image": "imgs/case1.nii.gz", "label": 0},
+        ]
+        path = self._write_datalist(tmp_dir, {"training": entries})
+        out = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir)
+        self.assertEqual(len(out), 2)
+        self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case0.nii.gz")))
+        self.assertEqual(out[0]["label"], 2)
+        self.assertIsInstance(out[0]["label"], int)
+        self.assertEqual(out[1]["label"], 0)
+        self.assertIsInstance(out[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = self._make_dir()
+        abs_image = os.path.join(tmp_dir, "imgs", "case0.nii.gz")
+        abs_label = os.path.join(tmp_dir, "labels", "case0.nii.gz")
+        entries = [
+            {"image": abs_image, "label": abs_label},
+            {"image": "imgs/case1.nii.gz", "label": "labels/case1.nii.gz"},
+        ]
+        path = self._write_datalist(tmp_dir, {"training": entries})
+        out = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+        self.assertEqual(out[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(out[0]["label"], os.path.normpath(abs_label))
+        self.assertEqual(out[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case1.nii.gz")))
+        self.assertEqual(out[1]["label"], os.path.normpath(os.path.join(tmp_dir, "labels", "case1.nii.gz")))
+
+    def test_seg_no_labels(self):
+        tmp_dir = self._make_dir()
+        path = self._write_datalist(tmp_dir, {"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]})
+        out = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=tmp_dir)
+        self.assertEqual(len(out), 2)
+        self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "t0.nii.gz")))
+        self.assertNotIn("label", out[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
