+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as file:
+        json.dump(content, file)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imagesTr/a.nii.gz", "label": "labelsTr/./a.nii.gz", "fold": 0},
+                    {"image": ["imagesTr/b0.nii.gz", "imagesTr/b1.nii.gz"], "label": "labelsTr/b.nii.gz"},
+                ],
+            }
+            path = _write_datalist(tmp_dir, content)
+            items = load_decathalon_datalist(path, True, "training", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/a.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/a.nii.gz")))
+            self.assertEqual(items[0]["fold"], 0)
+            self.assertEqual(
+                items[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "imagesTr/b0.nii.gz")),
+                    os.path.normpath(os.path.join(tmp_dir, "imagesTr/b1.nii.gz")),
+                ],
+            )
+            self.assertEqual(items[1]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/b.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imagesTr/a.nii.gz", "label": 1},
+                    {"image": "imagesTr/b.nii.gz", "label": 0},
+                ],
+            }
+            path = _write_datalist(tmp_dir, content)
+            items = load_decathalon_datalist(path, False, "training", tmp_dir)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/a.nii.gz")))
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/b.nii.gz")))
+            self.assertEqual(items[1]["label"], 0)
+            self.assertIsInstance(items[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(os.sep, "data", "imagesTr", "a.nii.gz")
+            abs_label = os.path.join(os.sep, "data", "labelsTr", "a.nii.gz")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = _write_datalist(tmp_dir, content)
+            items = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["imagesTs/a.nii.gz", "imagesTs/b.nii.gz"]}
+            path = _write_datalist(tmp_dir, content)
+            items = load_decathalon_datalist(path, True, "test", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTs/a.nii.gz")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
