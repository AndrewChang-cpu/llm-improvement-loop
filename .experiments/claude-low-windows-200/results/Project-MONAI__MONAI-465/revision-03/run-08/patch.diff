+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    The entries stored under ``data_list_key`` are returned as a list of per-case items, in their original order.
+    The "image" field, and the "label" field when ``is_segmentation`` is True, are resolved against ``base_dir``
+    (normalized paths; lists of paths keep their order). Other fields are kept unchanged. When ``is_segmentation``
+    is False, the "label" field is left exactly as stored, whatever its type, such as an integer class id.
+    When ``data_list_key`` is "test", each plain path entry is converted to an image-only item ``{"image": entry}``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means the
+            directory containing the datalist file.
+
+    Returns:
+        A list of dictionaries, one per entry, each with the same field names as its input item. The "image" value
+        (and the "label" value in segmentation mode) is a resolved path string, or a list of resolved path strings
+        when the input was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are normalized paths under the datalist directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from data list file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in data list file {data_list_file_path} must be a mapping, found {item!r}.")
+
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+
+    return result
