+"""
+Utilities to make MONAI easier to use inside Jupyter notebooks.
+
+Matplotlib and IPython are imported lazily inside the functions that need them, so this module can be
+imported without those optional packages and without creating circular imports through ``optional_import``.
+Some arguments are intentionally untyped (``Any``) because the types of plotting objects are hard to annotate
+precisely without requiring Matplotlib at import time.
+"""
+
+from typing import Any, Optional, Sequence
+
+import numpy as np
+
+__all__ = ["is_jupyter", "to_numpy_image", "plot_image"]
+
+
+def is_jupyter() -> bool:
+    """
+    Return True if the code is running inside an IPython/Jupyter kernel (for example a notebook), False otherwise.
+    If IPython is not installed, this returns False.
+    """
+    try:
+        from IPython import get_ipython  # type: ignore
+    except ImportError:
+        return False
+    shell = get_ipython()
+    if shell is None:
+        return False
+    return type(shell).__name__ == "ZMQInteractiveShell"
+
+
+def to_numpy_image(data: Any, channel_index: Optional[int] = None) -> np.ndarray:
+    """
+    Convert a torch tensor, numpy array or array-like to a 2D numpy array suitable for plotting.
+
+    Args:
+        data: input image, can be a torch tensor or numpy array. Expected shapes are ``(H, W)``, ``(C, H, W)``
+            (single channel selected by ``channel_index``) or ``(D, H, W)`` (the middle slice is returned).
+        channel_index: when ``data`` has 3 dims and it is a channel-first image with ``C`` in the leading dim,
+            select this channel. If None, the input is treated as a 3D volume and the middle slice along the
+            first dimension is returned.
+
+    Raises:
+        ValueError: when the input does not have 2 or 3 dimensions after converting to numpy.
+    """
+    if hasattr(data, "detach"):  # torch tensor
+        data = data.detach().cpu().numpy()
+    arr = np.asarray(data)
+
+    if arr.ndim == 2:
+        return arr
+    if arr.ndim == 3:
+        if channel_index is not None:
+            return arr[channel_index]
+        return arr[arr.shape[0] // 2]
+    raise ValueError(f"Expected a 2D or 3D image, got an array with shape {arr.shape}.")
+
+
+def plot_image(
+    data: Any,
+    title: Optional[str] = None,
+    cmap: str = "gray",
+    channel_index: Optional[int] = None,
+    figsize: Sequence[float] = (5, 5),
+    show: bool = True,
+) -> Any:
+    """
+    Plot a single 2D image (or the middle slice of a 3D volume) with Matplotlib, for display in a notebook.
+
+    Args:
+        data: image to plot, see :func:`to_numpy_image` for supported shapes.
+        title: optional title of the figure.
+        cmap: Matplotlib colormap name.
+        channel_index: channel to select for channel-first 3D inputs, see :func:`to_numpy_image`.
+        figsize: size of the figure in inches.
+        show: whether to call ``plt.show()`` after plotting.
+
+    Returns:
+        the Matplotlib figure that was created.
+
+    Raises:
+        ImportError: when Matplotlib is not installed.
+    """
+    from monai.utils import optional_import
+
+    plt, has_plt = optional_import("matplotlib.pyplot")
+    if not has_plt:
+        raise ImportError("Matplotlib is required for plot_image, please install it.")
+
+    image = to_numpy_image(data, channel_index=channel_index)
+    fig, ax = plt.subplots(figsize=tuple(figsize))
+    ax.imshow(image, cmap=cmap)
+    ax.axis("off")
+    if title is not None:
+        ax.set_title(title)
+    if show:
+        plt.show()
+    return fig
