+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+import torch
+
+from monai.utils import optional_import
+from monai.utils.jupyter_utils import is_jupyter, plot_image, to_numpy_image
+
+_, HAS_PLT = optional_import("matplotlib.pyplot")
+
+
+class TestJupyterUtils(unittest.TestCase):
+    def test_is_jupyter(self):
+        self.assertFalse(is_jupyter())
+
+    def test_to_numpy_image(self):
+        np.testing.assert_array_equal(to_numpy_image(np.zeros((4, 5))).shape, (4, 5))
+        self.assertEqual(to_numpy_image(torch.zeros(3, 4, 5)).shape, (4, 5))
+        arr = np.arange(2 * 3 * 4).reshape(2, 3, 4)
+        np.testing.assert_array_equal(to_numpy_image(arr, channel_index=1), arr[1])
+        np.testing.assert_array_equal(to_numpy_image(arr), arr[1])
+
+    def test_to_numpy_image_bad_shape(self):
+        with self.assertRaises(ValueError):
+            to_numpy_image(np.zeros(4))
+
+    @unittest.skipUnless(HAS_PLT, "Matplotlib is required")
+    def test_plot_image(self):
+        import matplotlib
+
+        matplotlib.use("Agg")
+        fig = plot_image(torch.rand(1, 8, 8), title="t", show=False)
+        self.assertEqual(fig.axes[0].get_title(), "t")
+
+    @unittest.skipIf(HAS_PLT, "only checks the error path without Matplotlib")
+    def test_plot_image_missing_matplotlib(self):
+        with self.assertRaises(ImportError):
+            plot_image(np.zeros((4, 4)), show=False)
+
+
+if __name__ == "__main__":
+    unittest.main()
