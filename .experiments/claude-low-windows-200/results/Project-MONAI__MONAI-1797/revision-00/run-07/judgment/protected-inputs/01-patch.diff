+"""
+Utilities to help use MONAI inside Jupyter notebooks.
+
+Type annotations are intentionally omitted on the plotting helpers, since matplotlib objects
+are awkward to type. This module does not use ``optional_import`` so that it can be imported
+from ``monai.utils`` without causing circular imports; optional dependencies are imported
+inside the functions that need them.
+"""
+
+import sys
+from typing import Optional, Sequence
+
+import numpy as np
+
+__all__ = ["is_jupyter", "plot_image_grid"]
+
+
+def is_jupyter():
+    """
+    Return True if the code is running inside a Jupyter (IPython ZMQ) kernel, False otherwise.
+
+    IPython is never imported here: if it is not already loaded, the code is not running in a notebook.
+    """
+    ipython = sys.modules.get("IPython")
+    if ipython is None:
+        return False
+    get_ipython = getattr(ipython, "get_ipython", None)
+    if get_ipython is None:
+        return False
+    shell = get_ipython()
+    return shell is not None and type(shell).__name__ == "ZMQInteractiveShell"
+
+
+def _to_2d_array(image):
+    arr = image.detach().cpu().numpy() if hasattr(image, "detach") else np.asarray(image)
+    arr = np.squeeze(arr)
+    if arr.ndim != 2:
+        raise ValueError(f"expected a 2D image after squeezing, got shape {arr.shape}.")
+    return arr
+
+
+def plot_image_grid(images, titles: Optional[Sequence[str]] = None, ncols: int = 4, figsize=None, cmap="gray"):
+    """
+    Plot a sequence of 2D images in a grid using matplotlib, for display in a notebook.
+
+    Args:
+        images: sequence of 2D images, each a numpy array or torch tensor. Singleton dimensions are squeezed.
+        titles: optional sequence of titles, one per image.
+        ncols: maximum number of columns in the grid.
+        figsize: optional ``(width, height)`` of the whole figure in inches.
+        cmap: matplotlib colormap name used for every image.
+
+    Returns:
+        the matplotlib figure containing the grid.
+    """
+    import matplotlib.pyplot as plt  # imported here to keep this module importable without matplotlib
+
+    images = list(images)
+    if len(images) == 0:
+        raise ValueError("no images given to plot.")
+    if titles is not None and len(titles) != len(images):
+        raise ValueError(f"got {len(titles)} titles for {len(images)} images.")
+    if ncols < 1:
+        raise ValueError(f"ncols must be at least 1, got {ncols}.")
+
+    ncols = min(ncols, len(images))
+    nrows = int(np.ceil(len(images) / ncols))
+    if figsize is None:
+        figsize = (4 * ncols, 4 * nrows)
+    fig, axes = plt.subplots(nrows, ncols, figsize=figsize, squeeze=False)
+    axes_flat = axes.ravel()
+    for i, image in enumerate(images):
+        ax = axes_flat[i]
+        ax.imshow(_to_2d_array(image), cmap=cmap)
+        ax.axis("off")
+        if titles is not None:
+            ax.set_title(str(titles[i]))
+    for ax in axes_flat[len(images) :]:
+        ax.axis("off")
+    fig.tight_layout()
+    return fig
