+import unittest
+from unittest import mock
+
+import numpy as np
+import torch
+
+from monai.utils import jupyter_utils
+from monai.utils.jupyter_utils import is_jupyter, plot_image_grid
+
+try:
+    import matplotlib  # noqa: F401
+
+    has_matplotlib = True
+except ImportError:
+    has_matplotlib = False
+
+
+class TestIsJupyter(unittest.TestCase):
+    def test_not_jupyter_when_ipython_absent(self):
+        with mock.patch.dict("sys.modules", {"IPython": None}):
+            self.assertFalse(is_jupyter())
+
+    def test_zmq_shell_is_jupyter(self):
+        class ZMQInteractiveShell:
+            pass
+
+        fake = mock.MagicMock()
+        fake.get_ipython.return_value = ZMQInteractiveShell()
+        with mock.patch.dict("sys.modules", {"IPython": fake}):
+            self.assertTrue(is_jupyter())
+
+    def test_terminal_shell_is_not_jupyter(self):
+        class TerminalInteractiveShell:
+            pass
+
+        fake = mock.MagicMock()
+        fake.get_ipython.return_value = TerminalInteractiveShell()
+        with mock.patch.dict("sys.modules", {"IPython": fake}):
+            self.assertFalse(is_jupyter())
+
+    def test_no_shell_is_not_jupyter(self):
+        fake = mock.MagicMock()
+        fake.get_ipython.return_value = None
+        with mock.patch.dict("sys.modules", {"IPython": fake}):
+            self.assertFalse(is_jupyter())
+
+
+@unittest.skipUnless(has_matplotlib, "matplotlib is required")
+class TestPlotImageGrid(unittest.TestCase):
+    def test_grid_layout(self):
+        import matplotlib.pyplot as plt
+
+        images = [torch.rand(1, 8, 8), np.random.rand(8, 8), torch.rand(8, 8, 1), np.random.rand(1, 8, 8)]
+        fig = plot_image_grid(images, titles=["a", "b", "c", "d"], ncols=3)
+        axes = [ax for ax in fig.axes]
+        self.assertEqual(len(axes), 6)  # 2 rows x 3 cols
+        self.assertEqual(axes[0].get_title(), "a")
+        self.assertEqual(axes[3].get_title(), "d")
+        self.assertFalse(axes[4].axison)
+        plt.close(fig)
+
+    def test_ncols_capped_by_number_of_images(self):
+        import matplotlib.pyplot as plt
+
+        fig = plot_image_grid([np.zeros((4, 4))], ncols=5)
+        self.assertEqual(len(fig.axes), 1)
+        plt.close(fig)
+
+    def test_bad_inputs(self):
+        with self.assertRaises(ValueError):
+            plot_image_grid([])
+        with self.assertRaises(ValueError):
+            plot_image_grid([np.zeros((4, 4))], titles=["a", "b"])
+        with self.assertRaises(ValueError):
+            plot_image_grid([np.zeros((2, 4, 4))])
+        with self.assertRaises(ValueError):
+            plot_image_grid([np.zeros((4, 4))], ncols=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
