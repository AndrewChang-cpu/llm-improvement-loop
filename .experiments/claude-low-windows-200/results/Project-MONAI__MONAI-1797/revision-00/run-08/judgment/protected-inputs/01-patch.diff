+"""
+Utilities to make MONAI easier to use inside Jupyter notebooks.
+
+Note: this module deliberately does not import from ``monai.utils.module`` (e.g. ``optional_import``)
+to avoid circular dependencies, and optional dependencies (IPython, matplotlib) are imported lazily.
+Some values are left untyped because matplotlib objects do not have stable type annotations.
+"""
+
+from typing import Any, List, Optional, Sequence, Tuple
+
+import numpy as np
+
+__all__ = ["is_jupyter", "plot_image_grid"]
+
+
+def is_jupyter() -> bool:
+    """
+    Return True if the code is running inside a Jupyter notebook (or qtconsole) kernel, False otherwise.
+
+    IPython is not required to be installed; if it is missing, this returns False.
+    """
+    try:
+        from IPython import get_ipython  # type: ignore
+    except ImportError:
+        return False
+    shell = get_ipython()
+    if shell is None:
+        return False
+    return type(shell).__name__ == "ZMQInteractiveShell"
+
+
+def plot_image_grid(
+    images: Sequence[Any],
+    rows: int = 1,
+    cols: Optional[int] = None,
+    titles: Optional[Sequence[str]] = None,
+    cmap: str = "gray",
+    figsize: Optional[Tuple[float, float]] = None,
+    show: bool = False,
+):
+    """
+    Plot a sequence of 2D images in a grid using matplotlib.
+
+    Args:
+        images: sequence of 2D array-like images (numpy arrays or torch tensors).
+        rows: number of rows in the grid.
+        cols: number of columns in the grid, defaults to ``ceil(len(images) / rows)``.
+        titles: optional titles, one per image.
+        cmap: matplotlib colormap name.
+        figsize: optional figure size in inches.
+        show: whether to call ``plt.show()`` after plotting (useful outside of notebooks).
+
+    Returns:
+        the matplotlib ``Figure`` object.
+
+    Raises:
+        ImportError: if matplotlib is not installed.
+        ValueError: if the grid is too small for the number of images, or titles length mismatches.
+    """
+    n = len(images)
+    if n == 0:
+        raise ValueError("no images to plot.")
+    if rows < 1:
+        raise ValueError(f"rows must be at least 1, got {rows}.")
+    if cols is None:
+        cols = int(np.ceil(n / rows))
+    if rows * cols < n:
+        raise ValueError(f"grid of {rows}x{cols} cannot hold {n} images.")
+    if titles is not None and len(titles) != n:
+        raise ValueError(f"got {len(titles)} titles for {n} images.")
+
+    try:
+        import matplotlib.pyplot as plt  # type: ignore
+    except ImportError as e:
+        raise ImportError("plot_image_grid requires matplotlib, please install it.") from e
+
+    if figsize is None:
+        figsize = (cols * 4.0, rows * 4.0)
+    fig, axes = plt.subplots(rows, cols, figsize=figsize, squeeze=False)
+    flat: List = list(axes.reshape(-1))
+    for i, ax in enumerate(flat):
+        ax.axis("off")
+        if i < n:
+            img = images[i]
+            if hasattr(img, "detach"):  # torch tensor
+                img = img.detach().cpu().numpy()
+            ax.imshow(np.asarray(img), cmap=cmap)
+            if titles is not None:
+                ax.set_title(str(titles[i]))
+    if show:
+        plt.show()
+    return fig
