+import importlib.util
+import unittest
+
+import numpy as np
+import torch
+
+from monai.utils.jupyter_utils import is_jupyter, plot_image_grid
+
+HAS_MPL = importlib.util.find_spec("matplotlib") is not None
+
+
+class TestIsJupyter(unittest.TestCase):
+    def test_returns_false_outside_notebook(self):
+        self.assertFalse(is_jupyter())
+
+
+class TestPlotImageGridArgs(unittest.TestCase):
+    def test_invalid_arguments(self):
+        with self.assertRaises(ValueError):
+            plot_image_grid([])
+        with self.assertRaises(ValueError):
+            plot_image_grid([np.zeros((2, 2))] * 3, rows=1, cols=2)
+        with self.assertRaises(ValueError):
+            plot_image_grid([np.zeros((2, 2))], titles=["x", "y"])
+
+
+@unittest.skipUnless(HAS_MPL, "matplotlib is required")
+class TestPlotImageGrid(unittest.TestCase):
+    def test_grid_shape_and_titles(self):
+        imgs = [np.random.rand(8, 8) for _ in range(3)]
+        fig = plot_image_grid(imgs, rows=2, titles=["a", "b", "c"])
+        self.assertEqual(len(fig.axes), 4)
+        self.assertEqual(fig.axes[0].get_title(), "a")
+        self.assertEqual(fig.axes[2].get_title(), "c")
+
+    def test_torch_tensor_input(self):
+        fig = plot_image_grid([torch.rand(5, 5)], rows=1)
+        self.assertEqual(len(fig.axes), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
