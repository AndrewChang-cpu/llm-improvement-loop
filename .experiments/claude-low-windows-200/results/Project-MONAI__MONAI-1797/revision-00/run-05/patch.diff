+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+import torch
+
+from monai.utils.jupyter_utils import is_jupyter, plot_center_slices, plot_image
+from tests.utils import SkipIfNoModule
+
+
+class TestJupyterUtils(unittest.TestCase):
+    def test_is_jupyter_false_in_script(self):
+        self.assertFalse(is_jupyter())
+
+    @SkipIfNoModule("matplotlib")
+    def test_plot_image_2d(self):
+        import matplotlib.pyplot as plt
+
+        fig = plot_image(np.random.rand(10, 12), title="t")
+        self.assertEqual(len(fig.axes), 1)
+        plt.close(fig)
+
+    @SkipIfNoModule("matplotlib")
+    def test_plot_image_2d_channel_tensor(self):
+        import matplotlib.pyplot as plt
+
+        fig = plot_image(torch.rand(1, 10, 12))
+        self.assertEqual(len(fig.axes), 1)
+        plt.close(fig)
+
+    @SkipIfNoModule("matplotlib")
+    def test_plot_center_slices(self):
+        import matplotlib.pyplot as plt
+
+        fig = plot_center_slices(torch.rand(8, 9, 10), title="3d")
+        self.assertEqual(len(fig.axes), 3)
+        plt.close(fig)
+
+    @SkipIfNoModule("matplotlib")
+    def test_plot_center_slices_bad_dims(self):
+        with self.assertRaises(ValueError):
+            plot_center_slices(np.zeros((4, 4)))
+
+
+if __name__ == "__main__":
+    unittest.main()
