+"""
+Utilities to help use MONAI interactively in Jupyter notebooks.
+
+Note: these helpers deliberately avoid `optional_import` and import ``IPython`` and ``matplotlib``
+lazily inside the functions, so that importing this module never causes circular imports and never
+requires those packages to be installed. Some values are left untyped on purpose, because type
+annotations for Matplotlib objects are difficult to make work reliably.
+"""
+
+from typing import Any, Optional, Sequence
+
+import numpy as np
+
+__all__ = ["is_jupyter", "plot_image", "plot_center_slices"]
+
+
+def is_jupyter() -> bool:
+    """
+    Return True if the code is running inside a Jupyter notebook (or qtconsole) kernel, False otherwise
+    (for example in a plain Python interpreter, a script, or when IPython is not installed).
+    """
+    try:
+        from IPython import get_ipython  # type: ignore
+    except ImportError:
+        return False
+    shell = get_ipython()
+    if shell is None:
+        return False
+    return type(shell).__name__ == "ZMQInteractiveShell"
+
+
+def _center_slice(data: np.ndarray, axis: int):
+    index = data.shape[axis] // 2
+    return np.take(data, index, axis=axis)
+
+
+def plot_center_slices(image, title: Optional[str] = None, cmap: str = "gray", figsize: Sequence[float] = (12, 4)):
+    """
+    Plot the center slices of a 3D image along the three orthogonal axes, in a single row of subplots.
+
+    Args:
+        image: array-like with 3 dimensions, ``(dim0, dim1, dim2)``. Torch tensors are converted to numpy.
+        title: optional figure title.
+        cmap: matplotlib colormap name.
+        figsize: figure size in inches.
+
+    Returns:
+        the matplotlib figure.
+    """
+    import matplotlib.pyplot as plt  # lazy import, matplotlib is optional
+
+    data = _to_numpy(image)
+    if data.ndim != 3:
+        raise ValueError(f"plot_center_slices expects a 3D image, got {data.ndim} dimensions.")
+
+    fig, axes = plt.subplots(1, 3, figsize=figsize)
+    for ax, axis in zip(axes, range(3)):
+        ax.imshow(_center_slice(data, axis).T, cmap=cmap, origin="lower")
+        ax.set_title(f"axis {axis}, index {data.shape[axis] // 2}")
+        ax.axis("off")
+    if title is not None:
+        fig.suptitle(title)
+    return fig
+
+
+def plot_image(image, title: Optional[str] = None, cmap: str = "gray", figsize: Sequence[float] = (6, 6)):
+    """
+    Display a 2D image, or the center slices of a 3D image, with matplotlib.
+
+    Args:
+        image: array-like with 2 or 3 dimensions. Torch tensors are converted to numpy. A leading channel
+            dimension of size 1 is squeezed out.
+        title: optional title.
+        cmap: matplotlib colormap name.
+        figsize: figure size in inches (used for 2D images; 3D images use ``plot_center_slices``).
+
+    Returns:
+        the matplotlib figure.
+    """
+    import matplotlib.pyplot as plt  # lazy import, matplotlib is optional
+
+    data = _to_numpy(image)
+    if data.ndim == 3 and data.shape[0] == 1:
+        data = data[0]
+    if data.ndim == 3:
+        return plot_center_slices(data, title=title, cmap=cmap)
+    if data.ndim != 2:
+        raise ValueError(f"plot_image expects a 2D or 3D image, got {data.ndim} dimensions.")
+
+    fig, ax = plt.subplots(1, 1, figsize=figsize)
+    ax.imshow(data.T, cmap=cmap, origin="lower")
+    ax.axis("off")
+    if title is not None:
+        ax.set_title(title)
+    return fig
+
+
+def _to_numpy(image: Any) -> np.ndarray:
+    if hasattr(image, "detach"):  # torch tensor
+        image = image.detach().cpu().numpy()
+    return np.asarray(image)
