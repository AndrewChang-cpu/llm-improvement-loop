+"""
+Utilities to help use MONAI inside Jupyter notebooks.
+
+``ipywidgets`` is an optional dependency: it is imported lazily (not through
+``optional_import``, which would create a circular dependency inside ``monai.utils``)
+and only needed by the widget helpers ``StopButton`` and ``ThreadButton``.
+The ``ThreadContainer`` helper has no optional dependency.
+"""
+
+import threading
+from typing import Any, Callable, Optional
+
+__all__ = ["ThreadContainer", "StopButton", "ThreadButton"]
+
+
+def _import_ipywidgets():
+    try:
+        import ipywidgets  # type: ignore
+    except ImportError as e:
+        raise ImportError(
+            "ipywidgets is required for Jupyter widget utilities, install with `pip install ipywidgets`."
+        ) from e
+    return ipywidgets
+
+
+class ThreadContainer(threading.Thread):
+    """
+    A thread that runs ``target(*args, **kwargs)`` and can be asked to stop.
+
+    The target function should periodically check the ``stop_event`` (or ``stopped``) and
+    return early when it is set. Stopping is cooperative: ``stop()`` only sets a flag.
+
+    Args:
+        target: the callable to run in the background thread.
+        args: positional arguments for ``target``.
+        kwargs: keyword arguments for ``target``.
+
+    Example:
+
+        .. code-block:: python
+
+            t = None
+
+            def my_loop():
+                while not t.stopped:
+                    ...
+
+            t = ThreadContainer(my_loop)
+            t.start()
+            ...
+            t.stop()
+            t.join()
+    """
+
+    def __init__(self, target: Callable[..., Any], args: tuple = (), kwargs: Optional[dict] = None) -> None:
+        super().__init__(daemon=True)
+        self._target_fn = target
+        self._args = tuple(args)
+        self._kwargs = dict(kwargs) if kwargs is not None else {}
+        self._stop_event = threading.Event()
+        self.result: Any = None
+        self.exception: Optional[BaseException] = None
+
+    @property
+    def stop_event(self) -> threading.Event:
+        """The event set by ``stop()``; pass it to the target to support cooperative cancellation."""
+        return self._stop_event
+
+    @property
+    def stopped(self) -> bool:
+        """True once ``stop()`` has been called."""
+        return self._stop_event.is_set()
+
+    def stop(self) -> None:
+        """Request the thread to stop (cooperative; the target must check ``stopped``)."""
+        self._stop_event.set()
+
+    def run(self) -> None:
+        try:
+            self.result = self._target_fn(*self._args, **self._kwargs)
+        except BaseException as e:  # keep the exception so callers can inspect it after join()
+            self.exception = e
+
+
+class StopButton:
+    """
+    An ipywidgets button which, when clicked, calls ``stop()`` on a ``ThreadContainer``
+    (or any object with a ``stop`` method).
+
+    Args:
+        thread: the object to stop when the button is clicked; it can be set later with ``attach``.
+        description: text shown on the button.
+        kwargs: extra keyword arguments passed to ``ipywidgets.Button``.
+
+    Requires ``ipywidgets``.
+    """
+
+    def __init__(self, thread: Optional[Any] = None, description: str = "Stop", **kwargs: Any) -> None:
+        widgets = _import_ipywidgets()
+        self.thread = thread
+        self.button = widgets.Button(description=description, **kwargs)
+        self.button.on_click(self._on_click)
+
+    def attach(self, thread: Any) -> None:
+        """Set the object whose ``stop`` method is called on click."""
+        self.thread = thread
+
+    def _on_click(self, _button: Any) -> None:
+        if self.thread is not None:
+            self.thread.stop()
+
+    def display(self) -> None:
+        """Display the button in the current notebook cell."""
+        from IPython.display import display  # type: ignore
+
+        display(self.button)
+
+
+class ThreadButton:
+    """
+    An ipywidgets button which starts ``target`` in a new ``ThreadContainer`` on click,
+    so long-running work does not block the notebook kernel. Clicking the button again
+    while a run is active does nothing. Use with ``StopButton`` to cancel a run.
+
+    Args:
+        target: the callable to run in the background.
+        args: positional arguments for ``target``.
+        kwargs: keyword arguments for ``target``.
+        description: text shown on the button.
+        button_kwargs: extra keyword arguments passed to ``ipywidgets.Button``.
+
+    Requires ``ipywidgets``.
+    """
+
+    def __init__(
+        self,
+        target: Callable[..., Any],
+        args: tuple = (),
+        kwargs: Optional[dict] = None,
+        description: str = "Run",
+        button_kwargs: Optional[dict] = None,
+    ) -> None:
+        widgets = _import_ipywidgets()
+        self._target = target
+        self._args = args
+        self._kwargs = kwargs
+        self.thread: Optional[ThreadContainer] = None
+        self.button = widgets.Button(description=description, **(button_kwargs or {}))
+        self.button.on_click(self._on_click)
+
+    def _on_click(self, _button: Any) -> None:
+        if self.thread is not None and self.thread.is_alive():
+            return
+        self.thread = ThreadContainer(self._target, args=self._args, kwargs=self._kwargs)
+        self.thread.start()
+
+    def display(self) -> None:
+        """Display the button in the current notebook cell."""
+        from IPython.display import display  # type: ignore
+
+        display(self.button)
