+import importlib.util
+import unittest
+
+from monai.utils.jupyter_utils import StopButton, ThreadButton, ThreadContainer
+
+HAS_IPYWIDGETS = importlib.util.find_spec("ipywidgets") is not None
+
+
+class TestThreadContainer(unittest.TestCase):
+    def test_runs_target_and_stores_result(self):
+        t = ThreadContainer(lambda a, b=0: a + b, args=(2,), kwargs={"b": 3})
+        t.start()
+        t.join()
+        self.assertEqual(t.result, 5)
+        self.assertIsNone(t.exception)
+
+    def test_stop_sets_flag_and_event(self):
+        t = ThreadContainer(lambda: None)
+        self.assertFalse(t.stopped)
+        self.assertFalse(t.stop_event.is_set())
+        t.stop()
+        self.assertTrue(t.stopped)
+        self.assertTrue(t.stop_event.is_set())
+
+    def test_cooperative_stop(self):
+        holder = {}
+
+        def loop():
+            count = 0
+            while not holder["t"].stopped:
+                count += 1
+                if count > 10_000_000:
+                    break
+            return count
+
+        holder["t"] = ThreadContainer(loop)
+        holder["t"].start()
+        holder["t"].stop()
+        holder["t"].join(timeout=10)
+        self.assertFalse(holder["t"].is_alive())
+        self.assertIsInstance(holder["t"].result, int)
+
+    def test_exception_is_captured(self):
+        def fail():
+            raise ValueError("boom")
+
+        t = ThreadContainer(fail)
+        t.start()
+        t.join()
+        self.assertIsInstance(t.exception, ValueError)
+        self.assertIsNone(t.result)
+
+
+@unittest.skipUnless(HAS_IPYWIDGETS, "ipywidgets not installed")
+class TestWidgets(unittest.TestCase):
+    def test_stop_button_stops_thread(self):
+        t = ThreadContainer(lambda: None)
+        b = StopButton(thread=t)
+        b._on_click(None)
+        self.assertTrue(t.stopped)
+
+    def test_thread_button_starts_thread(self):
+        b = ThreadButton(lambda: 7)
+        b._on_click(None)
+        b.thread.join()
+        self.assertEqual(b.thread.result, 7)
+
+
+if __name__ == "__main__":
+    unittest.main()
