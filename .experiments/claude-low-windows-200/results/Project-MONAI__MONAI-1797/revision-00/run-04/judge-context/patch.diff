+"""
+Utilities to make MONAI convenient to use inside Jupyter notebooks.
+
+This module deliberately does not use ``optional_import`` (which would create a circular dependency through
+``monai.utils``); optional packages such as ``matplotlib`` are imported lazily inside the functions that need them.
+Values are left loosely typed where Matplotlib objects are involved.
+"""
+
+import sys
+from typing import Any, Optional, Sequence
+
+import numpy as np
+
+__all__ = ["is_jupyter", "plot_image_grid"]
+
+
+def is_jupyter() -> bool:
+    """
+    Return True if the code is running inside a Jupyter kernel (e.g. a notebook or qtconsole), False otherwise.
+
+    IPython is never imported here: if it is not already loaded, the code cannot be running in a Jupyter kernel.
+    """
+    ipython = sys.modules.get("IPython")
+    if ipython is None:
+        return False
+    get_ipython = getattr(ipython, "get_ipython", None)
+    if get_ipython is None:
+        return False
+    shell = get_ipython()
+    return shell is not None and type(shell).__name__ == "ZMQInteractiveShell"
+
+
+def _to_2d_array(image: Any, channel: int, slice_index: Optional[int]) -> np.ndarray:
+    """
+    Reduce an image array to a 2D array for display. Supported layouts follow the MONAI channel-first convention:
+    (H, W), (C, H, W) and (C, D, H, W).
+    """
+    arr = np.asarray(image)
+    if arr.ndim == 3:
+        # channel-first 2D image (C, H, W)
+        arr = arr[min(channel, arr.shape[0] - 1)]
+    elif arr.ndim == 4:
+        # channel-first volume (C, D, H, W): select channel, then slice along depth
+        arr = arr[min(channel, arr.shape[0] - 1)]
+        idx = arr.shape[0] // 2 if slice_index is None else slice_index
+        arr = arr[min(idx, arr.shape[0] - 1)]
+    if arr.ndim != 2:
+        raise ValueError(f"unable to display array with shape {np.asarray(image).shape} as a 2D image.")
+    return arr
+
+
+def plot_image_grid(
+    images: Sequence[Any],
+    titles: Optional[Sequence[str]] = None,
+    channel: int = 0,
+    slice_index: Optional[int] = None,
+    cmap: str = "gray",
+    ncols: int = 4,
+    figsize_per_image: Sequence[float] = (4, 4),
+) -> Any:
+    """
+    Plot a sequence of images in a grid using Matplotlib and return the figure.
+
+    Each entry can be a 2D array (H, W), a channel-first 2D image (C, H, W), or a channel-first volume (C, D, H, W).
+    For multi-channel inputs only ``channel`` is shown; for volumes the slice ``slice_index`` (default: middle slice)
+    is shown.
+
+    Args:
+        images: sequence of array-like images.
+        titles: optional titles, one per image.
+        channel: channel to display for multi-channel images.
+        slice_index: slice to display for volumetric images; defaults to the middle slice.
+        cmap: Matplotlib colormap name.
+        ncols: maximum number of columns in the grid.
+        figsize_per_image: (width, height) in inches for each subplot.
+
+    Raises:
+        ImportError: if Matplotlib is not installed.
+        ValueError: if ``titles`` has a different length than ``images`` or an image cannot be displayed.
+    """
+    try:
+        import matplotlib.pyplot as plt
+    except ImportError as e:
+        raise ImportError("plot_image_grid requires matplotlib, please install it.") from e
+
+    if titles is not None and len(titles) != len(images):
+        raise ValueError(f"len(titles) ({len(titles)}) must equal len(images) ({len(images)}).")
+    if len(images) == 0:
+        raise ValueError("no images to plot.")
+
+    ncols = max(1, min(ncols, len(images)))
+    nrows = int(np.ceil(len(images) / ncols))
+    fig, axes = plt.subplots(
+        nrows,
+        ncols,
+        figsize=(figsize_per_image[0] * ncols, figsize_per_image[1] * nrows),
+        squeeze=False,
+    )
+    flat_axes = axes.ravel()
+    for i, image in enumerate(images):
+        ax = flat_axes[i]
+        ax.imshow(_to_2d_array(image, channel, slice_index), cmap=cmap)
+        ax.axis("off")
+        if titles is not None:
+            ax.set_title(str(titles[i]))
+    for ax in flat_axes[len(images) :]:
+        ax.axis("off")
+    fig.tight_layout()
+    return fig
