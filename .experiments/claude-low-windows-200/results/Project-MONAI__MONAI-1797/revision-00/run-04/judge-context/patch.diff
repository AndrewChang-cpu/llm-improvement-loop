+import sys
+import types
+import unittest
+from unittest import mock
+
+import numpy as np
+
+from monai.utils.jupyter_utils import _to_2d_array, is_jupyter, plot_image_grid
+
+try:
+    import matplotlib  # noqa: F401
+
+    has_matplotlib = True
+except ImportError:
+    has_matplotlib = False
+
+
+class TestIsJupyter(unittest.TestCase):
+    def test_not_jupyter_when_ipython_absent(self):
+        with mock.patch.dict(sys.modules, {"IPython": None}):
+            self.assertFalse(is_jupyter())
+
+    def test_not_jupyter_in_plain_python(self):
+        self.assertFalse(is_jupyter())
+
+    def test_detects_zmq_shell(self):
+        class ZMQInteractiveShell:
+            pass
+
+        fake = types.ModuleType("IPython")
+        fake.get_ipython = lambda: ZMQInteractiveShell()
+        with mock.patch.dict(sys.modules, {"IPython": fake}):
+            self.assertTrue(is_jupyter())
+
+    def test_terminal_shell_is_not_jupyter(self):
+        class TerminalInteractiveShell:
+            pass
+
+        fake = types.ModuleType("IPython")
+        fake.get_ipython = lambda: TerminalInteractiveShell()
+        with mock.patch.dict(sys.modules, {"IPython": fake}):
+            self.assertFalse(is_jupyter())
+
+
+class TestToTwoD(unittest.TestCase):
+    def test_2d(self):
+        out = _to_2d_array(np.zeros((4, 5)), channel=0, slice_index=None)
+        self.assertEqual(out.shape, (4, 5))
+
+    def test_channel_first(self):
+        img = np.arange(2 * 3 * 4).reshape(2, 3, 4)
+        out = _to_2d_array(img, channel=1, slice_index=None)
+        np.testing.assert_array_equal(out, img[1])
+
+    def test_volume_middle_slice(self):
+        vol = np.arange(1 * 5 * 3 * 4).reshape(1, 5, 3, 4)
+        out = _to_2d_array(vol, channel=0, slice_index=None)
+        np.testing.assert_array_equal(out, vol[0, 2])
+
+    def test_volume_given_slice(self):
+        vol = np.arange(1 * 5 * 3 * 4).reshape(1, 5, 3, 4)
+        out = _to_2d_array(vol, channel=0, slice_index=4)
+        np.testing.assert_array_equal(out, vol[0, 4])
+
+    def test_channel_volume(self):
+        img = np.arange(2 * 5 * 3 * 4).reshape(2, 5, 3, 4)
+        out = _to_2d_array(img, channel=1, slice_index=0)
+        np.testing.assert_array_equal(out, img[1, 0])
+
+    def test_bad_dims(self):
+        with self.assertRaises(ValueError):
+            _to_2d_array(np.zeros(5), channel=0, slice_index=None)
+
+
+class TestPlotImageGrid(unittest.TestCase):
+    def test_validation_errors(self):
+        if has_matplotlib:
+            with self.assertRaises(ValueError):
+                plot_image_grid([np.zeros((2, 2))], titles=["a", "b"])
+            with self.assertRaises(ValueError):
+                plot_image_grid([])
+        else:
+            with self.assertRaises(ImportError):
+                plot_image_grid([np.zeros((2, 2))])
+
+    def test_missing_matplotlib_raises(self):
+        with mock.patch.dict(sys.modules, {"matplotlib": None, "matplotlib.pyplot": None}):
+            with self.assertRaises(ImportError):
+                plot_image_grid([np.zeros((2, 2))])
+
+    @unittest.skipUnless(has_matplotlib, "matplotlib required")
+    def test_grid_layout(self):
+        import matplotlib
+
+        matplotlib.use("Agg")
+        imgs = [np.random.rand(8, 8) for _ in range(5)]
+        fig = plot_image_grid(imgs, titles=[str(i) for i in range(5)], ncols=2)
+        # 5 images in 2 columns -> 3 rows, 6 axes (last one empty)
+        self.assertEqual(len(fig.axes), 6)
+        import matplotlib.pyplot as plt
+
+        plt.close(fig)
+
+
+if __name__ == "__main__":
+    unittest.main()
