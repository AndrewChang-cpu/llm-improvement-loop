+"""
+Utilities for visualizing medical images, intended for use in Jupyter notebooks.
+
+Matplotlib is imported lazily inside each function (rather than through
+``optional_import`` at module level) so that this module stays importable
+without matplotlib and does not create circular imports with ``monai.utils``.
+The functions here are intentionally untyped where matplotlib objects are
+involved, since matplotlib does not ship type information.
+"""
+
+import numpy as np
+import torch
+
+
+def _to_numpy(data):
+    """Convert a torch tensor or array-like into a numpy array (detached, on CPU)."""
+    if isinstance(data, torch.Tensor):
+        return data.detach().cpu().numpy()
+    return np.asarray(data)
+
+
+def blend_images(image, label, alpha=0.5, cmap="hsv", rescale_arrays=True):
+    """
+    Blend a 2D grayscale image with a 2D label map, returning an RGB array for display.
+
+    Args:
+        image: 2D grayscale image, shape (H, W). Torch tensors are accepted.
+        label: 2D label map of the same shape as `image`. Each non-zero label is coloured
+            with `cmap`; background (0) keeps the grayscale image.
+        alpha: opacity of the label colours in the blend, in [0, 1].
+        cmap: name of a matplotlib colormap used to colour the labels.
+        rescale_arrays: if True, rescale `image` to [0, 1] before blending.
+
+    Returns:
+        float numpy array of shape (H, W, 3) with values in [0, 1].
+    """
+    image = _to_numpy(image).astype(np.float64)
+    label = _to_numpy(label)
+    if image.ndim != 2 or label.shape != image.shape:
+        raise ValueError(
+            f"image and label must be 2D arrays of the same shape, got {image.shape} and {label.shape}."
+        )
+    if not 0.0 <= alpha <= 1.0:
+        raise ValueError(f"alpha must be in [0, 1], got {alpha}.")
+
+    if rescale_arrays:
+        lo, hi = float(image.min()), float(image.max())
+        image = (image - lo) / (hi - lo) if hi > lo else np.zeros_like(image)
+
+    from matplotlib import pyplot as plt
+
+    gray_rgb = np.stack([image, image, image], axis=-1)
+    colormap = plt.get_cmap(cmap)
+    max_label = max(int(label.max()), 1)
+    label_rgb = colormap(label.astype(np.float64) / max_label)[..., :3]
+    mask = (label != 0)[..., None]
+    blended = np.where(mask, (1.0 - alpha) * gray_rgb + alpha * label_rgb, gray_rgb)
+    return np.clip(blended, 0.0, 1.0)
+
+
+def matshow3d(
+    volume,
+    fig=None,
+    title=None,
+    figsize=(10, 10),
+    frames_per_row=None,
+    every_n=1,
+    frame_dim=-1,
+    show=False,
+    cmap="gray",
+    vmin=None,
+    vmax=None,
+    **kwargs,
+):
+    """
+    Display all 2D slices of a 3D volume in a single grid of matplotlib subplots.
+
+    Args:
+        volume: 3D array or tensor. Slices are taken along `frame_dim`.
+        fig: matplotlib figure to draw into. A new figure is created if None.
+        title: optional figure title.
+        figsize: figure size in inches, used when creating a new figure.
+        frames_per_row: number of slices per grid row. Defaults to ``ceil(sqrt(n_frames))``.
+        every_n: step between displayed slices (display every `every_n`-th slice).
+        frame_dim: axis of `volume` along which slices are taken.
+        show: if True, call ``plt.show()`` after drawing.
+        cmap: matplotlib colormap name.
+        vmin: lower display limit passed to ``imshow``.
+        vmax: upper display limit passed to ``imshow``.
+        kwargs: additional keyword arguments passed to ``imshow``.
+
+    Returns:
+        the matplotlib figure containing the grid.
+    """
+    arr = _to_numpy(volume)
+    if arr.ndim != 3:
+        raise ValueError(f"volume must be 3D, got shape {arr.shape}.")
+    if every_n < 1:
+        raise ValueError(f"every_n must be a positive integer, got {every_n}.")
+
+    from matplotlib import pyplot as plt
+
+    arr = np.moveaxis(arr, frame_dim, -1)
+    frames = [arr[..., i] for i in range(0, arr.shape[-1], every_n)]
+    n_frames = len(frames)
+    if frames_per_row is None:
+        frames_per_row = int(np.ceil(np.sqrt(n_frames)))
+    frames_per_row = max(1, min(frames_per_row, n_frames))
+    n_rows = int(np.ceil(n_frames / frames_per_row))
+
+    if fig is None:
+        fig = plt.figure(figsize=figsize)
+    fig.clf()
+    axes = fig.subplots(n_rows, frames_per_row, squeeze=False)
+    for ax in axes.ravel():
+        ax.axis("off")
+    for idx, frame in enumerate(frames):
+        ax = axes.ravel()[idx]
+        ax.imshow(frame, cmap=cmap, vmin=vmin, vmax=vmax, **kwargs)
+        ax.set_title(str(idx * every_n))
+    if title is not None:
+        fig.suptitle(title)
+    if show:
+        plt.show()
+    return fig
