+
+import unittest
+
+import numpy as np
+import torch
+
+from monai.visualize import blend_images, matshow3d
+from tests.utils import SkipIfNoModule
+
+
+class TestVisualizeUtils(unittest.TestCase):
+    @SkipIfNoModule("matplotlib")
+    def test_blend_images(self):
+        image = np.random.rand(16, 16)
+        label = np.zeros((16, 16), dtype=np.int64)
+        label[4:8, 4:8] = 1
+        out = blend_images(torch.as_tensor(image), label, alpha=0.5)
+        self.assertEqual(out.shape, (16, 16, 3))
+        self.assertTrue(out.min() >= 0.0 and out.max() <= 1.0)
+        # background pixels stay grayscale
+        np.testing.assert_allclose(out[0, 0], np.full(3, out[0, 0, 0]))
+
+    def test_blend_images_bad_shape(self):
+        with self.assertRaises(ValueError):
+            blend_images(np.zeros((4, 4)), np.zeros((4, 5)))
+
+    @SkipIfNoModule("matplotlib")
+    def test_matshow3d(self):
+        import matplotlib
+
+        matplotlib.use("Agg")
+        vol = torch.rand(8, 8, 10)
+        fig = matshow3d(vol, title="t", every_n=2, frames_per_row=3)
+        self.assertEqual(len(fig.axes), 3 * 2)  # 5 frames -> 2 rows of 3
+
+    def test_matshow3d_bad_ndim(self):
+        with self.assertRaises(ValueError):
+            matshow3d(np.zeros((4, 4)))
+
+
+if __name__ == "__main__":
+    unittest.main()
