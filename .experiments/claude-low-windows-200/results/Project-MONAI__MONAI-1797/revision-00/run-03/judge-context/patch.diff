+"""
+Utilities for using MONAI interactively in Jupyter notebooks.
+
+This module deliberately avoids importing ``optional_import`` from ``monai.utils.module``
+and does not import matplotlib at module load time, so that it can be imported from
+``monai.utils`` without circular dependency problems. Optional dependencies are imported
+inside the functions that need them.
+"""
+
+from typing import Any, Optional, Sequence, Union
+
+import numpy as np
+
+__all__ = ["is_jupyter", "plot_image_grid"]
+
+
+def is_jupyter() -> bool:
+    """
+    Return True if the code is running inside a Jupyter kernel (notebook or qtconsole),
+    False otherwise (plain Python interpreter, IPython terminal, or IPython not installed).
+    """
+    try:
+        from IPython import get_ipython  # type: ignore
+    except ImportError:
+        return False
+    shell = get_ipython()
+    if shell is None:
+        return False
+    return type(shell).__name__ == "ZMQInteractiveShell"
+
+
+def plot_image_grid(
+    images: Sequence[Any],
+    titles: Optional[Sequence[str]] = None,
+    ncols: int = 4,
+    cmap: str = "gray",
+    figsize_per_image: Union[float, Sequence[float]] = 3.0,
+    show: bool = True,
+) -> Any:
+    """
+    Plot a sequence of 2D images (arrays or tensors of shape ``HW``, ``CHW`` with C=1 or 3,
+    or ``1HW``) in a grid using matplotlib. Matplotlib is imported when this function is called.
+
+    Args:
+        images: sequence of images to display. Torch tensors are converted to numpy on the CPU.
+        titles: optional titles, one per image.
+        ncols: number of columns in the grid.
+        cmap: colormap used for single-channel images.
+        figsize_per_image: width and height in inches of each subplot, either one number
+            or a ``(width, height)`` pair.
+        show: whether to call ``plt.show()`` after drawing.
+
+    Returns:
+        the matplotlib figure.
+    """
+    try:
+        import matplotlib.pyplot as plt  # type: ignore
+    except ImportError as e:
+        raise ImportError("matplotlib is required for plot_image_grid, please install it.") from e
+
+    if len(images) == 0:
+        raise ValueError("images must contain at least one image.")
+    if titles is not None and len(titles) != len(images):
+        raise ValueError(f"len(titles) ({len(titles)}) must match len(images) ({len(images)}).")
+    if ncols < 1:
+        raise ValueError(f"ncols must be a positive integer, got {ncols}.")
+
+    if isinstance(figsize_per_image, (int, float)):
+        w, h = float(figsize_per_image), float(figsize_per_image)
+    else:
+        w, h = (float(v) for v in figsize_per_image)
+
+    nrows = int(np.ceil(len(images) / ncols))
+    ncols_used = min(ncols, len(images))
+    fig, axes = plt.subplots(nrows, ncols_used, figsize=(w * ncols_used, h * nrows), squeeze=False)
+    flat_axes = axes.ravel()
+    for i, img in enumerate(images):
+        arr = img.detach().cpu().numpy() if hasattr(img, "detach") else np.asarray(img)
+        arr = np.squeeze(arr)
+        if arr.ndim != 2:
+            raise ValueError(f"each image must be 2D after squeezing, got shape {arr.shape} at index {i}.")
+        ax = flat_axes[i]
+        ax.imshow(arr, cmap=cmap)
+        ax.axis("off")
+        if titles is not None:
+            ax.set_title(str(titles[i]))
+    for ax in flat_axes[len(images) :]:
+        ax.axis("off")
+    fig.tight_layout()
+    if show:
+        plt.show()
+    return fig
