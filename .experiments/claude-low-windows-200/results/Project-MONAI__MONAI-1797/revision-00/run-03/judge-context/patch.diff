+
+import unittest
+
+import numpy as np
+import torch
+
+from monai.utils.jupyter_utils import is_jupyter, plot_image_grid
+
+try:
+    import matplotlib
+
+    matplotlib.use("Agg")
+    HAS_MPL = True
+except ImportError:
+    HAS_MPL = False
+
+
+class TestIsJupyter(unittest.TestCase):
+    def test_not_jupyter(self):
+        # tests run under plain python, not inside a Jupyter kernel
+        self.assertFalse(is_jupyter())
+
+
+@unittest.skipUnless(HAS_MPL, "matplotlib required")
+class TestPlotImageGrid(unittest.TestCase):
+    def test_grid_numpy_and_tensor(self):
+        images = [np.random.rand(8, 8), torch.rand(1, 8, 8), torch.rand(8, 8)]
+        fig = plot_image_grid(images, titles=["a", "b", "c"], ncols=2, show=False)
+        # 2 rows x 2 columns, last subplot unused but present
+        self.assertEqual(len(fig.axes), 4)
+        self.assertEqual(fig.axes[0].get_title(), "a")
+        self.assertEqual(fig.axes[2].get_title(), "c")
+
+    def test_single_image(self):
+        fig = plot_image_grid([np.zeros((4, 4))], show=False)
+        self.assertEqual(len(fig.axes), 1)
+
+    def test_bad_inputs(self):
+        with self.assertRaises(ValueError):
+            plot_image_grid([], show=False)
+        with self.assertRaises(ValueError):
+            plot_image_grid([np.zeros((4, 4))], titles=["a", "b"], show=False)
+        with self.assertRaises(ValueError):
+            plot_image_grid([np.zeros((2, 4, 4))], show=False)
+        with self.assertRaises(ValueError):
+            plot_image_grid([np.zeros((4, 4))], ncols=0, show=False)
+
+
+if __name__ == "__main__":
+    unittest.main()
