+"""
+Utilities to help use MONAI inside Jupyter notebooks.
+
+Matplotlib (and IPython) are imported lazily inside the functions that need them.
+This avoids a circular dependency with ``monai.utils`` and keeps this module importable
+when the notebook-only packages are not installed. Because of this, some values in this
+module are intentionally untyped (e.g. matplotlib figure and axes objects).
+"""
+
+from typing import Any, Optional, Tuple
+
+import numpy as np
+import torch
+
+__all__ = ["to_2d_display_array", "ipython_imshow"]
+
+
+def to_2d_display_array(img: Any) -> np.ndarray:
+    """
+    Convert an image to a 2D (H, W) or channel-last (H, W, C) numpy array that can be shown by matplotlib.
+
+    Accepted inputs are numpy arrays or torch tensors. Leading singleton dimensions are removed.
+    A channel-first (C, H, W) array with C in (1, 3, 4) is converted to channel-last.
+
+    Args:
+        img: input image, with shape (H, W), (C, H, W), (H, W, C) or with an extra leading singleton dim.
+
+    Returns:
+        numpy array of shape (H, W) or (H, W, C).
+
+    Raises:
+        ValueError: when the image cannot be reduced to 2D or channel-last 2D form.
+    """
+    if isinstance(img, torch.Tensor):
+        arr = img.detach().cpu().numpy()
+    else:
+        arr = np.asarray(img)
+
+    # drop leading singleton dimensions, e.g. (1, 1, H, W) -> (H, W)
+    while arr.ndim > 2 and arr.shape[0] == 1:
+        arr = arr[0]
+
+    if arr.ndim == 3 and arr.shape[0] in (1, 3, 4) and arr.shape[-1] not in (1, 3, 4):
+        arr = np.transpose(arr, (1, 2, 0))
+    if arr.ndim == 3 and arr.shape[-1] == 1:
+        arr = arr[..., 0]
+
+    if arr.ndim not in (2, 3):
+        raise ValueError(f"unsupported image shape for display: {arr.shape}.")
+    return arr
+
+
+def ipython_imshow(
+    img: Any,
+    title: Optional[str] = None,
+    figsize: Tuple[int, int] = (8, 8),
+    cmap: Optional[str] = "gray",
+    vmin: Optional[float] = None,
+    vmax: Optional[float] = None,
+    show: bool = True,
+) -> Any:
+    """
+    Display a 2D image (or a single slice of a 3D volume) inside a Jupyter notebook using matplotlib.
+
+    Args:
+        img: image to display, numpy array or torch tensor, see ``to_2d_display_array`` for accepted shapes.
+        title: optional title of the figure.
+        figsize: size of the figure in inches.
+        cmap: matplotlib colormap name, only used for single-channel images.
+        vmin: minimum value for the colormap, default is the image minimum.
+        vmax: maximum value for the colormap, default is the image maximum.
+        show: whether to call ``IPython.display.display`` on the figure (and close it) right away.
+
+    Returns:
+        the matplotlib figure object (untyped, to avoid a hard dependency on matplotlib at import time).
+
+    Raises:
+        ImportError: when matplotlib is not installed.
+    """
+    try:
+        import matplotlib.pyplot as plt
+    except ImportError as e:
+        raise ImportError("matplotlib is required for ipython_imshow, please install it.") from e
+
+    arr = to_2d_display_array(img)
+    fig, ax = plt.subplots(figsize=figsize)
+    is_gray = arr.ndim == 2
+    ax.imshow(arr, cmap=cmap if is_gray else None, vmin=vmin if is_gray else None, vmax=vmax if is_gray else None)
+    ax.axis("off")
+    if title is not None:
+        ax.set_title(title)
+
+    if show:
+        try:
+            from IPython.display import display
+
+            display(fig)
+        except ImportError:
+            plt.show()
+        plt.close(fig)
+    return fig
