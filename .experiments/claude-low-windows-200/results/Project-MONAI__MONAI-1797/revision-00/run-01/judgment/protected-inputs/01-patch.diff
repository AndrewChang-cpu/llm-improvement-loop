+
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.utils.jupyter_utils import ipython_imshow, to_2d_display_array
+
+try:
+    import matplotlib  # noqa: F401
+
+    has_matplotlib = True
+except ImportError:
+    has_matplotlib = False
+
+TEST_CASE_1 = [np.zeros((4, 5)), (4, 5)]
+TEST_CASE_2 = [np.zeros((1, 1, 4, 5)), (4, 5)]
+TEST_CASE_3 = [torch.zeros(1, 4, 5), (4, 5)]
+TEST_CASE_4 = [np.zeros((3, 4, 5)), (4, 5, 3)]
+TEST_CASE_5 = [torch.zeros(4, 5, 3), (4, 5, 3)]
+TEST_CASE_6 = [np.zeros((4, 5, 1)), (4, 5)]
+
+
+class TestToDisplayArray(unittest.TestCase):
+    @parameterized.expand([TEST_CASE_1, TEST_CASE_2, TEST_CASE_3, TEST_CASE_4, TEST_CASE_5, TEST_CASE_6])
+    def test_shape(self, img, expected_shape):
+        out = to_2d_display_array(img)
+        self.assertIsInstance(out, np.ndarray)
+        self.assertEqual(out.shape, expected_shape)
+
+    def test_invalid_shape(self):
+        with self.assertRaises(ValueError):
+            to_2d_display_array(np.zeros((2, 3, 4, 5)))
+
+
+class TestIPythonImshow(unittest.TestCase):
+    @unittest.skipUnless(has_matplotlib, "matplotlib is not installed")
+    def test_show_false_returns_figure(self):
+        fig = ipython_imshow(np.random.rand(8, 8), title="t", show=False)
+        self.assertEqual(len(fig.axes), 1)
+        self.assertEqual(fig.axes[0].get_title(), "t")
+        import matplotlib.pyplot as plt
+
+        plt.close(fig)
+
+
+if __name__ == "__main__":
+    unittest.main()
