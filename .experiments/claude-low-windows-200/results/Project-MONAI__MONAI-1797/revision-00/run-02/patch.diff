+# limitations under the License.
+
+import unittest
+from unittest import mock
+
+import numpy as np
+import torch
+
+from monai.utils.jupyter_utils import is_jupyter_notebook, plot_image_slices
+
+try:
+    import matplotlib
+
+    matplotlib.use("Agg")
+    has_matplotlib = True
+except ImportError:
+    has_matplotlib = False
+
+
+class TestJupyterUtils(unittest.TestCase):
+    def test_not_notebook(self):
+        self.assertFalse(is_jupyter_notebook())
+
+    def test_notebook_detection(self):
+        fake_ipython = mock.MagicMock()
+        shell_cls = type("ZMQInteractiveShell", (), {})
+        fake_ipython.get_ipython = mock.Mock(return_value=shell_cls())
+        with mock.patch.dict("sys.modules", {"IPython": fake_ipython}):
+            self.assertTrue(is_jupyter_notebook())
+        plain_cls = type("TerminalInteractiveShell", (), {})
+        fake_ipython.get_ipython = mock.Mock(return_value=plain_cls())
+        with mock.patch.dict("sys.modules", {"IPython": fake_ipython}):
+            self.assertFalse(is_jupyter_notebook())
+
+    def test_missing_matplotlib(self):
+        with mock.patch.dict("sys.modules", {"matplotlib": None, "matplotlib.pyplot": None}):
+            with self.assertRaises(ImportError):
+                plot_image_slices(np.zeros((4, 4)), show=False)
+
+    @unittest.skipUnless(has_matplotlib, "matplotlib required")
+    def test_plot_2d_and_3d(self):
+        import matplotlib.pyplot as plt
+
+        fig = plot_image_slices(np.random.rand(8, 8), title="t", show=False)
+        self.assertEqual(len(fig.axes), 1)
+        plt.close(fig)
+        fig = plot_image_slices(torch.rand(1, 8, 8, 8), show=False)
+        self.assertEqual(len(fig.axes), 3)
+        plt.close(fig)
+        fig = plot_image_slices(torch.rand(1, 8, 8), show=False)
+        self.assertEqual(len(fig.axes), 1)
+        plt.close(fig)
+
+    @unittest.skipUnless(has_matplotlib, "matplotlib required")
+    def test_invalid_shape(self):
+        with self.assertRaises(ValueError):
+            plot_image_slices(np.zeros((2, 3, 4, 5, 6)), show=False)
+
+
+if __name__ == "__main__":
+    unittest.main()
