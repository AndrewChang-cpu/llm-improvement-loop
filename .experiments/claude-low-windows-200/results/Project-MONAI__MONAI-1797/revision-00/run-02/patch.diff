+"""
+Utilities to help use MONAI interactively in Jupyter notebooks.
+
+This module deliberately does not use ``optional_import`` at module level: ``monai.utils.module``
+is imported by most of MONAI, so the optional dependencies (IPython, matplotlib) are imported
+lazily inside the functions that need them. Values are intentionally left untyped where the
+matplotlib objects would otherwise be hard to annotate.
+"""
+
+from typing import Any, Optional, Sequence
+
+import numpy as np
+
+__all__ = ["is_jupyter_notebook", "plot_image_slices"]
+
+
+def is_jupyter_notebook() -> bool:
+    """
+    Return True if the code is running inside a Jupyter notebook (or qtconsole), False otherwise.
+
+    IPython is not required to be installed; if it cannot be imported, this returns False.
+    """
+    try:
+        from IPython import get_ipython
+    except ImportError:
+        return False
+    shell = get_ipython()
+    if shell is None:
+        return False
+    return type(shell).__name__ == "ZMQInteractiveShell"
+
+
+def _to_numpy(image: Any) -> np.ndarray:
+    if hasattr(image, "detach"):  # torch.Tensor without importing torch
+        image = image.detach().cpu().numpy()
+    return np.asarray(image)
+
+
+def plot_image_slices(
+    image: Any,
+    title: Optional[str] = None,
+    cmap: str = "gray",
+    figsize: Sequence[float] = (12, 4),
+    show: bool = True,
+) -> Any:
+    """
+    Plot a 2D or 3D single-channel image in a notebook using matplotlib.
+
+    For 2D input (H, W) a single panel is drawn. For 3D input (D, H, W) the three orthogonal
+    middle slices are drawn side by side. A leading channel dimension of size 1 is removed.
+
+    Args:
+        image: array-like or torch tensor with shape (H, W), (D, H, W), (1, H, W) or (1, D, H, W).
+        title: optional figure title.
+        cmap: matplotlib colormap name.
+        figsize: figure size in inches.
+        show: whether to call ``plt.show()``.
+
+    Returns:
+        the matplotlib figure.
+
+    Raises:
+        ImportError: if matplotlib is not installed.
+        ValueError: if the image does not have 2 or 3 spatial dimensions.
+    """
+    try:
+        import matplotlib.pyplot as plt
+    except ImportError as e:
+        raise ImportError("matplotlib is required for plot_image_slices, please install it.") from e
+
+    data = _to_numpy(image)
+    if data.ndim == 4 and data.shape[0] == 1:
+        data = data[0]
+    if data.ndim == 2:
+        fig, ax = plt.subplots(1, 1, figsize=figsize)
+        ax.imshow(data, cmap=cmap)
+        ax.axis("off")
+    elif data.ndim == 3:
+        d, h, w = data.shape
+        slices = [data[d // 2, :, :], data[:, h // 2, :], data[:, :, w // 2]]
+        fig, axes = plt.subplots(1, 3, figsize=figsize)
+        for ax, s in zip(axes, slices):
+            ax.imshow(s, cmap=cmap)
+            ax.axis("off")
+    else:
+        raise ValueError(f"expected 2D or 3D image (optionally with a singleton channel), got shape {data.shape}.")
+
+    if title is not None:
+        fig.suptitle(title)
+    if show:
+        plt.show()
+    return fig
