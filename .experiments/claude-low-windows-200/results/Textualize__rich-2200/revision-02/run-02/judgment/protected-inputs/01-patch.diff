diff --git a/rich/console.py b/rich/console.py
index c2b1995..76d022e 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1151,6 +1151,28 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the terminal window title.
+
+        Rich provides no way to reset the title to its previous value, so the
+        title persists after the application exits. Some shells reset titles
+        before and after each command, but most do not. Some terminals need
+        configuration changes or do not support titles. Other software may
+        overwrite the title at any time.
+
+        Args:
+            title (str): The new window title.
+
+        Returns:
+            bool: True if the title control was written to the buffer, otherwise
+                False. True means only that the control was written, not that the
+                title changed.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
+
