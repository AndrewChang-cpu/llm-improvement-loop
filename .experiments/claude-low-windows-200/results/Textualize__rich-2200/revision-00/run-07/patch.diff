diff --git a/rich/control.py b/rich/control.py
index e17b2c6..cb2d623 100644
--- a/rich/control.py
+++ b/rich/control.py
@@ -30,6 +30,7 @@ CONTROL_CODES_FORMAT: Dict[int, Callable[..., str]] = {
     ControlType.CURSOR_MOVE_TO_COLUMN: lambda param: f"\x1b[{param+1}G",
     ControlType.ERASE_IN_LINE: lambda param: f"\x1b[{param}K",
     ControlType.CURSOR_MOVE_TO: lambda x, y: f"\x1b[{y+1};{x+1}H",
+    ControlType.SET_WINDOW_TITLE: lambda title: f"\x1b]0;{title}\x07",
 }
 
 
@@ -58,6 +59,23 @@ class Control:
         """Ring the 'bell'."""
         return cls(ControlType.BELL)
 
+    @classmethod
+    def title(cls, title: str) -> "Control":
+        """Set the terminal window title.
+
+        Note that some terminals may require configuration to allow setting the
+        title, and some may not support it at all. Other software may also change
+        the title, so the value may be overwritten. Rich does not reset the title
+        when the application exits.
+
+        Args:
+            title (str): The new window title.
+
+        Returns:
+            ~Control: Control object.
+        """
+        return cls((ControlType.SET_WINDOW_TITLE, title))
+
     @classmethod
     def home(cls) -> "Control":
         """Move cursor to 'home' position."""
