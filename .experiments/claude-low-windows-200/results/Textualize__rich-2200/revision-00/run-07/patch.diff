+    def set_window_title(self, title: str) -> None:
+        """Set the title of the terminal window (if supported).
+
+        Some terminals may require configuration before the title can be set, and
+        some may not support it at all. Rich does not restore the previous title
+        when the application exits.
+
+        Args:
+            title (str): The new window title.
+        """
+        self.control(Control.title(title))
