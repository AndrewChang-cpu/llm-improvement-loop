@@ -1151,6 +1151,25 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the title of the terminal window.
+
+        Note that there is no means within Rich to restore the previous title, so
+        the title set here will persist after the application exits unless the
+        shell or terminal resets it. Some terminals may require configuration
+        before they allow the title to be set, and some may not support it.
+
+        Args:
+            title (str): The new terminal window title.
+
+        Returns:
+            bool: True if the control codes were written.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
+
