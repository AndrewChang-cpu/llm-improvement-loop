@@ -1151,6 +1151,23 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the title of the terminal window (if supported by the terminal).
+
+        Note that Rich does not restore the previous title on exit, and the shell,
+        prompt, or terminal may overwrite the title afterwards.
+
+        Args:
+            title (str): The new window title. Control characters are removed.
+
+        Returns:
+            bool: True if the control code was written.
+        """
+        if self.is_terminal and not self.legacy_windows:
+            self.control(Control.title(title))
+            return True
+        return False
+
