+def test_set_window_title():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, legacy_windows=False, _environ={}
+    )
+    assert console.set_window_title("My App")
+    assert console.file.getvalue() == "\x1b]0;My App\x07"
+
+
+def test_set_window_title_not_terminal():
+    console = Console(file=io.StringIO(), force_terminal=False, _environ={})
+    assert not console.set_window_title("My App")
+    assert console.file.getvalue() == ""
+
+
 def test_clear():
     console = Console(file=io.StringIO(), force_terminal=True, _environ={})
     console.clear()
