diff --git a/tests/test_console.py b/tests/test_console.py
index 4a5536c..24d23dd 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -976,3 +976,20 @@ def test_reset_height():
     expected = "╭──────────────────╮\n│ ╭──────────────╮ │\n│ │ foo          │ │\n│ ╰──────────────╯ │\n│ ╭──────────────╮ │\n│ │ bar          │ │\n│ ╰──────────────╯ │\n│                  │\n│                  │\n│                  │\n│                  │\n╰──────────────────╯\n"
 
     assert result == expected
+
+
+def test_set_window_title():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        legacy_windows=False,
+        _environ={"TERM": "xterm-256color"},
+    )
+    assert console.set_window_title("Hello") is True
+    assert console.file.getvalue() == "\x1b]0;Hello\x07"
+
+
+def test_set_window_title_not_terminal():
+    console = Console(file=io.StringIO(), force_terminal=False)
+    assert console.set_window_title("Hello") is False
+    assert console.file.getvalue() == ""
