 }
 
 
@@ -139,6 +142,20 @@ class Control:
         """Show or hide the cursor."""
         return cls(ControlType.SHOW_CURSOR if show else ControlType.HIDE_CURSOR)
 
+    @classmethod
+    def title(cls, title: str) -> "Control":
+        """Set the terminal window title.
+
+        Args:
+            title (str): The new window title. Control characters are removed
+                so they cannot terminate the escape sequence early.
+
+        Returns:
+            ~Control: Control object.
+        """
+        safe_title = strip_control_codes(title, _TITLE_TRANSLATE)
+        return cls(ControlType.SET_WINDOW_TITLE, safe_title)
+
     @classmethod
