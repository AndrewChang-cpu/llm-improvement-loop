@@ -1151,6 +1151,23 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the title of the terminal window (if supported by the terminal).
+
+        Note that the title is not reset when your application exits, and the shell,
+        terminal, or other software may overwrite it.
+
+        Args:
+            title (str): The new window title.
+
+        Returns:
+            bool: True if the control codes were written.
+        """
+        if self.is_terminal and not self.legacy_windows:
+            self.control(Control.title(title))
+            return True
+        return False
+
