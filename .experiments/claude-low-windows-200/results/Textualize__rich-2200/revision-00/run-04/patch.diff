+++ b/rich/console.py
@@ -1046,6 +1046,17 @@ class Console:
         """Play a 'bell' sound (if supported by the terminal)."""
         self.control(Control.bell())
 
+    def set_window_title(self, title: str) -> None:
+        """Set the title of the terminal window (if supported by the terminal).
+
+        Note that Rich cannot restore the previous title, so the title set here
+        persists after the application exits, unless the shell or terminal resets it.
+
+        Args:
+            title (str): The new window title.
+        """
+        self.control(Control.title(title))
+
