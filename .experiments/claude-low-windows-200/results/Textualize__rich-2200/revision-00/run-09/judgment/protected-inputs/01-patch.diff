@@ -63,6 +64,23 @@ class Control:
         """Move cursor to 'home' position."""
         return cls(ControlType.HOME)
 
+    @classmethod
+    def title(cls, title: str) -> "Control":
+        """Set the terminal window title.
+
+        Terminals that do not support this will ignore it. Control characters
+        (such as BEL and ESC) are removed from the title so it cannot terminate
+        the escape sequence early.
+
+        Args:
+            title (str): New window title.
+
+        Returns:
+            ~Control: Control object.
+        """
+        safe_title = "".join(char for char in title if char.isprintable())
+        return cls((ControlType.SET_WINDOW_TITLE, safe_title))
+
