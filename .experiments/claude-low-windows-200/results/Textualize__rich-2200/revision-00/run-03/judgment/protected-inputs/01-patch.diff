+def test_control_title():
+    control = Control.title("Hello")
+    assert control.segment == Segment(
+        "\x1b]0;Hello\x07", None, [(ControlType.SET_WINDOW_TITLE, "Hello")]
+    )
+
+
+def test_control_title_strips_control_characters():
+    control = Control.title("evil\x07title\x1b[31m")
+    assert str(control) == "\x1b]0;eviltitle[31m\x07"
+
+
 def test_strip_control_codes():
