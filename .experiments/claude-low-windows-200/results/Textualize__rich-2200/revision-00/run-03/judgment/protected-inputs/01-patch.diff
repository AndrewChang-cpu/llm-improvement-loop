+    @classmethod
+    def title(cls, title: str) -> "Control":
+        """Set the terminal window title.
+
+        Control characters (such as escape and bell) are removed from the title
+        so that it cannot terminate the OSC sequence early or inject other codes.
+
+        Args:
+            title (str): The new terminal window title.
+
+        Returns:
+            ~Control: Control object.
+        """
+        return cls((ControlType.SET_WINDOW_TITLE, _strip_title_controls(title)))
