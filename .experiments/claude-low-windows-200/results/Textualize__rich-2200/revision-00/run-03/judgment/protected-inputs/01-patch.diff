+++ b/rich/console.py
@@ -1046,6 +1046,29 @@ class Console:
         """Play a 'bell' sound (if supported by the terminal)."""
         self.control(Control.bell())
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the title of the terminal window (if supported).
+
+        Warning:
+            There is no means within Rich of "resetting" the window title to its
+            previous value, meaning the title you set will persist even after your
+            application exits. Some shells reset the title for you, but many do not.
+
+            Some terminals require configuration before they allow the title to be
+            set, and some do not support it at all. Other software (the shell, custom
+            prompts, plugins, etc.) may overwrite the title after you set it.
+
+        Args:
+            title (str): The new terminal window title.
+
+        Returns:
+            bool: True if the control codes were written, otherwise False.
+        """
+        if self.is_terminal and not self.legacy_windows:
+            self.control(Control.title(title))
+            return True
+        return False
+
