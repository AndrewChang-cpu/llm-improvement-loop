+def test_time_elapsed_column():
+    clock = MockClock(auto=False)
+    progress = Progress(
+        console=Console(file=io.StringIO()), auto_refresh=False, get_time=clock
+    )
+    column = TimeElapsedColumn()
+    progress.add_task("foo", total=10, start=False)
+    task = progress.tasks[0]
+
+    # Unstarted: placeholder
+    assert str(column(task)) == "-:--:--"
+
+    # Running: live elapsed time
+    progress.start_task(0)
+    clock.tick(65)
+    assert str(column(task)) == "0:01:05"
+
+    # Finished: value frozen at the time of the finishing advance
+    clock.tick(5)
+    progress.advance(0, 10)
+    clock.tick(100)
+    assert str(column(task)) == "0:01:10"
+
+
