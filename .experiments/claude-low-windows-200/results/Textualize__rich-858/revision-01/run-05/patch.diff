+def test_time_elapsed_column():
+    current_time = 1.0
+
+    def get_time():
+        return current_time
+
+    column = TimeElapsedColumn()
+    task = Task(TaskID(1), "test", 100, 20, _get_time=get_time)
+
+    # Unstarted: placeholder
+    text = column(task)
+    assert str(text) == "-:--:--"
+
+    # Running: live elapsed, whole seconds
+    task.start_time = 1.0
+    current_time = 3.5
+    text = column(task)
+    assert str(text) == "0:00:02"
+
+    # Finished: frozen at the captured value, even though the clock has advanced
+    task.completed = 100
+    task.finished_time = 4.0
+    current_time = 60.0
+    text = column(task)
+    assert str(text) == "0:00:04"
+
