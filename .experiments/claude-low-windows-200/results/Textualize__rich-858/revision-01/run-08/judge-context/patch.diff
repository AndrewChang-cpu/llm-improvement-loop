+def test_time_elapsed_column():
+    clock = MockClock(time=0.0, auto=False)
+    column = TimeElapsedColumn()
+    task = Task(1, "test", 100, 20, _get_time=clock)
+
+    # Unstarted
+    text = column.render(task)
+    assert str(text) == "-:--:--"
+
+    # Running
+    task.start_time = clock()
+    clock.tick(5)
+    text = column.render(task)
+    assert str(text) == "0:00:05"
+
+    # Finished: value stays frozen at the finished time
+    task.completed = 100
+    task.finished_time = 7.0
+    clock.tick(10)
+    text = column.render(task)
+    assert str(text) == "0:00:07"
+
