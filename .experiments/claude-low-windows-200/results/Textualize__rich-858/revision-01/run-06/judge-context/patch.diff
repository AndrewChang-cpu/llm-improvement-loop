+def test_time_elapsed_column():
+    column = TimeElapsedColumn()
+    clock = MockClock(auto=False)
+
+    # Unstarted task shows the placeholder
+    task = Task(1, "test", 100, 20, _get_time=clock)
+    assert str(column(task)) == "-:--:--"
+
+    # Running task shows live elapsed time
+    task.start_time = 0.0
+    clock.time = 12.5
+    assert str(column(task)) == "0:00:12"
+
+    # Finished task keeps the value captured when it finished
+    task.finished_time = 10.0
+    clock.time = 50.0
+    assert str(column(task)) == "0:00:10"
+
+
