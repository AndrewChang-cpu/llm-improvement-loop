+def test_time_elapsed_column():
+    current_time = 0.0
+
+    def get_time() -> float:
+        return current_time
+
+    column = TimeElapsedColumn()
+    task = Task(TaskID(1), "test", 100, 20, _get_time=get_time)
+
+    # Unstarted task shows the placeholder
+    text = column(task)
+    assert str(text) == "-:--:--"
+    assert text.style == "progress.elapsed"
+
+    # Running task shows live elapsed time, truncated to whole seconds
+    task.start_time = 0.0
+    current_time = 10.5
+    text = column(task)
+    assert str(text) == "0:00:10"
+
+    # Finished task shows the frozen finished time, even as the clock advances
+    task.completed = 100
+    task.finished_time = 10.0
+    current_time = 3600.0
+    text = column(task)
+    assert str(text) == "0:00:10"
+
+
