+def test_time_elapsed_column():
+    column = TimeElapsedColumn()
+    current_time = 1.0
+
+    def get_time() -> float:
+        return current_time
+
+    task = Task(TaskID(1), "test", 100, 20, _get_time=get_time)
+    # Unstarted: placeholder
+    assert str(column(task)) == "-:--:--"
+
+    # Running: live elapsed time
+    task.start_time = 1.0
+    current_time = 5.5
+    assert str(column(task)) == "0:00:04"
+
+    # Finished: value is frozen at the finished time
+    task.finished_time = 7.0
+    assert task.finished
+    current_time = 100.0
+    assert str(column(task)) == "0:00:07"
+
