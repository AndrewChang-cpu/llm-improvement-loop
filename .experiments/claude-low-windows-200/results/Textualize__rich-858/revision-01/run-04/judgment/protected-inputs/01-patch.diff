+def test_time_elapsed_column():
+    current_time = 1.0
+
+    def get_time():
+        return current_time
+
+    column = TimeElapsedColumn()
+    task = Task(1, "test", 100, 20, _get_time=get_time)
+    text = column(task)
+    assert str(text) == "-:--:--"
+
+    task.start_time = 1.0
+    current_time = 5.5
+    text = column(task)
+    assert str(text) == "0:00:04"
+
+    task.completed = 100
+    current_time = 11.0
+    task.finished_time = task.elapsed
+    current_time = 20.0
+    text = column(task)
+    assert str(text) == "0:00:10"
+
