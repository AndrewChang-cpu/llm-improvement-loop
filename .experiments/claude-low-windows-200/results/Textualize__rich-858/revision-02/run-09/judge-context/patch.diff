@@ -79,6 +80,32 @@ def test_time_remaining_column():
     assert str(text) == "0:01:00"
 
 
+def test_time_elapsed_column():
+    current_time = 1.0
+
+    def get_time() -> float:
+        return current_time
+
+    column = TimeElapsedColumn()
+    task = Task(TaskID(1), "test", 100, 20, _get_time=get_time)
+
+    # Unstarted: placeholder
+    text = column(task)
+    assert str(text) == "-:--:--"
+
+    # Running: live elapsed time
+    task.start_time = 1.0
+    current_time = 11.0
+    text = column(task)
+    assert str(text) == "0:00:10"
+
+    # Finished: value frozen at the finish time
+    task.finished_time = 10.0
+    current_time = 100.0
+    text = column(task)
+    assert str(text) == "0:00:10"
+
