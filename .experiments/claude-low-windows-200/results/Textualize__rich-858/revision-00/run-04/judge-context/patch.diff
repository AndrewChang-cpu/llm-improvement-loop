+def test_time_elapsed_column() -> None:
+    column = TimeElapsedColumn()
+    task = Task(TaskID(0), "foo", 100, 0, _get_time=lambda: 5.0)
+    # Not started yet
+    assert column.render(task) == Text("-:--:--", style="progress.elapsed")
+    task.start_time = 0.0
+    assert column.render(task) == Text("0:00:05", style="progress.elapsed")
+
