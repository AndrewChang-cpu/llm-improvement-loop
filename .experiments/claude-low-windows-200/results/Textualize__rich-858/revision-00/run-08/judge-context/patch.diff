+def test_time_elapsed_column():
+    class FakeTask(Task):
+        elapsed = 3725.9
+
+    column = TimeElapsedColumn()
+    task = Task(1, "test", 100, 20, _get_time=lambda: 1.0)
+    text = column(task)
+    assert str(text) == "-:--:--"
+
+    text = column(FakeTask(1, "test", 100, 20, _get_time=lambda: 1.0))
+    assert str(text) == "1:02:05"
