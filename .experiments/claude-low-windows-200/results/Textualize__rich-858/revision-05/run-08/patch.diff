     _TrackThread,
@@ -79,6 +80,32 @@ def test_time_remaining_column():
     assert str(text) == "0:01:00"
 
 
+def test_time_elapsed_column():
+    clock = [0.0]
+    progress = Progress(auto_refresh=False, get_time=lambda: clock[0])
+    task_id = progress.add_task("test", total=10, start=False)
+    column = TimeElapsedColumn()
+
+    # Unstarted
+    text = column(progress.tasks[0])
+    assert str(text) == "-:--:--"
+
+    # Running
+    progress.start_task(task_id)
+    clock[0] = 5.5
+    text = column(progress.tasks[0])
+    assert str(text) == "0:00:05"
+
+    progress.advance(task_id, 4)
+    clock[0] = 10.0
+    progress.advance(task_id, 6)  # reaches total at elapsed 10.0
+
+    # Finished: value frozen at the finish time
+    clock[0] = 25.0
+    text = column(progress.tasks[0])
+    assert str(text) == "0:00:10"
+
+
