@@ -0,0 +1,167 @@
+"""Tests for the Databricks OAuth profile mapping."""
+
+from unittest.mock import patch
+
+import pytest
+from airflow.models.connection import Connection
+
+from cosmos.profiles import get_automatic_profile_mapping
+from cosmos.profiles.databricks import (
+    DatabricksOauthProfileMapping,
+    DatabricksTokenProfileMapping,
+)
+
+
+@pytest.fixture()
+def mock_databricks_oauth_conn():  # type: ignore
+    """
+    Mocks and returns an Airflow Databricks connection that uses OAuth client credentials in extra.
+    """
+    conn = Connection(
+        conn_id="my_databricks_oauth_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        extra='{"http_path": "my_http_path", "client_id": "my_client_id", "client_secret": "my_client_secret"}',
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        yield conn
+
+
+def test_connection_claiming() -> None:
+    """
+    Tests that the Databricks OAuth profile mapping claims the correct connection type.
+    """
+    # should only claim when:
+    # - conn_type == databricks
+    # and the following exist:
+    # - schema
+    # - host
+    # - http_path
+    # - client_id
+    # - client_secret
+    potential_values = {
+        "conn_type": "databricks",
+        "host": "my_host",
+        "login": "my_client_id",
+        "password": "my_client_secret",
+        "extra": '{"http_path": "my_http_path"}',
+    }
+
+    # if we're missing any of the values, it shouldn't claim
+    for key in potential_values:
+        values = potential_values.copy()
+        del values[key]
+        conn = Connection(**values)  # type: ignore
+
+        print("testing with", values)
+
+        with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+            profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+            assert not profile_mapping.can_claim_connection()
+
+    # also test when there's no schema
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {})
+        assert not profile_mapping.can_claim_connection()
+
+    # if we have them all, it should claim
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert profile_mapping.can_claim_connection()
+
+
+def test_databricks_token_mapping_selected_when_login_and_password_set() -> None:
+    """
+    Tests that a login-plus-password connection is still selected as the token mapping.
+    """
+    conn = Connection(
+        conn_id="my_databricks_token_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        login="my_client_id",
+        password="my_token",
+        extra='{"http_path": "my_http_path"}',
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = get_automatic_profile_mapping(conn.conn_id, {"schema": "my_schema"})
+        assert isinstance(profile_mapping, DatabricksTokenProfileMapping)
+
+
+def test_databricks_oauth_mapping_selected(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that a connection with extra OAuth credentials and no password or token is selected as the OAuth mapping.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        {"schema": "my_schema"},
+    )
+    assert isinstance(profile_mapping, DatabricksOauthProfileMapping)
+
+
+def test_profile(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the profile values get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={"schema": "my_schema"},
+    )
+    profile = profile_mapping.profile
+
+    assert profile["auth_type"] == "oauth"
+    assert profile["client_secret"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}"
+    assert profile["client_id"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}"
+    # host is passed through unchanged
+    assert profile["host"] == "https://my_host"
+    assert profile["http_path"] == "my_http_path"
+    assert "method" not in profile
+
+
+def test_profile_env_vars(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the environment variables get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={"schema": "my_schema"},
+    )
+    env_vars = profile_mapping.env_vars
+    assert set(env_vars.keys()) == {
+        "COSMOS_CONN_DATABRICKS_CLIENT_SECRET",
+        "COSMOS_CONN_DATABRICKS_CLIENT_ID",
+    }
+    assert env_vars["COSMOS_CONN_DATABRICKS_CLIENT_SECRET"] == "my_client_secret"
+
+
+def test_profile_args_cannot_override_auth_or_secrets(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that profile args can override ordinary fields but not auth_type or the secret fields.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={
+            "schema": "my_schema",
+            "auth_type": "token",
+            "client_id": "override_client_id",
+            "client_secret": "override_client_secret",
+            "http_path": "http_path_override",
+        },
+    )
+    profile = profile_mapping.profile
+
+    assert profile["auth_type"] == "oauth"
+    assert profile["client_id"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}"
+    assert profile["client_secret"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}"
+    assert profile["http_path"] == "http_path_override"
