+"""Tests for the Databricks OAuth profile mapping."""
+
+from unittest.mock import patch
+
+import pytest
+from airflow.models.connection import Connection
+
+from cosmos.profiles import get_automatic_profile_mapping
+from cosmos.profiles.databricks import (
+    DatabricksOauthProfileMapping,
+    DatabricksTokenProfileMapping,
+)
+
+
+@pytest.fixture()
+def mock_databricks_oauth_conn():  # type: ignore
+    """
+    Mocks and returns an Airflow Databricks connection that carries OAuth credentials.
+    The client id is in the login field and the client secret is in the extra field.
+    """
+    conn = Connection(
+        conn_id="my_databricks_oauth_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        login="my_client_id",
+        schema="my_schema",
+        extra='{"http_path": "my_http_path", "client_secret": "my_client_secret"}',
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        yield conn
+
+
+def test_connection_claiming() -> None:
+    """
+    Tests that the Databricks OAuth profile mapping claims the correct connection type.
+    """
+    # should only claim when:
+    # - conn_type == databricks
+    # and the following exist:
+    # - schema
+    # - host
+    # - http_path
+    # - client_id
+    # - client_secret
+    potential_values = {
+        "conn_type": "databricks",
+        "host": "my_host",
+        "schema": "my_schema",
+        "login": "my_client_id",
+        "extra": '{"http_path": "my_http_path", "client_secret": "my_client_secret"}',
+    }
+
+    # removing each required input (including every source it can come from) should prevent claiming
+    removals: dict[str, dict[str, str]] = {
+        "host": {"remove": "host"},
+        "schema": {"remove": "schema"},
+        "http_path": {"extra": '{"client_secret": "my_client_secret"}'},
+        "client_id": {"remove": "login"},
+        "client_secret": {"extra": '{"http_path": "my_http_path"}'},
+    }
+    for name, change in removals.items():
+        values = potential_values.copy()
+        if "remove" in change:
+            del values[change["remove"]]
+        else:
+            values["extra"] = change["extra"]
+
+        conn = Connection(**values)  # type: ignore
+
+        print("testing without", name)
+
+        with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+            profile_mapping = DatabricksOauthProfileMapping(conn.conn_id, {})
+            assert not profile_mapping.can_claim_connection()
+
+    # client id supplied only via extra (not login) should still be claimed
+    conn = Connection(
+        conn_id="my_databricks_connection",
+        conn_type="databricks",
+        host="my_host",
+        schema="my_schema",
+        extra='{"http_path": "my_http_path", "client_id": "my_client_id", "client_secret": "my_client_secret"}',
+    )
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn.conn_id, {})
+        assert profile_mapping.can_claim_connection()
+
+    # if we have them all, it should claim
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn.conn_id, {})
+        assert profile_mapping.can_claim_connection()
+
+
+def test_databricks_token_mapping_selected_over_oauth() -> None:
+    """
+    Tests that a connection with login, password, host, schema and http path resolves to the token mapping.
+    """
+    conn = Connection(
+        conn_id="my_databricks_token_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        login="my_client_id",
+        password="my_token",
+        schema="my_schema",
+        extra='{"http_path": "my_http_path"}',
+    )
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = get_automatic_profile_mapping(conn.conn_id, {})
+        assert isinstance(profile_mapping, DatabricksTokenProfileMapping)
+
+
+def test_databricks_oauth_mapping_selected() -> None:
+    """
+    Tests that a connection with extra OAuth credentials and no password or token resolves to the OAuth mapping.
+    """
+    conn = Connection(
+        conn_id="my_databricks_extra_oauth_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        schema="my_schema",
+        extra='{"http_path": "my_http_path", "client_id": "my_client_id", "client_secret": "my_client_secret"}',
+    )
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = get_automatic_profile_mapping(conn.conn_id, {})
+        assert isinstance(profile_mapping, DatabricksOauthProfileMapping)
+
+
+def test_profile_args_and_env_vars(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the profile values and environment variables get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={
+            "catalog": "my_catalog",
+            "threads": 4,
+            "auth_type": "token",
+        },
+    )
+    assert isinstance(profile_mapping, DatabricksOauthProfileMapping)
+
+    assert profile_mapping.profile == {
+        "type": "databricks",
+        "host": "https://my_host",
+        "schema": "my_schema",
+        "http_path": "my_http_path",
+        "catalog": "my_catalog",
+        "threads": 4,
+        "auth_type": "oauth",
+        "client_secret": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}",
+        "client_id": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}",
+    }
+
+    assert profile_mapping.env_vars == {
+        "COSMOS_CONN_DATABRICKS_CLIENT_SECRET": "my_client_secret",
+        "COSMOS_CONN_DATABRICKS_CLIENT_ID": "my_client_id",
+    }
