@@ -0,0 +1,64 @@
+"""Maps Airflow Databricks connections using OAuth (service principal) to dbt profiles."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from ..base import BaseProfileMapping
+
+
+class DatabricksOauthProfileMapping(BaseProfileMapping):
+    """
+    Maps Airflow Databricks connections using OAuth machine-to-machine credentials to dbt profiles.
+
+    The connection must opt in with ``"auth_type": "oauth"`` in its extra JSON. The OAuth client ID is read
+    from the connection login and the OAuth client secret from the connection password. The client secret is
+    stored in an environment variable.
+
+    https://docs.getdbt.com/docs/core/connect-data-platform/databricks-setup
+    https://airflow.apache.org/docs/apache-airflow-providers-databricks/stable/connections/databricks.html
+    """
+
+    airflow_connection_type: str = "databricks"
+    dbt_profile_type: str = "databricks"
+
+    required_fields = [
+        "host",
+        "schema",
+        "http_path",
+        "client_id",
+        "client_secret",
+    ]
+
+    secret_fields = [
+        "client_secret",
+    ]
+
+    airflow_param_mapping = {
+        "host": "host",
+        "schema": "schema",
+        "http_path": "extra.http_path",
+        "client_id": "login",
+        "client_secret": "password",
+    }
+
+    @property
+    def profile(self) -> dict[str, Any | None]:
+        """Generates profile. The client secret is stored in an environment variable."""
+        return {
+            **self.mapped_params,
+            **self.profile_args,
+            "auth_type": "oauth",
+            # client secret should always get set as env var
+            "client_secret": self.get_env_var_format("client_secret"),
+        }
+
+    def can_claim_connection(self) -> bool:
+        """Only claims connections that explicitly opt in to OAuth via ``extra.auth_type``."""
+        if self.conn.extra_dejson.get("auth_type") != "oauth":
+            return False
+        return super().can_claim_connection()
+
+    def transform_host(self, host: str) -> str:
+        """Removes the https:// prefix."""
+        return host.replace("https://", "")
diff --git a/tests/profiles/databricks/test_dbr_oauth.py b/tests/profiles/databricks/test_dbr_oauth.py
