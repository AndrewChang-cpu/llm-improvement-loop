index 0000000..eec5f99
--- /dev/null
+++ b/tests/profiles/databricks/test_dbr_oauth.py
@@ -0,0 +1,139 @@
+"""Tests for the Databricks OAuth profile mapping."""
+
+from unittest.mock import patch
+
+import pytest
+from airflow.models.connection import Connection
+
+from cosmos.profiles import get_automatic_profile_mapping
+from cosmos.profiles.databricks import DatabricksOauthProfileMapping, DatabricksTokenProfileMapping
+
+
+@pytest.fixture()
+def mock_databricks_oauth_conn():  # type: ignore
+    """
+    Mocks and returns an Airflow Databricks connection using OAuth client credentials.
+    """
+    conn = Connection(
+        conn_id="my_databricks_oauth_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        login="my_client_id",
+        password="my_client_secret",
+        extra='{"http_path": "my_http_path"}',
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        yield conn
+
+
+def test_connection_claiming() -> None:
+    """
+    Tests that the Databricks OAuth profile mapping claims the correct connection type.
+    """
+    potential_values = {
+        "conn_type": "databricks",
+        "host": "my_host",
+        "login": "my_client_id",
+        "password": "my_client_secret",
+        "extra": '{"http_path": "my_http_path"}',
+    }
+
+    # if any of the values are missing, it shouldn't claim
+    for key in potential_values:
+        values = potential_values.copy()
+        del values[key]
+        conn = Connection(**values)  # type: ignore
+
+        with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+            profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+            assert not profile_mapping.can_claim_connection()
+
+    # no schema -> no claim
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {})
+        assert not profile_mapping.can_claim_connection()
+
+    # a connection carrying a token should not be claimed by the OAuth mapping
+    token_values = dict(potential_values, extra='{"http_path": "my_http_path", "token": "my_token"}')
+    conn = Connection(**token_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert not profile_mapping.can_claim_connection()
+
+    # all values present -> claim
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert profile_mapping.can_claim_connection()
+
+
+def test_databricks_oauth_mapping_selected(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the OAuth profile mapping is selected for OAuth connections, and not the token one.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        {"schema": "my_schema"},
+    )
+    assert isinstance(profile_mapping, DatabricksOauthProfileMapping)
+    assert not isinstance(profile_mapping, DatabricksTokenProfileMapping)
+
+
+def test_profile_args(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the profile values get set correctly for OAuth.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={
+            "schema": "my_schema",
+            "catalog": "my_catalog",
+            "threads": 4,
+        },
+    )
+    assert profile_mapping.profile == {
+        "type": mock_databricks_oauth_conn.conn_type,
+        "host": "my_host",
+        "auth_type": "oauth",
+        "client_id": "my_client_id",
+        "client_secret": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}",
+        "http_path": "my_http_path",
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "threads": 4,
+    }
+    expected_profile_yml = """example:
+    outputs:
+        cosmos_target:
+            auth_type: oauth
+            catalog: my_catalog
+            client_id: my_client_id
+            client_secret: '{{ env_var(''COSMOS_CONN_DATABRICKS_CLIENT_SECRET'') }}'
+            host: my_host
+            http_path: my_http_path
+            schema: my_schema
+            threads: 4
+            type: databricks
+    target: cosmos_target\n"""
+    assert profile_mapping.get_profile_file_contents("example") == expected_profile_yml
+
+
+def test_profile_env_vars(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the client secret is exposed as an environment variable.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={"schema": "my_schema"},
+    )
+    assert profile_mapping.env_vars == {
+        "COSMOS_CONN_DATABRICKS_CLIENT_SECRET": mock_databricks_oauth_conn.password,
+    }
