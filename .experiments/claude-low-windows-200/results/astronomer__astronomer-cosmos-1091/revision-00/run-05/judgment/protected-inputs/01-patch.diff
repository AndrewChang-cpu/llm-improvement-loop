+"""Tests for the Databricks OAuth profile mapping."""
+
+from unittest.mock import patch
+
+import pytest
+from airflow.models.connection import Connection
+
+from cosmos.profiles import get_automatic_profile_mapping
+from cosmos.profiles.databricks import (
+    DatabricksOauthProfileMapping,
+    DatabricksTokenProfileMapping,
+)
+
+
+@pytest.fixture()
+def mock_databricks_oauth_conn():  # type: ignore
+    """
+    Mocks and returns an Airflow Databricks connection using OAuth client credentials.
+    """
+    conn = Connection(
+        conn_id="my_databricks_oauth_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        login="my_client_id",
+        password="my_client_secret",
+        extra='{"http_path": "my_http_path"}',
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        yield conn
+
+
+def test_connection_claiming() -> None:
+    """
+    Tests that the Databricks OAuth profile mapping claims the correct connection type.
+    """
+    # should only claim when:
+    # - conn_type == databricks
+    # and the following exist:
+    # - schema
+    # - host
+    # - http_path
+    # - login (client id)
+    # - password (client secret)
+    potential_values = {
+        "conn_type": "databricks",
+        "host": "my_host",
+        "login": "my_client_id",
+        "password": "my_client_secret",
+        "extra": '{"http_path": "my_http_path"}',
+    }
+
+    # if we're missing any of the values, it shouldn't claim
+    for key in potential_values:
+        values = potential_values.copy()
+        del values[key]
+        conn = Connection(**values)  # type: ignore
+
+        print("testing with", values)
+
+        with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+            profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+            assert not profile_mapping.can_claim_connection()
+
+    # also test when there's no schema
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {})
+        assert not profile_mapping.can_claim_connection()
+
+    # if we have them all, it should claim
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert profile_mapping.can_claim_connection()
+
+
+def test_token_connection_not_claimed_by_oauth() -> None:
+    """
+    Tests that a token-based connection (no login) is not claimed by the OAuth mapping.
+    """
+    conn = Connection(
+        conn_id="my_databricks_token_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        password="my_token",
+        extra='{"http_path": "my_http_path"}',
+    )
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        oauth_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert not oauth_mapping.can_claim_connection()
+
+        token_mapping = DatabricksTokenProfileMapping(conn, {"schema": "my_schema"})
+        assert token_mapping.can_claim_connection()
+
+
+def test_databricks_oauth_mapping_selected(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the correct profile mapping is selected.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        {"schema": "my_schema"},
+    )
+    assert isinstance(profile_mapping, DatabricksOauthProfileMapping)
+
+
+def test_profile_args(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the profile values get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={
+            "schema": "my_schema",
+            "catalog": "my_catalog",
+            "session_properties": {"legacy_time_parser_policy": "corrected"},
+            "threads": 4,
+        },
+    )
+    assert profile_mapping.profile_args == {
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "session_properties": {"legacy_time_parser_policy": "corrected"},
+        "threads": 4,
+    }
+
+    assert profile_mapping.profile == {
+        "type": mock_databricks_oauth_conn.conn_type,
+        "host": mock_databricks_oauth_conn.host.replace("https://", ""),
+        "auth_type": "oauth",
+        "client_id": mock_databricks_oauth_conn.login,
+        "client_secret": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}",
+        "http_path": mock_databricks_oauth_conn.extra_dejson.get("http_path"),
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "threads": 4,
+        "session_properties": {"legacy_time_parser_policy": "corrected"},
+    }
+    expected_profile_yml = """example:
+    outputs:
+        cosmos_target:
+            auth_type: oauth
+            catalog: my_catalog
+            client_id: my_client_id
+            client_secret: '{{ env_var(''COSMOS_CONN_DATABRICKS_CLIENT_SECRET'') }}'
+            host: my_host
+            http_path: my_http_path
+            schema: my_schema
+            session_properties:
+                legacy_time_parser_policy: corrected
+            threads: 4
+            type: databricks
+    target: cosmos_target\n"""
+    assert profile_mapping.get_profile_file_contents("example") == expected_profile_yml
+
+
+def test_profile_env_vars(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the environment variables get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={"schema": "my_schema"},
+    )
+    assert profile_mapping.env_vars == {
+        "COSMOS_CONN_DATABRICKS_CLIENT_SECRET": mock_databricks_oauth_conn.password,
+    }
