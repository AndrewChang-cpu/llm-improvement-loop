+
+import unittest
+import warnings
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg
+
+
+class TestDeprecated(unittest.TestCase):
+    def test_function_warns_between_since_and_removed(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.6")
+        def f(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(1), 2)
+
+    def test_function_silent_before_since(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.4")
+        def f(x):
+            return x
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            f(1)
+        self.assertEqual(len(w), 0)
+
+    def test_function_raises_after_removed(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.7.0")
+        def f():
+            return 1
+
+        with self.assertRaises(DeprecatedError):
+            f()
+
+    def test_class_warns_on_init(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.6")
+        class C:
+            """doc"""
+
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(C(3).v, 3)
+        self.assertIn("deprecated", C.__doc__)
+
+    def test_class_raises_after_removed(self):
+        @deprecated(removed="0.7", version_val="0.8")
+        class C:
+            pass
+
+        with self.assertRaises(DeprecatedError):
+            C()
+
+    def test_invalid_versions(self):
+        with self.assertRaises(ValueError):
+            deprecated(since="0.8", removed="0.7")
+
+    def test_deprecated_arg_keyword_and_positional(self):
+        @deprecated_arg("old", since="0.5", removed="0.7", new_name="new", version_val="0.6")
+        def f(a, old=None, new=None):
+            return a
+
+        with self.assertWarns(DeprecationWarning):
+            f(1, old=2)
+        with self.assertWarns(DeprecationWarning):
+            f(1, 2)
+
+    def test_deprecated_arg_not_passed_is_silent(self):
+        @deprecated_arg("old", since="0.5", removed="0.7", version_val="0.6")
+        def f(a, old=None):
+            return a
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            f(1)
+        self.assertEqual(len(w), 0)
+
+    def test_deprecated_arg_raises_after_removed(self):
+        @deprecated_arg("old", removed="0.7", version_val="0.7")
+        def f(a, old=None):
+            return a
+
+        with self.assertRaises(DeprecatedError):
+            f(1, old=2)
+
+
+if __name__ == "__main__":
+    unittest.main()
