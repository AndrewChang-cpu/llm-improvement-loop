+# limitations under the License.
+
+import unittest
+import warnings
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg
+from monai.utils.deprecate_utils import version_leq
+
+
+class TestDeprecated(unittest.TestCase):
+    def test_version_leq(self):
+        self.assertTrue(version_leq("0.1", "0.2"))
+        self.assertTrue(version_leq("0.2", "0.2"))
+        self.assertFalse(version_leq("0.3", "0.2"))
+        self.assertTrue(version_leq("0.6", "0.6.0.1"))
+        self.assertTrue(version_leq("0.5.9", "0.6.0+12.gabc"))
+
+    def test_func_warns_after_since(self):
+        @deprecated(since="0.1", removed="0.3", version_val="0.2")
+        def foo(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(foo(1), 2)
+
+    def test_func_no_warning_before_since(self):
+        @deprecated(since="0.3", removed="0.4", version_val="0.2")
+        def foo(x):
+            return x + 1
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(foo(1), 2)
+        self.assertEqual(len(w), 0)
+
+    def test_removed_raises(self):
+        with self.assertRaises(DeprecatedError):
+
+            @deprecated(since="0.1", removed="0.2", version_val="0.2")
+            def foo():
+                pass
+
+    def test_class_warns_on_init(self):
+        @deprecated(since="0.1", removed="0.3", version_val="0.2")
+        class Foo:
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(Foo(3).v, 3)
+
+    def test_method_warns(self):
+        class Foo:
+            @deprecated(since="0.1", version_val="0.2")
+            def bar(self):
+                return 5
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(Foo().bar(), 5)
+
+    def test_invalid_versions(self):
+        with self.assertRaises(ValueError):
+            deprecated(since="0.3", removed="0.2")
+
+
+class TestDeprecatedArg(unittest.TestCase):
+    def test_kwarg_warns(self):
+        @deprecated_arg(name="old", since="0.1", removed="0.3", version_val="0.2", new_name="new")
+        def foo(new=None, old=None):
+            return new, old
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(foo(old=1), (None, 1))
+
+    def test_positional_warns(self):
+        @deprecated_arg(name="old", since="0.1", version_val="0.2")
+        def foo(new=None, old=None):
+            return new, old
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(foo(1, 2), (1, 2))
+
+    def test_not_supplied_no_warning(self):
+        @deprecated_arg(name="old", since="0.1", version_val="0.2")
+        def foo(new=None, old=None):
+            return new, old
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(foo(new=3), (3, None))
+        self.assertEqual(len(w), 0)
+
+    def test_before_since_no_warning(self):
+        @deprecated_arg(name="old", since="0.3", version_val="0.2")
+        def foo(old=None):
+            return old
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            foo(old=1)
+        self.assertEqual(len(w), 0)
+
+    def test_removed_raises(self):
+        with self.assertRaises(DeprecatedError):
+
+            @deprecated_arg(name="old", since="0.1", removed="0.2", version_val="0.2")
+            def foo(old=None):
+                return old
+
+
+if __name__ == "__main__":
+    unittest.main()
