+"""
+Decorators for marking functions, methods, classes and arguments as deprecated.
+
+The MONAI version (``monai.__version__`` by default) decides the behaviour:
+
+* once the version reaches ``since``, using the object issues a ``DeprecationWarning``;
+* once the version reaches ``removed``, the decorator raises ``DeprecatedError``
+  (at decoration time, so the deprecated object cannot be defined any more).
+"""
+
+import inspect
+import warnings
+from functools import wraps
+from typing import Any, Callable, Optional, Tuple, Type, TypeVar, Union
+
+from monai import __version__
+
+__all__ = ["DeprecatedError", "deprecated", "deprecated_arg", "version_leq"]
+
+T = TypeVar("T")
+
+
+class DeprecatedError(Exception):
+    """Raised when a deprecated object has reached its removal version."""
+
+
+def _version_tuple(version: str) -> Tuple[int, ...]:
+    """Convert a version string such as ``"0.6.0+12.gabc"`` to a tuple of leading integers."""
+    parts = []
+    for component in str(version).split("+")[0].split("."):
+        digits = ""
+        for ch in component:
+            if not ch.isdigit():
+                break
+            digits += ch
+        if digits == "":
+            break
+        parts.append(int(digits))
+    return tuple(parts)
+
+
+def version_leq(version_a: str, version_b: str) -> bool:
+    """Return True if ``version_a <= version_b``, comparing numeric components (missing components count as 0)."""
+    a, b = _version_tuple(version_a), _version_tuple(version_b)
+    n = max(len(a), len(b))
+    a = a + (0,) * (n - len(a))
+    b = b + (0,) * (n - len(b))
+    return a <= b
+
+
+def _msg(kind: str, name: str, since: Optional[str], removed: Optional[str], msg_suffix: str) -> str:
+    msg = f"{kind} '{name}' has been deprecated"
+    if since is not None:
+        msg += f" since version {since}"
+    if removed is not None:
+        msg += f" and will be removed in version {removed}"
+    msg += "."
+    if msg_suffix:
+        msg += f" {msg_suffix}"
+    return msg
+
+
+def _check_versions(since: Optional[str], removed: Optional[str]) -> None:
+    if since is not None and removed is not None and not version_leq(since, removed):
+        raise ValueError(f"since version {since} must not be later than removed version {removed}.")
+
+
+def _is_reached(version: Optional[str], version_val: str) -> bool:
+    return version is not None and version_leq(version, version_val)
+
+
+def deprecated(
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    version_val: str = __version__,
+    warning_category: Type[Warning] = DeprecationWarning,
+) -> Callable[[T], T]:
+    """
+    Decorator to mark a function, method or class as deprecated.
+
+    Args:
+        since: version at which the object was deprecated. Calls issue ``warning_category`` once this is reached.
+        removed: version at which the object is removed. If ``version_val`` has reached it, decorating raises
+            ``DeprecatedError``.
+        msg_suffix: additional message appended to the warning.
+        version_val: version used for the comparisons, defaults to ``monai.__version__``.
+        warning_category: category of the emitted warning.
+    """
+    _check_versions(since, removed)
+
+    def _decorator(obj: T) -> T:
+        kind = "Class" if inspect.isclass(obj) else "Function"
+        name = getattr(obj, "__qualname__", getattr(obj, "__name__", repr(obj)))
+        if _is_reached(removed, version_val):
+            raise DeprecatedError(_msg(kind, name, since, removed, msg_suffix) + " It has been removed.")
+        if not _is_reached(since, version_val):
+            return obj
+        msg = _msg(kind, name, since, removed, msg_suffix)
+
+        if inspect.isclass(obj):
+            original_init = obj.__init__  # type: ignore
+
+            @wraps(original_init)
+            def __init__(self, *args, **kwargs):  # type: ignore
+                warnings.warn(msg, category=warning_category, stacklevel=2)
+                original_init(self, *args, **kwargs)
+
+            obj.__init__ = __init__  # type: ignore
+            return obj
+
+        @wraps(obj)  # type: ignore
+        def _wrapper(*args, **kwargs):
+            warnings.warn(msg, category=warning_category, stacklevel=2)
+            return obj(*args, **kwargs)  # type: ignore
+
+        return _wrapper  # type: ignore
+
+    return _decorator
+
+
+def deprecated_arg(
+    name: str,
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    version_val: str = __version__,
+    new_name: Optional[str] = None,
+    warning_category: Type[Warning] = DeprecationWarning,
+) -> Callable[[Callable], Callable]:
+    """
+    Decorator to mark a single argument of a callable as deprecated.
+
+    If the argument ``name`` is supplied (by keyword or position) once ``since`` has been reached, a
+    ``warning_category`` warning is issued. If ``removed`` has been reached when decorating, ``DeprecatedError``
+    is raised.
+
+    Args:
+        name: name of the deprecated argument.
+        since: version at which the argument was deprecated.
+        removed: version at which the argument is removed.
+        msg_suffix: additional message appended to the warning.
+        version_val: version used for the comparisons, defaults to ``monai.__version__``.
+        new_name: name of the replacement argument, mentioned in the warning if given.
+        warning_category: category of the emitted warning.
+    """
+    _check_versions(since, removed)
+
+    def _decorator(func: Callable) -> Callable:
+        arg_label = f"argument '{name}'"
+        if _is_reached(removed, version_val):
+            raise DeprecatedError(
+                _msg("Function", getattr(func, "__qualname__", repr(func)), since, removed, msg_suffix)
+                + f" The {arg_label} has been removed."
+            )
+        if not _is_reached(since, version_val):
+            return func
+
+        msg = _msg("Function", getattr(func, "__qualname__", repr(func)), since, removed, msg_suffix)
+        msg = msg.replace("Function", f"The {arg_label} of function", 1)
+        if new_name is not None:
+            msg += f" Please use '{new_name}' instead."
+
+        try:
+            signature = inspect.signature(func)
+        except (TypeError, ValueError):
+            signature = None
+
+        @wraps(func)
+        def _wrapper(*args, **kwargs):
+            supplied = name in kwargs
+            if not supplied and signature is not None:
+                try:
+                    supplied = name in signature.bind_partial(*args, **kwargs).arguments
+                except TypeError:
+                    supplied = False
+            if supplied:
+                warnings.warn(msg, category=warning_category, stacklevel=2)
+            return func(*args, **kwargs)
+
+        return _wrapper
+
+    return _decorator
