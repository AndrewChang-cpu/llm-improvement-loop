+import unittest
+import warnings
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg
+
+
+class TestDeprecatedFunction(unittest.TestCase):
+    def test_warns_after_since(self):
+        @deprecated(since="0.5", removed="0.8", version_val="0.6")
+        def f(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning) as cm:
+            self.assertEqual(f(1), 2)
+        self.assertIn("since version 0.5", str(cm.warning))
+        self.assertIn("removed in version 0.8", str(cm.warning))
+
+    def test_no_warning_before_since(self):
+        @deprecated(since="0.7", version_val="0.6")
+        def f(x):
+            return x
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(3), 3)
+        self.assertEqual(len(w), 0)
+
+    def test_raises_after_removed(self):
+        @deprecated(since="0.5", removed="0.6", version_val="0.6.0")
+        def f():
+            return 1
+
+        with self.assertRaises(DeprecatedError):
+            f()
+
+    def test_msg_suffix(self):
+        @deprecated(since="0.5", version_val="0.6", msg_suffix="Use g instead.")
+        def h():
+            pass
+
+        with self.assertWarns(DeprecationWarning) as cm:
+            h()
+        self.assertTrue(str(cm.warning).endswith("Use g instead."))
+
+    def test_preserves_metadata(self):
+        @deprecated(since="0.5", version_val="0.6")
+        def f():
+            """doc"""
+
+        self.assertEqual(f.__name__, "f")
+        self.assertEqual(f.__doc__, "doc")
+
+    def test_invalid_versions(self):
+        with self.assertRaises(ValueError):
+            deprecated()
+        with self.assertRaises(ValueError):
+            deprecated(since="0.6", removed="0.5")
+
+
+class TestDeprecatedClass(unittest.TestCase):
+    def test_class_warns_on_init(self):
+        @deprecated(since="0.5", version_val="0.6")
+        class C:
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            c = C(4)
+        self.assertEqual(c.v, 4)
+
+    def test_class_raises_after_removed(self):
+        @deprecated(since="0.4", removed="0.5", version_val="0.5")
+        class C:
+            pass
+
+        with self.assertRaises(DeprecatedError):
+            C()
+
+    def test_class_no_warning_before_since(self):
+        @deprecated(since="0.7", version_val="0.6")
+        class C:
+            pass
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            C()
+        self.assertEqual(len(w), 0)
+
+
+class TestDeprecatedArg(unittest.TestCase):
+    def test_keyword_warns(self):
+        @deprecated_arg("old", since="0.5", version_val="0.6", new_name="new")
+        def f(new=None, old=None):
+            return new, old
+
+        with self.assertWarns(DeprecationWarning) as cm:
+            self.assertEqual(f(old=2), (None, 2))
+        self.assertIn("`new`", str(cm.warning))
+
+    def test_positional_warns(self):
+        @deprecated_arg("b", since="0.5", version_val="0.6")
+        def f(a, b=None):
+            return a, b
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(1, 2), (1, 2))
+
+    def test_not_supplied_no_warning(self):
+        @deprecated_arg("b", since="0.5", version_val="0.6")
+        def f(a, b=None):
+            return a, b
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(1), (1, None))
+        self.assertEqual(len(w), 0)
+
+    def test_raises_after_removed(self):
+        @deprecated_arg("b", since="0.4", removed="0.5", version_val="0.5")
+        def f(a, b=None):
+            return a
+
+        with self.assertRaises(DeprecatedError):
+            f(1, b=2)
+        self.assertEqual(f(1), 1)
+
+    def test_no_warning_before_since(self):
+        @deprecated_arg("b", since="0.7", version_val="0.6")
+        def f(a, b=None):
+            return a
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            f(1, b=2)
+        self.assertEqual(len(w), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
