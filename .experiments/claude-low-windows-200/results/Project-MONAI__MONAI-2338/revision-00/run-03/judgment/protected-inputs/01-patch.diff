+"""
+Decorators for marking functions, methods, classes and function arguments as deprecated.
+
+An object is considered deprecated from version ``since`` onwards, and removed from version ``removed`` onwards. Using a
+deprecated object at a MONAI version ``v`` issues a ``DeprecationWarning`` when ``since <= v < removed``, and raises
+``DeprecatedError`` when ``v >= removed``. Versions are compared using their numeric components (e.g. "0.6" or "0.6.1").
+"""
+
+import functools
+import re
+import warnings
+from typing import Any, Callable, Optional, Tuple
+
+import monai
+
+__all__ = ["DeprecatedError", "deprecated", "deprecated_arg"]
+
+
+class DeprecatedError(Exception):
+    """Raised when a deprecated object is used at or after its removal version."""
+
+
+def _parse_version(ver: Optional[str]) -> Optional[Tuple[int, ...]]:
+    """Convert a version string such as "0.6.1" or "0.6.0+3.gabc" into a tuple of ints, or None if `ver` is None."""
+    if ver is None:
+        return None
+    parts = []
+    for p in str(ver).split("+")[0].split("."):
+        m = re.match(r"\d+", p)
+        if m is None:
+            break
+        parts.append(int(m.group(0)))
+    return tuple(parts) if parts else (0,)
+
+
+def _check_deprecation(
+    name: str, since: Optional[str], removed: Optional[str], msg_suffix: str, version_val: str, kind: str
+) -> None:
+    """Issue a warning or raise an error for `name` depending on the current `version_val`."""
+    cur = _parse_version(version_val)
+    since_v = _parse_version(since)
+    removed_v = _parse_version(removed)
+    if removed_v is not None and cur is not None and cur >= removed_v:
+        raise DeprecatedError(
+            f"{kind} '{name}' was removed in version {removed} (current version {version_val}). {msg_suffix}".rstrip()
+        )
+    if since_v is not None and cur is not None and cur >= since_v:
+        msg = f"{kind} '{name}' has been deprecated since version {since}"
+        if removed is not None:
+            msg += f" and will be removed in version {removed}"
+        msg += f". {msg_suffix}" if msg_suffix else "."
+        warnings.warn(msg, category=DeprecationWarning, stacklevel=3)
+
+
+def deprecated(
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    version_val: str = monai.__version__,
+) -> Callable:
+    """
+    Decorator to mark a function, method or class as deprecated. Calling it (or instantiating it, for classes) issues a
+    `DeprecationWarning` for versions in ``[since, removed)`` and raises `DeprecatedError` for versions ``>= removed``.
+
+    Args:
+        since: version in which the object was deprecated.
+        removed: version in which the object is removed.
+        msg_suffix: additional message appended to the warning or error.
+        version_val: version used for the comparison, defaults to `monai.__version__`.
+    """
+    if since is None and removed is None:
+        raise ValueError("at least one of `since` or `removed` must be specified.")
+
+    def _decorator(obj: Any) -> Any:
+        kind = "Class" if isinstance(obj, type) else "Function"
+        name = getattr(obj, "__qualname__", getattr(obj, "__name__", repr(obj)))
+
+        if isinstance(obj, type):
+            orig_init = obj.__init__
+
+            @functools.wraps(orig_init)
+            def __init__(self, *args, **kwargs):
+                _check_deprecation(name, since, removed, msg_suffix, version_val, kind)
+                orig_init(self, *args, **kwargs)
+
+            obj.__init__ = __init__
+            return obj
+
+        @functools.wraps(obj)
+        def _wrapper(*args, **kwargs):
+            _check_deprecation(name, since, removed, msg_suffix, version_val, kind)
+            return obj(*args, **kwargs)
+
+        return _wrapper
+
+    return _decorator
+
+
+def deprecated_arg(
+    name: str,
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    version_val: str = monai.__version__,
+) -> Callable:
+    """
+    Decorator to mark the argument `name` of a callable as deprecated. If the argument is passed explicitly to the
+    callable, a `DeprecationWarning` is issued for versions in ``[since, removed)`` and `DeprecatedError` is raised for
+    versions ``>= removed``.
+
+    Args:
+        name: name of the deprecated argument.
+        since: version in which the argument was deprecated.
+        removed: version in which the argument is removed.
+        msg_suffix: additional message appended to the warning or error.
+        version_val: version used for the comparison, defaults to `monai.__version__`.
+    """
+    if since is None and removed is None:
+        raise ValueError("at least one of `since` or `removed` must be specified.")
+
+    def _decorator(func: Callable) -> Callable:
+        @functools.wraps(func)
+        def _wrapper(*args, **kwargs):
+            if name in kwargs:
+                _check_deprecation(
+                    f"argument '{name}' of {getattr(func, '__qualname__', func)}",
+                    since,
+                    removed,
+                    msg_suffix,
+                    version_val,
+                    "Argument",
+                )
+            return func(*args, **kwargs)
+
+        return _wrapper
+
+    return _decorator
