+import unittest
+import warnings
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg
+
+
+class TestDeprecated(unittest.TestCase):
+    def test_function_warns_in_range(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.6")
+        def f(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(1), 2)
+
+    def test_function_no_warning_before_since(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.4")
+        def f(x):
+            return x
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            f(1)
+        self.assertEqual(len(w), 0)
+
+    def test_function_raises_after_removed(self):
+        @deprecated(since="0.5", removed="0.6", version_val="0.6.1")
+        def f():
+            return 1
+
+        with self.assertRaises(DeprecatedError):
+            f()
+
+    def test_class_warns_on_init(self):
+        @deprecated(since="0.5", version_val="0.5")
+        class C:
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(C(3).v, 3)
+
+    def test_class_raises_on_init(self):
+        @deprecated(removed="0.5", version_val="0.5")
+        class C:
+            pass
+
+        with self.assertRaises(DeprecatedError):
+            C()
+
+    def test_deprecated_arg(self):
+        @deprecated_arg("old", since="0.5", removed="0.7", version_val="0.6")
+        def f(new=1, old=None):
+            return new
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(old=3), 1)
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            f(new=2)
+        self.assertEqual(len(w), 0)
+
+    def test_deprecated_arg_removed(self):
+        @deprecated_arg("old", removed="0.6", version_val="0.6")
+        def f(old=None):
+            return old
+
+        with self.assertRaises(DeprecatedError):
+            f(old=1)
+
+    def test_requires_version(self):
+        with self.assertRaises(ValueError):
+            deprecated()
+
+
+if __name__ == "__main__":
+    unittest.main()
