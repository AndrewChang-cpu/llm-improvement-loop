+# limitations under the License.
+
+import unittest
+import warnings
+from unittest import mock
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg, version_leq
+
+
+def _with_version(version):
+    return mock.patch("monai.utils.deprecate_utils._current_version", return_value=version)
+
+
+class TestVersionLeq(unittest.TestCase):
+    def test_compare(self):
+        self.assertTrue(version_leq("0.5.3", "0.6.0"))
+        self.assertTrue(version_leq("0.6", "0.6.0"))
+        self.assertTrue(version_leq("0.6.0", "0.6.0"))
+        self.assertFalse(version_leq("0.10.0", "0.9.9"))
+        self.assertTrue(version_leq("0.6.0+12.gabc", "0.6.1"))
+
+
+class TestDeprecated(unittest.TestCase):
+    def test_function_warns_after_since(self):
+        @deprecated(since="0.5")
+        def f(x):
+            return x + 1
+
+        with _with_version("0.6.0"), warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(1), 2)
+        self.assertEqual(len(w), 1)
+        self.assertTrue(issubclass(w[0].category, DeprecationWarning))
+        self.assertIn("deprecated in version 0.5", str(w[0].message))
+
+    def test_function_silent_before_since(self):
+        @deprecated(since="0.7")
+        def f(x):
+            return x
+
+        with _with_version("0.6.0"), warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(3), 3)
+        self.assertEqual(len(w), 0)
+
+    def test_function_raises_after_removed(self):
+        @deprecated(since="0.4", removed="0.6")
+        def f():
+            return 1
+
+        with _with_version("0.6.0"):
+            with self.assertRaises(DeprecatedError):
+                f()
+        with _with_version("0.5.0"), warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(), 1)
+        self.assertEqual(len(w), 1)
+        self.assertIn("will be removed in version 0.6", str(w[0].message))
+
+    def test_msg_suffix_and_docstring(self):
+        @deprecated(since="0.5", msg_suffix="Use g instead.")
+        def f():
+            """Doc."""
+
+        self.assertIn("deprecated:: 0.5", f.__doc__)
+        with _with_version("0.6.0"), warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            f()
+        self.assertIn("Use g instead.", str(w[0].message))
+
+    def test_class(self):
+        @deprecated(since="0.5", removed="0.7")
+        class C:
+            def __init__(self, v):
+                self.v = v
+
+        with _with_version("0.6.0"), warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(C(4).v, 4)
+        self.assertEqual(len(w), 1)
+        self.assertIn("Class `C`", str(w[0].message))
+        with _with_version("0.7.0"):
+            with self.assertRaises(DeprecatedError):
+                C(1)
+
+    def test_requires_version(self):
+        with self.assertRaises(ValueError):
+            deprecated()
+
+
+class TestDeprecatedArg(unittest.TestCase):
+    def _make(self):
+        @deprecated_arg("old", since="0.5", removed="0.7")
+        def f(a, old=None):
+            return a
+
+        return f
+
+    def test_keyword_warns(self):
+        f = self._make()
+        with _with_version("0.6.0"), warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(1, old=2), 1)
+        self.assertEqual(len(w), 1)
+        self.assertIn("Argument `old`", str(w[0].message))
+
+    def test_positional_warns(self):
+        f = self._make()
+        with _with_version("0.6.0"), warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            f(1, 2)
+        self.assertEqual(len(w), 1)
+
+    def test_default_not_warned(self):
+        f = self._make()
+        with _with_version("0.6.0"), warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(5), 5)
+        self.assertEqual(len(w), 0)
+
+    def test_raises_after_removed(self):
+        f = self._make()
+        with _with_version("0.7.0"):
+            with self.assertRaises(DeprecatedError):
+                f(1, old=2)
+            self.assertEqual(f(1), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
