+"""
+Decorators to mark functions, methods, classes and arguments as deprecated.
+
+Each decorator takes a ``since`` and/or ``removed`` MONAI version. When the current MONAI version (or ``version_val``)
+is at or beyond ``removed``, the decorated object raises ``DeprecatedError`` when used. Otherwise, when it is at or
+beyond ``since``, a ``DeprecationWarning`` is issued. Before ``since`` nothing is reported.
+"""
+
+from __future__ import annotations
+
+import inspect
+import re
+import warnings
+from functools import wraps
+from typing import Any, Callable, Optional, Tuple
+
+from monai import __version__
+
+__all__ = ["DeprecatedError", "deprecated", "deprecated_arg"]
+
+
+class DeprecatedError(Exception):
+    """Raised when a deprecated object is used at or after its removal version."""
+
+
+def _version_tuple(version: str) -> Tuple[int, ...]:
+    """Convert a version string such as ``"0.5.3+12.g1234"`` into a tuple of ints, ignoring non-numeric suffixes."""
+    parts = []
+    for part in str(version).split("+")[0].split(".")[:3]:
+        match = re.match(r"\d+", part)
+        if match is None:
+            break
+        parts.append(int(match.group(0)))
+    return tuple(parts) if parts else (0,)
+
+
+def _is_at_or_after(current: str, target: Optional[str]) -> bool:
+    """Return True if version ``current`` is greater than or equal to ``target``."""
+    if target is None:
+        return False
+    return _version_tuple(current) >= _version_tuple(target)
+
+
+def _check(
+    name: str, since: Optional[str], removed: Optional[str], msg_suffix: str, version_val: str, kind: str
+) -> None:
+    """Warn or raise according to the current version relative to ``since`` and ``removed``."""
+    if _is_at_or_after(version_val, removed):
+        msg = f"{kind} `{name}` was removed in MONAI version {removed}."
+        raise DeprecatedError(f"{msg} {msg_suffix}".strip())
+    if _is_at_or_after(version_val, since):
+        msg = f"{kind} `{name}` was deprecated in MONAI version {since}"
+        if removed is not None:
+            msg += f" and will be removed in version {removed}"
+        msg += "."
+        warnings.warn(f"{msg} {msg_suffix}".strip(), DeprecationWarning, stacklevel=3)
+
+
+def _validate(since: Optional[str], removed: Optional[str]) -> None:
+    if since is None and removed is None:
+        raise ValueError("at least one of `since` or `removed` must be specified.")
+
+
+def deprecated(
+    since: Optional[str] = None, removed: Optional[str] = None, msg_suffix: str = "", version_val: str = __version__
+) -> Callable:
+    """
+    Decorator to mark a function or class as deprecated.
+
+    Args:
+        since: version at which the object was deprecated; a warning is issued from this version onwards.
+        removed: version at which the object is removed; ``DeprecatedError`` is raised from this version onwards.
+        msg_suffix: message appended to the warning or error.
+        version_val: version to compare against, defaults to ``monai.__version__``.
+
+    For classes, the check is performed when the class is instantiated.
+    """
+    _validate(since, removed)
+
+    def _decorator(obj: Any) -> Any:
+        is_func = inspect.isfunction(obj)
+        kind = "Function" if is_func else "Class"
+        name = obj.__name__
+
+        if is_func:
+
+            @wraps(obj)
+            def _wrapper(*args, **kwargs):
+                _check(name, since, removed, msg_suffix, version_val, kind)
+                return obj(*args, **kwargs)
+
+            return _wrapper
+
+        if not inspect.isclass(obj):
+            raise TypeError(f"`deprecated` can only be applied to functions or classes, got {type(obj)}.")
+
+        original_init = obj.__init__
+
+        @wraps(original_init)
+        def _init(self, *args, **kwargs):
+            _check(name, since, removed, msg_suffix, version_val, kind)
+            original_init(self, *args, **kwargs)
+
+        obj.__init__ = _init  # type: ignore
+        return obj
+
+    return _decorator
+
+
+def deprecated_arg(
+    name: str,
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    version_val: str = __version__,
+) -> Callable:
+    """
+    Decorator to mark a single argument of a callable as deprecated.
+
+    The check is only performed when the caller supplies the argument (by keyword or position).
+
+    Args:
+        name: name of the deprecated argument.
+        since: version at which the argument was deprecated; a warning is issued from this version onwards.
+        removed: version at which the argument is removed; ``DeprecatedError`` is raised from this version onwards.
+        msg_suffix: message appended to the warning or error.
+        version_val: version to compare against, defaults to ``monai.__version__``.
+    """
+    _validate(since, removed)
+
+    def _decorator(func: Callable) -> Callable:
+        try:
+            signature = inspect.signature(func)
+        except (TypeError, ValueError):
+            signature = None
+
+        @wraps(func)
+        def _wrapper(*args, **kwargs):
+            supplied = name in kwargs
+            if not supplied and signature is not None:
+                try:
+                    supplied = name in signature.bind_partial(*args, **kwargs).arguments
+                except TypeError:
+                    supplied = False
+            if supplied:
+                _check(name, since, removed, msg_suffix, version_val, "Argument")
+            return func(*args, **kwargs)
+
+        return _wrapper
+
+    return _decorator
