+# limitations under the License.
+
+import unittest
+import warnings
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg
+
+
+class TestDeprecated(unittest.TestCase):
+    def test_function_warning(self):
+        @deprecated(since="0.1", removed="99.0", version_val="0.2")
+        def f(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(1), 2)
+
+    def test_function_not_yet_deprecated(self):
+        @deprecated(since="99.0", removed="100.0")
+        def f(x):
+            return x
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(3), 3)
+        self.assertEqual(len(w), 0)
+
+    def test_function_removed(self):
+        @deprecated(removed="0.1", version_val="0.5")
+        def f():
+            return 1
+
+        with self.assertRaises(DeprecatedError):
+            f()
+
+    def test_class_warning_and_removed(self):
+        @deprecated(since="0.1", version_val="0.2")
+        class C:
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(C(2).v, 2)
+
+        @deprecated(removed="0.2", version_val="0.2")
+        class D:
+            pass
+
+        with self.assertRaises(DeprecatedError):
+            D()
+
+    def test_arg(self):
+        @deprecated_arg("old", since="0.1", removed="99.0", version_val="0.2")
+        def f(a, old=None):
+            return a
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(1), 1)
+            self.assertEqual(len(w), 0)
+        with self.assertWarns(DeprecationWarning):
+            f(1, old=2)
+        with self.assertWarns(DeprecationWarning):
+            f(1, 2)
+
+    def test_arg_removed(self):
+        @deprecated_arg("old", removed="0.1", version_val="0.2")
+        def f(a, old=None):
+            return a
+
+        self.assertEqual(f(5), 5)
+        with self.assertRaises(DeprecatedError):
+            f(5, old=1)
+
+    def test_no_version_raises(self):
+        with self.assertRaises(ValueError):
+            deprecated()
+
+
+if __name__ == "__main__":
+    unittest.main()
