+"""
+Decorators for marking functions, methods, classes and arguments as deprecated.
+
+The MONAI version (``monai.__version__``) is compared against the ``since`` and ``removed`` versions given to the
+decorators: once the current version is at or past ``removed`` a ``DeprecatedError`` is raised when the object is
+used, otherwise once it is at or past ``since`` a ``DeprecationWarning`` is issued.
+"""
+
+import functools
+import inspect
+import re
+import warnings
+from typing import Any, Callable, Optional, Tuple
+
+__all__ = ["DeprecatedError", "deprecated", "deprecated_arg"]
+
+
+class DeprecatedError(Exception):
+    """Raised when a deprecated feature has reached its removal version."""
+
+
+def _version_tuple(version: str) -> Tuple[int, ...]:
+    """Extract the leading numeric components of a version string, e.g. "0.5.1+3" -> (0, 5, 1)."""
+    m = re.match(r"^\s*v?(\d+(?:\.\d+)*)", str(version))
+    if m is None:
+        return (0,)
+    return tuple(int(p) for p in m.group(1).split("."))
+
+
+def _version_leq(v1: str, v2: str) -> bool:
+    """Return True if version ``v1`` <= version ``v2``, padding the shorter one with zeros."""
+    t1, t2 = _version_tuple(v1), _version_tuple(v2)
+    n = max(len(t1), len(t2))
+    t1 = t1 + (0,) * (n - len(t1))
+    t2 = t2 + (0,) * (n - len(t2))
+    return t1 <= t2
+
+
+def _current_version(version_val: Optional[str]) -> str:
+    if version_val is not None:
+        return version_val
+    import monai  # local import to avoid a circular import at package load time
+
+    return monai.__version__
+
+
+def _check_status(obj_name: str, since: Optional[str], removed: Optional[str], msg_suffix: str, version_val):
+    """
+    Raise ``DeprecatedError`` if ``removed`` has been reached, or warn with ``DeprecationWarning`` if ``since`` has
+    been reached. Does nothing if the object is not yet deprecated for the current version.
+    """
+    current = _current_version(version_val)
+    suffix = f" {msg_suffix}" if msg_suffix else ""
+    if removed is not None and _version_leq(removed, current):
+        raise DeprecatedError(f"{obj_name} was removed in version {removed}.{suffix}")
+    if since is not None and _version_leq(since, current):
+        msg = f"{obj_name} has been deprecated since version {since}"
+        if removed is not None:
+            msg += f" and will be removed in version {removed}"
+        warnings.warn(msg + "." + suffix, category=DeprecationWarning, stacklevel=3)
+
+
+def _docstring_note(doc: Optional[str], since: Optional[str], removed: Optional[str], msg_suffix: str) -> str:
+    note = "\n\n.. deprecated:: "
+    note += f"{since}" if since is not None else ""
+    if removed is not None:
+        note += f"\n    Will be removed in version {removed}."
+    if msg_suffix:
+        note += f" {msg_suffix}"
+    return (doc or "") + note
+
+
+def deprecated(
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    version_val: Optional[str] = None,
+) -> Callable:
+    """
+    Decorator to mark a function, method or class as deprecated.
+
+    Args:
+        since: version at which the object was deprecated (a warning is issued from this version on).
+        removed: version at which the object is removed (a ``DeprecatedError`` is raised from this version on).
+        msg_suffix: additional message appended to the warning or error.
+        version_val: version string to compare against instead of ``monai.__version__`` (mainly for testing).
+
+    Returns:
+        decorator which wraps the object so that using it checks the deprecation status.
+    """
+
+    def decorator(obj):
+        if inspect.isclass(obj):
+            original_init = obj.__init__
+            obj_name = f"Class {obj.__qualname__}"
+
+            @functools.wraps(original_init)
+            def __init__(self, *args, **kwargs):
+                _check_status(obj_name, since, removed, msg_suffix, version_val)
+                original_init(self, *args, **kwargs)
+
+            obj.__init__ = __init__
+            obj.__doc__ = _docstring_note(obj.__doc__, since, removed, msg_suffix)
+            return obj
+
+        obj_name = f"Function {obj.__qualname__}"
+
+        @functools.wraps(obj)
+        def wrapper(*args, **kwargs):
+            _check_status(obj_name, since, removed, msg_suffix, version_val)
+            return obj(*args, **kwargs)
+
+        wrapper.__doc__ = _docstring_note(obj.__doc__, since, removed, msg_suffix)
+        return wrapper
+
+    return decorator
+
+
+def deprecated_arg(
+    name: str,
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    new_name: Optional[str] = None,
+    version_val: Optional[str] = None,
+) -> Callable:
+    """
+    Decorator to mark a particular argument of a callable as deprecated.
+
+    The argument is considered used when it is explicitly passed by the caller (positionally or by keyword).
+
+    Args:
+        name: name of the deprecated argument.
+        since: version at which the argument was deprecated (a warning is issued from this version on).
+        removed: version at which the argument is removed (a ``DeprecatedError`` is raised from this version on).
+        msg_suffix: additional message appended to the warning or error.
+        new_name: name of the replacement argument, if any, mentioned in the message.
+        version_val: version string to compare against instead of ``monai.__version__`` (mainly for testing).
+
+    Returns:
+        decorator which wraps the callable so that passing the argument checks the deprecation status.
+    """
+
+    def decorator(func):
+        try:
+            signature = inspect.signature(func)
+        except (TypeError, ValueError):
+            signature = None
+        obj_name = f"Argument '{name}' of {func.__qualname__}"
+        suffix = msg_suffix
+        if new_name is not None:
+            suffix = f"Please use '{new_name}' instead. {suffix}".strip()
+
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            used = name in kwargs
+            if not used and signature is not None:
+                try:
+                    used = name in signature.bind_partial(*args, **kwargs).arguments
+                except TypeError:
+                    used = False
+            if used:
+                _check_status(obj_name, since, removed, suffix, version_val)
+            return func(*args, **kwargs)
+
+        arg_note = f"\n\n.. deprecated:: {since or ''}\n    Argument ``{name}`` is deprecated."
+        if removed is not None:
+            arg_note += f" Will be removed in version {removed}."
+        wrapper.__doc__ = (func.__doc__ or "") + arg_note
+        return wrapper
+
+    return decorator
