+
+import unittest
+import warnings
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg
+
+
+class TestDeprecatedFunction(unittest.TestCase):
+    def test_not_yet_deprecated(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.4")
+        def f(x):
+            return x + 1
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(1), 2)
+        self.assertEqual(len(w), 0)
+
+    def test_warning(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.6")
+        def f(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(1), 2)
+
+    def test_removed_raises(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.7.0")
+        def f(x):
+            return x + 1
+
+        with self.assertRaises(DeprecatedError):
+            f(1)
+
+    def test_docstring_and_name_preserved(self):
+        @deprecated(since="0.5", version_val="0.1")
+        def f(x):
+            """Doc."""
+            return x
+
+        self.assertEqual(f.__name__, "f")
+        self.assertIn("deprecated:: 0.5", f.__doc__)
+
+
+class TestDeprecatedClass(unittest.TestCase):
+    def test_warning_on_init(self):
+        @deprecated(since="0.5", removed="0.7", version_val="0.5")
+        class C:
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            c = C(3)
+        self.assertEqual(c.v, 3)
+
+    def test_removed_raises_on_init(self):
+        @deprecated(since="0.5", removed="0.7", version_val="1.0")
+        class C:
+            pass
+
+        with self.assertRaises(DeprecatedError):
+            C()
+
+
+class TestDeprecatedArg(unittest.TestCase):
+    def test_unused_arg_no_warning(self):
+        @deprecated_arg("old", since="0.5", removed="0.7", version_val="0.6")
+        def f(x, old=None):
+            return x
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(1), 1)
+        self.assertEqual(len(w), 0)
+
+    def test_keyword_warning(self):
+        @deprecated_arg("old", since="0.5", removed="0.7", new_name="new", version_val="0.6")
+        def f(x, old=None, new=None):
+            return x
+
+        with self.assertWarns(DeprecationWarning):
+            f(1, old=2)
+
+    def test_positional_warning(self):
+        @deprecated_arg("old", since="0.5", version_val="0.6")
+        def f(x, old=None):
+            return x
+
+        with self.assertWarns(DeprecationWarning):
+            f(1, 2)
+
+    def test_removed_raises(self):
+        @deprecated_arg("old", since="0.5", removed="0.7", version_val="0.8")
+        def f(x, old=None):
+            return x
+
+        with self.assertRaises(DeprecatedError):
+            f(1, old=2)
+
+
+if __name__ == "__main__":
+    unittest.main()
