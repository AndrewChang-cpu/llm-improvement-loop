+"""
+Decorators for marking functions, methods, classes and arguments as deprecated.
+
+The MONAI version (``monai.__version__``) is compared against the ``since`` and ``removed`` versions:
+once the current version reaches ``removed``, a ``DeprecatedError`` is raised; otherwise, if ``since``
+has been reached (or is not given), a ``DeprecationWarning`` is issued.
+"""
+
+import inspect
+import re
+import warnings
+from functools import wraps
+from types import FunctionType
+from typing import Any, Callable, Optional, Tuple
+
+import monai
+
+__all__ = ["DeprecatedError", "deprecated", "deprecated_arg"]
+
+
+class DeprecatedError(Exception):
+    """Raised when a deprecated feature is used after its removal version."""
+
+
+def _parse_version(version: str) -> Tuple[int, ...]:
+    """
+    Parse the leading numeric components of a version string, e.g. "0.6.0rc1" -> (0, 6, 0).
+    Non-numeric version strings (such as "0+unknown") are parsed up to the first non-numeric part.
+    """
+    parts = []
+    for part in str(version).split("+")[0].split("."):
+        m = re.match(r"^(\d+)", part)
+        if m is None:
+            break
+        parts.append(int(m.group(1)))
+        if m.group(1) != part:
+            break
+    return tuple(parts) if parts else (0,)
+
+
+def _version_reached(current: str, target: str) -> bool:
+    """Return True if version `current` is greater than or equal to `target`."""
+    a, b = _parse_version(current), _parse_version(target)
+    n = max(len(a), len(b))
+    return a + (0,) * (n - len(a)) >= b + (0,) * (n - len(b))
+
+
+def _current_version() -> str:
+    return monai.__version__
+
+
+def warn_deprecated(obj: Any, msg: str) -> None:
+    """Issue a `DeprecationWarning` with message `msg`, attributed to the caller of the deprecated object."""
+    warnings.warn(msg, category=DeprecationWarning, stacklevel=4)
+
+
+def _check_and_warn(
+    name: str, since: Optional[str], removed: Optional[str], msg_suffix: str, version_val: Optional[str]
+) -> None:
+    current = _current_version() if version_val is None else version_val
+    if removed is not None and _version_reached(current, removed):
+        raise DeprecatedError(f"{name} was removed in version {removed}, current version is {current}. {msg_suffix}")
+    if since is not None:
+        msg = f"{name} has been deprecated since version {since}"
+    else:
+        msg = f"{name} is deprecated"
+    if removed is not None:
+        msg += f" and will be removed in version {removed}"
+    msg += f". {msg_suffix}".rstrip()
+    warn_deprecated(name, msg.strip())
+
+
+def deprecated(
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    version_val: Optional[str] = None,
+) -> Callable:
+    """
+    Decorator to mark a function, method or class as deprecated.
+
+    Args:
+        since: version in which the object was deprecated.
+        removed: version in which the object is (or will be) removed. If the current MONAI version is at or
+            beyond this version, calling the object raises `DeprecatedError`.
+        msg_suffix: additional message appended to the warning or error.
+        version_val: version to compare against instead of ``monai.__version__`` (mainly for testing).
+
+    Returns:
+        decorator that wraps functions, or replaces ``__init__`` of classes, with the deprecation check.
+    """
+
+    def _decorator(obj: Any) -> Any:
+        is_func = isinstance(obj, FunctionType)
+        call_obj = obj if is_func else obj.__init__
+        kind = "Function" if is_func else "Class"
+        name = f"{kind} `{obj.__name__}`"
+
+        @wraps(call_obj)
+        def _wrapper(*args, **kwargs):
+            _check_and_warn(name, since, removed, msg_suffix, version_val)
+            return call_obj(*args, **kwargs)
+
+        if is_func:
+            return _wrapper
+        obj.__init__ = _wrapper
+        return obj
+
+    return _decorator
+
+
+def deprecated_arg(
+    name: str,
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    new_name: Optional[str] = None,
+    version_val: Optional[str] = None,
+) -> Callable:
+    """
+    Decorator to mark a single argument of a callable as deprecated.
+
+    If the deprecated argument is supplied (by keyword, or positionally when it is a named parameter),
+    a `DeprecationWarning` is issued, or `DeprecatedError` if the removal version has been reached.
+
+    Args:
+        name: name of the deprecated argument.
+        since: version in which the argument was deprecated.
+        removed: version in which the argument is removed.
+        msg_suffix: additional message appended to the warning or error.
+        new_name: name of the replacement argument, mentioned in the message if given.
+        version_val: version to compare against instead of ``monai.__version__`` (mainly for testing).
+    """
+
+    def _decorator(func: Callable) -> Callable:
+        try:
+            sig_params = inspect.signature(func).parameters
+            positional = [
+                p.name
+                for p in sig_params.values()
+                if p.kind in (inspect.Parameter.POSITIONAL_ONLY, inspect.Parameter.POSITIONAL_OR_KEYWORD)
+            ]
+        except (TypeError, ValueError):
+            positional = []
+        pos_index = positional.index(name) if name in positional else None
+
+        @wraps(func)
+        def _wrapper(*args, **kwargs):
+            supplied = name in kwargs or (pos_index is not None and len(args) > pos_index)
+            if supplied:
+                msg_name = f"Argument `{name}`"
+                if new_name is not None:
+                    msg_name += f" (replaced by `{new_name}`)"
+                _check_and_warn(f"{msg_name} of `{func.__name__}`", since, removed, msg_suffix, version_val)
+            return func(*args, **kwargs)
+
+        return _wrapper
+
+    return _decorator
