+# limitations under the License.
+
+import unittest
+import warnings
+
+from parameterized import parameterized
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg
+
+
+class TestDeprecated(unittest.TestCase):
+    @parameterized.expand([("0.1.0", "0.2.0", "0.1.5"), ("0.1.0", None, "0.5.0")])
+    def test_warning_function(self, since, removed, version):
+        @deprecated(since=since, removed=removed, version_val=version)
+        def _func(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning) as cm:
+            self.assertEqual(_func(1), 2)
+        self.assertIn("`_func`", str(cm.warning))
+        self.assertIn(since, str(cm.warning))
+        self.assertEqual(cm.filename, __file__)
+
+    def test_error_function(self):
+        @deprecated(since="0.1.0", removed="0.2.0", version_val="0.2.0")
+        def _func(x):
+            return x
+
+        with self.assertRaises(DeprecatedError):
+            _func(1)
+
+    def test_warning_class(self):
+        @deprecated(since="0.1.0", removed="0.3.0", version_val="0.2.0")
+        class _Cls:
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            obj = _Cls(3)
+        self.assertEqual(obj.v, 3)
+
+    def test_error_class(self):
+        @deprecated(since="0.1.0", removed="0.2.0", version_val="0.3.0")
+        class _Cls:
+            def __init__(self):
+                pass
+
+        with self.assertRaises(DeprecatedError):
+            _Cls()
+
+    def test_no_warning_before_since_reached_for_removed_only(self):
+        @deprecated(removed="0.5.0", version_val="0.1.0")
+        def _func():
+            return 1
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(_func(), 1)
+        self.assertTrue(any(issubclass(x.category, DeprecationWarning) for x in w))
+
+    def test_deprecated_arg(self):
+        @deprecated_arg("old", since="0.1.0", removed="0.3.0", new_name="new", version_val="0.2.0")
+        def _func(new=None, old=None):
+            return new, old
+
+        with self.assertWarns(DeprecationWarning) as cm:
+            self.assertEqual(_func(old=5), (None, 5))
+        self.assertIn("`old`", str(cm.warning))
+        self.assertIn("`new`", str(cm.warning))
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(_func(new=4), (4, None))
+        self.assertEqual(len(w), 0)
+
+    def test_deprecated_arg_positional(self):
+        @deprecated_arg("b", since="0.1.0", removed="0.2.0", version_val="0.1.0")
+        def _func(a, b=None):
+            return a, b
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(_func(1, 2), (1, 2))
+
+    def test_deprecated_arg_error(self):
+        @deprecated_arg("old", since="0.1.0", removed="0.2.0", version_val="0.2.0")
+        def _func(old=None):
+            return old
+
+        with self.assertRaises(DeprecatedError):
+            _func(old=1)
+        self.assertIsNone(_func())
+
+
+if __name__ == "__main__":
+    unittest.main()
