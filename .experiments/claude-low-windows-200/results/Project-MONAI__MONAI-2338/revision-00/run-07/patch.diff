+import unittest
+import warnings
+
+from parameterized import parameterized
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg, version_leq
+
+
+class TestDeprecated(unittest.TestCase):
+    @parameterized.expand([("0.1", "0.2", "0.1"), ("0.1", None, "0.5"), ("0.1", "0.2", "0.1.5")])
+    def test_warns_in_range(self, since, removed, version):
+        @deprecated(since=since, removed=removed, version_val=version)
+        def _f(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(_f(1), 2)
+
+    def test_no_warning_before_since(self):
+        @deprecated(since="0.2", removed="0.4", version_val="0.1")
+        def _f(x):
+            return x
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(_f(3), 3)
+        self.assertEqual(len(w), 0)
+
+    def test_raises_after_removed(self):
+        @deprecated(since="0.1", removed="0.2", version_val="0.2")
+        def _f():
+            return 1
+
+        with self.assertRaises(DeprecatedError):
+            _f()
+
+    def test_class(self):
+        @deprecated(since="0.1", removed="0.3", version_val="0.2")
+        class _C:
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(_C(4).v, 4)
+
+        @deprecated(since="0.1", removed="0.2", version_val="0.2")
+        class _D:
+            pass
+
+        with self.assertRaises(DeprecatedError):
+            _D()
+
+    def test_method(self):
+        class _M:
+            @deprecated(since="0.1", version_val="0.1")
+            def m(self, x):
+                return x * 2
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(_M().m(3), 6)
+
+
+class TestDeprecatedArg(unittest.TestCase):
+    @parameterized.expand([(dict(old=1),), ({"old": 1, "x": 2},)])
+    def test_warns_when_passed(self, kwargs):
+        @deprecated_arg("old", since="0.1", removed="0.3", version_val="0.2")
+        def _f(x=0, old=None):
+            return (x, old)
+
+        with self.assertWarns(DeprecationWarning):
+            _f(**kwargs)
+
+    def test_positional_passed(self):
+        @deprecated_arg("old", since="0.1", version_val="0.1")
+        def _f(x, old=None):
+            return x
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(_f(5, 1), 5)
+
+    def test_not_passed_no_warning(self):
+        @deprecated_arg("old", since="0.1", removed="0.3", version_val="0.2")
+        def _f(x=0, old=None):
+            return x
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(_f(x=7), 7)
+        self.assertEqual(len(w), 0)
+
+    def test_raises_when_removed(self):
+        @deprecated_arg("old", since="0.1", removed="0.2", version_val="0.3")
+        def _f(old=None):
+            return old
+
+        with self.assertRaises(DeprecatedError):
+            _f(old=1)
+        self.assertIsNone(_f())
+
+
+class TestVersionLeq(unittest.TestCase):
+    @parameterized.expand(
+        [("0.1", "0.1", True), ("0.1", "0.2", True), ("0.10", "0.9", False), ("0.5", "0.5.0", True), ("1.0.0+3.gab", "1.0.0", True)]
+    )
+    def test_version_leq(self, lhs, rhs, expected):
+        self.assertEqual(version_leq(lhs, rhs), expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
