+"""
+Decorators for marking functions, methods, classes and arguments as deprecated.
+
+The MONAI version (``monai.__version__``) is compared against the ``since`` and ``removed`` version strings:
+once the current version is at or past ``removed``, a ``DeprecatedError`` is raised; once it is at or past
+``since`` (but not yet removed), a ``DeprecationWarning`` is issued. Before ``since`` nothing happens.
+"""
+
+import inspect
+import re
+import warnings
+from functools import wraps
+from typing import Any, Callable, Optional, Tuple
+
+__all__ = ["DeprecatedError", "deprecated", "deprecated_arg", "version_leq"]
+
+
+class DeprecatedError(Exception):
+    """Raised when a deprecated object or argument has passed its removal version."""
+
+
+def _version_tuple(version: str) -> Tuple[int, ...]:
+    """Parse the leading numeric components of a version string, e.g. "0.5.1+12.gabc" -> (0, 5, 1)."""
+    parts = []
+    for piece in str(version).split("+")[0].split("."):
+        m = re.match(r"\d+", piece)
+        if m is None:
+            break
+        parts.append(int(m.group(0)))
+    return tuple(parts)
+
+
+def version_leq(lhs: str, rhs: str) -> bool:
+    """
+    Returns True if version string `lhs` is less than or equal to version string `rhs`.
+    Missing components are treated as zero, so "0.5" equals "0.5.0".
+    """
+    a, b = _version_tuple(lhs), _version_tuple(rhs)
+    n = max(len(a), len(b))
+    a = a + (0,) * (n - len(a))
+    b = b + (0,) * (n - len(b))
+    return a <= b
+
+
+def _current_version() -> str:
+    import monai  # local import to avoid circular imports at package load time
+
+    return monai.__version__
+
+
+def _msg(kind: str, name: str, since: Optional[str], removed: Optional[str], msg_suffix: str) -> str:
+    msg = f"{kind} '{name}' has been deprecated"
+    if since is not None:
+        msg += f" since version {since}"
+    if removed is not None:
+        msg += f" and will be removed in version {removed}"
+    msg += "."
+    if msg_suffix:
+        msg += f" {msg_suffix}"
+    return msg
+
+
+def _check(kind: str, name: str, since: Optional[str], removed: Optional[str], msg_suffix: str, version: str) -> None:
+    """Raise DeprecatedError or warn depending on `version` relative to `since` and `removed`."""
+    if removed is not None and version_leq(removed, version):
+        raise DeprecatedError(_msg(kind, name, since, removed, msg_suffix) + " It has been removed.")
+    if since is None or version_leq(since, version):
+        warnings.warn(_msg(kind, name, since, removed, msg_suffix), category=DeprecationWarning, stacklevel=3)
+
+
+def deprecated(
+    since: Optional[str] = None, removed: Optional[str] = None, msg_suffix: str = "", version_val: Optional[str] = None
+) -> Callable:
+    """
+    Decorator to mark a function, method or class as deprecated.
+
+    Args:
+        since: version at which the object was deprecated.
+        removed: version at which the object is removed; calling it at or after this version raises `DeprecatedError`.
+        msg_suffix: additional message appended to the warning or error.
+        version_val: version string to compare against, defaults to `monai.__version__`.
+    """
+
+    def _decorator(obj: Any) -> Any:
+        kind = "Class" if inspect.isclass(obj) else "Function"
+        name = getattr(obj, "__qualname__", getattr(obj, "__name__", repr(obj)))
+
+        if inspect.isclass(obj):
+            original_init = obj.__init__
+
+            @wraps(original_init)
+            def _init(self, *args, **kwargs):
+                _check(kind, name, since, removed, msg_suffix, version_val or _current_version())
+                return original_init(self, *args, **kwargs)
+
+            obj.__init__ = _init
+            return obj
+
+        @wraps(obj)
+        def _wrapper(*args, **kwargs):
+            _check(kind, name, since, removed, msg_suffix, version_val or _current_version())
+            return obj(*args, **kwargs)
+
+        return _wrapper
+
+    return _decorator
+
+
+def deprecated_arg(
+    name: str,
+    since: Optional[str] = None,
+    removed: Optional[str] = None,
+    msg_suffix: str = "",
+    version_val: Optional[str] = None,
+) -> Callable:
+    """
+    Decorator to mark a single argument of a callable as deprecated. The argument is considered used when it is
+    explicitly passed (positionally or by keyword), regardless of its value.
+
+    Args:
+        name: name of the deprecated argument.
+        since: version at which the argument was deprecated.
+        removed: version at which the argument is removed; passing it at or after this version raises `DeprecatedError`.
+        msg_suffix: additional message appended to the warning or error.
+        version_val: version string to compare against, defaults to `monai.__version__`.
+    """
+
+    def _decorator(func: Callable) -> Callable:
+        sig = inspect.signature(func)
+
+        @wraps(func)
+        def _wrapper(*args, **kwargs):
+            bound = sig.bind_partial(*args, **kwargs).arguments
+            if name in kwargs or name in bound:
+                _check("Argument", name, since, removed, msg_suffix, version_val or _current_version())
+            return func(*args, **kwargs)
+
+        return _wrapper
+
+    return _decorator
