+# limitations under the License.
+
+import unittest
+import warnings
+
+from monai.utils import DeprecatedError, deprecated, deprecated_arg
+
+
+class TestDeprecated(unittest.TestCase):
+    def test_function_warns(self):
+        @deprecated(since="0.1", removed="0.3", version_val="0.2")
+        def f(x):
+            return x + 1
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(1), 2)
+
+    def test_function_active_and_future(self):
+        @deprecated(since="0.3", removed="0.4", version_val="0.2")
+        def f(x):
+            return x
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(3), 3)
+        self.assertEqual(len(w), 0)
+
+    def test_function_removed_raises(self):
+        @deprecated(since="0.1", removed="0.2", version_val="0.2")
+        def f():
+            return 1
+
+        with self.assertRaises(DeprecatedError):
+            f()
+
+    def test_class_warns_on_init(self):
+        @deprecated(since="0.1", version_val="0.1")
+        class C:
+            def __init__(self, v):
+                self.v = v
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(C(5).v, 5)
+
+    def test_class_removed_raises(self):
+        @deprecated(since="0.1", removed="0.2", version_val="0.5")
+        class C:
+            pass
+
+        with self.assertRaises(DeprecatedError):
+            C()
+
+    def test_invalid_versions(self):
+        with self.assertRaises(ValueError):
+            deprecated(since="0.3", removed="0.2")
+
+    def test_version_with_suffix(self):
+        @deprecated(since="0.1", version_val="0.1.0+12.gabc")
+        def f():
+            return 1
+
+        with self.assertWarns(DeprecationWarning):
+            f()
+
+
+class TestDeprecatedArg(unittest.TestCase):
+    def test_keyword_warns(self):
+        @deprecated_arg("old", since="0.1", version_val="0.2", new_name="new")
+        def f(new=None, old=None):
+            return new, old
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(old=3), (None, 3))
+
+    def test_positional_warns(self):
+        @deprecated_arg("old", since="0.1", version_val="0.2")
+        def f(new=None, old=None):
+            return new, old
+
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(f(1, 2), (1, 2))
+
+    def test_not_supplied_no_warning(self):
+        @deprecated_arg("old", since="0.1", version_val="0.2")
+        def f(new=None, old=None):
+            return new, old
+
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(f(new=1), (1, None))
+        self.assertEqual(len(w), 0)
+
+    def test_removed_raises(self):
+        @deprecated_arg("old", since="0.1", removed="0.2", version_val="0.2")
+        def f(old=None):
+            return old
+
+        with self.assertRaises(DeprecatedError):
+            f(old=1)
+        self.assertIsNone(f())
+
+
+if __name__ == "__main__":
+    unittest.main()
