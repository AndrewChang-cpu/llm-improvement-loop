diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..005001f
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,95 @@
+import re
+from json import dumps
+from typing import Any, Callable, Optional
+
+from .text import Text
+
+_JSON_TOKEN = re.compile(
+    r'(?P<str>"(?:\\.|[^"\\])*")(?P<colon>\s*:)?'
+    r"|(?P<number>-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)"
+    r"|(?P<bool>\btrue\b|\bfalse\b)"
+    r"|(?P<null>\bnull\b)"
+)
+
+
+class JSON:
+    """A renderable which pretty prints JSON with syntax highlighting.
+
+    Args:
+        json (str): JSON encoded data.
+        highlight (bool, optional): Enable highlighting of output. Defaults to True.
+    """
+
+    def __init__(self, json: str, *, highlight: bool = True) -> None:
+        self.text = self._highlight(json) if highlight else Text(json)
+
+    @classmethod
+    def from_data(
+        cls,
+        data: Any,
+        *,
+        indent: Optional[Any] = 2,
+        highlight: bool = True,
+        skip_keys: bool = False,
+        ensure_ascii: bool = False,
+        check_circular: bool = True,
+        allow_nan: bool = True,
+        default: Optional[Callable[[Any], Any]] = None,
+        sort_keys: bool = False,
+    ) -> "JSON":
+        """Encode a Python object as JSON and create a renderable from it.
+
+        Args:
+            data (Any): Data to be encoded.
+            indent (Union[None, int, str], optional): Number of spaces to indent. Defaults to 2.
+            highlight (bool, optional): Enable highlighting of output. Defaults to True.
+            skip_keys (bool, optional): Skip keys not of a basic type. Defaults to False.
+            ensure_ascii (bool, optional): Escape all non-ascii characters. Defaults to False.
+            check_circular (bool, optional): Check for circular references. Defaults to True.
+            allow_nan (bool, optional): Allow NaN and Infinity values. Defaults to True.
+            default (Callable, optional): Function to convert non-serializable objects. Defaults to None.
+            sort_keys (bool, optional): Sort dictionary keys. Defaults to False.
+        """
+        json_str = dumps(
+            data,
+            indent=indent,
+            skipkeys=skip_keys,
+            ensure_ascii=ensure_ascii,
+            check_circular=check_circular,
+            allow_nan=allow_nan,
+            default=default,
+            sort_keys=sort_keys,
+        )
+        return cls(json_str, highlight=highlight)
+
+    @staticmethod
+    def _highlight(source: str) -> Text:
+        result = Text()
+        pos = 0
+        for match in _JSON_TOKEN.finditer(source):
+            start, end = match.span()
+            if start > pos:
+                result.append(source[pos:start], "json.brace")
+            if match.group("str") is not None:
+                if match.group("colon"):
+                    result.append(match.group("str"), "json.key")
+                    result.append(match.group("colon"), "json.brace")
+                else:
+                    result.append(match.group("str"), "json.str")
+            elif match.group("number") is not None:
+                result.append(match.group("number"), "json.number")
+            elif match.group("bool") is not None:
+                is_true = match.group("bool") == "true"
+                result.append(
+                    match.group("bool"),
+                    "json.bool_true" if is_true else "json.bool_false",
+                )
+            else:
+                result.append(match.group("null"), "json.null")
+            pos = end
+        if pos < len(source):
+            result.append(source[pos:], "json.brace")
+        return result
+
+    def __rich__(self) -> Text:
+        return self.text
