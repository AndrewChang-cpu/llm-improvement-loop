diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..3783bb0
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,94 @@
+from typing import Any, Callable, Optional
+
+import json as _json
+
+from .highlighter import ReprHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (Union[None, int, str], optional): Number of spaces to indent, or a string to indent with. Defaults to 2.
+        highlight (bool, optional): Enable highlighting of JSON. Defaults to True.
+        skip_keys (bool, optional): Skip keys not of a basic type. Defaults to False.
+        ensure_ascii (bool, optional): Escape all non-ascii characters. Defaults to False.
+        check_circular (bool, optional): Check for circular references. Defaults to True.
+        allow_nan (bool, optional): Allow NaN and Infinity values. Defaults to True.
+        default (Callable, optional): Function to convert non-serializable objects. Defaults to None.
+        sort_keys (bool, optional): Sort dictionary keys. Defaults to False.
+    """
+
+    def __init__(
+        self,
+        json: str,
+        indent: Any = 2,
+        highlight: bool = True,
+        skip_keys: bool = False,
+        ensure_ascii: bool = False,
+        check_circular: bool = True,
+        allow_nan: bool = True,
+        default: Optional[Callable[[Any], Any]] = None,
+        sort_keys: bool = False,
+    ) -> None:
+        data = _json.loads(json)
+        self.text = self._dumps(
+            data,
+            indent=indent,
+            skip_keys=skip_keys,
+            ensure_ascii=ensure_ascii,
+            check_circular=check_circular,
+            allow_nan=allow_nan,
+            default=default,
+            sort_keys=sort_keys,
+        )
+        self.highlight = highlight
+
+    @classmethod
+    def from_data(
+        cls,
+        data: Any,
+        indent: Any = 2,
+        highlight: bool = True,
+        skip_keys: bool = False,
+        ensure_ascii: bool = False,
+        check_circular: bool = True,
+        allow_nan: bool = True,
+        default: Optional[Callable[[Any], Any]] = None,
+        sort_keys: bool = False,
+    ) -> "JSON":
+        """Create a JSON renderable from already decoded Python data."""
+        json_instance = cls.__new__(cls)
+        json_instance.text = cls._dumps(
+            data,
+            indent=indent,
+            skip_keys=skip_keys,
+            ensure_ascii=ensure_ascii,
+            check_circular=check_circular,
+            allow_nan=allow_nan,
+            default=default,
+            sort_keys=sort_keys,
+        )
+        json_instance.highlight = highlight
+        return json_instance
+
+    @staticmethod
+    def _dumps(data: Any, **options: Any) -> str:
+        return _json.dumps(
+            data,
+            indent=options["indent"],
+            skipkeys=options["skip_keys"],
+            ensure_ascii=options["ensure_ascii"],
+            check_circular=options["check_circular"],
+            allow_nan=options["allow_nan"],
+            default=options["default"],
+            sort_keys=options["sort_keys"],
+        )
+
+    def __rich__(self) -> Text:
+        text = Text(self.text)
+        if self.highlight:
+            text = ReprHighlighter()(text)
+        return text
