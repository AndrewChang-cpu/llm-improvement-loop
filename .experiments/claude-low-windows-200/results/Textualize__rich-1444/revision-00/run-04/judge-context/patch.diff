diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..085bc2b
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,96 @@
+from typing import Any, Callable, Optional
+
+import json as _json
+
+from .highlighter import ReprHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (Union[None, int, str], optional): Number of spaces to indent, or a string to indent with. Defaults to 2.
+        highlight (bool, optional): Enable highlighting of output. Defaults to True.
+        sort_keys (bool, optional): Sort dictionary keys. Defaults to False.
+        ensure_ascii (bool, optional): Escape non-ASCII characters. Defaults to False.
+        default (Callable, optional): Function to convert non-JSON-serializable objects. Defaults to None.
+    """
+
+    def __init__(
+        self,
+        json: str,
+        indent: Any = 2,
+        highlight: bool = True,
+        sort_keys: bool = False,
+        ensure_ascii: bool = False,
+        default: Optional[Callable[[Any], Any]] = None,
+    ) -> None:
+        data = _json.loads(json)
+        self.text = self._format(
+            data,
+            indent=indent,
+            highlight=highlight,
+            sort_keys=sort_keys,
+            ensure_ascii=ensure_ascii,
+            default=default,
+        )
+
+    @classmethod
+    def from_data(
+        cls,
+        data: Any,
+        indent: Any = 2,
+        highlight: bool = True,
+        sort_keys: bool = False,
+        ensure_ascii: bool = False,
+        default: Optional[Callable[[Any], Any]] = None,
+    ) -> "JSON":
+        """Encodes a Python object as JSON and returns a renderable.
+
+        Args:
+            data (Any): An object which may be encoded as JSON.
+            indent (Union[None, int, str], optional): Number of spaces to indent, or a string to indent with. Defaults to 2.
+            highlight (bool, optional): Enable highlighting of output. Defaults to True.
+            sort_keys (bool, optional): Sort dictionary keys. Defaults to False.
+            ensure_ascii (bool, optional): Escape non-ASCII characters. Defaults to False.
+            default (Callable, optional): Function to convert non-JSON-serializable objects. Defaults to None.
+
+        Returns:
+            JSON: A renderable.
+        """
+        json_instance: "JSON" = cls.__new__(cls)
+        json_instance.text = cls._format(
+            data,
+            indent=indent,
+            highlight=highlight,
+            sort_keys=sort_keys,
+            ensure_ascii=ensure_ascii,
+            default=default,
+        )
+        return json_instance
+
+    @staticmethod
+    def _format(
+        data: Any,
+        indent: Any,
+        highlight: bool,
+        sort_keys: bool,
+        ensure_ascii: bool,
+        default: Optional[Callable[[Any], Any]],
+    ) -> Text:
+        encoded = _json.dumps(
+            data,
+            indent=indent,
+            sort_keys=sort_keys,
+            ensure_ascii=ensure_ascii,
+            default=default,
+        )
+        text = Text(encoded)
+        if highlight:
+            ReprHighlighter().highlight(text)
+        return text
+
+    def __rich__(self) -> Text:
+        return self.text
