index 0000000..1f7cb2d
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,119 @@
+import re
+from typing import Any, Optional
+
+from .text import Text
+
+# Matches JSON strings (optionally followed by ``:`` making them keys),
+# numbers, booleans and null.
+_JSON_TOKEN_RE = re.compile(
+    r"""
+    (?P<key>"(?:\\.|[^"\\])*"(?=\s*:))
+    |(?P<str>"(?:\\.|[^"\\])*")
+    |(?P<number>-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)
+    |(?P<true>\btrue\b)
+    |(?P<false>\bfalse\b)
+    |(?P<null>\bnull\b)
+    """,
+    re.VERBOSE,
+)
+
+_TOKEN_STYLES = {
+    "key": "json.key",
+    "str": "json.str",
+    "number": "json.number",
+    "true": "json.bool_true",
+    "false": "json.bool_false",
+    "null": "json.null",
+}
+
+
+class JSON:
+    """A renderable which pretty prints JSON with syntax highlighting.
+
+    Args:
+        json (str): A string containing JSON.
+        indent (Union[None, int, str], optional): Number of spaces to indent, or a string to indent with. Defaults to 2.
+        highlight (bool, optional): Enable highlighting of output. Defaults to True.
+        sort_keys (bool, optional): Sort dictionary keys. Defaults to False.
+    """
+
+    def __init__(
+        self,
+        json: str,
+        indent: int = 2,
+        highlight: bool = True,
+        sort_keys: bool = False,
+    ) -> None:
+        import json as _json
+
+        data = _json.loads(json)
+        self.json = json
+        self.data = data
+        self.highlight = highlight
+        self.text = self._build_text(
+            _json.dumps(data, indent=indent, sort_keys=sort_keys),
+            highlight,
+        )
+
+    @classmethod
+    def from_data(
+        cls,
+        data: Any,
+        indent: int = 2,
+        highlight: bool = True,
+        skip_keys: bool = False,
+        ensure_ascii: bool = False,
+        check_circular: bool = True,
+        allow_nan: bool = True,
+        default: Optional[Any] = None,
+        sort_keys: bool = False,
+    ) -> "JSON":
+        """Encodes a Python object as JSON and returns a renderable.
+
+        Args:
+            data (Any): An object which may be encoded as JSON.
+            indent (int, optional): Spaces to indent. Defaults to 2.
+            highlight (bool, optional): Enable highlighting. Defaults to True.
+            skip_keys (bool, optional): Skip keys not of a basic type. Defaults to False.
+            ensure_ascii (bool, optional): Escape non-ASCII characters. Defaults to False.
+            check_circular (bool, optional): Check for circular references. Defaults to True.
+            allow_nan (bool, optional): Allow NaN and Infinity. Defaults to True.
+            default (Callable, optional): Function to convert non-serializable objects. Defaults to None.
+            sort_keys (bool, optional): Sort dictionary keys. Defaults to False.
+
+        Returns:
+            JSON: A renderable.
+        """
+        import json as _json
+
+        encoded = _json.dumps(
+            data,
+            indent=indent,
+            skipkeys=skip_keys,
+            ensure_ascii=ensure_ascii,
+            check_circular=check_circular,
+            allow_nan=allow_nan,
+            default=default,
+            sort_keys=sort_keys,
+        )
+        instance = cls.__new__(cls)
+        instance.json = encoded
+        instance.data = data
+        instance.highlight = highlight
+        instance.text = cls._build_text(encoded, highlight)
+        return instance
+
+    @staticmethod
+    def _build_text(encoded: str, highlight: bool) -> Text:
+        text = Text(encoded)
+        if not highlight:
+            return text
+        for match in _JSON_TOKEN_RE.finditer(encoded):
+            kind = match.lastgroup
+            if kind is None:
+                continue
+            text.stylize(_TOKEN_STYLES[kind], match.start(), match.end())
+        return text
+
+    def __rich__(self) -> Text:
+        return self.text
