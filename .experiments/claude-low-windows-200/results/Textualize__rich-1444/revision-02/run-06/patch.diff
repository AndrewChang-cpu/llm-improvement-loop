+def test_print_json():
+    output = io.StringIO()
+    console = Console(
+        file=output, force_terminal=True, color_system="truecolor", width=80
+    )
+    console.print_json('[false, true, null, "foo"]')
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert output.getvalue() == expected
+
+
