+            r"(?P<number>(?<!\w)\-?[0-9]+(?:\.[0-9]+)?(?:e[\-\+]?[0-9]+)?\b|0x[0-9a-fA-F]+)",
+            r'(?<![\\\w])(?P<str>b?".*?(?<!\\)")',
+        ),
+    ]
+
