+class JSONHighlighter(RegexHighlighter):
+    """Highlights JSON text."""
+
+    base_style = "json."
+    highlights = [
+        _combine_regex(
+            r"(?P<brace>[\{\[\(\)\]\}])",
+            r"(?P<bool_true>\btrue\b)|(?P<bool_false>\bfalse\b)|(?P<null>\bnull\b)",
+            r"(?<!\w)(?P<number>0x[0-9a-fA-F]+|\-?[0-9]+(\.[0-9]+)?(e[\-\+]?[0-9]+)?)",
+            r"(?<![\\\w])(?P<str>b?\".*?(?<!\\)\")",
+        ),
+    ]
+
