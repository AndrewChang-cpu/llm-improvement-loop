diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..150932f
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,49 @@
+import json as _json
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (int, optional): Number of spaces to indent. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of JSON. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = _json.loads(json)
+        json_str = _json.dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        text = highlighter(json_str)
+        text.no_wrap = True
+        text.overflow = "ignore"
+        self.text = text
+
+    def __rich__(self) -> Text:
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument("path", metavar="PATH", help="path to a JSON file")
+    args = parser.parse_args()
+
+    console = Console()
+    try:
+        with open(args.path, "rt") as json_file:
+            json_text = json_file.read()
+    except Exception as error:
+        error_console = Console(stderr=True)
+        error_console.print(f"Unable to read {args.path!r}; {error}", markup=False)
+        sys.exit(-1)
+
+    json_renderable = JSON(json_text)
+    console.print(json_renderable, soft_wrap=True)
