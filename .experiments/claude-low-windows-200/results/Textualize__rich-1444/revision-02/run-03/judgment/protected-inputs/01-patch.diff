+def test_print_json():
+    console = Console(
+        file=io.StringIO(),
+        width=80,
+        color_system="truecolor",
+        _environ={},
+    )
+    console.print_json('[false, true, null, "foo"]')
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    result = console.file.getvalue()
+    assert result == expected
