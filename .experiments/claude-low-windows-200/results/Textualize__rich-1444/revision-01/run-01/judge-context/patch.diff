diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..f98d53f
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,60 @@
+"""Pretty print JSON text with optional syntax highlighting."""
+
+import json as _json
+from typing import Any
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON text to pretty print.
+        indent (int, optional): Number of spaces to indent by. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of the JSON. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = _json.loads(json)
+        json_str = _json.dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        text = highlighter(json_str)
+        text.no_wrap = True
+        text.overflow = None
+        self._text = text
+
+    def __rich__(self) -> Text:
+        """Return the highlighted text for rendering.
+
+        Returns:
+            Text: The pretty printed JSON as a Text instance.
+        """
+        return self._text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument(
+        "path",
+        metavar="FILE",
+        help="path to a JSON file",
+    )
+    args = parser.parse_args()
+
+    try:
+        with open(args.path, "rt") as json_file:
+            json_data = json_file.read()
+    except (OSError, IOError) as error:
+        error_console = Console(stderr=True)
+        error_console.print(f"Unable to read {args.path!r}; {error}")
+        sys.exit(-1)
+
+    console = Console()
+    console.print(JSON(json_data), soft_wrap=True)
