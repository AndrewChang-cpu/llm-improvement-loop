+class JSONHighlighter(RegexHighlighter):
+    """Highlights JSON text."""
+
+    base_style = "json."
+    highlights = [
+        _combine_regex(
+            r"(?P<brace>[\{\[\(\)\]\}])",
+            r"\b(?P<bool_true>true)\b|\b(?P<bool_false>false)\b|\b(?P<null>null)\b",
+            r"(?P<number>0x[0-9a-fA-F]+|(?<!\w)\-?[0-9]+\.?[0-9]*(e[\-\+]?\d+)?)",
+            r"(?<![\\\w])(?P<str>b?\".*?(?<!\\)\")",
+        ),
+    ]
+
