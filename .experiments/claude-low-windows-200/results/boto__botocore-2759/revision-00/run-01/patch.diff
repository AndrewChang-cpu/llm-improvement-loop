diff --git a/tests/unit/test_args.py b/tests/unit/test_args.py
index b2a2320..3b5173e 100644
--- a/tests/unit/test_args.py
+++ b/tests/unit/test_args.py
@@ -459,3 +459,67 @@ class TestCreateClientArgs(unittest.TestCase):
             client_config=Config(retries={'mode': 'standard'})
         )['client_config']
         self.assertEqual(config.retries['mode'], 'standard')
+
+    def test_builtin_defaults_without_client_config(self):
+        builtins = self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=self.region,
+            endpoint_url=None,
+            client_config=None,
+        )
+        self.assertEqual(
+            builtins,
+            {
+                'AWS::Region': self.region,
+                'AWS::UseFIPS': False,
+                'AWS::UseDualStack': False,
+                'SDK::Endpoint': None,
+                'AWS::S3::Accelerate': False,
+                'AWS::S3::ForcePathStyle': False,
+                'AWS::S3::UseArnRegion': True,
+                'AWS::S3Control::UseArnRegion': True,
+            },
+        )
+
+    def test_builtin_defaults_from_client_config(self):
+        builtins = self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=self.region,
+            endpoint_url=self.endpoint_url,
+            client_config=Config(
+                use_fips_endpoint=True,
+                use_dualstack_endpoint=True,
+                s3={
+                    'use_accelerate_endpoint': True,
+                    'addressing_style': 'path',
+                },
+            ),
+        )
+        self.assertTrue(builtins['AWS::UseFIPS'])
+        self.assertTrue(builtins['AWS::UseDualStack'])
+        self.assertEqual(builtins['SDK::Endpoint'], self.endpoint_url)
+        self.assertTrue(builtins['AWS::S3::Accelerate'])
+        self.assertTrue(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_builtin_defaults_s3_config_from_config_store(self):
+        self.config_store.set_config_variable(
+            's3', {'addressing_style': 'virtual'}
+        )
+        self.config_store.set_config_variable('use_arn_region', False)
+        builtins = self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=self.region,
+            endpoint_url=None,
+            client_config=None,
+        )
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+        self.assertFalse(builtins['AWS::S3::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3Control::UseArnRegion'])
+
+    def test_builtin_defaults_client_config_s3_beats_config_store(self):
+        self.config_store.set_config_variable(
+            's3', {'addressing_style': 'path'}
+        )
+        builtins = self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=self.region,
+            endpoint_url=None,
+            client_config=Config(s3={'addressing_style': 'virtual'}),
+        )
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
