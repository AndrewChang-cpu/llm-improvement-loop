+    def compute_endpoint_resolver_builtin_defaults(
+        self, region_name, endpoint_url, client_config
+    ):
+        """Compute the default values of the endpoint ruleset builtins.
+
+        The returned dictionary is keyed by builtin parameter name (e.g.
+        ``AWS::Region``) and is intended to be consumed by the future
+        ``EndpointProvider``. Values are derived from the client creation
+        arguments, the client config, the S3 config and the config store.
+
+        :type region_name: str
+        :param region_name: The region the client is created for.
+
+        :type endpoint_url: str
+        :param endpoint_url: The custom endpoint URL, if any.
+
+        :type client_config: botocore.config.Config
+        :param client_config: The client config passed by the user, if any.
+
+        :rtype: dict
+        :return: Mapping of builtin parameter name to its value.
+        """
+        use_fips = False
+        use_dualstack = False
+        if client_config is not None:
+            use_fips = bool(client_config.use_fips_endpoint)
+            use_dualstack = bool(client_config.use_dualstack_endpoint)
+
+        s3_config = self.compute_s3_config(client_config) or {}
+        addressing_style = s3_config.get('addressing_style')
+        use_accelerate = s3_config.get('use_accelerate_endpoint', False)
+
+        use_arn_region = self._config_store.get_config_variable(
+            'use_arn_region'
+        )
+        if use_arn_region is None:
+            use_arn_region = True
+        else:
+            use_arn_region = botocore.utils.ensure_boolean(use_arn_region)
+
+        return {
+            'AWS::Region': region_name,
+            'AWS::UseFIPS': use_fips,
+            'AWS::UseDualStack': use_dualstack,
+            'SDK::Endpoint': endpoint_url,
+            'AWS::S3::Accelerate': botocore.utils.ensure_boolean(
+                use_accelerate
+            ),
+            'AWS::S3::ForcePathStyle': addressing_style == 'path',
+            'AWS::S3::UseArnRegion': use_arn_region,
+            'AWS::S3Control::UseArnRegion': use_arn_region,
+        }
+
     def compute_s3_config(self, client_config):
         s3_configuration = self._config_store.get_config_variable('s3')
 
