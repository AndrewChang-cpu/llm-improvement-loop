@@ -234,6 +245,46 @@ class ClientArgsCreator:
             'config_kwargs': config_kwargs,
             's3_config': s3_config,
             'socket_options': self._compute_socket_options(scoped_config),
+            'endpoint_builtins': endpoint_builtins,
