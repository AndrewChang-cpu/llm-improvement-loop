@@ -459,3 +459,94 @@ class TestCreateClientArgs(unittest.TestCase):
             client_config=Config(retries={'mode': 'standard'})
         )['client_config']
         self.assertEqual(config.retries['mode'], 'standard')
+
+
+class TestEndpointResolverBuiltinDefaults(unittest.TestCase):
+    def setUp(self):
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            mock.Mock(HierarchicalEmitter), None, None, None, None,
+            self.config_store,
+        )
+
+    def compute(self, service_name='ec2', region_name='us-west-2', **kwargs):
+        params = dict(
+            service_name=service_name,
+            region_name=region_name,
+            endpoint_url=None,
+            use_dualstack_endpoint=False,
+            use_fips_endpoint=False,
+            s3_config=None,
+        )
+        params.update(kwargs)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **params
+        )
+
+    def test_common_builtins(self):
+        builtins = self.compute()
+        self.assertEqual(builtins['AWS::Region'], 'us-west-2')
+        self.assertIs(builtins['AWS::UseFIPS'], False)
+        self.assertIs(builtins['AWS::UseDualStack'], False)
+        self.assertIsNone(builtins['SDK::Endpoint'])
+        self.assertNotIn('AWS::S3::Accelerate', builtins)
+        self.assertNotIn('AWS::STS::UseGlobalEndpoint', builtins)
+
+    def test_endpoint_url_and_variants(self):
+        builtins = self.compute(
+            endpoint_url='https://custom/',
+            use_dualstack_endpoint=True,
+            use_fips_endpoint=True,
+        )
+        self.assertEqual(builtins['SDK::Endpoint'], 'https://custom/')
+        self.assertIs(builtins['AWS::UseFIPS'], True)
+        self.assertIs(builtins['AWS::UseDualStack'], True)
+
+    def test_region_none_is_passed_through(self):
+        self.assertIsNone(self.compute(region_name=None)['AWS::Region'])
+
+    def test_sts_global_endpoint_legacy_global_region(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'legacy'
+        )
+        builtins = self.compute(service_name='sts', region_name='us-east-1')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_sts_regional_config_disables_global_endpoint(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self.compute(service_name='sts', region_name='us-east-1')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_sts_non_legacy_region_is_not_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'legacy'
+        )
+        builtins = self.compute(service_name='sts', region_name='ap-east-1')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_defaults(self):
+        builtins = self.compute(service_name='s3')
+        self.assertIs(builtins['AWS::S3::Accelerate'], False)
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], False)
+        self.assertIs(builtins['AWS::S3::UseArnRegion'], True)
+
+    def test_s3_config_values(self):
+        builtins = self.compute(
+            service_name='s3',
+            s3_config={
+                'use_accelerate_endpoint': True,
+                'addressing_style': 'path',
+                'use_arn_region': False,
+            },
+        )
+        self.assertIs(builtins['AWS::S3::Accelerate'], True)
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], True)
+        self.assertIs(builtins['AWS::S3::UseArnRegion'], False)
+
+    def test_s3_virtual_addressing_is_not_path_style(self):
+        builtins = self.compute(
+            service_name='s3', s3_config={'addressing_style': 'virtual'}
+        )
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], False)
