+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        service_name,
+        region_name,
+        endpoint_url,
+        use_dualstack_endpoint,
+        use_fips_endpoint,
+        s3_config,
+    ):
+        """Compute the values of the endpoint ruleset builtin parameters.
+
+        Each key is the builtin parameter name as it appears in an endpoint
+        ruleset, and each value is the value that parameter should take for
+        this client. This is glue code only; nothing consumes the result yet.
+
+        :type service_name: str
+        :param service_name: The endpoint prefix of the service.
+
+        :type region_name: str
+        :param region_name: The region the client was created with, or None.
+
+        :type endpoint_url: str
+        :param endpoint_url: The user supplied endpoint URL, or None.
+
+        :type use_dualstack_endpoint: bool
+        :param use_dualstack_endpoint: Whether dualstack was requested.
+
+        :type use_fips_endpoint: bool
+        :param use_fips_endpoint: Whether FIPS was requested.
+
+        :type s3_config: dict
+        :param s3_config: The computed S3 config, or None.
+
+        :rtype: dict
+        :return: Mapping of builtin parameter name to value.
+        """
+        s3_config = s3_config or {}
+        builtins = {
+            'AWS::Region': region_name,
+            'AWS::UseFIPS': bool(use_fips_endpoint),
+            'AWS::UseDualStack': bool(use_dualstack_endpoint),
+            'SDK::Endpoint': endpoint_url,
+        }
+        if service_name == 'sts':
+            builtins['AWS::STS::UseGlobalEndpoint'] = (
+                self._get_sts_regional_endpoints_config() == 'legacy'
+                and region_name in LEGACY_GLOBAL_STS_REGIONS
+            )
+        if service_name == 's3':
+            builtins['AWS::S3::Accelerate'] = bool(
+                s3_config.get('use_accelerate_endpoint', False)
+            )
+            builtins['AWS::S3::ForcePathStyle'] = (
+                s3_config.get('addressing_style') == 'path'
+            )
+            builtins['AWS::S3::UseArnRegion'] = bool(
+                s3_config.get('use_arn_region', True)
+            )
+        return builtins
+
     def compute_s3_config(self, client_config):
         s3_configuration = self._config_store.get_config_variable('s3')
 
diff --git a/tests/unit/test_args.py b/tests/unit/test_args.py
