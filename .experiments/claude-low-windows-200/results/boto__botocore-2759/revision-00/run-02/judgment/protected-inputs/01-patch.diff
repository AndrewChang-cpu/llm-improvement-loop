         self.assertEqual(config.retries['mode'], 'standard')
+
+
+class TestComputeEndpointResolverBuiltinDefaults(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+
+    def compute(
+        self,
+        service_name='ec2',
+        region_name='us-west-2',
+        endpoint_url=None,
+        client_config=None,
+        s3_config=None,
+    ):
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            service_name=service_name,
+            region_name=region_name,
+            endpoint_url=endpoint_url,
+            client_config=client_config,
+            s3_config=s3_config,
+        )
+
+    def test_defaults_without_client_config(self):
+        builtins = self.compute()
+        self.assertEqual(
+            builtins,
+            {
+                'AWS::Region': 'us-west-2',
+                'AWS::UseFIPS': False,
+                'AWS::UseDualStack': False,
+                'SDK::Endpoint': None,
+                'AWS::S3::Accelerate': False,
+                'AWS::S3::ForcePathStyle': False,
+                'AWS::S3::UseArnRegion': True,
+                'AWS::S3::DisableMultiRegionAccessPoints': False,
+            },
+        )
+
+    def test_region_and_endpoint_url_are_passed_through(self):
+        builtins = self.compute(
+            region_name='eu-west-1', endpoint_url='https://example.com'
+        )
+        self.assertEqual(builtins['AWS::Region'], 'eu-west-1')
+        self.assertEqual(builtins['SDK::Endpoint'], 'https://example.com')
+
+    def test_region_can_be_none(self):
+        builtins = self.compute(region_name=None)
+        self.assertIsNone(builtins['AWS::Region'])
+
+    def test_use_fips_from_client_config(self):
+        builtins = self.compute(
+            client_config=Config(use_fips_endpoint=True)
+        )
+        self.assertTrue(builtins['AWS::UseFIPS'])
+        self.assertFalse(builtins['AWS::UseDualStack'])
+
+    def test_use_dualstack_from_client_config(self):
+        builtins = self.compute(
+            client_config=Config(use_dualstack_endpoint=True)
+        )
+        self.assertTrue(builtins['AWS::UseDualStack'])
+        self.assertFalse(builtins['AWS::UseFIPS'])
+
+    def test_s3_dualstack_from_s3_config_only_for_s3(self):
+        s3_config = {'use_dualstack_endpoint': True}
+        s3_builtins = self.compute(
+            service_name='s3', s3_config=s3_config
+        )
+        self.assertTrue(s3_builtins['AWS::UseDualStack'])
+        other_builtins = self.compute(
+            service_name='ec2', s3_config=s3_config
+        )
+        self.assertFalse(other_builtins['AWS::UseDualStack'])
+
+    def test_s3_accelerate_from_s3_config(self):
+        builtins = self.compute(
+            service_name='s3',
+            s3_config={'use_accelerate_endpoint': True},
+        )
+        self.assertTrue(builtins['AWS::S3::Accelerate'])
+
+    def test_s3_force_path_style_from_addressing_style(self):
+        builtins = self.compute(
+            service_name='s3', s3_config={'addressing_style': 'path'}
+        )
+        self.assertTrue(builtins['AWS::S3::ForcePathStyle'])
+
+        builtins = self.compute(
+            service_name='s3', s3_config={'addressing_style': 'virtual'}
+        )
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_s3_use_arn_region_can_be_disabled(self):
+        builtins = self.compute(
+            service_name='s3', s3_config={'use_arn_region': False}
+        )
+        self.assertFalse(builtins['AWS::S3::UseArnRegion'])
+
+    def test_s3_disable_multiregion_access_points(self):
+        builtins = self.compute(
+            service_name='s3-control',
+            s3_config={'s3_disable_multiregion_access_points': True},
+        )
+        self.assertTrue(builtins['AWS::S3::DisableMultiRegionAccessPoints'])
