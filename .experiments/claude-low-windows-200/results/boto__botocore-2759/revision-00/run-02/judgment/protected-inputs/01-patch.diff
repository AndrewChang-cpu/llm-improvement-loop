index 0da5bb7..32340cf 100644
--- a/botocore/args.py
+++ b/botocore/args.py
@@ -236,6 +236,51 @@ class ClientArgsCreator:
             'socket_options': self._compute_socket_options(scoped_config),
         }
 
+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        service_name,
+        region_name,
+        endpoint_url,
+        client_config,
+        s3_config,
+    ):
+        """Compute values for the builtin parameters of endpoint rulesets.
+
+        Returns a dict keyed by builtin parameter name (e.g. ``AWS::Region``)
+        whose values are derived from the client creation inputs. This is
+        internal glue code for the endpoint resolver; it does not change the
+        result of ``compute_client_args``.
+        """
+        is_s3_service = service_name in ['s3', 's3-control']
+        use_fips = bool(client_config and client_config.use_fips_endpoint)
+        use_dualstack = bool(
+            client_config and client_config.use_dualstack_endpoint
+        )
+        if is_s3_service and s3_config and s3_config.get(
+            'use_dualstack_endpoint'
+        ):
+            use_dualstack = True
+
+        s3_config = s3_config or {}
+        return {
+            'AWS::Region': region_name,
+            'AWS::UseFIPS': use_fips,
+            'AWS::UseDualStack': use_dualstack,
+            'SDK::Endpoint': endpoint_url,
+            'AWS::S3::Accelerate': bool(
+                s3_config.get('use_accelerate_endpoint', False)
+            ),
+            'AWS::S3::ForcePathStyle': (
+                s3_config.get('addressing_style') == 'path'
+            ),
+            'AWS::S3::UseArnRegion': bool(
+                s3_config.get('use_arn_region', True)
+            ),
+            'AWS::S3::DisableMultiRegionAccessPoints': bool(
+                s3_config.get('s3_disable_multiregion_access_points', False)
+            ),
+        }
+
     def compute_s3_config(self, client_config):
         s3_configuration = self._config_store.get_config_variable('s3')
 
