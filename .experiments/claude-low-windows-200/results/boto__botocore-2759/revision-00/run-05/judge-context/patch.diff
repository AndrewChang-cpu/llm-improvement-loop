diff --git a/botocore/args.py b/botocore/args.py
index 0da5bb7..5c9fca1 100644
--- a/botocore/args.py
+++ b/botocore/args.py
@@ -255,6 +255,46 @@ class ClientArgsCreator:
 
         return s3_configuration
 
+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        endpoint_url,
+        client_config,
+        s3_config,
+    ):
+        """Compute the values of the builtin parameters for endpoint rulesets.
+
+        Returns a dict mapping each builtin parameter name (as referenced by
+        endpoint rulesets) to its value for this client. This is internal
+        glue code; it is not yet used to resolve endpoints.
+
+        :param region_name: The region name the client was created with.
+        :param endpoint_url: The custom endpoint URL, or None.
+        :param client_config: The ``botocore.config.Config`` for the client,
+            or None.
+        :param s3_config: The resolved s3 config dict, or None.
+        """
+        s3_config = s3_config or {}
+        use_fips = False
+        use_dualstack = False
+        if client_config is not None:
+            use_fips = bool(client_config.use_fips_endpoint)
+            use_dualstack = bool(client_config.use_dualstack_endpoint)
+        return {
+            'AWS::Region': region_name,
+            'AWS::UseFIPS': use_fips,
+            'AWS::UseDualStack': use_dualstack,
+            'SDK::Endpoint': endpoint_url,
+            'AWS::S3::Accelerate': bool(
+                s3_config.get('use_accelerate_endpoint', False)
+            ),
+            'AWS::S3::ForcePathStyle': s3_config.get('addressing_style')
+            == 'path',
+            'AWS::S3::UseArnRegion': bool(
+                s3_config.get('use_arn_region', True)
+            ),
+        }
+
     def _compute_endpoint_config(
         self,
         service_name,
diff --git a/tests/unit/test_args.py b/tests/unit/test_args.py
index b2a2320..3cc7580 100644
--- a/tests/unit/test_args.py
+++ b/tests/unit/test_args.py
@@ -459,3 +459,63 @@ class TestCreateClientArgs(unittest.TestCase):
             client_config=Config(retries={'mode': 'standard'})
         )['client_config']
         self.assertEqual(config.retries['mode'], 'standard')
+
+
+class TestEndpointResolverBuiltinDefaults(unittest.TestCase):
+    def setUp(self):
+        self.args_create = args.ClientArgsCreator(
+            None, None, None, None, None, None
+        )
+
+    def compute(self, client_config=None, s3_config=None, **kwargs):
+        call_kwargs = {
+            'region_name': 'us-west-2',
+            'endpoint_url': None,
+        }
+        call_kwargs.update(kwargs)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            client_config=client_config, s3_config=s3_config, **call_kwargs
+        )
+
+    def test_default_values(self):
+        self.assertEqual(
+            self.compute(),
+            {
+                'AWS::Region': 'us-west-2',
+                'AWS::UseFIPS': False,
+                'AWS::UseDualStack': False,
+                'SDK::Endpoint': None,
+                'AWS::S3::Accelerate': False,
+                'AWS::S3::ForcePathStyle': False,
+                'AWS::S3::UseArnRegion': True,
+            },
+        )
+
+    def test_region_and_endpoint_url(self):
+        result = self.compute(
+            region_name='eu-west-1', endpoint_url='https://example.com/'
+        )
+        self.assertEqual(result['AWS::Region'], 'eu-west-1')
+        self.assertEqual(result['SDK::Endpoint'], 'https://example.com/')
+
+    def test_fips_and_dualstack_from_client_config(self):
+        config = Config(use_fips_endpoint=True, use_dualstack_endpoint=True)
+        result = self.compute(client_config=config)
+        self.assertTrue(result['AWS::UseFIPS'])
+        self.assertTrue(result['AWS::UseDualStack'])
+
+    def test_s3_builtins_from_s3_config(self):
+        result = self.compute(
+            s3_config={
+                'use_accelerate_endpoint': True,
+                'addressing_style': 'path',
+                'use_arn_region': False,
+            }
+        )
+        self.assertTrue(result['AWS::S3::Accelerate'])
+        self.assertTrue(result['AWS::S3::ForcePathStyle'])
+        self.assertFalse(result['AWS::S3::UseArnRegion'])
+
+    def test_virtual_addressing_style_is_not_force_path(self):
+        result = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertFalse(result['AWS::S3::ForcePathStyle'])
