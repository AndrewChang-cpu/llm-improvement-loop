         return s3_configuration
 
+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        service_name,
+        region_name,
+        endpoint_url,
+        client_config,
+        s3_config,
+    ):
+        """Assign values to the endpoint ruleset "builtin" parameters.
+
+        Returns a dict keyed by builtin parameter name (e.g. ``AWS::Region``)
+        for use by the endpoint ruleset resolver. This is internal glue code;
+        it does not resolve an endpoint by itself.
+        """
+        use_fips = bool(client_config and client_config.use_fips_endpoint)
+        use_dualstack = bool(
+            client_config and client_config.use_dualstack_endpoint
+        )
+        is_s3 = service_name == 's3'
+        if is_s3 and s3_config and s3_config.get('use_dualstack_endpoint'):
+            use_dualstack = True
+
+        builtins = {
+            'AWS::Region': region_name,
+            'AWS::UseFIPS': use_fips,
+            'AWS::UseDualStack': use_dualstack,
+            'SDK::Endpoint': endpoint_url,
+            'AWS::STS::UseGlobalEndpoint': False,
+            'AWS::S3::UseGlobalEndpoint': False,
+            'AWS::S3::Accelerate': False,
+            'AWS::S3::ForcePathStyle': False,
+            'AWS::S3::UseArnRegion': True,
+            'AWS::S3Control::UseArnRegion': False,
+        }
+
+        if service_name == 'sts':
+            builtins['AWS::STS::UseGlobalEndpoint'] = (
+                endpoint_url is None
+                and self._get_sts_regional_endpoints_config() == 'legacy'
+                and region_name in LEGACY_GLOBAL_STS_REGIONS
+            )
+
+        if is_s3:
+            builtins['AWS::S3::UseGlobalEndpoint'] = (
+                self._should_force_s3_global(region_name, s3_config)
+            )
+            if s3_config:
+                builtins['AWS::S3::Accelerate'] = bool(
+                    s3_config.get('use_accelerate_endpoint', False)
+                )
+                builtins['AWS::S3::ForcePathStyle'] = (
+                    s3_config.get('addressing_style') == 'path'
+                )
+
+        return builtins
+
     def _compute_endpoint_config(
         self,
         service_name,
