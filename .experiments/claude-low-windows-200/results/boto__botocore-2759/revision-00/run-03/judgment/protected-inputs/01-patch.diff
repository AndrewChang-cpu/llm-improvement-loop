+
+class TestComputeEndpointResolverBuiltinDefaults(unittest.TestCase):
+    def setUp(self):
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            mock.Mock(HierarchicalEmitter), None, None, None, None,
+            self.config_store,
+        )
+
+    def _compute(
+        self,
+        service_name='ec2',
+        region_name='us-west-2',
+        endpoint_url=None,
+        client_config=None,
+        s3_config=None,
+    ):
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            service_name, region_name, endpoint_url, client_config, s3_config
+        )
+
+    def test_region_and_endpoint_url(self):
+        builtins = self._compute(endpoint_url='https://custom/')
+        self.assertEqual(builtins['AWS::Region'], 'us-west-2')
+        self.assertEqual(builtins['SDK::Endpoint'], 'https://custom/')
+
+    def test_defaults_when_no_client_config(self):
+        builtins = self._compute()
+        self.assertFalse(builtins['AWS::UseFIPS'])
+        self.assertFalse(builtins['AWS::UseDualStack'])
+        self.assertIsNone(builtins['SDK::Endpoint'])
+
+    def test_fips_and_dualstack_from_client_config(self):
+        builtins = self._compute(
+            client_config=Config(
+                use_fips_endpoint=True, use_dualstack_endpoint=True
+            )
+        )
+        self.assertTrue(builtins['AWS::UseFIPS'])
+        self.assertTrue(builtins['AWS::UseDualStack'])
+
+    def test_s3_dualstack_from_s3_config(self):
+        builtins = self._compute(
+            service_name='s3',
+            s3_config={'use_dualstack_endpoint': True},
+        )
+        self.assertTrue(builtins['AWS::UseDualStack'])
+
+    def test_s3_dualstack_not_applied_to_other_services(self):
+        builtins = self._compute(
+            service_name='ec2',
+            s3_config={'use_dualstack_endpoint': True},
+        )
+        self.assertFalse(builtins['AWS::UseDualStack'])
+
+    def test_s3_accelerate_and_path_style(self):
+        builtins = self._compute(
+            service_name='s3',
+            s3_config={
+                'use_accelerate_endpoint': True,
+                'addressing_style': 'path',
+            },
+        )
+        self.assertTrue(builtins['AWS::S3::Accelerate'])
+        self.assertTrue(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_s3_virtual_addressing_is_not_path_style(self):
+        builtins = self._compute(
+            service_name='s3', s3_config={'addressing_style': 'virtual'}
+        )
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_s3_use_global_endpoint_for_us_east_1_legacy(self):
+        builtins = self._compute(service_name='s3', region_name='us-east-1')
+        self.assertTrue(builtins['AWS::S3::UseGlobalEndpoint'])
+
+    def test_s3_no_global_endpoint_for_us_east_1_regional(self):
+        builtins = self._compute(
+            service_name='s3',
+            region_name='us-east-1',
+            s3_config={'us_east_1_regional_endpoint': 'regional'},
+        )
+        self.assertFalse(builtins['AWS::S3::UseGlobalEndpoint'])
+
+    def test_s3_arn_region_defaults(self):
+        builtins = self._compute(service_name='s3')
+        self.assertTrue(builtins['AWS::S3::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3Control::UseArnRegion'])
+
+    def test_sts_global_endpoint_for_legacy_region(self):
+        builtins = self._compute(service_name='sts', region_name='us-east-1')
+        self.assertTrue(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_sts_regional_endpoint_for_regional_config(self):
+        self.config_store.set_config_provider(
+            'sts_regional_endpoints',
+            ('sts_regional_endpoints', None, None, None),
+        )
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._compute(service_name='sts', region_name='us-east-1')
+        self.assertFalse(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_sts_not_global_when_endpoint_url_provided(self):
+        builtins = self._compute(
+            service_name='sts',
+            region_name='us-east-1',
+            endpoint_url='https://sts.local/',
+        )
+        self.assertFalse(builtins['AWS::STS::UseGlobalEndpoint'])
