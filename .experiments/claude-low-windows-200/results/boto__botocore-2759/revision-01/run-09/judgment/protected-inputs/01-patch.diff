+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.client_config = Config()
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=self.client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(self, **overrides):
+        call_kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        call_kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **call_kwargs
+        )
+
+    def test_default_values(self):
+        builtins = self.compute()
+        self.assertEqual(len(builtins), 11)
+        self.assertEqual(
+            builtins[args.EPRBuiltins.AWS_REGION], 'ca-central-1'
+        )
+        self.assertIs(builtins[args.EPRBuiltins.AWS_USE_FIPS], False)
+        self.assertIs(builtins[args.EPRBuiltins.AWS_USE_DUALSTACK], False)
+        self.assertIs(builtins[args.EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], False)
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_ACCELERATE], False)
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False)
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_DISABLE_MRAP], False)
+        self.assertIsNone(builtins[args.EPRBuiltins.SDK_ENDPOINT])
+
+    def test_fips_from_config_store_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self.compute()
+        self.assertIs(builtins[args.EPRBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_from_config_store_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self.compute()
+        self.assertIs(builtins[args.EPRBuiltins.AWS_USE_FIPS], False)
+
+    def test_dualstack_s3_control_client_config_true(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self.compute(service_name='s3-control')
+        self.assertIs(builtins[args.EPRBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_s3_control_client_config_false(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': False})
+        builtins = self.compute(service_name='s3-control')
+        self.assertIs(builtins[args.EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_dualstack_other_service_ignores_s3_setting(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self.compute(service_name='other-service')
+        self.assertIs(builtins[args.EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_for_legacy_region(self):
+        builtins = self.compute(region_name='us-west-2')
+        self.assertIs(builtins[args.EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+
+    def test_sts_not_global_for_nonlegacy_region(self):
+        builtins = self.compute(region_name='eu-south-1')
+        self.assertIs(builtins[args.EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_sts_not_global_when_regional_configured(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self.compute(region_name='us-west-2')
+        self.assertIs(builtins[args.EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_s3_global_predicate_called_once_when_true(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self.compute(region_name='us-east-1')
+        predicate.assert_called_once_with('us-east-1', {})
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True)
+
+    def test_s3_accelerate_true_and_false(self):
+        builtins = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_ACCELERATE], True)
+        builtins = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_ACCELERATE], False)
+
+    def test_s3_force_path_style_only_for_path(self):
+        builtins = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], True)
+        for style in ('auto', 'virtual'):
+            builtins = self.compute(s3_config={'addressing_style': style})
+            self.assertIs(
+                builtins[args.EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+            )
+
+    def test_use_arn_region_false_applies_to_both(self):
+        builtins = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(
+            builtins[args.EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False
+        )
+
+    def test_use_arn_region_true_applies_to_both(self):
+        builtins = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(
+            builtins[args.EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True
+        )
+
+    def test_s3_disable_mrap_true_and_false(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_DISABLE_MRAP], True)
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(builtins[args.EPRBuiltins.AWS_S3_DISABLE_MRAP], False)
+
+    def test_sdk_endpoint_client_url_wins(self):
+        self.resolver.uses_builtin_data = False
+        builtins = self.compute(client_endpoint_url='https://client.url')
+        self.assertEqual(
+            builtins[args.EPRBuiltins.SDK_ENDPOINT], 'https://client.url'
+        )
+
+    def test_sdk_endpoint_legacy_url_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        builtins = self.compute()
+        self.assertEqual(
+            builtins[args.EPRBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_legacy_with_bundled_data(self):
+        # Despite the name, this sets the bundled-data flag to False, so the
+        # legacy URL is returned per the workflow rules.
+        self.resolver.uses_builtin_data = False
+        builtins = self.compute()
+        self.assertEqual(
+            builtins[args.EPRBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data(self):
+        builtins = self.compute()
+        self.assertIsNone(builtins[args.EPRBuiltins.SDK_ENDPOINT])
+
+    def test_region_is_argument_not_resolved_endpoint(self):
+        builtins = self.compute(region_name='us-west-2')
+        self.assertEqual(builtins[args.EPRBuiltins.AWS_REGION], 'us-west-2')
