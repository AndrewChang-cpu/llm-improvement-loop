+class EndpointResolverBuiltins(str, enum.Enum):
+    """Builtin parameter names consumed by endpoint rulesets."""
+
+    # string: the region name exactly as given by the caller.
+    AWS_REGION = 'AWS::Region'
+    # boolean: whether FIPS endpoints are requested.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # boolean: whether DualStack endpoints are requested.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # boolean: whether STS should use the global endpoint.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # boolean: whether S3 should use the global endpoint.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # boolean: whether S3 transfer acceleration is enabled.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # boolean: whether S3 uses path-style addressing.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # boolean by default; raw config value otherwise: whether S3 ARNs use the ARN region.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # boolean by default; raw config value otherwise: whether S3Control ARNs use the ARN region.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # boolean: whether S3 multi-region access points are disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # string, or absent: the SDK-provided endpoint URL.
+    SDK_ENDPOINT = 'SDK::Endpoint'
