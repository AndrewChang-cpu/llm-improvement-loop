+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.region = 'ca-central-1'
+        self.service = 'fooservice'
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _compute(self, **overrides):
+        kwargs = {
+            'region_name': self.region,
+            'service_name': self.service,
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_values(self):
+        builtins = self._compute()
+        self.assertEqual(len(builtins), 11)
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.AWS_REGION], 'ca-central-1'
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_FIPS], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False
+        )
+        self.assertIsNone(builtins[EndpointResolverBuiltins.SDK_ENDPOINT])
+
+    def test_builtin_keys_are_string_valued(self):
+        self.assertEqual(EndpointResolverBuiltins.AWS_REGION, 'AWS::Region')
+        self.assertEqual(
+            EndpointResolverBuiltins.SDK_ENDPOINT, 'SDK::Endpoint'
+        )
+
+    def test_fips_from_config_store_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._compute()
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_FIPS], True
+        )
+
+    def test_fips_from_config_store_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._compute()
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_FIPS], False
+        )
+
+    def test_dualstack_s3_control_from_client_config_true(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self._compute(service_name='s3-control')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], True
+        )
+
+    def test_dualstack_s3_control_from_client_config_false(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        builtins = self._compute(service_name='s3-control')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_dualstack_scoped_to_s3_services(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self._compute(service_name='other-service')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_sts_global_for_legacy_region(self):
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+
+    def test_sts_not_global_for_non_legacy_region(self):
+        builtins = self._compute(region_name='eu-south-1')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+
+    def test_sts_not_global_when_regional_configured(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+
+    def test_s3_global_calls_predicate_once(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self._compute(region_name='us-east-1')
+        predicate.assert_called_once_with('us-east-1', {})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+
+    def test_s3_accelerate_true(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE], True
+        )
+
+    def test_s3_accelerate_false(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False
+        )
+
+    def test_force_path_style_for_path(self):
+        builtins = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], True
+        )
+
+    def test_force_path_style_for_auto_and_virtual(self):
+        for style in ('auto', 'virtual'):
+            builtins = self._compute(s3_config={'addressing_style': style})
+            self.assertIs(
+                builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE],
+                False,
+            )
+
+    def test_use_arn_region_false(self):
+        builtins = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+
+    def test_use_arn_region_true(self):
+        builtins = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            True,
+        )
+
+    def test_mrap_true(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], True
+        )
+
+    def test_mrap_false(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False
+        )
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data_and_legacy(self):
+        self.resolver.uses_builtin_data = False
+        builtins = self._compute(client_endpoint_url='https://client.url')
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.url',
+        )
+
+    def test_sdk_endpoint_custom_data_uses_legacy_url(self):
+        self.resolver.uses_builtin_data = False
+        builtins = self._compute()
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_legacy_url_with_bundled_data(self):
+        # The name is misleading: this sets the bundled-data flag to False
+        # (custom data), so the legacy URL is used per the workflow rules.
+        self.resolver.uses_builtin_data = False
+        builtins = self._compute()
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_bundled_data_is_absent(self):
+        builtins = self._compute()
+        self.assertIsNone(builtins[EndpointResolverBuiltins.SDK_ENDPOINT])
