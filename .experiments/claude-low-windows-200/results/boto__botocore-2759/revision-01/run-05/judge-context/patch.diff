+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock(EndpointResolver)
+        self.resolver.uses_builtin_data = True
+        self.client_config = Config()
+        self.bridge = self._make_bridge()
+        self.region = 'ca-central-1'
+        self.service = 'fooservice'
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _make_bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            endpoint_resolver=self.resolver,
+            scoped_config=None,
+            client_config=client_config or self.client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        kwargs = {
+            'region_name': self.region,
+            'service_name': self.service,
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_case(self):
+        result = self._compute()
+        B = EndpointResolverBuiltins
+        self.assertEqual(result[B.AWS_REGION], 'ca-central-1')
+        self.assertIs(result[B.AWS_USE_FIPS], False)
+        self.assertIs(result[B.AWS_USE_DUALSTACK], False)
+        self.assertIs(result[B.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+        self.assertIs(result[B.AWS_S3_USE_GLOBAL_ENDPOINT], False)
+        self.assertIs(result[B.AWS_S3_ACCELERATE], False)
+        self.assertIs(result[B.AWS_S3_FORCE_PATH_STYLE], False)
+        self.assertIs(result[B.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[B.AWS_S3CONTROL_USE_ARN_REGION], False)
+        self.assertIs(result[B.AWS_S3_DISABLE_MRAP], False)
+        self.assertIn(B.SDK_ENDPOINT, result)
+        self.assertIsNone(result[B.SDK_ENDPOINT])
+        self.assertEqual(len(result), 11)
+
+    def test_builtin_names_and_str_equality(self):
+        self.assertEqual(EndpointResolverBuiltins.AWS_REGION, 'AWS::Region')
+        self.assertEqual(
+            EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP,
+            'AWS::S3::DisableMultiRegionAccessPoints',
+        )
+        self.assertEqual(EndpointResolverBuiltins.SDK_ENDPOINT, 'SDK::Endpoint')
+
+    def test_fips_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+
+    def test_dualstack_s3_control_true(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(service_name='s3-control', endpoint_bridge=bridge)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_s3_control_false(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': False})
+        )
+        result = self._compute(service_name='s3-control', endpoint_bridge=bridge)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_dualstack_other_service_ignores_s3_setting(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_in_us_west_2_default(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True
+        )
+
+    def test_sts_not_global_in_eu_south_1(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False
+        )
+
+    def test_sts_regional_setting_disables_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False
+        )
+
+    def test_s3_global_predicate_called_once_when_true(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self._compute(region_name='us-east-1')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True)
+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_s3_accelerate_true_and_false(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], True)
+        result = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False)
+
+    def test_force_path_style(self):
+        B = EndpointResolverBuiltins
+        self.assertIs(
+            self._compute(s3_config={'addressing_style': 'path'})[
+                B.AWS_S3_FORCE_PATH_STYLE
+            ],
+            True,
+        )
+        for style in ('auto', 'virtual'):
+            self.assertIs(
+                self._compute(s3_config={'addressing_style': style})[
+                    B.AWS_S3_FORCE_PATH_STYLE
+                ],
+                False,
+            )
+
+    def test_use_arn_region_false(self):
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False
+        )
+
+    def test_use_arn_region_true(self):
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True
+        )
+
+    def test_mrap_true_and_false(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], True)
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False)
+
+    def test_sdk_endpoint_client_url_wins(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute(client_endpoint_url='https://client.example.com')
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.example.com',
+        )
+
+    def test_sdk_endpoint_legacy_url_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data_and_legacy_url(self):
+        # Despite the name, this sets the bundled-data flag to false, per the
+        # workflow rules: the legacy URL is used when data is custom.
+        self.resolver.uses_builtin_data = False
+        result = self._compute(legacy_endpoint_url=self.legacy_url)
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data(self):
+        result = self._compute()
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
