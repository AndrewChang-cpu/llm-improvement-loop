+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute the endpoint ruleset builtin values for one client.
+
+        This is a pure computation; it is not used during client creation.
+        All builtins are always present in the returned mapping.
+        """
+        B = EndpointResolverBuiltins
+        s3_config = s3_config or {}
+        use_fips = endpoint_bridge._resolve_endpoint_variant_config_var(
+            'use_fips_endpoint'
+        )
+        use_dualstack = endpoint_bridge._resolve_use_dualstack_endpoint(
+            service_name
+        )
+        resolver = endpoint_bridge.endpoint_resolver
+        if client_endpoint_url:
+            sdk_endpoint = client_endpoint_url
+        elif not resolver.uses_builtin_data:
+            sdk_endpoint = legacy_endpoint_url
+        else:
+            sdk_endpoint = None
+        return {
+            B.AWS_REGION: region_name,
+            B.AWS_USE_FIPS: use_fips or False,
+            B.AWS_USE_DUALSTACK: use_dualstack or False,
+            B.AWS_STS_USE_GLOBAL_ENDPOINT: (
+                self._should_set_global_sts_endpoint(region_name, None, None)
+            ),
+            B.AWS_S3_USE_GLOBAL_ENDPOINT: self._should_force_s3_global(
+                region_name, s3_config
+            ),
+            B.AWS_S3_ACCELERATE: s3_config.get('use_accelerate_endpoint', False),
+            B.AWS_S3_FORCE_PATH_STYLE: (
+                s3_config.get('addressing_style') == 'path'
+            ),
+            B.AWS_S3_USE_ARN_REGION: s3_config.get('use_arn_region', True),
+            B.AWS_S3CONTROL_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', False
+            ),
+            B.AWS_S3_DISABLE_MRAP: s3_config.get(
+                's3_disable_multiregion_access_points', False
+            ),
+            B.SDK_ENDPOINT: sdk_endpoint,
+        }
