+class EndpointResolverBuiltins(str, Enum):
+    """Builtin parameter names consumed by endpoint rulesets."""
+
+    # Region name for the request. Type: string.
+    AWS_REGION = "AWS::Region"
+    # Whether FIPS endpoints should be used. Type: boolean.
+    AWS_USE_FIPS = "AWS::UseFIPS"
+    # Whether DualStack endpoints should be used. Type: boolean.
+    AWS_USE_DUALSTACK = "AWS::UseDualStack"
+    # Whether the global STS endpoint should be used. Type: boolean.
+    AWS_STS_USE_GLOBAL_ENDPOINT = "AWS::STS::UseGlobalEndpoint"
+    # Whether the global S3 endpoint should be used. Type: boolean.
+    AWS_S3_USE_GLOBAL_ENDPOINT = "AWS::S3::UseGlobalEndpoint"
+    # Whether S3 Transfer Acceleration should be used. Type: boolean.
+    AWS_S3_ACCELERATE = "AWS::S3::Accelerate"
+    # Whether path-style S3 addressing should be used. Type: boolean.
+    AWS_S3_FORCE_PATH_STYLE = "AWS::S3::ForcePathStyle"
+    # Whether S3 ARNs may use their own region. Type: boolean by default,
+    # raw config value otherwise.
+    AWS_S3_USE_ARN_REGION = "AWS::S3::UseArnRegion"
+    # Whether S3 Control ARNs may use their own region. Type: boolean by
+    # default, raw config value otherwise.
+    AWS_S3CONTROL_USE_ARN_REGION = "AWS::S3Control::UseArnRegion"
+    # Whether multi-region access points are disabled for S3. Type: boolean.
+    AWS_S3_DISABLE_MRAP = "AWS::S3::DisableMultiRegionAccessPoints"
+    # Endpoint URL override for the SDK. Type: string, or absent (None).
+    SDK_ENDPOINT = "SDK::Endpoint"
