+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter,
+            None,
+            None,
+            None,
+            None,
+            self.config_store,
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_values(self):
+        builtins = self.compute()
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.AWS_REGION], 'ca-central-1'
+        )
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False)
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], False)
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False)
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False)
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False)
+        self.assertIsNone(builtins[EndpointResolverBuiltins.SDK_ENDPOINT])
+        self.assertEqual(len(builtins), 11)
+
+    def test_fips_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self.compute()
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self.compute()
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+
+    def test_dualstack_s3_control_from_client_config(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self.compute(service_name='s3-control')
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_s3_control_false_from_client_config(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': False})
+        builtins = self.compute(service_name='s3-control')
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_dualstack_ignored_for_other_services(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self.compute(service_name='other-service')
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_in_us_west_2_default(self):
+        builtins = self.compute(region_name='us-west-2')
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+
+    def test_sts_regional_in_eu_south_1(self):
+        builtins = self.compute(region_name='eu-south-1')
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_sts_regional_when_sts_regional_endpoints_regional(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self.compute(region_name='us-west-2')
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_s3_global_uses_predicate_once(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self.compute(region_name='us-east-1')
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True)
+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_s3_accelerate_true(self):
+        builtins = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE], True)
+
+    def test_s3_accelerate_false(self):
+        builtins = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False)
+
+    def test_force_path_style_for_path(self):
+        builtins = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], True)
+
+    def test_force_path_style_false_for_auto_and_virtual(self):
+        for style in ('auto', 'virtual'):
+            builtins = self.compute(s3_config={'addressing_style': style})
+            self.assertIs(
+                builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+            )
+
+    def test_use_arn_region_false(self):
+        builtins = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False
+        )
+
+    def test_use_arn_region_true(self):
+        builtins = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True
+        )
+
+    def test_mrap_true(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], True)
+
+    def test_mrap_false(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False)
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute(client_endpoint_url='https://client.url')
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT], 'https://client.url'
+        )
+
+    def test_sdk_endpoint_legacy_url_with_custom_data(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute()
+        self.assertEqual(builtins[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url)
+
+    def test_sdk_endpoint_absent_with_bundled_data_and_legacy_url(self):
+        # Despite the name, this sets the bundled-data flag to False, so the
+        # legacy URL is used. The name is kept from the reference suite.
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute(legacy_endpoint_url=self.legacy_url)
+        self.assertEqual(builtins[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url)
+
+    def test_sdk_endpoint_absent_with_bundled_data(self):
+        builtins = self.compute()
+        self.assertIsNone(builtins[EndpointResolverBuiltins.SDK_ENDPOINT])
