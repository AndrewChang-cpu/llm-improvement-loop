+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.region = 'ca-central-1'
+        self.service = 'fooservice'
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(self, **overrides):
+        kwargs = {
+            'region_name': self.region,
+            'service_name': self.service,
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_case(self):
+        result = self.compute()
+        B = EndpointResolverBuiltins
+        self.assertEqual(result[B.AWS_REGION], 'ca-central-1')
+        self.assertIs(result[B.AWS_USE_FIPS], False)
+        self.assertIs(result[B.AWS_USE_DUALSTACK], False)
+        self.assertIs(result[B.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+        self.assertIs(result[B.AWS_S3_USE_GLOBAL_ENDPOINT], False)
+        self.assertIs(result[B.AWS_S3_ACCELERATE], False)
+        self.assertIs(result[B.AWS_S3_FORCE_PATH_STYLE], False)
+        self.assertIs(result[B.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[B.AWS_S3CONTROL_USE_ARN_REGION], False)
+        self.assertIs(result[B.AWS_S3_DISABLE_MRAP], False)
+        self.assertIsNone(result[B.SDK_ENDPOINT])
+        self.assertEqual(len(result), 11)
+
+    def test_builtin_names_are_strings(self):
+        self.assertEqual(EndpointResolverBuiltins.AWS_REGION, 'AWS::Region')
+        self.assertEqual(
+            EndpointResolverBuiltins.SDK_ENDPOINT, 'SDK::Endpoint'
+        )
+
+    def test_fips_from_config_store_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_USE_FIPS], True
+        )
+
+    def test_fips_from_config_store_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self.compute()
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_USE_FIPS], False
+        )
+
+    def test_dualstack_s3_control_client_config_true(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        result = self.compute(service_name='s3-control')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], True
+        )
+
+    def test_dualstack_s3_control_client_config_false(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_dualstack_ignored_for_other_service(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        result = self.compute(service_name='other-service')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_sts_global_in_us_west_2_default(self):
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True
+        )
+
+    def test_sts_not_global_in_eu_south_1(self):
+        result = self.compute(region_name='eu-south-1')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+
+    def test_sts_regional_config_disables_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+
+    def test_s3_global_uses_predicate_once(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self.compute(region_name='us-east-1')
+        predicate.assert_called_once_with('us-east-1', {})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True
+        )
+
+    def test_s3_accelerate_pass_through(self):
+        for value in (True, False):
+            result = self.compute(s3_config={'use_accelerate_endpoint': value})
+            self.assertIs(
+                result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], value
+            )
+
+    def test_s3_force_path_style(self):
+        B = EndpointResolverBuiltins
+        result = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(result[B.AWS_S3_FORCE_PATH_STYLE], True)
+        for style in ('auto', 'virtual'):
+            result = self.compute(s3_config={'addressing_style': style})
+            self.assertIs(result[B.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_use_arn_region_false(self):
+        B = EndpointResolverBuiltins
+        result = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(result[B.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(result[B.AWS_S3CONTROL_USE_ARN_REGION], False)
+
+    def test_use_arn_region_true(self):
+        B = EndpointResolverBuiltins
+        result = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(result[B.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[B.AWS_S3CONTROL_USE_ARN_REGION], True)
+
+    def test_mrap_pass_through(self):
+        for value in (True, False):
+            result = self.compute(
+                s3_config={'s3_disable_multiregion_access_points': value}
+            )
+            self.assertIs(
+                result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], value
+            )
+
+    def test_sdk_endpoint_client_url_wins(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute(client_endpoint_url='https://client.url')
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.url',
+        )
+
+    def test_sdk_endpoint_legacy_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data_and_legacy_url(self):
+        # Per the spec rules: bundled data with no client URL yields an absent
+        # SDK endpoint, even when a legacy URL is present.
+        self.resolver.uses_builtin_data = True
+        result = self.compute()
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
