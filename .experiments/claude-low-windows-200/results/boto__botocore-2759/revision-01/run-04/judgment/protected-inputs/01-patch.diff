+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute the endpoint ruleset builtin values for one client.
+
+        Returns a mapping keyed by EndpointResolverBuiltins members. All
+        builtins are always present. This is a pure computation and is not
+        used during client creation.
+        """
+        use_fips = endpoint_bridge._resolve_endpoint_variant_config_var(
+            'use_fips_endpoint'
+        )
+        use_dualstack = endpoint_bridge._resolve_use_dualstack_endpoint(
+            service_name
+        )
+        sdk_endpoint = self._compute_sdk_endpoint_builtin(
+            endpoint_bridge,
+            client_endpoint_url,
+            legacy_endpoint_url,
+        )
+        return {
+            EndpointResolverBuiltins.SDK_ENDPOINT: sdk_endpoint,
+            EndpointResolverBuiltins.AWS_USE_FIPS: use_fips or False,
+            EndpointResolverBuiltins.AWS_USE_DUALSTACK: use_dualstack
+            or False,
+            EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: (
+                self._should_set_global_sts_endpoint(
+                    region_name, None, None
+                )
+            ),
+            EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: (
+                self._should_force_s3_global(region_name, s3_config)
+            ),
+            EndpointResolverBuiltins.AWS_S3_ACCELERATE: s3_config.get(
+                'use_accelerate_endpoint', False
+            ),
+            EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE: (
+                s3_config.get('addressing_style') == 'path'
+            ),
+            EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', True
+            ),
+            EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION: (
+                s3_config.get('use_arn_region', False)
+            ),
+            EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP: s3_config.get(
+                's3_disable_multiregion_access_points', False
+            ),
+            EndpointResolverBuiltins.AWS_REGION: region_name,
+        }
+
+    def _compute_sdk_endpoint_builtin(
+        self, endpoint_bridge, client_endpoint_url, legacy_endpoint_url
+    ):
+        if client_endpoint_url:
+            return client_endpoint_url
+        if not endpoint_bridge.endpoint_resolver.uses_builtin_data:
+            return legacy_endpoint_url
+        return None
