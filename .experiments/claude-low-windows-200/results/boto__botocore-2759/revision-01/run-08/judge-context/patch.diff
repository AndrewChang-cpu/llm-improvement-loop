+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock(botocore.regions.EndpointResolver)
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            endpoint_resolver=self.resolver,
+            scoped_config=None,
+            client_config=botocore.config.Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(
+        self,
+        region_name='ca-central-1',
+        service_name='fooservice',
+        s3_config=None,
+        client_endpoint_url=None,
+        legacy_endpoint_url=None,
+    ):
+        if s3_config is None:
+            s3_config = {}
+        if legacy_endpoint_url is None:
+            legacy_endpoint_url = self.legacy_url
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=region_name,
+            service_name=service_name,
+            s3_config=s3_config,
+            endpoint_bridge=self.bridge,
+            client_endpoint_url=client_endpoint_url,
+            legacy_endpoint_url=legacy_endpoint_url,
+        )
+
+    def test_returns_all_members_with_defaults(self):
+        result = self.compute()
+        self.assertEqual(set(result), set(EndpointResolverBuiltins))
+        self.assertEqual(result[EndpointResolverBuiltins.AWS_REGION], 'ca-central-1')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False)
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
+
+    def test_enum_values_are_strings(self):
+        self.assertEqual(EndpointResolverBuiltins.AWS_REGION, 'AWS::Region')
+        self.assertEqual(EndpointResolverBuiltins.SDK_ENDPOINT, 'SDK::Endpoint')
+
+    def test_fips_from_config_store_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_from_config_store_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self.compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+
+    def test_dualstack_s3_control_client_config_true(self):
+        self.bridge.client_config = botocore.config.Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_s3_control_client_config_false(self):
+        self.bridge.client_config = botocore.config.Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_dualstack_ignored_for_other_services(self):
+        self.bridge.client_config = botocore.config.Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self.compute(service_name='other-service')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_for_legacy_region(self):
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+
+    def test_sts_not_global_for_non_legacy_region(self):
+        result = self.compute(region_name='eu-south-1')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_sts_regional_config_disables_global(self):
+        self.config_store.set_config_variable('sts_regional_endpoints', 'regional')
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_s3_global_predicate_called_once(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self.compute(region_name='us-east-1')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True)
+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_s3_accelerate_true(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], True)
+
+    def test_s3_accelerate_false(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False)
+
+    def test_force_path_style_for_path(self):
+        result = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], True)
+
+    def test_force_path_style_false_for_auto_and_virtual(self):
+        for style in ('auto', 'virtual'):
+            result = self.compute(s3_config={'addressing_style': style})
+            self.assertIs(
+                result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+            )
+
+    def test_arn_region_false_for_both(self):
+        result = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False)
+
+    def test_arn_region_true_for_both(self):
+        result = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True)
+
+    def test_mrap_true(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], True)
+
+    def test_mrap_false(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False)
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute(client_endpoint_url='https://client.url')
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT], 'https://client.url'
+        )
+
+    def test_sdk_endpoint_legacy_url_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data_and_legacy_url(self):
+        # Despite the name, this sets the bundled-data flag to False.
+        self.resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data(self):
+        self.resolver.uses_builtin_data = True
+        result = self.compute()
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
+
+    def test_region_passed_through_unchanged(self):
+        result = self.compute(region_name='eu-west-1')
+        self.assertEqual(result[EndpointResolverBuiltins.AWS_REGION], 'eu-west-1')
