+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute the endpoint ruleset builtin values for one client.
+
+        This is a pure computation and is not called during client creation.
+        """
+        resolver_builtins = EndpointResolverBuiltins
+        uses_bundled_data = endpoint_bridge.endpoint_resolver.uses_builtin_data
+
+        # SDK::Endpoint is absent when bundled data is used and no client
+        # endpoint URL was given.
+        if client_endpoint_url:
+            sdk_endpoint = client_endpoint_url
+        elif not uses_bundled_data:
+            sdk_endpoint = legacy_endpoint_url
+        else:
+            sdk_endpoint = None
+
+        use_fips = endpoint_bridge._resolve_endpoint_variant_config_var(
+            'use_fips_endpoint'
+        )
+        use_dualstack = endpoint_bridge._resolve_use_dualstack_endpoint(
+            service_name
+        )
+
+        sts_global = self._should_set_global_sts_endpoint(
+            region_name, None, None
+        )
+        s3_global = self._should_force_s3_global(region_name, s3_config)
+
+        return {
+            resolver_builtins.AWS_REGION: region_name,
+            resolver_builtins.AWS_USE_FIPS: use_fips or False,
+            resolver_builtins.AWS_USE_DUALSTACK: use_dualstack or False,
+            resolver_builtins.AWS_STS_USE_GLOBAL_ENDPOINT: sts_global,
+            resolver_builtins.AWS_S3_USE_GLOBAL_ENDPOINT: s3_global,
+            resolver_builtins.AWS_S3_ACCELERATE: s3_config.get(
+                'use_accelerate_endpoint', False
+            ),
+            resolver_builtins.AWS_S3_FORCE_PATH_STYLE: (
+                s3_config.get('addressing_style') == 'path'
+            ),
+            resolver_builtins.AWS_S3_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', True
+            ),
+            resolver_builtins.AWS_S3CONTROL_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', False
+            ),
+            resolver_builtins.AWS_S3_DISABLE_MRAP: s3_config.get(
+                's3_disable_multiregion_access_points', False
+            ),
+            resolver_builtins.SDK_ENDPOINT: sdk_endpoint,
+        }
