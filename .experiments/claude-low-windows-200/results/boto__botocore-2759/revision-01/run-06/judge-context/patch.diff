+class EndpointResolverBuiltins(str, enum.Enum):
+    """Builtin names consumed by endpoint rulesets."""
+
+    # str: the region name for the client.
+    AWS_REGION = 'AWS::Region'
+    # bool: whether FIPS endpoints are in use.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # bool: whether DualStack endpoints are in use.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # bool: whether STS should use the global endpoint.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # bool: whether S3 should use the global endpoint.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # bool: whether S3 accelerate endpoints are in use.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # bool: whether S3 path-style addressing is forced.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # bool by default; raw config value otherwise: S3 ARN region usage.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # bool by default; raw config value otherwise: S3Control ARN region usage.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # bool: whether S3 multi-region access points are disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # str or absent: the SDK endpoint URL.
+    SDK_ENDPOINT = 'SDK::Endpoint'
