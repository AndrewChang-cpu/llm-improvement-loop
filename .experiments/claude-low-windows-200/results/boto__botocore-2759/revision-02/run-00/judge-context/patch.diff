+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock(EndpointResolver)
+        self.resolver.uses_builtin_data = True
+        self.bridge = self._build_bridge()
+        self.region = 'ca-central-1'
+        self.service = 'fooservice'
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _build_bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=client_config or Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        call_kwargs = {
+            'region_name': self.region,
+            'service_name': self.service,
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        call_kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **call_kwargs
+        )
+
+    def test_default_builtins(self):
+        result = self._compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.AWS_REGION], 'ca-central-1'
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_FIPS])
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT]
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE])
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION]
+        )
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP]
+        )
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
+
+    def test_fips_from_config_store_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_USE_FIPS])
+
+    def test_fips_from_config_store_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_FIPS])
+
+    def test_dualstack_s3control_client_config_true(self):
+        bridge = self._build_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_dualstack_s3control_client_config_false(self):
+        bridge = self._build_bridge(
+            Config(s3={'use_dualstack_endpoint': False})
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_dualstack_other_service_ignores_s3_setting(self):
+        bridge = self._build_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_sts_global_for_us_west_2_default_config(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_sts_not_global_for_eu_south_1(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_sts_not_global_for_us_west_2_regional_sts_config(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_s3_global_uses_predicate_result(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self._compute()
+        predicate.assert_called_once_with(self.region, {})
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_s3_accelerate_true(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE])
+
+    def test_s3_accelerate_false(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE])
+
+    def test_s3_force_path_style_with_path_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+
+    def test_s3_force_path_style_with_auto_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'auto'})
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+
+    def test_s3_force_path_style_with_virtual_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+
+    def test_use_arn_region_false(self):
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION]
+        )
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+
+    def test_use_arn_region_true(self):
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+
+    def test_disable_mrap_true(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP])
+
+    def test_disable_mrap_false(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP])
+
+    def test_sdk_endpoint_client_url_overrides_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.endpoint.com',
+        )
+
+    def test_sdk_endpoint_legacy_url_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data(self):
+        result = self._compute()
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
