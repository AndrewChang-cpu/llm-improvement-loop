+class EndpointResolverBuiltins(str, Enum):
+    """Names of the builtin parameters consumed by endpoint rulesets."""
+
+    # Region name for the request. str.
+    AWS_REGION = 'AWS::Region'
+    # Whether FIPS endpoints are requested. bool.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Whether DualStack endpoints are requested. bool.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Whether STS should use the global endpoint. bool.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Whether S3 should use the global endpoint. bool.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Whether S3 transfer acceleration is requested. bool.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Whether S3 path-style addressing is forced. bool.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Whether S3 honors ARN regions. bool by default; raw config otherwise.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Whether S3Control honors ARN regions. bool by default; raw config
+    # value otherwise.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Whether multi-region access points are disabled. bool.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # Endpoint URL override for the SDK. str, or None when absent.
+    SDK_ENDPOINT = 'SDK::Endpoint'
