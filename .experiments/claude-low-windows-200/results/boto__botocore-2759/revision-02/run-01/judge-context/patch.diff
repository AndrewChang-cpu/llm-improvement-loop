+        )
+
+    def test_arn_region_true_enables_both_arn_region_builtins(self):
+        builtins = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(
+            builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True
