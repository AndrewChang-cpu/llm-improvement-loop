+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter,
+            None,
+            None,
+            None,
+            None,
+            self.config_store,
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            endpoint_resolver=self.resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_builtins(self):
+        expected = {
+            EPRBuiltins.AWS_REGION: 'ca-central-1',
+            EPRBuiltins.AWS_USE_FIPS: False,
+            EPRBuiltins.AWS_USE_DUALSTACK: False,
+            EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: True,
+            EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: False,
+            EPRBuiltins.AWS_S3_ACCELERATE: False,
+            EPRBuiltins.AWS_S3_FORCE_PATH_STYLE: False,
+            EPRBuiltins.AWS_S3_USE_ARN_REGION: True,
+            EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION: False,
+            EPRBuiltins.AWS_S3_DISABLE_MRAP: False,
+            EPRBuiltins.SDK_ENDPOINT: None,
+        }
+        self.assertEqual(self._compute(), expected)
+
+    def test_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._compute()
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._compute()
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_FIPS], False)
+
+    def test_dualstack_true_for_s3control_with_s3_client_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self._compute(service_name='s3-control')
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_false_for_s3control_with_s3_client_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        builtins = self._compute(service_name='s3-control')
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_dualstack_false_for_other_service_with_s3_client_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self._compute(service_name='other-service')
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_true_for_us_west_2_default_config(self):
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+
+    def test_sts_global_false_for_eu_south_1(self):
+        builtins = self._compute(region_name='eu-south-1')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_sts_global_false_for_us_west_2_with_regional_sts(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_s3_global_true_when_s3_predicate_true(self):
