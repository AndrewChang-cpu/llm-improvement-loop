+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = self._make_bridge()
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _make_bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_builtins(self):
+        result = self._compute()
+        self.assertEqual(result[EPRBuiltins.AWS_REGION], 'ca-central-1')
+        self.assertIs(result[EPRBuiltins.AWS_USE_FIPS], False)
+        self.assertIs(result[EPRBuiltins.AWS_USE_DUALSTACK], False)
+        self.assertIs(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+        self.assertIs(result[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], False)
+        self.assertIs(result[EPRBuiltins.AWS_S3_ACCELERATE], False)
+        self.assertIs(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+        self.assertIs(result[EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False)
+        self.assertIs(result[EPRBuiltins.AWS_S3_DISABLE_MRAP], False)
+        self.assertIsNone(result[EPRBuiltins.SDK_ENDPOINT])
+
+    def test_fips_from_config_store_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertIs(result[EPRBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_from_config_store_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertIs(result[EPRBuiltins.AWS_USE_FIPS], False)
+
+    def test_dualstack_s3_control_client_config_true(self):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(result[EPRBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_s3_control_client_config_false(self):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': False})
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(result[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_dualstack_other_service_ignores_s3_setting(self):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertIs(result[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_endpoint_for_us_west_2(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+
+    def test_sts_global_endpoint_false_for_eu_south_1(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertIs(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_sts_global_endpoint_false_when_regional(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_s3_global_endpoint_uses_predicate(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self._compute(s3_config={'x': 1})
+        self.assertIs(result[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True)
+        predicate.assert_called_once_with('ca-central-1', {'x': 1})
+
+    def test_s3_accelerate_true(self):
+        result = self._compute(
+            s3_config={'use_accelerate_endpoint': True}
+        )
+        self.assertIs(result[EPRBuiltins.AWS_S3_ACCELERATE], True)
+
+    def test_s3_accelerate_false(self):
+        result = self._compute(
+            s3_config={'use_accelerate_endpoint': False}
+        )
+        self.assertIs(result[EPRBuiltins.AWS_S3_ACCELERATE], False)
+
+    def test_force_path_style_for_path_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], True)
+
+    def test_force_path_style_false_for_auto_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'auto'})
+        self.assertIs(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_force_path_style_false_for_virtual_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_arn_region_false_disables_s3_and_s3control(self):
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(result[EPRBuiltins.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(
+            result[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False
+        )
+
+    def test_arn_region_true_enables_s3_and_s3control(self):
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(result[EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True)
+
+    def test_disable_mrap_true(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(result[EPRBuiltins.AWS_S3_DISABLE_MRAP], True)
+
+    def test_disable_mrap_false(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(result[EPRBuiltins.AWS_S3_DISABLE_MRAP], False)
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            result[EPRBuiltins.SDK_ENDPOINT], 'https://client.endpoint.com'
+        )
+
+    def test_sdk_endpoint_legacy_url_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute()
+        self.assertEqual(result[EPRBuiltins.SDK_ENDPOINT], self.legacy_url)
+
+    def test_sdk_endpoint_absent_with_bundled_data(self):
+        result = self._compute()
+        self.assertIsNone(result[EPRBuiltins.SDK_ENDPOINT])
+
