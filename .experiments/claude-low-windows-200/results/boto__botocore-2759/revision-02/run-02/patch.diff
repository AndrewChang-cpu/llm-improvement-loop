+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_s3_accelerate_true(self):
+        builtins = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_ACCELERATE], True)
+
+    def test_s3_accelerate_false(self):
+        builtins = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_ACCELERATE], False)
+
+    def test_s3_force_path_style_addressing_style_path(self):
+        builtins = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], True)
+
+    def test_s3_force_path_style_addressing_style_auto(self):
+        builtins = self.compute(s3_config={'addressing_style': 'auto'})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_s3_force_path_style_addressing_style_virtual(self):
