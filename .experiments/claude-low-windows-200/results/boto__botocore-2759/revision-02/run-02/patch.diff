+        self.assertIs(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_arn_region_use_arn_region_false(self):
+        builtins = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(
+            builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False
+        )
+
+    def test_arn_region_use_arn_region_true(self):
+        builtins = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True)
+
+    def test_s3_disable_mrap_true(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP], True)
+
+    def test_s3_disable_mrap_false(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP], False)
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data_and_legacy(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            builtins[EPRBuiltins.SDK_ENDPOINT], 'https://client.endpoint.com'
+        )
+
+    def test_sdk_endpoint_custom_data_uses_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute()
+        self.assertEqual(builtins[EPRBuiltins.SDK_ENDPOINT], self.legacy_url)
+
+    def test_sdk_endpoint_bundled_data_is_absent_despite_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = True
+        builtins = self.compute()
+        self.assertIsNone(builtins[EPRBuiltins.SDK_ENDPOINT])
