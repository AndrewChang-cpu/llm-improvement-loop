+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_values(self):
+        builtins = self._compute()
+        B = EPRBuiltins
+        self.assertEqual(builtins[B.AWS_REGION], 'ca-central-1')
+        self.assertIs(builtins[B.AWS_USE_FIPS], False)
+        self.assertIs(builtins[B.AWS_USE_DUALSTACK], False)
+        self.assertIs(builtins[B.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+        self.assertIs(builtins[B.AWS_S3_USE_GLOBAL_ENDPOINT], False)
+        self.assertIs(builtins[B.AWS_S3_ACCELERATE], False)
+        self.assertIs(builtins[B.AWS_S3_FORCE_PATH_STYLE], False)
+        self.assertIs(builtins[B.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(builtins[B.AWS_S3CONTROL_USE_ARN_REGION], False)
+        self.assertIs(builtins[B.AWS_S3_DISABLE_MRAP], False)
+        self.assertIsNone(builtins[B.SDK_ENDPOINT])
+
+    def test_returns_all_eleven_builtins(self):
+        builtins = self._compute(service_name='s3')
+        self.assertEqual(set(builtins), set(EPRBuiltins))
+        self.assertEqual(len(builtins), 11)
+
+    def test_use_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._compute()
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_FIPS], True)
+
+    def test_use_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._compute()
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_FIPS], False)
+
+    def test_s3control_dualstack_true_from_client_config(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self._compute(service_name='s3-control')
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_s3control_dualstack_false_from_client_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        builtins = self._compute(service_name='s3-control')
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_dualstack_ignores_s3_setting_for_other_service(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self._compute(service_name='other-service')
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_in_us_west_2_with_default_config(self):
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+
+    def test_sts_not_global_in_eu_south_1(self):
+        builtins = self._compute(region_name='eu-south-1')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_sts_not_global_in_us_west_2_with_regional_config(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_s3_global_when_predicate_returns_true(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self._compute()
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True)
+        predicate.assert_called_once_with('ca-central-1', {})
+
+    def test_accelerate_true_from_s3_config(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_ACCELERATE], True)
+
+    def test_accelerate_false_from_s3_config(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_ACCELERATE], False)
+
+    def test_force_path_style_true_for_path_addressing(self):
+        builtins = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], True)
+
+    def test_force_path_style_false_for_auto_addressing(self):
+        builtins = self._compute(s3_config={'addressing_style': 'auto'})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_force_path_style_false_for_virtual_addressing(self):
+        builtins = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_arn_region_false_disables_s3_and_s3control(self):
+        builtins = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(
+            builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False
+        )
+
+    def test_arn_region_true_enables_s3_and_s3control(self):
+        builtins = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(
+            builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True
+        )
+
+    def test_mrap_true_from_s3_config(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP], True)
+
+    def test_mrap_false_from_s3_config(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP], False)
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data_and_legacy(self):
+        self.resolver.uses_builtin_data = False
+        builtins = self._compute(client_endpoint_url='https://client.url')
+        self.assertEqual(
+            builtins[EPRBuiltins.SDK_ENDPOINT], 'https://client.url'
+        )
+
+    def test_sdk_endpoint_legacy_url_used_for_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        builtins = self._compute()
+        self.assertEqual(builtins[EPRBuiltins.SDK_ENDPOINT], self.legacy_url)
+
+    def test_sdk_endpoint_absent_for_bundled_data_with_legacy_url(self):
+        builtins = self._compute()
+        self.assertIsNone(builtins[EPRBuiltins.SDK_ENDPOINT])
