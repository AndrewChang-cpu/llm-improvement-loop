+class EndpointResolverBuiltins(str, Enum):
+    """Builtin names consumed by endpoint rulesets."""
+
+    # Type: string. The region name given for client creation.
+    AWS_REGION = 'AWS::Region'
+    # Type: boolean. Whether FIPS endpoints are requested.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Type: boolean. Whether DualStack endpoints are requested.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Type: boolean. Whether STS should use the global endpoint.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Type: boolean. Whether S3 should use the global endpoint.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Type: boolean. Whether S3 accelerate endpoints are used.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Type: boolean. Whether S3 path-style addressing is forced.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Type: boolean by default; the raw config value when configured.
+    # Whether S3 ARNs may override the region.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Type: boolean by default; the raw config value when configured.
+    # Whether S3Control ARNs may override the region.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Type: boolean. Whether S3 multi-region access points are disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # Type: string, or absent (None). The SDK endpoint value: the client
+    # endpoint URL if set, else the legacy endpoint URL when the resolver
+    # uses custom data, else absent.
+    SDK_ENDPOINT = 'SDK::Endpoint'
