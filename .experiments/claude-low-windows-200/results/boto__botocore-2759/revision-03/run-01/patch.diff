+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock(EndpointResolver)
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        kwargs = dict(
+            region_name='ca-central-1',
+            service_name='fooservice',
+            s3_config={},
+            endpoint_bridge=self.bridge,
+            client_endpoint_url=None,
+            legacy_endpoint_url='https://my.legacy.endpoint.com',
+        )
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_builtin_values(self):
+        result = self._compute()
+        self.assertEqual(set(result), set(EndpointResolverBuiltins))
+        self.assertEqual(result[EndpointResolverBuiltins.AWS_REGION],
+                         'ca-central-1')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK],
+                      False)
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE],
+                      False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE],
+                      False)
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION],
+                      True)
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+        self.assertIs(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP],
+                      False)
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
+
+    def test_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+
+    def test_dualstack_true_for_s3control_with_s3_client_config(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        result = self._compute(service_name='s3-control')
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_false_for_s3control_with_s3_client_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        result = self._compute(service_name='s3-control')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_dualstack_false_for_other_service_with_s3_client_config(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        result = self._compute(service_name='other-service')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_sts_global_true_in_legacy_region(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+
+    def test_sts_global_false_outside_legacy_regions(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+
+    def test_sts_global_false_with_regional_sts_config(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+
+    def test_s3_global_true_when_predicate_true(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self._compute(region_name='us-east-1', s3_config={})
+        predicate.assert_called_once_with('us-east-1', {})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+
+    def test_s3_accelerate_true_passes_through(self):
+        result = self._compute(
+            s3_config={'use_accelerate_endpoint': True}
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], True
+        )
+
+    def test_s3_accelerate_false_passes_through(self):
+        result = self._compute(
+            s3_config={'use_accelerate_endpoint': False}
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False
+        )
+
+    def test_force_path_style_true_for_path_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], True
+        )
+
+    def test_force_path_style_false_for_auto_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'auto'})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+        )
+
+    def test_force_path_style_false_for_virtual_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+        )
+
+    def test_use_arn_region_false_applies_to_s3_and_s3control(self):
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], False
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+
+    def test_use_arn_region_true_applies_to_s3_and_s3control(self):
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            True,
+        )
+
+    def test_mrap_true_passes_through(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], True
+        )
+
+    def test_mrap_false_passes_through(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False
+        )
+
+    def test_sdk_endpoint_client_url_beats_legacy_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.endpoint.com',
+        )
+
+    def test_sdk_endpoint_legacy_url_with_custom_endpoint_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://my.legacy.endpoint.com',
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data_and_legacy_url(self):
+        result = self._compute()
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
