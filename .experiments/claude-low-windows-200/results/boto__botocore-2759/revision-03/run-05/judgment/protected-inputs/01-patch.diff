+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+
+    def _make_bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        call_kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self._make_bridge(),
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': 'https://my.legacy.endpoint.com',
+        }
+        call_kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **call_kwargs
+        )
+
+    def test_default_builtins(self):
+        builtins = self._compute()
+        self.assertEqual(builtins['AWS::Region'], 'ca-central-1')
+        self.assertEqual(builtins['AWS::UseFIPS'], False)
+        self.assertEqual(builtins['AWS::UseDualStack'], False)
+        self.assertEqual(builtins['AWS::STS::UseGlobalEndpoint'], True)
+        self.assertEqual(builtins['AWS::S3::UseGlobalEndpoint'], False)
+        self.assertEqual(builtins['AWS::S3::Accelerate'], False)
+        self.assertEqual(builtins['AWS::S3::ForcePathStyle'], False)
+        self.assertEqual(builtins['AWS::S3::UseArnRegion'], True)
+        self.assertEqual(builtins['AWS::S3Control::UseArnRegion'], False)
+        self.assertEqual(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+        self.assertIsNone(builtins['SDK::Endpoint'])
+
+    def test_use_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._compute()
+        self.assertEqual(builtins['AWS::UseFIPS'], True)
+
+    def test_use_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._compute()
+        self.assertEqual(builtins['AWS::UseFIPS'], False)
+
+    def test_s3_control_dualstack_true_from_client_config(self):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': True})
+        )
+        builtins = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertEqual(builtins['AWS::UseDualStack'], True)
+
+    def test_s3_control_dualstack_false_from_client_config(self):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': False})
+        )
+        builtins = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertEqual(builtins['AWS::UseDualStack'], False)
+
+    def test_other_service_ignores_s3_dualstack_setting(self):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': True})
+        )
+        builtins = self._compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertEqual(builtins['AWS::UseDualStack'], False)
+
+    def test_sts_global_for_us_west_2_default_configuration(self):
+        builtins = self._compute(region_name='us-west-2')
+        self.assertEqual(builtins['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_sts_not_global_for_eu_south_1(self):
+        builtins = self._compute(region_name='eu-south-1')
+        self.assertEqual(builtins['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_sts_not_global_for_us_west_2_with_regional_config(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._compute(region_name='us-west-2')
+        self.assertEqual(builtins['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_global_true_calls_predicate_once(self):
+        with mock.patch.object(
