+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute endpoint resolver builtin values for one client.
+
+        Returns a dict keyed by EndpointResolverBuiltins members.
+        """
+        bridge = endpoint_bridge
+        use_fips = bridge._resolve_endpoint_variant_config_var(
+            'use_fips_endpoint'
+        )
+        use_dualstack = bridge._resolve_use_dualstack_endpoint(service_name)
+        sts_global = self._should_set_global_sts_endpoint(
+            region_name, None, None
+        )
+        s3_global = self._should_force_s3_global(region_name, s3_config)
+        return {
+            EPRBuiltins.SDK_ENDPOINT: self._resolve_sdk_endpoint(
+                client_endpoint_url, legacy_endpoint_url, bridge
+            ),
+            EPRBuiltins.AWS_USE_FIPS: use_fips or False,
+            EPRBuiltins.AWS_USE_DUALSTACK: use_dualstack or False,
+            EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: sts_global,
+            EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: s3_global,
+            EPRBuiltins.AWS_S3_ACCELERATE: s3_config.get(
+                'use_accelerate_endpoint', False
+            ),
+            EPRBuiltins.AWS_S3_FORCE_PATH_STYLE: (
+                s3_config.get('addressing_style') == 'path'
+            ),
+            EPRBuiltins.AWS_S3_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', True
+            ),
+            EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', False
+            ),
+            EPRBuiltins.AWS_S3_DISABLE_MRAP: s3_config.get(
+                's3_disable_multiregion_access_points', False
+            ),
+            EPRBuiltins.AWS_REGION: region_name,
+        }
+
+    def _resolve_sdk_endpoint(
+        self, client_endpoint_url, legacy_endpoint_url, endpoint_bridge
+    ):
+        # Precedence: the client endpoint URL, then the legacy endpoint URL
+        # when the resolver uses custom (non-bundled) endpoint data. With
+        # bundled data and no client URL, the value is None (absent).
+        if client_endpoint_url:
+            return client_endpoint_url
+        resolver = endpoint_bridge.endpoint_resolver
+        if not resolver.uses_builtin_data:
+            return legacy_endpoint_url
+        return None
