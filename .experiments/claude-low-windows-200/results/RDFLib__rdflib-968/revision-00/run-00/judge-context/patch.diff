--- a/docs/utilities.rst
+++ b/docs/utilities.rst
@@ -22,6 +22,38 @@ Use :meth:`~rdflib.graph.Graph.value` and
 :meth:`~rdflib.graph.Graph.set` to work with :term:`functional
 properties`, i.e. properties than can only occur once for a resource.
 
+Concise Bounded Descriptions
+----------------------------
+
+To extract everything a graph says about a resource, use
+:meth:`~rdflib.graph.Graph.cbd`. It returns a new graph containing the
+*Concise Bounded Description* of the resource, as defined by the W3C
+member submission `CBD - Concise Bounded Description
+<https://www.w3.org/Submission/CBD/>`_:
+
+* every triple whose subject is the resource;
+* for every blank node reached as an object, that blank node's triples,
+  recursively;
+* reified statements (``rdf:Statement`` nodes) that describe a statement
+  already in the description.
+
+Triples about other URIs are left out, so the result is a small,
+self-contained subgraph. The source graph is not modified::
+
+    >>> from rdflib import Graph, URIRef, Literal, BNode
+    >>> g = Graph()
+    >>> alice = URIRef("http://example.org/alice")
+    >>> bob = URIRef("http://example.org/bob")
+    >>> knows = URIRef("http://xmlns.com/foaf/0.1/knows")
+    >>> name = URIRef("http://xmlns.com/foaf/0.1/name")
+    >>> g.add((alice, knows, bob))
+    >>> g.add((bob, name, Literal("Bob")))
+    >>> len(g.cbd(alice))
+    1
+
+``cbd`` is also the building block for describing resources in SPARQL
+``DESCRIBE`` queries.
+
 Slicing graphs
 --------------
 
diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..95e16d0 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1165,6 +1165,83 @@ class Graph(Node):
         else:
             return False
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource
+
+        The Concise Bounded Description (CBD) of a resource is the subgraph
+        of this graph that is needed to describe it, following the rules of
+        the W3C member submission "CBD - Concise Bounded Description"
+        (https://www.w3.org/Submission/CBD/):
+
+        1. Every triple whose subject is the resource is included.
+        2. For every triple included so far whose object is a blank node,
+           the blank node's own description is included, recursively.
+        3. Reification: if a statement (s, p, o) is in the subgraph and a
+           blank node of type ``rdf:Statement`` reifies it (via
+           ``rdf:subject``, ``rdf:predicate`` and ``rdf:object``), that
+           blank node is described as in rule 2.
+
+        Parameters:
+            resource: the URIRef (or BNode) to describe.
+
+        Returns:
+            a new ``Graph`` containing the CBD. Triples are copied, so the
+            original graph is not modified.
+
+        Example::
+
+            >>> from rdflib import Graph, URIRef, Literal, BNode
+            >>> g = Graph()
+            >>> alice = URIRef("http://example.org/alice")
+            >>> bob = URIRef("http://example.org/bob")
+            >>> name = URIRef("http://xmlns.com/foaf/0.1/name")
+            >>> knows = URIRef("http://xmlns.com/foaf/0.1/knows")
+            >>> based_near = URIRef("http://xmlns.com/foaf/0.1/based_near")
+            >>> addr = BNode()
+            >>> g.add((alice, name, Literal("Alice")))
+            >>> g.add((alice, knows, bob))
+            >>> g.add((alice, based_near, addr))
+            >>> g.add((addr, name, Literal("Somewhere")))
+            >>> len(g.cbd(alice))
+            4
+
+        Triples about other URIs (here, ``bob``) are not part of the CBD
+        unless they are reachable through blank nodes.
+        """
+        subgraph = Graph()
+        described = set()
+
+        def describe(node):
+            if node in described:
+                return
+            described.add(node)
+            for s, p, o in self.triples((node, None, None)):
+                subgraph.add((s, p, o))
+                if isinstance(o, BNode):
+                    describe(o)
+
+        describe(resource)
+
+        # Reification: keep describing reifying statement nodes until no
+        # new ones are found. Each pass visits at least one new node, so
+        # this terminates.
+        changed = True
+        while changed:
+            changed = False
+            for stmt in self.subjects(RDF.type, RDF.Statement):
+                if stmt in described:
+                    continue
+                s = self.value(stmt, RDF.subject, None)
+                p = self.value(stmt, RDF.predicate, None)
+                o = self.value(stmt, RDF.object, None)
+                if s is None or p is None or o is None:
+                    continue
+                if (s, p, o) in subgraph:
+                    describe(stmt)
+                    changed = True
+
+        return subgraph
+
     def all_nodes(self):
         res = set(self.objects())
         res.update(self.subjects())
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..87c753e
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,119 @@
+import unittest
+
+from rdflib import BNode, Graph, Literal, URIRef
+from rdflib.namespace import RDF, RDFS
+
+
+EX = "http://example.org/"
+
+
+class CBDTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.g = Graph()
+        self.alice = URIRef(EX + "alice")
+        self.bob = URIRef(EX + "bob")
+        self.knows = URIRef(EX + "knows")
+        self.name = URIRef(EX + "name")
+        self.label = URIRef(EX + "label")
+
+    def test_includes_triples_with_resource_as_subject(self):
+        self.g.add((self.alice, self.name, Literal("Alice")))
+        self.g.add((self.alice, self.knows, self.bob))
+        self.g.add((self.bob, self.name, Literal("Bob")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 2)
+        self.assertIn((self.alice, self.name, Literal("Alice")), cbd)
+        self.assertIn((self.alice, self.knows, self.bob), cbd)
+        self.assertNotIn((self.bob, self.name, Literal("Bob")), cbd)
+
+    def test_excludes_triples_with_resource_as_object_only(self):
+        self.g.add((self.alice, self.name, Literal("Alice")))
+        self.g.add((self.bob, self.knows, self.alice))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 1)
+        self.assertNotIn((self.bob, self.knows, self.alice), cbd)
+
+    def test_follows_blank_nodes_recursively(self):
+        b1 = BNode()
+        b2 = BNode()
+        self.g.add((self.alice, self.name, Literal("Alice")))
+        self.g.add((self.alice, self.knows, b1))
+        self.g.add((b1, self.name, Literal("Inner")))
+        self.g.add((b1, self.knows, b2))
+        self.g.add((b2, self.label, Literal("Deepest")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 5)
+        self.assertIn((b2, self.label, Literal("Deepest")), cbd)
+
+    def test_does_not_follow_uri_objects(self):
+        self.g.add((self.alice, self.knows, self.bob))
+        self.g.add((self.bob, self.name, Literal("Bob")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 1)
+
+    def test_handles_blank_node_cycles(self):
+        b1 = BNode()
+        b2 = BNode()
+        self.g.add((self.alice, self.knows, b1))
+        self.g.add((b1, self.knows, b2))
+        self.g.add((b2, self.knows, b1))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 3)
+
+    def test_includes_reified_statements(self):
+        stmt = BNode()
+        self.g.add((self.alice, self.knows, self.bob))
+        self.g.add((stmt, RDF.type, RDF.Statement))
+        self.g.add((stmt, RDF.subject, self.alice))
+        self.g.add((stmt, RDF.predicate, self.knows))
+        self.g.add((stmt, RDF.object, self.bob))
+        self.g.add((stmt, RDFS.comment, Literal("reified")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertIn((stmt, RDFS.comment, Literal("reified")), cbd)
+        self.assertIn((stmt, RDF.type, RDF.Statement), cbd)
+
+    def test_does_not_include_unrelated_reified_statements(self):
+        stmt = BNode()
+        self.g.add((self.alice, self.name, Literal("Alice")))
+        self.g.add((stmt, RDF.type, RDF.Statement))
+        self.g.add((stmt, RDF.subject, self.bob))
+        self.g.add((stmt, RDF.predicate, self.knows))
+        self.g.add((stmt, RDF.object, self.alice))
+        self.g.add((stmt, RDFS.comment, Literal("not reified in cbd")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 1)
+
+    def test_unknown_resource_gives_empty_graph(self):
+        self.g.add((self.alice, self.name, Literal("Alice")))
+
+        cbd = self.g.cbd(URIRef(EX + "nobody"))
+
+        self.assertIsInstance(cbd, Graph)
+        self.assertEqual(len(cbd), 0)
+
+    def test_does_not_modify_source_graph(self):
+        self.g.add((self.alice, self.knows, self.bob))
+        before = len(self.g)
+
+        self.g.cbd(self.alice).add((self.bob, self.name, Literal("X")))
+
+        self.assertEqual(len(self.g), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
