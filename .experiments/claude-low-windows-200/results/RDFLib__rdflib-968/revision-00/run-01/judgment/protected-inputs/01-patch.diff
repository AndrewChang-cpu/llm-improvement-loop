index 4a27e6d..e538bee 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1170,6 +1170,62 @@ class Graph(Node):
         res.update(self.subjects())
         return res
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C member
+        submission at https://www.w3.org/Submission/CBD/ and is the
+        subgraph that describes ``resource``. It is built from these rules:
+
+        1. Every triple whose subject is ``resource`` is included.
+        2. If the object of an included triple is a blank node, every triple
+           whose subject is that blank node is included, and the same rules
+           are applied recursively to the blank node.
+        3. Reification: for every blank node ``x`` typed ``rdf:Statement``
+           with ``rdf:subject`` equal to ``resource``, the triples whose
+           subject is ``x`` are included (and rule 2 is applied to them).
+
+        Blank nodes are tracked so that cycles terminate.
+
+        The result is returned as a new in-memory :class:`Graph`; this graph
+        is not modified.
+
+        >>> from rdflib import Graph, URIRef, BNode, Literal, RDF
+        >>> from rdflib.namespace import FOAF
+        >>> g = Graph()
+        >>> alice = URIRef("http://example.org/alice")
+        >>> address = BNode()
+        >>> g.add((alice, FOAF.name, Literal("Alice")))
+        >>> g.add((alice, FOAF.knows, URIRef("http://example.org/bob")))
+        >>> g.add((alice, URIRef("http://example.org/address"), address))
+        >>> g.add((address, URIRef("http://example.org/city"), Literal("Oslo")))
+        >>> len(g.cbd(alice))
+        4
+
+        :param resource: the node (usually a URIRef) to describe
+        :returns: a :class:`Graph` containing the concise bounded description
+        """
+        subgraph = Graph()
+        seen = set()
+        stack = [resource]
+
+        # Reified statements about the resource (rule 3)
+        for statement in self.subjects(RDF.subject, resource):
+            if (statement, RDF.type, RDF.Statement) in self:
+                stack.append(statement)
+
+        while stack:
+            node = stack.pop()
+            if node in seen:
+                continue
+            seen.add(node)
+            for s, p, o in self.triples((node, None, None)):
+                subgraph.add((s, p, o))
+                if isinstance(o, BNode) and o not in seen:
+                    stack.append(o)
+
+        return subgraph
+
