diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..dc7bdfb
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,116 @@
+import unittest
+
+from rdflib import BNode, Graph, Literal, URIRef
+from rdflib.namespace import RDF
+
+
+EX = "http://example.org/"
+
+
+class CBDTestCase(unittest.TestCase):
+    def setUp(self):
+        self.g = Graph()
+        self.alice = URIRef(EX + "alice")
+        self.bob = URIRef(EX + "bob")
+        self.knows = URIRef(EX + "knows")
+        self.name = URIRef(EX + "name")
+        self.address = URIRef(EX + "address")
+        self.city = URIRef(EX + "city")
+
+    def test_direct_triples_only(self):
+        self.g.add((self.alice, self.name, Literal("Alice")))
+        self.g.add((self.alice, self.knows, self.bob))
+        self.g.add((self.bob, self.name, Literal("Bob")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 2)
+        self.assertIn((self.alice, self.name, Literal("Alice")), cbd)
+        self.assertIn((self.alice, self.knows, self.bob), cbd)
+        self.assertNotIn((self.bob, self.name, Literal("Bob")), cbd)
+
+    def test_incoming_triples_excluded(self):
+        self.g.add((self.bob, self.knows, self.alice))
+        self.g.add((self.alice, self.name, Literal("Alice")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 1)
+        self.assertNotIn((self.bob, self.knows, self.alice), cbd)
+
+    def test_blank_node_closure(self):
+        addr = BNode()
+        self.g.add((self.alice, self.address, addr))
+        self.g.add((addr, self.city, Literal("Oslo")))
+        self.g.add((addr, self.name, Literal("Home")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 3)
+        self.assertIn((addr, self.city, Literal("Oslo")), cbd)
+        self.assertIn((addr, self.name, Literal("Home")), cbd)
+
+    def test_nested_blank_nodes(self):
+        inner = BNode()
+        outer = BNode()
+        self.g.add((self.alice, self.address, outer))
+        self.g.add((outer, self.address, inner))
+        self.g.add((inner, self.city, Literal("Oslo")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 3)
+        self.assertIn((inner, self.city, Literal("Oslo")), cbd)
+
+    def test_blank_node_cycle_terminates(self):
+        a = BNode()
+        b = BNode()
+        self.g.add((self.alice, self.address, a))
+        self.g.add((a, self.knows, b))
+        self.g.add((b, self.knows, a))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 3)
+
+    def test_uri_objects_not_followed(self):
+        self.g.add((self.alice, self.knows, self.bob))
+        self.g.add((self.bob, self.name, Literal("Bob")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertEqual(len(cbd), 1)
+
+    def test_reification(self):
+        stmt = BNode()
+        self.g.add((self.alice, self.knows, self.bob))
+        self.g.add((stmt, RDF.type, RDF.Statement))
+        self.g.add((stmt, RDF.subject, self.alice))
+        self.g.add((stmt, RDF.predicate, self.knows))
+        self.g.add((stmt, RDF.object, self.bob))
+        self.g.add((stmt, self.name, Literal("assertion")))
+
+        cbd = self.g.cbd(self.alice)
+
+        self.assertIn((stmt, self.name, Literal("assertion")), cbd)
+        self.assertIn((stmt, RDF.type, RDF.Statement), cbd)
+
+    def test_unknown_resource_gives_empty_graph(self):
+        self.g.add((self.alice, self.name, Literal("Alice")))
+
+        cbd = self.g.cbd(self.bob)
+
+        self.assertEqual(len(cbd), 0)
+        self.assertIsInstance(cbd, Graph)
+
+    def test_source_graph_unchanged(self):
+        self.g.add((self.alice, self.name, Literal("Alice")))
+        before = len(self.g)
+
+        self.g.cbd(self.alice)
+
+        self.assertEqual(len(self.g), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
