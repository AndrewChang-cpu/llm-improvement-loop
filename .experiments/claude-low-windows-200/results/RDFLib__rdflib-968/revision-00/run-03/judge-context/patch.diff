diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..2567688 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1170,6 +1170,60 @@ class Graph(Node):
         res.update(self.subjects())
         return res
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C member
+        submission at https://www.w3.org/Submission/CBD/
+
+        The CBD of a resource is the subgraph made of:
+
+        - every triple whose subject is the resource, and
+        - for each blank node object of such a triple, recursively, every
+          triple whose subject is that blank node.
+
+        Parameters:
+
+        - ``resource``: a URIRef or BNode instance (or a value that can be
+          converted to a URIRef).
+
+        Returns a new ``Graph`` containing the CBD. The triples are copied
+        from this graph; this graph is not modified.
+
+        Example::
+
+            >>> from rdflib import Graph, URIRef, BNode, Literal, Namespace
+            >>> EX = Namespace("http://example.org/")
+            >>> g = Graph()
+            >>> g.add((EX.alice, EX.knows, EX.bob))
+            >>> g.add((EX.alice, EX.address, BNode("addr")))
+            >>> g.add((BNode("addr"), EX.city, Literal("Paris")))
+            >>> g.add((EX.bob, EX.name, Literal("Bob")))
+            >>> cbd = g.cbd(EX.alice)
+            >>> assert (EX.alice, EX.knows, EX.bob) in cbd
+            >>> assert (EX.bob, EX.name, Literal("Bob")) not in cbd
+            >>> assert len(cbd) == 3
+        """
+        if not isinstance(resource, Node):
+            resource = URIRef(resource)
+
+        subgraph = Graph()
+        visited = set()
+        to_visit = [resource]
+
+        while to_visit:
+            subject = to_visit.pop()
+            if subject in visited:
+                continue
+            visited.add(subject)
+            for triple in self.triples((subject, None, None)):
+                subgraph.add(triple)
+                obj = triple[2]
+                if isinstance(obj, BNode) and obj not in visited:
+                    to_visit.append(obj)
+
+        return subgraph
+
