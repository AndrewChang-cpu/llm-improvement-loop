 from nose.exc import SkipTest
 
@@ -146,6 +147,57 @@ class GraphTestCase(unittest.TestCase):
 
         self.assertEqual(False, graph.connected())
 
+    def testCBD(self):
+        graph = self.graph
+        ex = Namespace("http://example.org/")
+        alice, bob = ex.alice, ex.bob
+        addr = BNode("addr")
+        geo = BNode("geo")
+        carol = ex.carol
+
+        graph.add((alice, ex.knows, bob))
+        graph.add((alice, ex.address, addr))
+        graph.add((addr, ex.city, Literal("Paris")))
+        graph.add((addr, ex.geo, geo))
+        graph.add((geo, ex.lat, Literal(48.85)))
+        # not part of alice's CBD: bob is a URIRef, so it is not followed
+        graph.add((bob, ex.name, Literal("Bob")))
+        # not part of alice's CBD: carol is not reachable from alice
+        graph.add((carol, ex.knows, alice))
+
+        cbd = graph.cbd(alice)
+        self.assertEqual(len(cbd), 5)
+        self.assertIn((alice, ex.knows, bob), cbd)
+        self.assertIn((alice, ex.address, addr), cbd)
+        self.assertIn((addr, ex.city, Literal("Paris")), cbd)
+        self.assertIn((addr, ex.geo, geo), cbd)
+        self.assertIn((geo, ex.lat, Literal(48.85)), cbd)
+        self.assertNotIn((bob, ex.name, Literal("Bob")), cbd)
+        self.assertNotIn((carol, ex.knows, alice), cbd)
+
+        # the source graph is left untouched
+        self.assertEqual(len(graph), 7)
+
+        # the method accepts a plain string and converts it to a URIRef
+        self.assertEqual(len(graph.cbd(str(bob))), 1)
+
+        # a resource with no outgoing triples yields an empty graph
+        self.assertEqual(len(graph.cbd(ex.nobody)), 0)
+
+    def testCBDBlankNodeCycle(self):
+        graph = self.graph
+        ex = Namespace("http://example.org/")
+        a, b = BNode("a"), BNode("b")
+        start = ex.start
+
+        graph.add((start, ex.p, a))
+        graph.add((a, ex.q, b))
+        graph.add((b, ex.r, a))  # cycle between blank nodes
+
+        cbd = graph.cbd(start)
+        self.assertEqual(len(cbd), 3)
+        self.assertIn((b, ex.r, a), cbd)
+
