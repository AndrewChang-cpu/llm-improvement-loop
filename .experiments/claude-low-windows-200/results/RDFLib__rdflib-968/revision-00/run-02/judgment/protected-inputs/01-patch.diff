diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..265b199 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1170,6 +1170,62 @@ class Graph(Node):
         res.update(self.subjects())
         return res
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in [1] as:
+
+            Given a particular URI reference (R), the Concise Bounded
+            Description of R is a subgraph of the graph that contains:
+
+            1. Every triple in which R is the subject of the triple
+            2. Recursively, for every triple in the CBD of a blank node
+               object of the triple, if that blank node is not already
+               in the CBD.
+
+        This is the non-reified version of the CBD (see [1], section 1.1).
+
+        Parameters:
+
+        - ``resource``: a URIRef (or other Node) identifying the resource
+          whose description is wanted.
+
+        Returns a new ``Graph`` containing only the triples of the CBD.
+
+        Example::
+
+            >>> from rdflib import Graph, URIRef, Literal, BNode
+            >>> g = Graph()
+            >>> alice = URIRef("http://example.org/alice")
+            >>> bob = URIRef("http://example.org/bob")
+            >>> name = URIRef("http://xmlns.com/foaf/0.1/name")
+            >>> knows = URIRef("http://xmlns.com/foaf/0.1/knows")
+            >>> address = BNode()
+            >>> g.add((alice, name, Literal("Alice")))
+            >>> g.add((alice, knows, bob))
+            >>> g.add((alice, URIRef("http://example.org/address"), address))
+            >>> g.add((address, URIRef("http://example.org/city"), Literal("Paris")))
+            >>> g.add((bob, name, Literal("Bob")))
+            >>> cbd = g.cbd(alice)
+            >>> len(cbd)
+            4
+            >>> (bob, name, Literal("Bob")) in cbd
+            False
+
+        [1] https://www.w3.org/Submission/CBD/
+        """
+        subgraph = Graph()
+
+        def add_to_cbd(node):
+            for s, p, o in self.triples((node, None, None)):
+                subgraph.add((s, p, o))
+                # recurse into blank node objects not yet described
+                if isinstance(o, BNode) and (o, None, None) not in subgraph:
+                    add_to_cbd(o)
+
+        add_to_cbd(resource)
+        return subgraph
+
