+    def testCBD(self):
+        graph = self.graph
+        self.addStuff()
+
+        alice = URIRef("alice")
+        bob = URIRef("bob")
+        address = BNode()
+        city = BNode()
+        street = BNode()
+
+        graph.add((alice, self.likes, bob))
+        graph.add((alice, self.hates, self.michel))
+        graph.add((alice, URIRef("address"), address))
+        graph.add((address, URIRef("city"), city))
+        graph.add((city, URIRef("name"), Literal("Paris")))
+        # a blank node reachable only from outside the CBD of alice
+        graph.add((bob, URIRef("address"), street))
+        graph.add((street, URIRef("name"), Literal("Rue")))
+
+        cbd = graph.cbd(alice)
+
+        self.assertIsInstance(cbd, Graph)
+        # every triple with alice as subject
+        self.assertIn((alice, self.likes, bob), cbd)
+        self.assertIn((alice, self.hates, self.michel), cbd)
+        self.assertIn((alice, URIRef("address"), address), cbd)
+        # recursively described blank nodes
+        self.assertIn((address, URIRef("city"), city), cbd)
+        self.assertIn((city, URIRef("name"), Literal("Paris")), cbd)
+        # triples of other resources are excluded
+        self.assertNotIn((bob, URIRef("address"), street), cbd)
+        self.assertNotIn((street, URIRef("name"), Literal("Rue")), cbd)
+        self.assertEqual(len(cbd), 5)
+
+        # resource with no subject triples gives an empty graph
+        self.assertEqual(len(graph.cbd(URIRef("nobody"))), 0)
+
+    def testCBDBlankNodeCycle(self):
+        graph = self.graph
+        a = BNode()
+        b = BNode()
+        root = URIRef("root")
+        graph.add((root, self.likes, a))
+        graph.add((a, self.likes, b))
+        graph.add((b, self.likes, a))
+
+        cbd = graph.cbd(root)
+        self.assertEqual(len(cbd), 3)
+
