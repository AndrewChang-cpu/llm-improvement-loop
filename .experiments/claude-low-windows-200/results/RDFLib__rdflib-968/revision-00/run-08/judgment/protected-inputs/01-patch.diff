index 4a27e6d..10127df 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1170,6 +1170,79 @@ class Graph(Node):
         res.update(self.subjects())
         return res
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in [1] as:
+
+            Given a particular node (the subject) in a particular graph
+            (the context), a concise bounded description (CBD) of the
+            subject in the context is made up of the union of:
+
+            1. the set of triples in the context, with the subject as their
+               subject
+            2. recursively, for all blank node objects in the set of triples
+               from (1), the CBD of each such blank node, including the
+               reification triples of any such triples
+
+        [1] https://www.w3.org/Submission/CBD/
+
+        Parameters:
+
+        - ``resource``: the subject (URIRef or BNode) to describe.
+
+        Returns a new ``Graph`` containing the CBD triples. The triples are
+        copied, so the source graph is not modified.
+
+        Example::
+
+            >>> from rdflib import Graph, URIRef, BNode, Literal
+            >>> from rdflib.namespace import FOAF
+            >>> g = Graph()
+            >>> alice = URIRef("http://example.org/alice")
+            >>> addr = BNode()
+            >>> g.add((alice, FOAF.name, Literal("Alice")))
+            >>> g.add((alice, FOAF.knows, URIRef("http://example.org/bob")))
+            >>> g.add((alice, FOAF.based_near, addr))
+            >>> g.add((addr, FOAF.name, Literal("Somewhere")))
+            >>> g.add((URIRef("http://example.org/bob"), FOAF.name,
+            ...        Literal("Bob")))
+            >>> cbd = g.cbd(alice)
+            >>> len(cbd)
+            4
+            >>> (alice, FOAF.name, Literal("Alice")) in cbd
+            True
+            >>> bob = URIRef("http://example.org/bob")
+            >>> (bob, FOAF.name, Literal("Bob")) in cbd
+            False
+
+        """
+        subgraph = Graph()
+        seen = set()
+        to_visit = [resource]
+
+        while to_visit:
+            subject = to_visit.pop()
+            if subject in seen:
+                continue
+            seen.add(subject)
+
+            for s, p, o in self.triples((subject, None, None)):
+                subgraph.add((s, p, o))
+                if isinstance(o, BNode) and o not in seen:
+                    to_visit.append(o)
+
+                # Reification: any reified statement (?stmt rdf:subject s,
+                # rdf:predicate p, rdf:object o) is part of the description
+                # of the triple, so include its triples too.
+                for stmt in self.subjects(RDF.subject, s):
+                    if ((stmt, RDF.predicate, p) in self and
+                            (stmt, RDF.object, o) in self and
+                            stmt not in seen):
+                        to_visit.append(stmt)
+
+        return subgraph
+
