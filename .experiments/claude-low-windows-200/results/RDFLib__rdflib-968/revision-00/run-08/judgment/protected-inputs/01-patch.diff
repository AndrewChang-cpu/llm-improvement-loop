+    def testCBD(self):
+        graph = self.graph
+        alice = URIRef("alice")
+        bob = URIRef("bob")
+        name = URIRef("name")
+        knows = URIRef("knows")
+        based_near = URIRef("based_near")
+        addr = BNode()
+        street = URIRef("street")
+
+        graph.add((alice, name, Literal("Alice")))
+        graph.add((alice, knows, bob))
+        graph.add((alice, based_near, addr))
+        graph.add((addr, street, Literal("Main St")))
+        # Not reachable from alice: must not be in the CBD.
+        graph.add((bob, name, Literal("Bob")))
+
+        cbd = graph.cbd(alice)
+
+        self.assertTrue(isinstance(cbd, Graph))
+        self.assertEqual(4, len(cbd))
+        self.assertTrue((alice, name, Literal("Alice")) in cbd)
+        self.assertTrue((alice, knows, bob) in cbd)
+        self.assertTrue((alice, based_near, addr) in cbd)
+        self.assertTrue((addr, street, Literal("Main St")) in cbd)
+        self.assertFalse((bob, name, Literal("Bob")) in cbd)
+
+        # the source graph is left untouched
+        self.assertEqual(5, len(graph))
+
+    def testCBDReification(self):
+        graph = self.graph
+        alice = URIRef("alice")
+        bob = URIRef("bob")
+        knows = URIRef("knows")
+        confidence = URIRef("confidence")
+        stmt = BNode()
+
+        graph.add((alice, knows, bob))
+        graph.add((stmt, RDF.type, RDF.Statement))
+        graph.add((stmt, RDF.subject, alice))
+        graph.add((stmt, RDF.predicate, knows))
+        graph.add((stmt, RDF.object, bob))
+        graph.add((stmt, confidence, Literal(0.9)))
+
+        cbd = graph.cbd(alice)
+
+        self.assertTrue((alice, knows, bob) in cbd)
+        self.assertTrue((stmt, confidence, Literal(0.9)) in cbd)
+        self.assertTrue((stmt, RDF.subject, alice) in cbd)
+
+    def testCBDCycle(self):
+        graph = self.graph
+        a = BNode()
+        b = BNode()
+        p = URIRef("p")
+
+        graph.add((a, p, b))
+        graph.add((b, p, a))
+
+        # Must terminate even though the blank nodes refer to each other.
+        cbd = graph.cbd(a)
+        self.assertEqual(2, len(cbd))
+
