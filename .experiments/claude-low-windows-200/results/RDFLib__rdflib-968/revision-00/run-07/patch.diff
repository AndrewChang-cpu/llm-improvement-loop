--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1170,6 +1170,83 @@ class Graph(Node):
         res.update(self.subjects())
         return res
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in [1] as:
+
+            Given a particular node (the subject in the query), and a particular
+            node type (bNode or URI), the Concise Bounded Description (CBD)
+            contains:
+
+            1. the set of triples in the graph that have the subject node as
+               their subject (note: the value is the subject, not the object
+               of the statement)
+            2. recursively, for all blank nodes that are the object of a
+               statement in the CBD, include the CBD for that blank node
+            3. for each statement whose subject is a reified statement with
+               rdf:subject, rdf:predicate and rdf:object matching the resource,
+               include the statement's triples (the reification itself, and
+               its recursive CBD)
+
+        The returned graph is a new, in-memory Graph containing only those
+        triples. Triples are copied; the source graph is not modified.
+
+        [1] https://www.w3.org/Submission/CBD/
+
+        >>> from rdflib import Graph, URIRef, Literal, BNode
+        >>> g = Graph()
+        >>> alice = URIRef("http://example.org/alice")
+        >>> bob = URIRef("http://example.org/bob")
+        >>> knows = URIRef("http://xmlns.com/foaf/0.1/knows")
+        >>> name = URIRef("http://xmlns.com/foaf/0.1/name")
+        >>> g.add((alice, name, Literal("Alice")))
+        >>> g.add((alice, knows, bob))
+        >>> g.add((bob, name, Literal("Bob")))
+        >>> len(g.cbd(alice))
+        2
+        >>> (bob, name, Literal("Bob")) in g.cbd(alice)
+        False
+
+        :param resource: the subject node whose description is wanted
+        :returns: a new :class:`~rdflib.graph.Graph` with the CBD triples
+        """
+        cbd = Graph()
+        # Blank nodes already expanded, to avoid infinite recursion on cycles
+        seen = set()
+        self._cbd_add(resource, cbd, seen)
+        return cbd
+
+    def _cbd_add(self, resource, target, seen):
+        """Adds the CBD of ``resource`` (from self) into ``target``."""
+        if resource in seen:
+            return
+        seen.add(resource)
+
+        # Rule 1: all statements with resource as subject
+        for p, o in self.predicate_objects(resource):
+            target.add((resource, p, o))
+            # Rule 2: recurse into blank node objects
+            if isinstance(o, BNode):
+                self._cbd_add(o, target, seen)
+
+        # Rule 3: reified statements describing (resource, p, o)
+        for stmt in self.subjects(RDF.subject, resource):
+            if (stmt, RDF.type, RDF.Statement) not in self:
+                continue
+            preds = list(self.objects(stmt, RDF.predicate))
+            objs = list(self.objects(stmt, RDF.object))
+            for p in preds:
+                for o in objs:
+                    if (resource, p, o) in self:
+                        for sp, so in self.predicate_objects(stmt):
+                            target.add((stmt, sp, so))
+                            if isinstance(so, BNode):
+                                self._cbd_add(so, target, seen)
+                        target.add((stmt, RDF.subject, resource))
+                        target.add((stmt, RDF.predicate, p))
+                        target.add((stmt, RDF.object, o))
+
