diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..0253ce9
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,103 @@
+import unittest
+
+from rdflib import BNode, Graph, Literal, URIRef
+from rdflib.namespace import RDF
+
+ALICE = URIRef("http://example.org/alice")
+BOB = URIRef("http://example.org/bob")
+KNOWS = URIRef("http://xmlns.com/foaf/0.1/knows")
+NAME = URIRef("http://xmlns.com/foaf/0.1/name")
+ADDRESS = URIRef("http://example.org/address")
+CITY = URIRef("http://example.org/city")
+
+
+class TestConciseBoundedDescription(unittest.TestCase):
+    def test_only_outgoing_triples_of_resource(self):
+        g = Graph()
+        g.add((ALICE, NAME, Literal("Alice")))
+        g.add((ALICE, KNOWS, BOB))
+        g.add((BOB, NAME, Literal("Bob")))
+
+        cbd = g.cbd(ALICE)
+        self.assertEqual(len(cbd), 2)
+        self.assertIn((ALICE, NAME, Literal("Alice")), cbd)
+        self.assertIn((ALICE, KNOWS, BOB), cbd)
+        self.assertNotIn((BOB, NAME, Literal("Bob")), cbd)
+
+    def test_incoming_triples_excluded(self):
+        g = Graph()
+        g.add((BOB, KNOWS, ALICE))
+        self.assertEqual(len(g.cbd(ALICE)), 0)
+
+    def test_unknown_resource_gives_empty_graph(self):
+        g = Graph()
+        g.add((ALICE, NAME, Literal("Alice")))
+        self.assertEqual(len(g.cbd(BOB)), 0)
+
+    def test_blank_node_objects_are_followed_recursively(self):
+        g = Graph()
+        addr = BNode()
+        g.add((ALICE, ADDRESS, addr))
+        g.add((addr, CITY, Literal("Paris")))
+        g.add((BOB, NAME, Literal("Bob")))
+
+        cbd = g.cbd(ALICE)
+        self.assertIn((ALICE, ADDRESS, addr), cbd)
+        self.assertIn((addr, CITY, Literal("Paris")), cbd)
+        self.assertNotIn((BOB, NAME, Literal("Bob")), cbd)
+        self.assertEqual(len(cbd), 2)
+
+    def test_blank_node_cycles_terminate(self):
+        g = Graph()
+        b1 = BNode()
+        b2 = BNode()
+        g.add((ALICE, ADDRESS, b1))
+        g.add((b1, KNOWS, b2))
+        g.add((b2, KNOWS, b1))
+
+        cbd = g.cbd(ALICE)
+        self.assertEqual(len(cbd), 3)
+
+    def test_uri_objects_are_not_followed(self):
+        g = Graph()
+        g.add((ALICE, KNOWS, BOB))
+        g.add((BOB, NAME, Literal("Bob")))
+        self.assertEqual(len(g.cbd(ALICE)), 1)
+
+    def test_reified_statement_included(self):
+        g = Graph()
+        g.add((ALICE, KNOWS, BOB))
+        stmt = BNode()
+        g.add((stmt, RDF.type, RDF.Statement))
+        g.add((stmt, RDF.subject, ALICE))
+        g.add((stmt, RDF.predicate, KNOWS))
+        g.add((stmt, RDF.object, BOB))
+        g.add((stmt, NAME, Literal("reified note")))
+
+        cbd = g.cbd(ALICE)
+        self.assertIn((stmt, RDF.type, RDF.Statement), cbd)
+        self.assertIn((stmt, RDF.subject, ALICE), cbd)
+        self.assertIn((stmt, RDF.predicate, KNOWS), cbd)
+        self.assertIn((stmt, RDF.object, BOB), cbd)
+        self.assertIn((stmt, NAME, Literal("reified note")), cbd)
+
+    def test_reification_without_matching_triple_ignored(self):
+        g = Graph()
+        stmt = BNode()
+        g.add((stmt, RDF.type, RDF.Statement))
+        g.add((stmt, RDF.subject, ALICE))
+        g.add((stmt, RDF.predicate, KNOWS))
+        g.add((stmt, RDF.object, BOB))
+        # no (ALICE, KNOWS, BOB) in the graph
+        self.assertEqual(len(g.cbd(ALICE)), 0)
+
+    def test_source_graph_unchanged(self):
+        g = Graph()
+        g.add((ALICE, KNOWS, BOB))
+        before = len(g)
+        g.cbd(ALICE)
+        self.assertEqual(len(g), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
