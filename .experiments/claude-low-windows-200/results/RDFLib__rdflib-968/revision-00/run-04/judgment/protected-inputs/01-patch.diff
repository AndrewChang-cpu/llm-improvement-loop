diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..ac15e9f
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,87 @@
+from rdflib import BNode, Graph, Literal, Namespace, URIRef
+
+EX = Namespace("http://example.org/")
+
+
+def test_cbd_returns_only_triples_about_subject():
+    g = Graph()
+    g.add((EX.bob, EX.name, Literal("Bob")))
+    g.add((EX.bob, EX.knows, EX.alice))
+    g.add((EX.alice, EX.name, Literal("Alice")))
+
+    cbd = g.cbd(EX.bob)
+
+    assert set(cbd) == {
+        (EX.bob, EX.name, Literal("Bob")),
+        (EX.bob, EX.knows, EX.alice),
+    }
+
+
+def test_cbd_does_not_follow_uri_objects():
+    g = Graph()
+    g.add((EX.bob, EX.knows, EX.alice))
+    g.add((EX.alice, EX.name, Literal("Alice")))
+
+    assert (EX.alice, EX.name, Literal("Alice")) not in g.cbd(EX.bob)
+
+
+def test_cbd_follows_blank_node_objects_recursively():
+    g = Graph()
+    addr = BNode()
+    geo = BNode()
+    g.add((EX.bob, EX.address, addr))
+    g.add((addr, EX.city, Literal("Paris")))
+    g.add((addr, EX.geo, geo))
+    g.add((geo, EX.lat, Literal(48.85)))
+    g.add((EX.alice, EX.address, BNode()))
+
+    cbd = g.cbd(EX.bob)
+
+    assert len(cbd) == 4
+    assert (EX.bob, EX.address, addr) in cbd
+    assert (addr, EX.city, Literal("Paris")) in cbd
+    assert (addr, EX.geo, geo) in cbd
+    assert (geo, EX.lat, Literal(48.85)) in cbd
+
+
+def test_cbd_handles_blank_node_cycles():
+    g = Graph()
+    a = BNode()
+    b = BNode()
+    g.add((EX.bob, EX.link, a))
+    g.add((a, EX.next, b))
+    g.add((b, EX.next, a))
+
+    cbd = g.cbd(EX.bob)
+
+    assert len(cbd) == 3
+
+
+def test_cbd_for_blank_node_resource():
+    g = Graph()
+    a = BNode()
+    g.add((a, EX.name, Literal("anon")))
+    g.add((EX.bob, EX.knows, a))
+
+    cbd = g.cbd(a)
+
+    assert set(cbd) == {(a, EX.name, Literal("anon"))}
+
+
+def test_cbd_unknown_resource_is_empty():
+    g = Graph()
+    g.add((EX.bob, EX.name, Literal("Bob")))
+
+    assert len(g.cbd(URIRef("http://example.org/nobody"))) == 0
+
+
+def test_cbd_does_not_modify_source_graph():
+    g = Graph()
+    addr = BNode()
+    g.add((EX.bob, EX.address, addr))
+    g.add((addr, EX.city, Literal("Paris")))
+    before = set(g)
+
+    g.cbd(EX.bob)
+
+    assert set(g) == before
