diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..5b1d1a6 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1170,6 +1170,64 @@ class Graph(Node):
         res.update(self.subjects())
         return res
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in [1] as:
+
+            Given a particular node (the subject) in a particular graph
+            (the context), a subgraph of that particular graph is taken
+            where:
+
+            * f(subject, predicate, object) is in the subgraph if
+              (subject, predicate, object) is in the context and
+              subject == the subject given
+            * recursively, f(bnode, predicate, object) is in the subgraph
+              if (subject, predicate, bnode) is in the subgraph and bnode
+              is a blank node, and (bnode, predicate, object) is in the
+              context
+
+        Parameters:
+
+        - ``resource``: a URIRef or BNode instance identifying the subject.
+
+        Returns a new ``Graph`` containing the CBD triples. The source graph
+        is not modified.
+
+        Example::
+
+            >>> from rdflib import Graph, URIRef, BNode, Literal, Namespace
+            >>> EX = Namespace("http://example.org/")
+            >>> g = Graph()
+            >>> g.add((EX.bob, EX.name, Literal("Bob")))
+            >>> addr = BNode()
+            >>> g.add((EX.bob, EX.address, addr))
+            >>> g.add((addr, EX.city, Literal("Paris")))
+            >>> g.add((EX.alice, EX.name, Literal("Alice")))
+            >>> cbd = g.cbd(EX.bob)
+            >>> len(cbd)
+            3
+            >>> (EX.alice, EX.name, Literal("Alice")) in cbd
+            False
+
+        [1] https://www.w3.org/Submission/CBD/
+        """
+        result = Graph()
+        seen_bnodes = set()
+        to_visit = [resource]
+        if isinstance(resource, BNode):
+            seen_bnodes.add(resource)
+
+        while to_visit:
+            subject = to_visit.pop()
+            for predicate, obj in self.predicate_objects(subject):
+                result.add((subject, predicate, obj))
+                if isinstance(obj, BNode) and obj not in seen_bnodes:
+                    seen_bnodes.add(obj)
+                    to_visit.append(obj)
+
+        return result
+
