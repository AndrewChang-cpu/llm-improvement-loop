+    def testCBD(self):
+        graph = self.graph
+        tarek = self.tarek
+        bob = self.bob
+        likes = self.likes
+        hates = self.hates
+        pizza = self.pizza
+        cheese = self.cheese
+        self.addStuff()
+
+        cbd = graph.cbd(tarek)
+        self.assertEqual(len(cbd), 2)
+        self.assertEqual((tarek, likes, pizza) in cbd, True)
+        self.assertEqual((tarek, likes, cheese) in cbd, True)
+        self.assertEqual((bob, likes, cheese) in cbd, False)
+
+        # the source graph is not modified
+        self.assertEqual(len(graph), 7)
+
+        # a resource with no outgoing triples has an empty description
+        self.assertEqual(len(graph.cbd(URIRef(u'nobody'))), 0)
+
+        # the object of bob's hates-triple is a URIRef, so not followed
+        cbd = graph.cbd(bob)
+        self.assertEqual(len(cbd), 3)
+        self.assertEqual((bob, hates, pizza) in cbd, True)
+
+    def testCBDBlankNodes(self):
+        graph = self.graph
+        michel = self.michel
+        likes = self.likes
+        hates = self.hates
+        pizza = self.pizza
+
+        addr = BNode()
+        city = BNode()
+        self.graph.add((michel, self.likes, pizza))
+        self.graph.add((michel, self.hates, addr))
+        self.graph.add((addr, self.likes, city))
+        self.graph.add((city, self.likes, pizza))
+        # unrelated bnode, must not be included
+        self.graph.add((BNode(), self.likes, pizza))
+
+        cbd = graph.cbd(michel)
+        self.assertEqual(len(cbd), 4)
+        self.assertEqual((michel, hates, addr) in cbd, True)
+        self.assertEqual((addr, likes, city) in cbd, True)
+        self.assertEqual((city, likes, pizza) in cbd, True)
+
+    def testCBDBlankNodeCycle(self):
+        graph = self.graph
+        michel = self.michel
+        likes = self.likes
+
+        a = BNode()
+        b = BNode()
+        graph.add((michel, likes, a))
+        graph.add((a, likes, b))
+        graph.add((b, likes, a))
+
+        # must terminate despite the cycle between a and b
+        cbd = graph.cbd(michel)
+        self.assertEqual(len(cbd), 3)
+
+    def testCBDReification(self):
+        graph = self.graph
+        michel = self.michel
+        likes = self.likes
+        pizza = self.pizza
+
+        stmt = BNode()
+        graph.add((stmt, RDF.type, RDF.Statement))
+        graph.add((stmt, RDF.subject, michel))
+        graph.add((stmt, RDF.predicate, likes))
+        graph.add((stmt, RDF.object, pizza))
+        graph.add((michel, likes, pizza))
+
+        cbd = graph.cbd(michel)
+        self.assertEqual(len(cbd), 5)
+        self.assertEqual((stmt, RDF.subject, michel) in cbd, True)
+        self.assertEqual((stmt, RDF.type, RDF.Statement) in cbd, True)
+
