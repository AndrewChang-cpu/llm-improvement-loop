+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in [1] as:
+
+        Given a particular node (the subject) in a particular graph (G), a
+        subgraph (S) is a CBD of the subject if the following conditions hold:
+
+        1. S is a subgraph of G.
+        2. The subject is a node in S.
+        3. S includes, for every triple in G whose subject is the subject
+           node, that triple.
+        4. If the object of any triple in S is a blank node, then S includes,
+           for that blank node, the concise bounded description of that
+           blank node (recursively, applying the same rules).
+        5. If a statement is reified (i.e. an ``rdf:Statement`` whose
+           ``rdf:subject`` is the subject node), that reification is
+           included together with its own concise bounded description.
+
+        Parameters:
+
+        - ``resource``: the URIRef or BNode whose description is wanted.
+
+        Returns a new ``Graph`` containing the CBD triples. The source graph
+        is not modified.
+
+        Example::
+
+            >>> from rdflib import Graph, Namespace, Literal, BNode
+            >>> EX = Namespace("http://example.org/")
+            >>> g = Graph()
+            >>> addr = BNode()
+            >>> g.add((EX.bob, EX.name, Literal("Bob")))
+            >>> g.add((EX.bob, EX.address, addr))
+            >>> g.add((addr, EX.city, Literal("Paris")))
+            >>> g.add((EX.alice, EX.name, Literal("Alice")))
+            >>> len(g.cbd(EX.bob))
+            3
+
+        [1] https://www.w3.org/Submission/CBD/
+        """
+        subgraph = Graph()
+        seen = set()
+        stack = [resource]
+        while stack:
+            node = stack.pop()
+            if node in seen:
+                continue
+            seen.add(node)
+
+            # Rule 3 and 4: all triples about this node, recursing into
+            # blank node objects.
+            for p, o in self.predicate_objects(subject=node):
+                subgraph.add((node, p, o))
+                if isinstance(o, BNode) and o not in seen:
+                    stack.append(o)
+
+            # Rule 5: reifications whose rdf:subject is this node.
+            for stmt in self.subjects(RDF.subject, node):
+                if (stmt, RDF.type, RDF.Statement) in self:
+                    if stmt not in seen:
+                        stack.append(stmt)
+
+        return subgraph
+
