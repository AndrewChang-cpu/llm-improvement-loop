diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..dfcaa9c
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,100 @@
+from rdflib import Graph, URIRef, Literal, BNode
+from rdflib.namespace import Namespace
+
+EX = Namespace("http://example.org/")
+
+DATA = """
+@prefix ex: <http://example.org/> .
+
+ex:a ex:name "A" ;
+     ex:knows ex:b ;
+     ex:addr [ ex:street "Main" ;
+               ex:geo [ ex:lat "1.0" ] ] .
+
+ex:b ex:name "B" .
+ex:c ex:knows ex:a .
+[ ex:x "unrelated" ] .
+"""
+
+
+def _graph():
+    return Graph().parse(data=DATA, format="turtle")
+
+
+def test_cbd_outgoing_and_blank_node_closure():
+    g = _graph()
+    result = g.cbd(EX.a)
+
+    # ex:a name, knows, addr (3) + addr's street, geo (2) + geo's lat (1)
+    assert len(result) == 6
+
+    assert (EX.a, EX.name, Literal("A")) in result
+    assert (EX.a, EX.knows, EX.b) in result
+    addr = result.value(EX.a, EX.addr)
+    assert isinstance(addr, BNode)
+    assert (addr, EX.street, Literal("Main")) in result
+    geo = result.value(addr, EX.geo)
+    assert isinstance(geo, BNode)
+    assert (geo, EX.lat, Literal("1.0")) in result
+
+
+def test_cbd_excludes_uri_objects_and_incoming_triples():
+    result = _graph().cbd(EX.a)
+
+    # URI objects are not followed, so b's description is not included
+    assert (EX.b, EX.name, Literal("B")) not in result
+    # incoming triples are not included
+    assert (EX.c, EX.knows, EX.a) not in result
+    # unrelated blank node is not included
+    assert not any(p == EX.x for s, p, o in result)
+
+
+def test_cbd_of_blank_node_resource():
+    g = _graph()
+    addr = g.value(EX.a, EX.addr)
+    result = g.cbd(addr)
+
+    # street, geo, and geo's lat
+    assert len(result) == 3
+    assert (EX.a, EX.name, Literal("A")) not in result
+    assert (addr, EX.street, Literal("Main")) in result
+
+
+def test_cbd_handles_blank_node_cycles():
+    g = Graph().parse(data="""
+        @prefix ex: <http://example.org/> .
+        ex:a ex:self _:loop .
+        _:loop ex:next _:loop ;
+               ex:label "loop" .
+        """, format="turtle")
+
+    result = g.cbd(EX.a)
+    loop = result.value(EX.a, EX.self)
+    assert isinstance(loop, BNode)
+    assert (loop, EX.next, loop) in result
+    assert (loop, EX.label, Literal("loop")) in result
+    assert len(result) == 3
+
+
+def test_cbd_unknown_resource_is_empty():
+    result = _graph().cbd(URIRef("http://example.org/nothing"))
+    assert len(result) == 0
+
+
+def test_cbd_none_is_empty():
+    result = _graph().cbd(None)
+    assert len(result) == 0
+
+
+def test_cbd_copies_namespace_bindings():
+    g = _graph()
+    g.bind("ex", EX)
+    result = g.cbd(EX.a)
+    assert dict(result.namespaces())["ex"] == URIRef("http://example.org/")
+
+
+def test_cbd_does_not_modify_source():
+    g = _graph()
+    before = len(g)
+    g.cbd(EX.a)
+    assert len(g) == before
