+    def cbd(self, resource):
+        """Concise Bounded Description (CBD) of resource
+
+        Returns a new Graph containing the subgraph of this graph that
+        describes resource, following the W3C member submission
+        https://www.w3.org/Submission/CBD/ :
+
+        1. Every triple whose subject is resource is included.
+        2. For every included triple whose object is a blank node, every
+           triple whose subject is that blank node is included too,
+           recursively.
+
+        Namespace bindings of this graph are copied to the result.
+
+        Parameters:
+        resource -- the URIRef or BNode to describe. If None, an empty
+        Graph is returned.
+        """
+        described = Graph()
+        for prefix, namespace in self.namespaces():
+            described.bind(prefix, namespace)
+
+        if resource is None:
+            return described
+
+        seen = set()
+        to_visit = [resource]
+        while to_visit:
+            subject = to_visit.pop()
+            if subject in seen:
+                continue
+            seen.add(subject)
+            for predicate, obj in self.predicate_objects(subject):
+                described.add((subject, predicate, obj))
+                if isinstance(obj, BNode):
+                    to_visit.append(obj)
+        return described
+
