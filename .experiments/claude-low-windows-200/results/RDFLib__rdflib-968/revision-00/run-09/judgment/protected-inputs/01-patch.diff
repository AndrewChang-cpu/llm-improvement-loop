+class CBDTestCase(unittest.TestCase):
+    """Tests for Graph.cbd(), the Concise Bounded Description"""
+
+    def setUp(self):
+        self.g = Graph()
+        self.bob = URIRef(u'http://example.org/bob')
+        self.alice = URIRef(u'http://example.org/alice')
+        self.carol = URIRef(u'http://example.org/carol')
+        self.name = URIRef(u'http://xmlns.com/foaf/0.1/name')
+        self.knows = URIRef(u'http://xmlns.com/foaf/0.1/knows')
+        self.based_near = URIRef(u'http://xmlns.com/foaf/0.1/based_near')
+
+    def test_returns_new_graph(self):
+        self.g.add((self.bob, self.name, Literal(u'Bob')))
+        cbd = self.g.cbd(self.bob)
+        self.assertIsInstance(cbd, Graph)
+        self.assertIsNot(cbd, self.g)
+
+    def test_includes_outgoing_triples_only(self):
+        self.g.add((self.bob, self.name, Literal(u'Bob')))
+        self.g.add((self.bob, self.knows, self.alice))
+        self.g.add((self.alice, self.name, Literal(u'Alice')))
+        cbd = self.g.cbd(self.bob)
+        self.assertEqual(len(cbd), 2)
+        self.assertIn((self.bob, self.name, Literal(u'Bob')), cbd)
+        self.assertIn((self.bob, self.knows, self.alice), cbd)
+        self.assertNotIn((self.alice, self.name, Literal(u'Alice')), cbd)
+
+    def test_excludes_incoming_triples(self):
+        self.g.add((self.alice, self.knows, self.bob))
+        self.g.add((self.bob, self.name, Literal(u'Bob')))
+        cbd = self.g.cbd(self.bob)
+        self.assertEqual(len(cbd), 1)
+        self.assertNotIn((self.alice, self.knows, self.bob), cbd)
+
+    def test_follows_blank_nodes(self):
+        addr = BNode()
+        street = BNode()
+        self.g.add((self.bob, self.based_near, addr))
+        self.g.add((addr, self.name, Literal(u'Somewhere')))
+        self.g.add((addr, URIRef(u'http://example.org/street'), street))
+        self.g.add((street, self.name, Literal(u'Main St')))
+        cbd = self.g.cbd(self.bob)
+        self.assertEqual(len(cbd), 4)
+        self.assertIn((street, self.name, Literal(u'Main St')), cbd)
+
+    def test_does_not_follow_named_nodes(self):
+        self.g.add((self.bob, self.knows, self.alice))
+        self.g.add((self.alice, self.name, Literal(u'Alice')))
+        cbd = self.g.cbd(self.bob)
+        self.assertEqual(len(cbd), 1)
+
+    def test_handles_blank_node_cycles(self):
+        a = BNode()
+        b = BNode()
+        self.g.add((self.bob, self.knows, a))
+        self.g.add((a, self.knows, b))
+        self.g.add((b, self.knows, a))
+        cbd = self.g.cbd(self.bob)
+        self.assertEqual(len(cbd), 3)
+
+    def test_includes_reification(self):
+        stmt = BNode()
+        self.g.add((self.bob, self.knows, self.alice))
+        self.g.add((stmt, RDF.type, RDF.Statement))
+        self.g.add((stmt, RDF.subject, self.bob))
+        self.g.add((stmt, RDF.predicate, self.knows))
+        self.g.add((stmt, RDF.object, self.alice))
+        self.g.add((stmt, self.name, Literal(u'provenance')))
+        cbd = self.g.cbd(self.bob)
+        self.assertIn((stmt, RDF.subject, self.bob), cbd)
+        self.assertIn((stmt, self.name, Literal(u'provenance')), cbd)
+        self.assertEqual(len(cbd), 6)
+
+    def test_unknown_resource_gives_empty_graph(self):
+        self.g.add((self.bob, self.name, Literal(u'Bob')))
+        cbd = self.g.cbd(self.carol)
+        self.assertEqual(len(cbd), 0)
+
+    def test_copies_namespace_bindings(self):
+        self.g.bind(u'foaf', u'http://xmlns.com/foaf/0.1/')
+        self.g.add((self.bob, self.name, Literal(u'Bob')))
+        cbd = self.g.cbd(self.bob)
+        self.assertIn(
+            (u'foaf', URIRef(u'http://xmlns.com/foaf/0.1/')),
+            list(cbd.namespaces()))
+
+
