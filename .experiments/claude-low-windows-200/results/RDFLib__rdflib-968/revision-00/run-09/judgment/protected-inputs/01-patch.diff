+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a resource
+
+        Returns a new :class:`Graph` containing the subgraph of this graph
+        described by the W3C Member Submission "Concise Bounded Description"
+        (https://www.w3.org/Submission/CBD/), starting from ``resource``:
+
+        1. Every triple whose subject is ``resource`` is included.
+        2. For every blank node that appears as an object in an included
+           triple, its own description is included, recursively.
+        3. Reification: every ``rdf:Statement`` whose ``rdf:subject`` or
+           ``rdf:object`` is a described node is included, together with its
+           own description.
+
+        Blank nodes are followed transitively, and each node is visited at
+        most once, so cycles in the graph are handled safely.
+
+        Namespace bindings from this graph are copied to the result.
+
+        >>> from rdflib import Graph, URIRef, BNode, Literal
+        >>> from rdflib.namespace import FOAF
+        >>> g = Graph()
+        >>> bob = URIRef("http://example.org/bob")
+        >>> alice = URIRef("http://example.org/alice")
+        >>> addr = BNode()
+        >>> g.add((bob, FOAF.name, Literal("Bob")))
+        >>> g.add((bob, FOAF.knows, alice))
+        >>> g.add((bob, FOAF.based_near, addr))
+        >>> g.add((addr, FOAF.name, Literal("Somewhere")))
+        >>> g.add((alice, FOAF.name, Literal("Alice")))
+        >>> cbd = g.cbd(bob)
+        >>> len(cbd)
+        4
+        >>> (alice, FOAF.name, Literal("Alice")) in cbd
+        False
+        """
+        result = Graph()
+        for prefix, namespace in self.namespaces():
+            result.bind(prefix, namespace)
+
+        seen = set()
+        to_visit = [resource]
+        while to_visit:
+            node = to_visit.pop()
+            if node in seen:
+                continue
+            seen.add(node)
+
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and o not in seen:
+                    to_visit.append(o)
+
+            # Reification: statements about this node are part of its CBD.
+            for statement in self.subjects(RDF.subject, node):
+                if (statement, RDF.type, RDF.Statement) in self:
+                    to_visit.append(statement)
+            for statement in self.subjects(RDF.object, node):
+                if (statement, RDF.type, RDF.Statement) in self:
+                    to_visit.append(statement)
+
+        return result
+
