diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..6232f11 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) and consists of:
+
+        1. All triples in the graph whose subject is the resource.
+        2. Recursively, for each blank node object of a triple added by
+           rule 1, the same rules are applied to that blank node, unless
+           the result already contains a triple with that blank node as
+           subject (which also guarantees termination on blank node cycles).
+        3. Reification: for every statement whose rdf:subject is the node,
+           all triples whose subject is that statement are included. This
+           is applied regardless of whether the statement has an rdf:Statement
+           type and regardless of its rdf:predicate or rdf:object values.
+           Blank node objects of these reification triples are not expanded,
+           and rdf:object and rdf:predicate values are not followed.
+
+        The result is a new Graph that is a subgraph of this graph; this
+        graph is not modified.
+
+        :param resource: The resource (node term) whose description is wanted.
+        :return: A new Graph containing the Concise Bounded Description.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: direct subject triples, expanding unseen blank nodes.
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                obj = triple[2]
+                if isinstance(obj, BNode) and not any(
+                        result.triples((obj, None, None))):
+                    add_to_cbd(obj)
+
+            # Rule 2 / reification: statements whose rdf:subject is node.
+            reifiers = [s for s, _, _ in
+                        self.triples((None, RDF.subject, node))]
+            for reifier in reifiers:
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..82d9695
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,149 @@
+import unittest
+
+from rdflib import Graph, Namespace, BNode, Literal
+from rdflib.namespace import RDF
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph()
+        self.graph.bind("ex", self.ex)
+        self.graph.parse(data="""
+            @prefix ex: <http://example.org/> .
+            @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+            # Rules 1 and 2: resource with blank node chain.
+            ex:R1 ex:p1 ex:A ;
+                  ex:p2 ex:B ;
+                  ex:p3 _:b1 .
+            _:b1 ex:q ex:C ;
+                 ex:r _:b2 .
+            _:b2 ex:s "x" .
+
+            # Resource with a type and two relations.
+            ex:R2 rdf:type ex:T ;
+                  ex:r1 ex:X ;
+                  ex:r2 ex:Y .
+
+            # Resource with two property triples.
+            ex:R3 ex:p ex:A ;
+                  ex:q ex:B .
+
+            # Reification case A: one typed reifier (5 triples).
+            ex:R5 ex:a ex:X ;
+                  ex:b ex:Y ;
+                  ex:c ex:Z .
+            ex:st1 rdf:type rdf:Statement ;
+                   rdf:subject ex:R5 ;
+                   rdf:predicate ex:a ;
+                   rdf:object ex:X ;
+                   ex:note "typed" .
+
+            # Reification case B: one typed and one untyped reifier.
+            ex:R6 ex:a ex:X ;
+                  ex:b ex:Y ;
+                  ex:c ex:Z .
+            ex:st2 rdf:type rdf:Statement ;
+                   rdf:subject ex:R6 ;
+                   rdf:predicate ex:a ;
+                   rdf:object ex:X ;
+                   ex:note "typed" .
+            ex:st3 rdf:subject ex:R6 ;
+                   rdf:predicate ex:b ;
+                   rdf:object ex:Y ;
+                   ex:note "untyped" ;
+                   ex:when "yesterday" .
+
+            # Incoming reification: statement A p B, reified by st4.
+            ex:A ex:p ex:B .
+            ex:st4 rdf:subject ex:A ;
+                   rdf:object ex:B ;
+                   ex:note "incoming" .
+
+            # Reifier whose rdf:object is a blank node.
+            ex:R7 ex:a ex:X .
+            ex:st5 rdf:subject ex:R7 ;
+                   rdf:object _:hidden ;
+                   ex:note "bnode-in-reification" .
+            _:hidden ex:v "hidden" .
+
+            # Blank node cycle.
+            ex:R8 ex:p _:c1 .
+            _:c1 ex:q _:c2 .
+            _:c2 ex:r _:c1 .
+        """, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(self.ex.R1)
+        # 3 direct triples + 2 from _:b1 + 1 from _:b2
+        self.assertEqual(len(result), 6)
+        self.assertIsInstance(result, Graph)
+
+    def testCbdTypeAndRelations(self):
+        result = self.graph.cbd(self.ex.R2)
+        self.assertEqual(len(result), 3)
+
+    def testCbdTwoProperties(self):
+        result = self.graph.cbd(self.ex.R3)
+        self.assertEqual(len(result), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(self.ex.nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        # 3 direct triples + 5 triples of the typed reifier
+        result = self.graph.cbd(self.ex.R5)
+        self.assertEqual(len(result), 8)
+        self.assertIn((self.ex.st1, RDF.subject, self.ex.R5), result)
+
+    def testCbdReifiedTypedAndUntyped(self):
+        # 3 direct triples + 5 typed reifier + 5 untyped reifier
+        result = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(result), 13)
+        # The untyped reifier must be included.
+        self.assertIn((self.ex.st3, RDF.subject, self.ex.R6), result)
+        self.assertIn((self.ex.st3, self.ex.note, Literal("untyped")), result)
+
+    def testCbdIncomingReificationExcluded(self):
+        # Reifier of statement (A p B) is attached to A, not B.
+        result_b = self.graph.cbd(self.ex.B)
+        self.assertEqual(len(result_b), 0)
+        self.assertNotIn((self.ex.st4, self.ex.note, Literal("incoming")),
+                         result_b)
+
+        result_a = self.graph.cbd(self.ex.A)
+        self.assertIn((self.ex.st4, self.ex.note, Literal("incoming")),
+                      result_a)
+
+    def testCbdBlankNodeInReificationNotExpanded(self):
+        result = self.graph.cbd(self.ex.R7)
+        # 1 direct triple + 3 triples of the reifier st5
+        self.assertEqual(len(result), 4)
+        self.assertIn((self.ex.st5, self.ex.note,
+                       Literal("bnode-in-reification")), result)
+        for s, p, o in result:
+            self.assertFalse(isinstance(s, BNode))
+
+    def testCbdBlankNodeCycleTerminates(self):
+        result = self.graph.cbd(self.ex.R8)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, None, None)))), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        before_len = len(self.graph)
+        result = self.graph.cbd(self.ex.R5)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before_len)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
