diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..bdfe7e4 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,58 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the starting node.
+        2. If an object of an included triple is a blank node, apply the
+           same rules recursively to that blank node, unless the result
+           already contains a triple whose subject is that blank node
+           (this guard makes blank-node cycles terminate).
+        3. Reification: for every statement whose rdf:subject is the node,
+           include every triple whose subject is that statement. No
+           rdf:Statement type check and no rdf:predicate or rdf:object
+           matching is applied, so untyped reifiers are included. The
+           blank nodes reached through reifiers are not expanded.
+
+        The result is a new Graph that is a subgraph of this Graph; this
+        Graph is not modified. Namespace bindings are not copied.
+
+        Note: this method does not implement SPARQL DESCRIBE.
+
+        :param resource: the starting node (a URIRef or BNode term).
+        :return: a new Graph containing the Concise Bounded Description.
+        """
+
+        def add_to_cbd(node, result):
+            # Step 1 (rule 1): add all triples whose subject is the node,
+            # expanding blank-node objects that have not been expanded yet.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode):
+                    has_subject = False
+                    for _ in result.triples((o, None, None)):
+                        has_subject = True
+                        break
+                    if not has_subject:
+                        add_to_cbd(o, result)
+
+            # Step 2 (rule 3): reifiers whose rdf:subject is the node
+            # contribute all of their triples. Reifiers are not expanded.
+            reifiers = [S for S, _, _ in
+                        self.triples((None, RDF.subject, node))]
+            for reifier in reifiers:
+                for t in self.triples((reifier, None, None)):
+                    result.add(t)
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..3dd15da
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,154 @@
+import unittest
+
+from rdflib import Graph, URIRef, BNode, Literal, ConjunctiveGraph
+from rdflib.namespace import RDF
+
+
+FIXTURE = u"""
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: resource with blank-node chain (7 triples from R1)
+ex:R1 ex:p1 ex:O1 ;
+      ex:p2 ex:O2 ;
+      ex:p3 [ ex:q1 "x" ;
+              ex:q2 [ ex:r1 "y" ; ex:r2 "z" ] ] .
+
+# Resource with a type triple and two relation triples (3)
+ex:R2 a ex:Thing ;
+      ex:rel ex:R3 ;
+      ex:rel2 ex:R4 .
+
+# Resource with two property triples (2)
+ex:R9 ex:name "nine" ;
+      ex:label "IX" .
+
+# Reified case A: R5 with a typed reifier (3 + 5 = 8)
+ex:R5 ex:a 1 ;
+      ex:b 2 ;
+      ex:c 3 .
+ex:S1 rdf:type rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:a ;
+      rdf:object 1 ;
+      ex:note "typed" .
+
+# Reified case B: R6 with a typed and an untyped reifier (3 + 5 + 5 = 13)
+ex:R6 ex:a 1 ;
+      ex:b 2 ;
+      ex:c 3 .
+ex:S2 rdf:type rdf:Statement ;
+      rdf:subject ex:R6 ;
+      rdf:predicate ex:a ;
+      rdf:object 1 ;
+      ex:note "typed" ;
+      ex:extra "more" .
+ex:S3 rdf:subject ex:R6 ;
+      rdf:predicate ex:b ;
+      rdf:object 2 ;
+      ex:n1 "one" ;
+      ex:n2 "two" .
+
+# Incoming reification: A p B with reifier S4 (rdf:subject A, rdf:object B)
+ex:A ex:p ex:B .
+ex:S4 rdf:subject ex:A ;
+      rdf:predicate ex:p ;
+      rdf:object ex:B ;
+      ex:note "incoming" .
+
+# Reifier whose blank-node object is not expanded (R7: 1 + 3 = 4)
+ex:R7 ex:p ex:O .
+ex:S5 rdf:subject ex:R7 ;
+      rdf:object [ ex:v "v" ; ex:w "w" ] ;
+      ex:note "bnode" .
+
+# Blank-node cycle: R8 -> _:c1 -> _:c2 -> _:c1 (3 triples)
+ex:R8 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("ex", "http://example.org/")
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.ex = "http://example.org/"
+
+    def tearDown(self):
+        self.graph.close()
+
+    def uri(self, local):
+        return URIRef(self.ex + local)
+
+    def testCbd(self):
+        result = self.graph.cbd(self.uri("R1"))
+        # 3 direct triples + 2 for the blank node + 2 for the nested one
+        self.assertEqual(len(result), 7)
+
+        result = self.graph.cbd(self.uri("R2"))
+        self.assertEqual(len(result), 3)
+
+        result = self.graph.cbd(self.uri("R9"))
+        self.assertEqual(len(result), 2)
+
+        result = self.graph.cbd(self.uri("NoSuchResource"))
+        self.assertEqual(len(result), 0)
+        self.assertIsInstance(result, Graph)
+
+    def testCbdReified(self):
+        # Typed reifier: 3 direct + 5 reifier triples
+        result = self.graph.cbd(self.uri("R5"))
+        self.assertEqual(len(result), 8)
+        self.assertIn((self.uri("S1"), RDF.subject, self.uri("R5")), result)
+
+        # Typed and untyped reifiers are both included
+        result = self.graph.cbd(self.uri("R6"))
+        self.assertEqual(len(result), 13)
+        self.assertIn((self.uri("S3"), self.uri("n1"), Literal("one")), result)
+
+    def testCbdIncomingReificationExcluded(self):
+        # The reifier of (A p B) contributes to cbd(A) only
+        result_a = self.graph.cbd(self.uri("A"))
+        self.assertEqual(len(result_a), 5)
+        self.assertIn((self.uri("S4"), self.uri("note"), Literal("incoming")),
+                      result_a)
+
+        result_b = self.graph.cbd(self.uri("B"))
+        self.assertEqual(len(result_b), 0)
+        self.assertNotIn((self.uri("S4"), self.uri("note"),
+                          Literal("incoming")), result_b)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(self.uri("R7"))
+        # 1 direct triple + 3 reifier triples; the blank node's triples
+        # are not added because it is reached only through a reifier.
+        self.assertEqual(len(result), 4)
+        for s, p, o in result:
+            self.assertNotIn(p, [self.uri("v"), self.uri("w")])
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(self.uri("R8"))
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, None, None)))), 3)
+
+    def testSourceGraphUnchanged(self):
+        before = set(self.graph)
+        before_len = len(self.graph)
+        result = self.graph.cbd(self.uri("R5"))
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before_len)
+        self.assertEqual(set(self.graph), before)
+
+    def testCbdConjunctiveGraph(self):
+        cg = ConjunctiveGraph()
+        for t in self.graph:
+            cg.add(t)
+        result = cg.cbd(self.uri("R1"))
+        self.assertEqual(len(result), 7)
+
+
+if __name__ == "__main__":
+    unittest.main()
