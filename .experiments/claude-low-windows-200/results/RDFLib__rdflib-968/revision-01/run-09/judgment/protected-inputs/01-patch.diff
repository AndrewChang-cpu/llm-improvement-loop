diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..6b75dfe 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,53 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Concise Bounded Description (CBD) of a resource.
+
+        Returns a new Graph holding the Concise Bounded Description of
+        ``resource``, following the three rules of the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. Every triple whose subject is the resource is included. If an
+           object of such a triple is a blank node, and the result does not
+           yet contain a triple with that blank node as subject, the blank
+           node is described by the same rules, recursively.
+        2. Reification: every statement S whose rdf:subject is the node (no
+           rdf:Statement type check, and no matching of rdf:predicate or
+           rdf:object values) is a reifier, and every triple whose subject is
+           S is included. This applies to every node described, including
+           blank nodes reached by rule 1. The rdf:predicate and rdf:object
+           values of a reifier are not followed, and blank nodes that are
+           objects of the triples added by this rule are not described.
+
+        The result is a subgraph of this graph; this graph is not modified.
+        Namespace bindings are not copied to the result.
+
+        :param resource: the resource (a term) to describe. It is used as given
+            in triple-pattern queries.
+        :return: a new Graph containing the Concise Bounded Description of
+            resource. It is empty if the resource has no triples and no
+            reifiers.
+        """
+
+        def add_to_cbd(node, cbd_graph):
+            # Rule 1: triples with node as subject; recurse into blank nodes
+            # that the result does not already describe.
+            for s, p, o in self.triples((node, None, None)):
+                cbd_graph.add((s, p, o))
+                if type(o) is BNode and \
+                        not any(cbd_graph.triples((o, None, None))):
+                    add_to_cbd(o, cbd_graph)
+            # Rule 2 (reification): for each reifier S of node, add all
+            # triples whose subject is S. Nothing is recursed into here.
+            for reifier in self.subjects(RDF.subject, node):
+                for s, p, o in self.triples((reifier, None, None)):
+                    cbd_graph.add((s, p, o))
+
+        retval = Graph()
+        add_to_cbd(resource, retval)
+        return retval
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..af67150
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,156 @@
+import unittest
+
+from rdflib import Graph, URIRef, Literal
+
+
+PREFIXES = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+"""
+
+FIXTURE = PREFIXES + """
+# R1: three direct triples, two URI objects and one blank node that has
+# a nested blank node. The blank node's triples are reached by rule 1.
+ex:R1 ex:p1 ex:O1 ;
+      ex:p2 ex:O2 ;
+      ex:p3 [ ex:q ex:X ;
+              ex:r [ ex:s "deep" ] ] .
+
+# R2: a type triple and two relation triples.
+ex:R2 a ex:Thing ;
+      ex:knows ex:R3 ;
+      ex:likes ex:R4 .
+ex:R3 ex:name "unrelated" .
+
+# R5: two property triples.
+ex:R5 ex:name "five" ;
+      ex:age "5" .
+
+# R6, case A: three direct triples plus a typed reifier (5 triples).
+ex:R6 ex:p1 ex:O1 ;
+      ex:p2 ex:O2 ;
+      ex:p3 ex:O3 .
+ex:st1 a rdf:Statement ;
+       rdf:subject ex:R6 ;
+       rdf:predicate ex:p1 ;
+       rdf:object ex:O1 ;
+       ex:certainty "high" .
+
+# R7, case B: three direct triples plus a typed reifier (5 triples) and an
+# untyped reifier (5 triples, no rdf:Statement type).
+ex:R7 ex:p1 ex:O1 ;
+      ex:p2 ex:O2 ;
+      ex:p3 ex:O3 .
+ex:st2 a rdf:Statement ;
+       rdf:subject ex:R7 ;
+       rdf:predicate ex:p1 ;
+       rdf:object ex:O1 ;
+       ex:certainty "high" .
+ex:st3 rdf:subject ex:R7 ;
+       rdf:predicate ex:p2 ;
+       rdf:object ex:O2 ;
+       ex:note "untyped" ;
+       ex:source "test" .
+
+# Incoming reification: A p B is reified by st4, whose rdf:subject is A and
+# whose rdf:object is B.
+ex:A ex:p ex:B .
+ex:st4 rdf:subject ex:A ;
+       rdf:predicate ex:p ;
+       rdf:object ex:B ;
+       ex:note "incoming" .
+
+# Blank node referenced by a reifier must not be expanded through it.
+ex:R8 ex:p ex:O8 .
+ex:st5 rdf:subject ex:R8 ;
+       ex:note [ ex:val "hidden" ] .
+
+# Blank-node cycle: C p _:x, _:x q _:y, _:y r _:x.
+ex:C ex:p _:x .
+_:x ex:q _:y .
+_:y ex:r _:x .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", "http://example.org/")
+        self.ex = "http://example.org/"
+
+    def tearDown(self):
+        self.graph.close()
+
+    def uri(self, local):
+        return URIRef(self.ex + local)
+
+    def testCbd(self):
+        # Rule 1 only: R1 has 3 direct triples, plus the blank node's
+        # triples (q, r) and the nested blank node's triple (s).
+        r1 = self.uri("R1")
+        result = self.graph.cbd(r1)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 6)
+
+        # type triple and two relation triples
+        self.assertEqual(len(self.graph.cbd(self.uri("R2"))), 3)
+
+        # two property triples
+        self.assertEqual(len(self.graph.cbd(self.uri("R5"))), 2)
+
+        # no triples at all: empty graph, not an error
+        empty = self.graph.cbd(self.uri("NoSuchResource"))
+        self.assertIsInstance(empty, Graph)
+        self.assertEqual(len(empty), 0)
+
+    def testCbdReified(self):
+        # Reified case A: 3 direct + typed reifier's 5 triples
+        self.assertEqual(len(self.graph.cbd(self.uri("R6"))), 8)
+
+        # Reified case B: 3 direct + typed reifier (5) + untyped reifier (5)
+        result = self.graph.cbd(self.uri("R7"))
+        self.assertEqual(len(result), 13)
+        self.assertIn(
+            (self.uri("st3"), self.uri("note"), Literal("untyped")), result)
+
+    def testCbdIncomingReificationExcluded(self):
+        # The reifier of A p B is described from its subject A only.
+        result_a = self.graph.cbd(self.uri("A"))
+        self.assertEqual(len(result_a), 5)
+        self.assertIn((self.uri("st4"), self.uri("note"),
+                       Literal("incoming")), result_a)
+
+        # B is the rdf:object of the reifier, so the reifier is not included.
+        result_b = self.graph.cbd(self.uri("B"))
+        self.assertEqual(len(result_b), 0)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(self.uri("R8"))
+        # R8 p O8, plus the reifier's rdf:subject and note triples.
+        self.assertEqual(len(result), 3)
+        # The blank node referenced by the reifier is not described.
+        self.assertEqual(len(list(result.triples((None, self.uri("val"),
+                                                  None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(self.uri("C"))
+        # C p _:x, _:x q _:y, _:y r _:x; each triple appears once.
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(set(result)), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        count = len(self.graph)
+        result = self.graph.cbd(self.uri("R6"))
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), count)
+        self.assertEqual(set(self.graph), before)
+        # the result is a subgraph of the source
+        for triple in result:
+            self.assertIn(triple, self.graph)
+
+
+if __name__ == '__main__':
+    unittest.main()
