diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..5a15eab 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,50 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission at https://www.w3.org/Submission/CBD/ and is applied here
+        with the following rules:
+
+        1. Every triple whose subject is the resource is included.
+        2. For every blank node object of a triple included by rule 1, the
+           same rules are applied recursively. A blank node is expanded only
+           when the result does not already contain a triple whose subject
+           is that blank node, so cycles terminate.
+        3. Reification: every statement whose rdf:subject is the node (or a
+           blank node reached by rules 1 and 2) is included, together with all
+           triples of that statement. No rdf:Statement type check is made and
+           the rdf:predicate and rdf:object values are not matched. Blank
+           nodes that are objects of the triples added by this rule are not
+           expanded.
+
+        The result is a subgraph of this graph; this graph is not modified.
+        This method does not implement SPARQL DESCRIBE.
+
+        :param resource: the resource (a node) to describe.
+        :return: a new Graph containing the Concise Bounded Description of
+            resource. The result is empty if there is no matching data.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1 (and recursion into blank nodes, rule 2)
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and not any(
+                        result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3 (reification): statements whose rdf:subject is node
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..7c55a04
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,131 @@
+import unittest
+
+from rdflib import Graph, Namespace, BNode
+from rdflib.namespace import RDF
+
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# blank-node resource: R1 (3 direct) + _:a (2) + _:g (1) = 6
+ex:R1 ex:name "one" ;
+      ex:knows ex:R2 ;
+      ex:address [ ex:street "main" ; ex:geo [ ex:lat "1" ] ] .
+ex:R2 ex:name "two" .
+
+# type triple and two relation triples = 3
+ex:R3 a ex:Thing ;
+      ex:likes ex:R2 ;
+      ex:likes ex:R1 .
+
+# two property triples = 2
+ex:R4 ex:name "four" ;
+      ex:age "4" .
+
+# Reified case A: R5 (3 direct) + typed reifier (5) = 8
+ex:R5 ex:name "five" ;
+      ex:knows ex:R2 ;
+      ex:age "5" .
+ex:st5 a rdf:Statement ;
+       rdf:subject ex:R5 ;
+       rdf:predicate ex:name ;
+       rdf:object "five" ;
+       ex:note "n5" .
+
+# Reified case B: R6 (3 direct) + typed reifier (5) + untyped reifier (5) = 13
+ex:R6 ex:name "six" ;
+      ex:knows ex:R2 ;
+      ex:age "6" .
+ex:st6a a rdf:Statement ;
+        rdf:subject ex:R6 ;
+        rdf:predicate ex:name ;
+        rdf:object "six" ;
+        ex:note "a" .
+ex:st6b rdf:subject ex:R6 ;
+        rdf:predicate ex:age ;
+        rdf:object "6" ;
+        ex:note "b" ;
+        ex:source "c" .
+
+# Incoming reification: statement A p B with reifier having subject A, object B
+ex:A ex:p ex:B .
+ex:st7 rdf:subject ex:A ;
+       rdf:predicate ex:p ;
+       rdf:object ex:B ;
+       ex:note "x" .
+
+# Blank node in reifier: reifier's rdf:object blank node is not expanded
+ex:R8 ex:name "eight" .
+ex:st8 rdf:subject ex:R8 ;
+       rdf:object [ ex:inner "deep" ] ;
+       ex:note "y" .
+
+# Blank-node cycle: _:c1 -> _:c2 -> _:c1
+ex:R9 ex:link _:c1 .
+_:c1 ex:next _:c2 .
+_:c2 ex:next _:c1 .
+"""
+
+EX = Namespace("http://example.org/")
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=TURTLE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # rule 1 with blank node recursion
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 6)
+        # type triple and two relation triples
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 3)
+        # two property triples
+        self.assertEqual(len(self.graph.cbd(EX.R4)), 2)
+        # no triples
+        self.assertEqual(len(self.graph.cbd(EX.Nothing)), 0)
+
+    def testCbdReified(self):
+        # typed reifier is included
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+
+    def testCbdUntypedReifier(self):
+        # both typed and untyped reifiers are included
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertTrue((EX.st6b, RDF.subject, EX.R6) in result)
+        self.assertTrue((EX.st6b, EX.source, None) in result)
+
+    def testCbdIncomingReificationExcluded(self):
+        # reifier of A p B does not describe B
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        # reifier of A is included for A
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 5)
+        self.assertTrue((EX.st7, EX.note, None) in result)
+
+    def testCbdBlankNodeInReifierNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(list(result.triples((None, EX.inner, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, EX.next, None)))), 2)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(set(self.graph), before)
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+
+
+if __name__ == '__main__':
+    unittest.main()
