diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..5ab6547 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        The Concise Bounded Description is built by the three rules of the
+        W3C Member Submission (https://www.w3.org/Submission/CBD/):
+
+        1. Every triple whose subject is the resource is included. Objects
+           that are blank nodes are followed recursively, and each blank node
+           is expanded only once (a blank node is expanded only if the result
+           does not yet contain a triple with that blank node as subject).
+        2. Reification: for every statement whose rdf:subject is the node,
+           every triple whose subject is that statement (the reifier) is
+           included. Reifiers are found by their rdf:subject triple only; no
+           rdf:Statement type check and no rdf:predicate or rdf:object
+           matching is performed. Blank node objects of these triples are
+           not followed.
+        3. Rule 2 is applied to every node processed by rule 1, including
+           blank nodes reached through rule 1.
+
+        The result is a subgraph of this Graph; this Graph is not modified.
+        Namespace bindings are not copied to the result.
+
+        :param resource: The resource (node) whose description is requested.
+        :return: A new Graph containing the Concise Bounded Description of
+                 the resource. It is empty if the resource has no triples and
+                 no reifiers.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples with the node as subject.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and (o, None, None) not in result:
+                    add_to_cbd(o)
+
+            # Rule 2: reifiers whose rdf:subject is the node.
+            for reifier in self.subjects(RDF.subject, node):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..d9ea86b
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,142 @@
+import unittest
+
+from rdflib import Graph, Namespace, URIRef, BNode
+from rdflib.namespace import RDF
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: blank node with nested blank node (6 triples for ex:R1)
+ex:R1 ex:p1 ex:U1 ;
+      ex:p2 ex:U2 ;
+      ex:p3 [ ex:q "x" ; ex:r [ ex:s "y" ] ] .
+ex:U1 ex:name "U1" .
+
+# Three triples: type and two relations (3 for ex:R2)
+ex:R2 a ex:Thing ;
+      ex:p1 ex:U1 ;
+      ex:p2 ex:U2 .
+
+# Two property triples (2 for ex:R3)
+ex:R3 ex:p1 "a" ;
+      ex:p2 "b" .
+
+# Typed reifier (rdf:Statement) with 5 triples in total (8 for ex:R5)
+ex:R5 ex:a "1" ;
+      ex:b "2" ;
+      ex:c ex:U .
+ex:st1 a rdf:Statement ;
+       rdf:subject ex:R5 ;
+       rdf:predicate ex:c ;
+       rdf:object ex:U ;
+       ex:note "n" .
+
+# Typed reifier with 5 triples plus untyped reifier with 5 triples (13 for ex:R6)
+ex:R6 ex:a "1" ;
+      ex:b "2" ;
+      ex:c ex:U .
+ex:st2 a rdf:Statement ;
+       rdf:subject ex:R6 ;
+       rdf:predicate ex:c ;
+       rdf:object ex:U ;
+       ex:note "n" .
+ex:st3 rdf:subject ex:R6 ;
+       rdf:predicate ex:a ;
+       rdf:object "x" ;
+       ex:p "1" ;
+       ex:q "2" .
+
+# Incoming reification: statement ex:A ex:p ex:B reified by ex:st4
+ex:A ex:p ex:B .
+ex:st4 rdf:subject ex:A ;
+       rdf:predicate ex:p ;
+       rdf:object ex:B ;
+       ex:note "x" .
+
+# Reifier whose object is a blank node (not expanded through rule 2)
+ex:R7 ex:a "1" .
+ex:st5 rdf:subject ex:R7 ;
+       rdf:object [ ex:v "bx" ] ;
+       ex:meta [ ex:w "by" ] .
+
+# Blank node cycle (4 triples for ex:C)
+ex:C ex:link _:c1 .
+_:c1 ex:next _:c2 .
+_:c2 ex:next _:c1 ;
+     ex:name "c2" .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        cbd = self.graph.cbd(EX.R1)
+        self.assertIsInstance(cbd, Graph)
+        self.assertEqual(len(cbd), 6)
+        self.assertNotIn((EX.U1, EX.name, None), cbd)
+        self.assertIn((EX.R1, EX.p1, EX.U1), cbd)
+
+    def testCbdTypeAndRelations(self):
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+
+    def testCbdPropertiesOnly(self):
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+
+    def testCbdNoTriples(self):
+        cbd = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(cbd, Graph)
+        self.assertEqual(len(cbd), 0)
+
+    def testCbdTypedReified(self):
+        cbd = self.graph.cbd(EX.R5)
+        self.assertEqual(len(cbd), 8)
+        self.assertIn((EX.st1, EX.note, None), cbd)
+
+    def testCbdReifiedUntypedIncluded(self):
+        cbd = self.graph.cbd(EX.R6)
+        self.assertEqual(len(cbd), 13)
+        self.assertIn((EX.st3, EX.p, None), cbd)
+        self.assertIn((EX.st3, RDF.subject, EX.R6), cbd)
+
+    def testCbdIncomingReificationExcluded(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+
+    def testCbdOutgoingReificationIncluded(self):
+        cbd = self.graph.cbd(EX.A)
+        self.assertIn((EX.A, EX.p, EX.B), cbd)
+        self.assertIn((EX.st4, EX.note, None), cbd)
+        self.assertEqual(len(cbd), 5)
+
+    def testCbdReifierBlankNodeObjectNotExpanded(self):
+        cbd = self.graph.cbd(EX.R7)
+        self.assertEqual(len(cbd), 4)
+        self.assertEqual(len(list(cbd.triples((None, EX.v, None)))), 0)
+        self.assertEqual(len(list(cbd.triples((None, EX.w, None)))), 0)
+
+    def testCbdBlankNodeCycleTerminates(self):
+        cbd = self.graph.cbd(EX.C)
+        self.assertEqual(len(cbd), 4)
+        self.assertEqual(len(list(cbd.triples((None, EX.name, None)))), 1)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        cbd = self.graph.cbd(EX.R6)
+        self.assertIsNot(cbd, self.graph)
+        self.assertEqual(set(self.graph), before)
+        for triple in cbd:
+            self.assertIn(triple, self.graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
