diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..b718001 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,53 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the Resource.
+        2. Recursively, for every triple included by rule 1 whose object is a
+           blank node, include the blank node's CBD (the blank node is only
+           expanded when the result does not already contain a triple with
+           that blank node as subject, so cycles terminate).
+        3. Reification: for every statement S whose rdf:subject is the node
+           being described, include every triple whose subject is S. This is
+           applied to every node processed, including blank nodes reached by
+           rules 1 and 2. Every statement with rdf:subject equal to the node
+           is included: there is no rdf:Statement type check and no matching
+           of rdf:predicate or rdf:object values. Blank nodes that are objects
+           of the triples added by rule 3 are not expanded, and the rdf:object
+           and rdf:predicate values of a reifier are not followed.
+
+        The result is a subgraph of this Graph: it contains only triples that
+        exist in this Graph, and this Graph is not modified. This method does
+        not implement SPARQL DESCRIBE.
+
+        :param resource: the node whose Concise Bounded Description is returned
+        :return: a new Graph containing the Concise Bounded Description of
+            ``resource``; empty if there is no matching data
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples whose subject is the node.
+            for s, p, o in list(self.triples((node, None, None))):
+                result.add((s, p, o))
+                # Rule 2: expand unvisited blank node objects.
+                if type(o) is BNode and \
+                        next(result.triples((o, None, None)), None) is None:
+                    add_to_cbd(o)
+            # Rule 3: reifiers whose rdf:subject is the node.
+            for reifier, _, _ in list(
+                    self.triples((None, RDF.subject, node))):
+                for t in list(self.triples((reifier, None, None))):
+                    result.add(t)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..41cb6ad
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,133 @@
+import unittest
+
+from rdflib import Graph, Namespace, RDF, BNode, URIRef
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: nested blank nodes (R1 has 7 reachable triples).
+ex:R1 ex:p1 ex:O1 ;
+      ex:p2 ex:O2 ;
+      ex:p3 [ ex:q1 "x" ;
+              ex:q2 [ ex:r1 "y" ; ex:r2 "z" ] ] .
+
+# Rules 1 only: URI objects are not expanded (3 triples).
+ex:R2 ex:type ex:Thing ;
+      ex:rel ex:R3 ;
+      ex:rel2 ex:R4 .
+
+# Two property triples (2 triples).
+ex:R9 ex:name "nine" ;
+      ex:label "Nine" .
+
+# Reified case A: 3 direct triples + typed reifier with 5 triples (8 total).
+ex:R5 ex:a "1" ;
+      ex:b "2" ;
+      ex:c "3" .
+_:s1 a rdf:Statement ;
+     rdf:subject ex:R5 ;
+     rdf:predicate ex:a ;
+     rdf:object "1" ;
+     ex:note "about a" .
+
+# Reified case B: 3 direct triples + typed reifier (5) + untyped reifier (5).
+ex:R6 ex:a "1" ;
+      ex:b "2" ;
+      ex:c "3" .
+_:s2 a rdf:Statement ;
+     rdf:subject ex:R6 ;
+     rdf:predicate ex:a ;
+     rdf:object "1" ;
+     ex:note "typed" .
+_:s3 rdf:subject ex:R6 ;
+     rdf:predicate ex:b ;
+     rdf:object "2" ;
+     ex:note "untyped" ;
+     ex:source "test" .
+
+# Incoming reification: statement A p B, reifier with subject A and object B.
+ex:A ex:p ex:B .
+_:s4 rdf:subject ex:A ;
+     rdf:object ex:B ;
+     ex:note "incoming" .
+
+# Blank node inside a reifier is not expanded.
+ex:R7 ex:p ex:O .
+_:s5 rdf:subject ex:R7 ;
+     ex:note _:bn1 .
+_:bn1 ex:deep "d" .
+
+# Blank-node cycle: c1 -> c2 -> c1.
+ex:R8 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:q _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(EX.R1)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 7)
+
+        result = self.graph.cbd(EX.R2)
+        self.assertEqual(len(result), 3)
+
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 2)
+
+        result = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        # Case A: typed reifier is included.
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+        self.assertIn((None, RDF.subject, EX.R5), result)
+
+        # Case B: typed and untyped reifiers are both included.
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((None, RDF.subject, EX.R6), result)
+        self.assertIn((None, EX.source, None), result)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 4)
+        self.assertIn((EX.A, EX.p, EX.B), result)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(EX.R7)
+        self.assertEqual(len(result), 3)
+        self.assertNotIn((None, EX.deep, None), result)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+        triples = list(result)
+        self.assertEqual(len(triples), len(set(triples)))
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
