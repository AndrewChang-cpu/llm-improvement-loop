diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..ed54835 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,50 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a resource.
+
+        Implements the three rules of the W3C Member Submission on Concise
+        Bounded Descriptions (https://www.w3.org/Submission/CBD/):
+
+        1. Include every triple whose subject is the resource.
+        2. For every object of such a triple that is a blank node not yet
+           described in the result, apply the same rules to that blank
+           node, recursively.
+        3. Reification: for every statement whose ``rdf:subject`` is the
+           resource (or a blank node being described), include every
+           triple whose subject is that statement. Every statement with
+           that ``rdf:subject`` is included, whether or not it has an
+           ``rdf:Statement`` type and regardless of its ``rdf:predicate``
+           and ``rdf:object`` values. The ``rdf:predicate`` and
+           ``rdf:object`` values of such statements are not followed.
+
+        The result is a subgraph of this graph; this graph is not modified.
+        This method does not implement SPARQL DESCRIBE.
+
+        :param resource: the resource (node) to describe.
+        :return: a new :class:`Graph` containing the Concise Bounded
+            Description of ``resource``. It is empty if no triples apply.
+        """
+
+        def add_to_cbd(node, cbd):
+            # Rule 1: triples whose subject is the node
+            for triple in self.triples((node, None, None)):
+                cbd.add(triple)
+                obj = triple[2]
+                # Rule 2: expand blank-node objects not yet described
+                if type(obj) is BNode and not any(
+                        cbd.triples((obj, None, None))):
+                    add_to_cbd(obj, cbd)
+            # Rule 3: reification via rdf:subject
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    cbd.add(triple)
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..abe8123
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,144 @@
+import unittest
+
+from rdflib import BNode, Graph, Namespace, RDF
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Blank-node resource: 3 direct + 3 on the blank node + 2 on its nested blank node = 8
+ex:R1 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 [ ex:q1 "x" ;
+              ex:q2 [ ex:r1 "y" ; ex:r2 "z" ] ;
+              ex:q3 "w" ] .
+
+# Type and two relations: 3
+ex:R2 a ex:Thing ;
+      ex:knows ex:R3 ;
+      ex:likes ex:R4 .
+ex:R3 ex:label "three" .
+
+# Two property triples: 2
+ex:R7 ex:label "seven" ;
+      ex:comment "c7" .
+
+# Reified case A: 3 direct + typed reifier with 5 triples = 8
+ex:R5 ex:p1 "a" ;
+      ex:p2 "b" ;
+      ex:p3 ex:R2 .
+ex:S5 a rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:p3 ;
+      rdf:object ex:R2 ;
+      ex:note "n5" .
+
+# Reified case B: 3 direct + typed reifier (5) + untyped reifier (5) = 13
+ex:R6 ex:p1 "a" ;
+      ex:p2 "b" ;
+      ex:p3 "c" .
+ex:S6a a rdf:Statement ;
+       rdf:subject ex:R6 ;
+       rdf:predicate ex:p1 ;
+       rdf:object "a" ;
+       ex:note "n6" .
+ex:S6b rdf:subject ex:R6 ;
+       rdf:predicate ex:p2 ;
+       rdf:object "b" ;
+       ex:note "x6" ;
+       ex:note2 "y6" .
+
+# Incoming reification: A p B, reifier with rdf:subject A and rdf:object B
+ex:A16 ex:p ex:B16 .
+ex:B16 ex:name "b" .
+ex:S16 a rdf:Statement ;
+       rdf:subject ex:A16 ;
+       rdf:predicate ex:p ;
+       rdf:object ex:B16 ;
+       ex:note "n16" .
+
+# Blank node object of a reifier is not expanded
+ex:R10 ex:p ex:C10 .
+ex:S10 a rdf:Statement ;
+       rdf:subject ex:R10 ;
+       rdf:predicate ex:p ;
+       rdf:object [ ex:deep "d" ] .
+
+# Blank-node cycle: _:c1 -> _:c2 -> _:c1
+ex:R11 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 ;
+     ex:s "end" .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R7)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.NoSuch)), 0)
+
+    def testCbdReturnsGraph(self):
+        result = self.graph.cbd(EX.NoSuch)
+        self.assertIsInstance(result, Graph)
+        self.assertIsNot(result, self.graph)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+        self.assertIn((EX.S5, RDF.subject, EX.R5), result)
+        self.assertIn((EX.S5, EX.note, None), result)
+
+    def testCbdReifiedUntyped(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S6b, RDF.subject, EX.R6), result)
+        self.assertIn((EX.S6b, EX.note2, None), result)
+
+    def testCbdIncomingReification(self):
+        result_b = self.graph.cbd(EX.B16)
+        self.assertEqual(len(result_b), 1)
+        self.assertIn((EX.B16, EX.name, None), result_b)
+        self.assertEqual(len(list(result_b.triples((EX.S16, None, None)))), 0)
+
+        result_a = self.graph.cbd(EX.A16)
+        self.assertIn((EX.S16, RDF.subject, EX.A16), result_a)
+        self.assertEqual(len(result_a), 6)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        bnode = self.graph.value(EX.S10, RDF.object)
+        self.assertIsInstance(bnode, BNode)
+        result = self.graph.cbd(EX.R10)
+        self.assertEqual(len(result), 5)
+        self.assertEqual(len(list(result.triples((bnode, None, None)))), 0)
+        self.assertNotIn((bnode, EX.deep, None), result)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R11)
+        self.assertEqual(len(result), 4)
+        self.assertIn((EX.R11, EX.p, None), result)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        length_before = len(self.graph)
+        self.graph.cbd(EX.R1)
+        self.graph.cbd(EX.R5)
+        self.graph.cbd(EX.R11)
+        self.assertEqual(set(self.graph), before)
+        self.assertEqual(len(self.graph), length_before)
+
+
+if __name__ == "__main__":
+    unittest.main()
