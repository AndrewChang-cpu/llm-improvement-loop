diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..a85ffa0 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,48 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the starting node.
+        2. Recursively apply rule 1 to the object of each such triple when
+           that object is a blank node which is not already described.
+        3. Reification: for every node R of the description, include every
+           statement S with rdf:subject R, and all triples whose subject is S.
+           This is applied as it behaves here: any node S that has an
+           rdf:subject triple whose object is R counts as a reifier, with no
+           rdf:Statement type check and no matching of rdf:predicate or
+           rdf:object values. Objects of the reifier's triples are not
+           followed.
+
+        The result is a subgraph of this graph; this graph is not modified.
+        The result is a new Graph; namespace bindings are not copied.
+
+        :param resource: the starting node (a term used as the subject of
+            the triple-pattern queries on this graph)
+        :return: a new Graph containing the Concise Bounded Description of
+            resource, which is empty if there is no matching data
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples whose subject is the node.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and \
+                        not any(result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3: reifiers of the node (triples with rdf:subject node).
+            for reifier in self.subjects(RDF.subject, node):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..cf43d85
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,155 @@
+import unittest
+
+from rdflib import Graph, URIRef, BNode
+from rdflib.namespace import RDF
+
+
+EX = "http://example.org/"
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: R1 has three direct triples; one object is a blank node
+# with a nested blank node.
+ex:R1 ex:p "a" ;
+      ex:q ex:R2 ;
+      ex:r _:b1 .
+ex:R2 ex:s "x" .
+_:b1 ex:t "y" ;
+     ex:u _:b2 .
+_:b2 ex:v "z" .
+
+# Rule 1 and 2 with a resource that has a type triple and two relations.
+ex:R3 rdf:type ex:Thing ;
+      ex:rel1 ex:R4 ;
+      ex:rel2 ex:R4 .
+
+# Two property triples.
+ex:R4 ex:name "four" ;
+      ex:label "Four" .
+
+# Reification case A: R5 with a typed reifier (5 triples in total).
+ex:R5 ex:a "1" ;
+      ex:b "2" ;
+      ex:c "3" .
+ex:S1 rdf:type rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:a ;
+      rdf:object "1" ;
+      ex:note "typed" .
+
+# Reification case B: R6 with a typed reifier and an untyped reifier.
+ex:R6 ex:a "1" ;
+      ex:b "2" ;
+      ex:c "3" .
+ex:S2 rdf:type rdf:Statement ;
+      rdf:subject ex:R6 ;
+      rdf:predicate ex:a ;
+      rdf:object "1" ;
+      ex:note "typed" .
+ex:S3 rdf:subject ex:R6 ;
+      rdf:predicate ex:b ;
+      rdf:object "2" ;
+      ex:note "untyped" ;
+      ex:extra "more" .
+
+# Incoming reification: A p B, reified by S4 with rdf:subject A, rdf:object B.
+ex:A ex:p ex:B .
+ex:S4 rdf:subject ex:A ;
+      rdf:object ex:B ;
+      ex:note "incoming" .
+
+# Reifier whose object is a blank node: the blank node is not expanded.
+ex:R7 ex:p ex:R8 .
+ex:S5 rdf:subject ex:R7 ;
+      rdf:object _:bn ;
+      ex:note "bnode-in-reification" .
+_:bn ex:deep "d" .
+
+# Blank-node cycle.
+ex:C ex:p _:x .
+_:x ex:q _:y .
+_:y ex:r _:x .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def term(self, local):
+        return URIRef(EX + local)
+
+    def testCbd(self):
+        r1 = self.term("R1")
+        result = self.graph.cbd(r1)
+        self.assertIsInstance(result, Graph)
+        self.assertIsNot(result, self.graph)
+        # 3 direct triples, plus 2 for _:b1 and 1 for _:b2.
+        self.assertEqual(len(result), 6)
+
+        r3 = self.term("R3")
+        self.assertEqual(len(self.graph.cbd(r3)), 3)
+
+        r4 = self.term("R4")
+        self.assertEqual(len(self.graph.cbd(r4)), 2)
+
+        nothing = self.term("Nothing")
+        empty = self.graph.cbd(nothing)
+        self.assertIsInstance(empty, Graph)
+        self.assertEqual(len(empty), 0)
+
+    def testCbdTypedReified(self):
+        r5 = self.term("R5")
+        # 3 direct triples plus the 5 triples of the typed reifier S1.
+        self.assertEqual(len(self.graph.cbd(r5)), 8)
+
+    def testCbdUntypedReifiedIncluded(self):
+        r6 = self.term("R6")
+        # 3 direct triples, 5 for typed reifier S2, 5 for untyped reifier S3.
+        self.assertEqual(len(self.graph.cbd(r6)), 13)
+        untyped = self.term("S3")
+        self.assertIn((untyped, self.term("note"), None),
+                      self.graph.cbd(r6))
+
+    def testCbdIncomingReificationExcluded(self):
+        a = self.term("A")
+        b = self.term("B")
+        self.assertEqual(len(self.graph.cbd(b)), 0)
+        # A has one direct triple plus the 3 triples of reifier S4.
+        self.assertEqual(len(self.graph.cbd(a)), 4)
+
+    def testCbdBlankNodeInReificationNotExpanded(self):
+        r7 = self.term("R7")
+        result = self.graph.cbd(r7)
+        # 1 direct triple plus 3 triples of reifier S5; _:bn is not expanded.
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(list(result.triples((None, self.term("deep"),
+                                                  None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        c = self.term("C")
+        result = self.graph.cbd(c)
+        # Each of the 3 triples of the cycle appears exactly once.
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(set(result)), len(result))
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        size = len(self.graph)
+        for name in ("R1", "R5", "R6", "A", "R7", "C"):
+            result = self.graph.cbd(self.term(name))
+            self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), size)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
