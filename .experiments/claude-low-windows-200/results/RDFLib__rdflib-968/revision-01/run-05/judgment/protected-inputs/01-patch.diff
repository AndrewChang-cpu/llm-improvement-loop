diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..11d8d0f 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission at https://www.w3.org/Submission/CBD/ and is implemented
+        here by the following rules:
+
+        1. Include every triple whose subject is the resource.
+        2. If an object of an included triple is a blank node, recursively
+           apply rules 1 and 2 to that blank node, unless the result already
+           contains a triple whose subject is that blank node.
+        3. Reification: for every statement whose rdf:subject is the resource
+           (or a blank node included by the rules above), include all triples
+           whose subject is that statement. The statement is included
+           regardless of whether it has an rdf:Statement type or whether its
+           rdf:predicate or rdf:object values match any triple in the graph.
+           Blank nodes that are objects of the triples added by this rule are
+           not expanded, and the rdf:predicate and rdf:object values of a
+           statement are not followed.
+
+        The result is a subgraph of this Graph; this Graph is not modified.
+        The result is a new Graph, which is empty if the resource has no
+        matching triples.
+
+        :param resource: the resource (node) whose description is requested
+        :return: a new Graph containing the Concise Bounded Description
+        """
+
+        def add_to_cbd(node, cbd):
+            # Rules 1 and 2: triples with node as subject.
+            for s, p, o in self.triples((node, None, None)):
+                cbd.add((s, p, o))
+                if isinstance(o, BNode) and not any(
+                        True for _ in cbd.triples((o, None, None))):
+                    add_to_cbd(o, cbd)
+            # Rule 3: statements that have node as their rdf:subject.
+            for statement, _, _ in self.triples((None, RDF.subject, node)):
+                for s, p, o in self.triples((statement, None, None)):
+                    cbd.add((s, p, o))
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..d256be2
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,107 @@
+import unittest
+
+from rdflib import Graph, URIRef, RDF
+
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Resource with a blank node chain: R1 -> _:b1 -> _:b2 (6 triples in CBD)
+ex:R1 ex:p1 "a" ; ex:p2 ex:X ; ex:p3 [ ex:q1 "c" ; ex:q2 [ ex:r1 "d" ] ] .
+ex:X ex:z "e" .
+
+# Resource with two property triples
+ex:R2 ex:p1 "a" ; ex:p2 "b" .
+
+# Resource with a type triple and two relation triples
+ex:R3 rdf:type ex:Thing ; ex:p1 ex:R1 ; ex:p2 ex:R2 .
+
+# Reified case A: typed reifier of R5 (5 triples)
+ex:R5 ex:p1 "a" ; ex:p2 "b" ; ex:p3 "c" .
+[] rdf:type rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:p1 ;
+   rdf:object "a" ; ex:note "n" .
+
+# Reified case B: typed reifier (5 triples) and untyped reifier (5 triples) of R6
+ex:R6 ex:p1 "a" ; ex:p2 "b" ; ex:p3 "c" .
+[] rdf:type rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:p1 ;
+   rdf:object "a" ; ex:note "n" .
+[] rdf:subject ex:R6 ; rdf:predicate ex:p2 ; rdf:object "b" ;
+   ex:a "1" ; ex:b "2" .
+
+# Incoming reification: statement (ex:A ex:p ex:B) reified by _:s3
+ex:A ex:p ex:B .
+[] rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:B ; ex:note "x" .
+
+# Reifier whose triples point to a blank node that must not be expanded
+ex:R7 ex:p "a" .
+[] rdf:subject ex:R7 ; ex:note [ ex:q "z" ] .
+
+# Blank-node cycle: R8 -> _:c1 -> _:c2 -> _:c1 (3 triples in CBD)
+ex:R8 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", "http://example.org/")
+        self.ex = "http://example.org/"
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        cbd = self.graph.cbd(URIRef(self.ex + "R1"))
+        # 3 direct triples + 2 blank node triples + 1 nested blank node triple
+        self.assertEqual(len(cbd), 6)
+        self.assertEqual(
+            len(self.graph.cbd(URIRef(self.ex + "R2"))), 2)
+        self.assertEqual(
+            len(self.graph.cbd(URIRef(self.ex + "R3"))), 3)
+        self.assertEqual(
+            len(self.graph.cbd(URIRef(self.ex + "Nothing"))), 0)
+
+    def testCbdReified(self):
+        # Typed reifier only: 3 direct + 5 reifier triples
+        cbd = self.graph.cbd(URIRef(self.ex + "R5"))
+        self.assertEqual(len(cbd), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        # 3 direct + 5 typed reifier + 5 untyped reifier
+        cbd = self.graph.cbd(URIRef(self.ex + "R6"))
+        self.assertEqual(len(cbd), 13)
+        self.assertIn(
+            (None, RDF.subject, URIRef(self.ex + "R6")), cbd)
+        self.assertEqual(
+            len(list(cbd.triples((None, URIRef(self.ex + "a"), None)))), 1)
+
+    def testCbdIncomingReificationExcluded(self):
+        # The reifier of (A p B) is not part of the description of B
+        self.assertEqual(len(self.graph.cbd(URIRef(self.ex + "B"))), 0)
+        # ...but it is part of the description of A: 1 triple + 4 reifier triples
+        self.assertEqual(len(self.graph.cbd(URIRef(self.ex + "A"))), 5)
+
+    def testCbdBlankNodeInReificationNotExpanded(self):
+        # 1 direct triple + 2 reifier triples; ex:q triple of the blank node
+        # reached only through the reifier is not included
+        cbd = self.graph.cbd(URIRef(self.ex + "R7"))
+        self.assertEqual(len(cbd), 3)
+        self.assertEqual(
+            len(list(cbd.triples((None, URIRef(self.ex + "q"), None)))), 0)
+
+    def testCbdBlankNodeCycleTerminates(self):
+        cbd = self.graph.cbd(URIRef(self.ex + "R8"))
+        # R8 triple + _:c1 triple + _:c2 triple; each once
+        self.assertEqual(len(cbd), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        cbd = self.graph.cbd(URIRef(self.ex + "R1"))
+        self.assertIsNot(cbd, self.graph)
+        self.assertIsInstance(cbd, Graph)
+        self.assertEqual(len(self.graph), before)
