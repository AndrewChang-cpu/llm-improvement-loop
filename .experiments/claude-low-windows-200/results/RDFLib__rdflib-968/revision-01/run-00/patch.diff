diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..65e5fae 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,56 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission at https://www.w3.org/Submission/CBD/ and is applied
+        here as follows:
+
+        1. Include every triple whose subject is the resource. Each object
+           that is a blank node is expanded in the same way (rule 1), unless
+           the result already contains a triple whose subject is that blank
+           node, which keeps cycles finite.
+        2. Include every statement whose ``rdf:subject`` is the resource
+           (reification, rule 3). All triples of each such statement are
+           included, regardless of whether it has an ``rdf:Statement`` type
+           or whether its ``rdf:predicate`` or ``rdf:object`` values match
+           any triple in the graph. Blank nodes that are objects of the
+           reifier triples are not expanded, and the ``rdf:object`` and
+           ``rdf:predicate`` values of a reifier are not followed.
+
+        Reification (rule 2) is applied to every node processed, including
+        blank nodes expanded by rule 1.
+
+        The result is a subgraph of this graph: it contains only triples
+        that exist here, and this graph is not modified. The result is a
+        new Graph without this graph's namespace bindings; it is empty if
+        the resource has no matching triples.
+
+        :param resource: the resource (subject node) to describe
+        :return: a new Graph containing the Concise Bounded Description
+        """
+        def add_to_cbd(node, result):
+            # Rule 1: triples with the node as subject.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and \
+                        not any(True for _ in result.triples((o, None, None))):
+                    add_to_cbd(o, result)
+
+            # Rule 3: reification via rdf:subject.
+            reifiers = set(s for s, _, _ in
+                           self.triples((None, RDF.subject, node)))
+            for reifier in reifiers:
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        retval = Graph()
+        add_to_cbd(resource, retval)
+        return retval
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..8620eb4
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,142 @@
+import unittest
+
+from rdflib import Graph, Namespace, RDF, BNode, Literal
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix example: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: blank-node resource (6 triples reachable from R1)
+example:R1 example:p1 example:O1 ;
+    example:p2 example:O2 ;
+    example:p3 [ example:q1 "x" ;
+                 example:q2 [ example:r "y" ] ] .
+
+# Rules 1 and 2: resource with two property triples
+example:R2 example:a "1" ;
+    example:b "2" .
+
+# Reified case A: R5 with a typed reifier (5 triples)
+example:R5 example:p1 example:O1 ;
+    example:p2 "a" ;
+    example:p3 "b" .
+example:S5 rdf:type rdf:Statement ;
+    rdf:subject example:R5 ;
+    rdf:predicate example:p1 ;
+    rdf:object example:O1 ;
+    example:note "n5" .
+
+# Reified case B: R6 with a typed and an untyped reifier (5 + 5 triples)
+example:R6 example:p1 example:O1 ;
+    example:p2 "a" ;
+    example:p3 "b" .
+example:S6a rdf:type rdf:Statement ;
+    rdf:subject example:R6 ;
+    rdf:predicate example:p1 ;
+    rdf:object example:O1 ;
+    example:note "n6a" .
+example:S6b rdf:subject example:R6 ;
+    rdf:predicate example:p2 ;
+    rdf:object "a" ;
+    example:note "n6b" ;
+    example:extra "e6b" .
+
+# Incoming reification: statement (A p B) reified by S
+example:A example:p example:B .
+example:S7 rdf:subject example:A ;
+    rdf:predicate example:p ;
+    rdf:object example:B ;
+    example:note "n7" .
+
+# Blank node in a reifier is not expanded unless reached by rules 1 or 2
+example:R8 example:p "z" .
+example:S8 rdf:subject example:R8 ;
+    rdf:predicate example:p ;
+    rdf:object [ example:val "v" ] .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("example", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        cbd = self.graph.cbd(EX.R1)
+        # 3 direct triples + 2 for the blank node + 1 for its nested blank node
+        self.assertEqual(len(cbd), 6)
+
+        cbd = self.graph.cbd(EX.R2)
+        self.assertEqual(len(cbd), 2)
+
+        cbd = self.graph.cbd(EX.NoSuchResource)
+        self.assertEqual(len(cbd), 0)
+        self.assertIsInstance(cbd, Graph)
+
+    def testCbdBlankNodeObjectsExpanded(self):
+        bnode = self.graph.value(EX.R1, EX.p3)
+        self.assertIsInstance(bnode, BNode)
+        cbd = self.graph.cbd(EX.R1)
+        self.assertIn((bnode, EX.q1, Literal("x")), cbd)
+        nested = cbd.value(bnode, EX.q2)
+        self.assertIsInstance(nested, BNode)
+        self.assertIn((nested, EX.r, Literal("y")), cbd)
+
+    def testCbdReified(self):
+        # Case A: 3 direct triples + 5 triples of the typed reifier
+        cbd = self.graph.cbd(EX.R5)
+        self.assertEqual(len(cbd), 8)
+        self.assertIn((EX.S5, EX.note, Literal("n5")), cbd)
+
+    def testCbdReifiedUntypedIncluded(self):
+        # Case B: 3 direct + 5 typed reifier + 5 untyped reifier
+        cbd = self.graph.cbd(EX.R6)
+        self.assertEqual(len(cbd), 13)
+        self.assertIn((EX.S6b, EX.note, Literal("n6b")), cbd)
+        self.assertIn((EX.S6b, EX.extra, Literal("e6b")), cbd)
+
+    def testCbdIncomingReificationExcluded(self):
+        # B has no subject triples and is only the object of (A p B)
+        cbd_b = self.graph.cbd(EX.B)
+        self.assertEqual(len(cbd_b), 0)
+
+        # A is the rdf:subject of the reifier S7, so S7's triples are included
+        cbd_a = self.graph.cbd(EX.A)
+        self.assertIn((EX.A, EX.p, EX.B), cbd_a)
+        self.assertIn((EX.S7, EX.note, Literal("n7")), cbd_a)
+        self.assertEqual(len(cbd_a), 5)
+
+    def testCbdBlankNodeInReificationNotExpanded(self):
+        cbd = self.graph.cbd(EX.R8)
+        # 1 direct triple + 3 triples of the reifier S8
+        self.assertEqual(len(cbd), 4)
+        bnode = self.graph.value(EX.S8, RDF.object)
+        self.assertIsInstance(bnode, BNode)
+        self.assertIn((EX.S8, RDF.object, bnode), cbd)
+        self.assertNotIn((bnode, EX.val, Literal("v")), cbd)
+
+    def testCbdCycleTerminates(self):
+        g = Graph()
+        g.parse(data="""
+            @prefix example: <http://example.org/> .
+            example:R10 example:p _:c1 .
+            _:c1 example:next _:c2 .
+            _:c2 example:next _:c1 ;
+                 example:name "n" .
+            """, format="turtle")
+        cbd = g.cbd(EX.R10)
+        self.assertEqual(len(cbd), 4)
+        g.close()
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        cbd = self.graph.cbd(EX.R5)
+        self.assertIsNot(cbd, self.graph)
+        self.assertEqual(set(self.graph), before)
