diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..57a5708 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,52 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description (CBD) of a resource
+        as a new Graph, following the rules of the W3C Member Submission
+        "CBD - Concise Bounded Description"
+        (https://www.w3.org/Submission/CBD/):
+
+        1. All triples whose subject is the resource are included.
+        2. For every blank node object of an included triple, the same
+           rules are applied recursively, so that the blank node's
+           description is included. Blank nodes that were already
+           expanded are not expanded again, so cycles terminate.
+        3. Reification: every statement whose rdf:subject is the node
+           (or blank node) being described is included, together with
+           all of its triples. No rdf:Statement type check is made and
+           the rdf:predicate and rdf:object values are not matched
+           against the graph. Blank nodes that are objects of these
+           reification triples are not followed.
+
+        The result is a subgraph of this graph; this graph is not
+        modified.
+
+        :param resource: the resource (node) to describe.
+        :return: a new Graph containing the Concise Bounded Description
+            of the resource.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1 and 2: subject triples, recursing into blank nodes
+            # that have not been expanded yet.
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                obj = triple[2]
+                if type(obj) is BNode and \
+                        not any(result.triples((obj, None, None))):
+                    add_to_cbd(obj)
+            # Rule 3: reification, for every statement whose rdf:subject
+            # is this node.
+            for reifier in self.subjects(RDF.subject, node):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..13d620f
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,121 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph().parse(data="""
+            @prefix ex: <http://example.org/> .
+            @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+            # R1: three direct triples, one pointing to a blank node
+            # chain of depth two.
+            ex:R1 ex:p1 ex:A ;
+                  ex:p2 ex:B ;
+                  ex:p3 _:b1 .
+            _:b1 ex:q _:b2 .
+            _:b2 ex:r "v" .
+
+            # R2: two property triples.
+            ex:R2 ex:p1 ex:A ;
+                  ex:p2 "x" .
+
+            # R3: a blank-node cycle.
+            ex:R3 ex:p _:c1 .
+            _:c1 ex:next _:c2 .
+            _:c2 ex:next _:c1 .
+
+            # R5: a typed reifier of R5's statement.
+            ex:R5 ex:p1 ex:A ;
+                  ex:p2 ex:B ;
+                  ex:p3 "x" .
+            ex:S5 rdf:type rdf:Statement ;
+                  rdf:subject ex:R5 ;
+                  rdf:predicate ex:p1 ;
+                  rdf:object ex:A ;
+                  ex:note "n" .
+
+            # R6: a typed and an untyped reifier of R6's statements.
+            ex:R6 ex:p1 ex:A ;
+                  ex:p2 ex:B ;
+                  ex:p3 "x" .
+            ex:S6a rdf:type rdf:Statement ;
+                   rdf:subject ex:R6 ;
+                   rdf:predicate ex:p1 ;
+                   rdf:object ex:A ;
+                   ex:note "a" .
+            ex:S6b rdf:subject ex:R6 ;
+                   rdf:predicate ex:p2 ;
+                   rdf:object ex:B ;
+                   ex:note "b" ;
+                   ex:source "c" .
+
+            # Incoming reification: S7 reifies A1 p B1.
+            ex:A1 ex:p ex:B1 .
+            ex:S7 rdf:subject ex:A1 ;
+                  rdf:predicate ex:p ;
+                  rdf:object ex:B1 ;
+                  ex:note "r" .
+
+            # R8: reifier whose rdf:object and other values are blank nodes.
+            ex:R8 ex:p1 ex:A8 .
+            ex:S8 rdf:subject ex:R8 ;
+                  rdf:predicate ex:p1 ;
+                  rdf:object _:bo ;
+                  ex:note _:bn .
+            _:bo ex:v "w" .
+            _:bn ex:v "z" .
+            """, format="turtle")
+        self.graph.bind("ex", self.ex)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(self.ex.R1)
+        self.assertEqual(len(result), 5)
+        self.assertIn((self.ex.R1, self.ex.p1, self.ex.A), result)
+
+    def testCbdTwoProperties(self):
+        result = self.graph.cbd(self.ex.R2)
+        self.assertEqual(len(result), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(self.ex.Missing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(self.ex.R3)
+        self.assertEqual(len(result), 3)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(self.ex.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        result = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((self.ex.S6b, self.ex.note, None), result)
+
+    def testCbdIncomingReificationExcluded(self):
+        self.assertEqual(len(self.graph.cbd(self.ex.B1)), 0)
+        self.assertEqual(len(self.graph.cbd(self.ex.A1)), 5)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(self.ex.R8)
+        self.assertEqual(len(result), 5)
+        self.assertNotIn((None, self.ex.v, None), result)
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(self.ex.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
