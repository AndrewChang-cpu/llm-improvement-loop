diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..1cc125d 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,44 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a resource.
+
+        Implements the three rules of the W3C Member Submission on Concise
+        Bounded Description (https://www.w3.org/Submission/CBD/):
+
+        1. Include every triple whose subject is the resource.
+        2. For every object of such a triple that is a blank node not yet
+           described in the result, apply the same rules to that blank node
+           (recursively, so cycles terminate).
+        3. Reification: include every statement whose rdf:subject is the
+           resource. Every statement with that rdf:subject is included, with
+           no rdf:Statement type check and no matching of its rdf:predicate
+           or rdf:object values. The rdf:object and rdf:predicate values of
+           such a reifier are not followed, and blank nodes that are objects
+           of the triples added by this rule are not described.
+
+        The result is a subgraph of this graph, returned as a new Graph.
+        This graph is not modified. Namespace bindings are not copied.
+
+        :param resource: The resource whose description is retrieved.
+        :return: A new Graph containing the Concise Bounded Description.
+        """
+
+        def add_to_cbd(node, cbd_graph):
+            for s, p, o in self.triples((node, None, None)):
+                cbd_graph.add((s, p, o))
+                if type(o) is BNode and next(
+                        cbd_graph.triples((o, None, None)), None) is None:
+                    add_to_cbd(o, cbd_graph)
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    cbd_graph.add(triple)
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..19f27e6
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,126 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph()
+        self.graph.bind("ex", self.ex)
+        self.graph.parse(data="""
+            @prefix ex: <http://example.org/> .
+            @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+            # Blank-node resource: 3 direct triples, one blank node with a
+            # nested blank node. CBD has 6 triples.
+            ex:R1 ex:p1 ex:O1 ;
+                  ex:p2 ex:O2 ;
+                  ex:p3 [ ex:q1 "a" ; ex:q2 [ ex:r1 "b" ] ] .
+
+            # Type triple and two relation triples: 3 triples.
+            ex:R2 a ex:Type ;
+                  ex:p1 ex:O1 ;
+                  ex:p2 ex:O2 .
+
+            # Two property triples: 2 triples.
+            ex:R3 ex:p1 "x" ;
+                  ex:p2 "y" .
+
+            # Reified case A: 3 direct triples + typed reifier (5 triples).
+            ex:R5 ex:p1 ex:O1 ;
+                  ex:p2 ex:O2 ;
+                  ex:p3 ex:O3 .
+            ex:S5 a rdf:Statement ;
+                  rdf:subject ex:R5 ;
+                  rdf:predicate ex:p1 ;
+                  rdf:object ex:O1 ;
+                  ex:note "n5" .
+
+            # Reified case B: 3 direct triples + typed reifier (5 triples)
+            # + untyped reifier (5 triples).
+            ex:R6 ex:p1 ex:O1 ;
+                  ex:p2 ex:O2 ;
+                  ex:p3 ex:O3 .
+            ex:S6a a rdf:Statement ;
+                   rdf:subject ex:R6 ;
+                   rdf:predicate ex:p1 ;
+                   rdf:object ex:O1 ;
+                   ex:note "a" .
+            ex:S6b rdf:subject ex:R6 ;
+                   rdf:predicate ex:p2 ;
+                   rdf:object ex:O2 ;
+                   ex:note "b" ;
+                   ex:conf "0.5" .
+
+            # Incoming reification: A p B, reified with subject A, object B.
+            ex:A ex:p ex:B .
+            ex:S7 rdf:subject ex:A ;
+                  rdf:predicate ex:p ;
+                  rdf:object ex:B ;
+                  ex:note "i" .
+
+            # Reifier whose object is a blank node with properties.
+            ex:R8 ex:p1 ex:O1 .
+            ex:S8 rdf:subject ex:R8 ;
+                  rdf:object [ ex:hidden "h" ] ;
+                  ex:note "x" .
+
+            # Blank-node cycle.
+            ex:R9 ex:has _:c1 .
+            _:c1 ex:next _:c2 .
+            _:c2 ex:next _:c1 .
+            """, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        ex = self.ex
+        self.assertEqual(len(self.graph.cbd(ex.R1)), 6)
+        self.assertEqual(len(self.graph.cbd(ex.R2)), 3)
+        self.assertEqual(len(self.graph.cbd(ex.R3)), 2)
+        self.assertEqual(len(self.graph.cbd(ex.Missing)), 0)
+
+    def testCbdReified(self):
+        ex = self.ex
+        # 3 direct triples + 5 triples of the typed reifier.
+        self.assertEqual(len(self.graph.cbd(ex.R5)), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        ex = self.ex
+        # 3 direct triples + 5 typed + 5 untyped reifier triples.
+        self.assertEqual(len(self.graph.cbd(ex.R6)), 13)
+
+    def testCbdIncomingReificationExcluded(self):
+        ex = self.ex
+        self.assertEqual(len(self.graph.cbd(ex.B)), 0)
+        # 1 statement (A p B) + 4 triples of the reifier with subject A.
+        self.assertEqual(len(self.graph.cbd(ex.A)), 5)
+
+    def testCbdReifierBlankNodeObjectNotExpanded(self):
+        ex = self.ex
+        result = self.graph.cbd(ex.R8)
+        # 1 direct triple + 3 triples of the reifier; the blank node's
+        # "hidden" triple is not included.
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(list(result.triples((None, ex.hidden, None)))),
+                         0)
+
+    def testCbdBlankNodeCycle(self):
+        ex = self.ex
+        result = self.graph.cbd(ex.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        ex = self.ex
+        before = set(self.graph)
+        result = self.graph.cbd(ex.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
