diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..7121f4f 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,49 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description (CBD) of a resource.
+
+        Implements the rules of the W3C Member Submission "Concise Bounded
+        Description" (https://www.w3.org/Submission/CBD/):
+
+        1. Every triple whose subject is the resource is included.
+        2. For every blank node object reached this way, the same rules are
+           applied to that blank node, so that its triples are included
+           too. Each blank node is expanded only once, so cycles terminate.
+        3. Reification: every statement S that has an rdf:subject triple
+           whose object is the resource (or a blank node being described)
+           is included, with all of its triples, regardless of whether S
+           has an rdf:Statement type or whether its rdf:predicate and
+           rdf:object values match any triple in the graph. Reifiers are
+           not expanded further: their rdf:object and rdf:predicate values
+           are not followed.
+
+        The result is a new Graph that is a subgraph of this graph; this
+        graph is not modified. If the resource has no matching triples, an
+        empty Graph is returned. Namespace bindings are not copied.
+
+        :param resource: the resource (node) whose description is requested
+        :return: a new Graph containing the concise bounded description
+        """
+
+        def add_to_cbd(node, cbd):
+            # Rules 1 and 2: triples with the node as subject.
+            for triple in list(self.triples((node, None, None))):
+                cbd.add(triple)
+                obj = triple[2]
+                if type(obj) is BNode and not any(
+                        cbd.triples((obj, None, None))):
+                    add_to_cbd(obj, cbd)
+            # Rule 3: reifiers of the node contribute all their triples.
+            for reifier in list(self.subjects(RDF.subject, node)):
+                for triple in list(self.triples((reifier, None, None))):
+                    cbd.add(triple)
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..03e02b4
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,110 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.g = Graph().parse(data="""
+            @prefix ex: <http://example.org/> .
+            @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+            ex:R1 ex:p1 ex:U1 ; ex:p2 ex:U2 ; ex:p3 _:b1 .
+            _:b1 ex:q1 "x" ; ex:q2 _:b2 ; ex:q3 "z" .
+            _:b2 ex:r1 "y" ; ex:r2 "w" .
+
+            ex:R2 rdf:type ex:Thing ; ex:knows ex:A ; ex:likes ex:B .
+            ex:Other ex:knows ex:R2 .
+
+            ex:R3 ex:name "n" ; ex:age 3 .
+
+            ex:R5 ex:p1 ex:U1 ; ex:p2 ex:U2 ; ex:p3 "lit" .
+            ex:S5 rdf:type rdf:Statement ; rdf:subject ex:R5 ;
+                rdf:predicate ex:p1 ; rdf:object ex:U1 ; ex:certainty "0.9" .
+
+            ex:R6 ex:p1 ex:U1 ; ex:p2 ex:U2 ; ex:p3 "lit" .
+            ex:S6a rdf:type rdf:Statement ; rdf:subject ex:R6 ;
+                rdf:predicate ex:p1 ; rdf:object ex:U1 ; ex:certainty "0.9" .
+            ex:S6b rdf:subject ex:R6 ; rdf:predicate ex:p2 ; rdf:object ex:U2 ;
+                ex:source "a" ; ex:note "b" .
+
+            ex:A ex:likes ex:B .
+            ex:S7 rdf:subject ex:A ; rdf:predicate ex:likes ; rdf:object ex:B ;
+                ex:note "c" .
+
+            ex:R8 ex:p ex:U1 .
+            ex:S8 rdf:subject ex:R8 ; rdf:predicate ex:p ; rdf:object _:bn ;
+                ex:note "d" .
+            _:bn ex:x "1" .
+
+            ex:R9 ex:link _:c1 .
+            _:c1 ex:next _:c2 .
+            _:c2 ex:next _:c1 ; ex:name "n" .
+            """, format="turtle")
+        self.g.bind("ex", self.ex)
+
+    def tearDown(self):
+        self.g.close()
+
+    def testCbd(self):
+        result = self.g.cbd(self.ex.R1)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 8)
+
+    def testCbdTypeAndRelations(self):
+        result = self.g.cbd(self.ex.R2)
+        self.assertEqual(len(result), 3)
+
+    def testCbdTwoProperties(self):
+        result = self.g.cbd(self.ex.R3)
+        self.assertEqual(len(result), 2)
+
+    def testCbdNoTriples(self):
+        result = self.g.cbd(self.ex.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        result = self.g.cbd(self.ex.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        # Typed reifier S6a (5 triples) and untyped reifier S6b (5 triples)
+        # plus the 3 direct triples of R6.
+        result = self.g.cbd(self.ex.R6)
+        self.assertEqual(len(result), 13)
+        self.assertEqual(
+            len(list(result.triples((self.ex.S6b, None, None)))), 5)
+
+    def testCbdIncomingReificationExcluded(self):
+        # S7 reifies (A likes B); it belongs to A's description only.
+        self.assertEqual(len(self.g.cbd(self.ex.B)), 0)
+        result = self.g.cbd(self.ex.A)
+        self.assertEqual(len(result), 5)
+        self.assertEqual(
+            len(list(result.triples((self.ex.S7, None, None)))), 4)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.g.cbd(self.ex.R8)
+        self.assertEqual(len(result), 5)
+        self.assertEqual(
+            len(list(result.triples((None, self.ex.x, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.g.cbd(self.ex.R9)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(set(result)), len(result))
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.g)
+        result = self.g.cbd(self.ex.R1)
+        self.assertIsNot(result, self.g)
+        self.assertEqual(len(self.g), before)
+        for triple in result:
+            self.assertIn(triple, self.g)
+
+
+if __name__ == "__main__":
+    unittest.main()
