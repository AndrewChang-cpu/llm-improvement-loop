diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..52ba190 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieve the Concise Bounded Description of a resource.
+
+        The Concise Bounded Description (CBD) is computed following the
+        three rules of the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. For the resource, include every triple whose subject is the
+           resource. For each object that is a blank node which is not
+           already the subject of a triple in the result, apply the same
+           rules to that blank node, recursively.
+        2. Reification: for every node processed, include every
+           statement whose ``rdf:subject`` is that node, together with
+           all triples whose subject is that statement. No ``rdf:Statement``
+           type check and no matching of ``rdf:predicate`` or
+           ``rdf:object`` is performed, so untyped reifiers are included.
+        3. Blank nodes that are objects of triples added by rule 2 are
+           not followed, and ``rdf:object`` / ``rdf:predicate`` values of a
+           reifier are not followed.
+
+        The result is a new Graph that is a subgraph of this graph; this
+        graph is not modified. Namespace bindings are not copied.
+
+        :param resource: the resource (node) whose description is requested.
+        :return: a new Graph containing the concise bounded description of
+                 ``resource``; empty if there is no matching data.
+        """
+
+        def add_to_cbd(node, result):
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                obj = triple[2]
+                if type(obj) is BNode:
+                    expanded = any(True for _ in
+                                   result.triples((obj, None, None)))
+                    if not expanded:
+                        add_to_cbd(obj, result)
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        graph = Graph()
+        add_to_cbd(resource, graph)
+        return graph
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..4e6cc62
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,120 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Resource with a blank node chain: 3 + 2 + 1 = 6 triples
+ex:R1 ex:p1 "a" ; ex:p2 ex:X ; ex:p3 [ ex:q "x" ; ex:r [ ex:s "y" ] ] .
+
+# Resource with a type triple and two relation triples: 3 triples
+ex:A rdf:type ex:Thing ; ex:rel ex:B ; ex:rel ex:C .
+ex:B ex:other "not included" .
+
+# Resource with two property triples: 2 triples
+ex:D ex:p "1" ; ex:p2 "2" .
+
+# Reified resource A (typed reifier): 3 + 5 = 8 triples
+ex:R5 ex:a "1" ; ex:b "2" ; ex:c "3" .
+ex:S5 rdf:type rdf:Statement ;
+    rdf:subject ex:R5 ;
+    rdf:predicate ex:a ;
+    rdf:object "1" ;
+    ex:note "n5" .
+
+# Reified resource B (typed and untyped reifiers): 3 + 5 + 5 = 13 triples
+ex:R6 ex:a "1" ; ex:b "2" ; ex:c "3" .
+ex:S6a rdf:type rdf:Statement ;
+    rdf:subject ex:R6 ;
+    rdf:predicate ex:a ;
+    rdf:object "1" ;
+    ex:note "typed" .
+ex:S6b rdf:subject ex:R6 ;
+    rdf:predicate ex:b ;
+    rdf:object "2" ;
+    ex:note "untyped" ;
+    ex:extra "more" .
+
+# Incoming reification: A2 p B2 is reified by S7
+ex:A2 ex:p ex:B2 .
+ex:S7 rdf:subject ex:A2 ;
+    rdf:predicate ex:p ;
+    rdf:object ex:B2 ;
+    ex:note "x" .
+
+# Reifier whose rdf:object is a blank node: 1 + 3 = 4 triples
+ex:R8 ex:p "v" .
+ex:S8 rdf:subject ex:R8 ;
+    rdf:object _:hiddenBnode ;
+    ex:note "n" .
+_:hiddenBnode ex:hidden "h" .
+
+# Blank node cycle: 3 triples
+ex:R9 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("ex", EX)
+        self.graph.parse(data=FIXTURE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(result), 6)
+
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 3)
+
+        result = self.graph.cbd(EX.D)
+        self.assertEqual(len(result), 2)
+
+        result = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S6b, EX.note, None), result)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.B2)), 0)
+        result = self.graph.cbd(EX.A2)
+        self.assertEqual(len(result), 5)
+        self.assertIn((EX.S7, EX.note, None), result)
+
+    def testCbdBlankNodeInReificationNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(list(result.triples((None, EX.hidden, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        before_len = len(self.graph)
+        result = self.graph.cbd(EX.R6)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before_len)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
