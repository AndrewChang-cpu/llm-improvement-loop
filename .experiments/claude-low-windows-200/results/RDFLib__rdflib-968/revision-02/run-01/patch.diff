diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..f478f0d 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) and consists of:
+
+        1. All triples in which the subject is the resource.
+        2. Recursively, for each blank node that is an object of a triple
+           in the description and that is not already expanded, the
+           triples in which that blank node is the subject.
+        3. Reification: every reifier S of the resource (a node S that has
+           an rdf:subject triple whose object is the resource) contributes
+           all triples whose subject is S. No check is made for an
+           rdf:Statement type, nor for matching rdf:predicate or rdf:object
+           values. Blank nodes reached through a reifier are not expanded
+           by this rule.
+
+        The result is a subgraph of this Graph and is a new Graph
+        instance; this Graph is not modified. Namespace bindings are not
+        copied. If the resource has no subject triples and no reifiers,
+        the result is an empty Graph.
+
+        This method does not implement SPARQL DESCRIBE.
+
+        :param resource: the resource (node) whose description is wanted
+        :return: a new Graph containing the Concise Bounded Description
+        """
+        cbd_graph = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples with the node as subject; expand blank node
+            # objects that are not yet described in the result.
+            for s, p, o in self.triples((node, None, None)):
+                cbd_graph.add((s, p, o))
+                if isinstance(o, BNode) and not any(
+                        True for _ in cbd_graph.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3: reifiers of the node contribute all their triples.
+            for reifier in list(self.subjects(RDF.subject, node)):
+                for t in self.triples((reifier, None, None)):
+                    cbd_graph.add(t)
+
+        add_to_cbd(resource)
+        return cbd_graph
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..fe62a72
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,123 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+RDF = Namespace("http://www.w3.org/1999/02/22-rdf-syntax-ns#")
+
+DATA = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Three direct triples, two URI objects, one blank node object with a
+# nested blank node. Expected CBD: 6 triples.
+ex:R3 ex:p1 ex:R1 ;
+      ex:p2 ex:R2 ;
+      ex:p3 [ ex:q "x" ; ex:r [ ex:s "y" ] ] .
+
+# Two property triples. Expected CBD: 2 triples.
+ex:R2 ex:name "two" ;
+      ex:label "Two" .
+
+# Typed reifier of R5 (5 triples). Expected CBD: 3 + 5 = 8 triples.
+ex:R5 ex:name "five" ;
+      ex:knows ex:R1 ;
+      ex:likes ex:R2 .
+ex:st5 a rdf:Statement ;
+       rdf:subject ex:R5 ;
+       rdf:predicate ex:name ;
+       rdf:object "five" ;
+       ex:note "n" .
+
+# Typed reifier and untyped reifier of R6. Expected CBD: 3 + 5 + 5 = 13.
+ex:R6 ex:a "a" ;
+      ex:b ex:R1 ;
+      ex:c ex:R2 .
+ex:st6 a rdf:Statement ;
+       rdf:subject ex:R6 ;
+       rdf:predicate ex:a ;
+       rdf:object "a" ;
+       ex:note "x" .
+ex:st6b rdf:subject ex:R6 ;
+        rdf:predicate ex:b ;
+        rdf:object ex:R1 ;
+        ex:note "y" ;
+        ex:note2 "z" .
+
+# Incoming reification: statement (A p B) with reifier st7 whose subject
+# is A and whose object is B. Expected CBD of A: 1 + 4 = 5. CBD of B: 0.
+ex:A ex:p ex:B .
+ex:st7 rdf:subject ex:A ;
+       rdf:predicate ex:p ;
+       rdf:object ex:B ;
+       ex:note "w" .
+
+# Reifier of R8 whose object is a blank node. The blank node's triples
+# must not be added. Expected CBD of R8: 3 triples.
+ex:R8 ex:val "v" .
+ex:st8 rdf:subject ex:R8 ;
+       ex:obj [ ex:z "deep" ] .
+
+# Blank node cycle. Expected CBD of R9: 3 triples.
+ex:R9 ex:link _:x .
+_:x ex:next _:y .
+_:y ex:next _:x .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=DATA, format='turtle')
+        self.graph.bind('ex', EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(EX.R3)
+        self.assertEqual(len(result), 6)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 2)
+
+    def testCbdEmpty(self):
+        result = self.graph.cbd(EX.NoSuchResource)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+        self.assertIn((EX.st5, RDF.subject, EX.R5), result)
+        self.assertIn((EX.st5, RDF.type, RDF.Statement), result)
+
+    def testCbdUntypedReifier(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.st6b, RDF.subject, EX.R6), result)
+        self.assertIn((EX.st6b, EX.note2, None), result)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 5)
+        self.assertIn((EX.st7, RDF.subject, EX.A), result)
+
+    def testCbdBlankNodeInReification(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, EX.z, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdImmutable(self):
+        before = len(self.graph)
+        result = self.graph.cbd(EX.R5)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before)
+
+
+if __name__ == '__main__':
+    unittest.main()
