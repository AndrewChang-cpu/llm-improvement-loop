diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..3d119e9 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,50 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission at https://www.w3.org/Submission/CBD/ and is applied here
+        as follows, starting from the given resource:
+
+        1. Every triple whose subject is the resource is included. Each
+           object that is a blank node which is not yet the subject of any
+           triple in the result is described in the same way, recursively.
+        2. Every statement whose ``rdf:subject`` is the resource (a reifier)
+           contributes all triples whose subject is that statement. No
+           ``rdf:Statement`` type check and no matching of ``rdf:predicate``
+           or ``rdf:object`` values is performed, so untyped reifiers are
+           included.
+        3. The rdf:object and rdf:predicate values of reifiers are not
+           followed, and blank nodes reached only as objects of the triples
+           added by rule 2 are not described.
+
+        The result is a new Graph containing a subgraph of this Graph; this
+        Graph is not modified. Namespace bindings are not copied.
+
+        :param resource: the resource (node) to describe. It is used as given
+            in the triple-pattern queries.
+        :return: a new Graph with the triples of the Concise Bounded
+            Description of resource; empty if there is no matching data.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: all triples about node; expand unseen blank node objects
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and not any(
+                        result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 2: every reifier of node contributes all of its triples
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..f5b7258
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,111 @@
+import sys
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+RDF = Namespace("http://www.w3.org/1999/02/22-rdf-syntax-ns#")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Three direct triples, two URI objects, one blank node with a nested blank node
+ex:R1 ex:name "one" ; ex:knows ex:R2 ; ex:link _:b1 .
+ex:R2 ex:name "two" .
+_:b1 ex:p "blank" ; ex:q _:b2 .
+_:b2 ex:r "nested" .
+
+# Two property triples
+ex:R3 ex:a "1" ; ex:b "2" .
+
+# Type triple and two relation triples
+ex:R4 rdf:type ex:Thing ; ex:rel ex:R2 ; ex:rel2 ex:R3 .
+
+# Reified case A: typed reifier of R5
+ex:R5 ex:a "1" ; ex:b "2" ; ex:c "3" .
+_:s5 rdf:type rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:a ;
+     rdf:object "1" ; ex:note "x" .
+
+# Reified case B: typed reifier and untyped reifier of R6
+ex:R6 ex:a "1" ; ex:b "2" ; ex:c "3" .
+_:s6a rdf:type rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:a ;
+      rdf:object "1" ; ex:note "x" .
+_:s6b rdf:subject ex:R6 ; rdf:predicate ex:b ; rdf:object "2" ;
+      ex:note "y" ; ex:note2 "z" .
+
+# Incoming reification: statement (A p B) reified by _:s7
+ex:A ex:p ex:B .
+_:s7 rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:B ; ex:note "n" .
+
+# Reifier whose rdf:object is a blank node that must not be expanded
+ex:R8 ex:a "x" .
+_:s8 rdf:subject ex:R8 ; rdf:predicate ex:a ; rdf:object _:bn8 .
+_:bn8 ex:v "hidden" .
+
+# Blank node cycle: _:x -> _:y -> _:x
+ex:C ex:link _:x .
+_:x ex:next _:y ; ex:name "x" .
+_:y ex:next _:x .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # Rule 1 with blank node expansion: 3 direct + 2 (_:b1) + 1 (_:b2)
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(result), 6)
+        # Two property triples
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+        # Type triple and two relation triples
+        self.assertEqual(len(self.graph.cbd(EX.R4)), 3)
+        # Resource with no triples
+        empty = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(empty, Graph)
+        self.assertEqual(len(empty), 0)
+
+    def testCbdReified(self):
+        # Case A: 3 direct + 5 triples of the typed reifier
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        # Case B: 3 direct + 5 typed reifier + 5 untyped reifier
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+
+    def testCbdIncomingReificationExcluded(self):
+        # cbd of A includes the reifier of (A p B)
+        self.assertEqual(len(self.graph.cbd(EX.A)), 5)
+        # cbd of B does not include the reifier whose rdf:object is B
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+
+    def testCbdBlankNodeInReificationNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        # 1 direct triple + 3 triples of the reifier
+        self.assertEqual(len(result), 4)
+        bn = next(self.graph.subjects(EX.v, None))
+        self.assertEqual(len(list(result.triples((bn, None, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.C)
+        # C link x; x next y; x name "x"; y next x
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(set(result)), len(result))
+
+    def testCbdSourceGraphUnchanged(self):
+        before = set(self.graph)
+        count = len(self.graph)
+        result = self.graph.cbd(EX.R6)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), count)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == '__main__':
+    unittest.main(argv=sys.argv[:1])
