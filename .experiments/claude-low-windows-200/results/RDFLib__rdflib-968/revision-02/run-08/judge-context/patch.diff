diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..17db753 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,52 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Return the Concise Bounded Description of ``resource``
+
+        The Concise Bounded Description (CBD) is computed by the rules of the
+        W3C Member Submission (https://www.w3.org/Submission/CBD/):
+
+        Rule 1: every triple whose subject is the resource is included. Each
+        object that is a blank node, and is not yet described in the result,
+        is described by the same rules, recursively, so cycles terminate.
+
+        Rule 2: every blank node reached by rule 1 is described in the same
+        way.
+
+        Rule 3 (reification): every statement whose ``rdf:subject`` is the
+        node being described is included, together with all of its triples.
+        Every such statement is included: there is no ``rdf:Statement`` type
+        check and no matching of its ``rdf:predicate`` or ``rdf:object``
+        values. Blank nodes that are objects of the triples included by this
+        rule are not described, and the ``rdf:object`` and ``rdf:predicate``
+        values of those statements are not followed.
+
+        The result is a new Graph that is a subgraph of this graph; this
+        graph is not modified. Namespace bindings are not copied.
+
+        :param resource: the resource (node) to describe
+        :return: a new Graph containing the Concise Bounded Description
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1 (and rule 2 for blank nodes): subject triples first, so
+            # the cycle guard sees the triples already added for this node.
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                obj = triple[2]
+                if type(obj) is BNode and not any(
+                        True for _ in result.triples((obj, None, None))):
+                    add_to_cbd(obj)
+            # Rule 3 (reification): every statement whose rdf:subject is node.
+            for reifier in self.subjects(RDF.subject, node):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..9e08e57
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,120 @@
+import unittest
+
+from rdflib import Graph
+from rdflib.namespace import Namespace
+
+EX = Namespace("http://example.org/")
+
+TURTLE = """
+@prefix example: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Blank-node resource: 3 direct triples + 2 (b1) + 1 (b2) = 6
+example:R1 example:p1 example:O1 ;
+    example:p2 example:O2 ;
+    example:p3 _:b1 .
+_:b1 example:q1 "x" ;
+    example:q2 _:b2 .
+_:b2 example:r1 "y" .
+
+# Type triple and two relation triples: 3
+example:R2 rdf:type example:Thing ;
+    example:rel1 example:X ;
+    example:rel2 example:Y .
+
+# Two property triples: 2
+example:R3 example:name "a" ;
+    example:label "b" .
+
+# Reified case A: 3 direct + typed reifier with 5 triples = 8
+example:R5 example:p1 example:O1 ;
+    example:p2 example:O2 ;
+    example:p3 example:O3 .
+example:st1 rdf:type rdf:Statement ;
+    rdf:subject example:R5 ;
+    rdf:predicate example:p1 ;
+    rdf:object example:O1 ;
+    example:note "n" .
+
+# Reified case B: 3 direct + typed reifier (5) + untyped reifier (5) = 13
+example:R6 example:p1 example:O1 ;
+    example:p2 example:O2 ;
+    example:p3 example:O3 .
+example:st2 rdf:type rdf:Statement ;
+    rdf:subject example:R6 ;
+    rdf:predicate example:p1 ;
+    rdf:object example:O1 ;
+    example:note "n2" .
+example:st3 rdf:subject example:R6 ;
+    rdf:predicate example:p2 ;
+    rdf:object example:O2 ;
+    example:note "n3" ;
+    example:extra "e3" .
+
+# Incoming reification: A p B, reifier has rdf:subject A and rdf:object B
+example:A example:p example:B .
+example:st4 rdf:subject example:A ;
+    rdf:predicate example:p ;
+    rdf:object example:B ;
+    example:note "n4" .
+
+# Reifier whose rdf:object is a blank node that must not be expanded
+example:R7 example:p example:O .
+example:st5 rdf:subject example:R7 ;
+    rdf:object _:b3 ;
+    example:note "n5" .
+_:b3 example:secret "s" .
+
+# Blank-node cycle: _:c1 -> _:c2 -> _:c1
+example:R8 example:p _:c1 .
+_:c1 example:q _:c2 .
+_:c2 example:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("example", EX)
+        self.graph.parse(data=TURTLE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 6)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.Nothing)), 0)
+
+    def testCbdReified(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+
+    def testCbdIncomingReificationExcluded(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 5)
+        self.assertEqual(len(list(result.triples((EX.st4, None, None)))), 4)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(EX.R7)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(
+            len(list(result.triples((None, EX.secret, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(self.graph), before)
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
