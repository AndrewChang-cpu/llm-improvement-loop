diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..3dcb63d 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,54 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the starting node.
+        2. For every blank node object reached by step 1 that is not
+           already the subject of a triple in the result, recursively
+           apply the same rules to that blank node.
+        3. Reification: for every node processed, include every statement
+           whose ``rdf:subject`` is that node, together with all triples
+           whose subject is that statement. This is implemented as
+           specified: every such statement is included, with no
+           ``rdf:Statement`` type check and no ``rdf:predicate`` or
+           ``rdf:object`` matching.
+
+        Blank nodes that are objects of triples added by rule 3 are not
+        expanded, and the ``rdf:predicate`` and ``rdf:object`` values of a
+        reifier are not followed.
+
+        The result is a new Graph containing only triples that exist in
+        this graph (it is a subgraph of the source); this graph is not
+        modified. If the resource has no matching triples, the result is
+        an empty Graph.
+
+        This method is not an implementation of SPARQL DESCRIBE.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the Concise Bounded Description
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1 (and blank-node recursion via rule 2)
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if type(o) == BNode and \
+                        not any(result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3 (reification): every statement whose rdf:subject is node
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..b7cc774
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,130 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: direct triples and nested blank nodes
+ex:R1 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 [ ex:q [ ex:r "x" ] ] .
+
+# Three direct triples: a type and two relations
+ex:R2 rdf:type ex:Thing ;
+      ex:likes ex:R3 ;
+      ex:knows ex:R4 .
+
+# Reified case A: one typed reifier of R5
+ex:R5 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 ex:C .
+_:s5 rdf:type rdf:Statement ;
+     rdf:subject ex:R5 ;
+     rdf:predicate ex:p1 ;
+     rdf:object ex:A ;
+     ex:note "n5" .
+
+# Reified case B: one typed reifier and one untyped reifier of R6
+ex:R6 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 ex:C .
+_:s6a rdf:type rdf:Statement ;
+      rdf:subject ex:R6 ;
+      rdf:predicate ex:p1 ;
+      rdf:object ex:A ;
+      ex:note "n6a" .
+_:s6b rdf:subject ex:R6 ;
+      rdf:predicate ex:p2 ;
+      rdf:object ex:B ;
+      ex:note "n6b" ;
+      ex:extra "e6b" .
+
+# Incoming reification: (A1 p1 B1) is reified; B1 must not get the reifier
+ex:A1 ex:p1 ex:B1 .
+_:s7 rdf:subject ex:A1 ;
+     rdf:predicate ex:p1 ;
+     rdf:object ex:B1 ;
+     ex:note "n7" .
+
+# Reifier with a blank-node object that is not reached by rules 1 or 2
+ex:R8 ex:p ex:C8 .
+_:s8 rdf:subject ex:R8 ;
+     rdf:object _:bx ;
+     ex:note "n8" .
+_:bx ex:inner "deep" .
+
+# Blank-node cycle
+ex:R9 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # 3 direct triples + 1 from the first blank node + 1 from the nested one
+        result = self.graph.cbd(EX.R1)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 5)
+
+    def testCbdTypeAndRelations(self):
+        result = self.graph.cbd(EX.R2)
+        self.assertEqual(len(result), 3)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(EX.NoSuchResource)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReifiedTyped(self):
+        # 3 direct triples + 5 triples of the typed reifier
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        # 3 direct + 5 typed reifier + 5 untyped reifier
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertTrue(any(result.triples((None, EX.extra, None))))
+
+    def testCbdIncomingReificationExcluded(self):
+        # The subject of the reified statement gets the reifier
+        self.assertEqual(len(self.graph.cbd(EX.A1)), 5)
+        # The object of the reified statement does not
+        self.assertEqual(len(self.graph.cbd(EX.B1)), 0)
+
+    def testCbdBlankNodeInReificationNotExpanded(self):
+        # 1 direct triple + 3 triples of the reifier; _:bx is not expanded
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 4)
+        self.assertFalse(any(result.triples((None, EX.inner, None))))
+
+    def testCbdBlankNodeCycleTerminates(self):
+        # R9 p c1, c1 q c2, c2 r c1: each triple appears once
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R6)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+        for triple in result:
+            self.assertIn(triple, self.graph)
+
+
+if __name__ == '__main__':
+    unittest.main()
