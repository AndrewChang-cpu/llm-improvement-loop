diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..d0b21c7 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description (CBD) of a resource
+        from this graph, following the rules of the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/):
+
+        1. Every triple whose subject is the resource is included. For
+           each object that is a blank node not already described in
+           the result, the same rules are applied recursively to it.
+        2. Reification: for every statement whose ``rdf:subject`` is
+           the node, all triples whose subject is that statement are
+           included. Every such statement is included, with no
+           ``rdf:Statement`` type check and no matching of its
+           ``rdf:predicate`` or ``rdf:object`` values.
+        3. Blank nodes that are objects of the triples added by rule 2
+           are not expanded, and the ``rdf:object`` and
+           ``rdf:predicate`` values of reifiers are not followed.
+
+        The result is a new Graph containing a subgraph of this graph;
+        this graph is not modified. Namespace bindings are not copied.
+
+        This method does not implement SPARQL DESCRIBE.
+
+        :param resource: the resource (node) to describe
+        :return: a new Graph holding the CBD of ``resource``
+        """
+        cbd = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: direct triples, expanding unseen blank nodes.
+            for s, p, o in self.triples((node, None, None)):
+                cbd.add((s, p, o))
+                if type(o) is BNode and not any(
+                        cbd.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 2: reifiers of the node contribute their triples.
+            for reifier in set(
+                    s for s, _, _ in
+                    self.triples((None, RDF.subject, node))):
+                for t in self.triples((reifier, None, None)):
+                    cbd.add(t)
+
+        add_to_cbd(resource)
+        return cbd
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..1048b0b
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,122 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data="""
+            @prefix ex: <http://example.org/> .
+            @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+            ex:R1 a ex:Thing ; ex:knows ex:R2 ; ex:name "one" .
+            ex:R2 ex:name "two" .
+
+            ex:R3 ex:p [ ex:q [ ex:r "z" ] ] .
+
+            ex:R5 ex:name "five" ; ex:size "5" ; ex:color "red" .
+            ex:S1 a rdf:Statement ;
+                rdf:subject ex:R5 ;
+                rdf:predicate ex:p ;
+                rdf:object ex:O ;
+                ex:note "typed" .
+
+            ex:R6 ex:name "six" ; ex:size "6" ; ex:color "blue" .
+            ex:S2 a rdf:Statement ;
+                rdf:subject ex:R6 ;
+                rdf:predicate ex:p ;
+                rdf:object ex:O ;
+                ex:note "typed" .
+            ex:S3 rdf:subject ex:R6 ;
+                rdf:predicate ex:p ;
+                rdf:object ex:O ;
+                ex:x "1" ;
+                ex:y "2" .
+
+            ex:A ex:p ex:B .
+            ex:S4 rdf:subject ex:A ;
+                rdf:predicate ex:p ;
+                rdf:object ex:B ;
+                ex:c "c" .
+
+            ex:R7 ex:name "seven" .
+            ex:S5 rdf:subject ex:R7 ;
+                rdf:object _:bn ;
+                ex:c "c" .
+            _:bn ex:d "e" .
+
+            ex:R9 ex:p _:c1 .
+            _:c1 ex:q _:c2 .
+            _:c2 ex:q _:c1 ; ex:n "v" .
+            """, format="turtle")
+        self.ex = Namespace("http://example.org/")
+        self.graph.bind("ex", self.ex)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        ex = self.ex
+        result = self.graph.cbd(ex.R1)
+        self.assertEqual(len(result), 3)
+        self.assertIsInstance(result, Graph)
+
+        result = self.graph.cbd(ex.R2)
+        self.assertEqual(len(result), 1)
+
+        result = self.graph.cbd(ex.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdBlankNodes(self):
+        # R3 has one direct triple, plus two nested blank nodes
+        # each reached by rule 1.
+        result = self.graph.cbd(self.ex.R3)
+        self.assertEqual(len(result), 3)
+
+    def testCbdReified(self):
+        # Typed reifier S1 contributes its 5 triples to R5's 3 direct.
+        result = self.graph.cbd(self.ex.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        # Typed reifier S2 (5 triples) and untyped reifier S3 (5 triples)
+        # both contribute, with R6's 3 direct triples: 13 in total.
+        result = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(result), 13)
+
+    def testCbdIncomingReification(self):
+        # B is only the object of A p B and of the reifier's rdf:object,
+        # so nothing from S4 is included for B.
+        result = self.graph.cbd(self.ex.B)
+        self.assertEqual(len(result), 0)
+
+        # A has its direct triple plus the 4 triples of reifier S4.
+        result = self.graph.cbd(self.ex.A)
+        self.assertEqual(len(result), 5)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        # S5 contributes 3 triples; _:bn is its rdf:object and is not
+        # expanded, so its ex:d triple is excluded.
+        result = self.graph.cbd(self.ex.R7)
+        self.assertEqual(len(result), 4)
+        blank_triples = list(result.triples((None, self.ex.d, None)))
+        self.assertEqual(len(blank_triples), 0)
+
+    def testCbdBlankNodeCycle(self):
+        # R9 p c1; c1 q c2; c2 q c1; c2 n "v" -> 4 distinct triples.
+        result = self.graph.cbd(self.ex.R9)
+        self.assertEqual(len(result), 4)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(self.ex.R5)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+        self.assertTrue(set(result).issubset(before))
+
+
+if __name__ == "__main__":
+    unittest.main()
