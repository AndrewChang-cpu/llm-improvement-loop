diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..e122d30 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,58 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        Given a particular node (the starting node) in a graph, a subgraph
+        can be obtained by performing the following:
+
+        1. Include in the subgraph all statements in the graph where the
+           subject of the statement is the starting node.
+        2. Recursively, for all statements identified in the subgraph thus
+           far having a blank node as object, include in the subgraph all
+           statements in the graph where the subject of the statement is
+           the blank node in question and which are not already included
+           in the subgraph.
+        3. Recursively, for all statements included in the subgraph thus
+           far, for each reified node R (a node S having an rdf:subject
+           triple whose object is R), include every statement in the graph
+           whose subject is S. This rule is applied without any rdf:Statement
+           type check and without matching rdf:predicate or rdf:object
+           values.
+
+        The result is a subgraph of the source graph: every triple in it
+        exists in this graph, and this graph is not modified. Namespace
+        bindings are not copied.
+
+        :param resource: The starting node of the description. It is used
+            as given in the triple-pattern queries.
+        :return: A new Graph containing the Concise Bounded Description of
+            ``resource``. It is empty if no triples are found.
+        """
+
+        def add_to_cbd(node, cbd_graph):
+            # Rule 1: statements whose subject is the node.
+            for s, p, o in self.triples((node, None, None)):
+                cbd_graph.add((s, p, o))
+                if isinstance(o, BNode):
+                    expanded = False
+                    for _ in cbd_graph.triples((o, None, None)):
+                        expanded = True
+                        break
+                    if not expanded:
+                        add_to_cbd(o, cbd_graph)
+            # Rule 3: reifiers of the node contribute all of their statements.
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    cbd_graph.add(triple)
+            return cbd_graph
+
+        return add_to_cbd(resource, Graph())
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..bf78a99
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,106 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Resource with a blank-node tree: 3 direct + 2 + 1 = 6 triples.
+ex:R1 ex:p1 ex:A ; ex:p2 ex:B ; ex:p3 _:b1 .
+_:b1 ex:q1 "x" ; ex:q2 _:b2 .
+_:b2 ex:r1 "y" .
+
+# Resource with two property triples.
+ex:R2 ex:name "a" ; ex:label "b" .
+
+# Resource with no triples.
+
+# Reified case A: 3 direct + typed reifier (5 triples) = 8.
+ex:R5 ex:p1 ex:A ; ex:p2 ex:B ; ex:p3 ex:C .
+_:s5 a rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:p1 ;
+     rdf:object ex:A ; ex:note "n5" .
+
+# Reified case B: 3 direct + typed reifier (5) + untyped reifier (5) = 13.
+ex:R6 ex:p1 ex:A ; ex:p2 ex:B ; ex:p3 ex:C .
+_:s6a a rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:p1 ;
+      rdf:object ex:A ; ex:note "n6a" .
+_:s6b rdf:subject ex:R6 ; rdf:predicate ex:p2 ; rdf:object ex:B ;
+      ex:note "n6b" ; ex:note2 "n6c" .
+
+# Incoming reification: statement (A2 p B2) reified by _:s7.
+# cbd(A2) = 1 + 4 = 5; cbd(B2) = 0.
+ex:A2 ex:p ex:B2 .
+_:s7 rdf:subject ex:A2 ; rdf:predicate ex:p ; rdf:object ex:B2 ;
+     ex:note "n7" .
+
+# Reifier whose triples point to a blank node: 1 + 2 = 3, blank not expanded.
+ex:R8 ex:p ex:C8 .
+_:s8 rdf:subject ex:R8 ; ex:note _:n8 .
+_:n8 ex:v "z" .
+
+# Blank-node cycle: 4 distinct triples.
+ex:R9 ex:p _:a9 .
+_:a9 ex:q _:b9 .
+_:b9 ex:r _:a9 ; ex:s "t" .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("ex", EX)
+        self.graph.parse(data=FIXTURE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(result), 6)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdTwoProperties(self):
+        result = self.graph.cbd(EX.R2)
+        self.assertEqual(len(result), 2)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntyped(self):
+        # The untyped reifier _:s6b must be included.
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+
+    def testCbdIncomingReification(self):
+        # The reifier of (A2 p B2) is not included for the object B2.
+        self.assertEqual(len(self.graph.cbd(EX.B2)), 0)
+        # It is included for the subject A2.
+        self.assertEqual(len(self.graph.cbd(EX.A2)), 5)
+
+    def testCbdReifierBlankObjectNotExpanded(self):
+        # _:n8 is only reached through the reifier, so its triple is excluded.
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 4)
+
+    def testCbdDoesNotModifySource(self):
+        before = len(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(self.graph), before)
+        self.assertIsNot(result, self.graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
