+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task by the bytes consumed.
+
+        The Progress display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): File mode. 'r' or 'rt' returns text, 'rb' or 'br' returns bytes. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding, for text modes. Defaults to None.
+            errors (str, optional): Error handling for text modes. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (int, optional): Total number of bytes. Default is the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode or buffering is invalid.
+            OSError: If the file size cannot be obtained or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+        text_mode = mode in ("r", "rt")
+
+        line_buffering = False
+        if text_mode:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            line_buffering = buffering == 1
+            if line_buffering:
+                buffering = -1
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode; "
+                "the default buffer size is used",
+                RuntimeWarning,
+                stacklevel=2,
+            )
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if text_mode:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
