+def _file_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=_file_console(), auto_refresh=False) as text:
+            assert text.read() == "hello\nworld\n"
+        assert text.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_mode_reads_text() -> None:
+    path = _temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(
+            path, "r", console=_file_console(), auto_refresh=False
+        ) as text:
+            assert text.read() == "hello\nworld\n"
+        assert text.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_returns_bytes() -> None:
+    path = _temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(
+            path, "rb", console=_file_console(), auto_refresh=False
+        ) as binary:
+            assert binary.read() == b"hello\nworld\n"
+        assert binary.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_default_total_is_file_size() -> None:
+    path = _temp_file(b"0123456789")
+    try:
+        progress = Progress(console=_file_console(), disable=True)
+        with progress.open(path, "rb") as reader:
+            assert progress.tasks[0].total == 10
+            assert reader.read() == b"0123456789"
+    finally:
+        os.remove(path)
+
+
+def test_missing_path_without_total_raises_file_not_found() -> None:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    progress = Progress(console=_file_console(), disable=True)
+    with pytest.raises(FileNotFoundError):
+        progress.open(path, "rb")
+    assert progress.tasks == []
+    with pytest.raises(FileNotFoundError):
+        progress_open(path, console=_file_console(), auto_refresh=False)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    path = _temp_file(b"abc")
+    try:
+        with open(path, "rb") as handle:
+            context = wrap_file(handle, 3, console=_file_console(), auto_refresh=False)
+            with context as reader:
+                assert reader.read() == b"abc"
+            assert reader.closed
+            assert not handle.closed
+        assert handle.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    progress = Progress(console=_file_console(), disable=True)
+    task_id = progress.add_task("reading", total=3.5)
+    path = _temp_file(b"abc")
+    try:
+        with open(path, "rb") as handle:
+            reader = progress.wrap_file(handle, task_id=task_id)
+            assert reader.read() == b"abc"
+    finally:
+        os.remove(path)
+    assert progress.tasks[0].total == 3.5
+    assert progress.tasks[0].completed == 3
+
+
+def test_progress_wrap_file_task_without_total_raises() -> None:
+    progress = Progress(console=_file_console(), disable=True)
+    task_id = progress.add_task("reading", total=None)
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"), task_id=task_id)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+
+
+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"line1\nline2\nline3\n"
+    progress = Progress(console=_file_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+
+    def completed() -> float:
+        return progress.tasks[0].completed
+
+    assert reader.readline() == b"line1\n"
+    assert completed() == 6
+    assert reader.read(3) == b"lin"
+    assert completed() == 9
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"e2\nl"
+    assert completed() == 13
+    assert reader.readlines() == [b"ine3\n"]
+    assert completed() == 18
+
+
+def test_iteration_advances_by_line_length() -> None:
+    data = b"line1\nline2\nline3\n"
+    progress = Progress(console=_file_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert list(reader) == [b"line1\n", b"line2\n", b"line3\n"]
+    assert progress.tasks[0].completed == len(data)
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    data = b"line1\nline2\nline3\n"
+    progress = Progress(console=_file_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert reader.seek(6) == 6
+    assert progress.tasks[0].completed == 6
+    assert reader.tell() == 6
+    assert reader.read(4) == b"line"
+    assert progress.tasks[0].completed == 10
+
+
+def test_write_raises_unsupported_operation() -> None:
+    progress = Progress(console=_file_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(b"abc"), total=3)
+    with pytest.raises(io.UnsupportedOperation, match="write"):
+        reader.write(b"x")
+
+
+def test_binary_buffering_one_warns_and_reads() -> None:
+    path = _temp_file(b"hello")
+    try:
+        progress = Progress(console=_file_console(), disable=True)
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        with reader:
+            assert reader.read() == b"hello"
+    finally:
+        os.remove(path)
+
+
+def test_text_mode_unbuffered_raises() -> None:
+    path = _temp_file(b"hello")
+    try:
+        progress = Progress(console=_file_console(), disable=True)
+        with pytest.raises(ValueError):
+            progress.open(path, "r", buffering=0)
+        assert progress.tasks == []
+    finally:
+        os.remove(path)
+
+
+def test_invalid_mode_raises_value_error() -> None:
+    progress = Progress(console=_file_console(), disable=True)
+    with pytest.raises(ValueError, match="'w'"):
+        progress.open("unused-path.txt", "w")
+    assert progress.tasks == []
+
