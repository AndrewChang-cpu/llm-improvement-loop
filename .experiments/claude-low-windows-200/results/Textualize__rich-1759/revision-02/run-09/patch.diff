+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    content = b"line one\nline two\nline three\n"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with progress.open(path, "rb") as reader:
+            task = progress.tasks[0]
+            assert reader.read(4) == b"line"
+            assert task.completed == 4
+            assert reader.readline() == b" one\n"
+            assert task.completed == reader.tell() == 9
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert buffer == b"line"
+            assert task.completed == reader.tell() == 13
+            assert reader.readlines() == [b" two\n", b"line three\n"]
+            assert task.completed == len(content)
+    finally:
+        os.remove(path)
+
