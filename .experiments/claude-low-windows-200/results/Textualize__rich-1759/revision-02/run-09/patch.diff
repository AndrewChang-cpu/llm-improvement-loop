+class _ReaderContext(Generic[_IOT]):
+    """Starts a Progress display and enters a reader for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        resource (IO): The reader, or a text wrapper around it, to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", resource: _IOT) -> None:
+        self._progress = progress
+        self._resource = resource
+
+    def __enter__(self) -> _IOT:
+        self._progress.start()
+        try:
+            self._resource.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._resource
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._resource.__exit__(exc_type, exc_val, exc_tb)
+
