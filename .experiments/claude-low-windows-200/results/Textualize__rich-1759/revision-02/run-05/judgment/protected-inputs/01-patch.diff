+def test_progress_wrap_file_reuses_task_total() -> None:
+    content = b"abcdef"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_make_read_console())
+        task_id = progress.add_task("read", total=6.5)
+        with open(path, "rb") as file:
+            reader = progress.wrap_file(file, task_id=task_id)
+            assert reader.read() == content
+        task = progress.tasks[0]
+        assert len(progress.tasks) == 1
+        assert task.total == 6.5
+        assert isinstance(task.total, float)
+        assert task.completed == len(content)
+    finally:
