+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(content: bytes) -> str:
+    with tempfile.NamedTemporaryFile(delete=False) as temp:
+        temp.write(content)
+    return temp.name
+
+
+def test_open_default_mode_returns_text() -> None:
+    content = "hello\nworld\n"
+    path = _write_temp_file(content.encode("utf-8"))
+    try:
+        with progress_open(path, console=_make_read_console()) as reader:
+            data = reader.read()
+            assert isinstance(data, str)
+            assert data == content
+        assert reader.closed
+    finally:
+        os.remove(path)
