+class _Reader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task by the bytes it consumes.
+
+    Instances are created by :meth:`Progress.open` and :meth:`Progress.wrap_file`.
+    The byte position is always taken from the wrapped handle.
+
+    Args:
+        handle (BinaryIO): The binary handle to read from.
+        progress (Progress): The Progress that owns the task.
+        task_id (TaskID): The task to advance as bytes are read.
+        owns_handle (bool): True if closing the reader should close ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    def _advance(self, count: int) -> None:
+        """Advance the task by a number of bytes actually consumed."""
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def close(self) -> None:
+        """Close the reader, and the handle if the reader owns it."""
+        if self._owns_handle:
+            self.handle.close()
+        self._closed = True
+
+    def __enter__(self) -> "_Reader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_Reader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._advance(len(line))
+        return line
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the bytes returned."""
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        """Read one line and advance the task by the bytes returned."""
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of the lines."""
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def readinto(self, buffer: bytearray) -> int:
+        """Read into ``buffer`` and advance the task by the count returned."""
+        count = self.handle.readinto(buffer)
+        self._advance(count)
+        return count
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle, and set the task's completed value to the new position."""
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        """Writing is not supported by a reader.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+
+class _ReaderContext:
+    """Starts a Progress display and enters a reader for the duration of a with block.
+
+    The display is started before the reader is entered, and stopped before the
+    reader is exited, so the display is always stopped when the block exits.
+
+    Args:
+        progress (Progress): The Progress to start and stop.
+        stream (IO[Any]): The reader, or a text wrapper around it, to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", stream: IO[Any]) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> IO[Any]:
+        self._progress.start()
+        try:
+            return self._stream.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._stream.__exit__(exc_type, exc_val, exc_tb)
+
