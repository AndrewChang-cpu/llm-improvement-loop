+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task by the bytes consumed.
+
+        The task is not started here; start the Progress to show the display.
+
+        Args:
+            file (Union[str, PathLike, bytes]): The path of the file to open.
+            mode (str, optional): 'r' and 'rt' return a text reader, other accepted modes such as 'rb' return a binary reader. Defaults to 'r'.
+            buffering (int, optional): Buffering policy. In binary mode, 1 uses the default buffer size with a warning. In text mode, 1 requests line buffering. Defaults to -1.
+            encoding (str, optional): Text encoding, for text modes. Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (int, optional): Total number of bytes. Defaults to the size of the file in bytes.
+            task_id (TaskID, optional): An existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering is 0 in text mode.
+            OSError: If the size of the file cannot be obtained, or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(
+                f"unsupported mode {mode!r}; expected 'r', 'rt', 'rb' or 'br'"
+            )
+        is_text = mode in ("r", "rt")
+
+        line_buffering = False
+        if is_text and buffering == 0:
+            raise ValueError("can't have unbuffered text I/O")
+        if buffering == 1:
+            if is_text:
+                line_buffering = True
+            else:
+                warnings.warn(
+                    "line buffering is not supported in binary mode, "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _Reader(handle, self, task_id, owns_handle=True)
+        if is_text:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
