+def test_read_paths_advance_completed() -> None:
+    content = b"line1\nline2\nline3\n"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_make_read_console())
+        with open(path, "rb") as file:
+            reader = progress.wrap_file(file, total=len(content))
+            task = progress.tasks[0]
+            assert reader.readline() == b"line1\n"
+            assert task.completed == 6
+            assert next(reader) == b"line2\n"
+            assert task.completed == 12
+            buffer = bytearray(3)
+            assert reader.readinto(buffer) == 3
+            assert bytes(buffer) == b"lin"
+            assert task.completed == 15
+            assert reader.readlines() == [b"e3\n"]
+            assert task.completed == 18
+    finally:
+        os.remove(path)
+
