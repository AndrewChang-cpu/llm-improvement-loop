+class _ProgressFileReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task by the bytes it returns.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if the reader opened the handle and should close it.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    def _advance(self, count: int) -> None:
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def name(self) -> str:
+        """str: The name reported by the wrapped handle."""
+        return self.handle.name
+
+    @property
+    def mode(self) -> str:
+        """str: The mode reported by the wrapped handle."""
+        return self.handle.mode
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (all).
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        """Read one line and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (no limit).
+
+        Returns:
+            bytes: The line read, including its terminator.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readinto(self, buffer: bytearray) -> int:
+        """Read into a buffer and advance the task by the count returned.
+
+        Args:
+            buffer (bytearray): The buffer to fill.
+
+        Returns:
+            int: The number of bytes read into the buffer.
+        """
+        count = self.handle.readinto(buffer)
+        self._advance(count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all remaining lines and advance the task by their total length.
+
+        Args:
+            hint (int, optional): Approximate byte limit for the lines read. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek in the wrapped handle and set the task's completed value to the position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point for the offset. Defaults to io.SEEK_SET.
+
+        Returns:
+            int: The new absolute position in bytes.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the wrapped handle in bytes."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        """Return whether the wrapped handle is readable."""
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        """Return whether the wrapped handle is seekable."""
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        """Return False, the reader never accepts writes."""
+        return False
+
+    def write(self, data: bytes) -> int:
+        """Refuse a write.
+
+        Raises:
+            io.UnsupportedOperation: Always, because the reader is read-only.
+        """
+        raise io.UnsupportedOperation("'write' is not supported by a progress reader")
+
+    def fileno(self) -> int:
+        """Return the file descriptor of the wrapped handle."""
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Return whether the wrapped handle is an interactive terminal."""
+        return self.handle.isatty()
+
+    def close(self) -> None:
+        """Close the wrapped handle if the reader owns it, and mark the reader closed."""
+        try:
+            if self._owns_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+
+    def __enter__(self) -> BinaryIO:
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ProgressReaderContext(Generic[_ReaderT]):
+    """Starts a progress display and enters a reader for the duration of a block.
+
+    Args:
+        progress (Progress): The Progress instance that displays the reader's progress.
+        stream (IO): The reader, or a text wrapper around it, to yield on enter.
+    """
+
+    def __init__(self, progress: "Progress", stream: _ReaderT) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        self._stream.__enter__()
+        return self._stream
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._stream.__exit__(exc_type, exc_val, exc_tb)
+
