+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Attach a binary reader to an open file that advances a task as bytes are read.
+
+        The reader does not close the wrapped file. The task is not started, and the
+        display is not started by this method.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Total number of bytes. Required unless ``task_id``
+                refers to a task that already has a total.
+            task_id (TaskID, optional): Existing task to advance. Default creates a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError("total must be specified, or the task must have a total")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
