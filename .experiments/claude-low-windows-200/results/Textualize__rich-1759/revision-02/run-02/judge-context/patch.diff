+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file from a path and attach a reader that advances a task as bytes are read.
+
+        The task is not started, and the display is not started by this method.
+
+        Args:
+            file (str | bytes | PathLike): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' or 'br' for binary. Defaults to "r".
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Error handling for text decoding.
+            newline (str, optional): Newline handling for text mode.
+            total (int, optional): Total number of bytes. Default is the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Default creates a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            TextIO | BinaryIO: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering 0 is given in text mode.
+            OSError: If the size of the file cannot be read, or the file cannot be opened.
+        """
+        if "".join(sorted(mode)) not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt', 'rb' or 'br'")
+        is_text = mode in ("r", "rt")
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            line_buffering = buffering == 1
+            handle_buffering = -1 if line_buffering else buffering
+        else:
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode, "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+            handle_buffering = buffering
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", handle_buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if is_text:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
