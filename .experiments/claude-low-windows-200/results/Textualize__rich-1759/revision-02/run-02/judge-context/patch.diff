+    """Open a file for reading, showing its progress in a live display.
+
+    The default mode is text ('r'). Use 'rb' for binary, which returns bytes.
+    The default total is the size of the file in bytes.
+
+    Args:
+        file (str | bytes | PathLike): Path of the file to open.
+        mode (str, optional): File mode, 'r' or 'rt' for text, 'rb' for binary. Defaults to "r".
+        buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+        encoding (str, optional): Text encoding, used in text mode only.
+        errors (str, optional): Error handling for text decoding.
+        newline (str, optional): Newline handling for text mode.
+        total (int, optional): Total number of bytes. Default is the size of the file.
+        description (str, optional): Description of task shown next to progress bar. Defaults to "Reading...".
+        auto_refresh (bool, optional): Automatic refresh, disable to force a refresh after each read. Default is True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time.
+        refresh_per_second (float): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress.
+
+    Returns:
+        ContextManager: A context manager yielding a text reader for 'r' and 'rt', or a binary reader otherwise.
+
+    Raises:
+        ValueError: If the mode is invalid, or buffering 0 is given in text mode.
+        OSError: If the size of the file cannot be read, or the file cannot be opened.
+    """
+    progress = _make_display_progress(
+        description,
+        auto_refresh,
+        console,
+        transient,
+        get_time,
+        refresh_per_second,
+        style,
+        complete_style,
+        finished_style,
+        pulse_style,
+        disable,
+    )
+    result = progress.open(
+        file,
+        mode,
+        buffering,
+        encoding,
+        errors,
+        newline,
+        total=total,
+        description=description,
+    )
+    return _ReaderContext(progress, result)
