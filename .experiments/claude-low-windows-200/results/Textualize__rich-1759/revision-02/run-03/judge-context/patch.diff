+def _make_read_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _make_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello world\n")
+    try:
+        with progress_open(path, console=_make_read_console()) as reader:
+            assert reader.read() == "hello world\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello world\n")
+    try:
+        with progress_open(path, "r", console=_make_read_console()) as reader:
+            assert reader.read() == "hello world\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_rb_mode_reads_bytes() -> None:
+    path = _make_temp_file(b"\x00\x01binary")
+    try:
+        with progress_open(path, "rb", console=_make_read_console()) as reader:
+            assert reader.read() == b"\x00\x01binary"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_keeps_caller_file_open() -> None:
+    with io.BytesIO(b"caller data") as source:
+        with progress_wrap_file(source, 11, console=_make_read_console()) as reader:
+            assert reader.read() == b"caller data"
+        assert reader.closed
+        assert not source.closed
+
+
+def test_progress_open_defaults_total_to_file_size() -> None:
+    path = _make_temp_file(b"0123456789")
+    try:
+        progress = Progress(console=_make_read_console())
+        with progress.open(path, "rb") as reader:
+            assert progress.tasks[0].total == 10
+            assert reader.read() == b"0123456789"
+        assert progress.tasks[0].completed == 10
+    finally:
+        os.remove(path)
+
+
+def test_missing_path_without_total_raises_file_not_found() -> None:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    progress = Progress(console=_make_read_console())
+    with pytest.raises(FileNotFoundError):
+        progress.open(path)
+    assert progress.tasks == []
+    with pytest.raises(FileNotFoundError):
+        progress_open(path, console=_make_read_console())
+
+
+def test_invalid_mode_raises_value_error_before_opening() -> None:
+    progress = Progress(console=_make_read_console())
+    with pytest.raises(ValueError, match="'w'"):
+        progress.open("does-not-exist.txt", "w")
+    assert progress.tasks == []
+
+
+def test_text_mode_buffering_zero_raises_value_error() -> None:
+    progress = Progress(console=_make_read_console())
+    with pytest.raises(ValueError):
+        progress.open("does-not-exist.txt", "r", buffering=0)
+    assert progress.tasks == []
+
+
+def test_binary_mode_buffering_one_warns_and_reads() -> None:
+    path = _make_temp_file(b"abc")
+    try:
+        progress = Progress(console=_make_read_console())
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        with reader:
+            assert reader.read() == b"abc"
+    finally:
+        os.remove(path)
+
