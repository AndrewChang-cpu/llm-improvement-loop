+def test_progress_wrap_file_reuses_task_total() -> None:
+    progress = Progress(console=_make_read_console())
+    task_id = progress.add_task("Parsing", total=6.5)
+    with io.BytesIO(b"hello!") as source:
+        reader = progress.wrap_file(source, task_id=task_id)
+        assert reader.read() == b"hello!"
+        reader.close()
+    assert progress.tasks[0].total == 6.5
+    assert progress.tasks[0].completed == 6
+
+
+def test_progress_wrap_file_without_any_total_raises_value_error() -> None:
+    progress = Progress(console=_make_read_console())
+    task_id = progress.add_task("Parsing", total=None)
+    with io.BytesIO(b"data") as source:
+        with pytest.raises(ValueError):
+            progress.wrap_file(source, task_id=task_id)
+        with pytest.raises(ValueError):
+            progress.wrap_file(source)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+    assert not progress.live.is_started
+
+
+def test_read_methods_advance_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_read_console())
+    task_id = progress.add_task("Reading", total=len(data))
+    with io.BytesIO(data) as source:
+        reader = progress.wrap_file(source, task_id=task_id)
+        assert reader.readline() == b"line one\n"
+        assert progress.tasks[0].completed == 9
+        assert next(reader) == b"line two\n"
+        assert progress.tasks[0].completed == 18
+        assert reader.read(4) == b"line"
+        assert progress.tasks[0].completed == 22
+        buffer = bytearray(3)
+        assert reader.readinto(buffer) == 3
+        assert buffer == bytearray(b" th")
+        assert progress.tasks[0].completed == 25
+        assert reader.readlines() == [b"ree\n"]
+        assert progress.tasks[0].completed == len(data)
+
+
+def test_iteration_advances_completed_by_line_lengths() -> None:
+    progress = Progress(console=_make_read_console())
+    task_id = progress.add_task("Reading", total=4)
+    with io.BytesIO(b"a\nb\n") as source:
+        reader = progress.wrap_file(source, task_id=task_id)
+        assert list(reader) == [b"a\n", b"b\n"]
+    assert progress.tasks[0].completed == 4
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    progress = Progress(console=_make_read_console())
+    task_id = progress.add_task("Reading", total=10)
+    with io.BytesIO(b"0123456789") as source:
+        reader = progress.wrap_file(source, task_id=task_id)
+        assert reader.seek(5) == 5
+        assert progress.tasks[0].completed == 5
+        assert reader.tell() == 5
+        assert reader.read(2) == b"56"
+        assert progress.tasks[0].completed == 7
+
+
+def test_write_raises_unsupported_operation() -> None:
+    progress = Progress(console=_make_read_console())
+    with io.BytesIO(b"abc") as source:
+        reader = progress.wrap_file(source, 3)
+        with pytest.raises(io.UnsupportedOperation, match="write"):
+            reader.write(b"x")
+
