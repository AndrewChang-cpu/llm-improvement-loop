+    def open(
+        self,
+        file: _PathInput,
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task by the bytes consumed.
+
+        The Progress display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): The path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' or 'br' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding used in text mode. Defaults to None.
+            errors (str, optional): Error handling used in text mode. Defaults to None.
+            newline (str, optional): Newline handling used in text mode. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): An existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text reader for 'r' and 'rt', or a binary reader otherwise.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering is 0 in text mode.
+            OSError: If the file size cannot be obtained or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt', 'rb' or 'br'")
+        is_text = mode in ("r", "rt")
+        if is_text and buffering == 0:
+            raise ValueError("can't have unbuffered text I/O")
+        if not is_text and buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode; "
+                "the default buffer size is used",
+                RuntimeWarning,
+                stacklevel=2,
+            )
+        line_buffering = is_text and buffering == 1
+        byte_buffering = -1 if buffering == 1 else buffering
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", byte_buffering)
+        reader = _FileReader(handle, self, task_id, close_handle=True)
+        if is_text:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
