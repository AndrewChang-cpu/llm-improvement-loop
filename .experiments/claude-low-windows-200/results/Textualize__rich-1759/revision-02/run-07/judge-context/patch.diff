+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task by the bytes it returns.
+
+    Instances are created by :meth:`Progress.open` and :meth:`Progress.wrap_file`.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress that owns the task.
+        task_id (TaskID): The task to advance as bytes are read.
+        owns_handle (bool): True if the reader opened the handle and should close it.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    def _advance(self, count: Optional[int]) -> None:
+        """Advance the task by a number of bytes consumed from the handle."""
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def mode(self) -> str:
+        """str: The mode of the wrapped handle."""
+        return self.handle.mode
+
+    @property
+    def name(self) -> Any:
+        """The name of the wrapped handle."""
+        return self.handle.name
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to size bytes and advance the task by the number returned."""
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        """Read one line and advance the task by its length."""
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the sum of their lengths."""
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def readinto(self, buffer: Any) -> int:
+        """Read into a buffer and advance the task by the count returned."""
+        count = self.handle.readinto(buffer)
+        self._advance(count)
+        return count
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle and set the task's completed value to the new position."""
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the wrapped handle."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        """Return whether the wrapped handle is readable."""
+        return self.handle.readable()
+
+    def writable(self) -> bool:
+        """Writing is never supported by a progress reader."""
+        return False
+
+    def seekable(self) -> bool:
+        """Return whether the wrapped handle is seekable."""
+        return self.handle.seekable()
+
+    def fileno(self) -> int:
+        """Return the file descriptor of the wrapped handle."""
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Return whether the wrapped handle is a terminal."""
+        return self.handle.isatty()
+
+    def write(self, data: Any) -> int:
+        """Refuse writes, as a progress reader is read-only."""
+        raise io.UnsupportedOperation("write is not supported by this reader")
+
+    def close(self) -> None:
+        """Close the handle if this reader owns it, and mark the reader closed."""
+        if self._closed:
+            return
+        self._closed = True
+        if self._owns_handle:
+            self.handle.close()
+
