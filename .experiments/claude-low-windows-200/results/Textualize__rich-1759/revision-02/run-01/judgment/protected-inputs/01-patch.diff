+def test_read_methods_advance_completed_by_bytes_returned() -> None:
+    content = b"line one\nline two\nline three\n"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_make_test_console())
+        reader = progress.open(path, "rb")
+        task = progress.tasks[0]
+        try:
+            assert reader.readline() == b"line one\n"
+            assert task.completed == 9
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert bytes(buffer) == b"line"
+            assert task.completed == 13
+            assert reader.read(5) == b" two\n"
+            assert task.completed == 18
+            assert reader.readlines() == [b"line three\n"]
+            assert task.completed == len(content)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_iteration_advances_completed_by_line_lengths() -> None:
+    content = b"alpha\nbeta\n"
