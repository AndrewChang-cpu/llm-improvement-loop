+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file and attach a reader that advances a task as bytes are read.
+
+        Does not start the display. Use the result in a with statement.
+
+        Args:
+            file (str, PathLike or bytes): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' or 'br' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode.
+            errors (str, optional): Error handling, used in text mode.
+            newline (str, optional): Newline handling, used in text mode.
+            total (int, optional): Total number of bytes to read. Defaults to the file size in bytes.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in text mode.
+            OSError: If the file size cannot be read or the file cannot be opened.
+        """
+        if "".join(sorted(mode)) not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+        is_text = mode in ("r", "rt")
+
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            line_buffering = buffering == 1
+            byte_buffering = -1 if buffering == 1 else buffering
+        else:
+            line_buffering = False
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode, "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+            byte_buffering = buffering
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", byte_buffering)
+        reader = _ProgressReader(handle, self, task_id, close_handle=True)
+        if not is_text:
+            return reader
+        try:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        except BaseException:
+            reader.close()
+            raise
