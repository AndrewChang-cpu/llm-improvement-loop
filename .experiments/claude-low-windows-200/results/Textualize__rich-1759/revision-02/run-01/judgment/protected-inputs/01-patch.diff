+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Attach a reader to a binary file object that advances a task as bytes are read.
+
+        The reader does not close the file. Does not start the display.
+
+        Args:
+            file (BinaryIO): An already-open binary file object to read from.
+            total (int, optional): Total number of bytes to read. If omitted, the total of task_id is used.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader for the file.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified, or task_id must refer to a task with a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _ProgressReader(file, self, task_id, close_handle=False)
