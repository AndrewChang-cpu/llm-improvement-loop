+def _write_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as file:
+        file.write(content)
+    return path
+
+
+def _missing_path() -> str:
+    path = _write_temp_file(b"")
+    os.remove(path)
+    return path
+
+
+def test_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=_make_test_console()) as file:
+            assert file.read() == "hello\nworld\n"
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_open_explicit_r_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, "r", console=_make_test_console()) as file:
+            assert file.read() == "hello\nworld\n"
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_open_rb_mode_returns_bytes() -> None:
+    content = b"\x00binary\xff"
+    path = _write_temp_file(content)
+    try:
+        with progress_open(path, "rb", console=_make_test_console()) as file:
+            assert file.read() == content
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_keeps_caller_file_open() -> None:
+    content = b"caller owned"
+    path = _write_temp_file(content)
+    try:
+        with open(path, "rb") as raw:
+            wrapped = progress_wrap_file(
+                raw, len(content), console=_make_test_console()
+            )
+            with wrapped as file:
+                assert file.read() == content
+            assert file.closed
+            assert not raw.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_defaults_total_to_file_size() -> None:
+    content = b"0123456789"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_make_test_console())
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(content)
+            assert not progress.live.is_started
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_missing_path_without_total_raises_file_not_found() -> None:
+    path = _missing_path()
+    progress = Progress(console=_make_test_console())
+    with pytest.raises(FileNotFoundError):
+        progress.open(path, "rb")
+    assert progress.task_ids == []
+    with pytest.raises(FileNotFoundError):
+        progress_open(path, console=_make_test_console())
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    content = b"hello world"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_make_test_console())
+        task_id = progress.add_task("reading", total=11.5)
+        with open(path, "rb") as raw:
+            reader = progress.wrap_file(raw, task_id=task_id)
+            assert reader.read() == content
+    finally:
+        os.remove(path)
+    task = progress.tasks[0]
+    assert task.completed == len(content)
+    assert task.total == 11.5
+
+
+def test_progress_wrap_file_without_task_total_raises_value_error() -> None:
+    progress = Progress(console=_make_test_console())
+    task_id = progress.add_task("reading")
+    setattr(progress.tasks[0], "total", None)
+    path = _write_temp_file(b"data")
+    try:
+        with open(path, "rb") as raw:
+            with pytest.raises(ValueError):
+                progress.wrap_file(raw, task_id=task_id)
+    finally:
+        os.remove(path)
+    assert len(progress.tasks) == 1
+    assert not progress.live.is_started
