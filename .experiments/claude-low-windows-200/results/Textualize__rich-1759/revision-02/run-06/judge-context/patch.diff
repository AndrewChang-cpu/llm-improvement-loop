+def test_progress_wrap_file_reuses_task_total() -> None:
+    content = b"abcde"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_make_test_console())
+        task_id = progress.add_task("reading", total=12.5)
+        with open(path, "rb") as caller_file:
+            reader = progress.wrap_file(caller_file, task_id=task_id)
+            assert reader.read() == content
