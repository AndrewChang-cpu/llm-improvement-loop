+def _make_test_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    content = b"hello\nworld\n"
+    path = _write_temp_file(content)
+    try:
+        with progress_open(path, console=_make_test_console(), auto_refresh=False) as f:
+            assert isinstance(f.read(), str)
+            assert f.closed is False
+        assert f.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_mode_reads_text() -> None:
+    content = b"hello\nworld\n"
+    path = _write_temp_file(content)
+    try:
+        with progress_open(
+            path, "r", console=_make_test_console(), auto_refresh=False
+        ) as f:
+            assert f.read() == "hello\nworld\n"
+        assert f.closed
+    finally:
+        os.remove(path)
+
