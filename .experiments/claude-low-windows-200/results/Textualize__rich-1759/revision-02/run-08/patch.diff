+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (Any): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance. Its total is measured in bytes.
+        owns_handle (bool): Close ``handle`` when this reader is closed.
+    """
+
+    def __init__(
+        self,
+        handle: Any,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self._closed = False
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+
+    def _advance(self, count: int) -> None:
+        self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def writable(self) -> bool:
+        return False
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def read(self, size: int = -1) -> bytes:
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readinto(self, buffer: Any) -> int:
+        count = self.handle.readinto(buffer)
+        self._advance(count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._advance(len(line))
+        return line
+
+    def seek(self, offset: int, whence: int = os.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def write(self, data: Any) -> int:
+        raise io.UnsupportedOperation("write")
+
+    def close(self) -> None:
+        if not self._closed:
+            self._closed = True
+            try:
+                if self._owns_handle:
+                    self.handle.close()
+            finally:
+                super().close()
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ProgressFileContext(Generic[_FileT]):
+    """Context manager that runs a Progress display around a file object.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        file (IO[Any]): The reader or text wrapper to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", file: _FileT) -> None:
+        self._progress = progress
+        self._file = file
+
+    def __enter__(self) -> _FileT:
+        self._progress.start()
+        try:
+            self._file.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._file
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._file.__exit__(exc_type, exc_val, exc_tb)
+
