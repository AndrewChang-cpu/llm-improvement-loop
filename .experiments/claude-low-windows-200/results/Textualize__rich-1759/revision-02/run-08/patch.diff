+def test_progress_wrap_file_reuses_task_total() -> None:
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("Reading", total=10.5)
+    reader = progress.wrap_file(io.BytesIO(b"abcdef"), task_id=task_id)
+    assert reader.read() == b"abcdef"
+    task = progress.tasks[0]
+    assert task.total == 10.5
+    assert task.completed == 6
