+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file from a path and advance a task as its bytes are read.
+
+        The Progress display is not started by this method.
+
+        Args:
+            file (str | bytes | os.PathLike): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' or 'br' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Text error handling, used in text mode only.
+            newline (str, optional): Text newline handling, used in text mode only.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode or buffering is not supported.
+            OSError: If the file size cannot be determined or the file cannot be opened.
+        """
+        if "".join(sorted(mode)) not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt', or 'rb'")
+
+        is_text = mode in ("r", "rt")
+        line_buffering = False
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode; "
+                "the default buffer size is used",
+                RuntimeWarning,
+                stacklevel=2,
+            )
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if is_text:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
