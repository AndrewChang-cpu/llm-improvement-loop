+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp:
+        temp.write(content)
+    return path
+
+
+def _wrapped_reader(payload: bytes) -> Tuple[Progress, TaskID, BinaryIO]:
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("reading", total=len(payload))
+    reader = progress.wrap_file(io.BytesIO(payload), task_id=task_id)
+    return progress, task_id, reader
+
