+    def open(
+        self,
+        file: Union[str, bytes, os.PathLike],
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[BinaryIO, TextIO]:
+        """Open a file for reading, advancing a task by the bytes consumed.
+
+        The Progress is not started by this method. Use it as a context manager or call start().
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for ``open``. Defaults to -1.
+            encoding (str, optional): Text encoding for text mode. Defaults to None.
+            errors (str, optional): Error handling for text mode. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[BinaryIO, TextIO]: A binary reader for 'rb', or a text wrapper for 'r' and 'rt'.
+
+        Raises:
+            ValueError: If the mode is invalid, text mode is given buffering 0, or the size of the file cannot be determined and total is not given.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+        binary = normalized_mode == "br"
+
+        if binary:
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        elif buffering == 0:
+            raise ValueError("can't have unbuffered text I/O")
+        line_buffering = not binary and buffering == 1
+        handle_buffering = -1 if buffering == 1 else buffering
+
+        if total is None:
+            try:
+                total = os.stat(file).st_size
+            except OSError as error:
+                raise ValueError(
+                    "the number of bytes could not be determined; total must be specified"
+                ) from error
+
+        handle = io.open(file, "rb", handle_buffering)
+        try:
+            if task_id is None:
+                task_id = self.add_task(description, total=total)
+            else:
+                self.update(task_id, total=total)
+        except BaseException:
+            handle.close()
+            raise
+
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if binary:
+            return reader
+        try:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        except BaseException:
+            reader.close()
+            raise
