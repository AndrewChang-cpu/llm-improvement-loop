+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(data)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    data = b"hello\nworld"
+    path = _write_temp_file(data)
+    try:
+        console = Console(file=io.StringIO(), force_terminal=True)
+        with progress_open(path, console=console) as reader:
+            assert reader.read() == "hello\nworld"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_text_mode() -> None:
+    path = _write_temp_file(b"hello\nworld")
+    try:
+        console = Console(file=io.StringIO(), force_terminal=True)
+        with progress_open(path, "r", console=console) as reader:
+            assert reader.read() == "hello\nworld"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
