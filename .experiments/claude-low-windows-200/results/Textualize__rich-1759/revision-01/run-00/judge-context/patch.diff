+def test_progress_open_sets_total_to_file_size() -> None:
+    data = b"hello\nworld"
+    path = _write_temp_file(data)
+    try:
+        console = Console(file=io.StringIO(), force_terminal=True)
+        progress = Progress(console=console)
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(data)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
