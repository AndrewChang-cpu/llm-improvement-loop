+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> "_ProgressReader":
+        """Wrap an already-open binary file so that bytes read from it advance a task.
+
+        The wrapped file is not closed by the reader.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Total number of bytes. Defaults to the total of task_id, if given.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the new task, if one is created. Defaults to "Reading...".
+
+        Returns:
+            _ProgressReader: A binary reader over ``file``.
+
+        Raises:
+            ValueError: If no total is given and the task (if any) has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "could not determine the number of bytes to read; "
+                "total must be specified"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
