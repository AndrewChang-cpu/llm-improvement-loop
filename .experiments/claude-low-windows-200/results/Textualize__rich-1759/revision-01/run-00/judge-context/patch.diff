+def test_text_mode_unbuffered_raises() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        console = Console(file=io.StringIO(), force_terminal=True)
+        progress = Progress(console=console)
+        with pytest.raises(ValueError):
