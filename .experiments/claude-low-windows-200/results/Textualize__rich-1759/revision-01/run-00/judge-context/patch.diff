+        """Open a file for reading and attach it to this Progress.
+
+        The Progress is not started by this method.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for a text reader, 'rb' for a binary reader. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding, text mode only.
+            errors (str, optional): Error handling, text mode only.
+            newline (str, optional): Newline handling, text mode only.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the new task, if one is created. Defaults to "Reading...".
+
+        Returns:
+            Union[io.TextIOWrapper, _ProgressReader]: A text reader for 'r' and 'rt', or a binary reader for 'rb'.
+
+        Raises:
+            ValueError: If the mode is invalid, buffering is 0 in text mode, or the size of the file cannot be determined and total is not given.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode == "br":
+            binary = True
+        elif normalized_mode in ("r", "rt"):
+            binary = False
+        else:
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+
+        line_buffering = False
+        if binary:
