+class _ProgressReader(io.RawIOBase):
+    """A binary reader that advances a progress task by the bytes it returns.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress that owns the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if closing the reader should close ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        super().__init__()
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+        self.handle = handle
+
+    def _advance(self, size: int) -> None:
+        if size:
+            self._progress.advance(self._task_id, size)
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def read(self, size: Optional[int] = -1) -> bytes:
+        data = self.handle.read(-1 if size is None else size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: Optional[int] = -1) -> bytes:
+        line = self.handle.readline(-1 if size is None else size)
+        self._advance(len(line))
+        return line
+
+    def readinto(self, buffer: Any) -> int:
+        view = memoryview(buffer).cast("B")
+        data = self.handle.read(len(view))
+        size = len(data)
+        view[:size] = data
+        self._advance(size)
+        return size
+
+    def readlines(self, hint: Optional[int] = -1) -> List[bytes]:
+        lines = self.handle.readlines(-1 if hint is None else hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.handle.readline()
+        if not line:
+            raise StopIteration
+        self._advance(len(line))
+        return line
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def writable(self) -> bool:
+        return False
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def write(self, data: Any) -> int:
+        raise io.UnsupportedOperation("write is not supported by this reader")
+
+    def close(self) -> None:
+        if self._owns_handle:
+            self.handle.close()
+        self._closed = True
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ReaderContext(Generic[ReaderT]):
+    """Starts a Progress and enters a reader; stops and exits them in reverse order.
+
+    Args:
+        progress (Progress): The Progress to start and stop.
+        reader (ReaderT): The reader to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: ReaderT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> ReaderT:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
