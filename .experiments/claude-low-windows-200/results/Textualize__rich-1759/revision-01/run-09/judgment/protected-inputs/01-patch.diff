+
+def _temp_file(content: bytes) -> str:
+    handle, path = tempfile.mkstemp()
+    with os.fdopen(handle, "wb") as file:
+        file.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
