+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task by the bytes it returns.
+
+    Args:
+        handle (BinaryIO): The binary handle to read from.
+        progress (Progress): The Progress that owns the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if closing the reader should close the handle.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self._closed = False
+        self._owns_handle = owns_handle
+        self._progress = progress
+        self._task_id = task_id
+        self.handle = handle
+        super().__init__()
+
+    def _advance(self, count: int) -> None:
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the amount read.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        """Read one line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for no limit. Defaults to -1.
+
+        Returns:
+            bytes: The line read.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of the lines.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def readinto(self, buffer: Any) -> int:
+        """Read into a writable buffer and advance the task by the bytes stored.
+
+        Args:
+            buffer (Any): A writable bytes-like object.
+
+        Returns:
+            int: The number of bytes stored in the buffer.
+        """
+        view = memoryview(buffer).cast("B")
+        data = self.handle.read(len(view))
+        view[: len(data)] = data
+        self._advance(len(data))
+        return len(data)
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point for offset. Defaults to io.SEEK_SET.
+
+        Returns:
+            int: The new absolute position.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle."""
+        return self.handle.tell()
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._advance(len(line))
+        return line
+
+    def readable(self) -> bool:
+        """Return whether the handle is readable."""
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        """Return whether the handle is seekable."""
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        """The reader is never writable."""
+        return False
+
+    def write(self, data: bytes) -> int:
+        """Writing is not supported.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("'write' is not supported by a progress reader")
+
+    def fileno(self) -> int:
+        """Return the file descriptor of the handle."""
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Return whether the handle is an interactive terminal."""
+        return self.handle.isatty()
+
+    def close(self) -> None:
+        """Close the handle if the reader owns it, and mark the reader closed."""
+        if not self._closed:
+            self._closed = True
+            try:
+                if self._owns_handle:
+                    self.handle.close()
+            finally:
+                super().close()
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ReaderContext(Generic[_ReaderT]):
+    """Starts a progress display and enters a reader; stops and exits both on exit.
+
+    Args:
+        progress (Progress): The Progress to start and stop.
+        reader (ContextManager[_ReaderT]): The reader to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: ContextManager[_ReaderT]) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
