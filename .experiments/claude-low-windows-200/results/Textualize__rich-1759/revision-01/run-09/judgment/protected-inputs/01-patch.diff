+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If neither total nor a task with a total is given.
+        """
+        if total is None:
+            if task_id is None:
+                raise ValueError("total must be specified when no task_id is given")
+            with self._lock:
+                task_total = self._tasks[task_id].total
+            if task_total is None:
+                raise ValueError(
+                    "the task has no total; specify 'total' or use a task with a total"
+                )
+            total = int(task_total)
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
