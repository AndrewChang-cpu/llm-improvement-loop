+        description: str = "Reading...",
+    ) -> Union[BinaryIO, TextIO]:
+        """Open a file for reading and advance a task as bytes are read.
+
+        The Progress display is not started by this method.
+
+        Args:
+            file (str | bytes | os.PathLike): The path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding (text mode only). Defaults to None.
+            errors (str, optional): Error handling for decoding (text mode only). Defaults to None.
+            newline (str, optional): Newline handling (text mode only). Defaults to None.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            Union[BinaryIO, TextIO]: A binary reader for 'rb', or a text wrapper for 'r' and 'rt'.
+
+        Raises:
+            ValueError: If the mode is invalid, text mode is given buffering 0, or the size of the file
+                cannot be determined and total is not given.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+        is_binary = normalized_mode == "br"
+
+        line_buffering = False
