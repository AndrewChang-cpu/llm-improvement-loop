+class _Reader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task by the bytes it returns.
+
+    Instances are created by :meth:`Progress.open` and :meth:`Progress.wrap_file`.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance as bytes are consumed.
+        close_handle (bool): True if the reader owns the handle and closes it on close.
+    """
+
+    def __init__(
+        self,
+        handle: Union[BinaryIO, io.BufferedReader],
+        progress: "Progress",
+        task_id: TaskID,
+        close_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._close_handle = close_handle
+        self._closed = False
+
+    def __enter__(self) -> "_Reader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_Reader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def close(self) -> None:
+        try:
+            if self._close_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, b: Union[bytes, bytearray]) -> int:
+        raise io.UnsupportedOperation("'write' is not supported by this reader")
+
+    def read(self, size: int = -1) -> bytes:
+        block = self.handle.read(size)
+        self._progress.advance(self._task_id, len(block))
+        return block
+
+    def readinto(self, b: Union[bytearray, memoryview]) -> int:
+        n = self.handle.readinto(b)  # type: ignore
+        self._progress.advance(self._task_id, n)
+        return n
+
+    def readline(self, size: int = -1) -> bytes:
+        line = self.handle.readline(size)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task_id, sum(len(line) for line in lines))
+        return lines
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+
+_ReaderT = TypeVar("_ReaderT", bound=Union[io.TextIOWrapper, BinaryIO])
+
+
+class _ReadContext(Generic[_ReaderT]):
+    """Context wrapper that runs a Progress display around a reader.
+
+    The display starts on enter and stops on exit, before the reader is exited.
+
+    Args:
+        progress (Progress): The Progress instance whose display is run.
+        reader (_ReaderT): The reader to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: _ReaderT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
