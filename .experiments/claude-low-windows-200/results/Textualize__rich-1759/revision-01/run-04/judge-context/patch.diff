+def test_iteration_and_seek_track_completed() -> None:
+    content = b"one\ntwo\nthree\n"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_quiet_console())
+        reader = progress.open(path, "rb")
+        try:
+            task = progress.tasks[0]
+            iterated = [line for line in reader]
+            assert iterated == [b"one\n", b"two\n", b"three\n"]
+            assert task.completed == len(content)
+
+            position = reader.seek(4)
+            assert position == 4
+            assert task.completed == 4
+            assert reader.tell() == 4
+            assert reader.read() == b"two\nthree\n"
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
