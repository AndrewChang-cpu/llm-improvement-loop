+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    content = b"alpha\nbeta\ngamma\ndelta\nepsilon\n"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_quiet_console())
+        reader = progress.open(path, "rb")
+        try:
+            task = progress.tasks[0]
+
+            line = reader.readline()
+            assert task.completed == len(line)
+
+            buffer = bytearray(4)
+            count = reader.readinto(buffer)
+            assert count == 4
+            assert task.completed == len(line) + count
+
+            lines = reader.readlines()
+            assert task.completed == len(line) + count + sum(map(len, lines))
+            assert task.completed == len(content)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
