+    def open(
+        self,
+        file: Union[str, bytes, os.PathLike],
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[io.TextIOWrapper, BinaryIO]:
+        """Open a file for reading and advance a task as bytes are consumed.
+
+        The Progress is not started by this method; use it as a context manager or call start().
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode. Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[io.TextIOWrapper, BinaryIO]: A text wrapper for 'r' and 'rt', or a binary reader for 'rb'.
+
+        Raises:
+            ValueError: If the mode is invalid, if text mode is given buffering 0, or if
+                the number of bytes cannot be determined and total is not given.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode in ("r", "rt"):
+            binary = False
+        elif normalized_mode == "br":
+            binary = True
+        else:
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+
+        line_buffering = False
+        if binary:
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            try:
+                total = os.stat(file).st_size
+            except OSError as error:
+                raise ValueError(
+                    f"the number of bytes could not be determined for {file!r}; "
+                    "total must be specified"
+                ) from error
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = builtins.open(file, "rb", buffering=buffering)
+        reader = _Reader(handle, self, task_id, close_handle=True)
+        if binary:
+            return reader
+        try:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        except BaseException:
+            reader.close()
+            raise
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Read from a binary file-like object and advance a task as bytes are consumed.
+
+        The wrapped file is not closed when the reader is closed; the caller keeps ownership of it.
+        The Progress is not started by this method.
+
+        Args:
+            file (BinaryIO): An already-open binary file-like object.
+            total (int, optional): Total number of bytes. Defaults to the total of task_id.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If total is not given and task_id is not given or has no total.
+        """
+        task_total: Optional[float] = total
+        if task_total is None:
+            if task_id is None:
+                raise ValueError(
+                    "the number of bytes could not be determined; total must be specified"
+                )
+            with self._lock:
+                task_total = self._tasks[task_id].total
+            if task_total is None:
+                raise ValueError("the task has no total; total must be specified")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=task_total)
+        else:
+            self.update(task_id, total=task_total)
+
+        return _Reader(file, self, task_id, close_handle=False)
