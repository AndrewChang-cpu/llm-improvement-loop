+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task by the bytes it consumes.
+
+    Instances are created by :meth:`Progress.open` and :meth:`Progress.wrap_file`.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance. Its completed value is measured in bytes.
+        owns_handle (bool): True if the reader opened ``handle`` and should close it.
+
+    Attributes:
+        handle (BinaryIO): The wrapped binary file object.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    def _advance(self, size: int) -> None:
+        """Advance the task by a number of bytes."""
+        if size:
+            self._progress.advance(self._task_id, size)
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (read all).
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        """Read one line and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (no limit).
+
+        Returns:
+            bytes: The line read, including its line ending.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of the lines.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read. Defaults to -1 (no limit).
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def readinto(self, buffer: Union[bytearray, memoryview]) -> int:
+        """Read bytes into a buffer and advance the task by the bytes read.
+
+        Args:
+            buffer (Union[bytearray, memoryview]): A writable buffer to fill.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        view = memoryview(buffer).cast("B")
+        data = self.handle.read(len(view))
+        view[: len(data)] = data
+        self._advance(len(data))
+        return len(data)
+
+    def __iter__(self) -> "_ProgressReader":
+        """Return the reader itself, so it can be iterated line by line."""
+        return self
+
+    def __next__(self) -> bytes:
+        """Return the next line and advance the task by its length.
+
+        Returns:
+            bytes: The next line.
+
+        Raises:
+            StopIteration: When the handle has no more lines.
+        """
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        """Seek the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point, as for file objects. Defaults to 0.
+
+        Returns:
+            int: The absolute position in bytes.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle in bytes."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        """Return whether the handle is readable."""
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        """Return whether the handle is seekable."""
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        """Return False, since the reader cannot write."""
+        return False
+
+    def write(self, b: bytes) -> int:
+        """Refuse to write.
+
+        Raises:
+            io.UnsupportedOperation: Always, since the reader is read-only.
+        """
+        raise io.UnsupportedOperation("write is not supported by this reader")
+
+    def fileno(self) -> int:
+        """Return the file descriptor of the handle."""
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Return whether the handle is an interactive terminal."""
+        return self.handle.isatty()
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def close(self) -> None:
+        """Close the handle if this reader owns it, and mark the reader closed."""
+        if not self._closed:
+            self._closed = True
+            if self._owns_handle:
+                self.handle.close()
+
+    def __enter__(self) -> "_ProgressReader":
+        """Enter the handle and return the reader."""
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        """Close the reader."""
+        self.close()
+
+
+class _ProgressContext:
+    """Starts a Progress display and enters a reader for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        reader (Union[_ProgressReader, io.TextIOWrapper]): The object to enter and exit.
+    """
+
+    def __init__(
+        self,
+        progress: "Progress",
+        reader: Union[_ProgressReader, io.TextIOWrapper],
+    ) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> Union[_ProgressReader, io.TextIOWrapper]:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
+def _make_reading_progress(
+    description: str,
+    auto_refresh: bool,
+    console: Optional[Console],
+    transient: bool,
+    get_time: Optional[Callable[[], float]],
+    refresh_per_second: float,
+    style: StyleType,
+    complete_style: StyleType,
+    finished_style: StyleType,
+    pulse_style: StyleType,
+    disable: bool,
+) -> "Progress":
+    """Build a Progress display laid out like the one used by ``track()``."""
+    columns: List["ProgressColumn"] = (
+        [TextColumn("[progress.description]{task.description}")] if description else []
+    )
+    columns.extend(
+        (
+            BarColumn(
+                style=style,
+                complete_style=complete_style,
+                finished_style=finished_style,
+                pulse_style=pulse_style,
+            ),
+            DownloadColumn(),
+            TimeRemainingColumn(),
+        )
+    )
+    return Progress(
+        *columns,
+        auto_refresh=auto_refresh,
+        console=console,
+        transient=transient,
+        get_time=get_time,
+        refresh_per_second=refresh_per_second or 10,
+        disable=disable,
+    )
