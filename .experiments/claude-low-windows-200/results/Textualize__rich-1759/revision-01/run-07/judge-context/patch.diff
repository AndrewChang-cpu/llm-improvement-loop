+    def open(
+        self,
+        file: Union[str, bytes, os.PathLike],
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[_ProgressReader, io.TextIOWrapper]:
+        """Open a file and attach a reader that advances a task as bytes are read.
+
+        The progress display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): ``'r'`` or ``'rt'`` for text, ``'rb'`` for binary. Defaults to ``'r'``.
+            buffering (int, optional): Buffering policy, as for ``open()``. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode. Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): An existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[_ProgressReader, io.TextIOWrapper]: A binary reader for ``'rb'``, or a
+            text wrapper around a binary reader for ``'r'`` and ``'rt'``.
+
+        Raises:
+            ValueError: If the mode is invalid, the buffering is invalid for the mode, or the size
+                of the file cannot be determined and no total was given.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode == "br":
+            binary = True
+        elif normalized_mode in ("r", "rt"):
+            binary = False
+        else:
+            raise ValueError(f"invalid mode: {mode!r}")
+
+        line_buffering = False
+        if binary:
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            try:
+                total = os.path.getsize(file)
+            except OSError as error:
+                raise ValueError(
+                    f"the number of bytes could not be determined for {file!r}; "
+                    "total must be specified"
+                ) from error
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if binary:
+            return reader
+        try:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        except BaseException:
+            reader.close()
+            raise
