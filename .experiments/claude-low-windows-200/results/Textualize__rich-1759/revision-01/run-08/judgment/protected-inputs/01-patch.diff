+def _fresh_reader(content: bytes) -> Tuple[Progress, Any]:
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("reading", total=len(content))
+    reader = progress.wrap_file(io.BytesIO(content), task_id=task_id)
+    return progress, reader
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    content = b"hello world\nsecond line\n"
+    path = _write_temp(content)
+    try:
+        with progress_open(path, console=_make_console()) as text_file:
+            text = text_file.read()
+            assert isinstance(text, str)
+            assert text == content.decode()
+        assert text_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_text_mode_reads_text() -> None:
+    content = b"explicit text\n"
+    path = _write_temp(content)
+    try:
+        with progress_open(path, "r", console=_make_console()) as text_file:
+            assert text_file.read() == content.decode()
+        assert text_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_reads_bytes() -> None:
+    content = b"\x00\x01binary\xff"
+    path = _write_temp(content)
+    try:
+        with progress_open(path, "rb", console=_make_console()) as binary_file:
+            assert binary_file.read() == content
+        assert binary_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_total_defaults_to_file_size() -> None:
+    content = b"0123456789" * 5
+    path = _write_temp(content)
+    try:
+        progress = Progress(console=_make_console())
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(content)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    content = b"caller owned"
+    path = _write_temp(content)
+    try:
+        with open(path, "rb") as raw_file:
+            with progress_wrap_file(
+                raw_file, len(content), console=_make_console()
+            ) as reader:
+                assert reader.read() == content
+            assert reader.closed
+            assert not raw_file.closed
+        assert raw_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    content = b"0123456789"
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("reading", total=len(content))
+    reader = progress.wrap_file(io.BytesIO(content), task_id=task_id)
+    assert reader.read() == content
+    assert progress.tasks[0].completed == len(content)
+
+
+def test_each_read_path_advances_completed_by_bytes_returned() -> None:
+    content = b"line one\nline two\nline three\n"
+
+    progress, reader = _fresh_reader(content)
+    assert reader.read(4) == b"line"
+    assert progress.tasks[0].completed == 4
+
+    progress, reader = _fresh_reader(content)
+    line = reader.readline()
+    assert line == b"line one\n"
+    assert progress.tasks[0].completed == len(line)
+
+    progress, reader = _fresh_reader(content)
+    buffer = bytearray(5)
+    assert reader.readinto(buffer) == 5
+    assert progress.tasks[0].completed == 5
+
+    progress, reader = _fresh_reader(content)
+    lines = reader.readlines()
+    assert progress.tasks[0].completed == sum(len(line) for line in lines)
+    assert progress.tasks[0].completed == len(content)
+
+    progress, reader = _fresh_reader(content)
+    assert list(reader) == [b"line one\n", b"line two\n", b"line three\n"]
+    assert progress.tasks[0].completed == len(content)
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    progress, reader = _fresh_reader(b"0123456789")
+    assert reader.seek(3) == 3
+    assert progress.tasks[0].completed == 3
+    assert reader.tell() == 3
+
