+class _BinaryReader(io.RawIOBase):
+    """A binary reader that advances a progress task by the bytes it returns.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance as bytes are consumed.
+        owns_handle (bool): True if closing the reader should close ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self._closed = False
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def _account(self, count: int) -> None:
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    def read(self, size: int = -1) -> bytes:
+        data = self.handle.read(size)
+        self._account(len(data))
+        return data
+
+    def readinto(self, buffer: Any) -> int:
+        view = memoryview(buffer).cast("B")
+        data = self.handle.read(len(view))
+        count = len(data)
+        view[:count] = data
+        self._account(count)
+        return count
+
+    def readline(self, size: int = -1) -> bytes:
+        line = self.handle.readline(size)
+        self._account(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self._account(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_BinaryReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        raise io.UnsupportedOperation("write is not supported by this reader")
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def close(self) -> None:
+        if self._owns_handle:
+            self.handle.close()
+        self._closed = True
+
+    def __enter__(self) -> "_BinaryReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ReaderContext(Generic[ReaderT]):
+    """Starts a Progress display and enters a reader for the duration of a block.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        reader (ContextManager): The reader to enter and exit inside the display.
+    """
+
+    def __init__(self, progress: "Progress", reader: ContextManager[ReaderT]) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> ReaderT:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            self._reader.__exit__(*sys.exc_info())
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
