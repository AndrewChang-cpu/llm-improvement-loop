+    ) -> Union[_BinaryReader, io.TextIOWrapper]:
+        """Open a file for reading and attach it to a progress task.
+
+        The display is not started by this method.
+
+        Args:
+            file (Union[str, PathLike, bytes]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Error handling for text decoding, used in text mode only.
+            newline (str, optional): Newline handling, used in text mode only.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            Union[_BinaryReader, io.TextIOWrapper]: A binary reader for 'rb', or a text wrapper for 'r' and 'rt'.
+
+        Raises:
+            ValueError: If the mode is invalid, the buffering is invalid for the mode,
+                or the total cannot be determined.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+        binary = "b" in normalized_mode
+
+        line_buffering = False
+        if buffering == 1:
+            if binary:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+            else:
+                line_buffering = True
+            buffering = -1
+        elif buffering == 0 and not binary:
+            raise ValueError("can't have unbuffered text I/O")
+
+        if total is None:
+            try:
+                total = os.path.getsize(file)
+            except OSError as error:
+                raise ValueError(
+                    "the number of bytes could not be determined; "
+                    "total must be specified"
+                ) from error
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _BinaryReader(handle, self, task_id, owns_handle=True)
+        if binary:
+            return reader
+        return io.TextIOWrapper(
+            reader,
+            encoding=encoding,
+            errors=errors,
+            newline=newline,
+            line_buffering=line_buffering,
+        )
