+class _Reader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task by the bytes it returns.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance as bytes are consumed.
+        close_handle (bool, optional): Close ``handle`` when this reader is closed. Defaults to True.
+
+    Returns:
+        _Reader: A binary reader that counts the bytes consumed from ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        close_handle: bool = True,
+    ) -> None:
+        self._closed = False
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._close_handle = close_handle
+
+    def _advance(self, count: int) -> None:
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    @property
+    def mode(self) -> str:
+        return "rb"
+
+    @property
+    def name(self) -> Any:
+        return self.handle.name
+
+    def __enter__(self) -> "_Reader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_Reader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._advance(len(line))
+        return line
+
+    def read(self, size: int = -1) -> bytes:
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def readinto(self, buffer: Any) -> int:
+        view = memoryview(buffer).cast("B")
+        data = self.handle.read(len(view))
+        count = len(data)
+        view[:count] = data
+        self._advance(count)
+        return count
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, b: bytes) -> int:
+        raise io.UnsupportedOperation("write is not supported by a progress reader")
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def close(self) -> None:
+        if not self._closed:
+            self._closed = True
+            if self._close_handle:
+                self.handle.close()
+
+
+class _ReaderContext(Generic[ReaderType]):
+    """Starts a Progress display and enters a reader for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        reader (ReaderType): The reader to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: ReaderType) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> ReaderType:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
