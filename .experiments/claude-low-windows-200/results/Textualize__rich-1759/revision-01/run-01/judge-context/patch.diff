 )
@@ -549,6 +553,185 @@ def test_no_output_if_progress_is_disabled() -> None:
     assert result == expected
 
 
+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _make_temp_file(content: bytes) -> str:
+    handle, path = tempfile.mkstemp()
+    with os.fdopen(handle, "wb") as file:
+        file.write(content)
+    return path
+
+
+def test_module_open_reads_text_by_default() -> None:
+    content = b"hello\nworld\n"
+    path = _make_temp_file(content)
+    try:
+        with progress_open(path, console=_make_console()) as reader:
+            assert reader.read() == "hello\nworld\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_mode_reads_text() -> None:
+    content = b"hello\nworld\n"
+    path = _make_temp_file(content)
+    try:
+        with progress_open(path, "r", console=_make_console()) as reader:
+            assert reader.readline() == "hello\n"
+            assert reader.read() == "world\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_rb_returns_bytes() -> None:
+    content = b"\x00\x01binary\xff"
+    path = _make_temp_file(content)
+    try:
+        with progress_open(path, "rb", console=_make_console()) as reader:
+            assert reader.read() == content
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_sets_total_to_file_size() -> None:
+    content = b"0123456789" * 5
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console())
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(content)
+            assert not progress.live.is_started
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    content = b"caller owned bytes"
+    path = _make_temp_file(content)
+    try:
+        with open(path, "rb") as handle:
+            with progress_wrap_file(
+                handle, len(content), console=_make_console()
+            ) as reader:
+                assert reader.read() == content
+            assert reader.closed
+            assert not handle.closed
+        assert handle.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_existing_task_total() -> None:
+    content = b"reuse the task total"
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("reading", total=len(content))
+    reader = progress.wrap_file(io.BytesIO(content), task_id=task_id)
+    assert reader.read() == content
+    assert progress.tasks[0].completed == len(content)
+
+
+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    content = b"abc\ndef\nghi\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(content), len(content))
+    task = progress.tasks[0]
+
+    assert reader.read(2) == b"ab"
+    assert task.completed == 2
+    assert reader.readline() == b"c\n"
+    assert task.completed == 4
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert buffer == b"def"
+    assert task.completed == 7
+    assert reader.readlines() == [b"\n", b"ghi\n"]
+    assert task.completed == 12
+    assert reader.seek(0) == 0
+    assert task.completed == 0
+    assert list(reader) == [b"abc\n", b"def\n", b"ghi\n"]
+    assert task.completed == 12
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    content = b"0123456789"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(content), len(content))
+    task = progress.tasks[0]
+
+    assert reader.seek(4) == 4
+    assert task.completed == 4
+    assert reader.tell() == 4
+    assert reader.read(2) == b"45"
+    assert task.completed == 6
+
+
+def test_write_raises_unsupported_operation() -> None:
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(b"abc"), 3)
+    assert not reader.writable()
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+
+
+def test_file_like_without_total_or_task_total_raises_and_starts_nothing() -> None:
+    progress = Progress(console=_make_console())
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"))
+    assert progress.tasks == []
+    assert not progress.live.is_started
+
+
+def test_invalid_mode_raises_before_creating_task() -> None:
+    path = _make_temp_file(b"data")
+    try:
+        progress = Progress(console=_make_console())
+        with pytest.raises(ValueError, match="'w'"):
+            progress.open(path, "w")
+        assert progress.tasks == []
+    finally:
+        os.remove(path)
+
+
+def test_text_mode_buffering_zero_raises() -> None:
+    path = _make_temp_file(b"data")
+    try:
+        progress = Progress(console=_make_console())
+        with pytest.raises(ValueError):
+            progress.open(path, "r", buffering=0)
+    finally:
+        os.remove(path)
+
+
+def test_binary_mode_buffering_one_warns_and_reads() -> None:
+    content = b"buffered bytes"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console())
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        try:
+            assert reader.read() == content
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
 if __name__ == "__main__":
     _render = render_progress()
