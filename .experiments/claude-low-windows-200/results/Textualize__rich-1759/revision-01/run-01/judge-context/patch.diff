+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[BinaryIO, TextIO]:
+        """Open a file for reading and advance a task by the bytes consumed.
+
+        The display is not started by this method; start the Progress (for example by using it as a context manager) to show progress.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Error handling for text decoding, used in text mode only.
+            newline (str, optional): Newline handling, used in text mode only.
+            total (int, optional): Total number of bytes to read. Defaults to the file size.
+            task_id (TaskID, optional): An existing task to advance. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            Union[BinaryIO, TextIO]: A binary reader for 'rb', or a text wrapper around a binary reader for 'r' and 'rt'.
+
+        Raises:
+            ValueError: If the mode is invalid, text mode is given buffering 0, or the number of bytes
+                cannot be determined and total is not given.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+        binary = "b" in normalized_mode
+
+        line_buffering = False
+        if binary:
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            try:
+                total = os.path.getsize(file)
+            except OSError as error:
+                raise ValueError(
+                    f"the number of bytes could not be determined for {file!r}; please specify 'total'"
+                ) from error
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering=buffering)
+        reader = _Reader(handle, self, task_id)
+        if binary:
+            return reader
+        try:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        except BaseException:
