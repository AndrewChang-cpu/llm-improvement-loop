+    def open(
+        self,
+        file: _PathInput,
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[io.RawIOBase, io.TextIOWrapper]:
+        """Open a file for reading and advance a task by the bytes consumed.
+
+        The Progress is not started by this method.
+
+        Args:
+            file (str | PathLike | bytes): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy. In binary mode 1 is not supported and
+                the default is used. In text mode 1 requests line buffering. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only. Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total number of bytes. Defaults to the file size.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            io.RawIOBase: A binary reader for 'rb'.
+            io.TextIOWrapper: A text reader for 'r' and 'rt'.
+
+        Raises:
+            ValueError: If the mode is invalid, buffering is 0 in text mode, or the total
+                cannot be determined.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+        binary = normalized_mode == "br"
+
+        line_buffering = False
+        if binary:
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            line_buffering = buffering == 1
+            if line_buffering:
+                buffering = -1
+
+        if total is None:
+            try:
+                total = os.stat(file).st_size
+            except OSError as error:
+                raise ValueError(
+                    f"the number of bytes could not be determined for {file!r}; "
+                    "total must be specified"
+                ) from error
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _BinaryReader(handle, self, task_id, owns_handle=True)
+        if binary:
+            return reader
+        try:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        except BaseException:
+            reader.close()
+            raise
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> io.RawIOBase:
+        """Wrap an open binary file and advance a task by the bytes consumed.
+
+        The file is not closed by the returned reader.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Total number of bytes. Defaults to the task's total.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            io.RawIOBase: A binary reader.
+
+        Raises:
+            ValueError: If total is not given and the task has no total, or neither is given.
+        """
+        if total is None and task_id is not None:
+            with self._lock:
+                total = self._tasks[task_id].total
+        if total is None:
+            raise ValueError(
+                "the number of bytes could not be determined; total must be specified"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+        return _BinaryReader(file, self, task_id, owns_handle=False)
+
