+def _write_temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(data)
+    return path
+
+
+def _console() -> Console:
+    return Console(file=io.StringIO(), force_terminal=True)
+
+
+def _progress_reader(data: bytes) -> Tuple[Progress, io.RawIOBase]:
+    progress = Progress(console=_console())
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    return progress, reader
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    try:
+        with progress_open(path, console=_console()) as f:
+            assert f.read() == "hello\nworld\n"
+        assert f.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_text_mode() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    try:
+        with progress_open(path, "r", console=_console()) as f:
+            assert f.read() == "hello\nworld\n"
+        assert f.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_returns_bytes() -> None:
+    data = b"\x00\x01binary\xff"
+    path = _write_temp_file(data)
+    try:
+        with progress_open(path, "rb", console=_console()) as f:
+            assert f.read() == data
+        assert f.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_exception_propagates() -> None:
+    path = _write_temp_file(b"data")
+    try:
+        with pytest.raises(RuntimeError):
+            with progress_open(path, "rb", console=_console()):
+                raise RuntimeError("boom")
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_defaults_total_to_file_size() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    progress = Progress(console=_console())
+    try:
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(data)
+            assert not progress.live.is_started
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_invalid_mode_creates_no_task() -> None:
+    path = _write_temp_file(b"data")
+    progress = Progress(console=_console())
+    try:
+        with pytest.raises(ValueError, match="'w'"):
+            progress.open(path, "w")
+        assert progress.tasks == []
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_text_buffering_zero_raises() -> None:
+    path = _write_temp_file(b"data")
+    progress = Progress(console=_console())
+    try:
+        with pytest.raises(ValueError):
+            progress.open(path, "r", buffering=0)
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_binary_buffering_one_warns_and_reads() -> None:
+    data = b"line one\nline two\n"
+    path = _write_temp_file(data)
+    progress = Progress(console=_console())
+    try:
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        try:
+            assert reader.read() == data
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_wrap_file_module_level_caller_owned() -> None:
+    data = b"binary data"
+    path = _write_temp_file(data)
+    try:
+        with io.open(path, "rb") as raw:
+            with wrap_file(raw, len(data), console=_console()) as reader:
+                assert reader.read() == data
+            assert reader.closed
+            assert not raw.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_existing_task_total() -> None:
+    data = b"0123456789"
+    progress = Progress(console=_console())
+    task_id = progress.add_task("read", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+    assert reader.read() == data
+    assert progress.tasks[0].total == len(data)
+    assert progress.tasks[0].completed == len(data)
+
+
+def test_wrap_file_without_total_or_task_raises() -> None:
+    progress = Progress(console=_console())
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"x"))
+    task_id = progress.add_task("read", total=None)
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"x"), task_id=task_id)
+    assert not progress.live.is_started
+
+
+def test_readline_advances_by_bytes_returned() -> None:
+    progress, reader = _progress_reader(b"ab\ncd\n")
+    assert reader.readline() == b"ab\n"
+    assert progress.tasks[0].completed == 3
+
+
+def test_read_advances_by_bytes_returned() -> None:
+    progress, reader = _progress_reader(b"ab\ncd\n")
+    assert reader.read(4) == b"ab\nc"
+    assert progress.tasks[0].completed == 4
+
+
+def test_readinto_advances_by_bytes_returned() -> None:
+    progress, reader = _progress_reader(b"ab\ncd\n")
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert bytes(buffer) == b"ab\n"
+    assert progress.tasks[0].completed == 3
+
+
+def test_readlines_advances_by_sum_of_lengths() -> None:
+    progress, reader = _progress_reader(b"ab\ncd\n")
+    assert reader.readlines() == [b"ab\n", b"cd\n"]
+    assert progress.tasks[0].completed == 6
+
+
+def test_iteration_advances_by_line_lengths() -> None:
+    progress, reader = _progress_reader(b"ab\ncd\n")
+    assert list(reader) == [b"ab\n", b"cd\n"]
+    assert progress.tasks[0].completed == 6
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    progress, reader = _progress_reader(b"ab\ncd\n")
+    assert reader.seek(3) == 3
+    assert progress.tasks[0].completed == 3
+    assert reader.tell() == 3
+    assert reader.read() == b"cd\n"
+    assert progress.tasks[0].completed == 6
+
+
+def test_write_raises_unsupported_operation() -> None:
+    _, reader = _progress_reader(b"ab\n")
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
