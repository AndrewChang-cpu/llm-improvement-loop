+def open(
+    file: _PathInput,
+    mode: str = "r",
+    buffering: int = -1,
+    encoding: Optional[str] = None,
+    errors: Optional[str] = None,
+    newline: Optional[str] = None,
+    *,
+    total: Optional[int] = None,
+    description: str = "Reading...",
+    auto_refresh: bool = True,
+    console: Optional[Console] = None,
+    transient: bool = False,
+    get_time: Optional[GetTimeCallable] = None,
+    refresh_per_second: float = 10,
+    style: StyleType = "bar.back",
+    complete_style: StyleType = "bar.complete",
+    finished_style: StyleType = "bar.finished",
+    pulse_style: StyleType = "bar.pulse",
+    disable: bool = False,
+) -> ContextManager[Any]:
+    """Read a file while displaying progress of the bytes consumed.
+
+    The display starts when the returned context is entered and stops when it exits.
+
+    Args:
+        file (str | PathLike | bytes): Path of the file to open.
+        mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+        buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+        encoding (str, optional): Text encoding, used in text mode only. Defaults to None.
+        errors (str, optional): Error handling for text decoding. Defaults to None.
+        newline (str, optional): Newline handling for text mode. Defaults to None.
+        total (int, optional): Total number of bytes. Defaults to the file size.
+        description (str, optional): Description of the task. Defaults to "Reading...".
+        auto_refresh (bool, optional): Enable automatic refresh. Defaults to True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time.
+        refresh_per_second (float, optional): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress. Defaults to False.
+
+    Returns:
+        ContextManager: A context manager that yields a text reader for 'r' and 'rt',
+            or a binary reader for 'rb'.
+
+    Raises:
+        ValueError: If the mode is invalid, buffering is 0 in text mode, or the total
+            cannot be determined.
+    """
+    progress = _make_read_progress(
+        description,
+        auto_refresh,
+        console,
+        transient,
+        get_time,
+        refresh_per_second,
+        style,
+        complete_style,
+        finished_style,
+        pulse_style,
+        disable,
+    )
+    reader = progress.open(
+        file,
+        mode,
+        buffering,
+        encoding,
+        errors,
+        newline,
+        total=total,
+        description=description,
+    )
+    return _ReadContext(progress, reader)
+
