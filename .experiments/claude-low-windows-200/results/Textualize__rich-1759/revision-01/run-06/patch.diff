+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file-like object and track the bytes consumed in a task.
+
+        The wrapped file is not closed when the reader is closed. The progress display is not started by this method.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Size in bytes. If not given, the total of the existing task named by task_id is used.
+            task_id (TaskID, optional): Existing task to update. Default adds a new task.
+            description (str, optional): Description of the new task, if one is added. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that does not own file.
+
+        Raises:
+            ValueError: If neither total nor an existing task with a total is given.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "the number of bytes could not be determined, please specify 'total'"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _ProgressReader(file, self, task_id, close_handle=False)
