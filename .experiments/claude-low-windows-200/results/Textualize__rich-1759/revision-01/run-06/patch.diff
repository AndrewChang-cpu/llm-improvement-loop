+class _ReadContext:
+    """Context manager that runs a Progress display around a reader.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        reader (Union[io.TextIOWrapper, BinaryIO]): The reader to enter and exit.
+    """
+
+    def __init__(
+        self, progress: "Progress", reader: Union[io.TextIOWrapper, BinaryIO]
+    ) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> Union[io.TextIOWrapper, BinaryIO]:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
