+        """Open a file for reading and track the bytes consumed in a task.
+
+        The progress display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. In text mode, 1 requests line buffering. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Error handling for text decoding.
+            newline (str, optional): Newline handling for text mode.
+            total (int, optional): Size in bytes. Defaults to the file size reported by the file system.
+            task_id (TaskID, optional): Existing task to update. Default adds a new task.
+            description (str, optional): Description of the new task, if one is added. Defaults to "Reading...".
+
+        Returns:
+            Union[io.TextIOWrapper, BinaryIO]: A text wrapper for 'r' and 'rt', or a binary reader for 'rb'.
+
+        Raises:
+            ValueError: If the mode is invalid, text mode is given buffering 0, or the size of the file cannot be determined and total is not given.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}, expected 'r', 'rt' or 'rb'")
+        binary = "b" in normalized_mode
