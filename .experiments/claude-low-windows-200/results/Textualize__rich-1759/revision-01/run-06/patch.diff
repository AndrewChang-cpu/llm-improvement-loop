+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary handle to read from. Exposed as the ``handle`` attribute.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance. Its total is measured in bytes.
+        close_handle (bool): True if the reader owns the handle and closes it on close.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        close_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._close_handle = close_handle
+        self._closed = False
+
+    def _advance(self, size: int) -> None:
+        """Advance the task by a number of bytes.
+
+        Args:
+            size (int): Number of bytes that were consumed.
+        """
+        if size:
+            self._progress.advance(self._task_id, size)
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._advance(len(line))
+        return line
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the number returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (all).
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        """Read one line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (no limit).
+
+        Returns:
+            bytes: The line read, including its line ending.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of the lines.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read. Defaults to -1 (all).
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def readinto(self, buffer: Any) -> int:
+        """Read bytes into a writable buffer and advance the task by the count.
+
+        Args:
+            buffer (Any): A writable bytes-like object.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        view = memoryview(buffer).cast("B")
+        data = self.handle.read(len(view))
+        size = len(data)
+        view[:size] = data
+        self._advance(size)
+        return size
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Byte offset.
+            whence (int, optional): Reference point, as for file seek. Defaults to 0.
+
+        Returns:
+            int: The absolute position after seeking.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle.
+
+        Returns:
+            int: The current byte position.
+        """
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        """Return whether the handle is readable."""
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        """Return whether the handle is seekable."""
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        """Return False, since the reader never writes."""
+        return False
+
+    def write(self, data: Any) -> int:
+        """Refuse to write.
+
+        Raises:
+            io.UnsupportedOperation: Always, since the reader is read-only.
+        """
+        raise io.UnsupportedOperation("'write' is not supported by this reader")
+
+    def fileno(self) -> int:
+        """Return the file descriptor of the handle."""
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Return whether the handle is an interactive terminal."""
+        return self.handle.isatty()
+
+    def close(self) -> None:
+        """Close the handle if the reader owns it, and mark the reader closed."""
+        if self._close_handle:
+            self.handle.close()
+        self._closed = True
+
