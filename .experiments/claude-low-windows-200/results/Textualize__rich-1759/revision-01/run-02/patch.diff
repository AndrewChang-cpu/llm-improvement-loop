+class _ProgressReader(io.RawIOBase):
+    """A binary reader that advances a progress task by the bytes it returns.
+
+    Instances are created by :meth:`Progress.open` and :meth:`Progress.wrap_file`.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that holds the task.
+        task_id (TaskID): The task to advance as bytes are consumed.
+        owns_handle (bool): True if closing the reader should close ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        super().__init__()
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._is_closed = False
+
+    def _advance(self, size: int) -> None:
+        """Advance the task by a number of bytes, if any were consumed."""
+        if size:
+            self._progress.advance(self._task_id, size)
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:
+        """Read one line and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for no limit. Defaults to -1.
+
+        Returns:
+            bytes: The line read, including its line ending.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readinto(self, buffer: Any) -> int:
+        """Read bytes into a writable buffer and advance the task.
+
+        Args:
+            buffer (Any): A writable bytes-like object.
+
+        Returns:
+            int: The number of bytes written into ``buffer``.
+        """
+        view = memoryview(buffer).cast("B")
+        data = self.handle.read(len(view))
+        count = len(data)
+        view[:count] = data
+        self._advance(count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all remaining lines and advance the task by their total length.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.handle.readline()
+        if not line:
+            raise StopIteration
+        self._advance(len(line))
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek in the underlying handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point, as for ``io`` seek. Defaults to io.SEEK_SET.
+
+        Returns:
+            int: The new absolute position in bytes.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the underlying handle."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        """Writing is not supported by a reader.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._is_closed
+
+    def close(self) -> None:
+        """Close the reader, and the handle if the reader owns it."""
+        if not self._is_closed:
+            self._is_closed = True
+            if self._owns_handle:
+                self.handle.close()
+        super().close()
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ProgressContext(Generic[_ReaderT]):
+    """Starts a Progress display and enters a reader; on exit, stops the display first, then exits the reader.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        reader (ContextManager): The reader to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: ContextManager[_ReaderT]) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
