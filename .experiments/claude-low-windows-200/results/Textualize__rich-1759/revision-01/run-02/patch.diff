+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(content)
+    return path
+
+
+def test_progress_module_open_default_mode_reads_text() -> None:
+    path = _write_temp(b"hello world")
+    try:
+        with progress_open(path, auto_refresh=False, console=_make_console()) as reader:
+            assert reader.read() == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
