+def test_progress_reader_read_paths_advance_completed() -> None:
+    content = b"line one\nline two\nline three\n"
+    path = _write_temp(content)
+    try:
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        reader = progress.open(path, "rb")
+        with reader:
+            assert reader.readline() == b"line one\n"
+            assert progress.tasks[0].completed == 9
+            assert reader.read(4) == b"line"
+            assert progress.tasks[0].completed == 13
+            buffer = bytearray(3)
+            assert reader.readinto(buffer) == 3
+            assert bytes(buffer) == b" tw"
+            assert progress.tasks[0].completed == 16
+            assert reader.readlines() == [b"o\n", b"line three\n"]
+            assert progress.tasks[0].completed == len(content)
+
+            reader.seek(0)
+            assert progress.tasks[0].completed == 0
+            lines = list(reader)
+            assert lines == [b"line one\n", b"line two\n", b"line three\n"]
+            assert progress.tasks[0].completed == len(content)
+    finally:
+        os.remove(path)
