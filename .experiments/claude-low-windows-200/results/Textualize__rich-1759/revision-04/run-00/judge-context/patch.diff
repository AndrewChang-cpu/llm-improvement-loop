+    def open(
+        self,
+        file: Union[str, bytes, "os.PathLike[str]"],
+        mode: Literal["r", "rt", "rb"] = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task as bytes are consumed.
+
+        The task is not started by this method. Use the Progress display to show it.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): "r" or "rt" for text, or "rb" for binary. Defaults to "r".
+            buffering (int, optional): Buffering policy. Defaults to -1.
+            encoding (str, optional): Text encoding, used for text modes. Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for "r" and "rt", otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or if buffering is 0 in a text mode.
+            OSError: If the file size cannot be read or the file cannot be opened.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering=buffering)
+        reader = _BinaryFileReader(handle, self, task_id, owns_handle=True)
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Read from an open binary file-like object, advancing a task as bytes are consumed.
+
+        The file is not closed by the returned reader.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Total number of bytes. Defaults to the total of task_id, if given.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that wraps the file.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified for a file-like object, "
+                "either as an argument or on the task"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _BinaryFileReader(file, self, task_id, owns_handle=False)
