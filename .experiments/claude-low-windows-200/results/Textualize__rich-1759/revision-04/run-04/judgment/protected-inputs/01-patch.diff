+    data = b"0123456789"
+    path = _write_temp_file(data)
+    try:
+        with open(path, "rb") as caller_file:
+            with rich_progress.wrap_file(
+                caller_file, len(data), console=_make_file_console()
+            ) as reader:
+                assert reader.read() == data
+            assert reader.closed
+            assert not caller_file.closed
+        assert caller_file.closed
+    finally:
+        os.remove(path)
+
