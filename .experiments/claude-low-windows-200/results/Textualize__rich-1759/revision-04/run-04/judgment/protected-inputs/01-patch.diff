+def test_readline_and_read_advance_completed_by_bytes_returned() -> None:
+    data = b"first line\nsecond line\nthird line\n"
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+
+    def completed() -> float:
+        return progress.tasks[0].completed
+
+    assert reader.readline() == b"first line\n"
+    assert completed() == 11
+    assert reader.read(4) == b"seco"
+    assert completed() == 15
+    buffer = bytearray(5)
+    assert reader.readinto(buffer) == 5
+    assert bytes(buffer) == b"nd li"
+    assert completed() == 20
+    assert reader.readlines() == [b"ne\n", b"third line\n"]
+    assert completed() == len(data)
+
