+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"line one\n"
+    assert task.completed == 9
+
+    assert next(reader) == b"line two\n"
+    assert task.completed == 18
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"line"
+    assert task.completed == 22
+
+    assert reader.readlines() == [b" three\n"]
+    assert task.completed == 29
+
+    assert reader.read() == b""
+    assert task.completed == 29
+
