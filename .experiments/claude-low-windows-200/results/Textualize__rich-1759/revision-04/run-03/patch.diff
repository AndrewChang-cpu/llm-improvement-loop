+def test_text_mode_forwards_large_buffering_to_handle(monkeypatch) -> None:
+    path = _write_temp_file(b"text")
+    real_open = io.open
+    requested = []
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        requested.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    try:
+        progress = Progress(console=_file_console(), auto_refresh=False)
+        with progress.open(path, "r", buffering=4096) as f:
+            assert f.read() == "text"
+        assert requested == [4096]
+    finally:
+        os.remove(path)
+
