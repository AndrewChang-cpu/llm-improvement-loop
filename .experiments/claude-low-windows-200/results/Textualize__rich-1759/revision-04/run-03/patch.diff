+    # Clear the total directly; adding a task with total=None would make the
+    # refresh triggered by add_task render columns that need a numeric total.
+    progress.tasks[0].total = None
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"), task_id=task_id)
+    assert len(progress.tasks) == 1
