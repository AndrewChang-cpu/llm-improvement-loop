+def test_reader_advances_completed_for_each_read_path() -> None:
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(b"ab\ncd\nef\n"), total=9)
+    assert reader.read(2) == b"ab"
+    assert progress.tasks[0].completed == 2
+    assert reader.readline() == b"\n"
+    assert progress.tasks[0].completed == 3
+    buffer = bytearray(2)
+    assert reader.readinto(buffer) == 2
+    assert buffer == b"cd"
+    assert progress.tasks[0].completed == 5
+    assert next(reader) == b"\n"
+    assert progress.tasks[0].completed == 6
+    assert reader.readlines() == [b"ef\n"]
+    assert progress.tasks[0].completed == 9
