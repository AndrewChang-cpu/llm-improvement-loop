+def test_reader_read_paths_advance_completed() -> None:
+    data = b"alpha\nbeta\ngamma\n"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with open(path, "rb") as handle:
+            reader = progress.wrap_file(handle, len(data))
+            assert reader.readline() == b"alpha\n"
+            assert progress.tasks[0].completed == 6
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert buffer == b"beta"
+            assert progress.tasks[0].completed == 10
+            assert reader.readlines() == [b"\n", b"gamma\n"]
+            assert progress.tasks[0].completed == len(data)
+    finally:
+        os.remove(path)
