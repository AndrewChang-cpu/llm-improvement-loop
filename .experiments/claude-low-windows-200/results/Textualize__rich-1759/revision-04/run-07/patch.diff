+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp:
+        temp.write(data)
+    return path
+
+
+def _missing_path() -> str:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    return path
+
+
+def test_module_open_defaults_to_text() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    try:
+        with rich.progress.open(path, console=_make_console()) as text_file:
+            assert text_file.read() == "hello\nworld\n"
+        assert text_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_text_mode() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    try:
+        with rich.progress.open(path, "r", console=_make_console()) as text_file:
+            assert text_file.read() == "hello\nworld\n"
+        assert text_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_returns_bytes() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    try:
+        with rich.progress.open(path, "rb", console=_make_console()) as binary_file:
+            assert binary_file.read() == data
+        assert binary_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    try:
+        with open(path, "rb") as source:
+            with rich.progress.wrap_file(
+                source, len(data), console=_make_console()
+            ) as reader:
+                assert reader.read() == data
+            assert reader.closed
+            assert not source.closed
+        assert source.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_sets_total_to_file_size() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with progress.open(path, "rb") as reader:
+            assert reader.read() == data
+        assert progress.tasks[0].total == len(data)
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_does_not_start_display() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    try:
+        reader = progress.open(path, "rb")
+        assert not progress.live.is_started
+        reader.close()
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("read", total=12.5)
+    try:
+        with open(path, "rb") as source:
+            reader = progress.wrap_file(source, task_id=task_id)
+            assert reader.read() == data
+        task = progress.tasks[0]
+        assert task.completed == len(data)
+        assert task.total == 12.5
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_without_total_raises() -> None:
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("read", total=None)
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"), task_id=task_id)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+
+
+def test_progress_wrap_file_without_total_or_task_raises() -> None:
+    progress = Progress(console=_make_console())
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"))
+    assert progress.tasks == []
+
+
+def test_missing_path_without_total_raises_file_not_found() -> None:
+    path = _missing_path()
+    progress = Progress(console=_make_console())
+    with pytest.raises(FileNotFoundError):
+        progress.open(path, "rb")
+    with pytest.raises(FileNotFoundError):
+        rich.progress.open(path, console=_make_console())
+    assert progress.tasks == []
+
+
+def test_reader_advances_completed_by_bytes_returned() -> None:
+    data = b"first line\nsecond line\nthird line\n"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with progress.open(path, "rb") as reader:
+            assert reader.readline() == b"first line\n"
+            assert progress.tasks[0].completed == 11
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert progress.tasks[0].completed == 15
+            assert reader.read(3) == b"nd "
+            assert progress.tasks[0].completed == 18
+            assert reader.readlines() == [b"line\n", b"third line\n"]
+            assert progress.tasks[0].completed == len(data)
+    finally:
+        os.remove(path)
+
+
+def test_reader_iteration_advances_completed() -> None:
+    data = b"a\nbb\n"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with progress.open(path, "rb") as reader:
+            assert list(reader) == [b"a\n", b"bb\n"]
+            assert progress.tasks[0].completed == len(data)
+    finally:
+        os.remove(path)
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    data = b"first line\nsecond line\n"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with progress.open(path, "rb") as reader:
+            assert reader.seek(4) == 4
+            assert progress.tasks[0].completed == 4
+            assert reader.tell() == 4
+            assert reader.read(2) == b"t "
+            assert progress.tasks[0].completed == 6
+    finally:
+        os.remove(path)
+
+
+def test_write_raises_unsupported_operation() -> None:
+    data = b"abc"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with progress.open(path, "rb") as reader:
+            with pytest.raises(io.UnsupportedOperation):
+                reader.write(b"x")
+    finally:
+        os.remove(path)
+
+
+def test_invalid_mode_raises_before_file_is_opened() -> None:
+    progress = Progress(console=_make_console())
+    with pytest.raises(ValueError):
+        progress.open("does-not-exist", "w")
+    assert progress.tasks == []
+
+
+def test_text_mode_zero_buffering_raises() -> None:
+    progress = Progress(console=_make_console())
+    with pytest.raises(ValueError):
+        progress.open("does-not-exist", "r", 0)
+    assert progress.tasks == []
+
+
+def test_binary_mode_line_buffering_warns_and_reads() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", 1)
+        with reader:
+            assert reader.read() == data
+    finally:
+        os.remove(path)
+
+
+def test_text_mode_returns_text_reader() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with progress.open(path) as text_file:
+            assert isinstance(text_file, io.TextIOWrapper)
+            assert text_file.read() == "hello\nworld\n"
+    finally:
+        os.remove(path)
+
+
+def test_tr_mode_returns_binary_reader() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    progress = Progress(console=_make_console())
+    try:
+        with progress.open(path, "tr") as reader:
+            assert reader.read() == data
+    finally:
+        os.remove(path)
+
+
