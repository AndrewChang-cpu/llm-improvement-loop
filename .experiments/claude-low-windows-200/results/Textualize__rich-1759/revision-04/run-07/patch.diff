@@ -199,6 +199,44 @@ If the :class:`~rich.progress.Progress` class doesn't offer exactly what you nee
         def get_renderables(self):
             yield Panel(self.make_tasks_table(self.tasks))
 
+
+Reading from a file
+~~~~~~~~~~~~~~~~~~~
+
+:func:`~rich.progress.open` reads a file while showing how many bytes have been consumed, which is useful for a long-running parser. Pass a path (a ``str``, a path-like object, or ``bytes``). The default mode is text (``'r'``), and the reader returns ``str``. Pass ``'rb'`` to read bytes instead. The total defaults to the size of the file in bytes. The file is closed when the ``with`` block exits::
+
+    import rich.progress
+
+    with rich.progress.open("data.json") as text_file:
+        contents = text_file.read()
+
+    with rich.progress.open("data.bin", "rb") as binary_file:
+        data = binary_file.read()
+
+The progress display is shown while the ``with`` block runs.
+
+Reading from a file-like object
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+:func:`~rich.progress.wrap_file` reads an already-open binary file-like object. It only supports binary reads, and you must pass ``total``, the number of bytes to read. The reader does not close the file you pass in, so that file stays open after the ``with`` block exits::
+
+    import rich.progress
+
+    with open("data.bin", "rb") as source:
+        with rich.progress.wrap_file(source, total=1024) as reader:
+            data = reader.read()
+        assert not source.closed
+
+To attach a reader to a Progress instance you already have, call :meth:`~rich.progress.Progress.wrap_file` on it. Pass ``task_id`` to reuse an existing task. If you omit ``total``, the task's total is used, and the call raises ``ValueError`` if the task has no total. :meth:`~rich.progress.Progress.open` works the same way for a path::
+
+    import rich.progress
+
+    with rich.progress.Progress() as progress:
+        task_id = progress.add_task("Reading", total=1024)
+        with open("data.bin", "rb") as source:
+            reader = progress.wrap_file(source, task_id=task_id)
+            data = reader.read()
+
