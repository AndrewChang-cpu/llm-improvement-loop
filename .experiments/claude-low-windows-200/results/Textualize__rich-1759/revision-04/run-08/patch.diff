+def test_text_mode_passes_buffering_to_handle(monkeypatch) -> None:
+    data = b"abc\n"
+    path = _write_temp_file(data)
+    calls = []
+    real_open = io.open
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        calls.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    try:
+        progress = Progress(console=_quiet_console())
+        with progress.open(path, "r", buffering=4096) as reader:
+            assert reader.read() == "abc\n"
+        assert calls == [4096]
+    finally:
+        os.remove(path)
+
