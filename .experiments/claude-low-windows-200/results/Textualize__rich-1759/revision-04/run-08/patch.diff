+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task as bytes are consumed.
+
+        The task is not started here; the display is not started either. Use
+        the returned reader in a ``with`` statement.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding, used for text modes.
+            errors (str, optional): Error handling for text decoding.
+            newline (str, optional): Newline handling for text modes.
+            total (int, optional): Total number of bytes. Defaults to the file size.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text reader for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering is 0 in text mode.
+            OSError: If the file size or the file cannot be obtained.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode, "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        elif buffering == 0:
+            raise ValueError("can't have unbuffered text I/O")
+        elif buffering == 1:
+            line_buffering = True
+            buffering = -1
+
+        task_total: Optional[float] = total
+        if task_total is None:
+            task_total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=task_total)
+        else:
+            self.update(task_id, total=task_total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _Reader(handle, self, task_id, close_handle=True)
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file-like object in a reader that advances a task.
+
+        The wrapped file is not closed when the reader is closed.
+
+        Args:
+            file (BinaryIO): An already-open binary file-like object.
+            total (int, optional): Total number of bytes. If not given, the total of
+                ``task_id`` is used.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        task_total: Optional[float] = total
+        if task_total is None and task_id is not None:
+            with self._lock:
+                task_total = self._tasks[task_id].total
+        if task_total is None:
+            raise ValueError(
+                "total must be specified, or task_id must refer to a task with a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=task_total)
+        else:
+            self.update(task_id, total=task_total)
+        return _Reader(file, self, task_id, close_handle=False)
