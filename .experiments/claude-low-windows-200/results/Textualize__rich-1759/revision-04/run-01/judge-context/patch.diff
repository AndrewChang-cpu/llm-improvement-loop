+    def open(
+        self,
+        file: _PathLike,
+        mode: Literal["r", "rt", "rb"] = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and attach it to a task that counts bytes consumed.
+
+        The Progress is not started by this method.
+
+        Args:
+            file (str | bytes | os.PathLike): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy passed to the file. Defaults to -1.
+            encoding (str, optional): Text encoding for text mode. Defaults to None.
+            errors (str, optional): Error handling for text mode. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Size of the file in bytes. Defaults to the file size.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Raises:
+            ValueError: If the mode or buffering is invalid for the mode.
+            OSError: If the file size or the file cannot be obtained.
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text reader for 'r' and 'rt', otherwise a binary reader.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _BinaryFileReader(handle, self, task_id, owns_handle=True)
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file so that reading from it advances a task.
+
+        The wrapped file is not closed when the reader is closed.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Size of the file in bytes. Defaults to the stored total of task_id.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+
+        Returns:
+            BinaryIO: A binary reader.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified, or task_id must refer to a task with a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+
+        return _BinaryFileReader(file, self, task_id, owns_handle=False)
