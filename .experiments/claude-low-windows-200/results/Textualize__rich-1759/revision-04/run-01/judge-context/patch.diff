+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    progress = Progress(console=_quiet_console())
+    task_id = progress.add_task("reading", total=10)
+    reader = progress.wrap_file(io.BytesIO(b"0123456789"), task_id=task_id)
+    assert reader.read(3) == b"012"
+    assert reader.seek(7) == 7
+    assert progress.tasks[0].completed == 7
+    assert reader.tell() == 7
+    assert reader.read(2) == b"78"
+    assert progress.tasks[0].completed == 9
