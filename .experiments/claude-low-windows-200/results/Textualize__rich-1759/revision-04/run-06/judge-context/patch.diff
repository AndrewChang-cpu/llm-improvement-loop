+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    try:
+        progress = Progress(auto_refresh=False, console=_make_console())
+        with open(path, "rb") as fh:
+            reader = progress.wrap_file(fh, len(FILE_CONTENT))
+            task = progress.tasks[0]
+            assert reader.read(5) == b"hello"
+            assert task.completed == 5
+            assert reader.readline() == b"\n"
+            assert task.completed == 6
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert buffer == b"worl"
+            assert task.completed == 10
+            assert next(reader) == b"d\n"
+            assert task.completed == 12
+            assert reader.readlines() == [b"again\n"]
+            assert task.completed == 18
+    finally:
+        os.remove(path)
