+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    path = _write_temp_file(b"0123456789")
+    try:
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        with progress.open(path, "rb") as reader:
+            task = progress.tasks[0]
+            reader.read(4)
+            assert reader.seek(7) == 7
+            assert task.completed == 7
+            assert reader.tell() == 7
+            assert reader.read(2) == b"78"
+            assert task.completed == 9
+    finally:
+        os.remove(path)
