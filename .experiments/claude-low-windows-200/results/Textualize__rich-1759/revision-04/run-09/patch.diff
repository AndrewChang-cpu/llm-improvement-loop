+        """Open a file for reading and advance a task as bytes are consumed.
+
+        The display is not started by this method.
+
+        Args:
+            file (Union[str, PathLike, bytes]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy. With 'r' or 'rt', 0 is an error and 1 requests line buffering. With 'rb', 1 uses the default buffer size with a warning. Other values are passed to the file open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Error handling for text decoding, used in text mode only.
+            newline (str, optional): Newline handling, used in text mode only.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update. A new task is added if not given.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode or buffering is invalid.
+            OSError: If the total cannot be found from the file size, or the file cannot be opened.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+
+        line_buffering = False
+        if normalized == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
