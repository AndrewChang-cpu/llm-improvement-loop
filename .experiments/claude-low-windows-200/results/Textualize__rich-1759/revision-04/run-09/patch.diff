+def _make_console() -> Console:
+    return Console(file=io.StringIO(), force_terminal=True, width=60)
+
+
+def _write_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp:
+        temp.write(content)
+    return path
+
+
+def _missing_path() -> str:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(
+            path, console=_make_console(), auto_refresh=False
+        ) as reader:
+            assert reader.read() == "hello\nworld\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
