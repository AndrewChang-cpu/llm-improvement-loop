+def test_reads_advance_completed_by_bytes_returned() -> None:
+    content = b"aaa\nbbbb\ncc\ndddd\n"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        with progress.open(path, "rb") as reader:
+            task = progress.tasks[0]
+            assert reader.readline() == b"aaa\n"
+            assert task.completed == 4
+            buffer = bytearray(3)
+            assert reader.readinto(buffer) == 3
+            assert bytes(buffer) == b"bbb"
+            assert task.completed == 7
+            assert reader.read(2) == b"b\n"
+            assert task.completed == 9
+            assert reader.readlines() == [b"cc\n", b"dddd\n"]
+            assert task.completed == len(content)
+
+        with progress.open(path, "rb") as reader:
+            task = progress.tasks[-1]
+            lines = list(reader)
+            assert lines == [b"aaa\n", b"bbbb\n", b"cc\n", b"dddd\n"]
+            assert task.completed == len(content)
+    finally:
+        os.remove(path)
+
