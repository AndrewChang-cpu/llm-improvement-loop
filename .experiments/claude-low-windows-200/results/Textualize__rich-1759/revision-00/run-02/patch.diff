+    def read(
+        self,
+        file: Union[str, "os.PathLike[str]", BinaryIO],
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Track progress while reading from a binary file or path.
+
+        Args:
+            file: A path, or a binary file-like object to read from. If a path is given it is opened
+                for reading and closed when the returned reader is closed.
+            total (int, optional): Total number of bytes. Default is the size of the file if a path is given.
+                Must be specified for file-like objects.
+            task_id: (TaskID): Task to track. Default is new task.
+            description: (str, optional): Description of task, if new task is created.
+
+        Returns:
+            BinaryIO: A binary file-like object that updates the progress as it is read.
+        """
+        close_handle = False
+        if isinstance(file, (str, os.PathLike)):
+            handle: BinaryIO = open(file, "rb")
+            close_handle = True
+            if total is None:
+                total = os.stat(file).st_size
+        else:
+            handle = file
+            if total is None:
+                raise ValueError(
+                    f"unable to get size of {file!r}, please specify 'total'"
+                )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=float(total))
+        else:
+            self.update(task_id, total=float(total))
+
+        reader = _Reader(handle, self, task_id, close_handle=close_handle)
+        return reader  # type: ignore[return-value]
