+class _Reader:
+    """A reader that tracks progress while reading from a binary file-like object.
+
+    This class is private; use ``Progress.read`` (or ``rich.progress.read``) to get one.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: "TaskID",
+        close_handle: bool = False,
+        on_close: Optional[Callable[[], None]] = None,
+    ) -> None:
+        self.handle = handle
+        self.progress = progress
+        self.task_id = task_id
+        self.close_handle = close_handle
+        self.on_close = on_close
+        self._position = 0
+
+    @property
+    def closed(self) -> bool:
+        return self.handle.closed
+
+    def readable(self) -> bool:
+        return True
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def __enter__(self) -> "_Reader":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def _advance(self, size: int) -> None:
+        self._position += size
+        self.progress.update(self.task_id, completed=self._position)
+
+    def read(self, size: Optional[int] = -1) -> bytes:  # type: ignore[override]
+        data = self.handle.read(-1 if size is None else size)
+        self._advance(len(data))
+        return data
+
+    def readinto(self, buffer: Any) -> int:  # type: ignore[override]
+        count = self.handle.readinto(buffer)
+        self._advance(count or 0)
+        return count or 0
+
+    def readline(self, size: Optional[int] = -1) -> bytes:  # type: ignore[override]
+        line = self.handle.readline(-1 if size is None else size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:  # type: ignore[override]
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self._position = position
+        self.progress.update(self.task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self._position
+
+    def close(self) -> None:
+        if self.close_handle:
+            self.handle.close()
+        if self.on_close is not None:
+            on_close, self.on_close = self.on_close, None
+            on_close()
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def flush(self) -> None:
+        pass
+
