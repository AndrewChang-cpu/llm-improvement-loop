+def test_progress_read_file_like() -> None:
+    progress = Progress(disable=True)
+    data = io.BytesIO(b"0123456789")
+    with progress:
+        reader = progress.read(data, total=10)
+        assert reader.read(4) == b"0123"
+        task = progress.tasks[0]
+        assert task.completed == 4
+        assert reader.read() == b"456789"
+        assert progress.tasks[0].completed == 10
+        assert progress.tasks[0].finished
+        reader.seek(2)
+        assert progress.tasks[0].completed == 2
+    assert not data.closed
+
+
+def test_progress_read_file_like_requires_total() -> None:
+    progress = Progress(disable=True)
+    with pytest.raises(ValueError):
+        progress.read(io.BytesIO(b"abc"))
+
+
+def test_progress_read_path(tmp_path) -> None:
+    path = tmp_path / "data.bin"
+    path.write_bytes(b"hello world")
+    progress = Progress(disable=True)
+    with progress:
+        reader = progress.read(str(path))
+        assert progress.tasks[0].total == 11
+        with reader as f:
+            lines = list(f)
+            assert lines == [b"hello world"]
+        assert progress.tasks[0].completed == 11
+    assert reader.closed
+
+
+def test_read_helper(tmp_path) -> None:
+    path = tmp_path / "data.bin"
+    path.write_bytes(b"abcdef")
+    with read(str(path), disable=True) as f:
+        assert f.read() == b"abcdef"
+
