+        description: str = "Reading...",
+    ) -> "_Reader":
+        """Track progress while reading from a binary file.
+
+        Args:
+            file (Union[str, BinaryIO]): A path to a file, or a binary file-like object.
+            total (int, optional): Total number of bytes. Required when ``file`` is a file-like object.
+                Default is the size of the file at the given path.
+            description (str, optional): Description of task shown next to the progress bar. Defaults to "Reading...".
+
+        Returns:
+            _Reader: A binary file reader which advances the task as it is read.
+
+        Raises:
+            ValueError: If ``file`` is a file-like object and ``total`` is not given.
+        """
+        if isinstance(file, str):
+            if total is None:
+                total = os.stat(file).st_size
+            handle: BinaryIO = io.open(file, "rb")
+            close_handle = True
+        else:
+            if total is None:
+                raise ValueError(
+                    "unable to get size of file-like object; please specify 'total'"
+                )
+            handle = file
+            close_handle = False
+        task_id = self.add_task(description, total=total)
+        return _Reader(handle, self, task_id, close_handle=close_handle)
