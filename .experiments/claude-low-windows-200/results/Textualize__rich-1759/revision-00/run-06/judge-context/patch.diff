+    def read(
+        self,
+        file: Union[str, BinaryIO],
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Track progress while reading from a binary file or path.
+
+        Args:
+            file (Union[str, BinaryIO]): A path, or a binary file-like object to read from.
+            total (int, optional): Total number of bytes to read. Required when a file-like object
+                is given. When a path is given, defaults to the size of the file.
+            task_id (TaskID, optional): Task to track. Default is new task.
+            description (str, optional): Description of task, if new task is created.
+
+        Returns:
+            BinaryIO: A file-like object that advances the progress as it is read.
+        """
+        close_handle = False
+        if isinstance(file, str):
+            if total is None:
+                total = os.stat(file).st_size
+            handle: BinaryIO = open(file, "rb")
+            close_handle = True
+        else:
+            handle = file
+            if total is None:
+                raise ValueError("unable to get size of file, please specify 'total'")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        return _Reader(handle, self, task_id, close_handle=close_handle)
