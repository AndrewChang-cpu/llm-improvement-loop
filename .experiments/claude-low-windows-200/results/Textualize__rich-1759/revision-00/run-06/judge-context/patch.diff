+def read(
+    file: Union[str, BinaryIO],
+    total: Optional[int] = None,
+    description: str = "Reading...",
+    auto_refresh: bool = True,
+    console: Optional[Console] = None,
+    transient: bool = False,
+    get_time: Optional[Callable[[], float]] = None,
+    refresh_per_second: float = 10,
+    style: StyleType = "bar.back",
+    complete_style: StyleType = "bar.complete",
+    finished_style: StyleType = "bar.finished",
+    pulse_style: StyleType = "bar.pulse",
+    disable: bool = False,
+) -> BinaryIO:
+    """Read a binary file or path while displaying progress.
+
+    Args:
+        file (Union[str, BinaryIO]): A path, or a binary file-like object to read from.
+        total (int, optional): Total number of bytes to read. Required when a file-like object
+            is given. When a path is given, defaults to the size of the file.
+        description (str, optional): Description of task show next to progress bar. Defaults to "Reading...".
+        auto_refresh (bool, optional): Automatic refresh, disable to force a refresh after each read. Default is True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time.
+        refresh_per_second (float): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.done".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress.
+
+    Returns:
+        BinaryIO: A file-like object that advances the progress as it is read.
+    """
+    columns: List["ProgressColumn"] = (
+        [TextColumn("[progress.description]{task.description}")] if description else []
+    )
+    columns.extend(
+        (
+            BarColumn(
+                style=style,
+                complete_style=complete_style,
+                finished_style=finished_style,
+                pulse_style=pulse_style,
+            ),
+            TextColumn("[progress.percentage]{task.percentage:>3.0f}%"),
+            TimeRemainingColumn(),
+        )
+    )
+    progress = Progress(
+        *columns,
+        auto_refresh=auto_refresh,
+        console=console,
+        transient=transient,
+        get_time=get_time,
+        refresh_per_second=refresh_per_second or 10,
+        disable=disable,
+    )
+    progress.start()
+    try:
+        reader = progress.read(file, total=total, description=description)
+    except Exception:
+        progress.stop()
+        raise
+    return _ProgressStopReader(reader, progress)
+
+
+class _ProgressStopReader:
+    """Wraps a reader created by `read` and stops its progress when closed."""
+
+    def __init__(self, reader: BinaryIO, progress: "Progress") -> None:
+        self._reader = reader
+        self._progress = progress
+
+    def __enter__(self) -> BinaryIO:
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._reader, name)
+
+    def __iter__(self) -> Iterable[bytes]:  # type: ignore[override]
+        return iter(self._reader)
+
+    def close(self) -> None:
+        try:
+            self._reader.close()
+        finally:
+            self._progress.stop()
+
