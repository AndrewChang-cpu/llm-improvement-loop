+class _Reader(io.RawIOBase, BinaryIO):  # type: ignore[misc]
+    """A reader that updates a progress task each time data is read from it.
+
+    This class is private; use `Progress.read` or `rich.progress.read` to obtain one.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: "TaskID",
+        close_handle: bool = False,
+    ) -> None:
+        self.handle = handle
+        self.progress = progress
+        self.task_id = task_id
+        self.close_handle = close_handle
+        super().__init__()
+
+    def __enter__(self) -> "_Reader":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_Reader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def readable(self) -> bool:
+        return True
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    @property
+    def closed(self) -> bool:  # type: ignore[override]
+        return self.handle.closed
+
+    def close(self) -> None:
+        if self.close_handle:
+            self.handle.close()
+
+    def read(self, size: Optional[int] = -1) -> bytes:  # type: ignore[override]
+        block = self.handle.read(size)
+        self.progress.advance(self.task_id, len(block))
+        return block
+
+    def read1(self, size: int = -1) -> bytes:
+        block = self.handle.read1(size)  # type: ignore[attr-defined]
+        self.progress.advance(self.task_id, len(block))
+        return block
+
+    def readinto(self, buffer: Any) -> int:  # type: ignore[override]
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self.progress.advance(self.task_id, count)
+        return count
+
+    def readline(self, size: Optional[int] = -1) -> bytes:  # type: ignore[override]
+        line = self.handle.readline(size)
+        self.progress.advance(self.task_id, len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:  # type: ignore[override]
+        lines = self.handle.readlines(hint)
+        self.progress.advance(self.task_id, sum(len(line) for line in lines))
+        return lines
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self.progress.update(self.task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def truncate(self, size: Optional[int] = None) -> int:
+        raise io.UnsupportedOperation("truncate")
+
+    def write(self, data: Any) -> int:  # type: ignore[override]
+        raise io.UnsupportedOperation("write")
+
+    def flush(self) -> None:
+        pass
+
