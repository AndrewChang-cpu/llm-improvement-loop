+    def read(
+        self,
+        file: Union[str, BinaryIO],
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> "_Reader":
+        """Read a binary file, updating a task as data is read.
+
+        Args:
+            file (Union[str, BinaryIO]): A path to a file, or a binary file-like object.
+            total (int, optional): Total number of bytes. Defaults to the size of the file at the given path.
+                Must be given when a file-like object is passed.
+            task_id (TaskID, optional): Task to update. Default is a new task.
+            description (str, optional): Description of task, if new task is created.
+
+        Returns:
+            _Reader: A reader that advances the task as it is read from.
+        """
+        close_handle = False
+        if isinstance(file, str):
+            if total is None:
+                total = os.stat(file).st_size
+            handle: BinaryIO = open(file, "rb")
+            close_handle = True
+        else:
+            if total is None:
+                raise ValueError("unable to get size of file, please specify 'total'")
+            handle = file
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        return _Reader(handle, self, task_id, close_handle=close_handle)
