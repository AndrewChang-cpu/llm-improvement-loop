+class _Reader:
+    """A file reader that updates a progress task as data is read from it.
+
+    This class is private. Use `Progress.read` to create one.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        close_handle: bool = True,
+    ) -> None:
+        self.handle = handle
+        self.progress = progress
+        self.task_id = task_id
+        self.close_handle = close_handle
+
+    def __enter__(self) -> "_Reader":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def __getattr__(self, name: str) -> Any:
+        if name == "handle":
+            raise AttributeError(name)
+        return getattr(self.handle, name)
+
+    def read(self, size: Optional[int] = -1) -> bytes:
+        block = self.handle.read(size)
+        self.progress.advance(self.task_id, len(block))
+        return block
+
+    def readline(self, size: Optional[int] = -1) -> bytes:
+        line = self.handle.readline(size)
+        self.progress.advance(self.task_id, len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self.progress.advance(self.task_id, sum(len(line) for line in lines))
+        return lines
+
+    def readinto(self, buffer: Any) -> int:
+        count = self.handle.readinto(buffer) or 0
+        self.progress.advance(self.task_id, count)
+        return count
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        position = self.handle.seek(offset, whence)
+        self.progress.update(self.task_id, completed=position)
+        return position
+
+    def close(self) -> None:
+        if self.close_handle:
+            self.handle.close()
+
