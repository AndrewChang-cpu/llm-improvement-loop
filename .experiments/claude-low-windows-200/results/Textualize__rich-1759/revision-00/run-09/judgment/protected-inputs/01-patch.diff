+class _Reader:
+    """A reader that wraps a binary file-like object and updates a progress task as it is read.
+
+    Instances are created with :meth:`Progress.read` or :func:`read`; this class is private.
+    Attributes not defined here are delegated to the wrapped file-like object.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: "TaskID",
+        close_handle: bool = False,
+        close_progress: bool = False,
+    ) -> None:
+        self.handle = handle
+        self.progress = progress
+        self.task_id = task_id
+        self._close_handle = close_handle
+        self._close_progress = close_progress
+        self._closed = False
+
+    def __getattr__(self, name: str) -> Any:
+        # Delegate anything not overridden here (name, mode, tell, fileno, ...) to the wrapped handle.
+        return getattr(self.handle, name)
+
+    def __enter__(self) -> "_Reader":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    @property
+    def closed(self) -> bool:  # type: ignore[override]
+        return self._closed or bool(getattr(self.handle, "closed", False))
+
+    def readable(self) -> bool:
+        return True
+
+    def seekable(self) -> bool:
+        return bool(self.handle.seekable())
+
+    def _advance(self, data: bytes) -> bytes:
+        if data:
+            self.progress.advance(self.task_id, len(data))
+        return data
+
+    def read(self, size: Optional[int] = -1) -> bytes:  # type: ignore[override]
+        """Read up to `size` bytes, advancing the progress by the number of bytes read."""
+        if size is None:
+            size = -1
+        return self._advance(self.handle.read(size))
+
+    def read1(self, size: int = -1) -> bytes:
+        """Read up to `size` bytes with at most one underlying read call."""
+        read1 = getattr(self.handle, "read1", self.handle.read)
+        return self._advance(read1(size))
+
+    def readline(self, size: Optional[int] = -1) -> bytes:  # type: ignore[override]
+        """Read a line, advancing the progress by the number of bytes read."""
+        if size is None:
+            size = -1
+        return self._advance(self.handle.readline(size))
+
+    def readinto(self, buffer: Any) -> int:
+        """Read into a writable buffer, advancing the progress by the number of bytes read."""
+        count = self.handle.readinto(buffer)
+        if count:
+            self.progress.advance(self.task_id, count)
+        return count
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the wrapped handle and move the progress position to match."""
+        position = self.handle.seek(offset, whence)
+        self.progress.update(self.task_id, completed=position)
+        return position
+
+    def close(self) -> None:
+        """Close the wrapped handle (if owned) and stop the progress (if owned)."""
+        if self._closed:
+            return
+        self._closed = True
+        if self._close_handle:
+            self.handle.close()
+        if self._close_progress:
+            self.progress.stop()
+
