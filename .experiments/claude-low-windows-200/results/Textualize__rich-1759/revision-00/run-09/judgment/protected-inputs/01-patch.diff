+    def read(
+        self,
+        file: Union[str, "PathLike[str]", BinaryIO],
+        total: Optional[int] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Track progress while reading from a file path or binary file-like object.
+
+        If a path is given, the total defaults to the file size. If a file-like object is given,
+        ``total`` must be specified. Closing the returned reader closes the file (if it was opened
+        here) but does not stop this Progress instance.
+
+        Args:
+            file (Union[str, PathLike, BinaryIO]): A file path, or a binary file-like object.
+            total (int, optional): Total number of bytes to be read. Defaults to the file size for paths.
+            description (str, optional): Description of task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A file-like object that updates the progress as it is read.
+        """
+        return cast("BinaryIO", self._open_reader(file, total, description))
+
+    def _open_reader(
+        self,
+        file: Union[str, "PathLike[str]", BinaryIO],
+        total: Optional[int],
+        description: str,
+        close_progress: bool = False,
+    ) -> "_Reader":
+        if isinstance(file, (str, PathLike)):
+            path = os.fspath(file)
+            if total is None:
+                total = os.stat(path).st_size
+            handle: BinaryIO = open(path, "rb")
+            close_handle = True
+        else:
+            if total is None:
+                raise ValueError("'total' must be specified when reading from a file-like object")
+            handle = file
+            close_handle = False
+        task_id = self.add_task(description, total=int(total))
+        return _Reader(
+            handle,
+            self,
+            task_id,
+            close_handle=close_handle,
+            close_progress=close_progress,
+        )
