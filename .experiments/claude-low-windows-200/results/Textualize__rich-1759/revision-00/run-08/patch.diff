+class _Reader:
+    """A reader wrapping a binary file object, which updates a progress task as it is read.
+
+    Instances are created with ``Progress.read`` or ``rich.progress.read``.
+    Any attribute not defined here is delegated to the wrapped file object.
+    """
+
+    def __init__(
+        self,
+        file: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        close_handle: bool = False,
+    ) -> None:
+        self.file = file
+        self.progress = progress
+        self.task_id = task_id
+        self.close_handle = close_handle
+        self.on_close: Optional[Callable[[], None]] = None
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self.file, name)
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def __enter__(self) -> "_Reader":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def _advance(self, size: int) -> None:
+        if size:
+            self.progress.advance(self.task_id, size)
+
+    def read(self, size: Optional[int] = -1) -> bytes:
+        chunk = self.file.read(size)
+        self._advance(len(chunk))
+        return chunk
+
+    def readall(self) -> bytes:
+        return self.read(-1)
+
+    def readinto(self, buffer: Any) -> int:
+        count = self.file.readinto(buffer)
+        self._advance(count or 0)
+        return count
+
+    def readline(self, size: Optional[int] = -1) -> bytes:
+        line = self.file.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.file.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        position = self.file.seek(offset, whence)
+        self.progress.update(self.task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.file.tell()
+
+    def close(self) -> None:
+        if self.close_handle:
+            self.file.close()
+        if self.on_close is not None:
+            on_close, self.on_close = self.on_close, None
+            on_close()
+
+    @property
+    def closed(self) -> bool:
+        return self.file.closed
+
+    def readable(self) -> bool:
+        return self.file.readable()
+
+    def seekable(self) -> bool:
+        return self.file.seekable()
+
+    def fileno(self) -> int:
+        return self.file.fileno()
+
+    def isatty(self) -> bool:
+        return self.file.isatty()
+
