+    def read(
+        self,
+        file: Union[str, "os.PathLike[str]", BinaryIO],
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+        update_period: float = 0.1,
+    ) -> "_Reader":
+        """Track progress while reading from a binary file.
+
+        Args:
+            file (Union[str, PathLike, BinaryIO]): A path, or a binary file-like object to read from.
+            total (int, optional): Total number of bytes to read. Required when ``file`` is a file-like
+                object. Defaults to the size of the file at the given path.
+            task_id (TaskID, optional): Task to update. Default is a new task.
+            description (str, optional): Description of task, if new task is created.
+            update_period (float, optional): Minimum time (in seconds) between calls to update(). Defaults to 0.1.
+
+        Returns:
+            _Reader: A binary reader which advances the progress as it is read.
+        """
+        close_handle = False
+        if isinstance(file, (str, os.PathLike)):
+            if total is None:
+                total = os.stat(file).st_size
+            handle: BinaryIO = open(file, "rb")
+            close_handle = True
+        else:
+            if total is None:
+                raise ValueError(
+                    f"unable to get size of {file!r}, please specify 'total'"
+                )
+            handle = file
+
+        if task_id is None:
+            task_id = self.add_task(description, total=float(total))
+        else:
+            self.update(task_id, total=float(total))
+
+        self.update(task_id, completed=handle.tell())
+        return _Reader(handle, self, task_id, close_handle=close_handle)
+
