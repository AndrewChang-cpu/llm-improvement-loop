+def test_progress_read_bytes_from_file_object() -> None:
+    progress = Progress(auto_refresh=False, disable=True)
+    file = io.BytesIO(b"0123456789")
+    with progress:
+        reader = progress.read(file, total=10)
+        assert reader.read(4) == b"0123"
+        assert progress.tasks[0].completed == 4
+        assert reader.read() == b"456789"
+        assert progress.tasks[0].completed == 10
+    assert progress.tasks[0].total == 10
+
+
+def test_progress_read_seek_updates_completed() -> None:
+    progress = Progress(auto_refresh=False, disable=True)
+    file = io.BytesIO(b"0123456789")
+    with progress:
+        reader = progress.read(file, total=10)
+        reader.read(6)
+        reader.seek(2)
+        assert progress.tasks[0].completed == 2
+        assert reader.read(3) == b"234"
+        assert progress.tasks[0].completed == 5
+
+
+def test_progress_read_file_object_requires_total() -> None:
+    progress = Progress(auto_refresh=False, disable=True)
+    with pytest.raises(ValueError):
+        progress.read(io.BytesIO(b"abc"))
+
+
+def test_progress_read_path(tmp_path) -> None:
+    path = tmp_path / "data.bin"
+    path.write_bytes(b"hello world")
+    progress = Progress(auto_refresh=False, disable=True)
+    with progress:
+        with progress.read(str(path)) as reader:
+            assert reader.read() == b"hello world"
+        assert progress.tasks[0].total == 11
+        assert progress.tasks[0].completed == 11
+
+
+def test_read_wrapper_closes_progress(tmp_path) -> None:
+    path = tmp_path / "data.bin"
+    path.write_bytes(b"abc")
+    with read(str(path), disable=True) as reader:
+        assert reader.read() == b"abc"
+
