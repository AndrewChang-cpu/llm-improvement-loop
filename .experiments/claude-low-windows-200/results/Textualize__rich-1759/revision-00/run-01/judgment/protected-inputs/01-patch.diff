+    def read(
+        self,
+        file: Union[str, "os.PathLike[str]", IO[bytes]],
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> _Reader:
+        """Track progress while reading from a binary file.
+
+        Args:
+            file (Union[str, PathLike, IO[bytes]]): A path, or a binary file-like object to read from.
+                A path is opened (and closed by the reader); a file-like object is left open.
+            total (int, optional): Total number of bytes to read. Defaults to the size of the file
+                at ``file`` if it is a path. Required when ``file`` is a file-like object.
+            task_id (TaskID, optional): Task to track. Default is a new task.
+            description (str, optional): Description of task, if a new task is created.
+
+        Returns:
+            _Reader: A file-like object which advances the progress as it is read.
+        """
+        close_handle = False
+        if isinstance(file, (str, os.PathLike)):
+            if total is None:
+                total = os.stat(file).st_size
+            handle: IO[bytes] = open(file, "rb")
+            close_handle = True
+        else:
+            if total is None:
+                raise ValueError("'total' must be specified when reading a file-like object")
+            handle = file
+
+        if task_id is None:
+            task_id = self.add_task(description, total=float(total))
+        else:
+            self.update(task_id, total=float(total))
+
+        return _Reader(handle, self, task_id, close_handle=close_handle)
