+def test_progress_read_path(tmp_path):
+    from rich.progress import read
+
+    path = tmp_path / "data.bin"
+    path.write_bytes(b"x" * 100)
+    progress = Progress(disable=True)
+    with progress:
+        reader = progress.read(str(path))
+        assert reader.read(40) == b"x" * 40
+        assert progress.tasks[0].completed == 40
+        assert progress.tasks[0].total == 100
+        reader.seek(10)
+        assert progress.tasks[0].completed == 10
+        assert reader.read() == b"x" * 90
+        assert progress.tasks[0].completed == 100
+        reader.close()
+    assert reader.closed
+
+    with read(str(path), disable=True) as f:
+        assert f.read() == b"x" * 100
+
+
+def test_progress_read_file_object_requires_total():
+    progress = Progress(disable=True)
+    with pytest.raises(ValueError):
+        progress.read(io.BytesIO(b"abc"))
+    with progress:
+        reader = progress.read(io.BytesIO(b"abc"), total=3)
+        assert list(reader) == [b"abc"]
+        assert progress.tasks[0].completed == 3
+
