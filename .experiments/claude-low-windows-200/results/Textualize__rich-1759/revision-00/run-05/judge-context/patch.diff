+def _chain_close(
+    first: Optional[Callable[[], None]], second: Callable[[], None]
+) -> Callable[[], None]:
+    """Combine two optional close callbacks into one."""
+
+    def _close() -> None:
+        if first is not None:
+            first()
+        second()
+
+    return _close
