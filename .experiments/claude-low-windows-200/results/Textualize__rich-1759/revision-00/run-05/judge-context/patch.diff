+class _Reader:
+    """A file-like wrapper that updates a progress task as data is read.
+
+    This class is private; use ``Progress.read`` or ``rich.progress.read`` to create one.
+    Any attribute not defined here is delegated to the wrapped file object.
+    """
+
+    def __init__(
+        self,
+        handle: IO[bytes],
+        progress: "Progress",
+        task_id: TaskID,
+        close_handle: bool = True,
+        on_close: Optional[Callable[[], None]] = None,
+    ) -> None:
+        self.handle = handle
+        self.progress = progress
+        self.task_id = task_id
+        self.close_handle = close_handle
+        self._on_close = on_close
+        self._closed = False
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self.handle, name)
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def __enter__(self) -> "_Reader":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    @property
+    def closed(self) -> bool:
+        return self._closed or self.handle.closed
+
+    def read(self, size: Optional[int] = -1) -> bytes:
+        chunk = self.handle.read(size)
+        self.progress.advance(self.task_id, len(chunk))
+        return chunk
+
+    def readline(self, size: Optional[int] = -1) -> bytes:
+        line = self.handle.readline(size)
+        self.progress.advance(self.task_id, len(line))
+        return line
+
+    def readinto(self, buffer: Any) -> int:
+        count = self.handle.readinto(buffer)
+        if count:
+            self.progress.advance(self.task_id, count)
+        return count
+
+    def seek(self, offset: int, whence: int = os.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self.progress.update(self.task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        try:
+            if self.close_handle:
+                self.handle.close()
+        finally:
+            if self._on_close is not None:
+                self._on_close()
+
