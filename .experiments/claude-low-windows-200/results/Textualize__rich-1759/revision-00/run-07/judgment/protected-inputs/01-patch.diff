+class _Reader(Generic[BinaryIOType]):
+    """A reader that updates a progress task as data is read from a file.
+
+    Instances are created with `Progress.read`. This class is private.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIOType,
+        progress: "Progress",
+        task_id: "TaskID",
+    ) -> None:
+        self.handle = handle
+        self.progress = progress
+        self.task_id = task_id
+
+    def __enter__(self) -> "_Reader[BinaryIOType]":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self.handle, name)
+
+    def _advance(self, size: int) -> None:
+        if size:
+            self.progress.advance(self.task_id, size)
+
+    def read(self, size: Optional[int] = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the progress accordingly."""
+        data = self.handle.read(-1 if size is None else size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: Optional[int] = -1) -> bytes:
+        """Read a line and advance the progress accordingly."""
+        data = self.handle.readline(-1 if size is None else size)
+        self._advance(len(data))
+        return data
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all lines and advance the progress accordingly."""
+        lines: List[bytes] = []
+        total_read = 0
+        while True:
+            line = self.readline()
+            if not line:
+                break
+            lines.append(line)
+            total_read += len(line)
+            if 0 < hint <= total_read:
+                break
+        return lines
+
+    def readinto(self, buffer: Any) -> int:
+        """Read into a buffer and advance the progress accordingly."""
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._advance(count or 0)
+        return count
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        """Seek the underlying file and set the progress position to match."""
+        position = self.handle.seek(offset, whence)
+        with self.progress._lock:
+            self.progress._tasks[self.task_id].completed = position
+        self.progress.refresh()
+        return position
+
+    def close(self) -> None:
+        """Close the underlying file."""
+        self.handle.close()
+
