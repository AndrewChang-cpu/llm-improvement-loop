+def test_progress_read_file_object() -> None:
+    progress = Progress()
+    data = b"x" * 100
+    with progress:
+        reader = progress.read(io.BytesIO(data), total=len(data))
+        assert reader.read(40) == data[:40]
+        task = progress.tasks[0]
+        assert task.completed == 40
+        assert task.total == 100
+        assert reader.read() == data[40:]
+        assert progress.tasks[0].completed == 100
+
+
+def test_progress_read_requires_total_for_file_object() -> None:
+    progress = Progress()
+    with pytest.raises(ValueError):
+        progress.read(io.BytesIO(b"abc"))
+
+
+def test_progress_read_seek_updates_position() -> None:
+    progress = Progress()
+    data = b"0123456789"
+    with progress:
+        reader = progress.read(io.BytesIO(data), total=len(data))
+        reader.read(2)
+        reader.seek(7)
+        assert progress.tasks[0].completed == 7
+        assert reader.read(3) == b"789"
+        assert progress.tasks[0].completed == 10
+
+
+def test_progress_read_path(tmp_path) -> None:
+    path = tmp_path / "data.bin"
+    path.write_bytes(b"hello world")
+    progress = Progress()
+    with progress:
+        with progress.read(str(path)) as f:
+            assert progress.tasks[0].total == 11
+            assert f.read() == b"hello world"
+        assert progress.tasks[0].completed == 11
+
+
+def test_module_read_context_manager(tmp_path) -> None:
+    from rich.progress import read
+
+    path = tmp_path / "data.bin"
+    path.write_bytes(b"abcdef")
+    with read(str(path), disable=True) as f:
+        assert f.read() == b"abcdef"
+
