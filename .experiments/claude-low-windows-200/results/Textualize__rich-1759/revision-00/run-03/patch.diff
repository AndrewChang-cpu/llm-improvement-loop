+class _Reader(BinaryIO):
+    """A reader that updates a progress task with the number of bytes read.
+
+    Do not instantiate directly, use `Progress.read` or `rich.progress.read` instead.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: "TaskID",
+        close_handle: bool = True,
+    ) -> None:
+        self.handle = handle
+        self.progress = progress
+        self.task_id = task_id
+        self.close_handle = close_handle
+        self._closed = False
+
+    def __enter__(self) -> "_Reader":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def __getattr__(self, name: str) -> Any:
+        # Delegate anything not explicitly handled to the wrapped file object
+        return getattr(self.handle, name)
+
+    @property
+    def closed(self) -> bool:  # type: ignore[override]
+        return self._closed
+
+    @property
+    def mode(self) -> str:
+        return self.handle.mode
+
+    @property
+    def name(self) -> Any:
+        return self.handle.name
+
+    def _advance(self, size: int) -> None:
+        if size:
+            self.progress.advance(self.task_id, size)
+
+    def read(self, size: Optional[int] = -1) -> bytes:  # type: ignore[override]
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def read1(self, size: int = -1) -> bytes:
+        data = self.handle.read1(size)  # type: ignore[attr-defined]
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: Optional[int] = -1) -> bytes:  # type: ignore[override]
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:  # type: ignore[override]
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def seek(self, offset: int, whence: int = os.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self.progress.update(self.task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def flush(self) -> None:
+        self.handle.flush()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return self.handle.writable()
+
+    def truncate(self, size: Optional[int] = None) -> int:
+        return self.handle.truncate(size)
+
+    def write(self, data: Any) -> int:  # type: ignore[override]
+        return self.handle.write(data)
+
+    def writelines(self, lines: Iterable[Any]) -> None:  # type: ignore[override]
+        self.handle.writelines(lines)
+
+    def close(self) -> None:
+        if not self._closed:
+            self._closed = True
+            if self.close_handle:
+                self.handle.close()
