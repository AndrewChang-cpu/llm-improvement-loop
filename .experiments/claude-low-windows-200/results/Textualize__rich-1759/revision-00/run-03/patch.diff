+    def read(
+        self,
+        file: Union[str, "os.PathLike[str]", BinaryIO],
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Track progress while reading from a binary file.
+
+        Args:
+            file (Union[str, PathLike, BinaryIO]): A path, or a binary file-like object to read from.
+                A file opened from a path is closed when the returned reader is closed.
+            total (int, optional): Total number of bytes to read. Defaults to the size of the file
+                at the given path. Must be specified when passing a file-like object.
+            task_id (TaskID, optional): Task to track. Default is new task.
+            description (str, optional): Description of task, if new task is created.
+
+        Returns:
+            BinaryIO: A file reader that updates the progress as it is read from.
+        """
+        close_handle = False
+        if isinstance(file, (str, os.PathLike)):
+            if total is None:
+                total = os.stat(file).st_size
+            handle: BinaryIO = open(file, "rb")
+            close_handle = True
+        else:
+            if total is None:
+                raise ValueError(
+                    f"unable to get size of {file!r}, please specify 'total'"
+                )
+            handle = file
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        return _Reader(handle, self, task_id, close_handle=close_handle)
