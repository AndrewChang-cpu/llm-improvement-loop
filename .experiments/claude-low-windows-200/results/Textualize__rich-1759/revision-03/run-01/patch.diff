+        """Open a file for reading, advancing a task as bytes are consumed.
+
+        The Progress display is not started by this method.
+
+        Args:
+            file (str | os.PathLike | bytes): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, or a binary mode such as 'rb'. Defaults to 'r'.
+            buffering (int, optional): Buffering policy for the file. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Text error handling, used in text mode only.
+            newline (str, optional): Text newline handling, used in text mode only.
+            total (int, optional): Size of the file in bytes. Defaults to the file size.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in text mode.
+            OSError: If the file size cannot be read, for example when the file is missing.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        is_text = mode in ("r", "rt")
+        line_buffering = False
+        handle_buffering = buffering
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            line_buffering = buffering == 1
+            if line_buffering:
+                handle_buffering = -1
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode, "
+                "the default buffer size is used",
+                RuntimeWarning,
+                stacklevel=2,
+            )
+            handle_buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering=handle_buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if not is_text:
+            return reader
+        try:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        except BaseException:
+            reader.close()
+            raise
