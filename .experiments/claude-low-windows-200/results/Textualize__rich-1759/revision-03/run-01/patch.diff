+        OSError: If the file size cannot be read, for example when the file is missing.
+    """
+    progress = _make_reader_progress(
+        description,
+        auto_refresh,
+        console,
+        transient,
+        get_time,
+        refresh_per_second,
+        style,
+        complete_style,
+        finished_style,
+        pulse_style,
