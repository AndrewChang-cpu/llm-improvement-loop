+def _make_temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
+    return path
+
+
+def _make_console() -> Console:
+    return Console(file=io.StringIO(), force_terminal=True, width=80)
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        with rich_progress.open(path, console=_make_console()) as reader:
+            assert reader.read() == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        with rich_progress.open(path, "r", console=_make_console()) as reader:
+            assert reader.read() == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_returns_bytes() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        with rich_progress.open(path, "rb", console=_make_console()) as reader:
+            assert reader.read() == b"hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    path = _make_temp_file(b"caller owned")
+    try:
+        with open(path, "rb") as source:
+            with rich_progress.wrap_file(source, 12, console=_make_console()) as reader:
+                assert reader.read() == b"caller owned"
+            assert reader.closed
+            assert not source.closed
+        assert source.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_defaults_total_to_file_size() -> None:
+    path = _make_temp_file(b"0123456789")
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with progress.open(path, "rb") as reader:
+            assert progress.tasks[0].total == 10
+            assert reader.read() == b"0123456789"
+        assert progress.tasks[0].completed == 10
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    progress = Progress(console=_make_console(), disable=True)
+    task_id = progress.add_task("reading", total=5.5)
+    reader = progress.wrap_file(io.BytesIO(b"abcde"), task_id=task_id)
+    assert reader.read() == b"abcde"
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total == 5.5
+    assert progress.tasks[0].completed == 5
+
+
+def test_missing_path_without_total_raises_file_not_found() -> None:
+    directory = tempfile.mkdtemp()
+    path = os.path.join(directory, "missing.bin")
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with pytest.raises(FileNotFoundError):
+            rich_progress.open(path, console=_make_console())
+        with pytest.raises(FileNotFoundError):
+            progress.open(path)
+        assert progress.tasks == []
+    finally:
+        os.rmdir(directory)
+
+
+def test_progress_wrap_file_task_without_total_raises() -> None:
+    progress = Progress(console=_make_console(), disable=True)
+    task_id = progress.add_task("reading", total=None)
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"), task_id=task_id)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+    assert not progress.live.is_started
+
+
+def test_read_paths_advance_completed() -> None:
+    progress = Progress(console=_make_console(), disable=True)
+    data = b"abcdefghij\nklm\nnop"
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert reader.read(4) == b"abcd"
+    assert progress.tasks[0].completed == 4
+    assert reader.readline() == b"efghij\n"
+    assert progress.tasks[0].completed == 11
+    buffer = bytearray(2)
+    assert reader.readinto(buffer) == 2
+    assert buffer == b"kl"
+    assert progress.tasks[0].completed == 13
+    assert reader.readlines() == [b"m\n", b"nop"]
+    assert progress.tasks[0].completed == 18
+
+
+def test_iteration_advances_completed() -> None:
+    progress = Progress(console=_make_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(b"one\ntwo\n"), total=8)
+    assert list(reader) == [b"one\n", b"two\n"]
+    assert progress.tasks[0].completed == 8
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    progress = Progress(console=_make_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(b"abcdef"), total=6)
+    assert reader.seek(3) == 3
+    assert progress.tasks[0].completed == 3
+    assert reader.tell() == 3
+
+
+def test_write_raises_unsupported_operation() -> None:
+    progress = Progress(console=_make_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(b"abc"), total=3)
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+
+
+def test_invalid_mode_raises_before_task_is_created() -> None:
+    progress = Progress(console=_make_console(), disable=True)
+    with pytest.raises(ValueError, match="'w'"):
+        progress.open("missing.txt", "w")
+    assert progress.tasks == []
+
+
+def test_text_mode_unbuffered_raises_value_error() -> None:
+    path = _make_temp_file(b"data")
+    try:
+        with pytest.raises(ValueError):
+            rich_progress.open(path, "r", buffering=0, console=_make_console())
+    finally:
+        os.remove(path)
+
+
+def test_binary_mode_buffering_one_warns_and_reads() -> None:
+    path = _make_temp_file(b"data")
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        with reader:
+            assert reader.read() == b"data"
+    finally:
+        os.remove(path)
+
+
+def test_text_mode_passes_buffering_to_handle(monkeypatch) -> None:
+    seen = []
+    real_open = io.open
+
+    def fake_open(file, mode="r", buffering=-1, *args, **kwargs):
+        seen.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", fake_open)
+    path = _make_temp_file(b"data")
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with progress.open(path, "r", buffering=2) as text:
+            assert text.read() == "data"
+        assert seen == [2]
+    finally:
+        os.remove(path)
+
