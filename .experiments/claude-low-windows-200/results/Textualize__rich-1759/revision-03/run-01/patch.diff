+class _ReaderContext(Generic[_StreamT]):
+    """Context manager that runs a Progress display around a reader.
+
+    The display starts on enter and stops on exit, before the stream is exited.
+
+    Args:
+        progress (Progress): The Progress whose display is started and stopped.
+        stream (IO[Any]): The object yielded on enter: a reader, or a text
+            wrapper around one.
+    """
+
+    def __init__(self, progress: "Progress", stream: _StreamT) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> _StreamT:
+        self._progress.start()
+        try:
+            self._stream.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._stream
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._stream.__exit__(exc_type, exc_val, exc_tb)
+
