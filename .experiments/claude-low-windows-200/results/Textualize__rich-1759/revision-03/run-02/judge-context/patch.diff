+        """Open a file for reading, advancing a task by the bytes consumed.
+
+        The Progress display is not started by this method.
+
+        Args:
+            file (str | bytes | PathLike): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' or 'br' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy passed to the byte handle. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Text error handling, used in text mode only.
+            newline (str, optional): Text newline handling, used in text mode only.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Raises:
+            ValueError: If the mode is invalid, or text mode is used with buffering 0.
+            OSError: If the file size cannot be determined or the file cannot be opened.
+
+        Returns:
+            IO[Any]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt', 'rb' or 'br'")
+
+        is_text = mode in ("r", "rt")
+        line_buffering = False
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode; "
+                "the default buffer size is used",
+                RuntimeWarning,
+            )
+            buffering = -1
+
+        if total is None:
