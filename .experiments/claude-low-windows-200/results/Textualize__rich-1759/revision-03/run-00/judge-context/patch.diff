+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and attach it to a progress task.
+
+        The display is not started by this method.
+
+        Args:
+            file (Union[str, PathLike, bytes]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, passed to the file open. Defaults to -1.
+            encoding (str, optional): Text encoding for text mode.
+            errors (str, optional): Error handling for text mode.
+            newline (str, optional): Newline handling for text mode.
+            total (int, optional): Total number of bytes. Defaults to the file size.
+            task_id (TaskID, optional): Existing task to update. Default creates a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in text mode.
+            OSError: If the file size cannot be read or the file cannot be opened.
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+        """
+        if "".join(sorted(mode)) not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+        is_text = mode in ("r", "rt")
+        line_buffering = False
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+        elif buffering == 1:
