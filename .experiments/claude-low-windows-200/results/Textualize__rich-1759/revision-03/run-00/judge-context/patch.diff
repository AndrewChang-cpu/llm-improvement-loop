+class _BinaryReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Instances are created by ``Progress.open`` and ``Progress.wrap_file``.
+
+    Args:
+        handle (BinaryIO): The binary handle being read.
+        progress (Progress): The Progress that owns the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if the reader should close ``handle`` on close.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    @property
+    def mode(self) -> str:
+        """str: The mode of the wrapped handle."""
+        return self.handle.mode
+
+    @property
+    def name(self) -> str:
+        """str: The name of the wrapped handle."""
+        return self.handle.name
+
+    def _advance(self, size: int) -> None:
+        if size:
+            self._progress.advance(self._task_id, size)
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the amount read."""
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read one line and advance the task by its length."""
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        """Read into ``buffer`` and advance the task by the count returned."""
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._advance(count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all lines and advance the task by their total length."""
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_BinaryReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.handle.readline()
+        if not line:
+            raise StopIteration
+        self._advance(len(line))
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle and set the task's completed value to the new position."""
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the handle's current position."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def write(self, data: Any) -> None:
+        raise io.UnsupportedOperation("write")
+
+    def close(self) -> None:
+        """Close the handle if this reader owns it, and mark the reader closed."""
+        try:
+            if self._owns_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+
+    def __enter__(self) -> "_BinaryReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+_ReaderT = TypeVar("_ReaderT", bound=IO[Any])
+
+
+class _ReaderContext(Generic[_ReaderT]):
+    """Context manager that starts a Progress and enters a reader.
+
+    Args:
+        progress (Progress): The Progress to start and stop.
+        reader (IO[Any]): The reader to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: _ReaderT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
+def _file_progress(
