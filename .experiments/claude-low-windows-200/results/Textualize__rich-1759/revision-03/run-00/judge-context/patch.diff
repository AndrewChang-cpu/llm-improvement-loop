+FILE_CONTENT = b"line one\nline two\nline three\n"
+
+
+def _file_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _temp_path(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as file:
+        file.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        with rich_open(path, console=_file_console(), auto_refresh=False) as file:
+            assert file.read() == FILE_CONTENT.decode()
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_mode_reads_text() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        with rich_open(
+            path, "r", console=_file_console(), auto_refresh=False
+        ) as file:
+            assert file.read() == FILE_CONTENT.decode()
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_rb_mode_returns_bytes() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        with rich_open(path, "rb", console=_file_console(), auto_refresh=False) as file:
+            assert file.read() == FILE_CONTENT
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        with open(path, "rb") as raw:
+            with rich_wrap_file(
+                raw, len(FILE_CONTENT), console=_file_console(), auto_refresh=False
+            ) as reader:
+                assert reader.read() == FILE_CONTENT
+            assert reader.closed
+            assert not raw.closed
+        assert raw.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_path_sets_total_to_file_size() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        progress = Progress(console=_file_console(), auto_refresh=False)
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(FILE_CONTENT)
+            assert not progress.live._started
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_missing_path_with_no_total_raises_file_not_found() -> None:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    with pytest.raises(FileNotFoundError):
+        rich_open(path, console=_file_console(), auto_refresh=False)
+    with pytest.raises(FileNotFoundError):
+        progress.open(path, "rb")
+    assert progress.tasks == []
+
+
+def test_progress_wrap_file_reuses_existing_task_total() -> None:
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=6.5)
+    reader = progress.wrap_file(io.BytesIO(b"abcdef"), task_id=task_id)
+    assert reader.read() == b"abcdef"
+    assert progress.tasks[0].total == 6.5
+    assert progress.tasks[0].completed == 6
+
+
+def test_progress_wrap_file_task_without_total_raises() -> None:
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=None)
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"), task_id=task_id)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+
+
+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        progress = Progress(console=_file_console(), auto_refresh=False)
+        reader = progress.open(path, "rb")
+        try:
+            assert reader.readline() == b"line one\n"
+            assert progress.tasks[0].completed == 9
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert progress.tasks[0].completed == 13
+            assert reader.readlines() == [b" two\n", b"line three\n"]
+            assert progress.tasks[0].completed == len(FILE_CONTENT)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_iteration_advances_completed_by_line_lengths() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        progress = Progress(console=_file_console(), auto_refresh=False)
+        reader = progress.open(path, "rb")
+        try:
+            lines = list(reader)
+            assert lines == FILE_CONTENT.splitlines(keepends=True)
+            assert progress.tasks[0].completed == len(FILE_CONTENT)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(FILE_CONTENT), len(FILE_CONTENT))
+    assert reader.seek(5) == 5
+    assert progress.tasks[0].completed == 5
+    assert reader.tell() == 5
+
+
+def test_write_raises_unsupported_operation() -> None:
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(FILE_CONTENT), len(FILE_CONTENT))
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+
+
+def test_invalid_mode_raises_value_error() -> None:
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    with pytest.raises(ValueError, match="'wb'"):
+        progress.open("missing.txt", "wb")
+    assert progress.tasks == []
+
+
+def test_text_mode_with_buffering_zero_raises_value_error() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        with pytest.raises(ValueError):
+            rich_open(path, "r", buffering=0, console=_file_console())
+    finally:
+        os.remove(path)
+
+
+def test_binary_mode_buffering_one_warns_and_reads() -> None:
+    path = _temp_path(FILE_CONTENT)
+    try:
+        progress = Progress(console=_file_console(), auto_refresh=False)
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        try:
+            assert reader.read() == FILE_CONTENT
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_text_mode_forwards_buffering_greater_than_one(monkeypatch) -> None:
+    path = _temp_path(FILE_CONTENT)
+    calls = []
+    real_open = io.open
+
+    def spy_open(*args, **kwargs):
+        calls.append(args)
+        return real_open(*args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy_open)
+    try:
+        progress = Progress(console=_file_console(), auto_refresh=False)
+        reader = progress.open(path, "r", buffering=4096)
+        try:
+            assert calls[-1][2] == 4096
+            assert reader.read() == FILE_CONTENT.decode()
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
