+        """Wrap an open binary file and attach it to a progress task.
+
+        The wrapped file is not closed by the returned reader.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Total number of bytes. If omitted, the total of ``task_id`` is used.
+            task_id (TaskID, optional): Existing task to update. Default creates a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+
+        Returns:
+            BinaryIO: A binary reader that advances the task as bytes are read.
+        """
+        resolved: Optional[float] = total
+        if resolved is None and task_id is not None:
+            with self._lock:
+                resolved = self._tasks[task_id].total
+        if resolved is None:
+            raise ValueError("total must be specified, or the task must have a total")
