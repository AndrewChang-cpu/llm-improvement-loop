+    style: StyleType,
+    complete_style: StyleType,
+    finished_style: StyleType,
+    pulse_style: StyleType,
+    disable: bool,
+) -> "Progress":
+    """Build a Progress with the byte-oriented columns used by file readers."""
+    columns: List["ProgressColumn"] = (
