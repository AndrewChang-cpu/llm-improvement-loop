+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    content = b"line one\nline two\nline three\n"
+    progress = Progress(console=_quiet_console(), auto_refresh=False)
+    task_id = progress.add_task("read", total=len(content))
+    reader = progress.wrap_file(io.BytesIO(content), task_id=task_id)
+
+    assert reader.read(4) == b"line"
+    assert progress.tasks[0].completed == 4
+    assert reader.readline() == b" one\n"
+    assert progress.tasks[0].completed == 9
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"line"
+    assert progress.tasks[0].completed == 13
+    assert reader.readlines() == [b" two\n", b"line three\n"]
+    assert progress.tasks[0].completed == len(content)
+
