+def test_text_mode_forwards_buffering_to_byte_handle(monkeypatch) -> None:
+    real_open = io.open
+    buffering_values = []
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        buffering_values.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    path = _make_temp_file(b"text")
+    try:
+        progress = Progress(console=_quiet_console(), auto_refresh=False)
+        with progress.open(path, "r", buffering=4096) as reader:
+            assert reader.read() == "text"
+        assert buffering_values == [4096]
+    finally:
+        os.remove(path)
+
