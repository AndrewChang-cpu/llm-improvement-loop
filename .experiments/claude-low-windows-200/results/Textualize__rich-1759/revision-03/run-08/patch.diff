+def test_module_open_default_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello\nworld\n")
+    try:
+        console = _quiet_console()
+        with progress_open(path, console=console, auto_refresh=False) as reader:
+            content = reader.read()
+        assert content == "hello\nworld\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
