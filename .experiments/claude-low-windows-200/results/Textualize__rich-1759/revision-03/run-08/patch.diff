+def open(
+    file: _PathInput,
+    mode: str = "r",
+    buffering: int = -1,
+    encoding: Optional[str] = None,
+    errors: Optional[str] = None,
+    newline: Optional[str] = None,
+    *,
+    total: Optional[int] = None,
+    description: str = "Reading...",
+    auto_refresh: bool = True,
+    console: Optional[Console] = None,
+    transient: bool = False,
+    get_time: Optional[Callable[[], float]] = None,
+    refresh_per_second: float = 10,
+    style: StyleType = "bar.back",
+    complete_style: StyleType = "bar.complete",
+    finished_style: StyleType = "bar.finished",
+    pulse_style: StyleType = "bar.pulse",
+    disable: bool = False,
+) -> ContextManager[Union[TextIO, BinaryIO]]:
+    """Read a file while displaying a progress bar of the bytes consumed.
+
+    The default mode is text ('r'). Use 'rb' to read bytes.
+
+    Args:
+        file (str | PathLike | bytes): Path of the file to open.
+        mode (str, optional): File mode, 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+        buffering (int, optional): Buffering policy, passed to the byte handle. Defaults to -1.
+        encoding (str, optional): Text encoding, used in text mode only.
+        errors (str, optional): Error handling for text decoding, used in text mode only.
+        newline (str, optional): Newline handling, used in text mode only.
+        total (int, optional): Total count of bytes. Defaults to the size of the file.
+        description (str, optional): Description shown next to the bar. Defaults to "Reading...".
+        auto_refresh (bool, optional): Enable automatic refresh. Defaults to True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time. Defaults to None.
+        refresh_per_second (float, optional): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress. Defaults to False.
+
+    Returns:
+        ContextManager: A context manager that yields a text reader for 'r' and 'rt', and a binary reader otherwise.
+
+    Raises:
+        ValueError: If the mode or buffering is invalid.
+        OSError: If the file cannot be sized or opened.
+    """
+    progress = _make_file_progress(
+        description,
+        auto_refresh,
+        console,
+        transient,
+        get_time,
+        refresh_per_second,
+        style,
+        complete_style,
+        finished_style,
+        pulse_style,
+        disable,
+    )
+    stream = progress.open(
+        file,
+        mode,
+        buffering,
+        encoding,
+        errors,
+        newline,
+        total=total,
+        description=description,
+    )
+    return _ProgressContext(progress, stream)  # type: ignore[return-value, type-var]
+
