+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file and attach it to a task so that reading advances the task.
+
+        The Progress is not started by this method.
+
+        Args:
+            file (str | PathLike | bytes): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, passed to the byte handle. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Error handling for text decoding, used in text mode only.
+            newline (str, optional): Newline handling, used in text mode only.
+            total (int, optional): Total count of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): An existing task to update. If None, a new task is added.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode or buffering is invalid.
+            OSError: If the file cannot be sized or opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode: {mode!r}")
+        text_mode = mode in ("r", "rt")
+
+        line_buffering = False
+        if text_mode:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode; "
+                "the default buffer size is used",
+                RuntimeWarning,
+                stacklevel=2,
+            )
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if text_mode:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
