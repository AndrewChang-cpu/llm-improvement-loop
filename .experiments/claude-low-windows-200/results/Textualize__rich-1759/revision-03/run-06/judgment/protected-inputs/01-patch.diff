+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+
+    returned = 0
+    line = reader.readline()
+    returned += len(line)
+    buffer = bytearray(4)
+    returned += reader.readinto(buffer)
+    chunk = reader.read(3)
+    returned += len(chunk)
+    rest = reader.readlines()
+    returned += sum(len(item) for item in rest)
+
+    assert progress.tasks[0].completed == returned == len(data)
+    reader.close()
+
