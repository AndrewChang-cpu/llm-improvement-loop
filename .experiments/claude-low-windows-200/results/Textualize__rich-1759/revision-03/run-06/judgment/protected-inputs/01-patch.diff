+    def open(
+        self,
+        file: _FileSource,
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task by the bytes consumed.
+
+        The task is not started by this method. Use the Progress context or
+        ``start`` to display it.
+
+        Args:
+            file (str | bytes | os.PathLike): Path of the file to open.
+            mode (str, optional): 'r' and 'rt' return a text wrapper; 'rb' and 'br' return a binary reader. Defaults to 'r'.
+            buffering (int, optional): Buffering policy passed to the file open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only. Defaults to None.
+            errors (str, optional): Text error handling, used in text mode only. Defaults to None.
+            newline (str, optional): Text newline handling, used in text mode only. Defaults to None.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): An existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in text mode.
+            OSError: If the file size cannot be read or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode: {mode!r}")
+        is_text = mode in ("r", "rt")
+
+        line_buffering = False
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering (buffering=1) isn't supported in binary mode, "
+                "the default buffer size will be used",
+                RuntimeWarning,
+                stacklevel=2,
+            )
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering=buffering)
+        reader = _ProgressFileReader(handle, self, task_id, owns_handle=True)
+        if is_text:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file, advancing a task by the bytes consumed.
+
+        The wrapped file is not closed when the reader is closed. The task is
+        not started by this method.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Total number of bytes. Defaults to the total of ``task_id``.
+            task_id (TaskID, optional): An existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that wraps ``file``.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified, or the task must have a total, "
+                "to wrap a file-like object"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _ProgressFileReader(file, self, task_id, owns_handle=False)
