+def test_text_mode_buffering_greater_than_one_is_forwarded(monkeypatch) -> None:
+    real_open = io.open
+    seen_buffering = []
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        seen_buffering.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    content = b"forwarded"
+    path = _write_temp_file(content)
+    try:
+        monkeypatch.setattr(io, "open", recording_open)
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        with progress.open(path, "r", buffering=4096) as text_reader:
+            assert text_reader.read() == content.decode()
+        assert seen_buffering == [4096]
+    finally:
+        os.remove(path)
+
