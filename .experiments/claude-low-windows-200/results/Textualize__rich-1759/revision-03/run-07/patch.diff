+def _write_temp_file(content: bytes) -> str:
+    """Write content to a new temporary file and return its path."""
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(content)
+    return path
+
+
+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello world")
+    try:
+        with progress_open(path, console=_make_console(), auto_refresh=False) as reader:
+            text = reader.read()
+        assert text == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_text_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello world")
