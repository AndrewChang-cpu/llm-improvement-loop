+class _ProgressFileContext(Generic[_FileT]):
+    """Starts a Progress display and enters a file for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        stream (IO[Any]): The reader or text wrapper to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", stream: _FileT) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> _FileT:
+        self._progress.start()
+        self._stream.__enter__()
+        return self._stream
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._stream.__exit__(exc_type, exc_val, exc_tb)
