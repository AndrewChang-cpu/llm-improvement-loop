+def _write_temp_file(content: bytes) -> str:
+    handle, path = tempfile.mkstemp()
+    with os.fdopen(handle, "wb") as file:
+        file.write(content)
+    return path
+
+
+def _quiet_console() -> Console:
+    return Console(file=io.StringIO(), force_terminal=True, width=80)
+
+
+def _quiet_progress() -> Progress:
+    return Progress(console=_quiet_console(), auto_refresh=False)
+
+
+def test_module_open_defaults_to_text_mode() -> None:
+    path = _write_temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=_quiet_console()) as reader:
+            assert reader.read() == "hello\nworld\n"
+            assert not reader.closed
+        assert reader.closed
+    finally:
+        os.remove(path)
+
