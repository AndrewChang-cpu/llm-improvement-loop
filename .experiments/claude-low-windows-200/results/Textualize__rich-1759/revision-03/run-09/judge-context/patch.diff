+    def open(
+        self,
+        file: Union[str, bytes, "os.PathLike[Any]"],
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file path and read it, advancing a task as bytes are consumed.
+
+        The display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for a text reader, 'rb' or 'br' for a binary reader. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, passed to the file open. Defaults to -1.
+            encoding (str, optional): Text encoding, for text modes. Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (int, optional): Total number of bytes. Default is the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Default creates a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text reader for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or text mode is used with buffering 0.
+            OSError: If the file size cannot be read or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode: {mode!r}")
+        is_text = mode in ("r", "rt")
+        line_buffering = False
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode, "
+                "the default buffer size is used",
+                RuntimeWarning,
+                stacklevel=2,
+            )
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering=buffering)
+        reader = _ProgressReader(handle, self, task_id, close_handle=True)
+        if is_text:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Read from an open binary file-like object, advancing a task as bytes are consumed.
+
+        The file is not closed when the reader is closed. The display is not started by this method.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Total number of bytes. Default is the total of task_id, if given.
+            task_id (TaskID, optional): Existing task to advance. Default creates a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        task_total: Optional[float] = None
+        if total is not None:
+            task_total = total
+        elif task_id is not None:
+            with self._lock:
+                task_total = self._tasks[task_id].total
+        if task_total is None:
+            raise ValueError("total must be specified for a file-like object")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=task_total)
+        else:
+            self.update(task_id, total=task_total)
+        return _ProgressReader(file, self, task_id, close_handle=False)
