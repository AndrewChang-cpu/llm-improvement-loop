+class _ReadContext(Generic[_ReadT]):
+    """Starts a progress display and enters a reader, and reverses both on exit."""
+
+    def __init__(self, progress: "Progress", reader: ContextManager[_ReadT]) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReadT:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
