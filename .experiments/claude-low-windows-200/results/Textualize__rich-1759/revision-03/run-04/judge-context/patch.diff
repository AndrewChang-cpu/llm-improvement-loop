+class _FileReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed."""
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task: TaskID,
+        close_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task = task
+        self._close_handle = close_handle
+        self._closed = False
+
+    def __enter__(self) -> BinaryIO:
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> Iterator[bytes]:
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._progress.advance(self._task, len(line))
+        return line
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def close(self) -> None:
+        try:
+            if self._close_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def read(self, size: int = -1) -> bytes:
+        data = self.handle.read(size)
+        self._progress.advance(self._task, len(data))
+        return data
+
+    def readinto(self, b: _Buffer):  # type: ignore[no-untyped-def, override]
+        n = self.handle.readinto(b)  # type: ignore[attr-defined]
+        self._progress.advance(self._task, n)
+        return n
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        line = self.handle.readline(size)
+        self._progress.advance(self._task, len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task, sum(len(line) for line in lines))
+        return lines
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        pos = self.handle.seek(offset, whence)
+        self._progress.update(self._task, completed=pos)
+        return pos
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def write(self, s: Any) -> NoReturn:
+        raise io.UnsupportedOperation("write")
+
+
+class _ReadContext(Generic[_ReaderT]):
+    """Starts a progress display and yields a reader for a with block."""
+
+    def __init__(self, progress: "Progress", reader: _ReaderT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
