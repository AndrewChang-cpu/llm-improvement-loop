+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and count the bytes consumed on a task.
+
+        The Progress is not started by this method.
+
+        Args:
+            file (str | PathLike | bytes): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text (the default), 'rb' or 'br' for binary.
+            buffering (int, optional): Buffering passed to the file open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Error handling for text decoding.
+            newline (str, optional): Newline handling for text mode.
+            total (int, optional): Size of the file in bytes. Defaults to the file size.
+            task_id (TaskID, optional): An existing task to update. A new task is added if None.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in text mode.
+            OSError: If the file size cannot be read or the file cannot be opened.
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text reader for 'r' and 'rt', otherwise a binary reader.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode: {mode!r}")
+
+        is_text = mode in ("r", "rt")
+        line_buffering = False
+        if is_text:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode; "
+                "the default buffer size is used",
+                RuntimeWarning,
+            )
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _FileReader(handle, self, task_id, close_handle=True)
+        if not is_text:
+            return reader
+        return io.TextIOWrapper(
+            reader,
+            encoding=encoding,
+            errors=errors,
+            newline=newline,
+            line_buffering=line_buffering,
+        )
