+def _write_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(content)
+    return path
+
+
+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _wrapped(content: bytes) -> Tuple[Progress, BinaryIO]:
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=len(content))
+    return progress, progress.wrap_file(io.BytesIO(content), task_id=task_id)
+
