+def test_text_mode_passes_buffering_to_byte_open(monkeypatch) -> None:
+    path = _write_temp_file(b"text")
+    seen = []
+    real_open = io.open
+
+    def spy(*args, **kwargs):
+        seen.append(args)
+        return real_open(*args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy)
+    try:
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        with progress.open(path, "r", 8192) as reader:
+            assert reader.read() == "text"
+        assert seen[-1][2] == 8192
+    finally:
+        os.remove(path)
+
