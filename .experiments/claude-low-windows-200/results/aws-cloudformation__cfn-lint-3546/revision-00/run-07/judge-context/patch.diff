+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.resources.ecs.FargateExecutionRole import FargateExecutionRole
+
+
+@pytest.fixture(scope="module")
+def rule():
+    rule = FargateExecutionRole()
+    yield rule
+
+
+@pytest.mark.parametrize(
+    "instance,expected",
+    [
+        (
+            {"RequiresCompatibilities": ["EC2"], "ContainerDefinitions": [{"LogConfiguration": {"LogDriver": "awslogs"}}]},
+            [],
+        ),
+        (
+            {"RequiresCompatibilities": ["FARGATE"], "ContainerDefinitions": [{"Name": "a"}], "ExecutionRoleArn": "arn"},
+            [],
+        ),
+        (
+            {"RequiresCompatibilities": ["FARGATE"], "ContainerDefinitions": [{"Name": "a"}]},
+            [],
+        ),
+        (
+            {"RequiresCompatibilities": ["FARGATE"], "ContainerDefinitions": [{"LogConfiguration": {"LogDriver": "awslogs"}}]},
+            [
+                ValidationError(
+                    "\x27ExecutionRoleArn\x27 is a required property",
+                    rule=FargateExecutionRole(),
+                    path=deque([]),
+                    validator="required",
+                    schema_path=deque(["then", "required"]),
+                )
+            ],
+        ),
+    ],
+)
+def test_validate(instance, expected, rule, validator):
+    errs = list(rule.validate(validator, "", instance, {}))
+
+    assert errs == expected, f"Expected {expected} got {errs}"
