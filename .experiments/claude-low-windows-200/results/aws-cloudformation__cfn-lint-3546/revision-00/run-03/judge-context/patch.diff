diff --git a/test/unit/rules/resources/ecs/test_ecs_fargate_rules.py b/test/unit/rules/resources/ecs/test_ecs_fargate_rules.py
new file mode 100644
index 0000000..584e57e
--- /dev/null
+++ b/test/unit/rules/resources/ecs/test_ecs_fargate_rules.py
@@ -0,0 +1,101 @@
+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+import pytest
+
+from cfnlint.rules.resources.ecs.FargateNetworkMode import FargateNetworkMode
+from cfnlint.rules.resources.ecs.FargatePrivileged import FargatePrivileged
+from cfnlint.rules.resources.ecs.FargateServiceNetworkConfiguration import (
+    FargateServiceNetworkConfiguration,
+)
+
+
+@pytest.fixture(scope="module")
+def network_mode_rule():
+    yield FargateNetworkMode()
+
+
+@pytest.fixture(scope="module")
+def privileged_rule():
+    yield FargatePrivileged()
+
+
+@pytest.fixture(scope="module")
+def service_rule():
+    yield FargateServiceNetworkConfiguration()
+
+
+@pytest.mark.parametrize(
+    "instance,expected",
+    [
+        ({"RequiresCompatibilities": ["FARGATE"], "NetworkMode": "awsvpc"}, 0),
+        ({"RequiresCompatibilities": ["FARGATE"], "NetworkMode": {"Ref": "M"}}, 0),
+        ({"RequiresCompatibilities": ["EC2"], "NetworkMode": "bridge"}, 0),
+        ({"RequiresCompatibilities": ["FARGATE"], "NetworkMode": "bridge"}, 1),
+        ({"RequiresCompatibilities": ["FARGATE"]}, 1),
+    ],
+)
+def test_network_mode(instance, expected, network_mode_rule, validator):
+    errs = list(network_mode_rule.validate(validator, "", instance, {}))
+    assert len(errs) == expected, f"Expected {expected} got {errs}"
+
+
+@pytest.mark.parametrize(
+    "instance,expected",
+    [
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "ContainerDefinitions": [{"Name": "a", "Privileged": False}],
+            },
+            0,
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "ContainerDefinitions": [{"Name": "a"}],
+            },
+            0,
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "ContainerDefinitions": [{"Name": "a", "Privileged": {"Ref": "P"}}],
+            },
+            0,
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "ContainerDefinitions": [{"Name": "a", "Privileged": True}],
+            },
+            1,
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["EC2"],
+                "ContainerDefinitions": [{"Name": "a", "Privileged": True}],
+            },
+            0,
+        ),
+    ],
+)
+def test_privileged(instance, expected, privileged_rule, validator):
+    errs = list(privileged_rule.validate(validator, "", instance, {}))
+    assert len(errs) == expected, f"Expected {expected} got {errs}"
+
+
+@pytest.mark.parametrize(
+    "instance,expected",
+    [
+        ({"LaunchType": "FARGATE", "NetworkConfiguration": {}}, 0),
+        ({"LaunchType": "EC2"}, 0),
+        ({"LaunchType": {"Ref": "LT"}}, 0),
+        ({"LaunchType": "FARGATE"}, 1),
+    ],
+)
+def test_service_network_configuration(instance, expected, service_rule, validator):
+    errs = list(service_rule.validate(validator, "", instance, {}))
+    assert len(errs) == expected, f"Expected {expected} got {errs}"
