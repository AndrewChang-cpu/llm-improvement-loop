+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.resources.ecs.TaskFargatePrivileged import TaskFargatePrivileged
+
+
+@pytest.fixture(scope="module")
+def rule():
+    rule = TaskFargatePrivileged()
+    yield rule
+
+
+@pytest.mark.parametrize(
+    "instance,expected",
+    [
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "ContainerDefinitions": [{"Name": "app", "Privileged": False}],
+            },
+            [],
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["EC2"],
+                "ContainerDefinitions": [{"Name": "app", "Privileged": True}],
+            },
+            [],
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "ContainerDefinitions": [{"Name": "app", "Privileged": True}],
+            },
+            [
+                ValidationError(
+                    "Fargate tasks don't support privileged containers",
+                    rule=TaskFargatePrivileged(),
+                    path=deque(["ContainerDefinitions", 0]),
+                    validator="not",
+                    schema_path=deque(
+                        [
+                            "then",
+                            "properties",
+                            "ContainerDefinitions",
+                            "items",
+                            "not",
+                        ]
+                    ),
+                )
+            ],
+        ),
+    ],
+)
+def test_validate(instance, expected, rule, validator):
+    errs = list(rule.validate(validator, "", instance, {}))
+
+    assert errs == expected, f"Expected {expected} got {errs}"
