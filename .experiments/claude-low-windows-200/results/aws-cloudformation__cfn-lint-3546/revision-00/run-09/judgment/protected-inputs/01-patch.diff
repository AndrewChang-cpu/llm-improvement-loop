+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.resources.ecs.TaskFargateNetworkMode import TaskFargateNetworkMode
+
+
+@pytest.fixture(scope="module")
+def rule():
+    rule = TaskFargateNetworkMode()
+    yield rule
+
+
+@pytest.mark.parametrize(
+    "instance,expected",
+    [
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "NetworkMode": "awsvpc",
+            },
+            [],
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "NetworkMode": {"Ref": "NetworkMode"},
+            },
+            [],
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["EC2"],
+                "NetworkMode": "bridge",
+            },
+            [],
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["EC2"],
+            },
+            [],
+        ),
+        (
+            [],  # wrong type
+            [],
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+                "NetworkMode": "bridge",
+            },
+            [
+                ValidationError(
+                    "'awsvpc' was expected",
+                    rule=TaskFargateNetworkMode(),
+                    path=deque(["NetworkMode"]),
+                    validator="const",
+                    schema_path=deque(
+                        ["then", "properties", "NetworkMode", "then", "const"]
+                    ),
+                )
+            ],
+        ),
+        (
+            {
+                "RequiresCompatibilities": ["FARGATE"],
+            },
+            [
+                ValidationError(
+                    "'NetworkMode' is a required property",
+                    rule=TaskFargateNetworkMode(),
+                    path=deque([]),
+                    validator="required",
+                    schema_path=deque(["then", "required"]),
+                )
+            ],
+        ),
+    ],
+)
+def test_validate(instance, expected, rule, validator):
+    errs = list(rule.validate(validator, "", instance, {}))
+
+    assert errs == expected, f"Expected {expected} got {errs}"
