+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.resources.ecs.ServiceFargateNetworkConfiguration import (
+    ServiceFargateNetworkConfiguration,
+)
+
+
+@pytest.fixture(scope="module")
+def rule():
+    rule = ServiceFargateNetworkConfiguration()
+    yield rule
+
+
+@pytest.mark.parametrize(
+    "instance,expected",
+    [
+        (
+            {
+                "LaunchType": "FARGATE",
+                "NetworkConfiguration": {
+                    "AwsvpcConfiguration": {"Subnets": ["subnet-1"]}
+                },
+            },
+            [],
+        ),
+        (
+            {
+                "LaunchType": "EC2",
+            },
+            [],
+        ),
+        (
+            {},
+            [],
+        ),
+        (
+            [],  # wrong type
+            [],
+        ),
+        (
+            {
+                "LaunchType": "FARGATE",
+            },
+            [
+                ValidationError(
+                    "'NetworkConfiguration' is a required property",
+                    rule=ServiceFargateNetworkConfiguration(),
+                    path=deque([]),
+                    validator="required",
+                    schema_path=deque(["then", "required"]),
+                )
+            ],
+        ),
+    ],
+)
+def test_validate(instance, expected, rule, validator):
+    errs = list(rule.validate(validator, "", instance, {}))
+
+    assert errs == expected, f"Expected {expected} got {errs}"
