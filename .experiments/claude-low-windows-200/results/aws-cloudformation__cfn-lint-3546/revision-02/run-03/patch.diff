+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+def _get_task_definition_name(value: Any) -> str | None:
+    fn_k, fn_v = is_function(value)
+    if fn_k == "Ref":
+        if isinstance(fn_v, str):
+            return fn_v
+    elif fn_k == "Fn::GetAtt":
+        values = ensure_list(fn_v)
+        if values and isinstance(values[0], str):
+            return values[0].split(".")[0]
+    return None
+
+
+class ServiceFargate(CfnLintKeyword):
+    id = "E3054"
+    shortdesc = (
+        "Validate ECS services using FARGATE reference task definitions that "
+        "support FARGATE"
+    )
+    description = (
+        "When an ECS service has 'LaunchType' of 'FARGATE' the referenced task "
+        "definition must have 'RequiresCompatibilities' that includes 'FARGATE'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = _get_task_definition_name(task_definition)
+            if name is None:
+                continue
+
+            for launch_type, launch_type_validator in get_value_from_path(
+                task_definition_validator, instance, deque(["LaunchType"])
+            ):
+                if launch_type != "FARGATE":
+                    continue
+
+                resource, resource_validator = get_resource_by_name(
+                    launch_type_validator,
+                    name,
+                    ["AWS::ECS::TaskDefinition"],
+                )
+                if not resource:
+                    continue
+
+                for (
+                    compatibilities,
+                    compatibilities_validator,
+                ) in get_value_from_path(
+                    resource_validator,
+                    resource,
+                    deque(["Properties", "RequiresCompatibilities"]),
+                ):
+                    yield from self._validate_compatibilities(
+                        compatibilities, compatibilities_validator
+                    )
+
+    def _validate_compatibilities(
+        self, compatibilities: Any, validator: Validator
+    ) -> ValidationResult:
+        if compatibilities is None:
+            # The location one segment above RequiresCompatibilities, so that
+            # a missing key reports Properties and a missing or non-mapping
+            # Properties reports the TaskDefinition resource
+            path = list(validator.context.path.path)[:-1]
+            yield ValidationError(
+                "'RequiresCompatibilities' is a required property",
+                validator="required",
+                path_override=deque(path),
+                rule=self,
+            )
+            return
+
+        if not isinstance(compatibilities, list):
+            return
+
+        for item, _ in get_value_from_path(validator, compatibilities, deque(["*"])):
+            if isinstance(item, dict) or item == "FARGATE":
+                return
+
+        yield ValidationError(
+            f"{compatibilities!r} does not contain items matching 'FARGATE'",
+            validator="contains",
+            path_override=validator.context.path.path,
+            rule=self,
+        )
