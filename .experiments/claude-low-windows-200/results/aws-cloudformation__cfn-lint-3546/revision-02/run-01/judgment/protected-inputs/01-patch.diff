+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.TaskDefinitionAwsVpc import TaskDefinitionAwsVpc
+
+
+@pytest.fixture
+def rule():
+    rule = TaskDefinitionAwsVpc()
+    yield rule
+
+
+def _task_definition(network_mode, host_port, container_port):
+    mapping = {"ContainerPort": container_port}
+    if host_port is not None:
+        mapping["HostPort"] = host_port
+    return {
+        "Type": "AWS::ECS::TaskDefinition",
+        "Properties": {
+            "NetworkMode": network_mode,
+            "ContainerDefinitions": [
+                {
+                    "Name": "app",
+                    "Image": "my-image",
+                    "PortMappings": [mapping],
+                }
+            ],
+        },
+    }
+
+
+def _const(message, path):
+    return ValidationError(
+        message,
+        validator="const",
+        path_override=deque(path),
+        rule=TaskDefinitionAwsVpc(),
+    )
+
+
+_host_port_path = [
+    "Resources",
+    "TaskDefinition",
+    "Properties",
+    "ContainerDefinitions",
+    0,
+    "PortMappings",
+    0,
+    "HostPort",
+]
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition("awsvpc", 8080, 8080),
+                }
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition("awsvpc", "80", 8080),
+                }
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [_const("'80' does not equal 8080", _host_port_path)],
+        ),
