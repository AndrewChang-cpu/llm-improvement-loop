+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.ServiceFargate import ServiceFargate
+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+def _task_definition(properties=None, has_properties=True):
+    resource = {"Type": "AWS::ECS::TaskDefinition"}
+    if has_properties:
+        resource["Properties"] = properties if properties is not None else {}
+    return resource
+
+
+def _service(launch_type):
+    return {
+        "Type": "AWS::ECS::Service",
+        "Properties": {
+            "TaskDefinition": {"Ref": "TaskDefinition"},
+            "LaunchType": launch_type,
+        },
+    }
+
+
+def _required(path):
+    return ValidationError(
+        "'RequiresCompatibilities' is a required property",
+        validator="required",
+        path_override=deque(path),
+        rule=ServiceFargate(),
+    )
+
+
+def _contains(value, path):
+    return ValidationError(
+        f"{value!r} does not contain items matching 'FARGATE'",
+        validator="contains",
+        path_override=deque(path),
+        rule=ServiceFargate(),
+    )
+
+
+_props_path = ["Resources", "TaskDefinition", "Properties"]
+_compat_path = ["Resources", "TaskDefinition", "Properties", "RequiresCompatibilities"]
+_resource_path = ["Resources", "TaskDefinition"]
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["FARGATE"]}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2", "EXTERNAL"]}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_contains(["EC2", "EXTERNAL"], _compat_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition({"Cpu": "256"}),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_required(_props_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(has_properties=False),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_required(_resource_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": {
+                        "Type": "AWS::ECS::TaskDefinition",
+                        "Properties": "invalid",
+                    },
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_required(_resource_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": {"Ref": "AWS::NoValue"}}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_required(_compat_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["FARGATE"]}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Parameters": {"Compat": {"Type": "String"}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2", {"Ref": "Compat"}]}
+                    ),
+                    "Service": _service("FARGATE"),
+                },
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Parameters": {"Compat": {"Type": "String"}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": {"Ref": "Compat"}}
+                    ),
+                    "Service": _service("FARGATE"),
+                },
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service("EC2"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Conditions": {"IsFargate": {"Fn::Equals": ["a", "a"]}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service({"Fn::If": ["IsFargate", "EC2", "FARGATE"]}),
+                },
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_contains(["EC2"], _compat_path)],
+        ),
+        (
+            {
+                "Conditions": {"IsFargate": {"Fn::Equals": ["a", "a"]}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service({"Fn::If": ["IsFargate", "FARGATE", "EC2"]}),
+                },
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_contains(["EC2"], _compat_path)],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
+        validator, template, start_path
+    ):
+        errs = list(rule.validate(instance_validator, "", instance, {}))
+        assert errs == expected, f"Expected {expected} got {errs}"
