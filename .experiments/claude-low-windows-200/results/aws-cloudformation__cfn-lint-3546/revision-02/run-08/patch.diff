+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Iterator
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+class ServiceFargate(CfnLintKeyword):
+    id = "E3054"
+    shortdesc = (
+        "Validate ECS services using FARGATE reference task definitions that allow it"
+    )
+    description = (
+        "When an ECS service uses the 'FARGATE' launch type the task definition "
+        "it references must include 'FARGATE' in its 'RequiresCompatibilities'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _filter_resource_name(self, instance: Any) -> str | None:
+        fn_k, fn_v = is_function(instance)
+        if fn_k is None:
+            return None
+        if fn_k == "Ref":
+            if isinstance(fn_v, str):
+                return fn_v
+        elif fn_k == "Fn::GetAtt":
+            values = ensure_list(fn_v)
+            if values and isinstance(values[0], str):
+                return values[0].split(".")[0]
+        return None
+
+    def _get_task_definition_names(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Validator]]:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = self._filter_resource_name(task_definition)
+            if name is None:
+                continue
+            yield name, task_definition_validator
+
+    def _validate_task_definition(
+        self, validator: Validator, task_definition: Any
+    ) -> ValidationResult:
+        for properties, properties_validator in get_value_from_path(
+            validator, task_definition, deque(["Properties"])
+        ):
+            if is_function(properties)[0] is not None:
+                continue
+            if not isinstance(properties, dict):
+                # Missing or non-mapping Properties: report at the resource
+                yield ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    rule=self,
+                    path_override=validator.context.path.path,
+                )
+                continue
+
+            for compatibilities, compatibilities_validator in get_value_from_path(
+                properties_validator,
+                properties,
+                deque(["RequiresCompatibilities"]),
+            ):
+                if compatibilities is None:
+                    path = deque(compatibilities_validator.context.path.path)
+                    path.pop()
+                    yield ValidationError(
+                        "'RequiresCompatibilities' is a required property",
+                        validator="required",
+                        rule=self,
+                        path_override=path,
+                    )
+                    continue
+
+                if not isinstance(compatibilities, list):
+                    continue
+
+                found = False
+                for item, _ in get_value_from_path(
+                    compatibilities_validator,
+                    compatibilities,
+                    deque(["*"]),
+                ):
+                    if isinstance(item, dict) or item == "FARGATE":
+                        found = True
+                        break
+                if found:
+                    continue
+
+                yield ValidationError(
+                    f"{compatibilities!r} does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    rule=self,
+                    path_override=compatibilities_validator.context.path.path,
+                )
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for name, task_definition_validator in self._get_task_definition_names(
+            validator, instance
+        ):
+            for launch_type, launch_type_validator in get_value_from_path(
+                task_definition_validator,
+                instance,
+                deque(["LaunchType"]),
+            ):
+                if launch_type != "FARGATE":
+                    continue
+
+                task_definition, task_definition_lookup_validator = (
+                    get_resource_by_name(
+                        launch_type_validator,
+                        name,
+                        ["AWS::ECS::TaskDefinition"],
+                    )
+                )
+                if not task_definition:
+                    continue
+
+                yield from self._validate_task_definition(
+                    task_definition_lookup_validator, task_definition
+                )
