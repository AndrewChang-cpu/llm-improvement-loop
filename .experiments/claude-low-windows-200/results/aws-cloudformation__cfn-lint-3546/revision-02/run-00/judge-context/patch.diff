+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.TaskDefinitionAwsVpc import TaskDefinitionAwsVpc
+
+
+@pytest.fixture
+def rule():
+    rule = TaskDefinitionAwsVpc()
+    yield rule
+
+
+def _task_definition(host_port, container_port=8080, network_mode="awsvpc"):
+    port_mapping = {"ContainerPort": container_port}
+    if host_port is not None:
+        port_mapping["HostPort"] = host_port
+    return {
+        "Type": "AWS::ECS::TaskDefinition",
+        "Properties": {
+            "NetworkMode": network_mode,
+            "ContainerDefinitions": [
+                {
+                    "Name": "my-container",
+                    "Image": "my-image",
+                    "PortMappings": [port_mapping],
+                }
+            ],
+        },
+    }
+
+
+def _error(message, path):
+    return ValidationError(
+        message,
+        validator="const",
+        path_override=deque(path),
+        rule=TaskDefinitionAwsVpc(),
+    )
+
+
+_host_path = [
+    "Resources",
+    "TaskDefinition",
+    "Properties",
+    "ContainerDefinitions",
+    0,
+    "PortMappings",
+    0,
+    "HostPort",
+]
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition("8080", 8080),
+                }
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition("80", 8080),
+                }
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [_error("'80' does not equal 8080", _host_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(True, 8080),
+                }
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [_error("True does not equal 8080", _host_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(None, 8080),
+                }
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition("8080", None),
+                }
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition("80", 8080, "bridge"),
+                }
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"Fn::If": ["IsProd", 8080, 80]}, 8080
+                    ),
+                },
+                "Conditions": {"IsProd": {"Fn::Equals": ["a", "b"]}},
+            },
+            deque(["Resources", "TaskDefinition", "Properties"]),
+            [
+                _error(
+                    "80 does not equal 8080",
+                    [
+                        "Resources",
+                        "TaskDefinition",
+                        "Properties",
+                        "ContainerDefinitions",
+                        0,
+                        "PortMappings",
+                        0,
+                        "HostPort",
+                        "Fn::If",
+                        2,
+                    ],
+                ),
+            ],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
+        validator, template, start_path
+    ):
+        errs = list(rule.validate(instance_validator, "", instance, {}))
+        assert errs == expected, f"Expected {expected} got {errs}"
