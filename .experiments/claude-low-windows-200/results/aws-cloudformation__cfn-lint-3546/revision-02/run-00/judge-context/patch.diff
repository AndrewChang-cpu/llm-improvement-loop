+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+def _task_definition(requires=None, has_properties=True, properties=None):
+    if properties is not None:
+        return {"Type": "AWS::ECS::TaskDefinition", "Properties": properties}
+    if not has_properties:
+        return {"Type": "AWS::ECS::TaskDefinition"}
+    props = {"ContainerDefinitions": [{"Name": "c", "Image": "i"}]}
+    if requires is not None:
+        props["RequiresCompatibilities"] = requires
+    return {"Type": "AWS::ECS::TaskDefinition", "Properties": props}
+
+
+def _service(launch_type="FARGATE", task_definition=None):
+    props = {"TaskDefinition": task_definition or {"Ref": "TaskDefinition"}}
+    if launch_type is not None:
+        props["LaunchType"] = launch_type
+    return {"Type": "AWS::ECS::Service", "Properties": props}
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(["FARGATE", "EC2"]),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(["EC2", "EXTERNAL"]),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "['EC2', 'EXTERNAL'] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    path_override=deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "RequiresCompatibilities",
+                        ]
+                    ),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition", "Properties"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(has_properties=False),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(properties="not-a-mapping"),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition({"Ref": "AWS::NoValue"}),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "RequiresCompatibilities",
+                        ]
+                    ),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        [{"Ref": "CompatibilityParam"}, "EC2"]
+                    ),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition([{"Foo": "Bar"}]),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition({"Ref": "CompatParam"}),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(["FARGATE"]),
+                    "Service": _service(launch_type="EC2"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(["EC2"]),
+                    "Service": _service(launch_type=None),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Conditions": {"IsProd": {"Fn::Equals": ["a", "b"]}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(["EC2"]),
+                    "Service": _service(
+                        launch_type={
+                            "Fn::If": ["IsProd", "EC2", "FARGATE"],
+                        }
+                    ),
+                },
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "['EC2'] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    path_override=deque(
+                        ["Resources", "TaskDefinition", "Properties"]
+                        + ["RequiresCompatibilities"]
+                    ),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
+        validator, template, start_path
+    ):
+        errs = list(rule.validate(instance_validator, "", instance, {}))
+        assert errs == expected, f"Expected {expected} got {errs}"
