+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Iterator
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+def _get_task_definition_name(instance: Any) -> str | None:
+    fn_k, fn_v = is_function(instance)
+    if fn_k == "Ref" and isinstance(fn_v, str):
+        return fn_v
+    if fn_k == "Fn::GetAtt":
+        parts = ensure_list(fn_v)
+        if parts and isinstance(parts[0], str):
+            return parts[0].split(".")[0]
+    return None
+
+
+class ServiceFargate(CfnLintKeyword):
+    id = "E3054"
+    shortdesc = (
+        "ECS service using FARGATE must reference a task definition that "
+        "allows FARGATE compatibility"
+    )
+    description = (
+        "When an ECS service uses a LaunchType of FARGATE the referenced "
+        "task definition has to have RequiresCompatibilities that include FARGATE"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _get_task_definition_names(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Validator]]:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = _get_task_definition_name(task_definition)
+            if name is None:
+                continue
+            yield name, task_definition_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for name, task_definition_validator in self._get_task_definition_names(
+            validator, instance
+        ):
+            for launch_type, launch_type_validator in get_value_from_path(
+                task_definition_validator, instance, deque(["LaunchType"])
+            ):
+                if launch_type != "FARGATE":
+                    continue
+                resource, resource_validator = get_resource_by_name(
+                    launch_type_validator,
+                    name,
+                    ["AWS::ECS::TaskDefinition"],
+                )
+                if not resource:
+                    continue
+                for (
+                    compatibilities,
+                    compatibilities_validator,
+                ) in get_value_from_path(
+                    resource_validator,
+                    resource,
+                    deque(["Properties", "RequiresCompatibilities"]),
+                ):
+                    if compatibilities is None:
+                        # The path is the RequiresCompatibilities lookup path
+                        # with its last segment removed
+                        yield ValidationError(
+                            "'RequiresCompatibilities' is a required property",
+                            validator="required",
+                            path_override=deque(
+                                list(compatibilities_validator.context.path.path)[
+                                    :-1
+                                ]
+                            ),
+                            rule=self,
+                        )
+                        continue
+                    if not isinstance(compatibilities, list):
+                        continue
+                    if self._has_fargate_or_dict(
+                        compatibilities_validator, compatibilities
+                    ):
+                        continue
+                    yield ValidationError(
+                        f"{compatibilities!r} does not contain items "
+                        "matching 'FARGATE'",
+                        validator="contains",
+                        path_override=deque(
+                            compatibilities_validator.context.path.path
+                        ),
+                        rule=self,
+                    )
+
+    def _has_fargate_or_dict(self, validator: Validator, items: list[Any]) -> bool:
+        for item, _ in get_value_from_path(validator, items, deque(["*"])):
+            if isinstance(item, dict) or item == "FARGATE":
+                return True
+        return False
