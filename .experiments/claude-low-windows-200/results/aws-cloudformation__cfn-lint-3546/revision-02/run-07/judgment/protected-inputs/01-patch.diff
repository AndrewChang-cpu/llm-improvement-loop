+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.TaskDefinitionAwsVpc import TaskDefinitionAwsVpc
+
+
+@pytest.fixture
+def rule():
+    rule = TaskDefinitionAwsVpc()
+    yield rule
+
+
+_task_definition = {
+    "Type": "AWS::ECS::TaskDefinition",
+    "Properties": {
+        "NetworkMode": "awsvpc",
+        "ContainerDefinitions": [
+            {
+                "Name": "my-container",
+                "Image": "my-image",
+                "PortMappings": [
+                    {
+                        "ContainerPort": 8080,
+                        "HostPort": 8080,
+                    }
+                ],
+            }
+        ],
+    },
+}
+
+
+def _with_patch(path, value):
+    return jsonpatch.apply_patch(
+        dict(_task_definition),
+        [{"op": "replace", "path": path, "value": value}],
+    )
+
+
+def _without_patch(path):
+    return jsonpatch.apply_patch(
+        dict(_task_definition),
+        [{"op": "remove", "path": path}],
+    )
+
+
+@pytest.mark.parametrize(
+    "template,expected",
+    [
+        (
+            {"Resources": {"TaskDefinition": dict(_task_definition)}},
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _with_patch(
+                        "/Properties/ContainerDefinitions/0/PortMappings/0/HostPort",
+                        "80",
+                    ),
+                }
+            },
+            [
+                (
+                    "'80' does not equal 8080",
+                    "const",
+                    deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "ContainerDefinitions",
+                            0,
+                            "PortMappings",
+                            0,
+                            "HostPort",
+                        ]
+                    ),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _with_patch(
+                        "/Properties/ContainerDefinitions/0/PortMappings/0/HostPort",
+                        True,
+                    ),
+                }
+            },
+            [
+                (
+                    "True does not equal 8080",
+                    "const",
+                    deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "ContainerDefinitions",
+                            0,
+                            "PortMappings",
+                            0,
+                            "HostPort",
+                        ]
+                    ),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _without_patch(
+                        "/Properties/ContainerDefinitions/0/PortMappings/0/HostPort",
+                    ),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _without_patch(
+                        "/Properties/ContainerDefinitions/0/PortMappings"
+                        "/0/ContainerPort",
+                    ),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _with_patch(
+                        "/Properties/NetworkMode",
+                        "bridge",
+                    ),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                "Conditions": {"IsProd": {"Fn::Equals": ["a", "b"]}},
+                "Resources": {
+                    "TaskDefinition": _with_patch(
+                        "/Properties/ContainerDefinitions/0/PortMappings/0/HostPort",
+                        {"Fn::If": ["IsProd", "80", 8080]},
+                    ),
+                }
+            },
+            [
+                (
+                    "'80' does not equal 8080",
+                    "const",
+                    deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "ContainerDefinitions",
+                            0,
+                            "PortMappings",
+                            0,
+                            "HostPort",
+                            "Fn::If",
+                            1,
+                        ]
+                    ),
+                )
+            ],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, expected, rule, validator):
+    expected_errors = [
+        ValidationError(message, validator=kind, path_override=path, rule=rule)
+        for message, kind, path in expected
+    ]
+    errs = []
+    for instance, instance_validator in get_value_from_path(
+        validator,
+        template,
+        deque(["Resources", "TaskDefinition", "Properties"]),
+    ):
+        errs.extend(rule.validate(instance_validator, "", instance, {}))
+    assert errs == expected_errors, f"Expected {expected_errors} got {errs}"
