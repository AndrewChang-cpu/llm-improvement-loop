+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Iterator
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+class ServiceFargate(CfnLintKeyword):
+    id = "E3054"
+    shortdesc = (
+        "Validate ECS services using FARGATE reference task definitions that "
+        "allow FARGATE"
+    )
+    description = (
+        "When an ECS service uses a 'LaunchType' of 'FARGATE' the task definition "
+        "it references must have 'FARGATE' in its 'RequiresCompatibilities'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _filter_resource_name(self, instance: Any) -> str | None:
+        fn_k, fn_v = is_function(instance)
+        if fn_k == "Ref":
+            if isinstance(fn_v, str):
+                return fn_v
+        elif fn_k == "Fn::GetAtt":
+            items = ensure_list(fn_v)
+            if items and isinstance(items[0], str):
+                return items[0].split(".")[0]
+        return None
+
+    def _get_task_definition_names(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Validator]]:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = self._filter_resource_name(task_definition)
+            if name is None:
+                continue
+            yield name, task_definition_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for name, task_definition_validator in self._get_task_definition_names(
+            validator, instance
+        ):
+            for launch_type, launch_type_validator in get_value_from_path(
+                task_definition_validator, instance, deque(["LaunchType"])
+            ):
+                if launch_type != "FARGATE":
+                    continue
+
+                task_definition, td_validator = get_resource_by_name(
+                    launch_type_validator, name, ["AWS::ECS::TaskDefinition"]
+                )
+                if not task_definition:
+                    continue
+
+                for compat, compat_validator in get_value_from_path(
+                    td_validator,
+                    task_definition,
+                    deque(["Properties", "RequiresCompatibilities"]),
+                ):
+                    yield from self._validate_compatibilities(
+                        compat, compat_validator
+                    )
+
+    def _validate_compatibilities(
+        self, compat: Any, compat_validator: Validator
+    ) -> Iterator[ValidationError]:
+        if compat is None:
+            # The path of the lookup minus its last segment points at the
+            # location that is missing the key (Properties, the resource, or
+            # the RequiresCompatibilities location for AWS::NoValue).
+            path = deque(compat_validator.context.path.path)
+            if path:
+                path.pop()
+            yield ValidationError(
+                "'RequiresCompatibilities' is a required property",
+                validator="required",
+                path_override=path,
+                rule=self,
+            )
+            return
+
+        if not isinstance(compat, list):
+            return
+
+        for item, _ in get_value_from_path(compat_validator, compat, deque(["*"])):
+            if isinstance(item, dict) or item == "FARGATE":
+                return
+
+        yield ValidationError(
+            f"{compat!r} does not contain items matching 'FARGATE'",
+            validator="contains",
+            path_override=compat_validator.context.path.path,
+            rule=self,
+        )
