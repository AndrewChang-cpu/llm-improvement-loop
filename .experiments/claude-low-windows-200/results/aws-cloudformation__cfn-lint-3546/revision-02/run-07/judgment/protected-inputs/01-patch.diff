+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import jsonpatch
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.ServiceFargate import ServiceFargate
+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+_task_definition = {
+    "Type": "AWS::ECS::TaskDefinition",
+    "Properties": {
+        "RequiresCompatibilities": ["FARGATE", "EC2"],
+        "ContainerDefinitions": [
+            {
+                "Name": "my-container",
+                "Image": "my-image",
+            }
+        ],
+    },
+}
+
+_service = {
+    "Type": "AWS::ECS::Service",
+    "Properties": {
+        "TaskDefinition": {"Ref": "TaskDefinition"},
+        "LaunchType": "FARGATE",
+    },
+}
+
+_td_resources_path = deque(["Resources", "TaskDefinition"])
+_td_properties_path = deque(["Resources", "TaskDefinition", "Properties"])
+_td_rc_path = deque(
+    ["Resources", "TaskDefinition", "Properties", "RequiresCompatibilities"]
+)
+
+
+def _patch(doc, path, value):
+    return jsonpatch.apply_patch(
+        dict(doc), [{"op": "replace", "path": path, "value": value}]
+    )
+
+
+def _remove(doc, path):
+    return jsonpatch.apply_patch(dict(doc), [{"op": "remove", "path": path}])
+
+
+@pytest.mark.parametrize(
+    "template,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        ["EC2", "EXTERNAL"],
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            [
+                (
+                    "['EC2', 'EXTERNAL'] does not contain items matching 'FARGATE'",
+                    "contains",
+                    _td_rc_path,
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _remove(
+                        _task_definition, "/Properties/RequiresCompatibilities"
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            [
+                (
+                    "'RequiresCompatibilities' is a required property",
+                    "required",
+                    _td_properties_path,
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _remove(_task_definition, "/Properties"),
+                    "Service": dict(_service),
+                }
+            },
+            [
+                (
+                    "'RequiresCompatibilities' is a required property",
+                    "required",
+                    _td_resources_path,
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition, "/Properties", "not-a-mapping"
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            [
+                (
+                    "'RequiresCompatibilities' is a required property",
+                    "required",
+                    _td_resources_path,
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        {"Ref": "AWS::NoValue"},
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            [
+                (
+                    "'RequiresCompatibilities' is a required property",
+                    "required",
+                    _td_rc_path,
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        ["FARGATE"],
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        [{"Ref": "Compat"}],
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                "Parameters": {"Compat": {"Type": "String"}},
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        {"Ref": "Compat"},
+                    ),
+                    "Service": dict(_service),
+                },
+            },
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": dict(_task_definition),
+                    "Service": _patch(_service, "/Properties/LaunchType", "EC2"),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                "Conditions": {"IsProd": {"Fn::Equals": ["a", "b"]}},
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        ["EC2"],
+                    ),
+                    "Service": _patch(
+                        _service,
+                        "/Properties/LaunchType",
+                        {"Fn::If": ["IsProd", "FARGATE", "EC2"]},
+                    ),
+                },
+            },
+            [
+                (
+                    "['EC2'] does not contain items matching 'FARGATE'",
+                    "contains",
+                    _td_rc_path,
+                )
+            ],
+        ),
+        (
+            {
+                "Conditions": {"IsProd": {"Fn::Equals": ["a", "b"]}},
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        ["EC2"],
+                    ),
+                    "Service": _patch(
+                        _service,
+                        "/Properties/LaunchType",
+                        {"Fn::If": ["IsProd", "EC2", "FARGATE"]},
+                    ),
+                },
+            },
+            [
+                (
+                    "['EC2'] does not contain items matching 'FARGATE'",
+                    "contains",
+                    _td_rc_path,
+                )
+            ],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, expected, rule, validator):
+    expected_errors = [
+        ValidationError(message, validator=kind, path_override=path, rule=rule)
+        for message, kind, path in expected
+    ]
+    errs = []
+    for instance, instance_validator in get_value_from_path(
+        validator, template, deque(["Resources", "Service", "Properties"])
+    ):
+        errs.extend(rule.validate(instance_validator, "", instance, {}))
+    assert errs == expected_errors, f"Expected {expected_errors} got {errs}"
