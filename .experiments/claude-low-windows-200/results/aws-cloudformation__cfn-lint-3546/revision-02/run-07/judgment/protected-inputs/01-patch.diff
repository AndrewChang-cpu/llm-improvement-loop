+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Iterator
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+class ServiceNetworkConfiguration(CfnLintKeyword):
+    id = "E3052"
+    shortdesc = (
+        "Validate ECS services have NetworkConfiguration when the task "
+        "definition uses awsvpc network mode"
+    )
+    description = (
+        "When an ECS service references a task definition with a "
+        "'NetworkMode' of 'awsvpc' the service must define 'NetworkConfiguration'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _filter_resource_name(self, instance: Any) -> str | None:
+        fn_k, fn_v = is_function(instance)
+        if fn_k == "Ref":
+            if isinstance(fn_v, str):
+                return fn_v
+        elif fn_k == "Fn::GetAtt":
+            items = ensure_list(fn_v)
+            if items and isinstance(items[0], str):
+                return items[0].split(".")[0]
+        return None
+
+    def _get_task_definition_names(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Validator]]:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = self._filter_resource_name(task_definition)
+            if name is None:
+                continue
+            yield name, task_definition_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for name, task_definition_validator in self._get_task_definition_names(
+            validator, instance
+        ):
+            for network_configuration, nc_validator in get_value_from_path(
+                task_definition_validator, instance, deque(["NetworkConfiguration"])
+            ):
+                task_definition, td_lookup_validator = get_resource_by_name(
+                    nc_validator, name, ["AWS::ECS::TaskDefinition"]
+                )
+                if not task_definition:
+                    continue
+
+                for network_mode, _ in get_value_from_path(
+                    td_lookup_validator,
+                    task_definition,
+                    deque(["Properties", "NetworkMode"]),
+                ):
+                    if network_mode != "awsvpc":
+                        continue
+                    if network_configuration is None:
+                        yield ValidationError(
+                            "'NetworkConfiguration' is a required property",
+                            validator="required",
+                            rule=self,
+                        )
