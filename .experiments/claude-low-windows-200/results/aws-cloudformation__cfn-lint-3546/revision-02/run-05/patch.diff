+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.ServiceFargate import ServiceFargate
+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+def _task_definition(properties=None, has_properties=True):
+    resource = {"Type": "AWS::ECS::TaskDefinition"}
+    if has_properties:
+        resource["Properties"] = properties if properties is not None else {}
+    return resource
+
+
+def _service(launch_type, task_definition="TaskDefinition"):
+    return {
+        "Type": "AWS::ECS::Service",
+        "Properties": {
+            "TaskDefinition": {"Ref": task_definition},
+            "LaunchType": launch_type,
+        },
+    }
+
+
+def _contains_error(items, path_override):
+    return ValidationError(
+        f"{items!r} does not contain items matching 'FARGATE'",
+        validator="contains",
+        path_override=path_override,
+        rule=ServiceFargate(),
+    )
+
+
+def _required_error(path_override):
+    return ValidationError(
+        "'RequiresCompatibilities' is a required property",
+        validator="required",
+        path_override=path_override,
+        rule=ServiceFargate(),
+    )
+
+
+_requires_path = deque(
+    ["Resources", "TaskDefinition", "Properties", "RequiresCompatibilities"]
+)
+_properties_path = deque(["Resources", "TaskDefinition", "Properties"])
+_resource_path = deque(["Resources", "TaskDefinition"])
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2", "EXTERNAL"]}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_contains_error(["EC2", "EXTERNAL"], _requires_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["FARGATE"]}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition({}),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_required_error(_properties_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(has_properties=False),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_required_error(_resource_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": {
+                        "Type": "AWS::ECS::TaskDefinition",
+                        "Properties": "invalid",
+                    },
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_required_error(_resource_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": {"Ref": "AWS::NoValue"}}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_required_error(_requires_path)],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": [{"Ref": "Compat"}]}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": [{"Foo": "bar"}]}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": {"Ref": "Compat"}}
+                    ),
+                    "Service": _service("FARGATE"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service("EC2"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Conditions": {"IsProd": {"Fn::Equals": ["a", "b"]}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service({"Fn::If": ["IsProd", "FARGATE", "EC2"]}),
+                },
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [_contains_error(["EC2"], _requires_path)],
+        ),
+        (
+            {
+                "Conditions": {"IsProd": {"Fn::Equals": ["a", "b"]}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service({"Fn::If": ["IsProd", "EC2", "EC2"]}),
+                },
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    errs = []
+    for instance, instance_validator in get_value_from_path(
+        validator, template, start_path
+    ):
+        errs.extend(rule.validate(instance_validator, "", instance, {}))
+    assert errs == expected, f"Expected {expected} got {errs}"
