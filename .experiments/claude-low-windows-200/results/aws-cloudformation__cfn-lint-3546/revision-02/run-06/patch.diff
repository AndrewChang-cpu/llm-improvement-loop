+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Iterator
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+def _task_definition_name(value: Any) -> str | None:
+    fn_k, fn_v = is_function(value)
+    if fn_k == "Ref" and isinstance(fn_v, str):
+        return fn_v
+    if fn_k == "Fn::GetAtt":
+        names = ensure_list(fn_v)
+        if names and isinstance(names[0], str):
+            return names[0].split(".")[0]
+    return None
+
+
+class ServiceFargate(CfnLintKeyword):
+    id = "E3054"
+    shortdesc = (
+        "ECS service using FARGATE must reference a task definition "
+        "that supports FARGATE"
+    )
+    description = (
+        "When an ECS service has a 'LaunchType' of 'FARGATE' the task definition "
+        "it references must have 'RequiresCompatibilities' containing 'FARGATE'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _get_task_definition_names(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Validator]]:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = _task_definition_name(task_definition)
+            if name is None:
+                continue
+            yield name, task_definition_validator
+
+    def _get_fargate_validators(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[Validator]:
+        for launch_type, launch_type_validator in get_value_from_path(
+            validator, instance, deque(["LaunchType"])
+        ):
+            if isinstance(launch_type, str) and launch_type == "FARGATE":
+                yield launch_type_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for name, task_definition_validator in self._get_task_definition_names(
+            validator, instance
+        ):
+            for fargate_validator in self._get_fargate_validators(
+                task_definition_validator, instance
+            ):
+                resource, resource_validator = get_resource_by_name(
+                    fargate_validator,
+                    name,
+                    ["AWS::ECS::TaskDefinition"],
+                )
+                if not resource:
+                    continue
+
+                for (
+                    requires,
+                    requires_validator,
+                ) in get_value_from_path(
+                    resource_validator,
+                    resource,
+                    deque(["Properties", "RequiresCompatibilities"]),
+                ):
+                    if requires is None:
+                        # Drop the last segment so the override points at the
+                        # container of the missing value (Properties or resource)
+                        # or at the RequiresCompatibilities location for
+                        # AWS::NoValue.
+                        path = list(requires_validator.context.path.path)[:-1]
+                        yield ValidationError(
+                            "'RequiresCompatibilities' is a required property",
+                            validator="required",
+                            path_override=path,
+                            rule=self,
+                        )
+                        continue
+
+                    if not isinstance(requires, list):
+                        continue
+
+                    has_match = False
+                    for element, _element_validator in get_value_from_path(
+                        requires_validator, requires, deque(["*"])
+                    ):
+                        if isinstance(element, dict) or element == "FARGATE":
+                            has_match = True
+                            break
+
+                    if not has_match:
+                        yield ValidationError(
+                            f"{requires!r} does not contain items matching 'FARGATE'",
+                            validator="contains",
+                            path_override=requires_validator.context.path.path,
+                            rule=self,
+                        )
