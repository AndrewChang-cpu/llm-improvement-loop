+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.ServiceFargate import ServiceFargate
+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+def _service(launch_type="FARGATE"):
+    return {
+        "Type": "AWS::ECS::Service",
+        "Properties": {
+            "TaskDefinition": {"Ref": "TaskDefinition"},
+            "LaunchType": launch_type,
+        },
+    }
+
+
+def _task_definition(properties):
+    resource = {"Type": "AWS::ECS::TaskDefinition"}
+    if properties is not None:
+        resource["Properties"] = properties
+    return resource
+
+
+_start_path = deque(["Resources", "Service", "Properties"])
+_requires_path = deque(
+    ["Resources", "TaskDefinition", "Properties", "RequiresCompatibilities"]
+)
+_properties_path = deque(["Resources", "TaskDefinition", "Properties"])
+_resource_path = deque(["Resources", "TaskDefinition"])
+
+
+def _contains_error(value):
+    return ValidationError(
+        f"{value!r} does not contain items matching 'FARGATE'",
+        validator="contains",
+        path_override=_requires_path,
+        rule=ServiceFargate(),
+    )
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2", "EXTERNAL"]}
+                    ),
+                    "Service": _service(),
+                }
+            },
+            _start_path,
+            [_contains_error(["EC2", "EXTERNAL"])],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2", "FARGATE"]}
+                    ),
+                    "Service": _service(),
+                }
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": []}
+                    ),
+                    "Service": _service(),
+                }
+            },
+            _start_path,
+            [_contains_error([])],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition({"Cpu": "256"}),
+                    "Service": _service(),
+                }
+            },
+            _start_path,
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=_properties_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(None),
+                    "Service": _service(),
+                }
+            },
+            _start_path,
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=_resource_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition("not-a-mapping"),
+                    "Service": _service(),
+                }
+            },
+            _start_path,
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=_resource_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": {"Ref": "AWS::NoValue"}}
+                    ),
+                    "Service": _service(),
+                }
+            },
+            _start_path,
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=_requires_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Parameters": {"Compat": {"Type": "CommaDelimitedList"}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": {"Ref": "Compat"}}
+                    ),
+                    "Service": _service(),
+                },
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Parameters": {"Compat": {"Type": "String"}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": [{"Ref": "Compat"}]}
+                    ),
+                    "Service": _service(),
+                },
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": [{"Foo": "bar"}]}
+                    ),
+                    "Service": _service(),
+                }
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service("EC2"),
+                }
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Conditions": {
+                    "IsFargate": {"Fn::Equals": ["a", "a"]},
+                },
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service(
+                        {
+                            "Fn::If": [
+                                "IsFargate",
+                                "FARGATE",
+                                "EC2",
+                            ]
+                        }
+                    ),
+                },
+            },
+            _start_path,
+            [_contains_error(["EC2"])],
+        ),
+        (
+            {
+                "Parameters": {"Env": {"Type": "String"}},
+                "Conditions": {
+                    "IsProd": {"Fn::Equals": [{"Ref": "Env"}, "prod"]},
+                },
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2"]}
+                    ),
+                    "Service": _service(
+                        {
+                            "Fn::If": [
+                                "IsProd",
+                                {"Fn::If": ["IsProd", "EC2", "FARGATE"]},
+                                "EC2",
+                            ]
+                        }
+                    ),
+                },
+            },
+            _start_path,
+            [],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
+        validator, template, deque(start_path)
+    ):
+        errs = list(rule.validate(instance_validator, "", instance, {}))
+        assert errs == expected, f"Expected {expected} got {errs}"
