+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Iterator
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+def _task_definition_name(value: Any) -> str | None:
+    fn_k, fn_v = is_function(value)
+    if fn_k == "Ref" and isinstance(fn_v, str):
+        return fn_v
+    if fn_k == "Fn::GetAtt":
+        names = ensure_list(fn_v)
+        if names and isinstance(names[0], str):
+            return names[0].split(".")[0]
+    return None
+
+
+class ServiceNetworkConfiguration(CfnLintKeyword):
+    id = "E3052"
+    shortdesc = (
+        "ECS service with a task definition using awsvpc network mode "
+        "requires NetworkConfiguration"
+    )
+    description = (
+        "When the task definition referenced by an ECS service uses the "
+        "'awsvpc' NetworkMode the service must specify 'NetworkConfiguration'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _get_task_definition_names(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Validator]]:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = _task_definition_name(task_definition)
+            if name is None:
+                continue
+            yield name, task_definition_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for name, task_definition_validator in self._get_task_definition_names(
+            validator, instance
+        ):
+            for (
+                network_configuration,
+                network_configuration_validator,
+            ) in get_value_from_path(
+                task_definition_validator, instance, deque(["NetworkConfiguration"])
+            ):
+                resource, resource_validator = get_resource_by_name(
+                    network_configuration_validator,
+                    name,
+                    ["AWS::ECS::TaskDefinition"],
+                )
+                if not resource:
+                    continue
+
+                for network_mode, _mode_validator in get_value_from_path(
+                    resource_validator,
+                    resource,
+                    deque(["Properties", "NetworkMode"]),
+                ):
+                    if not isinstance(network_mode, str) or network_mode != "awsvpc":
+                        continue
+                    if network_configuration is None:
+                        yield ValidationError(
+                            "'NetworkConfiguration' is a required property",
+                            validator="required",
+                            rule=self,
+                        )
