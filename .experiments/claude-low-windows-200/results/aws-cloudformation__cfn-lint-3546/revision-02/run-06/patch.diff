+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.TaskDefinitionAwsVpc import TaskDefinitionAwsVpc
+
+
+@pytest.fixture
+def rule():
+    rule = TaskDefinitionAwsVpc()
+    yield rule
+
+
+def _task_definition(network_mode, port_mapping):
+    return {
+        "Type": "AWS::ECS::TaskDefinition",
+        "Properties": {
+            "NetworkMode": network_mode,
+            "ContainerDefinitions": [
+                {
+                    "Name": "my-container",
+                    "Image": "my-image",
+                    "PortMappings": [port_mapping],
+                }
+            ],
+        },
+    }
+
+
+_start_path = deque(["Resources", "TaskDefinition", "Properties"])
+_host_port_path = deque(
+    [
+        "Resources",
+        "TaskDefinition",
+        "Properties",
+        "ContainerDefinitions",
+        0,
+        "PortMappings",
+        0,
+        "HostPort",
+    ]
+)
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        "awsvpc", {"HostPort": 8080, "ContainerPort": 8080}
+                    ),
+                }
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        "awsvpc", {"HostPort": "8080", "ContainerPort": "8080"}
+                    ),
+                }
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        "awsvpc", {"HostPort": "80", "ContainerPort": 8080}
+                    ),
+                }
+            },
+            _start_path,
+            [
+                ValidationError(
+                    "'80' does not equal 8080",
+                    validator="const",
+                    path_override=_host_port_path,
+                    rule=TaskDefinitionAwsVpc(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        "awsvpc", {"HostPort": True, "ContainerPort": 8080}
+                    ),
+                }
+            },
+            _start_path,
+            [
+                ValidationError(
+                    "True does not equal 8080",
+                    validator="const",
+                    path_override=_host_port_path,
+                    rule=TaskDefinitionAwsVpc(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        "awsvpc", {"ContainerPort": 8080}
+                    ),
+                }
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        "awsvpc", {"HostPort": 8080}
+                    ),
+                }
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        "bridge", {"HostPort": 80, "ContainerPort": 8080}
+                    ),
+                }
+            },
+            _start_path,
+            [],
+        ),
+        (
+            {
+                "Conditions": {
+                    "IsProd": {"Fn::Equals": ["prod", "prod"]},
+                },
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        "awsvpc",
+                        {
+                            "HostPort": {
+                                "Fn::If": ["IsProd", 80, 8080],
+                            },
+                            "ContainerPort": 8080,
+                        },
+                    ),
+                },
+            },
+            _start_path,
+            [
+                ValidationError(
+                    "80 does not equal 8080",
+                    validator="const",
+                    path_override=deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "ContainerDefinitions",
+                            0,
+                            "PortMappings",
+                            0,
+                            "HostPort",
+                            "Fn::If",
+                            1,
+                        ]
+                    ),
+                    rule=TaskDefinitionAwsVpc(),
+                )
+            ],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
+        validator, template, deque(start_path)
+    ):
+        errs = list(rule.validate(instance_validator, "", instance, {}))
+        assert errs == expected, f"Expected {expected} got {errs}"
