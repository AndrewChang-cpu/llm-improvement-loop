+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.ServiceFargate import ServiceFargate
+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+def _task_definition(properties=None, **kwargs):
+    template = {"Type": "AWS::ECS::TaskDefinition"}
+    if properties is not None:
+        template["Properties"] = properties
+    template.update(kwargs)
+    return template
+
+
+def _task_properties(requires_compatibilities):
+    return {
+        "NetworkMode": "awsvpc",
+        "RequiresCompatibilities": requires_compatibilities,
+        "ContainerDefinitions": [{"Name": "app", "Image": "image"}],
+    }
+
+
+def _service(launch_type="FARGATE", task_definition=None):
+    return {
+        "Type": "AWS::ECS::Service",
+        "Properties": {
+            "TaskDefinition": (
+                {"Ref": "TaskDefinition"}
+                if task_definition is None
+                else task_definition
+            ),
+            "LaunchType": launch_type,
+        },
+    }
+
+
+_conditions = {
+    "Conditions": {
+        "IsProd": {"Fn::Equals": [{"Ref": "Env"}, "prod"]},
+    },
+    "Parameters": {
+        "Env": {"Type": "String"},
+    },
+}
+
+_requires_path = deque(
+    ["Resources", "TaskDefinition", "Properties", "RequiresCompatibilities"]
+)
+
+
+@pytest.mark.parametrize(
+    "template,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties(["EC2", "EXTERNAL"])
+                    ),
+                    "Service": _service(),
+                }
+            },
+            [
+                ValidationError(
+                    "['EC2', 'EXTERNAL'] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    path_override=_requires_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties(["EC2", "FARGATE"])
+                    ),
+                    "Service": _service(),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(_task_properties([])),
+                    "Service": _service(),
+                }
+            },
+            [
+                ValidationError(
+                    "[] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    path_override=_requires_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {
+                            "NetworkMode": "awsvpc",
+                            "ContainerDefinitions": [{"Name": "app"}],
+                        }
+                    ),
+                    "Service": _service(),
+                }
+            },
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition", "Properties"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(),
+                    "Service": _service(),
+                }
+            },
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition("not a mapping"),
+                    "Service": _service(),
+                }
+            },
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties({"Ref": "AWS::NoValue"})
+                    ),
+                    "Service": _service(),
+                }
+            },
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=_requires_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties({"Ref": "Compatibilities"})
+                    ),
+                    "Service": _service(),
+                },
+                "Parameters": {"Compatibilities": {"Type": "String"}},
+            },
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties(["EC2", {"Foo": "Bar"}])
+                    ),
+                    "Service": _service(),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties([{"Ref": "Compatibility"}])
+                    ),
+                    "Service": _service(),
+                },
+                "Parameters": {"Compatibility": {"Type": "String"}},
+            },
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties(["EC2"])
+                    ),
+                    "Service": _service(launch_type="EC2"),
+                }
+            },
+            [],
+        ),
+        (
+            {
+                **_conditions,
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties(["EC2"])
+                    ),
+                    "Service": _service(
+                        launch_type={"Fn::If": ["IsProd", "EC2", "FARGATE"]},
+                    ),
+                },
+            },
+            [
+                ValidationError(
+                    "['EC2'] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    path_override=_requires_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                **_conditions,
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties(["EC2"])
+                    ),
+                    "Service": _service(
+                        launch_type={"Fn::If": ["IsProd", "FARGATE", "EC2"]},
+                    ),
+                },
+            },
+            [
+                ValidationError(
+                    "['EC2'] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    path_override=_requires_path,
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        _task_properties(["EC2"])
+                    ),
+                    "Service": _service(task_definition="arn:aws:ecs:task"),
+                }
+            },
+            [],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
+        validator, template, deque(["Resources", "Service", "Properties"])
+    ):
+        errs = list(rule.validate(instance_validator, "", instance, {}))
+        assert errs == expected, f"Expected {expected} got {errs}"
