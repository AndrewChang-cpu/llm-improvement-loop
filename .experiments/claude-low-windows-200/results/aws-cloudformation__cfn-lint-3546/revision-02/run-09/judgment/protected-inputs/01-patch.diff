+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+def _resource_name(value: Any) -> str | None:
+    fn_k, fn_v = is_function(value)
+    if fn_k == "Ref":
+        if isinstance(fn_v, str):
+            return fn_v
+    elif fn_k == "Fn::GetAtt":
+        items = ensure_list(fn_v)
+        if items and isinstance(items[0], str):
+            return items[0].split(".")[0]
+    return None
+
+
+def _allows_fargate(validator: Validator, values: list[Any]) -> bool:
+    for item, _ in get_value_from_path(validator, values, deque(["*"])):
+        if isinstance(item, dict) or item == "FARGATE":
+            return True
+    return False
+
+
+class ServiceFargate(CfnLintKeyword):
+    id = "E3054"
+    shortdesc = "Validate ECS services using FARGATE reference a compatible task"
+    description = (
+        "When a service has a LaunchType of 'FARGATE' the task definition "
+        "it references has to have 'RequiresCompatibilities' including 'FARGATE'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = _resource_name(task_definition)
+            if name is None:
+                continue
+            for launch_type, launch_type_validator in get_value_from_path(
+                task_definition_validator, instance, deque(["LaunchType"])
+            ):
+                if launch_type != "FARGATE":
+                    continue
+                resource, resource_validator = get_resource_by_name(
+                    launch_type_validator,
+                    name,
+                    ["AWS::ECS::TaskDefinition"],
+                )
+                if not resource:
+                    continue
+                for (
+                    requires,
+                    requires_validator,
+                ) in get_value_from_path(
+                    resource_validator,
+                    resource,
+                    deque(["Properties", "RequiresCompatibilities"]),
+                ):
+                    if requires is None:
+                        path = deque(requires_validator.context.path.path)
+                        path.pop()
+                        yield ValidationError(
+                            "'RequiresCompatibilities' is a required property",
+                            validator="required",
+                            path_override=path,
+                            rule=self,
+                        )
+                        continue
+                    if not isinstance(requires, list):
+                        continue
+                    if _allows_fargate(requires_validator, requires):
+                        continue
+                    yield ValidationError(
+                        f"{requires!r} does not contain items matching 'FARGATE'",
+                        validator="contains",
+                        path_override=requires_validator.context.path.path,
+                        rule=self,
+                    )
