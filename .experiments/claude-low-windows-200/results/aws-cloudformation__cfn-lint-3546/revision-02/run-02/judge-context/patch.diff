+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any
+
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+class TaskDefinitionAwsVpc(CfnLintKeyword):
+    id = "E3053"
+    shortdesc = (
+        "ECS task definition using awsvpc network mode has matching host and "
+        "container ports"
+    )
+    description = (
+        "When an ECS task definition uses the 'awsvpc' NetworkMode the HostPort "
+        "of each port mapping must equal the ContainerPort"
+    )
+    source_url = "https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/aws-properties-ecs-taskdefinition-portmappings.html"
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::TaskDefinition/Properties"],
+        )
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for network_mode, network_mode_validator in get_value_from_path(
+            validator, instance, deque(["NetworkMode"])
+        ):
+            if network_mode != "awsvpc":
+                continue
+
+            # keep the branch's condition scope but report paths from Properties
+            branch_validator = network_mode_validator.evolve(
+                context=network_mode_validator.context.evolve(
+                    path=validator.context.path
+                ),
+            )
+            for container, container_validator in get_value_from_path(
+                branch_validator,
+                instance,
+                deque(["ContainerDefinitions", "*"]),
+            ):
+                for port_mapping, port_mapping_validator in get_value_from_path(
+                    container_validator,
+                    container,
+                    deque(["PortMappings", "*"]),
+                ):
+                    for host_port, host_port_validator in get_value_from_path(
+                        port_mapping_validator,
+                        port_mapping,
+                        deque(["HostPort"]),
+                    ):
+                        if host_port is None or not isinstance(host_port, (str, int)):
+                            continue
+                        for container_port, _ in get_value_from_path(
+                            host_port_validator,
+                            port_mapping,
+                            deque(["ContainerPort"]),
+                        ):
+                            if container_port is None or not isinstance(
+                                container_port, (str, int)
+                            ):
+                                continue
+                            if str(host_port) != str(container_port):
+                                yield ValidationError(
+                                    f"{host_port!r} does not equal {container_port!r}",
+                                    validator="const",
+                                    path_override=host_port_validator.context.path.path,
+                                    rule=self,
+                                )
