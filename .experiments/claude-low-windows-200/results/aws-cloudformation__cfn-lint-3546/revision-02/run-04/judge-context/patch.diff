+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": {
+                        "Type": "AWS::ECS::TaskDefinition",
+                        "Properties": "invalid",
+                    },
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
