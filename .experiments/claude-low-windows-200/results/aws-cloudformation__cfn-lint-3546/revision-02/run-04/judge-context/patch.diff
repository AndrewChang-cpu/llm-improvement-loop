+                        [
+                        "Resources",
+                        "TaskDefinition",
+                        "Properties",
+                        "RequiresCompatibilities",
+                    ]
+                    ),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": {
+                        "Type": "AWS::ECS::TaskDefinition",
+                        "Properties": {
+                            "RequiresCompatibilities": ["EC2", {"Ref": "Other"}],
+                        },
+                    },
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Parameters": {"MyCompat": {"Type": "CommaDelimitedList"}},
+                "Resources": {
+                    "TaskDefinition": {
+                        "Type": "AWS::ECS::TaskDefinition",
+                        "Properties": {
+                            "RequiresCompatibilities": {"Ref": "MyCompat"},
