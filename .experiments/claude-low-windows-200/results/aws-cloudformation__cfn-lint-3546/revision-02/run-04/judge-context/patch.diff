+
+
+class ServiceNetworkConfiguration(CfnLintKeyword):
+    id = "E3052"
+    shortdesc = (
+        "Validate ECS services require NetworkConfiguration for awsvpc task definitions"
+    )
+    description = (
+        "When an ECS service references a task definition with a 'NetworkMode' "
+        "of 'awsvpc' the service must define 'NetworkConfiguration'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _filter_resource_name(self, instance: Any) -> str | None:
+        fn_k, fn_v = is_function(instance)
+        if fn_k is None:
+            return None
+        if fn_k == "Ref":
+            if isinstance(fn_v, str):
+                return fn_v
+        elif fn_k == "Fn::GetAtt":
+            name = ensure_list(fn_v)[0]
+            if isinstance(name, str):
+                return name.split(".")[0]
+        return None
+
+    def _get_task_definition_names(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Validator]]:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = self._filter_resource_name(task_definition)
+            if name is None:
+                continue
+            yield name, task_definition_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for name, task_definition_validator in self._get_task_definition_names(
+            validator, instance
+        ):
+            for network_configuration, network_configuration_validator in (
+                get_value_from_path(
+                    task_definition_validator,
+                    instance,
+                    deque(["NetworkConfiguration"]),
+                )
+            ):
+                task_definition, task_definition_lookup_validator = (
+                    get_resource_by_name(
+                        network_configuration_validator,
+                        name,
+                        ["AWS::ECS::TaskDefinition"],
+                    )
+                )
+                if not task_definition:
+                    continue
+
+                for network_mode, _ in get_value_from_path(
+                    task_definition_lookup_validator,
+                    task_definition,
+                    deque(["Properties", "NetworkMode"]),
+                ):
+                    if network_mode != "awsvpc":
+                        continue
+                    if network_configuration is None:
+                        yield ValidationError(
+                            "'NetworkConfiguration' is a required property",
+                            validator="required",
+                            rule=self,
+                        )
