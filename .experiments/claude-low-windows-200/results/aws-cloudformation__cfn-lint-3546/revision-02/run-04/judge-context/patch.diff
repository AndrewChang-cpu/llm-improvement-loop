+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.ServiceFargate import ServiceFargate
+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+_task_definition = {
+    "Type": "AWS::ECS::TaskDefinition",
+    "Properties": {
+        "RequiresCompatibilities": ["FARGATE"],
+        "ContainerDefinitions": [{"Name": "app", "Image": "image"}],
+    },
+}
+
+_service = {
+    "Type": "AWS::ECS::Service",
+    "Properties": {
+        "TaskDefinition": {"Ref": "TaskDefinition"},
+        "LaunchType": "FARGATE",
+    },
+}
+
+_RESOURCES_TD = deque(["Resources", "TaskDefinition", "Properties"])
+
+
+def _contains_error(value, path):
+    return ValidationError(
+        f"{value!r} does not contain items matching 'FARGATE'",
+        validator="contains",
+        path_override=deque(path),
+        rule=ServiceFargate(),
+    )
+
+
+_required_error = ValidationError(
+    "'RequiresCompatibilities' is a required property",
+    validator="required",
+    path_override=deque(["Resources", "TaskDefinition", "Properties"]),
+    rule=ServiceFargate(),
+)
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": dict(_task_definition),
+                    "Service": dict(_service),
