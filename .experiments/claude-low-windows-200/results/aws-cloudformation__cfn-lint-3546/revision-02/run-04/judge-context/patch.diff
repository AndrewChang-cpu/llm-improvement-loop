+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Iterator
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+class ServiceFargate(CfnLintKeyword):
+    id = "E3054"
+    shortdesc = (
+        "Validate ECS services using FARGATE reference task definitions "
+        "that support FARGATE"
+    )
+    description = (
+        "When an ECS service uses a 'LaunchType' of 'FARGATE' the task definition "
+        "it references must have 'RequiresCompatibilities' that includes 'FARGATE'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _filter_resource_name(self, instance: Any) -> str | None:
+        fn_k, fn_v = is_function(instance)
+        if fn_k is None:
+            return None
+        if fn_k == "Ref":
+            if isinstance(fn_v, str):
+                return fn_v
+        elif fn_k == "Fn::GetAtt":
+            name = ensure_list(fn_v)[0]
+            if isinstance(name, str):
+                return name.split(".")[0]
+        return None
+
+    def _get_task_definition_names(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Validator]]:
+        for task_definition, task_definition_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = self._filter_resource_name(task_definition)
+            if name is None:
+                continue
+            yield name, task_definition_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for name, task_definition_validator in self._get_task_definition_names(
+            validator, instance
+        ):
+            for launch_type, launch_type_validator in get_value_from_path(
+                task_definition_validator, instance, deque(["LaunchType"])
+            ):
+                if launch_type != "FARGATE":
+                    continue
+
+                task_definition, task_definition_lookup_validator = (
+                    get_resource_by_name(
+                        launch_type_validator,
+                        name,
+                        ["AWS::ECS::TaskDefinition"],
+                    )
+                )
+                if not task_definition:
+                    continue
+
+                for (
+                    requires,
+                    requires_validator,
+                ) in get_value_from_path(
+                    task_definition_lookup_validator,
+                    task_definition,
+                    deque(["Properties", "RequiresCompatibilities"]),
+                ):
+                    yield from self._validate_requires(requires, requires_validator)
+
+    def _validate_requires(
+        self, requires: Any, requires_validator: Validator
+    ) -> Iterator[ValidationError]:
+        if requires is None:
+            # the lookup path minus its last segment points at the
+            # Properties location, the TaskDefinition resource location, or
+            # the RequiresCompatibilities location (AWS::NoValue)
+            path = deque(requires_validator.context.path.path)
+            path.pop()
+            yield ValidationError(
+                "'RequiresCompatibilities' is a required property",
+                validator="required",
+                path_override=path,
+                rule=self,
+            )
+            return
+
+        if not isinstance(requires, list):
+            return
+
+        has_fargate = False
+        for element, _ in get_value_from_path(
+            requires_validator, requires, deque(["*"])
+        ):
+            if isinstance(element, dict) or element == "FARGATE":
+                has_fargate = True
+                break
+
+        if not has_fargate:
+            yield ValidationError(
+                f"{requires!r} does not contain items matching 'FARGATE'",
+                validator="contains",
+                path_override=requires_validator.context.path.path,
+                rule=self,
+            )
