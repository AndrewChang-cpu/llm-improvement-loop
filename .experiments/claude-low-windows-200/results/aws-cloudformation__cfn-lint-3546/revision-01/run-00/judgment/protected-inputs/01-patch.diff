+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+class ServiceNetworkConfiguration(CfnLintKeyword):
+    id = "E3052"
+    shortdesc = (
+        "Validate ECS services using an 'awsvpc' task definition have "
+        "NetworkConfiguration"
+    )
+    description = (
+        "When the ECS task definition of a service uses 'awsvpc' network mode "
+        "the service has to specify 'NetworkConfiguration'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _get_task_definition_name(self, instance: Any) -> str | None:
+        fn_k, fn_v = is_function(instance)
+        if fn_k == "Ref":
+            if isinstance(fn_v, str):
+                return fn_v
+        elif fn_k == "Fn::GetAtt":
+            values = ensure_list(fn_v)
+            if values and isinstance(values[0], str):
+                return values[0].split(".")[0]
+        return None
+
+    def _get_task_definitions(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[Any, Validator]]:
+        for task_definition_ref, ref_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = self._get_task_definition_name(task_definition_ref)
+            if name is None:
+                continue
+            task_definition, task_definition_validator = get_resource_by_name(
+                ref_validator, name, ["AWS::ECS::TaskDefinition"]
+            )
+            if not task_definition:
+                continue
+            yield task_definition, task_definition_validator
+
+    def _is_awsvpc(self, validator: Validator, task_definition: Any) -> bool:
+        return any(
+            network_mode == "awsvpc"
+            for network_mode, _ in get_value_from_path(
+                validator, task_definition, deque(["Properties", "NetworkMode"])
+            )
+        )
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        if not isinstance(instance, dict):
+            return
+
+        for task_definition, task_definition_validator in self._get_task_definitions(
+            validator, instance
+        ):
+            if not self._is_awsvpc(task_definition_validator, task_definition):
+                continue
+
+            for network_configuration, _ in get_value_from_path(
+                validator, instance, deque(["NetworkConfiguration"])
+            ):
+                if network_configuration is None:
+                    yield ValidationError(
+                        "'NetworkConfiguration' is a required property",
+                        validator="required",
+                        rule=self,
+                    )
+                    break
