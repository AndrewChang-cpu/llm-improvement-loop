+        elif fn_k == "Fn::GetAtt":
+            names = ensure_list(fn_v)
+            if names and isinstance(names[0], str):
+                return names[0].split(".")[0]
+        return None
+
+    def _get_task_definitions(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[Any, Validator]]:
+        for task_definition_ref, ref_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = self._filter_resource_name(task_definition_ref)
+            if name is None:
+                continue
+            task_definition, task_definition_validator = get_resource_by_name(
+                ref_validator, name, ["AWS::ECS::TaskDefinition"]
+            )
+            if not task_definition:
+                continue
+            yield task_definition, task_definition_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for task_definition, task_definition_validator in self._get_task_definitions(
+            validator, instance
+        ):
+            is_awsvpc = False
+            for network_mode, _mode_validator in get_value_from_path(
