+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.ServiceFargate import ServiceFargate
+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+def _task_definition(properties: dict) -> dict:
+    return {
+        "Type": "AWS::ECS::TaskDefinition",
+        "Properties": {
+            "ContainerDefinitions": [{"Name": "app", "Image": "image"}],
+            **properties,
+        },
+    }
+
+
+def _service(launch_type: str | None = "FARGATE") -> dict:
+    properties = {"TaskDefinition": {"Ref": "TaskDefinition"}}
+    if launch_type is not None:
+        properties["LaunchType"] = launch_type
+    return {"Type": "AWS::ECS::Service", "Properties": properties}
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2", "EXTERNAL"]}
+                    ),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "['EC2', 'EXTERNAL'] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    rule=ServiceFargate(),
+                    path_override=deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "RequiresCompatibilities",
+                        ]
+                    ),
+                ),
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition({}),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    rule=ServiceFargate(),
+                    path_override=deque(["Resources", "TaskDefinition", "Properties"]),
+                ),
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["FARGATE"]}
+                    ),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {
+                            "RequiresCompatibilities": {
+                                "Ref": "Compatibilities",
+                            }
+                        }
+                    ),
+                    "Service": _service(),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2", "EXTERNAL"]}
+                    ),
+                    "Service": _service("EC2"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(
+                        {"RequiresCompatibilities": ["EC2", "EXTERNAL"]}
+                    ),
+                    "Service": _service(None),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
+        validator, template, start_path
+    ):
+        errs = list(rule.validate(instance_validator, "", instance, {}))
+        assert errs == expected, f"Expected {expected} got {errs}"
