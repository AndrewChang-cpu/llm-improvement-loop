+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+
+import jsonpatch
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.helpers import get_value_from_path
+from cfnlint.rules.resources.ecs.ServiceFargate import ServiceFargate
+
+
+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+_task_definition = {
+    "Type": "AWS::ECS::TaskDefinition",
+    "Properties": {
+        "RequiresCompatibilities": ["FARGATE"],
+        "ContainerDefinitions": [
+            {
+                "Name": "my-container",
+                "Image": "my-image",
+            }
+        ],
+    },
+}
+
+_service = {
+    "Type": "AWS::ECS::Service",
+    "Properties": {
+        "LaunchType": "FARGATE",
+        "TaskDefinition": {"Ref": "TaskDefinition"},
+    },
+}
+
+
+def _patch(template, path, value):
+    return jsonpatch.apply_patch(
+        dict(template),
+        [{"op": "replace", "path": path, "value": value}],
+    )
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": dict(_task_definition),
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        ["EC2", "EXTERNAL"],
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "['EC2', 'EXTERNAL'] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    path_override=deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "RequiresCompatibilities",
+                        ]
+                    ),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": jsonpatch.apply_patch(
+                        dict(_task_definition),
+                        [
+                            {
+                                "op": "remove",
+                                "path": "/Properties/RequiresCompatibilities",
+                            }
+                        ],
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition", "Properties"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        ["EC2", "FARGATE"],
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        {"Ref": "Compatibilities"},
+                    ),
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _patch(
+                        _task_definition,
+                        "/Properties/RequiresCompatibilities",
+                        ["EC2", "EXTERNAL"],
+                    ),
+                    "Service": _patch(_service, "/Properties/LaunchType", "EC2"),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
+        validator, template, start_path
+    ):
+        errs = list(rule.validate(instance_validator, "", instance, {}))
+        assert errs == expected, f"Expected {expected} got {errs}"
