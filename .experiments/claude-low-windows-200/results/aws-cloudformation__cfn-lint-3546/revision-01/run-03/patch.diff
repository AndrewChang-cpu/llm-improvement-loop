+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any, Iterator
+
+from cfnlint.helpers import ensure_list, is_function
+from cfnlint.jsonschema import ValidationError, ValidationResult
+from cfnlint.jsonschema.protocols import Validator
+from cfnlint.rules.helpers import get_resource_by_name, get_value_from_path
+from cfnlint.rules.jsonschema.CfnLintKeyword import CfnLintKeyword
+
+
+def _get_reference_name(value: Any) -> str | None:
+    fn_k, fn_v = is_function(value)
+    if fn_k == "Ref":
+        if isinstance(fn_v, str):
+            return fn_v
+    elif fn_k == "Fn::GetAtt":
+        values = ensure_list(fn_v)
+        if values and isinstance(values[0], str):
+            return values[0].split(".")[0]
+    return None
+
+
+class ServiceNetworkConfiguration(CfnLintKeyword):
+    id = "E3052"
+    shortdesc = (
+        "Validate ECS services using awsvpc task definitions have NetworkConfiguration"
+    )
+    description = (
+        "When the ECS task definition referenced by a service uses the "
+        "'awsvpc' network mode the service must define 'NetworkConfiguration'"
+    )
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _get_task_definitions(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[str, Any, Validator]]:
+        for task_ref, task_ref_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = _get_reference_name(task_ref)
+            if name is None:
+                continue
+            task_def, task_def_validator = get_resource_by_name(
+                task_ref_validator, name, ["AWS::ECS::TaskDefinition"]
+            )
+            if not task_def:
+                continue
+            yield name, task_def, task_def_validator
+
+    def _is_awsvpc(self, validator: Validator, task_def: Any) -> bool:
+        for mode, _ in get_value_from_path(
+            validator, task_def, deque(["Properties", "NetworkMode"])
+        ):
+            if mode == "awsvpc":
+                return True
+        return False
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for _, task_def, task_def_validator in self._get_task_definitions(
+            validator, instance
+        ):
+            if not self._is_awsvpc(task_def_validator, task_def):
+                continue
+
+            missing = any(
+                network_configuration is None
+                for network_configuration, _ in get_value_from_path(
+                    validator, instance, deque(["NetworkConfiguration"])
+                )
+            )
+            if missing:
+                yield ValidationError(
+                    "'NetworkConfiguration' is a required property",
+                    validator="required",
+                    rule=self,
+                )
