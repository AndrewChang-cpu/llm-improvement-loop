+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(["EC2", "EXTERNAL"]),
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "['EC2', 'EXTERNAL'] does not contain items matching 'FARGATE'",
+                    validator="contains",
+                    path_override=deque(
+                        [
+                            "Resources",
+                            "TaskDefinition",
+                            "Properties",
+                            "RequiresCompatibilities",
+                        ]
+                    ),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(None),
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [
+                ValidationError(
+                    "'RequiresCompatibilities' is a required property",
+                    validator="required",
+                    path_override=deque(["Resources", "TaskDefinition", "Properties"]),
+                    rule=ServiceFargate(),
+                )
+            ],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition({"Ref": "Compat"}),
+                    "Service": dict(_service),
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(["EC2"]),
+                    "Service": {
+                        "Type": "AWS::ECS::Service",
+                        "Properties": {
+                            "TaskDefinition": {"Ref": "TaskDefinition"},
+                            "LaunchType": "EC2",
+                        },
+                    },
+                }
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+        (
+            {
+                "Parameters": {"MyTaskDefinition": {"Type": "String"}},
+                "Resources": {
+                    "TaskDefinition": _task_definition(["EC2"]),
+                    "Service": {
+                        "Type": "AWS::ECS::Service",
+                        "Properties": {
+                            "TaskDefinition": {"Ref": "MyTaskDefinition"},
+                            "LaunchType": "FARGATE",
+                        },
+                    },
+                },
+            },
+            deque(["Resources", "Service", "Properties"]),
+            [],
+        ),
+    ],
+    indirect=["template"],
+)
+def test_validate(template, start_path, expected, rule, validator):
+    for instance, instance_validator in get_value_from_path(
