+@pytest.fixture
+def rule():
+    rule = ServiceFargate()
+    yield rule
+
+
+def _task_definition(requires):
+    properties = {
+        "ContainerDefinitions": [{"Name": "my-container", "Image": "my-image"}],
+    }
+    if requires is not None:
+        properties["RequiresCompatibilities"] = requires
+    return {"Type": "AWS::ECS::TaskDefinition", "Properties": properties}
+
+
+_service = {
+    "Type": "AWS::ECS::Service",
+    "Properties": {
+        "TaskDefinition": {"Ref": "TaskDefinition"},
+        "LaunchType": "FARGATE",
+    },
+}
+
+
+@pytest.mark.parametrize(
+    "template,start_path,expected",
+    [
+        (
+            {
+                "Resources": {
+                    "TaskDefinition": _task_definition(["FARGATE", "EC2"]),
+                    "Service": dict(_service),
