+class ServiceNetworkConfiguration(CfnLintKeyword):
+    id = "E3052"
+    shortdesc = (
+        "Validate ECS services have NetworkConfiguration when the task "
+        "definition uses awsvpc network mode"
+    )
+    description = (
+        "When the ECS task definition has a NetworkMode of 'awsvpc' "
+        "the service requires a 'NetworkConfiguration'"
+    )
+    source_url = "https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/aws-resource-ecs-service.html#cfn-ecs-service-networkconfiguration"
+    tags = ["resources", "ecs"]
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ECS::Service/Properties"],
+        )
+
+    def _filter_resource_name(self, instance: Any) -> str | None:
+        fn_k, fn_v = is_function(instance)
+        if fn_k == "Ref" and isinstance(fn_v, str):
+            return fn_v
+        if fn_k == "Fn::GetAtt":
+            items = ensure_list(fn_v)
+            if items and isinstance(items[0], str):
+                return items[0].split(".")[0]
+        return None
+
+    def _get_task_definitions(
+        self, validator: Validator, instance: Any
+    ) -> Iterator[tuple[Any, Validator]]:
+        for task_definition_ref, ref_validator in get_value_from_path(
+            validator, instance, deque(["TaskDefinition"])
+        ):
+            name = self._filter_resource_name(task_definition_ref)
+            if name is None:
+                continue
+            task_definition, task_definition_validator = get_resource_by_name(
+                ref_validator, name, ["AWS::ECS::TaskDefinition"]
+            )
+            if not task_definition:
+                continue
+            yield task_definition, task_definition_validator
+
+    def validate(
+        self, validator: Validator, _: Any, instance: Any, schema: dict[str, Any]
+    ) -> ValidationResult:
+        for task_definition, task_definition_validator in self._get_task_definitions(
+            validator, instance
+        ):
+            is_awsvpc = False
+            for network_mode, _mode_validator in get_value_from_path(
+                task_definition_validator,
+                task_definition,
+                deque(["Properties", "NetworkMode"]),
+            ):
+                if network_mode == "awsvpc":
+                    is_awsvpc = True
+            if not is_awsvpc:
+                continue
+
+            missing = False
+            for network_configuration, _config_validator in get_value_from_path(
+                validator, instance, deque(["NetworkConfiguration"])
+            ):
+                if network_configuration is None:
+                    missing = True
+            if missing:
+                yield ValidationError(
+                    "'NetworkConfiguration' is a required property",
+                    validator="required",
+                    rule=self,
+                )
