+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from collections import deque
+
+import pytest
+
+from cfnlint.jsonschema import ValidationError
+from cfnlint.rules.resources.elasticache.CacheClusterEngine import CacheClusterEngine
+
+
+@pytest.fixture(scope="module")
+def rule():
+    rule = CacheClusterEngine()
+    yield rule
+
+
+@pytest.mark.parametrize(
+    "instance,expected",
+    [
+        (
+            {"Engine": "redis"},
+            [],
+        ),
+        (
+            {"Engine": "memcached"},
+            [],
+        ),
+        (
+            {"Engine": "valkey"},
+            [],
+        ),
+        (
+            {"Engine": "Redis"},  # normalized to lowercase
+            [],
+        ),
+        (
+            [],
+            [],
+        ),
+        (
+            {"Engine": {"Ref": "Engine"}},
+            [],
+        ),
+        (
+            {"CacheNodeType": "cache.t3.micro"},
+            [],
+        ),
+        (
+            {"Engine": "foo"},
+            [
+                ValidationError(
+                    "'foo' is not one of ['memcached', 'redis', 'valkey']",
+                    rule=CacheClusterEngine(),
+                    path=deque(["Engine"]),
+                    validator="enum",
+                    schema_path=deque(
+                        ["allOf", 0, "then", "properties", "Engine", "enum"]
+                    ),
+                )
+            ],
+        ),
+    ],
+)
+def test_validate(instance, expected, rule, validator):
+    errs = list(rule.validate(validator, "", instance, {}))
+    assert errs == expected, f"Expected {expected} got {errs}"
