+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from __future__ import annotations
+
+import cfnlint.data.schemas.extensions.aws_elasticache_cachecluster
+from cfnlint.rules.jsonschema.CfnLintJsonSchema import CfnLintJsonSchema, SchemaDetails
+
+
+class CacheClusterEngine(CfnLintJsonSchema):
+    id = "E3695"
+    shortdesc = "Validate ElastiCache cluster engine"
+    description = "Validate the engine of an ElastiCache cache cluster"
+    tags = ["resources"]
+    source_url = "https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/aws-resource-elasticache-cachecluster.html#cfn-elasticache-cachecluster-engine"
+
+    def __init__(self) -> None:
+        super().__init__(
+            keywords=["Resources/AWS::ElastiCache::CacheCluster/Properties/Engine"],
+            schema_details=SchemaDetails(
+                module=cfnlint.data.schemas.extensions.aws_elasticache_cachecluster,
+                filename="engine_enum.json",
+            ),
+            all_matches=True,
+        )
