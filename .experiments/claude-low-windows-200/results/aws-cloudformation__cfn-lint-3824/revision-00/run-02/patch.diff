+"""
+
+from test.unit.rules import BaseRuleTestCase
+
+from cfnlint.rules.resources.elasticache.CacheClusterEngine import (
+    CacheClusterEngine,  # pylint: disable=E0401
+)
+
+
+class TestElasticCacheClusterEngine(BaseRuleTestCase):
+    """Test ElasticCache CacheClusterEngine"""
+
+    def setUp(self):
+        """Setup"""
+        super(TestElasticCacheClusterEngine, self).setUp()
+        self.collection.register(CacheClusterEngine())
+        self.success_templates = [
+            "test/fixtures/templates/good/resources/elasticache/cache_cluster_engine.yaml"
+        ]
+
+    def test_file_positive(self):
+        """Test Positive"""
+        self.helper_file_positive()
+
+    def test_file_artifact_failure(self):
+        """Test failure"""
+        self.helper_file_negative(
+            "test/fixtures/templates/bad/resources/elasticache/cache_cluster_engine.yaml",
+            2,
+        )
